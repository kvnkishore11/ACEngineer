  "sections_catalog": {
    "note": "Definitive list of the gradable section entities from apps/prompt_tier_list/src/constants/entities.ts (13 sections). Tier = usefulness/skill as placed on-screen in the final grid at ~45:40. Axes: usefulness S(top)→D(bottom); skill D=Beginner(left)→S=Expert(right).",
    "sections": [
      {
        "name": "# Title",
        "purpose": "Names the prompt with a clear, action-oriented H1. Immediately communicates what the prompt does.",
        "usefulness": "C",
        "skill": "D"
      },
      {
        "name": "## High Level Prompt",
        "purpose": "A high-level, detail-void description of what you want the agent to do. The required core of a Level-1 prompt. Very easy to write; decent value with almost no effort.",
        "usefulness": "B",
        "skill": "D"
      },
      {
        "name": "## Metadata",
        "purpose": "YAML frontmatter for Claude Code: allowed-tools, description, argument-hint, optional model. Lets you pin exact tools/models; otherwise not hugely valuable. Other tools have their own version.",
        "usefulness": "C",
        "skill": "C"
      },
      {
        "name": "## Purpose",
        "purpose": "One or two sentences of direct, agent-directed language stating exactly what this prompt is meant to do. Powerful and simple; sets the tone of voice ('talk to your agent').",
        "usefulness": "B",
        "skill": "D"
      },
      {
        "name": "## Variables",
        "purpose": "Dynamic ($1/$2/$ARGUMENTS) and static (fixed) values in a consistent NAME: value syntax, referenced by name throughout. Where prompts become massively more reusable.",
        "usefulness": "A",
        "skill": "B"
      },
      {
        "name": "## Instructions",
        "purpose": "A bullet list of auxiliary/guardrail information that aids the workflow. Distinct from Workflow (the play-by-play); more valuable in system prompts than user prompts. Often you can skip it.",
        "usefulness": "B",
        "skill": "C"
      },
      {
        "name": "## Relevant Files",
        "purpose": "A specific set of files for the agent to reference — speeds it up, gives it a quick way to find existing files. Like Codebase Structure but a flat file set. Not a game-breaker.",
        "usefulness": "C",
        "skill": "C"
      },
      {
        "name": "## Codebase Structure",
        "purpose": "A context map: a tree of where files are and what they do at a 100-foot view. You do NOT tell the agent to read them — you give it a map so it finds relevant files fast without burning tokens on search.",
        "usefulness": "C",
        "skill": "C"
      },
      {
        "name": "## Workflow",
        "purpose": "The sequential, numbered step-by-step play of exactly what the agent should do. THE most useful section. Maps to the agent's todo/plan list. Hosts control flow, loops, and delegation.",
        "usefulness": "S",
        "skill": "C"
      },
      {
        "name": "## Expertise",
        "purpose": "Accumulated domain knowledge, patterns, and standards embedded in the prompt — the section that makes a prompt self-improving (Level 7). Works best when a separate prompt updates it.",
        "usefulness": "A",
        "skill": "A"
      },
      {
        "name": "## Template",
        "purpose": "The exact output structure (a.k.a. Specified Format / Plan Format) the agent should generate, with <placeholder> blocks it fills in. The heart of a Template Metaprompt (Level 6). Very powerful, very hard.",
        "usefulness": "S",
        "skill": "S"
      },
      {
        "name": "## Examples",
        "purpose": "Concrete demonstrations of the desired output/result. Can drastically increase agent performance; doesn't take much skill to write.",
        "usefulness": "A",
        "skill": "B"
      },
      {
        "name": "## Report",
        "purpose": "The output/format section: how the agent responds — JSON, YAML, a specific structure, or required fields. Distinct from a bare Response; controls what comes back.",
        "usefulness": "B",
        "skill": "C"
      }
    ]
  },
  "tier_list": {
    "axes": {
      "x_skill": "Left→right = Beginner (D) to Expert (S): how much skill the section/format takes to operate.",
      "y_usefulness": "Top→bottom = Useful (S) to Useless (D): how valuable the section/format is."
