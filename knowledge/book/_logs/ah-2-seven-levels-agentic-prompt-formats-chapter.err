+    <section class="section" aria-labelledby="ah-heading">
+      <div class="section-head"><div><p class="eyebrow">Volume II</p><h2 id="ah-heading">Agentic Horizon</h2></div><p>1 of 6 chapters · 16.7%</p></div>
+      <div class="lesson-list">
+        <div class="lesson"><span class="lesson__n">09</span><div><strong>Elite Context Engineering</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+        <div class="lesson"><span class="lesson__n">10</span><div><strong><a href="vol-2-ah/10-seven-levels-agentic-prompt-formats.html">Seven Levels Agentic Prompt Formats</a></strong><p>Tactic: Master the Seven Agentic Prompt Formats · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
+        <div class="lesson"><span class="lesson__n">11</span><div><strong>Building Domain-Specific Agents</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+        <div class="lesson"><span class="lesson__n">12</span><div><strong>Multi-Agent Orchestration: The O-Agent</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+        <div class="lesson"><span class="lesson__n">13</span><div><strong>Agent Experts</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+        <div class="lesson"><span class="lesson__n">14</span><div><strong>Building Agentic Layers</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+      </div>
+    </section>
+
