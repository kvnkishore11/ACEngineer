<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A teaching-first field guide to IndyDevDan's Tactical Agentic Coding, Agentic Horizon, and multi-agent systems.">
  <title>IndyDevDan Expert Book</title>
  <link rel="stylesheet" href="design/tokens.css">
  <link rel="stylesheet" href="design/base.css">
  <link rel="stylesheet" href="design/components.css">
  <style>
    body { background: radial-gradient(circle at 88% 0, var(--accent-wash), transparent 32rem), var(--bg); }
    .hub { width: min(calc(100% - 2rem), 70rem); margin-inline: auto; padding: var(--space-6) 0 var(--space-12); }
    .masthead { display:flex; justify-content:space-between; align-items:center; gap:var(--space-4); padding-bottom:var(--space-4); border-bottom:var(--hairline); }
    .brand { color:var(--ink); font-weight:750; text-decoration:none; }
    .edition { color:var(--ink-mute); font:var(--text-xs) var(--font-mono); }
    .hero { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(18rem,.8fr); gap:var(--space-8); align-items:end; padding:var(--space-10) 0; }
    .eyebrow { color:var(--accent-ink); font-size:var(--text-xs); font-weight:750; letter-spacing:.09em; text-transform:uppercase; }
    .hero h1 { margin-top:var(--space-3); font-size:clamp(3rem,8vw,6.4rem); line-height:.92; max-width:10ch; }
    .hero__dek { margin-top:var(--space-5); color:var(--ink-soft); font:var(--text-md)/1.5 var(--font-display); max-width:48ch; }
    .progress-card { padding:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); box-shadow:var(--shadow-card); }
    .progress-card h2 { margin:var(--space-2) 0 0; font-size:var(--text-lg); }
    .progress-line { height:.7rem; margin:var(--space-4) 0 var(--space-2); overflow:hidden; border-radius:99px; background:var(--bg-inset); }
    .progress-line span { display:block; width:44.44%; height:100%; border-radius:inherit; background:var(--accent); }
    .progress-copy { display:flex; justify-content:space-between; color:var(--ink-mute); font-size:var(--text-sm); }
    .chapter-feature { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(18rem,.8fr); overflow:hidden; border:1px solid var(--accent); border-radius:1.25rem; background:var(--bg-card); box-shadow:var(--shadow-card); }
    .chapter-feature__copy { padding:clamp(1.5rem,4vw,3.5rem); }
    .chapter-feature h2 { margin-top:var(--space-3); font-size:clamp(2rem,4vw,3.5rem); }
    .chapter-feature__dek { margin-top:var(--space-3); color:var(--ink-soft); font-size:var(--text-md); }
    .chapter-feature__meta { display:flex; flex-wrap:wrap; gap:var(--space-2); margin:var(--space-5) 0 0; padding:0; list-style:none; }
    .chapter-feature__meta li { padding:.25rem .6rem; border-radius:99px; color:var(--ink-soft); background:var(--bg-inset); font-size:var(--text-sm); }
    .button { display:inline-flex; margin-top:var(--space-5); padding:.75rem 1rem; border-radius:var(--radius-md); color:var(--ink-inverse); background:var(--accent); font-weight:750; text-decoration:none; }
    .button:hover { color:var(--ink-inverse); background:var(--accent-ink); }
    .chapter-feature__map { display:grid; place-items:center; min-height:23rem; padding:var(--space-5); background:var(--accent-wash); }
    .four { display:grid; grid-template-columns:repeat(2,1fr); gap:var(--space-2); width:min(100%,22rem); }
    .four div { display:grid; place-items:center; aspect-ratio:1; border:2px solid var(--accent); border-radius:45% 55% 50% 50%; color:var(--accent-ink); background:color-mix(in srgb,var(--bg-card) 72%,transparent); font:650 var(--text-md) var(--font-display); }
    .focus-three { display:grid; gap:var(--space-3); width:min(100%,24rem); }
    .focus-three div { padding:var(--space-4); border:2px solid var(--accent); border-radius:var(--radius-lg); color:var(--accent-ink); background:color-mix(in srgb,var(--bg-card) 76%,transparent); font:650 var(--text-md) var(--font-display); text-align:center; }
    .section { margin-top:var(--space-10); }
    .section-head { display:flex; justify-content:space-between; align-items:end; gap:var(--space-4); padding-bottom:var(--space-3); border-bottom:var(--hairline); }
    .section-head h2 { margin:0; }
    .section-head p { color:var(--ink-mute); font-size:var(--text-sm); }
    .lesson-list { display:grid; gap:var(--space-2); margin-top:var(--space-4); }
    .lesson { display:grid; grid-template-columns:3rem minmax(0,1fr) auto; gap:var(--space-3); align-items:center; padding:var(--space-3) var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
    .lesson__n { color:var(--ink-mute); font:var(--text-sm) var(--font-mono); }
    .lesson strong { display:block; }
    .lesson p { color:var(--ink-mute); font-size:var(--text-sm); }
    .badge { padding:.2rem .55rem; border-radius:99px; font-size:var(--text-xs); font-weight:750; text-transform:uppercase; letter-spacing:.06em; }
    .badge--done { color:var(--ok); background:var(--ok-wash); }
    .badge--pending { color:var(--ink-mute); background:var(--bg-inset); }
    .volumes { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--space-4); margin-top:var(--space-4); }
    .volume-card { padding:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); }
    .volume-card h3 { margin-top:var(--space-2); }
    .volume-card p { margin-top:var(--space-3); color:var(--ink-soft); }
    .hub-footer { display:flex; justify-content:space-between; gap:var(--space-4); margin-top:var(--space-10); padding-top:var(--space-5); border-top:var(--hairline); color:var(--ink-mute); font-size:var(--text-sm); }
    @media (max-width:48rem) { .hero,.chapter-feature { grid-template-columns:1fr; } .chapter-feature__map { min-height:18rem; } .volumes { grid-template-columns:1fr; } .lesson { grid-template-columns:2rem minmax(0,1fr); } .lesson .badge { grid-column:2; justify-self:start; } }
  </style>
</head>
<body>
  <main class="hub">
    <header class="masthead">
      <a class="brand" href="index.html">IndyDevDan Expert Book</a>
      <span class="edition">GOLD PILOT · 2026</span>
    </header>

    <section class="hero">
      <div>
        <p class="eyebrow">Operate · retrieve · teach back</p>
        <h1>Build systems that build systems.</h1>
        <p class="hero__dek">A dense, teaching-first companion to IndyDevDan’s course system. Each chapter turns the video spine into mental models, worked codebase examples, failure repairs, retrieval practice, and graded labs.</p>
      </div>
      <aside class="progress-card" aria-label="Book progress">
        <p class="eyebrow">Corpus phase 1</p>
        <h2>8 of 18 chapters built</h2>
        <div class="progress-line" aria-hidden="true"><span></span></div>
        <p class="progress-copy"><span>44.4% complete</span><span>Volume I complete</span></p>
      </aside>
    </section>

    <article class="chapter-feature">
      <div class="chapter-feature__copy">
        <p class="eyebrow">Now available · Volume I · Chapter 08</p>
        <h2>The Agentic Layer</h2>
        <p class="chapter-feature__dek">Separate the application from the ring that operates it, build the three-directory minimum, compose prompt contracts into ADWs, and scale through task boards, triggers, isolated agents, and measured autonomy.</p>
        <ul class="chapter-feature__meta"><li>Tactic #8 · Prioritize Agentics</li><li>90–150 min core lab</li><li>12 full-width course frames</li><li>2 current-practice overlays</li></ul>
        <a class="button" href="vol-1-tac/08-the-agentic-layer.html">Start chapter →</a>
      </div>
      <div class="chapter-feature__map" aria-label="Agentic layer visual">
        <div class="four"><div>Prompts</div><div>Plans</div><div>ADWs</div><div>Triggers</div></div>
      </div>
    </article>

    <section class="section" aria-labelledby="tac-heading">
      <div class="section-head"><div><p class="eyebrow">Volume I</p><h2 id="tac-heading">Tactical Agentic Coding</h2></div><p>8 of 8 chapters · 100%</p></div>
      <div class="lesson-list">
        <div class="lesson"><span class="lesson__n">01</span><div><strong><a href="vol-1-tac/01-hello-agentic-coding.html">Hello Agentic Coding</a></strong><p>Tactic: Stop Coding · Gold chapter</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">02</span><div><strong><a href="vol-1-tac/02-the-12-leverage-points.html">The 12 Leverage Points</a></strong><p>Tactic: Adopt Your Agent’s Perspective · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">03</span><div><strong><a href="vol-1-tac/03-success-is-planned.html">Success is Planned</a></strong><p>Tactic: Template Your Engineering · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">04</span><div><strong><a href="vol-1-tac/04-afk-agents.html">AFK Agents</a></strong><p>Tactic: Stay Out The Loop · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">05</span><div><strong><a href="vol-1-tac/05-close-the-loops.html">Close the Loops</a></strong><p>Tactic: Always Add Feedback Loops · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">06</span><div><strong><a href="vol-1-tac/06-let-your-agents-focus.html">Let Your Agents Focus</a></strong><p>Tactic: One Agent, One Prompt, One Purpose · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">07</span><div><strong><a href="vol-1-tac/07-zte-secret-of-agentic-engineering.html">ZTE Secret of Agentic Engineering</a></strong><p>Tactic: Target Zero-Touch Engineering · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">08</span><div><strong><a href="vol-1-tac/08-the-agentic-layer.html">The Agentic Layer</a></strong><p>Tactic: Prioritize Agentics · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="roadmap-heading">
      <div class="section-head"><div><p class="eyebrow">Course spine</p><h2 id="roadmap-heading">Three-volume roadmap</h2></div><p>18 lessons · synthesis follows</p></div>
      <div class="volumes">
        <article class="volume-card"><p class="eyebrow">Volume I · 8 lessons</p><h3>Tactical Agentic Coding</h3><p>Operational tactics, leverage, planning, AFK agents, loops, focus, zero-touch engineering, and the agentic layer.</p></article>
        <article class="volume-card"><p class="eyebrow">Volume II · 6 lessons</p><h3>Agentic Horizon</h3><p>Context-window mastery, prompt formats, specialized agents, orchestration, agent experts, and agentic layers.</p></article>
        <article class="volume-card"><p class="eyebrow">Volume III · 4 lessons</p><h3>Multi-Agent Systems</h3><p>CEO, lead, UI, and verifier agents, followed by cross-volume synthesis and expert practice.</p></article>
      </div>
    </section>

    <footer class="hub-footer"><span>Light, offline-first teaching site</span><a href="data/curriculum.json">Curriculum data</a></footer>
  </main>
</body>
</html>

diff --git a/IndyDevDan/book/vol-2-ah/10-seven-levels-agentic-prompt-formats.assets.css b/IndyDevDan/book/vol-2-ah/10-seven-levels-agentic-prompt-formats.assets.css
new file mode 100644
index 0000000000000000000000000000000000000000..a280e7ce6197318398d30da01a1d1397db864498
--- /dev/null
+++ b/IndyDevDan/book/vol-2-ah/10-seven-levels-agentic-prompt-formats.assets.css
@@ -0,0 +1,281 @@
+/* AH-2 reuses the TAC-1 gold grammar and adds prompt-format teaching visuals. */
+@import url("../vol-1-tac/01-hello-agentic-coding.assets.css");
+
+:root {
+  --chapter-wide: 68.75rem;
+  --level-1: #8a6a45;
+  --level-2: #a55a22;
+  --level-3: #a33d2e;
+  --level-4: #8a3f06;
+  --level-5: #5f536e;
+  --level-6: #3d6b56;
+  --level-7: #2f5d68;
+}
+
+.hero--prompts {
+  background:
+    linear-gradient(120deg, transparent 0 57%, color-mix(in srgb, var(--accent-wash) 78%, transparent) 57% 100%),
+    var(--bg-card);
+}
+
+.hero--prompts::after { display: none; }
+
+.hero-stack {
+  display: grid;
+  grid-template-columns: repeat(7, minmax(0, 1fr));
+  gap: .45rem;
+  width: min(100%, 58rem);
+  margin-top: var(--space-7);
+  align-items: end;
+}
+
+.hero-stack__level {
+  display: grid;
+  place-items: end center;
+  min-height: calc(7rem + var(--i) * 1.35rem);
+  padding: .7rem .4rem;
+  border: 1px solid color-mix(in srgb, var(--accent) 62%, var(--border));
+  border-radius: var(--radius-md) var(--radius-md) 0 0;
+  color: var(--accent-ink);
+  background: color-mix(in srgb, var(--accent-wash) calc(40% + var(--i) * 6%), var(--bg-card));
+  text-align: center;
+}
+
+.hero-stack__level b { display: block; font: 700 var(--text-lg)/1 var(--font-display); }
+.hero-stack__level span { display: block; margin-top: .4rem; font-size: var(--text-xs); line-height: 1.25; }
+
+.section-grid,
+.audience-grid,
+.choice-grid,
+.practice-grid,
+.proof-grid,
+.confusion-grid,
+.lab-evidence,
+.level-cards,
+.prompt-scope,
+.format-strip {
+  display: grid;
+  gap: var(--space-3);
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+}
+
+.section-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.audience-grid,
+.choice-grid,
+.proof-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.practice-grid,
+.confusion-grid,
+.prompt-scope { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.lab-evidence { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.level-cards { grid-template-columns: repeat(7, minmax(8.5rem, 1fr)); overflow-x: auto; padding-bottom: var(--space-2); }
+
+.section-grid article,
+.audience-grid article,
+.choice-grid article,
+.practice-grid article,
+.proof-grid article,
+.confusion-grid article,
+.lab-evidence article,
+.level-cards article,
+.prompt-scope article {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.section-grid article { border-top: 4px solid var(--ink-mute); }
+.section-grid article:nth-child(4n + 1) { border-top-color: var(--accent); }
+.section-grid strong,
+.audience-grid strong,
+.choice-grid strong,
+.practice-grid strong,
+.proof-grid strong,
+.confusion-grid strong,
+.lab-evidence strong,
+.level-cards strong,
+.prompt-scope strong {
+  display: block;
+  color: var(--accent-ink);
+  font-family: var(--font-display);
+}
+
+.section-grid p,
+.audience-grid p,
+.choice-grid p,
+.practice-grid p,
+.proof-grid p,
+.confusion-grid p,
+.lab-evidence p,
+.level-cards p,
+.prompt-scope p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.audience-grid article:nth-child(3) { border-color: var(--accent); background: var(--accent-wash); }
+
+.level-staircase {
+  display: grid;
+  gap: .4rem;
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.level-step {
+  display: grid;
+  grid-template-columns: 4.1rem minmax(11rem, .65fr) minmax(0, 1.35fr) 5.2rem;
+  gap: var(--space-3);
+  align-items: center;
+  width: calc(58% + var(--i) * 6%);
+  min-height: 4.5rem;
+  padding: var(--space-3) var(--space-4);
+  border-left: .42rem solid var(--level-color);
+  border-radius: 0 var(--radius-md) var(--radius-md) 0;
+  background: color-mix(in srgb, var(--level-color) 9%, var(--bg-card));
+}
+
+.level-step__n { color: var(--level-color); font: 750 var(--text-xl)/1 var(--font-display); }
+.level-step strong { color: var(--ink); font-family: var(--font-display); }
+.level-step p { color: var(--ink-soft); font-size: var(--text-sm); }
+.level-step__grade { justify-self: end; color: var(--level-color); font: 750 var(--text-sm) var(--font-mono); }
+
+.flow-lens {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr auto 1fr;
+  gap: var(--space-3);
+  align-items: stretch;
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  padding: clamp(1.2rem, 4vw, 2.8rem);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: linear-gradient(135deg, var(--bg-card), var(--accent-wash));
+  box-shadow: var(--shadow-card);
+}
+
+.flow-lens__block { display: grid; align-content: center; min-height: 12rem; padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); text-align: center; }
+.flow-lens__block b { color: var(--accent-ink); font: 650 var(--text-lg)/1.1 var(--font-display); }
+.flow-lens__block code { margin-top: var(--space-2); }
+.flow-lens__block p { margin-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
+.flow-lens__arrow { display: grid; place-items: center; color: var(--accent); font: 750 var(--text-xl) var(--font-display); }
+
+.prompt-snippet {
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-code);
+}
+.prompt-snippet pre { margin: 0; border: 0; padding: 0; white-space: pre-wrap; }
+.prompt-snippet__note { margin-top: var(--space-3); color: var(--ink-mute); font-size: var(--text-sm); }
+
+.tier-figure { width: 100%; max-width: min(100%, var(--chapter-wide)); margin-inline: auto; }
+.tier-grid {
+  display: grid;
+  grid-template-columns: 5.7rem repeat(5, minmax(8rem, 1fr));
+  overflow-x: auto;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.tier-cell {
+  min-height: 8.2rem;
+  padding: var(--space-3);
+  border-right: var(--hairline);
+  border-bottom: var(--hairline);
+  background: color-mix(in srgb, var(--cell-color, var(--bg-card)) 7%, var(--bg-card));
+}
+.tier-cell--axis { display: grid; place-items: center; min-height: 4rem; color: var(--ink-soft); background: var(--bg-inset); font: 700 var(--text-sm) var(--font-mono); text-align: center; }
+.tier-cell--row { color: var(--accent-ink); font-size: var(--text-xs); font-weight: 750; text-transform: uppercase; }
+.tier-pill { display: block; width: fit-content; margin: .28rem 0; padding: .25rem .45rem; border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border)); border-radius: 999px; color: var(--ink); background: var(--bg-card); font-size: var(--text-xs); line-height: 1.25; }
+.tier-pill--format { border-color: var(--accent); color: var(--accent-ink); font-weight: 750; }
+
+.format-strip { grid-template-columns: repeat(7, minmax(8.5rem, 1fr)); overflow-x: auto; }
+.format-strip article { min-height: 12rem; padding: var(--space-3); border-top: .38rem solid var(--level-color); border-radius: var(--radius-md); background: color-mix(in srgb, var(--level-color) 8%, var(--bg-card)); }
+.format-strip b { display: block; color: var(--level-color); font: 750 var(--text-lg)/1 var(--font-display); }
+.format-strip strong { display: block; margin-top: var(--space-2); font-family: var(--font-display); }
+.format-strip p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-xs); }
+
+.scope-axis {
+  position: relative;
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  padding: var(--space-6);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+.scope-axis__line { height: .5rem; margin: var(--space-6) 2rem var(--space-2); border-radius: 999px; background: linear-gradient(90deg, var(--ok), var(--accent), var(--warn)); }
+.scope-axis__labels { display: flex; justify-content: space-between; gap: var(--space-4); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.decision-table { overflow-x: auto; width: 100%; max-width: min(100%, var(--chapter-wide)); margin-inline: auto; border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.decision-table table { min-width: 52rem; }
+
+.rubric-grid { display: grid; grid-template-columns: 1.35fr repeat(4, minmax(7rem, .75fr)); width: 100%; max-width: min(100%, var(--chapter-wide)); margin-inline: auto; overflow: hidden; border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.rubric-grid > div { padding: var(--space-3); border-right: var(--hairline); border-bottom: var(--hairline); }
+.rubric-grid .rubric-head { color: var(--accent-ink); background: var(--accent-wash); font-weight: 750; }
+
+.lab-checklist { padding: 0; list-style: none; }
+.lab-checklist li { position: relative; padding-left: 2rem; }
+.lab-checklist li::before { position: absolute; left: 0; content: "□"; color: var(--accent-ink); font: 700 1.25rem var(--font-mono); }
+
+.chapter-main .frame-card { width: min(68.75rem, calc(100vw - var(--rail-width) - var(--space-8) - 4rem)); max-width: none; }
+.frame-card img { width: 100%; max-width: 68.75rem; aspect-ratio: 16 / 9; object-fit: contain; background: var(--bg-card); }
+.frame-card figcaption { max-width: none; }
+.frame-sequence { display: grid; gap: var(--space-6); width: 100%; max-width: min(100%, var(--chapter-wide)); margin-inline: auto; }
+
+.teach-back { width: 100%; max-width: min(100%, var(--chapter-wide)); margin-inline: auto; }
+.source-note { padding: var(--space-4); border-left: 4px solid var(--ink-mute); background: var(--bg-inset); color: var(--ink-soft); font-size: var(--text-sm); }
+.graded-badge { display: inline-flex; padding: .2rem .55rem; border-radius: 999px; color: var(--ok); background: var(--ok-wash); font-size: var(--text-xs); font-weight: 750; letter-spacing: .05em; text-transform: uppercase; }
+
+@media (max-width: 72rem) {
+  .section-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .audience-grid,
+  .choice-grid,
+  .proof-grid,
+  .lab-evidence { grid-template-columns: 1fr; }
+  .level-step { width: 100%; }
+}
+
+@media (max-width: 52rem) {
+  .hero-stack { grid-template-columns: 1fr; align-items: stretch; }
+  .hero-stack__level { min-height: auto; place-items: center start; grid-template-columns: 2.5rem 1fr; text-align: left; }
+  .section-grid,
+  .practice-grid,
+  .confusion-grid,
+  .prompt-scope { grid-template-columns: 1fr; }
+  .level-step { grid-template-columns: 3.2rem 1fr; }
+  .level-step p { grid-column: 2; }
+  .level-step__grade { grid-column: 2; justify-self: start; }
+  .flow-lens { grid-template-columns: 1fr; }
+  .flow-lens__arrow { transform: rotate(90deg); }
+  .rubric-grid { grid-template-columns: 1fr; }
+  .rubric-grid > div { border-right: 0; }
+}
+
+@media print {
+  .hero-stack,
+  .level-staircase,
+  .flow-lens,
+  .tier-figure,
+  .prompt-scope,
+  .frame-card { break-inside: avoid; }
+  .level-step { width: 100%; }
+  .section-grid { grid-template-columns: repeat(2, 1fr); }
+  .tier-grid { grid-template-columns: 4.5rem repeat(5, 1fr); font-size: 8pt; }
+  .tier-cell { min-height: 5.7rem; padding: .35rem; }
+  .tier-pill { font-size: 7pt; }
+}
