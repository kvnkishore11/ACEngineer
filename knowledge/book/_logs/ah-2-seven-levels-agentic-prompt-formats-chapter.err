+              <tr><th scope="row"><code>## Variables</code></th><td>Section</td><td>A</td><td>B</td></tr>
+              <tr><th scope="row"><code>## Examples</code></th><td>Section</td><td>A</td><td>B</td></tr>
+              <tr><th scope="row"><code>## Expertise</code></th><td>Section</td><td>A</td><td>A</td></tr>
+              <tr><th scope="row"><code>## High Level Prompt</code></th><td>Section</td><td>B</td><td>D</td></tr>
+              <tr><th scope="row"><code>## Purpose</code></th><td>Section</td><td>B</td><td>D</td></tr>
+              <tr><th scope="row"><code>## Report</code></th><td>Section</td><td>B</td><td>C</td></tr>
+              <tr><th scope="row"><code>## Instructions</code></th><td>Section</td><td>B</td><td>C</td></tr>
+              <tr><th scope="row"><code># Title</code></th><td>Section</td><td>C</td><td>D</td></tr>
+              <tr><th scope="row"><code>## Metadata</code></th><td>Section</td><td>C</td><td>C</td></tr>
+              <tr><th scope="row"><code>## Codebase Structure</code></th><td>Section</td><td>C</td><td>C</td></tr>
+              <tr><th scope="row"><code>## Relevant Files</code></th><td>Section</td><td>C</td><td>C</td></tr>
+              <tr><th scope="row"><code>high_level_prompt.md</code></th><td>Format · L1</td><td>B</td><td>D</td></tr>
+              <tr><th scope="row"><code>workflow_prompt.md</code></th><td>Format · L2</td><td>A</td><td>C</td></tr>
+              <tr><th scope="row"><code>control_flow_prompt.md</code></th><td>Format · L3</td><td>A</td><td>B</td></tr>
+              <tr><th scope="row"><code>delegate_prompt.md</code></th><td>Format · L4</td><td>S</td><td>A</td></tr>
+              <tr><th scope="row"><code>higher_order_prompt.md</code></th><td>Format · L5</td><td>B</td><td>A</td></tr>
+              <tr><th scope="row"><code>template_metaprompt.md</code></th><td>Format · L6</td><td>S</td><td>S</td></tr>
+              <tr><th scope="row"><code>self_improving_prompt.md</code></th><td>Format · L7</td><td>A</td><td>S</td></tr>
