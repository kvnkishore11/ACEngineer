+            <tr><th scope="row">Prompt classification · 20</th><td>All with line evidence</td><td>One weak proof</td><td>Several guessed</td><td>No audit</td></tr>
+            <tr><th scope="row">Variables · 15</th><td>Syntax + drift explained</td><td>Classes and path correct</td><td>One misconception</td><td>No run</td></tr>
+            <tr><th scope="row">Levels 1–4 runs · 20</th><td>Four capabilities evidenced</td><td>Four runs present</td><td>One run incomplete</td><td>Multiple missing</td></tr>
