+        <div class="decision-table"><table aria-label="Lab grading rubric">
+          <thead><tr><th scope="col">Dimension</th><th scope="col">Exemplary</th><th scope="col">Competent</th><th scope="col">Developing</th><th scope="col">Missing</th></tr></thead>
