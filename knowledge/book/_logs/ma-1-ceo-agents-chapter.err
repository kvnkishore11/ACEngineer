    .section-head p { color:var(--ink-mute); font-size:var(--text-sm); }
    .lesson-list { display:grid; gap:var(--space-2); margin-top:var(--space-4); }
    .lesson { display:grid; grid-template-columns:3rem minmax(0,1fr) auto; gap:var(--space-3); align-items:center; padding:var(--space-3) var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
    .lesson__n { color:var(--ink-mute); font:var(--text-sm) var(--font-mono); }
    .lesson strong { display:block; }
    .lesson p { color:var(--ink-mute); font-size:var(--text-sm); }
    .badge { padding:.2rem .55rem; border-radius:99px; font-size:var(--text-xs); font-weight:750; text-transform:uppercase; letter-spacing:.06em; }
    .badge--done { color:var(--ok); background:var(--ok-wash); }
    .badge--pending { color:var(--ink-mute); background:var(--bg-inset); }
    .volumes { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--space-4); margin-top:var(--space-4); }
    .volume-card { padding:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); }
    .volume-card h3 { margin-top:var(--space-2); }
    .volume-card p { margin-top:var(--space-3); color:var(--ink-soft); }
    .hub-footer { display:flex; justify-content:space-between; gap:var(--space-4); margin-top:var(--space-10); padding-top:var(--space-5); border-top:var(--hairline); color:var(--ink-mute); font-size:var(--text-sm); }
    @media (max-width:48rem) { .hero,.chapter-feature { grid-template-columns:1fr; } .chapter-feature__map { min-height:18rem; } .volumes { grid-template-columns:1fr; } .lesson { grid-template-columns:2rem minmax(0,1fr); } .lesson .badge { grid-column:2; justify-self:start; } }
  </style>
</head>
<body>
  <main class="hub">
    <header class="masthead">
      <a class="brand" href="index.html">IndyDevDan Expert Book</a>
      <span class="edition">GOLD PILOT · 2026</span>
    </header>

    <section class="hero">
      <div>
        <p class="eyebrow">Operate · retrieve · teach back</p>
        <h1>Build systems that build systems.</h1>
        <p class="hero__dek">A dense, teaching-first companion to IndyDevDan’s course system. Each chapter turns the video spine into mental models, worked codebase examples, failure repairs, retrieval practice, and graded labs.</p>
      </div>
      <aside class="progress-card" aria-label="Book progress">
        <p class="eyebrow">Corpus phase 1</p>
        <h2>14 of 18 chapters built</h2>
        <div class="progress-line" aria-hidden="true"><span></span></div>
        <p class="progress-copy"><span>77.8% complete</span><span>Volume II · 6 of 6</span></p>
      </aside>
    </section>

    <article class="chapter-feature">
      <div class="chapter-feature__copy">
        <p class="eyebrow">Now available · Volume II · Lesson 14</p>
        <h2>Building Agentic Layers</h2>
        <p class="chapter-feature__dek">Turn every tactic into one buildable object: a specialized layer that climbs from prime prompts and feedback loops to out-loop ADWs and an orchestrator that can run them.</p>
        <ul class="chapter-feature__meta"><li>Three Classes · twelve Grades</li><li>90–120 min capstone lab</li><li>13 full-width course frames</li><li>In-loop → out-loop → orchestrated</li></ul>
        <a class="button" href="vol-2-ah/14-building-agentic-layers.html">Start chapter →</a>
      </div>
      <div class="chapter-feature__map" aria-label="Agent expert learning loop">
        <div class="focus-three"><div>Class 1 · In-loop</div><div>Class 2 · Out-loop</div><div>Class 3 · Orchestrated</div></div>
      </div>
    </article>

    <section class="section" aria-labelledby="tac-heading">
      <div class="section-head"><div><p class="eyebrow">Volume I</p><h2 id="tac-heading">Tactical Agentic Coding</h2></div><p>8 of 8 chapters · 100%</p></div>
      <div class="lesson-list">
        <div class="lesson"><span class="lesson__n">01</span><div><strong><a href="vol-1-tac/01-hello-agentic-coding.html">Hello Agentic Coding</a></strong><p>Tactic: Stop Coding · Gold chapter</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">02</span><div><strong><a href="vol-1-tac/02-the-12-leverage-points.html">The 12 Leverage Points</a></strong><p>Tactic: Adopt Your Agent’s Perspective · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">03</span><div><strong><a href="vol-1-tac/03-success-is-planned.html">Success is Planned</a></strong><p>Tactic: Template Your Engineering · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">04</span><div><strong><a href="vol-1-tac/04-afk-agents.html">AFK Agents</a></strong><p>Tactic: Stay Out The Loop · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">05</span><div><strong><a href="vol-1-tac/05-close-the-loops.html">Close the Loops</a></strong><p>Tactic: Always Add Feedback Loops · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">06</span><div><strong><a href="vol-1-tac/06-let-your-agents-focus.html">Let Your Agents Focus</a></strong><p>Tactic: One Agent, One Prompt, One Purpose · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">07</span><div><strong><a href="vol-1-tac/07-zte-secret-of-agentic-engineering.html">ZTE Secret of Agentic Engineering</a></strong><p>Tactic: Target Zero-Touch Engineering · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">08</span><div><strong><a href="vol-1-tac/08-the-agentic-layer.html">The Agentic Layer</a></strong><p>Tactic: Prioritize Agentics · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="ah-heading">
      <div class="section-head"><div><p class="eyebrow">Volume II</p><h2 id="ah-heading">Agentic Horizon</h2></div><p>6 of 6 chapters · 100%</p></div>
      <div class="lesson-list">
        <div class="lesson"><span class="lesson__n">09</span><div><strong><a href="vol-2-ah/09-rd-framework-context-window-mastery.html">Elite Context Engineering</a></strong><p>AH-1 · R&amp;D framework · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">10</span><div><strong><a href="vol-2-ah/10-seven-levels-agentic-prompt-formats.html">Seven Levels Agentic Prompt Formats</a></strong><p>Tactic: Master the Seven Agentic Prompt Formats · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">11</span><div><strong><a href="vol-2-ah/11-building-domain-specific-agents.html">Building Domain-Specific Agents</a></strong><p>Tactic: Build Custom Agents · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">12</span><div><strong><a href="vol-2-ah/12-multi-agent-orchestration-the-o-agent.html">Multi-Agent Orchestration: The O-Agent</a></strong><p>Tactic: Orchestrate Your Agents · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">13</span><div><strong><a href="vol-2-ah/13-agent-experts.html">Agent Experts</a></strong><p>Tactic: Build Agents That Learn · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
        <div class="lesson"><span class="lesson__n">14</span><div><strong><a href="vol-2-ah/14-building-agentic-layers.html">Building Agentic Layers</a></strong><p>Tactic: Prioritize Agentics · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="roadmap-heading">
      <div class="section-head"><div><p class="eyebrow">Course spine</p><h2 id="roadmap-heading">Three-volume roadmap</h2></div><p>18 lessons · synthesis follows</p></div>
      <div class="volumes">
        <article class="volume-card"><p class="eyebrow">Volume I · 8 lessons</p><h3>Tactical Agentic Coding</h3><p>Operational tactics, leverage, planning, AFK agents, loops, focus, zero-touch engineering, and the agentic layer.</p></article>
        <article class="volume-card"><p class="eyebrow">Volume II · 6 lessons</p><h3>Agentic Horizon</h3><p>Context-window mastery, prompt formats, specialized agents, orchestration, agent experts, and agentic layers.</p></article>
        <article class="volume-card"><p class="eyebrow">Volume III · 4 lessons</p><h3>Multi-Agent Systems</h3><p>CEO, lead, UI, and verifier agents, followed by cross-volume synthesis and expert practice.</p></article>
      </div>
    </section>

    <footer class="hub-footer"><span>Light, offline-first teaching site</span><a href="data/curriculum.json">Curriculum data</a></footer>
  </main>
</body>
</html>

diff --git a/IndyDevDan/book/vol-3-ma/15-ceo-agents.assets.css b/IndyDevDan/book/vol-3-ma/15-ceo-agents.assets.css
new file mode 100644
index 0000000000000000000000000000000000000000..4197f868a2356338ddb417a05e7b4015d23d0632
--- /dev/null
+++ b/IndyDevDan/book/vol-3-ma/15-ceo-agents.assets.css
@@ -0,0 +1,256 @@
+/* MA-1 extends the gold TAC-1 chapter system with boardroom-specific teaching diagrams. */
+@import url("../vol-1-tac/01-hello-agentic-coding.assets.css");
+
+:root {
+  --board-revenue: #9b3f78;
+  --board-product: #8c6613;
+  --board-technical: #9a3652;
+  --board-contrarian: #9c4f1e;
+  --board-compounder: #2f7658;
+  --board-customer: #267277;
+  --board-market: #705488;
+  --board-moonshot: #356f9c;
+}
+
+.skip-link {
+  position: fixed;
+  top: .5rem;
+  left: .5rem;
+  z-index: 200;
+  padding: .55rem .8rem;
+  border-radius: var(--radius-sm);
+  color: var(--ink-inverse);
+  background: var(--accent-ink);
+  font-weight: 750;
+  text-decoration: none;
+  transform: translateY(-180%);
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.chapter-main .frame-card img {
+  aspect-ratio: 16 / 9;
+  object-fit: contain;
+  background: var(--bg-card);
+}
+
+.chapter-main .frame-card figcaption { color: var(--ink-mute); }
+
+.hero--board::before {
+  position: absolute;
+  inset: 1rem 1rem auto auto;
+  width: clamp(8rem, 22vw, 17rem);
+  height: clamp(8rem, 22vw, 17rem);
+  border: 1px solid var(--border);
+  border-radius: 50%;
+  background:
+    radial-gradient(circle, var(--accent) 0 .35rem, transparent .4rem),
+    radial-gradient(circle at 50% 8%, var(--board-revenue) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 85% 25%, var(--board-product) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 93% 63%, var(--board-technical) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 68% 91%, var(--board-contrarian) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 30% 91%, var(--board-compounder) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 7% 63%, var(--board-customer) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 15% 25%, var(--board-moonshot) 0 .3rem, transparent .35rem);
+  content: "";
+  opacity: .38;
+}
+
+.hero--board h1 { max-width: 9ch; }
+
+.decision-pipe {
+  display: grid;
+  grid-template-columns: 1fr auto 1.15fr auto 1fr;
+  gap: var(--space-3);
+  align-items: stretch;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.decision-pipe__node {
+  display: grid;
+  align-content: center;
+  min-height: 9rem;
+  padding: var(--space-4);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.decision-pipe__node--middle {
+  border: 1px solid var(--accent);
+  background: var(--accent-wash);
+}
+
+.decision-pipe__node b {
+  color: var(--accent-ink);
+  font-family: var(--font-display);
+  font-size: var(--text-lg);
+}
+
+.decision-pipe__node span { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.decision-pipe__arrow { align-self: center; color: var(--accent); font-size: var(--text-xl); font-weight: 800; }
+
+.board-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.board-seat {
+  min-height: 10rem;
+  padding: var(--space-4);
+  border-top: .32rem solid var(--seat, var(--accent));
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.board-seat b { display: block; font-family: var(--font-display); font-size: var(--text-md); }
+.board-seat span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.board-seat--revenue { --seat: var(--board-revenue); }
+.board-seat--product { --seat: var(--board-product); }
+.board-seat--technical { --seat: var(--board-technical); }
+.board-seat--contrarian { --seat: var(--board-contrarian); }
+.board-seat--compounder { --seat: var(--board-compounder); }
+.board-seat--customer { --seat: var(--board-customer); }
+.board-seat--market { --seat: var(--board-market); }
+.board-seat--moonshot { --seat: var(--board-moonshot); }
+
+.architecture {
+  display: grid;
+  grid-template-columns: .8fr 1fr 1.4fr;
+  gap: var(--space-4);
+  align-items: center;
+  padding: var(--space-6);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.architecture__node {
+  padding: var(--space-4);
+  border: 2px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--bg-inset);
+  text-align: center;
+}
+
+.architecture__node--ceo { border-color: var(--accent); background: var(--accent-wash); }
+.architecture__node b { display: block; font: 650 var(--text-md) var(--font-display); }
+.architecture__node code { display: inline-block; margin-top: var(--space-2); }
+.architecture__fan { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
+.architecture__fan span { padding: var(--space-2); border-radius: var(--radius-sm); background: var(--bg-inset); font-size: var(--text-sm); text-align: center; }
+
+.innovation-stack {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.innovation-card {
+  position: relative;
+  min-height: 17rem;
+  padding: var(--space-5);
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.innovation-card::after {
+  position: absolute;
+  right: -1rem;
+  bottom: -2rem;
+  color: var(--accent-wash);
+  content: attr(data-n);
+  font: 700 9rem/1 var(--font-display);
+}
+
+.innovation-card > * { position: relative; z-index: 1; }
+.innovation-card h3 { margin-top: var(--space-2); }
+.innovation-card p { margin-top: var(--space-3); color: var(--ink-soft); }
+
+.constraint-board {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: var(--space-5);
+  padding: var(--space-5);
+  border: 1px solid var(--terminal-border);
+  border-radius: var(--radius-lg);
+  color: var(--terminal-ink);
+  background: var(--terminal-bg);
+}
+
+.constraint-board__label { display: flex; justify-content: space-between; font: var(--text-sm) var(--font-mono); }
+.constraint-board__track { position: relative; height: 1rem; margin-top: var(--space-2); overflow: hidden; border-radius: 99px; background: var(--terminal-bar); }
+.constraint-board__fill { display: block; width: 68%; height: 100%; background: var(--ok); }
+.constraint-board__fill--warn { width: 100%; background: var(--warn); }
+.constraint-board__min { position: absolute; top: 0; bottom: 0; left: 40%; width: 2px; background: var(--ink-inverse); }
+
+.round-model {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  gap: var(--space-4);
+  align-items: center;
+}
+
+.round-model__round { padding: var(--space-5); border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.round-model__round h4 { margin-top: 0; }
+.round-model__agents { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); margin-top: var(--space-3); }
+.round-model__agents span { padding: var(--space-2); border-radius: var(--radius-sm); background: var(--bg-inset); font-size: var(--text-xs); text-align: center; }
+.round-model__arrow { color: var(--accent); font-size: var(--text-xl); }
+
+.truth-table td:first-child { width: 26%; font-weight: 700; }
+.truth-table td:nth-child(2) { width: 33%; color: var(--ink-soft); }
+.truth-table td:nth-child(3) { border-left: 3px solid var(--ok); }
+
+.brief-anatomy {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.brief-anatomy div { padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+.brief-anatomy b { display: block; color: var(--accent-ink); font-family: var(--font-display); font-size: var(--text-md); }
+.brief-anatomy span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.rubric-table th:first-child { width: 18%; }
+.rubric-table td:not(:first-child), .rubric-table th:not(:first-child) { text-align: center; }
+.rubric-table td:first-child { font-weight: 700; }
+
+.mastery-ladder { counter-reset: mastery; display: grid; gap: var(--space-3); margin-top: var(--space-5); }
+.mastery-ladder li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); max-width: none; padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); list-style: none; }
+.mastery-ladder li::before { counter-increment: mastery; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; color: var(--ink-inverse); background: var(--accent); content: counter(mastery); font-weight: 800; }
+
+.source-note { padding: var(--space-4); border-top: var(--hairline); color: var(--ink-mute); font-size: var(--text-sm); }
+
+@media (max-width: 56rem) {
+  .board-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .innovation-stack { grid-template-columns: 1fr; }
+  .architecture { grid-template-columns: 1fr; }
+  .round-model { grid-template-columns: 1fr; }
+  .round-model__arrow { transform: rotate(90deg); text-align: center; }
+}
+
+@media (max-width: 42rem) {
+  .decision-pipe { grid-template-columns: 1fr; }
+  .decision-pipe__arrow { transform: rotate(90deg); text-align: center; }
+  .board-grid,
+  .constraint-board,
+  .brief-anatomy { grid-template-columns: 1fr; }
+}
+
+@media print {
+  .hero--board::before { display: none; }
+  .innovation-card { min-height: 0; }
+  .board-grid { grid-template-columns: repeat(4, 1fr); }
+  .board-seat { min-height: 0; }
+  .source-note { display: none; }
+}
diff --git a/IndyDevDan/book/vol-3-ma/15-ceo-agents.html b/IndyDevDan/book/vol-3-ma/15-ceo-agents.html
new file mode 100644
index 0000000000000000000000000000000000000000..1fe0d0143ee52e8caec1104e0ce77d9d6a3eec86
--- /dev/null
+++ b/IndyDevDan/book/vol-3-ma/15-ceo-agents.html
@@ -0,0 +1,1154 @@
+<!DOCTYPE html>
+<html lang="en">
