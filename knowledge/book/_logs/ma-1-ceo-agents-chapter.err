diff --git a/IndyDevDan/book/vol-3-ma/15-ceo-agents.assets.css b/IndyDevDan/book/vol-3-ma/15-ceo-agents.assets.css
new file mode 100644
index 0000000000000000000000000000000000000000..4197f868a2356338ddb417a05e7b4015d23d0632
--- /dev/null
+++ b/IndyDevDan/book/vol-3-ma/15-ceo-agents.assets.css
@@ -0,0 +1,256 @@
+/* MA-1 extends the gold TAC-1 chapter system with boardroom-specific teaching diagrams. */
+@import url("../vol-1-tac/01-hello-agentic-coding.assets.css");
+
+:root {
+  --board-revenue: #9b3f78;
+  --board-product: #8c6613;
+  --board-technical: #9a3652;
+  --board-contrarian: #9c4f1e;
+  --board-compounder: #2f7658;
+  --board-customer: #267277;
+  --board-market: #705488;
+  --board-moonshot: #356f9c;
+}
+
+.skip-link {
+  position: fixed;
+  top: .5rem;
+  left: .5rem;
+  z-index: 200;
+  padding: .55rem .8rem;
+  border-radius: var(--radius-sm);
+  color: var(--ink-inverse);
+  background: var(--accent-ink);
+  font-weight: 750;
+  text-decoration: none;
+  transform: translateY(-180%);
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.chapter-main .frame-card img {
+  aspect-ratio: 16 / 9;
+  object-fit: contain;
+  background: var(--bg-card);
+}
+
+.chapter-main .frame-card figcaption { color: var(--ink-mute); }
+
+.hero--board::before {
+  position: absolute;
+  inset: 1rem 1rem auto auto;
+  width: clamp(8rem, 22vw, 17rem);
+  height: clamp(8rem, 22vw, 17rem);
+  border: 1px solid var(--border);
+  border-radius: 50%;
+  background:
+    radial-gradient(circle, var(--accent) 0 .35rem, transparent .4rem),
+    radial-gradient(circle at 50% 8%, var(--board-revenue) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 85% 25%, var(--board-product) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 93% 63%, var(--board-technical) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 68% 91%, var(--board-contrarian) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 30% 91%, var(--board-compounder) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 7% 63%, var(--board-customer) 0 .3rem, transparent .35rem),
+    radial-gradient(circle at 15% 25%, var(--board-moonshot) 0 .3rem, transparent .35rem);
+  content: "";
+  opacity: .38;
+}
+
+.hero--board h1 { max-width: 9ch; }
+
+.decision-pipe {
+  display: grid;
+  grid-template-columns: 1fr auto 1.15fr auto 1fr;
+  gap: var(--space-3);
+  align-items: stretch;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.decision-pipe__node {
+  display: grid;
+  align-content: center;
+  min-height: 9rem;
+  padding: var(--space-4);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.decision-pipe__node--middle {
+  border: 1px solid var(--accent);
+  background: var(--accent-wash);
+}
+
+.decision-pipe__node b {
+  color: var(--accent-ink);
+  font-family: var(--font-display);
+  font-size: var(--text-lg);
+}
+
+.decision-pipe__node span { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.decision-pipe__arrow { align-self: center; color: var(--accent); font-size: var(--text-xl); font-weight: 800; }
+
+.board-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.board-seat {
+  min-height: 10rem;
+  padding: var(--space-4);
+  border-top: .32rem solid var(--seat, var(--accent));
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.board-seat b { display: block; font-family: var(--font-display); font-size: var(--text-md); }
+.board-seat span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.board-seat--revenue { --seat: var(--board-revenue); }
+.board-seat--product { --seat: var(--board-product); }
+.board-seat--technical { --seat: var(--board-technical); }
+.board-seat--contrarian { --seat: var(--board-contrarian); }
+.board-seat--compounder { --seat: var(--board-compounder); }
+.board-seat--customer { --seat: var(--board-customer); }
+.board-seat--market { --seat: var(--board-market); }
+.board-seat--moonshot { --seat: var(--board-moonshot); }
+
+.architecture {
+  display: grid;
+  grid-template-columns: .8fr 1fr 1.4fr;
+  gap: var(--space-4);
+  align-items: center;
+  padding: var(--space-6);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.architecture__node {
+  padding: var(--space-4);
+  border: 2px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--bg-inset);
+  text-align: center;
+}
+
+.architecture__node--ceo { border-color: var(--accent); background: var(--accent-wash); }
+.architecture__node b { display: block; font: 650 var(--text-md) var(--font-display); }
+.architecture__node code { display: inline-block; margin-top: var(--space-2); }
+.architecture__fan { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
+.architecture__fan span { padding: var(--space-2); border-radius: var(--radius-sm); background: var(--bg-inset); font-size: var(--text-sm); text-align: center; }
+
+.innovation-stack {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.innovation-card {
+  position: relative;
+  min-height: 17rem;
+  padding: var(--space-5);
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.innovation-card::after {
+  position: absolute;
+  right: -1rem;
+  bottom: -2rem;
+  color: var(--accent-wash);
+  content: attr(data-n);
+  font: 700 9rem/1 var(--font-display);
+}
+
+.innovation-card > * { position: relative; z-index: 1; }
+.innovation-card h3 { margin-top: var(--space-2); }
+.innovation-card p { margin-top: var(--space-3); color: var(--ink-soft); }
+
+.constraint-board {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: var(--space-5);
+  padding: var(--space-5);
+  border: 1px solid var(--terminal-border);
+  border-radius: var(--radius-lg);
+  color: var(--terminal-ink);
+  background: var(--terminal-bg);
+}
+
+.constraint-board__label { display: flex; justify-content: space-between; font: var(--text-sm) var(--font-mono); }
+.constraint-board__track { position: relative; height: 1rem; margin-top: var(--space-2); overflow: hidden; border-radius: 99px; background: var(--terminal-bar); }
+.constraint-board__fill { display: block; width: 68%; height: 100%; background: var(--ok); }
+.constraint-board__fill--warn { width: 100%; background: var(--warn); }
+.constraint-board__min { position: absolute; top: 0; bottom: 0; left: 40%; width: 2px; background: var(--ink-inverse); }
+
+.round-model {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  gap: var(--space-4);
+  align-items: center;
+}
+
+.round-model__round { padding: var(--space-5); border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.round-model__round h4 { margin-top: 0; }
+.round-model__agents { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); margin-top: var(--space-3); }
+.round-model__agents span { padding: var(--space-2); border-radius: var(--radius-sm); background: var(--bg-inset); font-size: var(--text-xs); text-align: center; }
+.round-model__arrow { color: var(--accent); font-size: var(--text-xl); }
+
+.truth-table td:first-child { width: 26%; font-weight: 700; }
+.truth-table td:nth-child(2) { width: 33%; color: var(--ink-soft); }
+.truth-table td:nth-child(3) { border-left: 3px solid var(--ok); }
+
+.brief-anatomy {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.brief-anatomy div { padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+.brief-anatomy b { display: block; color: var(--accent-ink); font-family: var(--font-display); font-size: var(--text-md); }
+.brief-anatomy span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.rubric-table th:first-child { width: 18%; }
+.rubric-table td:not(:first-child), .rubric-table th:not(:first-child) { text-align: center; }
+.rubric-table td:first-child { font-weight: 700; }
+
+.mastery-ladder { counter-reset: mastery; display: grid; gap: var(--space-3); margin-top: var(--space-5); }
+.mastery-ladder li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); max-width: none; padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); list-style: none; }
+.mastery-ladder li::before { counter-increment: mastery; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; color: var(--ink-inverse); background: var(--accent); content: counter(mastery); font-weight: 800; }
+
+.source-note { padding: var(--space-4); border-top: var(--hairline); color: var(--ink-mute); font-size: var(--text-sm); }
+
+@media (max-width: 56rem) {
+  .board-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .innovation-stack { grid-template-columns: 1fr; }
+  .architecture { grid-template-columns: 1fr; }
+  .round-model { grid-template-columns: 1fr; }
+  .round-model__arrow { transform: rotate(90deg); text-align: center; }
+}
+
+@media (max-width: 42rem) {
+  .decision-pipe { grid-template-columns: 1fr; }
+  .decision-pipe__arrow { transform: rotate(90deg); text-align: center; }
+  .board-grid,
+  .constraint-board,
+  .brief-anatomy { grid-template-columns: 1fr; }
+}
+
+@media print {
+  .hero--board::before { display: none; }
+  .innovation-card { min-height: 0; }
+  .board-grid { grid-template-columns: repeat(4, 1fr); }
+  .board-seat { min-height: 0; }
+  .source-note { display: none; }
+}
diff --git a/IndyDevDan/book/vol-3-ma/15-ceo-agents.html b/IndyDevDan/book/vol-3-ma/15-ceo-agents.html
