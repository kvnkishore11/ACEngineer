+    <section class="section" aria-labelledby="ma-heading">
+      <div class="section-head"><div><p class="eyebrow">Volume III</p><h2 id="ma-heading">Multi-Agent Systems</h2></div><p>1 of 4 chapters · 25%</p></div>
+      <div class="lesson-list">
+        <div class="lesson"><span class="lesson__n">15</span><div><strong><a href="vol-3-ma/15-ceo-agents.html">CEO Agents</a></strong><p>Tactic: Agents That Decide · Chapter complete</p></div><span class="badge badge--done">Done</span></div>
+        <div class="lesson"><span class="lesson__n">16</span><div><strong>Multi-Team Agentic Coding / Lead Agents</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+        <div class="lesson"><span class="lesson__n">17</span><div><strong>Infinite UI Agents</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+        <div class="lesson"><span class="lesson__n">18</span><div><strong>The Pi Verifier Agent</strong><p>Chapter pending</p></div><span class="badge badge--pending">Pending</span></div>
+      </div>
+    </section>
+
     <section class="section" aria-labelledby="roadmap-heading">
