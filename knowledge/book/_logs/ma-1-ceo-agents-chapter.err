let bad=[];
for(const r of [...new Set(refs)]) {const p=path.resolve(base,r); if(!fs.existsSync(p)) bad.push({ref:r,resolved:p});}
console.log('"'local refs',new Set(refs).size,'missing',bad.length); if(bad.length) console.log(bad);
