+/* TAC-7 reuses the gold chapter shell and adds only lesson-specific teaching diagrams. */
+@import url("01-hello-agentic-coding.assets.css");
+
+:root {
+  --chapter-max: 86rem;
+}
+
+.hero--zte h1 { max-width: 15ch; }
+
+.velocity-scale,
+.posture-scale,
+.guardrail-stack,
+.primitive-map,
+.state-grid,
+.kpi-board {
+  display: grid;
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.velocity-scale { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.velocity-scale__step,
+.posture-scale__step,
+.guardrail-stack__gate,
+.primitive-map__column,
+.state-grid__item,
+.kpi-board__item {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.velocity-scale__step strong,
+.posture-scale__step strong,
+.primitive-map__column strong,
+.kpi-board__item strong {
+  display: block;
+  color: var(--accent-ink);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+}
+
+.velocity-scale__step span,
+.posture-scale__step span,
+.kpi-board__item span {
+  display: block;
+  margin-top: var(--space-1);
+  color: var(--ink-mute);
+  font-size: var(--text-sm);
+}
+
+.velocity-scale__step--target {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+  box-shadow: var(--shadow-card);
+}
+
+.posture-scale { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.posture-scale__step { min-height: 8.5rem; }
+.posture-scale__step--sprint { border: 2px solid var(--accent); background: var(--accent-wash); }
+
+.guardrail-stack { counter-reset: gate; }
+.guardrail-stack__gate {
+  position: relative;
+  padding-left: 4rem;
+}
+.guardrail-stack__gate::before {
+  counter-increment: gate;
+  position: absolute;
+  left: var(--space-4);
+  top: var(--space-4);
+  display: grid;
+  place-items: center;
+  width: 2rem;
+  height: 2rem;
+  border-radius: 50%;
+  color: var(--ink-inverse);
+  background: var(--accent);
+  content: counter(gate);
+  font: 700 var(--text-sm) var(--font-mono);
+}
+
+.primitive-map { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.primitive-map__column { position: relative; }
+.primitive-map__column:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: -1.1rem;
+  z-index: 2;
+  color: var(--accent);
+  content: "\2192";
+  font-size: var(--text-lg);
+  font-weight: 800;
+  transform: translateY(-50%);
+}
+.primitive-map__column ul { margin-top: var(--space-3); columns: 2; }
+.primitive-map__column:last-child { border-color: var(--accent); background: var(--accent-wash); }
+
+.state-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.state-grid__item code { display: inline-block; margin-bottom: var(--space-2); font-weight: 700; }
+.state-grid__item p { color: var(--ink-soft); font-size: var(--text-base); }
+
+.kpi-board { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.kpi-board__item { text-align: center; }
+.kpi-board__item strong { font-size: var(--text-xl); }
+
+.presence-ledger th:first-child,
+.presence-ledger td:first-child { width: 24%; }
+
+.proof-strip {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin-top: var(--space-4);
+  padding: 0;
+  list-style: none;
+}
+.proof-strip li {
+  padding: .25rem .65rem;
+  border-radius: 999px;
+  color: var(--ink-soft);
+  background: var(--bg-inset);
+  font-size: var(--text-sm);
+}
+
+.chapter-main .frame-card img {
+  max-width: min(100%, 1100px);
+  object-fit: contain;
+}
+
+@media (max-width: 46rem) {
+  .velocity-scale,
+  .posture-scale,
+  .primitive-map,
+  .state-grid,
+  .kpi-board { grid-template-columns: 1fr; }
+  .primitive-map__column:not(:last-child)::after { display: none; }
+  .primitive-map__column ul { columns: 1; }
+}
+
+@media print {
+  .velocity-scale,
+  .primitive-map,
+  .kpi-board { break-inside: avoid; }
+}
