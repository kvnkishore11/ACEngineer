puts \"missing=#{missing.join(',')}\" unless missing.empty?
puts \"ids=#{ids.size} duplicate_ids=#{ids.tally.select{|_,v|v>1}.keys.join(',')}\"
puts \"anchors=#{anchors.uniq.size} missing_anchors=#{missing_anchors.join(',')}\"
puts \"nav_refs=#{nav_refs.size} nav_missing=#{(nav_refs-ids).join(',')}\"
puts \"idea_sections=#{ideas.size}\"
ideas.each do |id, body|
  moves = body.scan(/class=\"move move--(hook|picture|story|name|example|try|fail|current|check|teach)\"/).flatten
  expected = %w[hook picture story name example try fail current check teach]
  puts \"#{id}: moves=#{moves.size} missing=#{(expected-moves).join(',')} duplicates=#{moves.tally.select{|_,v|v>1}.keys.join(',')}\"
end
puts \"frames=#{html.scan(/media\\/frames\\/tac-7-zte-secret-of-agentic-engineering\\//).size}\"
puts \"youtube_links=#{html.scan(%r{https://www\\.youtube\\.com/watch\\?v=}).size}\"
puts \"details=#{html.scan(/<details\\b/).size} summaries=#{html.scan(/<summary\\b/).size}\"
puts \"open_main=#{html.scan(/<main\\b/).size} close_main=#{html.scan(%r{</main>}).size} open_html=#{html.scan(/<html\\b/).size} close_html=#{html.scan(%r{</html>}).size}\"
RUBY
