     1	#!/usr/bin/env -S uv run --script
     2	# /// script
     3	# requires-python = ">=3.11"
     4	# dependencies = []
     5	# ///
     6	"""Verifier-side SQLite inspection. READ-ONLY. JSON output."""
     7	
     8	import argparse
     9	import json
    10	import re
    11	import sqlite3
    12	import subprocess
    13	import sys
    14	from typing import Any
    15	
    16	# ─── Allowlists ──────────────────────────────────────────────────────────────
    17	
    18	# PRAGMAs that are read-only / introspective. Anything not in this set is
    19	# rejected, including pragmas like `writable_schema`, `defer_foreign_keys`,
    20	# `journal_mode`, etc., which can mutate database state or behavior.
    21	PRAGMA_ALLOWLIST: set[str] = {
    22	    "integrity_check",
    23	    "foreign_key_list",
    24	    "foreign_key_check",
    25	    "index_list",
    26	    "index_info",
    27	    "table_info",
    28	    "table_xinfo",
    29	    "database_list",
    30	    "schema_version",
    31	    "user_version",
    32	}
    33	
    34	# Keywords we recognize as deterministic mutations. Used only to enrich the
    35	# `reason` field of the structured error — actual gating is "not in allowlist".
    36	MUTATION_KEYWORDS: dict[str, str] = {
    37	    "INSERT": "INSERT is a mutation — verifier is read-only",
    38	    "UPDATE": "UPDATE is a mutation — verifier is read-only",
    39	    "DELETE": "DELETE is a mutation — verifier is read-only",
    40	    "DROP": "DROP is a mutation — verifier is read-only",
    41	    "ALTER": "ALTER is a mutation — verifier is read-only",
    42	    "CREATE": "CREATE is a mutation — verifier is read-only",
    43	    "REPLACE": "REPLACE is a mutation — verifier is read-only",
    44	    "TRUNCATE": "TRUNCATE is a mutation — verifier is read-only",
    45	    "REINDEX": "REINDEX rewrites indexes — verifier is read-only",
    46	    "VACUUM": "VACUUM rewrites the database — verifier is read-only",
    47	    "ATTACH": "ATTACH can introduce mutable connections — not permitted",
    48	    "DETACH": "DETACH mutates connection state — not permitted",
    49	    "BEGIN": "transactions are not permitted in the read-only verifier",
    50	    "COMMIT": "transactions are not permitted in the read-only verifier",
    51	    "ROLLBACK": "transactions are not permitted in the read-only verifier",
    52	    "SAVEPOINT": "transactions are not permitted in the read-only verifier",
    53	    "RELEASE": "transactions are not permitted in the read-only verifier",
    54	}
    55	
    56	ALLOWED_FORMS: list[str] = [
    57	    "dot-commands (e.g. .schema, .tables, .indexes)",
    58	    "SELECT ...",
    59	    "WITH ... SELECT ...",
    60	    "EXPLAIN <query>",
    61	    "PRAGMA integrity_check | foreign_key_list(<table>) | index_list(<table>) | table_info(<table>) | etc.",
    62	]
    63	
    64	
    65	# ─── Helpers ─────────────────────────────────────────────────────────────────
    66	
    67	def open_ro(path: str) -> sqlite3.Connection:
    68	    """Open the SQLite DB read-only via URI flags. Defense-in-depth: even if
    69	    a mutation string somehow reached this script, SQLite would refuse it."""
    70	    return sqlite3.connect(f"file:{path}?mode=ro&immutable=1", uri=True)
    71	
    72	
    73	def emit(payload: dict[str, Any], *, exit_code: int = 0) -> None:
    74	    """Print one JSON object to stdout and exit with the given code."""
    75	    sys.stdout.write(json.dumps(payload))
    76	    sys.stdout.write("\n")
    77	    sys.stdout.flush()
    78	    sys.exit(exit_code)
    79	
    80	
    81	def reject(received: str, reason: str, hint: str) -> None:
    82	    """Structured JSON rejection per PRE_INIT_DECISIONS.md Q5 ("Error
    83	    feedback shape"). Always exits non-zero."""
    84	    emit(
    85	        {
    86	            "error": "command not permitted in read-only verifier",
    87	            "received": received,
    88	            "reason": reason,
    89	            "allowed": ALLOWED_FORMS,
    90	            "hint": hint,
    91	        },
    92	        exit_code=2,
    93	    )
    94	
    95	
    96	def first_token(s: str) -> str:
    97	    """Return the first whitespace-delimited token, uppercased. Empty string
    98	    if the input is blank."""
    99	    stripped = s.lstrip()
   100	    if not stripped:
   101	        return ""
   102	    # Split on any whitespace; take the first chunk.
   103	    return stripped.split(None, 1)[0].upper()
   104	
   105	
   106	def extract_pragma_name(cmd: str) -> str | None:
   107	    """Return the pragma name following the `PRAGMA` keyword, lowercased.
   108	    Handles `PRAGMA name`, `PRAGMA name(arg)`, `PRAGMA name = value`."""
   109	    # \bPRAGMA\b followed by whitespace, then the identifier.
   110	    m = re.match(r"\s*PRAGMA\s+([A-Za-z_][A-Za-z0-9_]*)", cmd, re.IGNORECASE)
   111	    if not m:
   112	        return None
   113	    return m.group(1).lower()
   114	
   115	
   116	# ─── Routes ──────────────────────────────────────────────────────────────────
   117	
   118	def route_dot_command(db: str, cmd: str) -> None:
   119	    """Shell out to the sqlite3 CLI in -readonly mode. Print stdout/stderr as
   120	    JSON. Non-zero exit propagates."""
   121	    try:
   122	        proc = subprocess.run(
   123	            ["sqlite3", "-readonly", db, cmd],
   124	            capture_output=True,
   125	            text=True,
   126	            check=False,
   127	        )
   128	    except FileNotFoundError:
   129	        emit(
   130	            {
   131	                "error": "sqlite3 CLI not found on PATH",
   132	                "received": cmd,
   133	                "hint": "Install sqlite3 or use SELECT/PRAGMA via the Python module path.",
   134	            },
   135	            exit_code=3,
   136	        )
   137	        return  # unreachable; emit() exits
   138	
   139	    payload: dict[str, Any] = {"stdout": proc.stdout, "stderr": proc.stderr}
   140	    if proc.returncode != 0:
   141	        payload["exit"] = proc.returncode
   142	        emit(payload, exit_code=proc.returncode if proc.returncode != 0 else 1)
   143	    emit(payload, exit_code=0)
   144	
   145	
   146	def route_query(db: str, cmd: str) -> None:
   147	    """SELECT / WITH / EXPLAIN — execute via the Python sqlite3 module under
   148	    the read-only URI. Return columns + rows JSON."""
   149	    try:
   150	        with open_ro(db) as conn:
   151	            cur = conn.execute(cmd)
   152	            columns = [c[0] for c in cur.description] if cur.description else []
   153	            rows = [list(r) for r in cur.fetchall()]
   154	    except sqlite3.Error as e:
   155	        emit(
   156	            {
   157	                "error": "sqlite error",
   158	                "received": cmd,
   159	                "reason": str(e),
   160	                "hint": "Check the query syntax and that referenced tables/columns exist.",
   161	            },
   162	            exit_code=4,
   163	        )
   164	        return  # unreachable
   165	    emit({"columns": columns, "rows": rows}, exit_code=0)
   166	
   167	
   168	def route_pragma(db: str, cmd: str) -> None:
   169	    """PRAGMA — validate the name against the allowlist, then execute via the
   170	    Python sqlite3 module."""
   171	    name = extract_pragma_name(cmd)
   172	    if name is None:
   173	        reject(
   174	            received=cmd,
   175	            reason="could not parse PRAGMA name",
   176	            hint="Use the form: PRAGMA <name> or PRAGMA <name>(<arg>).",
   177	        )
   178	        return  # unreachable
   179	
   180	    if name not in PRAGMA_ALLOWLIST:
   181	        reject(
   182	            received=cmd,
   183	            reason=(
   184	                f"PRAGMA {name} is not on the read-only allowlist "
   185	                f"(it can mutate state or change connection behavior)"
   186	            ),
   187	            hint=(
   188	                "Allowed PRAGMAs: "
   189	                + ", ".join(sorted(PRAGMA_ALLOWLIST))
   190	                + ". For schema introspection prefer .schema or PRAGMA table_info(<table>)."
   191	            ),
   192	        )
   193	        return  # unreachable
   194	
   195	    try:
   196	        with open_ro(db) as conn:
   197	            cur = conn.execute(cmd)
   198	            columns = [c[0] for c in cur.description] if cur.description else []
   199	            rows = [list(r) for r in cur.fetchall()]
   200	    except sqlite3.Error as e:
   201	        emit(
   202	            {
   203	                "error": "sqlite error",
   204	                "received": cmd,
   205	                "reason": str(e),
   206	                "hint": "Check the PRAGMA arguments — e.g. PRAGMA table_info(users) needs a real table name.",
   207	            },
   208	            exit_code=4,
   209	        )
   210	        return  # unreachable
   211	    emit({"columns": columns, "rows": rows}, exit_code=0)
   212	
   213	
   214	# ─── Main ────────────────────────────────────────────────────────────────────
   215	
   216	def main() -> None:
   217	    parser = argparse.ArgumentParser(
   218	        description="Verifier-side SQLite inspection. READ-ONLY. JSON output.",
   219	        add_help=True,
   220	    )
   221	    parser.add_argument("db", help="Path to the SQLite database file.")
   222	    parser.add_argument(
   223	        "command",
   224	        help='A sqlite3 command — dot-command (e.g. ".schema"), SELECT/WITH/EXPLAIN query, or read-only PRAGMA.',
   225	    )
   226	
   227	    # argparse errors itself need to come out as JSON, not plain text.
   228	    try:
   229	        args = parser.parse_args()
   230	    except SystemExit as e:
   231	        # argparse already printed to stderr; emit a JSON shim so callers that
   232	        # only read stdout still see something structured.
   233	        sys.stdout.write(
   234	            json.dumps(
   235	                {
   236	                    "error": "invalid arguments",
   237	                    "hint": 'Usage: verify_sqlite.py <db> "<sqlite3 command>"',
   238	                }
   239	            )
   240	            + "\n"
   241	        )
   242	        sys.stdout.flush()
   243	        raise SystemExit(e.code if isinstance(e.code, int) else 2)
   244	
   245	    raw_cmd: str = args.command
   246	    cmd = raw_cmd.lstrip()
   247	
   248	    if cmd == "":
   249	        reject(
   250	            received=raw_cmd,
   251	            reason="command was empty",
   252	            hint='Pass a sqlite3 command, e.g. ".schema" or "SELECT count(*) FROM users".',
   253	        )
   254	        return  # unreachable
   255	
   256	    # 1. Dot-command — shell out to sqlite3 -readonly.
   257	    if cmd.startswith("."):
   258	        route_dot_command(args.db, cmd)
   259	        return  # unreachable
   260	
   261	    tok = first_token(cmd)
   262	
   263	    # 2. SELECT / WITH / EXPLAIN — Python module read-only.
   264	    if tok in {"SELECT", "WITH", "EXPLAIN"}:
   265	        route_query(args.db, cmd)
   266	        return  # unreachable
   267	
   268	    # 3. PRAGMA — validate name then execute read-only.
   269	    if tok == "PRAGMA":
   270	        route_pragma(args.db, cmd)
   271	        return  # unreachable
   272	
   273	    # 4. Anything else — structured JSON error.
   274	    reason = MUTATION_KEYWORDS.get(
   275	        tok,
   276	        f"`{tok or '<empty>'}` is not a recognized read-only sqlite3 command",
   277	    )
   278	    # Tailor the hint a bit based on the token.
   279	    if tok == "INSERT":
   280	        hint = "If you want to verify table contents, use: SELECT count(*) FROM <table>"
   281	    elif tok == "UPDATE":
   282	        hint = "If you want to inspect rows, use: SELECT * FROM <table> WHERE <cond>"
   283	    elif tok == "DELETE":
   284	        hint = "If you want to count matching rows, use: SELECT count(*) FROM <table> WHERE <cond>"
   285	    elif tok in {"DROP", "ALTER", "CREATE"}:
   286	        hint = "If you want to inspect schema, use: .schema  or  PRAGMA table_info(<table>)"
   287	    else:
   288	        hint = (
   289	            "Use a dot-command (.schema, .tables), a SELECT/WITH query, EXPLAIN, "
   290	            "or a read-only PRAGMA. The verifier never mutates state."
   291	        )
   292	
   293	    reject(received=raw_cmd, reason=reason, hint=hint)
   294	
   295	
   296	if __name__ == "__main__":
   297	    main()

