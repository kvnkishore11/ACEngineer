@@ -0,0 +1,575 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="A teaching-first companion to MA-4: The Pi Verifier Agent. Learn the two-agent observer loop, atomic verification, read-only architecture, the verifier Report flywheel, and a graded course-repository lab.">
+  <title>MA-4 · The Pi Verifier Agent — IndyDevDan Expert Book</title>
+  <link rel="stylesheet" href="../design/tokens.css">
+  <link rel="stylesheet" href="../design/base.css">
+  <link rel="stylesheet" href="../design/components.css">
+  <link rel="stylesheet" href="../vol-1-tac/01-hello-agentic-coding.assets.css">
+  <link rel="stylesheet" href="18-verifier-agent.assets.css">
+</head>
+<body>
+  <a class="skip-link" href="#main-content">Skip to chapter</a>
+  <div class="reading-progress" aria-hidden="true"><span class="reading-progress__bar" id="top-progress"></span></div>
+  <header class="site-bar">
+    <a class="site-bar__home" href="../index.html" aria-label="Back to the book hub">← IndyDevDan Expert Book</a>
+    <span class="site-bar__meta">VOL III · MA · LESSON 18</span>
+  </header>
+
+  <div class="chapter-shell">
+    <aside class="chapter-rail" aria-label="Chapter navigation">
+      <p class="rail-kicker">Volume III · Multi-Agent Systems</p>
+      <h2>The Pi Verifier Agent</h2>
+      <div class="rail-progress">
+        <p class="micro-label">Reading progress</p>
+        <div class="rail-progress__line"><span class="rail-progress__fill" id="rail-progress"></span></div>
+        <p class="rail-progress__copy"><span id="progress-label">0%</span><span>of chapter</span></p>
+      </div>
+      <nav class="chapter-nav" aria-label="On this page">
+        <ol>
+          <li><a href="#orientation"><span class="chapter-nav__n">00</span><span>Orientation</span></a></li>
+          <li><a href="#observer"><span class="chapter-nav__n">01</span><span>The observer loop</span></a></li>
+          <li><a href="#review"><span class="chapter-nav__n">02</span><span>The review constraint</span></a></li>
+          <li><a href="#atoms"><span class="chapter-nav__n">03</span><span>Atomic claims</span></a></li>
+          <li><a href="#tokens"><span class="chapter-nav__n">04</span><span>Tokens for time</span></a></li>
+          <li><a href="#trust-scale"><span class="chapter-nav__n">05</span><span>Trust AND scale</span></a></li>
+          <li><a href="#template"><span class="chapter-nav__n">06</span><span>Template by force</span></a></li>
+          <li><a href="#read-only"><span class="chapter-nav__n">07</span><span>Read-only architecture</span></a></li>
+          <li><a href="#flywheel"><span class="chapter-nav__n">08</span><span>The Report flywheel</span></a></li>
+          <li><a href="#stack"><span class="chapter-nav__n">09</span><span>Stack intelligence</span></a></li>
+          <li><a href="#current-practice"><span class="chapter-nav__n">10</span><span>Current practice</span></a></li>
+          <li><a href="#lab"><span class="chapter-nav__n">11</span><span>Graded lab</span></a></li>
+          <li><a href="#mastery"><span class="chapter-nav__n">12</span><span>Cumulative mastery</span></a></li>
+          <li><a href="#glossary"><span class="chapter-nav__n">13</span><span>Glossary</span></a></li>
+        </ol>
+      </nav>
+    </aside>
+
+    <main class="chapter-main" id="main-content">
+      <header class="hero hero--verifier">
+        <span class="hero__chapter">MA-4 · Spend tokens to save time</span>
+        <h1>The Pi Verifier Agent</h1>
+        <p class="hero__dek">Stop hand-checking every “done.” Put a second, input-locked, read-only agent behind the builder. It wakes on every stop event, turns the builder’s claims into atomic propositions, proves each against actual state, and sends one concrete correction back when proof fails.</p>
+        <ul class="hero__meta" aria-label="Chapter details">
+          <li>Video spine · 32:51</li>
+          <li>Lab · 60–90 min</li>
+          <li>Course repo · the-verifier-agent-system</li>
+          <li>Level · advanced shipping engineer</li>
+        </ul>
+        <p class="hero__promise"><strong>Mastery promise.</strong> By the end, you will be able to trace the builder/verifier lifecycle without calling it delegation, decompose a bundled claim into deterministic checks, explain the token-for-time trade, defend the three read-only layers, read the Report as a control surface, improve a verifier through its files instead of a one-off prompt, and reproduce the SQLite fail→feedback→repair→PERFECT loop in the real course codebase.</p>
+
+        <div class="hero-loop" role="img" aria-label="An engineer prompts a builder. A private socket carries lifecycle events to an input-locked verifier, which reads the builder session and can send corrective feedback back to the builder.">
+          <div class="hero-loop__node">
+            <b>Builder</b>
+            <span>Interactive. Writes, edits, generates, and reports what it did.</span>
+          </div>
+          <div class="hero-loop__channel">start · stop · error<br>private unix socket</div>
+          <div class="hero-loop__node hero-loop__node--verifier">
+            <b>Verifier</b>
+            <span>Observes. Reads the turn slice, proves claims, and prompts back only on failure.</span>
+          </div>
+          <div class="hero-loop__lock">Input locked · rules live in persona + script + template</div>
+        </div>
+      </header>
+
+      <div class="mobile-toc">
+        <details>
+          <summary>Chapter contents</summary>
+          <ol>
+            <li><a href="#orientation">Orientation</a></li>
+            <li><a href="#observer">The two-agent observer loop</a></li>
+            <li><a href="#review">The review constraint</a></li>
+            <li><a href="#atoms">Atomic claims</a></li>
+            <li><a href="#tokens">Spend tokens to save time</a></li>
+            <li><a href="#trust-scale">Trust AND scale</a></li>
+            <li><a href="#template">Template engineering by force</a></li>
+            <li><a href="#read-only">Read-only by architecture</a></li>
+            <li><a href="#flywheel">The Report flywheel</a></li>
+            <li><a href="#stack">Stack intelligence and own the harness</a></li>
+            <li><a href="#current-practice">Current practice companions</a></li>
+            <li><a href="#lab">Graded lab</a></li>
+            <li><a href="#mastery">Cumulative mastery</a></li>
+            <li><a href="#glossary">Glossary</a></li>
+          </ol>
+        </details>
+      </div>
+
+      <section class="chapter-section" id="orientation">
+        <span class="section-number">00</span>
+        <h2 class="section-title">Move review out of your head</h2>
+        <p class="section-lead">The builder says it created the table, added the foreign key, applied the migration, and checked the result. That sentence is not evidence. It is a bundle of claims that has quietly transferred a new job to you: prove that every part is true.</p>
+
+        <p>The course system moves that job to a second Pi process. The builder remains the normal interactive agent. The verifier appears beside it in a sibling window, but its input is disabled. When the builder finishes a turn, the builder-side extension emits a <code>stop</code> lifecycle event over a private unix socket. The verifier-side extension renders the same <code>verify_on_stop.md</code> template every cycle, reads only that turn’s slice from the builder’s session JSONL, decomposes the request and result into atomic claims, and checks them through the tools allowed by its domain persona.</p>
+
+        <p>If the claims hold, the verifier ends with a structured Report and stays out of the builder’s way. If a claim fails and the fix is concrete, its sole outbound tool—<code>verifier_prompt</code>—sends a correction to the builder. The builder receives that message as a follow-up turn, repairs the work, and triggers verification again. The course default allows three correction loops; after that, the system escalates to the human instead of pretending progress.</p>
+
+        <aside class="callout callout--tactic">
+          <p class="callout__label">The tactic</p>
+          <p><strong>Spend tokens to save time.</strong> Use a second, different, read-only agent to prove the builder’s atomic claims. Trade 2–5× the tokens for review hours you do not have to spend yourself.</p>
+        </aside>
+
+        <h3>What this is—and what it is not</h3>
+        <div class="comparison">
+          <article class="comparison__card">
+            <div class="comparison__head"><h3>Not model delegation</h3><p>The builder model does not decide to call a verifier or coordinate its proof work.</p></div>
+            <div class="comparison__body"><p>The builder harness does know: it owns the socket, spawns the child, shows connection state, and injects corrections. The separation is outside the builder model’s task flow.</p></div>
+          </article>
+          <article class="comparison__card comparison__card--agentic">
+            <div class="comparison__head"><h3>A top-down observer</h3><p>The verifier is attached to the builder’s lifecycle and proof surface.</p></div>
+            <div class="comparison__body"><p>It wakes automatically, reads the bounded session slice, checks actual state, and returns only a correction or a Report.</p></div>
+          </article>
+        </div>
+
+        <h3>Five outcomes to train</h3>
+        <ul class="learning-objectives">
+          <li><strong>Trace the system</strong>Explain what triggers verification, what crosses the socket, what is read from disk, and how a correction becomes a builder follow-up.</li>
+          <li><strong>Decompose proof</strong>Turn one confident summary into independently testable atoms with domain-appropriate evidence for each.</li>
+          <li><strong>Engineer authority</strong>Distinguish a prompt-level request for safety from the persona, tool-call, and connection layers that enforce it.</li>
+          <li><strong>Improve the class</strong>Convert an unverifiable gap into a durable persona, script, or template improvement without typing at the verifier.</li>
+          <li><strong>Operate the real loop</strong>Use <code>just vsql</code> and the shipped files to catch a planted schema defect and collect proof of automatic repair.</li>
+        </ul>
+
+        <aside class="callout callout--warning">
+          <p class="callout__label">Accuracy boundary</p>
+          <p>The recording and the checked-in files differ in a few places. The video’s SQLite verifier uses GLM 5.1; the current persona file declares <code>openai/gpt-5.5</code>. The README’s old “v1 limitations” paragraph says only SQLite ships, while the local tree contains full generic, SQLite, image, and Python personas. This chapter labels those differences and treats the files as the operational source of truth.</p>
+        </aside>
+
+        <h3>How to study the chapter</h3>
+        <p>Each of the nine ideas follows the same active sequence: feel the failure, see the system, replay a frame-backed moment, name the concept, inspect the course source, attempt a small task, diagnose a tempting error, update the idea for current practice, retrieve it from memory, and teach it back. Do the “You try” prompt before opening the retrieval answers. In the lab, save exact commands and outputs. “The verifier looked green” is a weak claim; “<code>atomic_claims_failed: 0</code> followed a failed FK atom proven by <code>PRAGMA foreign_key_list</code>” is inspectable evidence.</p>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="observer">
+        <span class="section-number">01</span>
+        <h2 class="section-title">The verifier is an observer, not a helper</h2>
+        <p class="section-lead">The core mechanic is deliberately small: one interactive builder, one input-locked verifier, one lifecycle channel, one bounded transcript slice, and one corrective path back.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The “second agent” that still needs you</h3>
+          <p>You ask a builder to implement a change. When it finishes, you open another chat, paste the request and summary, ask that agent to review, copy its findings back, and prompt the builder again. Two models were involved, but your hands performed every trigger, context transfer, and correction. The review loop did not close; it grew another manual step.</p>
+          <p>That setup also lets the builder choose the story the reviewer sees. If you paste only the summary, the reviewer receives the claims but not the tool calls, results, and actual repository state behind them. The second agent may sound independent while inheriting the builder’s framing. More chat is not automatically more proof.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — separate lifecycle from substance</p>
+          <h3>The assistant transcript is not streamed over the socket</h3>
+          <div class="observer-flow" role="img" aria-label="Builder emits lifecycle events over a unix socket. The verifier reads the bounded turn slice from session JSONL and can send one corrective prompt back.">
+            <div class="observer-flow__node observer-flow__node--builder"><b>Builder</b><span>Normal interactive Pi. Captures original prompt and turn line offsets.</span></div>
+            <span class="observer-flow__arrow" aria-hidden="true">→</span>
+            <div class="observer-flow__node"><b>Lifecycle event</b><span><code>start</code> · <code>stop</code> · <code>error</code> plus session id, turn index, line bounds.</span></div>
+            <span class="observer-flow__arrow" aria-hidden="true">→</span>
+            <div class="observer-flow__node observer-flow__node--verifier"><b>Verifier</b><span>Reads <code>session.jsonl</code> slice, checks actual state, returns a Report or correction.</span></div>
+          </div>
+          <div class="event-ledger">
+            <div><b>On the wire</b><code>lifecycle metadata + control, correction, report, ack, and liveness envelopes</code><p class="fine">Events include the original prompt and turn line offsets, but not the builder assistant transcript.</p></div>
+            <div><b>On disk</b><code>~/.pi/agent/sessions/&lt;sid&gt;.jsonl</code><p class="fine">The verifier reads the bounded slice named by the stop event.</p></div>
+          </div>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — Dan’s two-window reveal</p>
+          <h3>One input box is alive; the other is intentionally dead</h3>
+          <p>The opening view places two Pi agents side by side. The builder is ready for a human prompt and shows that a verifier is connected. The verifier’s editor has been replaced by a status surface. Dan draws attention to the strange part: this harness takes no input. That asymmetry matters more than the number of windows. One process builds because a person asked; the other verifies because the system observed completion.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/ma-4-verifier-agent/t0080-two-agent-split-intro.jpg" alt="Two Pi agents side by side: an input-locked verifier on the left and an interactive builder on the right" width="3840" height="2160" fetchpriority="high">
+            <figcaption><span class="frame-card__t">1:20</span>The whole primitive in one view. The builder accepts the request. The verifier is connected but cannot be prompted by the operator.</figcaption>
+          </figure>
+          <p>After the builder finishes, the verifier wakes without a human keystroke, reads the artifact and turn record, and later sends a correction through <code>verifier_prompt</code>. The builder immediately begins another turn. The agent-to-agent message is not an improvised conversation; it is a single typed channel with an acknowledgement.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/ma-4-verifier-agent/t0246-verifier-prompts-builder.png" alt="Verifier window acknowledging a corrective prompt while the builder receives the correction and starts another image generation turn" width="3840" height="2160" loading="lazy">
+            <figcaption><span class="frame-card__t">4:06</span><code>verifier_prompt ✓ ack: prompt delivered to builder</code> closes the loop. The left side proves and corrects; the right side rebuilds.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan’s term + plain English</p>
+          <h3>The verifier agent</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Canonical term</p>
+            <p><strong>Verifier agent:</strong> a top-down observer that starts after a builder turn, independently checks the work against domain-appropriate evidence, and prompts the builder back only when a concrete failure has a concrete fix.</p>
+          </aside>
+          <p>The definition excludes three nearby ideas. It is not self-review, because a separate process and persona check the builder. It is not ordinary delegation, because the builder model never decides to recruit it. It is not a conversational peer, because ordinary operator instructions are locked out and its output is constrained to evidence, Report, and correction.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — trace the real lifecycle</p>
+          <h3>Read the two extension hooks as a protocol</h3>
+          <p>Builder-side <code>apps/verifier/verifiable.ts</code> captures the line count before the user turn, then captures it again at <code>agent_end</code>. The resulting stop envelope names the exact slice the verifier should inspect:</p>
+          <pre><code>pi.on("agent_end", async (_event, _ctx) =&gt; {
+  const endLine = await currentSessionFileLineCount(state.sessionFilePath);
+  sendEnvelope({
+    type: "event",
+    name: "stop",
+    sessionId: state.sessionId,
+    turnIndex: state.turnIndex,
+    userPrompt: state.lastUserPrompt,
+    sessionFileStartLine: state.turnStartLine,
+    sessionFileEndLine: endLine,
+  });
+});</code></pre>
+          <p class="code-source"><span>Course source</span><span>apps/verifier/verifiable.ts · lines 304–323</span></p>
+          <p>Verifier-side <code>apps/verifier/verifier.ts</code> handles that stop event by rendering <code>.pi/verifier/prompts/verify_on_stop.md</code> with the turn index, timestamp, original prompt, and line bounds. It injects the rendered content as an extension-sourced follow-up, the one input source allowed through the verifier lock.</p>
+          <p>The architecture is therefore event-driven and bounded. The verifier does not continually scan a growing transcript. It receives enough metadata to locate one turn, then reads that turn from disk. The socket coordinates; the session file supplies substance.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — narrate the wire</p>
+          <h3>Write the six-arrow trace</h3>
+          <ol>
+            <li>Start with “The user prompts the builder.”</li>
+            <li>Add the builder event that begins the bounded turn and the event that ends it.</li>
+            <li>State exactly what the verifier reads and from where.</li>
+            <li>Add the two possible outcomes: Report only, or <code>verifier_prompt</code> plus Report.</li>
+            <li>End with the builder repair turn and the next verification cycle.</li>
+          </ol>
+          <p>Pass if no arrow says “the builder model delegates to the verifier” and no arrow says “the builder assistant transcript crosses the socket.”</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: calling every second agent a sub-agent</h3>
+          <p><strong>Why it fails:</strong> the label hides who owns initiation and context. In delegation, the primary agent asks another agent to do work and usually shapes the task it receives. Here, the harness observes the primary agent from above. That independence is what allows the verifier to judge the builder’s claims rather than inherit them as instructions.</p>
+          <p><strong>Fix:</strong> ask three diagnostic questions. Who triggers the second agent? Who chooses its persona and tools? Where does it obtain the evidence? If the answers are “the lifecycle hook,” “the harness configuration,” and “the bounded session slice plus actual state,” you are looking at an observer.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>The shape matters more than Pi</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · mid-2026 extract</p>
+            <p>The extract identifies four portable requirements: a stop-style lifecycle hook, access to the builder transcript, a tool allowlist, and a tool-call gate. Pi supplies all four in the course implementation. Other harnesses can host the pattern only to the degree that they expose the same control surfaces.</p>
+            <p class="current-practice__source">Keep the invariant: independent observer, bounded evidence, narrowed tools, typed correction channel.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <h3>Retrieve the trigger and evidence path</h3>
+          <section class="retrieval-quiz" aria-label="Retrieval questions for the observer loop">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. What starts verification?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The builder’s <code>agent_end</code> causes the builder-side extension to emit a <code>stop</code> lifecycle event; the verifier handles that event and injects its verification prompt.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. What carries the substantive turn content?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The builder’s session JSONL file on disk. The stop event supplies line bounds so the verifier reads only the relevant turn slice.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What is the verifier’s only agent-to-agent corrective channel?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The <code>verifier_prompt</code> tool, which sends a prompt envelope to the builder and awaits a <code>prompt_ack</code>.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back">
+            <h3>Correct the “two bots chatting” explanation</h3>
+            <p>A teammate says, “The builder chats with a reviewer after it finishes.” Replace that sentence with a precise one-minute explanation that includes the stop event, unix socket, bounded session slice, input lock, Report, and correction channel.</p>
+            <p class="fine">Pass if the listener could draw the data flow and would not mistake the verifier for builder-controlled delegation.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="review">
+        <span class="section-number">02</span>
+        <h2 class="section-title">Attack the review constraint</h2>
+        <p class="section-lead">Agentic engineering shifts scarce human effort away from typing. In Dan’s framework, the remaining constraints are planning and reviewing. The verifier is built to collapse the second.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The summary that creates another task</h3>
+          <p>A builder returns: “Created the users table, added the foreign key, applied the migration, and verified integrity.” The work may be correct. But if you are accountable for the result, four verbs become four review obligations. You open the schema, inspect columns, trace the FK target, check the migrated database, and run integrity checks. Faster generation has pushed the bottleneck downstream into your review queue.</p>
+          <p>Skimming the answer does not remove that obligation. It only replaces verification with confidence in fluent prose. The more work the agent performs per turn, the more claims can hide behind a compact summary. Throughput rises while the human’s proof capacity stays fixed.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — the two constraints</p>
+          <h3>Plan what should happen; review what did happen</h3>
+          <div class="constraint-map" aria-label="Planning and reviewing are the two constraints of agentic coding, with the verifier targeting reviewing">
+            <article><h3>Planning</h3><p>Define intent, scope, constraints, sequence, and success evidence before compute runs.</p><p><strong>Question:</strong> Did we specify the right outcome and proof?</p></article>
+            <article><h3>Reviewing</h3><p>Compare claims with actual state, find gaps, and decide whether the outcome is trustworthy.</p><p><strong>Verifier target:</strong> execute the evidence checklist after every relevant turn.</p></article>
+          </div>
+          <p>The verifier does not remove planning. It makes reviewing parallel and repeatable, then improves planning indirectly: every claim it cannot verify becomes a request for a better fixture, oracle, script command, or specification next time.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — review becomes a Report</p>
+          <h3>The failure is named, counted, and made actionable</h3>
+          <p>In the image demonstration, the builder produces an architecture diagram that looks detailed and useful. The verifier checks the requested visual claims and discovers that the diagram violates a persona rule: more than ten distinct text blocks. It does not return a vague dislike. It names the failed rule, records six atoms with five verified and one failed, and tells the builder how to reduce the text burden.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/ma-4-verifier-agent/t0360-failed-report-readability.png" alt="Verifier Report showing one failed readability claim, five verified claims, and a concrete correction sent to the builder" width="3840" height="2160" loading="lazy">
+            <figcaption><span class="frame-card__t">6:00</span>Review labor externalized: the failed readability atom, the exact threshold, the claim counts, and the corrective action appear in one structured Report.</figcaption>
+          </figure>
+          <p>The distinction is subtle but important. The verifier is not “another opinion about the image.” The persona turned a reusable review judgment—limit distinct text blocks—into a rule. The agent applied that rule to the bytes that were produced. The Report tells the operator what was proven, what was not, and what happened next.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan’s term + plain English</p>
+          <h3>Planning and reviewing</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">The two constraints</p>
+            <p><strong>Planning</strong> determines what the system should do. <strong>Reviewing</strong> determines whether the actual result deserves trust. The verifier improves the review constraint by executing a domain-specific proof routine on every completed turn.</p>
+          </aside>
+          <p>Review in this system is a verb, not a feeling. It consists of decomposing claims, selecting checks, running them against actual state, recording evidence, and admitting what remains unknown. SQLite checks can be deterministic tool outputs; image checks are model-mediated judgments grounded in the actual pixels. A green status is the output of that process; it is not a substitute for the process.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — encode a review checklist</p>
+          <h3>The SQLite persona is an executable reviewer</h3>
+          <p><code>.pi/verifier/agents/verify_sqlite.md</code> turns familiar database review moves into heuristics. If the builder claims a file was created, read it. If it claims a row count, run <code>SELECT count(*)</code>. If it declares a foreign key, run <code>PRAGMA foreign_key_list</code> and verify that the referenced table and column exist. If it modified a database, run <code>PRAGMA integrity_check</code> and require <code>ok</code>. If it claims an index, combine <code>PRAGMA index_list</code> with <code>EXPLAIN QUERY PLAN</code>.</p>
+          <p>That list is valuable because it is both domain-specific and stable. The builder may phrase its summary differently on every turn, but the verifier maps claims to the same deterministic checks. The proof routine does not depend on the operator remembering which command to run after a long generation session.</p>
+          <aside class="callout callout--why"><p class="callout__label">Evidence hierarchy</p><p>The builder’s final message is a claim. A tool output tied to the exact atom is evidence. A Report that preserves the command, observed output, and verdict is review.</p></aside>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — convert prose to review work</p>
+          <h3>Build a proof checklist from one sentence</h3>
+          <p>Take the sentence “I created the orders table with the right columns, primary key, foreign key, and index.” Without adding requirements, write the smallest checks that the shipped SQLite verifier can perform. For each check, name one exact command family: <code>.schema</code>, <code>PRAGMA table_info</code>, <code>PRAGMA foreign_key_list</code>, <code>PRAGMA index_list</code>, or <code>PRAGMA integrity_check</code>.</p>
+          <p>Pass if each claim can independently be true or false and every verdict would cite actual output rather than the builder’s wording.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: reviewing the explanation instead of the state</h3>
+          <p><strong>Symptom:</strong> the review agent says the summary is clear, the approach is reasonable, or the implementation “appears correct.” None of those statements establishes that the requested artifact exists with the requested properties.</p>
+          <p><strong>Fix:</strong> force every verified finding to include an oracle. In the course persona, a missing deterministic output must become <code>unsure</code>, not verified. That rule protects you from a reviewer that merely agrees with the builder’s story.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>Trust the operational files when prose lags</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · repository reality</p>
+            <p>The checked-in README still contains an older limitations paragraph that understates the shipped personas. The local tree has full generic, SQLite, image, and Python verifier personas. For an operational review system, inspect the active persona, launcher, and script—not only the overview prose.</p>
+            <p class="current-practice__source">This discrepancy is documented in the lesson extract; it is itself a reminder that documentation is a claim until checked against disk.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <h3>Retrieve the bottleneck</h3>
+          <section class="retrieval-quiz" aria-label="Retrieval questions for planning and review">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. What are the two constraints Dan names?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Planning and reviewing.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. Which constraint does the verifier directly attack?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Reviewing. It executes repeatable proof checks after every builder turn.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. Why is the builder’s final answer not proof?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It is the builder’s own assertion about its work. Proof requires an independent check against actual state and the output of that check.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back">
+            <h3>Explain where the bottleneck moved</h3>
+            <p>Teach a senior engineer who says, “Generation is fast now, so throughput is solved.” Explain how longer agent turns create more review obligations, why prose review does not satisfy them, and how a domain persona converts the obligations into executable checks.</p>
+            <p class="fine">Pass if your explanation includes planning, reviewing, actual state, and a deterministic oracle.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="atoms">
+        <span class="section-number">03</span>
+        <h2 class="section-title">Verification begins with decomposition</h2>
+        <p class="section-lead">A verifier is only as trustworthy as the granularity of its claims. “Done” is too large to prove. Each atom needs one unambiguous truth value and one evidence path.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The green check that hides four unknowns</h3>
+          <p>A reviewer runs <code>.tables</code>, sees <code>users</code>, and marks “created users table with constraints” as PASS. The table exists, but that single observation says nothing about the column types, primary key, foreign keys, defaults, or uniqueness constraints. The verdict is technically attached to evidence and still misleading because the claim was too broad.</p>
+          <p>Coarse claims create counterfeit certainty. One observed property lends its truth to neighboring properties that were never checked. The cure is not a smarter summary; it is smaller propositions.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — one bundle becomes five atoms</p>
+          <h3>“I created the users table” is not atomic</h3>
+          <div class="atom-board" aria-label="A bundled users table claim decomposed into five atomic claims">
+            <article data-atom="1"><h3>Exists</h3><p>The table named <code>users</code> exists.</p></article>
+            <article data-atom="2"><h3>Columns</h3><p>The requested columns and types exist.</p></article>
+            <article data-atom="3"><h3>Primary key</h3><p>The requested column is the primary key.</p></article>
+            <article data-atom="4"><h3>Foreign keys</h3><p>Each declared reference targets a real table and column.</p></article>
+            <article data-atom="5"><h3>Defaults</h3><p>The requested defaults and flags are present.</p></article>
+          </div>
+          <p>Each card can fail while the others pass. That independence is the point. The resulting Report may look longer than the builder’s summary, but the extra length is where trust lives.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — sixteen SQLite claims</p>
+          <h3>Different domain, same proof discipline</h3>
+          <p>Dan boots <code>just vsql</code> and asks the builder to find the SQLite databases and break down their tables, columns, and relationships. That request sounds like one inspection task. The verifier turns it into sixteen claims and proves them individually with <code>PRAGMA</code> queries, row counts, index checks, foreign-key checks, and an integrity result.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/ma-4-verifier-agent/t1180-sqlite-verify-16-claims.png" alt="Builder and SQLite verifier windows showing 16 of 16 atomic claims verified with PRAGMA, SELECT, and integrity evidence" width="3840" height="2160" loading="lazy">
+            <figcaption><span class="frame-card__t">19:40</span>Sixteen independently proven atoms, not one “database inspection passed.” The same frame also reveals the deliberate compute disparity between builder and verifier.</figcaption>
+          </figure>
+          <p>The image example reaches the same endpoint through a non-deterministic oracle: the vision-capable verifier checks the actual pixels against seven visual claims. The mechanism is stable across domains even when the check changes—decompose, choose an oracle, observe, record, decide.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/ma-4-verifier-agent/t0420-verified-report-7of7.png" alt="Image verifier with a green PERFECT status and seven of seven atomic visual claims verified" width="3840" height="2160" loading="lazy">
+            <figcaption><span class="frame-card__t">7:00</span>The repaired image closes at 7/7 with no feedback required. A PERFECT label means every atom was proven with zero gaps in that cycle.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan’s term + plain English</p>
+          <h3>Atomic claims, or small axioms</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Verification unit</p>
+            <p><strong>Atomic claim:</strong> the smallest proposition in the request or builder result that can be independently proven true, proven false, or declared unverifiable with the available oracle.</p>
+          </aside>
+          <p>An atom is not “small text.” It is small in responsibility. “The migration succeeded” may require several atoms because success bundles schema state, constraints, and integrity. “<code>PRAGMA integrity_check</code> returned <code>ok</code>” is atomic because one command has one observable answer.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — build an evidence matrix</p>
+          <h3>Route each claim to one check</h3>
+          <table class="claim-table">
+            <thead><tr><th>Atomic claim</th><th>Course verifier check</th><th>Possible verdict</th></tr></thead>
+            <tbody>
+              <tr><td><code>orders</code> exists</td><td><code>.schema orders</code></td><td class="pass">PASS / FAIL</td></tr>
+              <tr><td><code>orders.id</code> is a primary key</td><td><code>PRAGMA table_info(orders)</code></td><td class="pass">PASS / FAIL</td></tr>
+              <tr><td><code>orders.user_id</code> references <code>users.id</code></td><td><code>PRAGMA foreign_key_list(orders)</code> plus target inspection</td><td class="fail">PASS / FAIL</td></tr>
+              <tr><td>The database is internally consistent</td><td><code>PRAGMA integrity_check</code></td><td class="pass"><code>ok</code> / failure</td></tr>
+              <tr><td>A claimed query uses its index</td><td><code>PRAGMA index_list</code> + <code>EXPLAIN QUERY PLAN</code></td><td class="pass">used / not used</td></tr>
+            </tbody>
+          </table>
+          <p>This matrix does not predict the output. It defines what output would settle each claim. That distinction keeps the verifier honest. When no available command can settle an atom, the correct result is an explicit gap—not a guessed PASS.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — atomize before checking</p>
+          <h3>Decompose the lab prompt</h3>
+          <p>The lab asks the builder to “inspect <code>tmp/mock_shop.db</code> and confirm every table has a primary key and every foreign key references a real table and column.” Before running anything, write the atom list you expect. Include discovery atoms, one primary-key atom per table, one reference atom per FK, and an integrity atom. Do not invent a table or relationship that is not present; allow discovery to determine the final count.</p>
+          <p>Pass if a single failed FK does not force unrelated primary-key atoms to fail, and if every atom has a named check.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: one PASS for a bundle</h3>
+          <p><strong>Why it fails:</strong> a coarse PASS collapses checked and unchecked properties into the same status. It prevents the operator from seeing exactly what failed, exactly what remains unknown, and exactly what the builder should repair.</p>
+          <p><strong>Fix:</strong> split until each line can carry one command, one observed output, and one verdict. The SQLite persona says it plainly: one PASS hiding three unverified sub-claims is worse than three explicit FAILs.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>Specific models drift; the atom stays stable</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · model-agnostic proof</p>
+            <p>The video uses GLM 5.1 for SQLite and GPT-5.5 for images; the checked-in personas now declare <code>openai/gpt-5.5</code>. The model line moved. The proof discipline did not: atomic claims, domain oracle, exact evidence, honest gaps.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <h3>Retrieve the unit of verification</h3>
+          <section class="retrieval-quiz" aria-label="Retrieval questions for atomic claims">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. Why is “I created the users table” not atomic?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It bundles existence, columns and types, primary key, foreign keys, defaults, and other constraints that can vary independently.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. What three outcomes can an atom receive?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Proven true, proven false, or explicitly unverifiable with the available oracle.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What makes a claim-to-check mapping good?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The check’s observable output settles that one claim without borrowing certainty from neighboring claims.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back">
+            <h3>Defend the longer Report</h3>
+            <p>A teammate complains that sixteen findings are noisier than one green check. Explain why the extra rows are not verbosity but preserved proof boundaries. Use one table claim and one image readability claim to show that the oracle can differ while the atomic method stays the same.</p>
+            <p class="fine">Pass if you distinguish claim granularity from writing length and include the role of explicit unverifiable gaps.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="tokens">
+        <span class="section-number">04</span>
+        <h2 class="section-title">Spend tokens to save time</h2>
+        <p class="section-lead">The verifier writes no application code and often consumes more context than the builder. That is not an accidental inefficiency. It is the economic thesis of the lesson.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The token optimizer who buys back manual review</h3>
+          <p>You disable the verifier because a second model doubles or multiplies the token bill. The next builder run is cheaper. Then you spend forty minutes checking the schema, reading generated files, reproducing commands, and asking for repairs. You saved the resource the system can produce and spent the resource you cannot restore.</p>
+          <p>The mistake is not caring about cost. It is optimizing the wrong denominator. The verifier should be judged against human review time reclaimed and failure risk reduced, not against the fantasy baseline of unreviewed agent output.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — price the exchanged resources</p>
+          <h3>More compute, less operator attention</h3>
+          <div class="token-balance" role="img" aria-label="The builder uses a smaller amount of compute while the verifier uses more compute to return human review time">
+            <div class="token-balance__bar"><b>Builder</b><span>Generate the artifact and claims</span></div>
+            <div class="token-balance__bar"><b>Verifier · often 2–5×</b><span>Re-read, decompose, run proof checks, report, and correct</span></div>
+          </div>
+          <p>The bar is intentionally asymmetric. The verifier repeats work the builder may already have done and inspects it from a second perspective. Redundancy is the product when the objective is trust.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — watch compute get spent</p>
+          <h3>One agent prompts another model before verification even begins</h3>
+          <p>In the image demonstration, the Opus builder reads the <code>gpt-image-2</code> skill, constructs a highly detailed image prompt, and runs the generation script. The frame shows roughly seventy-five seconds of work. Then the verifier spends another model’s context inspecting the result, finds the readability failure, and causes the generation to run again.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/ma-4-verifier-agent/t0178-builder-gpt-image-skill.png" alt="Builder agent creating a detailed GPT Image 2 prompt and running the image generation skill" width="3840" height="2160" loading="lazy">
+            <figcaption><span class="frame-card__t">2:58</span>Compute is already layered: the builder model authors a prompt for GPT Image 2. The verifier then adds another proof pass. The system spends deliberately.</figcaption>
+          </figure>
+          <p>The extract records the image example at roughly 4% builder context versus 23% verifier context, about five times, and the SQLite example at roughly twice the builder’s tokens. The exact meter changes by turn and model. The invariant is the direction of the trade: spend extra compute now so the engineer does not become the serial reviewer later.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan’s term + plain English</p>
+          <h3>Tokens for time</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Economic rule</p>
+            <p><strong>Spend tokens to save time:</strong> deliberately pay for redundant generation and verification when that compute buys back scarce human review hours and increases confidence in the result.</p>
+          </aside>
+          <blockquote><p>“Whenever you can, you should be spending tokens to save time.”</p><cite>Dan, approximately 9:52 in the lesson transcript</cite></blockquote>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — evaluate the trade</p>
+          <h3>Compare against the real alternative</h3>
+          <p>The course README states the trade directly: the verifier often burns 2–5× the builder’s tokens and gives a second perspective plus deterministic checks. Suppose a SQLite turn reports tables, columns, foreign keys, indexes, counts, and integrity. Without the verifier, the alternative is not zero cost. It is the operator reconstructing the same checklist, running the same queries, comparing the same outputs, and deciding which discrepancy should become a correction.</p>
+          <p>The correct evaluation therefore has two columns. In the compute column: builder tokens, verifier tokens, any repeated builder turn, and domain-tool execution. In the human column: time to inspect, reproduce, diagnose, reprompt, and re-check. The lesson does not supply a universal dollar threshold. It supplies the decision rule: if compute can reclaim meaningful review time, take the trade.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — build a time ledger</p>
+          <h3>Estimate the manual path before judging the meter</h3>
+          <ol>
+            <li>Choose the SQLite lab or image readability loop.</li>
+            <li>List every manual review action you would perform without the verifier.</li>
+            <li>Estimate attention minutes, including the second check after repair.</li>
+            <li>List what the verifier performs automatically.</li>
+            <li>Write the maximum token spend you would accept to remove those manual actions; explain your reasoning without inventing a universal price.</li>
+          </ol>
+          <p>Pass if you compare against reviewed work, not against unreviewed output.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: treating token minimization as the objective</h3>
+          <p><strong>Why it fails:</strong> it assumes human review is free and unreviewed output is acceptable. Both assumptions contradict the system’s purpose.</p>
+          <p><strong>Fix:</strong> optimize total delivery cost under a trust requirement. Make review time visible, make verifier spend visible, and compare them. The frame’s context percentages are not a scoreboard to minimize; they are proof that compute was allocated to checking.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>The model roster is period detail</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · stable trade, moving prices</p>
+            <p>The lesson opens amid rapid model releases, and the shipped verifier model has already changed from the recorded SQLite configuration. Do not preserve the economics as a claim about one provider. Preserve the structure: redundant compute is justified when it buys back constrained operator review.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <h3>Retrieve the exchange</h3>
+          <section class="retrieval-quiz" aria-label="Retrieval questions for token economics">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. What two resources are exchanged?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Additional model compute/tokens are exchanged for reduced human review time and increased proof.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. Why is “builder-only cost” the wrong baseline?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Because accountable delivery still requires review. Without the verifier, the operator performs that work manually or accepts unverified output.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What range does the course source use for verifier spend?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Often 2–5× the builder’s tokens per turn, with concrete examples varying by domain and cycle.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back">
+            <h3>Answer the CFO and the engineer</h3>
+            <p>Explain why an agent that writes no application code can still make delivery faster. Your answer must name the manual review alternative, the repeated correction check, the 2–5× range, and the fact that the decision depends on time reclaimed rather than a universal model price.</p>
+            <p class="fine">Pass if you can justify the trade without saying tokens are literally free.</p>
+          </div>
+        </div>
+      </section>
+
+      <!-- Remaining idea cycles, current practice, lab, mastery, glossary, and script are appended below. -->
+    </main>
+  </div>
+</body>
+</html>

apply patch
patch: completed
/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/vol-3-ma/18-verifier-agent.html
diff --git a/IndyDevDan/book/vol-3-ma/18-verifier-agent.assets.css b/IndyDevDan/book/vol-3-ma/18-verifier-agent.assets.css
new file mode 100644
index 0000000000000000000000000000000000000000..3c043df0bcf965159fd56d178bbb72376e077fdd
--- /dev/null
+++ b/IndyDevDan/book/vol-3-ma/18-verifier-agent.assets.css
@@ -0,0 +1,456 @@
+/* MA-4 verifier chapter additions.
+   Shared color/type values come from ../design/tokens.css; the chapter shell
+   and ten-move teaching grammar come from the TAC-1 gold stylesheet. */
+
+:root {
+  --verifier-purple: #67507a;
+  --verifier-purple-wash: #eee7f3;
+  --verifier-line: color-mix(in srgb, var(--accent) 58%, var(--border));
+}
+
+.hero--verifier {
+  isolation: isolate;
+  background:
+    linear-gradient(135deg, color-mix(in srgb, var(--accent-wash) 74%, transparent), transparent 48%),
+    var(--bg-card);
+}
+
+.hero--verifier::before {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background-image:
+    linear-gradient(var(--border-soft) 1px, transparent 1px),
+    linear-gradient(90deg, var(--border-soft) 1px, transparent 1px);
+  background-size: 2.25rem 2.25rem;
+  opacity: .34;
+  content: "";
+  mask-image: linear-gradient(90deg, transparent 25%, black 78%);
+}
+
+.hero-loop {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+  gap: var(--space-3);
+  align-items: stretch;
+  margin-top: var(--space-8);
+}
+
+.hero-loop__node {
+  display: grid;
+  align-content: center;
+  min-height: 10rem;
+  padding: var(--space-5);
+  border: 2px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: color-mix(in srgb, var(--bg-card) 92%, var(--accent-wash));
+  box-shadow: var(--shadow-card);
+}
+
+.hero-loop__node--verifier {
+  border-color: var(--verifier-purple);
+  background: color-mix(in srgb, var(--bg-card) 86%, var(--verifier-purple-wash));
+}
+
+.hero-loop__node b {
+  font: 700 var(--text-lg)/1.1 var(--font-display);
+}
+
+.hero-loop__node span {
+  margin-top: var(--space-2);
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+}
+
+.hero-loop__channel {
+  display: grid;
+  place-items: center;
+  min-width: 8rem;
+  color: var(--accent-ink);
+  font: 750 var(--text-sm)/1.35 var(--font-mono);
+  text-align: center;
+}
+
+.hero-loop__channel::before,
+.hero-loop__channel::after {
+  content: "↔";
+  font-size: var(--text-xl);
+}
+
+.hero-loop__lock {
+  grid-column: 3;
+  justify-self: stretch;
+  padding: var(--space-2) var(--space-3);
+  border: 1px solid var(--verifier-purple);
+  border-radius: 999px;
+  color: var(--verifier-purple);
+  background: var(--verifier-purple-wash);
+  font-size: var(--text-sm);
+  font-weight: 750;
+  text-align: center;
+}
+
+.constraint-map,
+.trust-scale,
+.two-camps,
+.report-map,
+.lock-stack,
+.model-pair,
+.flywheel,
+.harness-map,
+.atom-board {
+  display: grid;
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.constraint-map { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+
+.constraint-map article,
+.trust-scale article,
+.two-camps article,
+.report-map article,
+.atom-board article {
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.constraint-map article:last-child,
+.trust-scale article:last-child {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+  box-shadow: var(--shadow-card);
+}
+
+.constraint-map h3,
+.trust-scale h3,
+.two-camps h3,
+.report-map h3,
+.atom-board h3 { margin-top: 0; }
+
+.constraint-map p,
+.trust-scale p,
+.two-camps p,
+.report-map p,
+.atom-board p { margin-top: var(--space-2); color: var(--ink-soft); }
+
+.observer-flow {
+  display: grid;
+  grid-template-columns: minmax(9rem, 1fr) auto minmax(9rem, 1fr) auto minmax(9rem, 1fr);
+  gap: var(--space-2);
+  align-items: center;
+  margin-top: var(--space-5);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.observer-flow__node {
+  min-height: 8rem;
+  padding: var(--space-4);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+  text-align: center;
+}
+
+.observer-flow__node--builder { border: 2px solid var(--accent); }
+.observer-flow__node--verifier { border: 2px solid var(--verifier-purple); }
+.observer-flow__node b { display: block; font-family: var(--font-display); font-size: var(--text-md); }
+.observer-flow__node span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.observer-flow__arrow { color: var(--accent); font-size: var(--text-xl); font-weight: 800; text-align: center; }
+
+.event-ledger {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.event-ledger div {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.event-ledger b { display: block; color: var(--accent-ink); }
+.event-ledger code { display: inline-block; margin-top: var(--space-2); }
+
+.atom-board { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.atom-board article { padding: var(--space-3); }
+.atom-board article::before {
+  display: grid;
+  place-items: center;
+  width: 1.8rem;
+  height: 1.8rem;
+  margin-bottom: var(--space-2);
+  border-radius: 50%;
+  color: var(--ink-inverse);
+  background: var(--accent);
+  content: attr(data-atom);
+  font: 750 var(--text-xs) var(--font-mono);
+}
+
+.claim-table td:last-child { font-weight: 750; }
+.claim-table .pass { color: var(--ok); }
+.claim-table .fail { color: var(--warn); }
+
+.token-balance {
+  display: grid;
+  grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr);
+  gap: var(--space-3);
+  align-items: end;
+  margin-top: var(--space-5);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.token-balance__bar {
+  display: grid;
+  align-content: end;
+  min-height: 12rem;
+  padding: var(--space-4);
+  border-radius: var(--radius-md);
+  color: var(--ink-inverse);
+  background: var(--accent);
+}
+
+.token-balance__bar:first-child { min-height: 7rem; background: var(--ink-soft); }
+.token-balance__bar b { font: 700 var(--text-lg) var(--font-display); }
+.token-balance__bar span { font-size: var(--text-sm); }
+
+.trust-scale { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+
+.trust-scale__both {
+  grid-column: 1 / -1;
+  padding: var(--space-5);
+  border: 2px solid var(--ok);
+  border-radius: var(--radius-lg);
+  color: var(--ok);
+  background: var(--ok-wash);
+  font: 700 var(--text-lg) var(--font-display);
+  text-align: center;
+}
+
+.lock-stack { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+
+.lock-stack__layer {
+  position: relative;
+  padding: var(--space-5);
+  border: 2px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.lock-stack__layer:nth-child(2) { border-color: var(--verifier-purple); }
+.lock-stack__layer:nth-child(3) { border-color: var(--ok); }
+.lock-stack__layer b { display: block; font-family: var(--font-display); font-size: var(--text-md); }
+.lock-stack__layer span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.report-map { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.report-map article { padding: var(--space-3); }
+.report-map h3 { font-family: var(--font-body); font-size: var(--text-sm); }
+.report-map p { font-size: var(--text-xs); }
+
+.confidence-ladder {
+  display: grid;
+  gap: var(--space-2);
+  margin-top: var(--space-4);
+}
+
+.confidence-ladder div {
+  display: grid;
+  grid-template-columns: 7rem 1fr auto;
+  gap: var(--space-3);
+  align-items: center;
+  padding: var(--space-3) var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.confidence-ladder b { font-family: var(--font-mono); font-size: var(--text-sm); }
+.confidence-ladder span { color: var(--ink-soft); font-size: var(--text-sm); }
+.confidence-ladder i { width: .8rem; height: .8rem; border-radius: 50%; background: var(--ok); }
+.confidence-ladder div:nth-child(3) i,
+.confidence-ladder div:nth-child(4) i { background: var(--accent); }
+.confidence-ladder div:nth-child(5) i { background: var(--warn); }
+
+.flywheel {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  counter-reset: flywheel;
+}
+
+.flywheel div {
+  position: relative;
+  padding: var(--space-5) var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.flywheel div::before {
+  counter-increment: flywheel;
+  display: grid;
+  place-items: center;
+  width: 2rem;
+  height: 2rem;
+  margin-bottom: var(--space-2);
+  border-radius: 50%;
+  color: var(--ink-inverse);
+  background: var(--accent);
+  content: counter(flywheel);
+  font-weight: 800;
+}
+
+.flywheel div:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: calc(var(--space-3) * -.8);
+  z-index: 2;
+  color: var(--accent);
+  content: "→";
+  font-weight: 800;
+}
+
+.model-pair { grid-template-columns: 1fr auto 1fr; align-items: center; }
+.model-pair__model {
+  padding: var(--space-5);
+  border: 2px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  text-align: center;
+}
+.model-pair__model:last-child { border-color: var(--verifier-purple); }
+.model-pair__model b { display: block; font: 700 var(--text-lg) var(--font-display); }
+.model-pair__model span { display: block; margin-top: var(--space-2); color: var(--ink-soft); }
+.model-pair__and { color: var(--accent-ink); font: 800 var(--text-xl) var(--font-display); }
+
+.two-camps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.two-camps article:first-child { border-top: .4rem solid var(--warn); }
+.two-camps article:last-child { border-top: .4rem solid var(--ok); }
+
+.harness-map { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.harness-map div {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+.harness-map b { display: block; color: var(--accent-ink); }
+.harness-map span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.code-source {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-3);
+  margin-top: var(--space-2);
+  color: var(--ink-mute);
+  font: var(--text-xs) var(--font-mono);
+}
+
+.frame-card {
+  width: min(100%, 1100px);
+  max-width: min(100%, 1100px);
+}
+
+.frame-card img {
+  width: 100%;
+  max-width: min(100%, 1100px);
+  aspect-ratio: 16 / 9;
+  object-fit: contain;
+  background: var(--bg-card);
+}
+
+.frame-card figcaption { max-width: 82ch; }
+
+.lab-phase {
+  margin-top: var(--space-6);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.lab-phase h3 { margin-top: 0; }
+.lab-phase__time { color: var(--accent-ink); font: 750 var(--text-xs) var(--font-mono); }
+
+.evidence-pack {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.evidence-pack div {
+  padding: var(--space-4);
+  border: 1px dashed var(--accent);
+  border-radius: var(--radius-md);
+  background: var(--accent-wash);
+}
+
+.scorecard th:first-child { width: 48%; }
+.scorecard td:not(:first-child),
+.scorecard th:not(:first-child) { text-align: center; }
+
+.source-note {
+  margin-top: var(--space-8);
+  padding-top: var(--space-4);
+  border-top: var(--hairline);
+  color: var(--ink-mute);
+  font-size: var(--text-sm);
+}
+
+@media (max-width: 68rem) {
+  .atom-board { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .report-map { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .harness-map { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 48rem) {
+  .hero-loop,
+  .observer-flow,
+  .model-pair { grid-template-columns: 1fr; }
+  .hero-loop__channel::before,
+  .hero-loop__channel::after,
+  .observer-flow__arrow { transform: rotate(90deg); }
+  .hero-loop__lock { grid-column: 1; }
+  .constraint-map,
+  .trust-scale,
+  .two-camps,
+  .lock-stack,
+  .event-ledger,
+  .token-balance { grid-template-columns: 1fr; }
+  .atom-board,
+  .report-map,
+  .flywheel,
+  .harness-map,
+  .evidence-pack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .flywheel div::after { display: none; }
+}
+
+@media (max-width: 34rem) {
+  .atom-board,
+  .report-map,
+  .flywheel,
+  .harness-map,
+  .evidence-pack { grid-template-columns: 1fr; }
+  .confidence-ladder div { grid-template-columns: 1fr auto; }
+  .confidence-ladder div span { grid-column: 1 / -1; }
+}
+
+@media print {
+  .hero--verifier::before { display: none; }
+  .hero-loop__node,
+  .observer-flow__node,
+  .lock-stack__layer,
+  .flywheel div { min-height: 0; }
+  .source-note { display: none; }
+}
diff --git a/IndyDevDan/book/vol-3-ma/18-verifier-agent.html b/IndyDevDan/book/vol-3-ma/18-verifier-agent.html
new file mode 100644
index 0000000000000000000000000000000000000000..def32c0adb55f954a46c8721ab3d58e129f3c743
--- /dev/null
+++ b/IndyDevDan/book/vol-3-ma/18-verifier-agent.html
@@ -0,0 +1,1388 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="A teaching-first companion to MA-4: The Pi Verifier Agent. Learn the two-agent observer loop, atomic verification, read-only architecture, the verifier Report flywheel, and a graded course-repository lab.">
+  <title>MA-4 · The Pi Verifier Agent — IndyDevDan Expert Book</title>
+  <link rel="stylesheet" href="../design/tokens.css">
+  <link rel="stylesheet" href="../design/base.css">
+  <link rel="stylesheet" href="../design/components.css">
+  <link rel="stylesheet" href="../vol-1-tac/01-hello-agentic-coding.assets.css">
