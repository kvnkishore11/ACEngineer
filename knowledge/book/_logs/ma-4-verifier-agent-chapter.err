    39	    .rd-map b { display:block; font:700 var(--text-3xl)/1 var(--font-display); }
    40	    .rd-map span { display:block; margin-top:var(--space-2); font-weight:750; }
    41	    .rd-map div:nth-child(2) { border-color:var(--ok); color:var(--ok); }
    42	    .section { margin-top:var(--space-10); }
    43	    .section-head { display:flex; justify-content:space-between; align-items:end; gap:var(--space-4); padding-bottom:var(--space-3); border-bottom:var(--hairline); }
    44	    .section-head h2 { margin:0; }
    45	    .section-head p { color:var(--ink-mute); font-size:var(--text-sm); }
    46	    .lesson-list { display:grid; gap:var(--space-2); margin-top:var(--space-4); }
    47	    .lesson { display:grid; grid-template-columns:3rem minmax(0,1fr) auto; gap:var(--space-3); align-items:center; padding:var(--space-3) var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
    48	    .lesson__n { color:var(--ink-mute); font:var(--text-sm) var(--font-mono); }
    49	    .lesson strong { display:block; }
    50	    .lesson p { color:var(--ink-mute); font-size:var(--text-sm); }
    51	    .badge { padding:.2rem .55rem; border-radius:99px; font-size:var(--text-xs); font-weight:750; text-transform:uppercase; letter-spacing:.06em; }
    52	    .badge--done { color:var(--ok); background:var(--ok-wash); }
    53	    .badge--pending { color:var(--ink-mute); background:var(--bg-inset); }
    54	    .volumes { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--space-4); margin-top:var(--space-4); }
    55	    .volume-card { padding:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); }
    56	    .volume-card h3 { margin-top:var(--space-2); }
    57	    .volume-card p { margin-top:var(--space-3); color:var(--ink-soft); }
    58	    .hub-footer { display:flex; justify-content:space-between; gap:var(--space-4); margin-top:var(--space-10); padding-top:var(--space-5); border-top:var(--hairline); color:var(--ink-mute); font-size:var(--text-sm); }
    59	    @media (max-width:48rem) { .hero,.chapter-feature { grid-template-columns:1fr; } .chapter-feature__map { min-height:18rem; } .volumes { grid-template-columns:1fr; } .lesson { grid-template-columns:2rem minmax(0,1fr); } .lesson .badge { grid-column:2; justify-self:start; } }
    60	  </style>
