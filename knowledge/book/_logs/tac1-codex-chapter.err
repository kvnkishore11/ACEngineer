python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urlparse
import re
root=Path('IndyDevDan/book')
files=[root/'index.html',root/'vol-1-tac/01-hello-agentic-coding.html']
class P(HTMLParser):
 def __init__(self): super().__init__(); self.refs=[]; self.ids=[]; self.hrefs=[]; self.text=[]; self.stack=[]
 def handle_starttag(self,t,a):
  d=dict(a)
  if 'id' in d:self.ids.append(d['id'])
  if t in {'img','link','script','a'}:
   key='href' if t in {'link','a'} else 'src'
   if d.get(key): self.refs.append((t,d[key]))
  if t=='a' and d.get('href'): self.hrefs.append(d['href'])
 def handle_data(self,d): self.text.append(d)
for f in files:
 p=P();p.feed(f.read_text())
 missing=[]
 for tag,ref in p.refs:
  u=urlparse(ref)
  if u.scheme or ref.startswith('#'): continue
  target=(f.parent/u.path).resolve()
  if not target.exists(): missing.append((tag,ref,str(target)))
 duplicate=sorted({x for x in p.ids if p.ids.count(x)>1})
 broken_frag=[]
 for h in p.hrefs:
  if h.startswith('#') and h[1:] not in p.ids: broken_frag.append(h)
 print(f'{f}: refs={len(p.refs)} ids={len(p.ids)} missing={len(missing)} duplicate_ids={duplicate} broken_fragments={broken_frag}')
 for item in missing: print(' MISSING',item)
chapter=files[1].read_text()
for sid in ['idea-role','idea-mission','idea-stop','idea-core-four','idea-ab','idea-tool','idea-programmable','idea-paradox']:
 m=re.search(fr'<section class=\"chapter-section idea-cycle\" id=\"{sid}\">(.*?)(?=<section class=\"chapter-section|</main>)',chapter,re.S)
 print(sid,'moves=',len(re.findall(r'<div class=\"move move--',m.group(1))) if m else 'MISSING')
print('frames',chapter.count('<img '),'video_cards',chapter.count('class=\"video-card\"'),'details',chapter.count('<details'))
print('forbidden PiCanvas',bool(re.search('PiCanvas',chapter,re.I)))
