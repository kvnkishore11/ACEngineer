p=Path('IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html')
class T(HTMLParser):
 def __init__(self): super().__init__(); self.s=[]; self.skip=0
 def handle_starttag(self,t,a):
  if t in {'script','style'}: self.skip+=1
 def handle_endtag(self,t):
  if t in {'script','style'} and self.skip:self.skip-=1
 def handle_data(self,d):
  if not self.skip:self.s.append(d)
x=T();x.feed(p.read_text());text=' '.join(x.s); words=re.findall(r\"\\b[\\w’'-]+\\b\",text)
print(len(words))
