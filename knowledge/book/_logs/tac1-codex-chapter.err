/bin/zsh -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urlparse
import re, json
root=Path('IndyDevDan/book')
chapter=root/'vol-1-tac/01-hello-agentic-coding.html'
class P(HTMLParser):
 def __init__(self): super().__init__(); self.refs=[]; self.ids=[]; self.text=[]; self.skip=0
 def handle_starttag(self,t,a):
  d=dict(a)
  if t in {'script','style'}: self.skip+=1
  if 'id' in d:self.ids.append(d['id'])
  key='href' if t in {'a','link'} else 'src'
  if t in {'a','link','img','script'} and d.get(key):self.refs.append((t,d[key]))
 def handle_endtag(self,t):
  if t in {'script','style'} and self.skip:self.skip-=1
 def handle_data(self,d):
  if not self.skip:self.text.append(d)
for f in [root/'index.html',chapter]:
 p=P();p.feed(f.read_text());missing=[]
 for tag,ref in p.refs:
  u=urlparse(ref)
  if u.scheme or ref.startswith('#'):continue
  target=(f.parent/u.path).resolve()
  if not target.exists():missing.append((tag,ref))
 print(f.name,{'refs':len(p.refs),'missing':missing,'duplicate_ids':sorted({x for x in p.ids if p.ids.count(x)>1})})
p=P();p.feed(chapter.read_text());words=re.findall(r\"\\b[\\w’'-]+\\b\",' '.join(p.text)); html=chapter.read_text()
print('visible_words',len(words),'frames',html.count('<img '),'yt_cards',html.count('class=\"video-card\"'),'details',html.count('<details'))
for sid in ['idea-role','idea-mission','idea-stop','idea-core-four','idea-ab','idea-tool','idea-programmable','idea-paradox']:
 m=re.search(fr'<section class=\"chapter-section idea-cycle\" id=\"{sid}\">(.*?)(?=<section class=\"chapter-section|</main>)',html,re.S)
 print(sid,'moves',len(re.findall(r'<div class=\"move move--',m.group(1))))
json.load(open(root/'_extracts/tac-1-hello-agentic-coding/extract.json'))
json.load(open(root/'_extracts/tac-1-hello-agentic-coding/frame-plan.json'))
print('extract_json valid; frame_plan valid')
PY
