+}
+
+.hero__chapter {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  padding: .25rem .65rem;
+  border: 1px solid var(--accent);
+  border-radius: 999px;
+  color: var(--accent-ink);
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+
+.hero h1 {
+  position: relative;
+  z-index: 1;
+  max-width: 13ch;
+  margin-top: var(--space-4);
+  font-size: clamp(2.65rem, 7vw, 5.8rem);
+  line-height: .97;
+}
+
+.hero__dek {
+  position: relative;
+  z-index: 1;
+  max-width: 52ch;
+  margin-top: var(--space-5);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: clamp(1.2rem, 2.5vw, 1.65rem);
+  line-height: 1.35;
+}
+
+.hero__meta {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.hero__meta li {
+  padding: .3rem .7rem;
+  border-radius: 999px;
+  color: var(--ink-soft);
+  background: var(--bg-inset);
+  font-size: var(--text-sm);
+}
+
+.hero__promise {
+  position: relative;
+  z-index: 1;
+  max-width: 46rem;
+  margin-top: var(--space-6);
+  padding-top: var(--space-4);
+  border-top: var(--hairline);
+}
+
+.chapter-section {
+  max-width: var(--content-max);
+  margin-inline: auto;
+  padding: var(--space-10) var(--space-4) 0;
+  scroll-margin-top: 5.5rem;
+}
+
+.chapter-section--wide { max-width: var(--wide-max); }
+
+.section-number {
+  display: inline-grid;
+  place-items: center;
+  width: 2.4rem;
+  height: 2.4rem;
+  border: 1px solid var(--accent);
+  border-radius: 50%;
+  color: var(--accent-ink);
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+}
+
+.section-title {
+  margin-top: var(--space-3);
+  font-size: clamp(2.1rem, 5vw, 3.8rem);
+}
+
+.section-lead {
+  margin-top: var(--space-4);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+  line-height: 1.45;
+}
+
+.learning-objectives {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.learning-objectives li {
+  padding: var(--space-4);
+  border: var(--hairline);
