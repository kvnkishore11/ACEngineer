python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urlparse
import re
for f in [Path('IndyDevDan/book/index.html'),Path('IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html')]:
 class P(HTMLParser):
  def __init__(self): super().__init__(); self.refs=[]; self.ids=[]
  def handle_starttag(self,t,a):
   d=dict(a)
   if 'id' in d:self.ids.append(d['id'])
   if t in {'img','link','script','a'}:
    key='href' if t in {'link','a'} else 'src'
    if d.get(key):self.refs.append(d[key])
 p=P();p.feed(f.read_text());miss=[]
 for ref in p.refs:
  u=urlparse(ref)
  if u.scheme or ref.startswith('#'):continue
  if not (f.parent/u.path).resolve().exists():miss.append(ref)
 print(f,'missing=',miss,'dupe_ids=',sorted({i for i in p.ids if p.ids.count(i)>1}))
