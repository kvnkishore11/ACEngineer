/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css
diff --git a/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css b/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css
new file mode 100644
index 0000000000000000000000000000000000000000..cec40f32a62e5641d28ec80c1c0a9d45c367786e
--- /dev/null
+++ b/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css
@@ -0,0 +1,742 @@
+/* TAC-1 chapter layout. Shared color and type values stay in ../design/tokens.css. */
+
+:root {
+  --rail-width: 17rem;
+  --chapter-max: 82rem;
+  --step-hook: #a33d2e;
+  --step-picture: #356b83;
+  --step-story: #7b5b25;
+  --step-name: #63477a;
+  --step-example: #3d7a4e;
+  --step-try: #b4530a;
+  --step-fail: #a33d2e;
+  --step-current: #356b83;
+  --step-check: #3d7a4e;
+  --step-teach: #63477a;
+}
+
+body {
+  background:
+    radial-gradient(circle at 88% 2%, color-mix(in srgb, var(--accent-wash) 68%, transparent) 0 17rem, transparent 38rem),
+    var(--bg);
+}
+
+.reading-progress {
+  position: fixed;
+  inset: 0 0 auto;
+  z-index: 100;
+  height: 4px;
+  background: var(--border-soft);
+}
+
+.reading-progress__bar {
+  display: block;
+  width: 0;
+  height: 100%;
+  background: var(--accent);
+  transition: width 80ms linear;
+}
+
+.site-bar {
+  position: sticky;
+  top: 4px;
+  z-index: 90;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  min-height: 3.25rem;
+  padding: var(--space-2) max(var(--space-4), calc((100vw - var(--chapter-max)) / 2));
+  border-bottom: var(--hairline);
+  background: color-mix(in srgb, var(--bg) 92%, transparent);
+  backdrop-filter: blur(12px);
+}
+
+.site-bar__home {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-size: var(--text-sm);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.site-bar__meta {
+  color: var(--ink-mute);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+}
+
+.chapter-shell {
+  display: grid;
+  grid-template-columns: var(--rail-width) minmax(0, 1fr);
+  gap: var(--space-8);
+  width: min(calc(100% - 2rem), var(--chapter-max));
+  margin-inline: auto;
+}
+
+.chapter-rail {
+  position: sticky;
+  top: 4.5rem;
+  align-self: start;
+  max-height: calc(100vh - 5.5rem);
+  padding: var(--space-6) var(--space-4) var(--space-6) 0;
+  overflow-y: auto;
+  scrollbar-width: thin;
+}
+
+.rail-kicker,
+.eyebrow,
+.move-label,
+.micro-label {
+  color: var(--accent-ink);
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .09em;
+  text-transform: uppercase;
+}
+
+.chapter-rail h2 {
+  margin-top: var(--space-2);
+  font-family: var(--font-body);
+  font-size: var(--text-md);
+  letter-spacing: 0;
+}
+
+.rail-progress {
+  margin-top: var(--space-4);
+  padding-bottom: var(--space-4);
+  border-bottom: var(--hairline);
+}
+
+.rail-progress__line {
+  height: .45rem;
+  margin-top: var(--space-2);
+  overflow: hidden;
+  border-radius: 999px;
+  background: var(--bg-inset);
+}
+
+.rail-progress__fill {
+  display: block;
+  width: 0;
+  height: 100%;
+  border-radius: inherit;
+  background: var(--accent);
+}
+
+.rail-progress__copy {
+  display: flex;
+  justify-content: space-between;
+  margin-top: var(--space-2);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.chapter-nav {
+  margin-top: var(--space-4);
+}
+
+.chapter-nav ol {
+  padding: 0;
+  list-style: none;
+}
+
+.chapter-nav li + li { margin-top: var(--space-1); }
+
+.chapter-nav a {
+  display: grid;
+  grid-template-columns: 1.5rem 1fr;
+  gap: var(--space-2);
+  padding: .38rem .45rem;
+  border-radius: var(--radius-sm);
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+  line-height: 1.3;
+  text-decoration: none;
+}
+
+.chapter-nav a:hover,
+.chapter-nav a[aria-current="location"] {
+  color: var(--accent-ink);
+  background: var(--accent-wash);
+}
+
+.chapter-nav__n {
+  color: var(--ink-mute);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+}
+
+.chapter-main {
+  min-width: 0;
+  padding-bottom: var(--space-12);
+}
+
+.hero {
+  position: relative;
+  margin: var(--space-8) 0 var(--space-10);
+  padding: clamp(1.5rem, 5vw, 4.5rem);
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: 1.5rem;
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.hero::after {
+  position: absolute;
+  right: -7rem;
+  bottom: -9rem;
+  width: 22rem;
+  height: 22rem;
+  border: 5rem solid var(--accent-wash);
+  border-radius: 50%;
+  content: "";
+}
+
+.hero__chapter {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  padding: .25rem .65rem;
+  border: 1px solid var(--accent);
+  border-radius: 999px;
+  color: var(--accent-ink);
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+
+.hero h1 {
+  position: relative;
+  z-index: 1;
+  max-width: 13ch;
+  margin-top: var(--space-4);
+  font-size: clamp(2.65rem, 7vw, 5.8rem);
+  line-height: .97;
+}
+
+.hero__dek {
+  position: relative;
+  z-index: 1;
+  max-width: 52ch;
+  margin-top: var(--space-5);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: clamp(1.2rem, 2.5vw, 1.65rem);
+  line-height: 1.35;
+}
+
+.hero__meta {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.hero__meta li {
+  padding: .3rem .7rem;
+  border-radius: 999px;
+  color: var(--ink-soft);
+  background: var(--bg-inset);
+  font-size: var(--text-sm);
+}
+
+.hero__promise {
+  position: relative;
+  z-index: 1;
+  max-width: 46rem;
+  margin-top: var(--space-6);
+  padding-top: var(--space-4);
+  border-top: var(--hairline);
+}
+
+.chapter-section {
+  max-width: var(--content-max);
+  margin-inline: auto;
+  padding: var(--space-10) var(--space-4) 0;
+  scroll-margin-top: 5.5rem;
+}
+
+.chapter-section--wide { max-width: var(--wide-max); }
+
+.section-number {
+  display: inline-grid;
+  place-items: center;
+  width: 2.4rem;
+  height: 2.4rem;
+  border: 1px solid var(--accent);
+  border-radius: 50%;
+  color: var(--accent-ink);
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+}
+
+.section-title {
+  margin-top: var(--space-3);
+  font-size: clamp(2.1rem, 5vw, 3.8rem);
+}
+
+.section-lead {
+  margin-top: var(--space-4);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+  line-height: 1.45;
+}
+
+.learning-objectives {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.learning-objectives li {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.learning-objectives strong {
+  display: block;
+  margin-bottom: var(--space-1);
+  color: var(--accent-ink);
+  font-size: var(--text-sm);
+}
+
+.idea-cycle {
+  padding-top: var(--space-8);
+}
+
+.move {
+  position: relative;
+  margin-top: var(--space-6);
+  padding-left: 2.25rem;
+}
+
+.move::before {
+  position: absolute;
+  top: .45rem;
+  left: .2rem;
+  width: .72rem;
+  height: .72rem;
+  border: 2px solid currentColor;
+  border-radius: 50%;
+  content: "";
+}
+
+.move::after {
+  position: absolute;
+  top: 1.55rem;
+  bottom: -1.7rem;
+  left: .54rem;
+  width: 1px;
+  background: var(--border);
+  content: "";
+}
+
+.move:last-child::after { display: none; }
+.move--hook { color: var(--step-hook); }
+.move--picture { color: var(--step-picture); }
+.move--story { color: var(--step-story); }
+.move--name { color: var(--step-name); }
+.move--example { color: var(--step-example); }
+.move--try { color: var(--step-try); }
+.move--fail { color: var(--step-fail); }
+.move--current { color: var(--step-current); }
+.move--check { color: var(--step-check); }
+.move--teach { color: var(--step-teach); }
+
+.move > *:not(.move-label) { color: var(--ink); }
+.move-label { color: currentColor; }
+.move h3 { margin-top: var(--space-2); color: var(--ink); }
+.move p + p,
+.move p + ul,
+.move p + ol,
+.move ul + p,
+.move ol + p,
+.move pre,
+.move figure,
+.move aside,
+.move .comparison,
+.move .retrieval-quiz,
+.move .workflow,
+.move .file-map { margin-top: var(--space-4); }
+
+.concept-strip {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.concept-strip__item {
+  min-height: 8rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.concept-strip__item b {
+  display: block;
+  margin-bottom: var(--space-2);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+}
+
+.concept-strip__item--new {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.comparison {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.comparison__card {
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.comparison__head {
+  padding: var(--space-4);
+  border-bottom: var(--hairline);
+}
+
+.comparison__head h3 { margin: 0; }
+.comparison__head p { margin-top: var(--space-2); color: var(--ink-soft); }
+.comparison__body { padding: var(--space-4); }
+.comparison__card--agentic { border-color: var(--accent); box-shadow: var(--shadow-card); }
+
+.workflow {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.workflow__step {
+  position: relative;
+  padding: var(--space-3);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+  text-align: center;
+}
+
+.workflow__step:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: -.72rem;
+  z-index: 2;
+  color: var(--accent);
+  content: "→";
+  font-weight: 800;
+  transform: translateY(-50%);
+}
+
+.workflow__step code {
+  display: block;
+  margin-top: var(--space-1);
+  font-size: var(--text-xs);
+}
+
+.core-four {
+  position: relative;
+  display: grid;
+  grid-template-columns: repeat(2, minmax(10rem, 1fr));
+  gap: var(--space-3);
+  max-width: 36rem;
+  margin-inline: auto;
+}
+
+.core-four__cell {
+  min-height: 11rem;
+  padding: var(--space-5);
+  border: 2px solid var(--border);
+  border-radius: 45% 55% 50% 50%;
+  background: color-mix(in srgb, var(--bg-card) 88%, var(--bg-inset));
+}
+
+.core-four__cell b {
+  display: block;
+  margin-bottom: var(--space-2);
+  color: var(--ink);
+  font-family: var(--font-display);
+  font-size: var(--text-lg);
+}
+
+.core-four__cell--tools {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.core-four__plus {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  display: grid;
+  place-items: center;
+  width: 3.25rem;
+  height: 3.25rem;
+  border-radius: 50%;
+  color: #fff;
+  background: var(--accent);
+  font: 800 var(--text-lg)/1 var(--font-body);
+  transform: translate(-50%, -50%);
+}
+
+.file-map {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.file-map__item {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.file-map__item code {
+  display: inline-block;
+  margin-bottom: var(--space-2);
+  font-weight: 700;
+}
+
+.terminal {
+  overflow: hidden;
+  border: 1px solid #d3c9ba;
+  border-radius: var(--radius-lg);
+  background: #27231f;
+  color: #f5efe7;
+  box-shadow: var(--shadow-card);
+}
+
+.terminal__bar {
+  display: flex;
+  gap: .38rem;
+  padding: .65rem .8rem;
+  background: #39332d;
+}
+
+.terminal__dot { width: .65rem; height: .65rem; border-radius: 50%; background: #d7c6ae; }
+.terminal pre { margin: 0; border: 0; border-radius: 0; color: inherit; background: transparent; }
+
+.frame-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.frame-grid .frame-card { margin: 0; }
+
+.image-note {
+  margin-top: var(--space-2);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.lab-box { scroll-margin-top: 5.5rem; }
+.lab-box + .lab-box { margin-top: var(--space-5); }
+.lab-box__meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin: var(--space-3) 0 var(--space-4);
+  padding: 0;
+  list-style: none;
+}
+
+.lab-box__meta li {
+  padding: .15rem .55rem;
+  border-radius: 999px;
+  background: var(--bg-card);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.checkpoint {
+  margin-top: var(--space-4);
+  padding: var(--space-4);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-md);
+  background: var(--accent-wash);
+}
+
+.checkpoint strong { color: var(--accent-ink); }
+
+.teach-back {
+  padding: var(--space-5);
+  border: 2px solid color-mix(in srgb, var(--step-teach) 70%, var(--border));
+  border-radius: var(--radius-lg);
+  background: color-mix(in srgb, var(--bg-card) 84%, #ece3f4);
+}
+
+.teach-back p + p { margin-top: var(--space-3); }
+
+.video-cards {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.video-card {
+  display: flex;
+  flex-direction: column;
+  min-height: 12rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  color: var(--ink);
+  background: var(--bg-card);
+  text-decoration: none;
+  box-shadow: var(--shadow-card);
+}
+
+.video-card:hover { border-color: var(--accent); }
+.video-card__type { color: var(--accent-ink); font-size: var(--text-xs); font-weight: 750; text-transform: uppercase; letter-spacing: .07em; }
+.video-card strong { display: block; margin-top: var(--space-3); font-family: var(--font-display); font-size: var(--text-md); line-height: 1.25; }
+.video-card p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.video-card__watch { margin-top: auto; padding-top: var(--space-3); color: var(--accent-ink); font-size: var(--text-sm); font-weight: 700; }
+
+.paradox {
+  position: relative;
+  padding: clamp(2rem, 6vw, 5rem);
+  overflow: hidden;
+  border-radius: 1.5rem;
+  color: var(--ink);
+  background: var(--accent-wash);
+  text-align: center;
+}
+
+.paradox::before,
+.paradox::after {
+  position: absolute;
+  color: color-mix(in srgb, var(--accent) 17%, transparent);
+  font: 700 12rem/1 var(--font-display);
+  content: "“";
+}
+
+.paradox::before { top: -3rem; left: 1rem; }
+.paradox::after { right: 1rem; bottom: -8rem; transform: rotate(180deg); }
+.paradox blockquote { position: relative; z-index: 1; border: 0; color: var(--ink); font: 600 clamp(2rem, 5vw, 4rem)/1.08 var(--font-display); }
+.paradox cite { color: var(--accent-ink); }
+
+.glossary {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.glossary div {
+  padding: var(--space-4);
+  border-top: 2px solid var(--border);
+}
+
+.glossary dt { font-family: var(--font-display); font-size: var(--text-md); font-weight: 650; }
+.glossary dd { margin-top: var(--space-2); color: var(--ink-soft); }
+
+.chapter-footer {
+  max-width: var(--wide-max);
+  margin: var(--space-10) auto 0;
+  padding: var(--space-6) var(--space-4);
+  border-top: var(--hairline);
+}
+
+.chapter-footer__nav {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-4);
+}
+
+.chapter-footer__nav a { font-weight: 700; }
+
+.mobile-toc { display: none; }
+
+@keyframes rise-in {
+  from { opacity: 0; transform: translateY(.6rem); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .hero,
+  .chapter-section { animation: rise-in .5s both; }
+}
+
+@media (max-width: 65rem) {
+  .chapter-shell { display: block; width: 100%; }
+  .chapter-rail { display: none; }
+  .chapter-main { width: 100%; }
+  .hero { margin: var(--space-4); }
+  .mobile-toc {
+    display: block;
+    max-width: var(--content-max);
+    margin: 0 auto var(--space-6);
+    padding: 0 var(--space-4);
+  }
+  .mobile-toc details { padding: var(--space-3) var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+  .mobile-toc summary { cursor: pointer; font-weight: 700; }
+  .mobile-toc ol { margin-top: var(--space-3); }
+}
+
+@media (max-width: 46rem) {
+  .site-bar__meta { display: none; }
+  .hero h1 { font-size: clamp(2.55rem, 15vw, 4.6rem); }
+  .learning-objectives,
+  .comparison,
+  .concept-strip,
+  .file-map,
+  .frame-grid,
+  .glossary,
+  .video-cards { grid-template-columns: 1fr; }
+  .workflow { grid-template-columns: 1fr; }
+  .workflow__step:not(:last-child)::after { top: auto; right: 50%; bottom: -.85rem; transform: translateX(50%) rotate(90deg); }
+  .move { padding-left: 1.75rem; }
+  .core-four { grid-template-columns: 1fr; }
+  .core-four__plus { display: none; }
+}
+
+@media print {
+  @page { margin: .7in; }
+  body { background: #fff; font-size: 10.5pt; }
+  .reading-progress,
+  .site-bar,
+  .chapter-rail,
+  .mobile-toc { display: none !important; }
+  .chapter-shell { display: block; width: auto; }
+  .hero { margin-top: 0; break-after: page; box-shadow: none; }
+  .chapter-section { max-width: none; padding-inline: 0; }
+  .chapter-section[id] { break-before: page; }
+  .move,
+  .callout,
+  .frame-card,
+  .diagram,
+  .retrieval-quiz__item,
+  .lab-box { break-inside: avoid; }
+  .frame-card img { max-height: 4.2in; object-fit: contain; }
+  .chapter-footer { display: none; }
+  a { color: inherit; text-decoration: none; }
+}

diff --git a/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css b/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css
new file mode 100644
index 0000000000000000000000000000000000000000..cec40f32a62e5641d28ec80c1c0a9d45c367786e
--- /dev/null
+++ b/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css
@@ -0,0 +1,742 @@
+/* TAC-1 chapter layout. Shared color and type values stay in ../design/tokens.css. */
+
+:root {
+  --rail-width: 17rem;
+  --chapter-max: 82rem;
+  --step-hook: #a33d2e;
+  --step-picture: #356b83;
+  --step-story: #7b5b25;
+  --step-name: #63477a;
+  --step-example: #3d7a4e;
+  --step-try: #b4530a;
+  --step-fail: #a33d2e;
+  --step-current: #356b83;
+  --step-check: #3d7a4e;
+  --step-teach: #63477a;
+}
+
+body {
+  background:
+    radial-gradient(circle at 88% 2%, color-mix(in srgb, var(--accent-wash) 68%, transparent) 0 17rem, transparent 38rem),
+    var(--bg);
+}
+
+.reading-progress {
+  position: fixed;
+  inset: 0 0 auto;
+  z-index: 100;
+  height: 4px;
+  background: var(--border-soft);
+}
+
+.reading-progress__bar {
+  display: block;
+  width: 0;
+  height: 100%;
+  background: var(--accent);
+  transition: width 80ms linear;
+}
+
+.site-bar {
+  position: sticky;
+  top: 4px;
+  z-index: 90;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  min-height: 3.25rem;
+  padding: var(--space-2) max(var(--space-4), calc((100vw - var(--chapter-max)) / 2));
+  border-bottom: var(--hairline);
+  background: color-mix(in srgb, var(--bg) 92%, transparent);
+  backdrop-filter: blur(12px);
+}
+
+.site-bar__home {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-size: var(--text-sm);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.site-bar__meta {
+  color: var(--ink-mute);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+}
+
+.chapter-shell {
+  display: grid;
+  grid-template-columns: var(--rail-width) minmax(0, 1fr);
+  gap: var(--space-8);
+  width: min(calc(100% - 2rem), var(--chapter-max));
+  margin-inline: auto;
+}
+
+.chapter-rail {
+  position: sticky;
+  top: 4.5rem;
+  align-self: start;
+  max-height: calc(100vh - 5.5rem);
+  padding: var(--space-6) var(--space-4) var(--space-6) 0;
+  overflow-y: auto;
+  scrollbar-width: thin;
+}
+
+.rail-kicker,
+.eyebrow,
+.move-label,
+.micro-label {
+  color: var(--accent-ink);
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .09em;
+  text-transform: uppercase;
+}
+
+.chapter-rail h2 {
+  margin-top: var(--space-2);
+  font-family: var(--font-body);
+  font-size: var(--text-md);
+  letter-spacing: 0;
+}
+
+.rail-progress {
+  margin-top: var(--space-4);
+  padding-bottom: var(--space-4);
+  border-bottom: var(--hairline);
+}
+
+.rail-progress__line {
+  height: .45rem;
+  margin-top: var(--space-2);
+  overflow: hidden;
+  border-radius: 999px;
+  background: var(--bg-inset);
+}
+
+.rail-progress__fill {
+  display: block;
+  width: 0;
+  height: 100%;
+  border-radius: inherit;
+  background: var(--accent);
+}
+
+.rail-progress__copy {
+  display: flex;
+  justify-content: space-between;
+  margin-top: var(--space-2);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.chapter-nav {
+  margin-top: var(--space-4);
+}
+
+.chapter-nav ol {
+  padding: 0;
+  list-style: none;
+}
+
+.chapter-nav li + li { margin-top: var(--space-1); }
+
+.chapter-nav a {
+  display: grid;
+  grid-template-columns: 1.5rem 1fr;
+  gap: var(--space-2);
+  padding: .38rem .45rem;
+  border-radius: var(--radius-sm);
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+  line-height: 1.3;
+  text-decoration: none;
+}
+
+.chapter-nav a:hover,
+.chapter-nav a[aria-current="location"] {
+  color: var(--accent-ink);
+  background: var(--accent-wash);
+}
+
+.chapter-nav__n {
+  color: var(--ink-mute);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+}
+
+.chapter-main {
+  min-width: 0;
+  padding-bottom: var(--space-12);
+}
+
+.hero {
+  position: relative;
+  margin: var(--space-8) 0 var(--space-10);
+  padding: clamp(1.5rem, 5vw, 4.5rem);
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: 1.5rem;
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.hero::after {
+  position: absolute;
+  right: -7rem;
+  bottom: -9rem;
+  width: 22rem;
+  height: 22rem;
+  border: 5rem solid var(--accent-wash);
+  border-radius: 50%;
+  content: "";
+}
+
+.hero__chapter {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  padding: .25rem .65rem;
+  border: 1px solid var(--accent);
+  border-radius: 999px;
+  color: var(--accent-ink);
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+
+.hero h1 {
+  position: relative;
+  z-index: 1;
+  max-width: 13ch;
+  margin-top: var(--space-4);
+  font-size: clamp(2.65rem, 7vw, 5.8rem);
+  line-height: .97;
+}
+
+.hero__dek {
+  position: relative;
+  z-index: 1;
+  max-width: 52ch;
+  margin-top: var(--space-5);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: clamp(1.2rem, 2.5vw, 1.65rem);
+  line-height: 1.35;
+}
+
+.hero__meta {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.hero__meta li {
+  padding: .3rem .7rem;
+  border-radius: 999px;
+  color: var(--ink-soft);
+  background: var(--bg-inset);
+  font-size: var(--text-sm);
+}
+
+.hero__promise {
+  position: relative;
+  z-index: 1;
+  max-width: 46rem;
+  margin-top: var(--space-6);
+  padding-top: var(--space-4);
+  border-top: var(--hairline);
+}
+
+.chapter-section {
+  max-width: var(--content-max);
+  margin-inline: auto;
+  padding: var(--space-10) var(--space-4) 0;
+  scroll-margin-top: 5.5rem;
+}
+
+.chapter-section--wide { max-width: var(--wide-max); }
+
+.section-number {
+  display: inline-grid;
+  place-items: center;
+  width: 2.4rem;
+  height: 2.4rem;
+  border: 1px solid var(--accent);
+  border-radius: 50%;
+  color: var(--accent-ink);
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+}
+
+.section-title {
+  margin-top: var(--space-3);
+  font-size: clamp(2.1rem, 5vw, 3.8rem);
+}
+
+.section-lead {
+  margin-top: var(--space-4);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+  line-height: 1.45;
+}
+
+.learning-objectives {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.learning-objectives li {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.learning-objectives strong {
+  display: block;
+  margin-bottom: var(--space-1);
+  color: var(--accent-ink);
+  font-size: var(--text-sm);
+}
+
+.idea-cycle {
+  padding-top: var(--space-8);
+}
+
+.move {
+  position: relative;
+  margin-top: var(--space-6);
+  padding-left: 2.25rem;
+}
+
+.move::before {
+  position: absolute;
+  top: .45rem;
+  left: .2rem;
+  width: .72rem;
+  height: .72rem;
+  border: 2px solid currentColor;
+  border-radius: 50%;
+  content: "";
+}
+
+.move::after {
+  position: absolute;
+  top: 1.55rem;
+  bottom: -1.7rem;
+  left: .54rem;
+  width: 1px;
+  background: var(--border);
+  content: "";
+}
+
+.move:last-child::after { display: none; }
+.move--hook { color: var(--step-hook); }
+.move--picture { color: var(--step-picture); }
+.move--story { color: var(--step-story); }
+.move--name { color: var(--step-name); }
+.move--example { color: var(--step-example); }
+.move--try { color: var(--step-try); }
+.move--fail { color: var(--step-fail); }
+.move--current { color: var(--step-current); }
+.move--check { color: var(--step-check); }
+.move--teach { color: var(--step-teach); }
+
+.move > *:not(.move-label) { color: var(--ink); }
+.move-label { color: currentColor; }
+.move h3 { margin-top: var(--space-2); color: var(--ink); }
+.move p + p,
+.move p + ul,
+.move p + ol,
+.move ul + p,
+.move ol + p,
+.move pre,
+.move figure,
+.move aside,
+.move .comparison,
+.move .retrieval-quiz,
+.move .workflow,
+.move .file-map { margin-top: var(--space-4); }
+
+.concept-strip {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.concept-strip__item {
+  min-height: 8rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.concept-strip__item b {
+  display: block;
+  margin-bottom: var(--space-2);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+}
+
+.concept-strip__item--new {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.comparison {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.comparison__card {
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.comparison__head {
+  padding: var(--space-4);
+  border-bottom: var(--hairline);
+}
+
+.comparison__head h3 { margin: 0; }
+.comparison__head p { margin-top: var(--space-2); color: var(--ink-soft); }
+.comparison__body { padding: var(--space-4); }
+.comparison__card--agentic { border-color: var(--accent); box-shadow: var(--shadow-card); }
+
+.workflow {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.workflow__step {
+  position: relative;
+  padding: var(--space-3);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+  text-align: center;
+}
+
+.workflow__step:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: -.72rem;
+  z-index: 2;
+  color: var(--accent);
+  content: "→";
+  font-weight: 800;
+  transform: translateY(-50%);
+}
+
+.workflow__step code {
+  display: block;
+  margin-top: var(--space-1);
+  font-size: var(--text-xs);
+}
+
+.core-four {
+  position: relative;
+  display: grid;
+  grid-template-columns: repeat(2, minmax(10rem, 1fr));
+  gap: var(--space-3);
+  max-width: 36rem;
+  margin-inline: auto;
+}
+
+.core-four__cell {
+  min-height: 11rem;
+  padding: var(--space-5);
+  border: 2px solid var(--border);
+  border-radius: 45% 55% 50% 50%;
+  background: color-mix(in srgb, var(--bg-card) 88%, var(--bg-inset));
+}
+
+.core-four__cell b {
+  display: block;
+  margin-bottom: var(--space-2);
+  color: var(--ink);
+  font-family: var(--font-display);
+  font-size: var(--text-lg);
+}
+
+.core-four__cell--tools {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.core-four__plus {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  display: grid;
+  place-items: center;
+  width: 3.25rem;
+  height: 3.25rem;
+  border-radius: 50%;
+  color: #fff;
+  background: var(--accent);
+  font: 800 var(--text-lg)/1 var(--font-body);
+  transform: translate(-50%, -50%);
+}
+
+.file-map {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.file-map__item {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.file-map__item code {
+  display: inline-block;
+  margin-bottom: var(--space-2);
+  font-weight: 700;
+}
+
+.terminal {
+  overflow: hidden;
+  border: 1px solid #d3c9ba;
+  border-radius: var(--radius-lg);
+  background: #27231f;
+  color: #f5efe7;
+  box-shadow: var(--shadow-card);
+}
+
+.terminal__bar {
+  display: flex;
+  gap: .38rem;
+  padding: .65rem .8rem;
+  background: #39332d;
+}
+
+.terminal__dot { width: .65rem; height: .65rem; border-radius: 50%; background: #d7c6ae; }
+.terminal pre { margin: 0; border: 0; border-radius: 0; color: inherit; background: transparent; }
+
+.frame-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.frame-grid .frame-card { margin: 0; }
+
+.image-note {
+  margin-top: var(--space-2);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.lab-box { scroll-margin-top: 5.5rem; }
+.lab-box + .lab-box { margin-top: var(--space-5); }
+.lab-box__meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin: var(--space-3) 0 var(--space-4);
+  padding: 0;
+  list-style: none;
+}
+
+.lab-box__meta li {
+  padding: .15rem .55rem;
+  border-radius: 999px;
+  background: var(--bg-card);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.checkpoint {
+  margin-top: var(--space-4);
+  padding: var(--space-4);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-md);
+  background: var(--accent-wash);
+}
+
+.checkpoint strong { color: var(--accent-ink); }
+
+.teach-back {
+  padding: var(--space-5);
+  border: 2px solid color-mix(in srgb, var(--step-teach) 70%, var(--border));
+  border-radius: var(--radius-lg);
+  background: color-mix(in srgb, var(--bg-card) 84%, #ece3f4);
+}
+
+.teach-back p + p { margin-top: var(--space-3); }
+
+.video-cards {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.video-card {
+  display: flex;
+  flex-direction: column;
+  min-height: 12rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  color: var(--ink);
+  background: var(--bg-card);
+  text-decoration: none;
+  box-shadow: var(--shadow-card);
+}
+
+.video-card:hover { border-color: var(--accent); }
+.video-card__type { color: var(--accent-ink); font-size: var(--text-xs); font-weight: 750; text-transform: uppercase; letter-spacing: .07em; }
+.video-card strong { display: block; margin-top: var(--space-3); font-family: var(--font-display); font-size: var(--text-md); line-height: 1.25; }
+.video-card p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.video-card__watch { margin-top: auto; padding-top: var(--space-3); color: var(--accent-ink); font-size: var(--text-sm); font-weight: 700; }
+
+.paradox {
+  position: relative;
+  padding: clamp(2rem, 6vw, 5rem);
+  overflow: hidden;
+  border-radius: 1.5rem;
+  color: var(--ink);
+  background: var(--accent-wash);
+  text-align: center;
+}
+
+.paradox::before,
+.paradox::after {
+  position: absolute;
+  color: color-mix(in srgb, var(--accent) 17%, transparent);
+  font: 700 12rem/1 var(--font-display);
+  content: "“";
+}
+
+.paradox::before { top: -3rem; left: 1rem; }
+.paradox::after { right: 1rem; bottom: -8rem; transform: rotate(180deg); }
+.paradox blockquote { position: relative; z-index: 1; border: 0; color: var(--ink); font: 600 clamp(2rem, 5vw, 4rem)/1.08 var(--font-display); }
+.paradox cite { color: var(--accent-ink); }
+
+.glossary {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.glossary div {
+  padding: var(--space-4);
+  border-top: 2px solid var(--border);
+}
+
+.glossary dt { font-family: var(--font-display); font-size: var(--text-md); font-weight: 650; }
+.glossary dd { margin-top: var(--space-2); color: var(--ink-soft); }
+
+.chapter-footer {
+  max-width: var(--wide-max);
+  margin: var(--space-10) auto 0;
+  padding: var(--space-6) var(--space-4);
+  border-top: var(--hairline);
+}
+
+.chapter-footer__nav {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-4);
+}
+
+.chapter-footer__nav a { font-weight: 700; }
+
+.mobile-toc { display: none; }
+
+@keyframes rise-in {
+  from { opacity: 0; transform: translateY(.6rem); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .hero,
+  .chapter-section { animation: rise-in .5s both; }
+}
+
+@media (max-width: 65rem) {
+  .chapter-shell { display: block; width: 100%; }
+  .chapter-rail { display: none; }
+  .chapter-main { width: 100%; }
+  .hero { margin: var(--space-4); }
+  .mobile-toc {
+    display: block;
+    max-width: var(--content-max);
+    margin: 0 auto var(--space-6);
+    padding: 0 var(--space-4);
+  }
+  .mobile-toc details { padding: var(--space-3) var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+  .mobile-toc summary { cursor: pointer; font-weight: 700; }
+  .mobile-toc ol { margin-top: var(--space-3); }
+}
+
+@media (max-width: 46rem) {
+  .site-bar__meta { display: none; }
+  .hero h1 { font-size: clamp(2.55rem, 15vw, 4.6rem); }
+  .learning-objectives,
+  .comparison,
+  .concept-strip,
+  .file-map,
+  .frame-grid,
+  .glossary,
+  .video-cards { grid-template-columns: 1fr; }
+  .workflow { grid-template-columns: 1fr; }
+  .workflow__step:not(:last-child)::after { top: auto; right: 50%; bottom: -.85rem; transform: translateX(50%) rotate(90deg); }
+  .move { padding-left: 1.75rem; }
+  .core-four { grid-template-columns: 1fr; }
+  .core-four__plus { display: none; }
+}
+
+@media print {
+  @page { margin: .7in; }
+  body { background: #fff; font-size: 10.5pt; }
+  .reading-progress,
+  .site-bar,
+  .chapter-rail,
+  .mobile-toc { display: none !important; }
+  .chapter-shell { display: block; width: auto; }
+  .hero { margin-top: 0; break-after: page; box-shadow: none; }
+  .chapter-section { max-width: none; padding-inline: 0; }
+  .chapter-section[id] { break-before: page; }
+  .move,
+  .callout,
+  .frame-card,
+  .diagram,
+  .retrieval-quiz__item,
+  .lab-box { break-inside: avoid; }
+  .frame-card img { max-height: 4.2in; object-fit: contain; }
+  .chapter-footer { display: none; }
+  a { color: inherit; text-decoration: none; }
+}

