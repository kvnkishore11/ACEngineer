+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="A teaching-first field guide to IndyDevDan's Tactical Agentic Coding, Agentic Horizon, and multi-agent systems.">
