+++ b/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.assets.css
@@ -0,0 +1,742 @@
+/* TAC-1 chapter layout. Shared color and type values stay in ../design/tokens.css. */
+
+:root {
+  --rail-width: 17rem;
+  --chapter-max: 82rem;
+  --step-hook: #a33d2e;
+  --step-picture: #356b83;
+  --step-story: #7b5b25;
+  --step-name: #63477a;
+  --step-example: #3d7a4e;
+  --step-try: #b4530a;
+  --step-fail: #a33d2e;
+  --step-current: #356b83;
+  --step-check: #3d7a4e;
+  --step-teach: #63477a;
+}
+
+body {
+  background:
+    radial-gradient(circle at 88% 2%, color-mix(in srgb, var(--accent-wash) 68%, transparent) 0 17rem, transparent 38rem),
+    var(--bg);
+}
+
+.reading-progress {
+  position: fixed;
+  inset: 0 0 auto;
+  z-index: 100;
+  height: 4px;
+  background: var(--border-soft);
+}
+
+.reading-progress__bar {
+  display: block;
+  width: 0;
+  height: 100%;
+  background: var(--accent);
+  transition: width 80ms linear;
+}
+
+.site-bar {
+  position: sticky;
+  top: 4px;
+  z-index: 90;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  min-height: 3.25rem;
+  padding: var(--space-2) max(var(--space-4), calc((100vw - var(--chapter-max)) / 2));
+  border-bottom: var(--hairline);
+  background: color-mix(in srgb, var(--bg) 92%, transparent);
+  backdrop-filter: blur(12px);
+}
+
+.site-bar__home {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-size: var(--text-sm);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.site-bar__meta {
+  color: var(--ink-mute);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+}
+
+.chapter-shell {
+  display: grid;
+  grid-template-columns: var(--rail-width) minmax(0, 1fr);
+  gap: var(--space-8);
+  width: min(calc(100% - 2rem), var(--chapter-max));
+  margin-inline: auto;
+}
+
+.chapter-rail {
+  position: sticky;
+  top: 4.5rem;
+  align-self: start;
+  max-height: calc(100vh - 5.5rem);
+  padding: var(--space-6) var(--space-4) var(--space-6) 0;
+  overflow-y: auto;
+  scrollbar-width: thin;
+}
+
+.rail-kicker,
+.eyebrow,
+.move-label,
+.micro-label {
+  color: var(--accent-ink);
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .09em;
+  text-transform: uppercase;
+}
+
+.chapter-rail h2 {
+  margin-top: var(--space-2);
+  font-family: var(--font-body);
+  font-size: var(--text-md);
+  letter-spacing: 0;
+}
+
+.rail-progress {
+  margin-top: var(--space-4);
+  padding-bottom: var(--space-4);
+  border-bottom: var(--hairline);
+}
+
+.rail-progress__line {
+  height: .45rem;
+  margin-top: var(--space-2);
+  overflow: hidden;
+  border-radius: 999px;
+  background: var(--bg-inset);
+}
+
+.rail-progress__fill {
+  display: block;
+  width: 0;
+  height: 100%;
+  border-radius: inherit;
+  background: var(--accent);
+}
+
+.rail-progress__copy {
+  display: flex;
+  justify-content: space-between;
+  margin-top: var(--space-2);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.chapter-nav {
+  margin-top: var(--space-4);
+}
+
+.chapter-nav ol {
+  padding: 0;
+  list-style: none;
+}
+
+.chapter-nav li + li { margin-top: var(--space-1); }
+
+.chapter-nav a {
+  display: grid;
+  grid-template-columns: 1.5rem 1fr;
+  gap: var(--space-2);
+  padding: .38rem .45rem;
+  border-radius: var(--radius-sm);
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+  line-height: 1.3;
+  text-decoration: none;
+}
+
+.chapter-nav a:hover,
+.chapter-nav a[aria-current="location"] {
+  color: var(--accent-ink);
+  background: var(--accent-wash);
+}
+
+.chapter-nav__n {
+  color: var(--ink-mute);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+}
+
+.chapter-main {
+  min-width: 0;
+  padding-bottom: var(--space-12);
+}
+
+.hero {
+  position: relative;
+  margin: var(--space-8) 0 var(--space-10);
+  padding: clamp(1.5rem, 5vw, 4.5rem);
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: 1.5rem;
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.hero::after {
+  position: absolute;
+  right: -7rem;
+  bottom: -9rem;
+  width: 22rem;
+  height: 22rem;
+  border: 5rem solid var(--accent-wash);
+  border-radius: 50%;
+  content: "";
+}
+
+.hero__chapter {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  padding: .25rem .65rem;
+  border: 1px solid var(--accent);
+  border-radius: 999px;
+  color: var(--accent-ink);
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+
+.hero h1 {
+  position: relative;
+  z-index: 1;
+  max-width: 13ch;
+  margin-top: var(--space-4);
+  font-size: clamp(2.65rem, 7vw, 5.8rem);
+  line-height: .97;
+}
+
+.hero__dek {
+  position: relative;
+  z-index: 1;
+  max-width: 52ch;
+  margin-top: var(--space-5);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: clamp(1.2rem, 2.5vw, 1.65rem);
+  line-height: 1.35;
+}
+
+.hero__meta {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.hero__meta li {
+  padding: .3rem .7rem;
+  border-radius: 999px;
+  color: var(--ink-soft);
+  background: var(--bg-inset);
+  font-size: var(--text-sm);
+}
+
+.hero__promise {
+  position: relative;
+  z-index: 1;
+  max-width: 46rem;
+  margin-top: var(--space-6);
+  padding-top: var(--space-4);
+  border-top: var(--hairline);
+}
+
+.chapter-section {
+  max-width: var(--content-max);
+  margin-inline: auto;
+  padding: var(--space-10) var(--space-4) 0;
+  scroll-margin-top: 5.5rem;
+}
+
+.chapter-section--wide { max-width: var(--wide-max); }
+
+.section-number {
+  display: inline-grid;
+  place-items: center;
+  width: 2.4rem;
+  height: 2.4rem;
+  border: 1px solid var(--accent);
+  border-radius: 50%;
+  color: var(--accent-ink);
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+}
+
+.section-title {
+  margin-top: var(--space-3);
+  font-size: clamp(2.1rem, 5vw, 3.8rem);
+}
+
+.section-lead {
+  margin-top: var(--space-4);
+  color: var(--ink-soft);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+  line-height: 1.45;
+}
+
+.learning-objectives {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+  margin-top: var(--space-6);
+  padding: 0;
+  list-style: none;
+}
+
+.learning-objectives li {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.learning-objectives strong {
+  display: block;
+  margin-bottom: var(--space-1);
+  color: var(--accent-ink);
+  font-size: var(--text-sm);
+}
+
+.idea-cycle {
+  padding-top: var(--space-8);
+}
+
+.move {
+  position: relative;
+  margin-top: var(--space-6);
+  padding-left: 2.25rem;
+}
+
+.move::before {
+  position: absolute;
+  top: .45rem;
+  left: .2rem;
+  width: .72rem;
+  height: .72rem;
+  border: 2px solid currentColor;
+  border-radius: 50%;
+  content: "";
+}
+
+.move::after {
+  position: absolute;
+  top: 1.55rem;
+  bottom: -1.7rem;
+  left: .54rem;
+  width: 1px;
+  background: var(--border);
+  content: "";
+}
+
+.move:last-child::after { display: none; }
+.move--hook { color: var(--step-hook); }
+.move--picture { color: var(--step-picture); }
+.move--story { color: var(--step-story); }
+.move--name { color: var(--step-name); }
+.move--example { color: var(--step-example); }
+.move--try { color: var(--step-try); }
+.move--fail { color: var(--step-fail); }
+.move--current { color: var(--step-current); }
+.move--check { color: var(--step-check); }
+.move--teach { color: var(--step-teach); }
+
+.move > *:not(.move-label) { color: var(--ink); }
+.move-label { color: currentColor; }
+.move h3 { margin-top: var(--space-2); color: var(--ink); }
+.move p + p,
+.move p + ul,
+.move p + ol,
+.move ul + p,
+.move ol + p,
+.move pre,
+.move figure,
+.move aside,
+.move .comparison,
+.move .retrieval-quiz,
+.move .workflow,
+.move .file-map { margin-top: var(--space-4); }
+
+.concept-strip {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.concept-strip__item {
+  min-height: 8rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.concept-strip__item b {
+  display: block;
+  margin-bottom: var(--space-2);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+}
+
+.concept-strip__item--new {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.comparison {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.comparison__card {
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.comparison__head {
+  padding: var(--space-4);
+  border-bottom: var(--hairline);
+}
+
+.comparison__head h3 { margin: 0; }
+.comparison__head p { margin-top: var(--space-2); color: var(--ink-soft); }
+.comparison__body { padding: var(--space-4); }
+.comparison__card--agentic { border-color: var(--accent); box-shadow: var(--shadow-card); }
+
+.workflow {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.workflow__step {
+  position: relative;
+  padding: var(--space-3);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+  text-align: center;
+}
+
+.workflow__step:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: -.72rem;
+  z-index: 2;
+  color: var(--accent);
+  content: "→";
+  font-weight: 800;
+  transform: translateY(-50%);
+}
+
+.workflow__step code {
+  display: block;
+  margin-top: var(--space-1);
+  font-size: var(--text-xs);
+}
+
+.core-four {
+  position: relative;
+  display: grid;
+  grid-template-columns: repeat(2, minmax(10rem, 1fr));
+  gap: var(--space-3);
+  max-width: 36rem;
+  margin-inline: auto;
+}
+
+.core-four__cell {
+  min-height: 11rem;
+  padding: var(--space-5);
+  border: 2px solid var(--border);
+  border-radius: 45% 55% 50% 50%;
+  background: color-mix(in srgb, var(--bg-card) 88%, var(--bg-inset));
+}
+
+.core-four__cell b {
+  display: block;
+  margin-bottom: var(--space-2);
+  color: var(--ink);
+  font-family: var(--font-display);
+  font-size: var(--text-lg);
+}
+
+.core-four__cell--tools {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.core-four__plus {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  display: grid;
+  place-items: center;
+  width: 3.25rem;
+  height: 3.25rem;
+  border-radius: 50%;
+  color: #fff;
+  background: var(--accent);
+  font: 800 var(--text-lg)/1 var(--font-body);
+  transform: translate(-50%, -50%);
+}
+
+.file-map {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.file-map__item {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.file-map__item code {
+  display: inline-block;
+  margin-bottom: var(--space-2);
+  font-weight: 700;
+}
+
+.terminal {
+  overflow: hidden;
+  border: 1px solid #d3c9ba;
+  border-radius: var(--radius-lg);
+  background: #27231f;
+  color: #f5efe7;
+  box-shadow: var(--shadow-card);
+}
+
+.terminal__bar {
+  display: flex;
+  gap: .38rem;
+  padding: .65rem .8rem;
+  background: #39332d;
+}
+
+.terminal__dot { width: .65rem; height: .65rem; border-radius: 50%; background: #d7c6ae; }
+.terminal pre { margin: 0; border: 0; border-radius: 0; color: inherit; background: transparent; }
+
+.frame-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.frame-grid .frame-card { margin: 0; }
+
+.image-note {
+  margin-top: var(--space-2);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.lab-box { scroll-margin-top: 5.5rem; }
+.lab-box + .lab-box { margin-top: var(--space-5); }
+.lab-box__meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin: var(--space-3) 0 var(--space-4);
+  padding: 0;
+  list-style: none;
+}
+
+.lab-box__meta li {
+  padding: .15rem .55rem;
+  border-radius: 999px;
+  background: var(--bg-card);
+  color: var(--ink-mute);
+  font-size: var(--text-xs);
+}
+
+.checkpoint {
+  margin-top: var(--space-4);
+  padding: var(--space-4);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-md);
+  background: var(--accent-wash);
+}
+
+.checkpoint strong { color: var(--accent-ink); }
+
+.teach-back {
+  padding: var(--space-5);
+  border: 2px solid color-mix(in srgb, var(--step-teach) 70%, var(--border));
+  border-radius: var(--radius-lg);
+  background: color-mix(in srgb, var(--bg-card) 84%, #ece3f4);
+}
+
+.teach-back p + p { margin-top: var(--space-3); }
+
+.video-cards {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.video-card {
+  display: flex;
+  flex-direction: column;
+  min-height: 12rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  color: var(--ink);
+  background: var(--bg-card);
+  text-decoration: none;
+  box-shadow: var(--shadow-card);
+}
+
+.video-card:hover { border-color: var(--accent); }
+.video-card__type { color: var(--accent-ink); font-size: var(--text-xs); font-weight: 750; text-transform: uppercase; letter-spacing: .07em; }
+.video-card strong { display: block; margin-top: var(--space-3); font-family: var(--font-display); font-size: var(--text-md); line-height: 1.25; }
+.video-card p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.video-card__watch { margin-top: auto; padding-top: var(--space-3); color: var(--accent-ink); font-size: var(--text-sm); font-weight: 700; }
+
+.paradox {
+  position: relative;
+  padding: clamp(2rem, 6vw, 5rem);
+  overflow: hidden;
+  border-radius: 1.5rem;
+  color: var(--ink);
+  background: var(--accent-wash);
+  text-align: center;
+}
+
+.paradox::before,
+.paradox::after {
+  position: absolute;
+  color: color-mix(in srgb, var(--accent) 17%, transparent);
+  font: 700 12rem/1 var(--font-display);
+  content: "“";
+}
+
+.paradox::before { top: -3rem; left: 1rem; }
+.paradox::after { right: 1rem; bottom: -8rem; transform: rotate(180deg); }
+.paradox blockquote { position: relative; z-index: 1; border: 0; color: var(--ink); font: 600 clamp(2rem, 5vw, 4rem)/1.08 var(--font-display); }
+.paradox cite { color: var(--accent-ink); }
+
+.glossary {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.glossary div {
+  padding: var(--space-4);
+  border-top: 2px solid var(--border);
+}
+
+.glossary dt { font-family: var(--font-display); font-size: var(--text-md); font-weight: 650; }
+.glossary dd { margin-top: var(--space-2); color: var(--ink-soft); }
+
+.chapter-footer {
+  max-width: var(--wide-max);
+  margin: var(--space-10) auto 0;
+  padding: var(--space-6) var(--space-4);
+  border-top: var(--hairline);
+}
+
+.chapter-footer__nav {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-4);
+}
+
+.chapter-footer__nav a { font-weight: 700; }
+
+.mobile-toc { display: none; }
+
+@keyframes rise-in {
+  from { opacity: 0; transform: translateY(.6rem); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .hero,
+  .chapter-section { animation: rise-in .5s both; }
+}
+
+@media (max-width: 65rem) {
+  .chapter-shell { display: block; width: 100%; }
+  .chapter-rail { display: none; }
+  .chapter-main { width: 100%; }
+  .hero { margin: var(--space-4); }
+  .mobile-toc {
+    display: block;
+    max-width: var(--content-max);
+    margin: 0 auto var(--space-6);
+    padding: 0 var(--space-4);
+  }
+  .mobile-toc details { padding: var(--space-3) var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+  .mobile-toc summary { cursor: pointer; font-weight: 700; }
+  .mobile-toc ol { margin-top: var(--space-3); }
+}
+
+@media (max-width: 46rem) {
+  .site-bar__meta { display: none; }
+  .hero h1 { font-size: clamp(2.55rem, 15vw, 4.6rem); }
+  .learning-objectives,
+  .comparison,
+  .concept-strip,
+  .file-map,
+  .frame-grid,
+  .glossary,
+  .video-cards { grid-template-columns: 1fr; }
+  .workflow { grid-template-columns: 1fr; }
+  .workflow__step:not(:last-child)::after { top: auto; right: 50%; bottom: -.85rem; transform: translateX(50%) rotate(90deg); }
+  .move { padding-left: 1.75rem; }
+  .core-four { grid-template-columns: 1fr; }
+  .core-four__plus { display: none; }
+}
+
+@media print {
+  @page { margin: .7in; }
+  body { background: #fff; font-size: 10.5pt; }
+  .reading-progress,
+  .site-bar,
+  .chapter-rail,
+  .mobile-toc { display: none !important; }
+  .chapter-shell { display: block; width: auto; }
+  .hero { margin-top: 0; break-after: page; box-shadow: none; }
+  .chapter-section { max-width: none; padding-inline: 0; }
+  .chapter-section[id] { break-before: page; }
+  .move,
+  .callout,
+  .frame-card,
+  .diagram,
+  .retrieval-quiz__item,
+  .lab-box { break-inside: avoid; }
+  .frame-card img { max-height: 4.2in; object-fit: contain; }
+  .chapter-footer { display: none; }
+  a { color: inherit; text-decoration: none; }
+}
diff --git a/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html b/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html
new file mode 100644
index 0000000000000000000000000000000000000000..9d6c5d324330341773f8b5d4253fe3381cf6a8e6
--- /dev/null
+++ b/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html
@@ -0,0 +1,1658 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="A teaching-first companion to TAC-1: Hello Agentic Coding. Learn the Core Four, stop hand-typing code, and turn Claude Code into a programmable agent.">
+  <title>TAC-1 · Hello Agentic Coding — IndyDevDan Expert Book</title>
+  <link rel="stylesheet" href="../design/tokens.css">
+  <link rel="stylesheet" href="../design/base.css">
+  <link rel="stylesheet" href="../design/components.css">
+  <link rel="stylesheet" href="01-hello-agentic-coding.assets.css">
+</head>
+<body>
+  <div class="reading-progress" aria-hidden="true"><span class="reading-progress__bar" id="top-progress"></span></div>
+  <header class="site-bar">
+    <a class="site-bar__home" href="../index.html" aria-label="Back to the book hub">← IndyDevDan Expert Book</a>
+    <span class="site-bar__meta">VOL I · TAC · CHAPTER 01</span>
+  </header>
+
+  <div class="chapter-shell">
+    <aside class="chapter-rail" aria-label="Chapter navigation">
+      <p class="rail-kicker">Volume I · Chapter 1</p>
+      <h2>Hello Agentic Coding</h2>
+      <div class="rail-progress">
+        <p class="micro-label">Reading progress</p>
+        <div class="rail-progress__line"><span class="rail-progress__fill" id="rail-progress"></span></div>
+        <p class="rail-progress__copy"><span id="progress-label">0%</span><span>of chapter</span></p>
+      </div>
+      <nav class="chapter-nav" aria-label="On this page">
+        <ol>
+          <li><a href="#orientation"><span class="chapter-nav__n">00</span><span>Orientation</span></a></li>
+          <li><a href="#idea-role"><span class="chapter-nav__n">01</span><span>The new role</span></a></li>
+          <li><a href="#idea-mission"><span class="chapter-nav__n">02</span><span>Mission &amp; leverage</span></a></li>
+          <li><a href="#idea-stop"><span class="chapter-nav__n">03</span><span>Stop coding</span></a></li>
+          <li><a href="#idea-core-four"><span class="chapter-nav__n">04</span><span>The Core Four</span></a></li>
+          <li><a href="#idea-ab"><span class="chapter-nav__n">05</span><span>The A/B demo</span></a></li>
+          <li><a href="#idea-tool"><span class="chapter-nav__n">06</span><span>Why this tool class works</span></a></li>
+          <li><a href="#idea-programmable"><span class="chapter-nav__n">07</span><span>Programmable agent</span></a></li>
+          <li><a href="#idea-paradox"><span class="chapter-nav__n">08</span><span>Replace yourself</span></a></li>
+          <li><a href="#lab"><span class="chapter-nav__n">09</span><span>Graded lab</span></a></li>
+          <li><a href="#mastery"><span class="chapter-nav__n">10</span><span>Mastery check</span></a></li>
+          <li><a href="#glossary"><span class="chapter-nav__n">11</span><span>Glossary</span></a></li>
+        </ol>
+      </nav>
+    </aside>
+
+    <main class="chapter-main" id="main-content">
+      <header class="hero">
+        <span class="hero__chapter">Tactic #1 · Stop Coding</span>
+        <h1>Hello Agentic Coding</h1>
+        <p class="hero__dek">The decisive move is not a better code-generation prompt. It is turning a prompt into a reliable engineering workflow—and turning the agent into a component you can call.</p>
+        <ul class="hero__meta" aria-label="Chapter details">
+          <li>Video spine · 21:51</li>
+          <li>Lab · 45–75 min</li>
+          <li>Course repo · tac/tac-1</li>
+          <li>Level · weak beginner → operator</li>
+        </ul>
+        <p class="hero__promise"><strong>Mastery promise.</strong> By the end, you will be able to diagnose agentic work with the Core Four, explain the exact difference between AI coding and agentic coding, reproduce Dan’s interactive and headless demos, and teach why “replace yourself” is a leverage strategy rather than a surrender.</p>
+      </header>
+
+      <div class="mobile-toc">
+        <details>
+          <summary>Chapter contents</summary>
+          <ol>
+            <li><a href="#orientation">Orientation</a></li>
+            <li><a href="#idea-role">The new role</a></li>
+            <li><a href="#idea-mission">Mission and leverage</a></li>
+            <li><a href="#idea-stop">Stop coding</a></li>
+            <li><a href="#idea-core-four">The Core Four</a></li>
+            <li><a href="#idea-ab">The A/B demo</a></li>
+            <li><a href="#idea-tool">Why this tool class works</a></li>
+            <li><a href="#idea-programmable">Programmable agent</a></li>
+            <li><a href="#idea-paradox">Replace yourself</a></li>
+            <li><a href="#lab">Graded lab</a></li>
+            <li><a href="#mastery">Mastery check</a></li>
+          </ol>
+        </details>
+      </div>
+
+      <section class="chapter-section" id="orientation">
+        <span class="section-number">00</span>
+        <h2 class="section-title">Begin with the failure, not the slogan</h2>
+        <p class="section-lead">You ask an AI to write a function. It gives you plausible code. You paste it into the repository, discover that it does not fit, repair two imports, run the tests, fix a test, create a branch, make the commit, and explain the result in Slack. The AI helped with one narrow slice. You still carried the workflow.</p>
+
+        <p>That is the concrete failure TAC-1 addresses. The problem is not that the generated code was bad. The problem is that the unit of delegation was too small. You delegated <em>typing</em> while retaining every transition that makes typing useful: reading the repository, choosing a safe branch, creating files, running programs, observing output, committing a coherent change, and reporting what happened. AI coding accelerated an activity. Agentic coding delegates an outcome-producing chain.</p>
+
+        <p>Dan’s lesson makes this distinction with almost comical economy. The source repository contains only seven files. Its README is exactly 35 lines. The generated programs print tiny messages. That smallness is deliberate. A realistic codebase would let you confuse complexity with the concept. Here the application code is so trivial that the only interesting variable is <strong>who moves the work through the engineering system</strong>.</p>
+
+        <aside class="callout callout--tactic">
+          <p class="callout__label">The chapter’s one-sentence thesis</p>
+          <p>AI coding uses context, model, and prompt to generate code. Agentic coding keeps those three and adds tools that can be executed reliably in a long chain—so the prompt becomes a workflow and the agent performs engineering work.</p>
+        </aside>
+
+        <h3>What you are training</h3>
+        <ul class="learning-objectives">
+          <li><strong>Discrimination</strong>Tell code generation apart from workflow execution even when both begin with a prompt.</li>
+          <li><strong>Diagnosis</strong>Locate failures in context, model, prompt, or tools instead of blindly rerolling.</li>
+          <li><strong>Operation</strong>Reproduce the branch → write → run → commit → report cycle in the real TAC-1 repo.</li>
+          <li><strong>Transfer</strong>Recognize how <code>claude -p</code> turns an interactive agent into a programmable building block.</li>
+        </ul>
+
+        <h3>How to use this chapter</h3>
+        <p>Do not read it as a transcript recap. Each major idea repeats the same ten learning moves: failure, picture, one demo move, term, worked example, a small action, failure repair, current-practice overlay, retrieval, and teach-back. That repetition is intentional. Expertise is not the ability to recognize Dan’s phrases. It is the ability to retrieve the idea under pressure, operate it in the course repository, notice when it fails, and explain it without the chapter open.</p>
+
+        <div class="callout callout--warning">
+          <p class="callout__label">Prime directive for every exercise</p>
+          <p>You type zero lines of application code by hand. “Stop coding” is a behavioral constraint, not a discussion topic. You may type prompts and terminal commands. When a generated file is imperfect, repair it through the agent so you practice controlling the loop.</p>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-role">
+        <span class="section-number">01</span>
+        <h2 class="section-title">A new role: the Agentic Engineer</h2>
+        <p class="section-lead">The title matters only if the work changes. “Agentic Engineer” is not a badge for someone who uses AI often; it names an engineer who builds systems able to take engineering actions.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The prompt expert who is still the workflow engine</h3>
+          <p>Imagine an engineer who can produce excellent code with a one-shot prompt. They know how to attach a specification, point at the right files, and ask for tests. Yet after every answer they manually copy code, open files, run commands, move changes onto a branch, decide whether the output succeeded, and write a summary. Their prompts improved. Their role did not. The human remains the glue between every step.</p>
+          <p>This is why “prompt engineer” is too narrow for Dan’s prediction. A clever request can improve a model’s answer. An agentic system changes who performs the sequence. If the human must relay every output into the next input, the human is still the orchestration layer. The system has intelligence but little agency.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — the two-phase map</p>
+          <h3>Move the boundary of delegation</h3>
+          <div class="comparison" aria-label="AI coding and agentic coding roles compared">
+            <article class="comparison__card">
+              <div class="comparison__head"><h3>Phase 1 · AI coding</h3><p>The agent produces code; the human carries the workflow.</p></div>
+              <div class="comparison__body">
+                <div class="workflow" style="grid-template-columns:1fr">
+                  <div class="workflow__step"><strong>Human</strong><code>context → prompt</code></div>
+                  <div class="workflow__step"><strong>Agent</strong><code>generate code</code></div>
+                  <div class="workflow__step"><strong>Human</strong><code>write → run → fix → commit → report</code></div>
+                </div>
+              </div>
+            </article>
+            <article class="comparison__card comparison__card--agentic">
+              <div class="comparison__head"><h3>Phase 2 · Agentic coding</h3><p>The human specifies and reviews; the agent carries the workflow.</p></div>
+              <div class="comparison__body">
+                <div class="workflow" style="grid-template-columns:1fr">
+                  <div class="workflow__step"><strong>Human</strong><code>goal + constraints + checks</code></div>
+                  <div class="workflow__step"><strong>Agent</strong><code>branch → write → run → commit → report</code></div>
+                  <div class="workflow__step"><strong>Human</strong><code>review outcome + improve loop</code></div>
+                </div>
+              </div>
+            </article>
+          </div>
+          <p>The important movement is the boundary. The human does not disappear. The human moves from carrying transitions to designing them, setting constraints, and evaluating the result.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>A 2023 bet becomes a visible phase change</h3>
+          <p>Dan opens with a concrete personal bet: in 2023 he bought <em>agenticengineer.com</em>, predicting a role defined by “the ability to build systems that can take actions as we can.” The claim is not that engineers vanish. It is that an engineer’s leverage shifts from personally performing actions to constructing systems that can perform them.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/tac-1/t0115-phase-1-vs-phase-2.jpg" alt="Dan's phase diagram moving from AI coding in phase one to agentic coding in phase two" loading="lazy">
+            <figcaption><span class="frame-card__t">1:55</span>Dan places AI coding and agentic coding on a two-phase timeline. Keep this scaffold visible: phase two is a superset, not a rejection, of phase one.</figcaption>
+          </figure>
+          <p>His one move is conceptual before it is technical: name the era change. In phase one, prompt-to-code makes code abundant and gives rise to vibe coding. In phase two, the engineering response is to command systems that take actions. That frame prevents the later terminal demo from shrinking into “Claude Code can run Git.” Git commands are merely the visible actions; role redesign is the lesson.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>Phase-two Agentic Engineer</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Dan’s term</p>
+            <p><strong>Agentic Engineer:</strong> an engineer who builds systems that can take actions as engineers can.</p>
+          </aside>
+          <p>In plain English: you build the worker and the work path, not merely the artifact at the end. The evidence is behavioral. Does your system know which files to read? Can it create or edit files? Can it execute commands and observe their results? Can it preserve state across steps? Can it report a result that another person or program can evaluate? If yes, you are designing agency. If you only ask for a snippet, you are using generation.</p>
+          <p>The title does not require full autonomy. TAC-1 demonstrates a tiny serial workflow with a person choosing when to launch it. The role begins as soon as you deliberately package actions into a repeatable system. Later tactics can improve triggers, context, focus, and closed loops; none are prerequisites for recognizing the role here.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — walk the course codebase</p>
+          <h3>The repository describes a worker, not a product</h3>
+          <p>Open the course source at <code>tac/tac-1</code>. Before any demo runs, there is no <code>main_aic.py</code> and no <code>main_tac.py</code>. The seven committed files are instructional and operational:</p>
+          <div class="file-map">
+            <div class="file-map__item"><code>README.md</code><p>Holds the phase-one and phase-two prompts plus the three launcher commands.</p></div>
+            <div class="file-map__item"><code>.claude/settings.json</code><p>Declares the tools the agent may use: three file tools, UV, four Git operations, and WebSearch.</p></div>
+            <div class="file-map__item"><code>programmable/prompt.md</code><p>Packages a self-contained branch → create → run → commit → report workflow.</p></div>
+            <div class="file-map__item"><code>programmable/*.{sh,py,ts}</code><p>Calls the same prompt from three host languages, proving the agent is a component.</p></div>
+            <div class="file-map__item"><code>.env.sample</code><p>Contains the API-key placeholder used by the headless billing path.</p></div>
+            <div class="file-map__item"><code>main_*.py</code><p><strong>Not source files at the start.</strong> They are runtime artifacts created by the agent.</p></div>
+          </div>
+          <p>The repository’s product is not the two print statements. Its product is a legible mechanism for directing an agent. This is the Agentic Engineer role reduced until no accidental complexity remains.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — 3 minute drill</p>
+          <h3>Classify the work by who carries the transitions</h3>
+          <ol>
+            <li>Write down one task where you ask an AI for code, then manually install the answer.</li>
+            <li>Underline every transition you still carry: locate, branch, edit, run, inspect, commit, report.</li>
+            <li>Rewrite the task as an outcome with explicit actions and a final report.</li>
+            <li>Do <em>not</em> run it yet. Circle the actions that would require tools or permissions.</li>
+          </ol>
+          <p>Your first draft is successful if it exposes the workflow you normally perform invisibly. The goal is not an elegant prompt. The goal is to see the human glue.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: a title change without a delegation change</h3>
+          <p><strong>Symptom:</strong> you say “agentic” because the tool has an agent mode, but you still approve and relay each micro-step. Or you send a long prompt that generates several files but never executes or verifies them.</p>
+          <p><strong>Fix:</strong> ask a falsifiable question: <em>What engineering action can the system complete without me moving information between steps?</em> Start with one closed chain, not a grand autonomy claim. In TAC-1 that chain is branch → write → run → commit → report. Once the system carries it, your role really has moved.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>The ceiling is higher; the primitive is unchanged</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · mid-2026</p>
+            <p>TAC-1 intentionally shows one agent, one terminal, one serial workflow. Current practice can fan the same shape into subagents, background tasks, and worktree-isolated parallel runs. Do not import that complexity into this first lesson. First learn to specify one reliable chain. Parallelism multiplies both good system design and confused system design.</p>
+            <p class="current-practice__source">Forward pointer: later TAC lessons scale the seed planted here.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <h3>Close the section before revealing answers</h3>
+          <section class="retrieval-quiz" aria-label="Retrieval questions for the Agentic Engineer role">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. What behavior, not job title, defines Dan’s Agentic Engineer?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Building systems that can take actions as engineers can—such as branching, writing, running, committing, and reporting.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. Why is an excellent one-shot code prompt still phase-one shaped?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Because the output is code while the human still carries the engineering workflow around it. Quality does not change who performs the transitions.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What is the smallest observable proof that your role has moved?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>A system completes at least one meaningful multi-action chain without the human relaying intermediate results, then returns evidence for review.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Explain in 60 seconds:</strong> “An Agentic Engineer is not just someone who writes better prompts.” Use one example from the seven-file TAC-1 repository and name the moment when the human stops being workflow glue.</p>
+            <p class="fine">Pass if your explanation includes actions, a repeatable system, and a report—not merely “AI does more.”</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-mission">
+        <span class="section-number">02</span>
+        <h2 class="section-title">The mission: command compute through leverage</h2>
+        <p class="section-lead">The tactic is emotionally difficult because it asks you to retire a visible skill. The mission supplies the reason: move up the stack from producing keystrokes to designing systems that produce outcomes.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The faster typist who cannot escape throughput</h3>
+          <p>Suppose an engineer doubles their typing speed, memorizes every framework API, and uses autocomplete perfectly. They may produce more code per hour, but every additional unit still consumes their attention. Their throughput is coupled to presence. If they stop, the work stops.</p>
+          <p>Now suppose another engineer spends ten minutes creating a reliable workflow that can be fired again. The first run may be slower than hand-typing. The second run costs almost no new design attention. The tenth run makes the original time investment look tiny. This is why Dan says the 10x engineer does not come from 10x time or effort. The multiplier is leverage, and the number could be 2x, 10x, or 100x depending on the leverage point.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — attention versus repeatability</p>
+          <h3>Effort is linear; a reusable system bends the curve</h3>
+          <figure class="diagram">
+            <div class="diagram__canvas">
+              <svg viewBox="0 0 820 390" role="img" aria-labelledby="leverage-title leverage-desc">
+                <title id="leverage-title">Leverage curve comparing hand work and reusable agentic work</title>
+                <desc id="leverage-desc">Hand work rises linearly with every repetition. Agentic work has an initial design investment, then much lower marginal attention for later runs.</desc>
+                <defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="7" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#85796A"/></marker></defs>
+                <line x1="90" y1="315" x2="760" y2="315" stroke="#85796A" stroke-width="2" marker-end="url(#arrow)"/>
+                <line x1="90" y1="315" x2="90" y2="45" stroke="#85796A" stroke-width="2" marker-end="url(#arrow)"/>
+                <text x="610" y="355" fill="#4C463C" font-family="system-ui" font-size="18">workflow repetitions</text>
+                <text x="28" y="210" fill="#4C463C" font-family="system-ui" font-size="18" transform="rotate(-90 28 210)">cumulative human attention</text>
+                <path d="M110 295 L700 75" fill="none" stroke="#A33D2E" stroke-width="5"/>
+                <text x="540" y="105" fill="#A33D2E" font-family="system-ui" font-weight="700" font-size="20">hand-carry every run</text>
+                <path d="M110 295 C145 180 205 155 285 150 C420 142 565 137 700 132" fill="none" stroke="#B4530A" stroke-width="6"/>
+                <circle cx="190" cy="164" r="8" fill="#B4530A"/>
+                <text x="205" y="190" fill="#8A3F06" font-family="system-ui" font-weight="700" font-size="20">design the workflow once</text>
+                <text x="470" y="162" fill="#8A3F06" font-family="system-ui" font-size="18">low marginal attention</text>
+              </svg>
+            </div>
+            <figcaption>The first automated run includes design cost. Leverage appears across repetitions, not in a screenshot of run one.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>He names the enemy, then changes the identity</h3>
+          <p>Dan states the mission with uncomfortable specificity: become an engineer “they” cannot replace—where “they” means your boss, the company, the industry, and AI. The point is not permanent safety; he explicitly says nothing in technology lasts forever. The point is to choose the adaptation with the greatest asymmetric advantage.</p>
+          <div class="frame-grid">
+            <figure class="frame-card">
+              <img src="../media/frames/tac-1/t0124-mission-irreplaceable.jpg" alt="Mission slide naming the engineer they cannot replace" loading="lazy">
+              <figcaption><span class="frame-card__t">2:04</span>The mission supplies the criterion by which later tactics are judged: do they increase your leverage and make your contribution harder to substitute?</figcaption>
+            </figure>
+            <figure class="frame-card">
+              <img src="../media/frames/tac-1/t0162-commander-of-compute.jpg" alt="Commander of Compute title card from TAC-1" loading="lazy">
+              <figcaption><span class="frame-card__t">2:42</span>The identity shift has a name: commander of compute. Your work moves from producing the artifact to aiming the machinery.</figcaption>
+            </figure>
+          </div>
+          <p>The story’s one move is to replace a threatened identity with a higher-order one. If “real engineer” means “person who types the best code,” an agent that types better feels like a rival. If engineering means building systems of leverage that produce valuable outcomes, a capable coding agent becomes new machinery. You are measured by what you can make the machinery reliably accomplish.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>Commander of compute</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Dan’s term</p>
+            <p><strong>Commander of compute:</strong> the phase-two engineer who aims powerful models and agentic systems at valuable outcomes, building systems that build systems.</p>
+          </aside>
+          <p>Plain English: stop treating the model like a faster pair of hands and start treating it like programmable capacity. Commanding does not mean shouting more prompts. It means deciding the target, furnishing context, declaring constraints, granting a bounded tool surface, defining success evidence, and choosing when the workflow should run.</p>
+          <p>Dan’s end-state phrase—<strong>self-operating machine</strong>—should be read incrementally. TAC-1 does not claim that a codebase becomes autonomous in one lesson. It shows the smallest seed: one workflow can recreate a branch, files, executions, commit, and report without an interactive human. Every later improvement can move another piece of attention out of the repeated path.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — walk the course codebase</p>
+          <h3>Where the leverage lives in <code>programmable/</code></h3>
+          <p>Separate the TAC-1 headless example into one-time design and repeatable execution.</p>
+          <table>
+            <thead><tr><th>One-time human design</th><th>Repeatable agent execution</th><th>Evidence returned</th></tr></thead>
+            <tbody>
+              <tr><td>Specify a known starting branch</td><td>Checkout <code>demo-agentic-coding</code></td><td>Current branch can be inspected</td></tr>
+              <tr><td>Describe both generated files</td><td>Create <code>main_aic.py</code> and <code>main_tac.py</code></td><td>Files exist with reviewable content</td></tr>
+              <tr><td>Declare execution commands</td><td>Run both files with <code>uv run</code></td><td>Exact outputs appear in the trace/report</td></tr>
+              <tr><td>Declare repository transition</td><td><code>git add .</code> and commit with the specified message</td><td><code>git log</code> exposes the commit</td></tr>
+              <tr><td>Require a report</td><td>Return both program outputs</td><td>The launcher prints a human-readable result</td></tr>
+            </tbody>
+          </table>
+          <p>The two print programs are deliberately disposable. The leverage lives in the durable <code>prompt.md</code> plus launcher pattern. Delete the runtime branch and files, fire the launcher again, and the work reappears. Reproducibility—not code volume—is the first visible multiplier.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — leverage ledger</p>
+          <h3>Measure attention, not impressiveness</h3>
+          <ol>
+            <li>Choose one repeated engineering task from your week.</li>
+            <li>Write the minutes you spend per repetition and the number of repetitions per month.</li>
+            <li>List which steps are judgment and which are deterministic transitions.</li>
+            <li>Mark the smallest complete chain an agent could carry while returning evidence to your judgment point.</li>
+            <li>Estimate break-even: design minutes ÷ minutes saved per run.</li>
+          </ol>
+          <p>A boring five-minute workflow repeated 40 times may be a better leverage point than an impressive hour-long task performed once. This chapter does not authorize using any non-course repository in the lab; this ledger is a planning exercise for transfer after mastery.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: confusing more output with more leverage</h3>
+          <p><strong>Symptom:</strong> you celebrate that an agent generated 2,000 lines, even though reviewing and repairing those lines consumed more attention than the old workflow. Or you automate a one-off task because the demo looks impressive.</p>
+          <p><strong>Fix:</strong> evaluate the ratio Dan’s mission actually cares about: valuable outcome per unit of your attention. Count reruns, intervention points, review load, and evidence quality. A short stable workflow with a clear report is more agentic than a spectacular uncontrolled generation.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>Period detail changes; leverage does not</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · mid-2026</p>
+            <p>The course-era Claude Code interface and model names are period detail. Newer interfaces, plan modes, and background execution can reduce friction, but they do not change the leverage test. Dan future-proofs the lesson directly: newer models and a different UI are welcome; do not let them distract from the tactic.</p>
+            <p class="current-practice__source">Use today’s tool, but grade it with the same question: how much reliable outcome does one unit of attention purchase?</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <section class="retrieval-quiz" aria-label="Retrieval questions for leverage and mission">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. Why does Dan say the “10x” number is arbitrary?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Because the multiplier comes from the leverage point you find. It could be 2x, 10x, or 100x; it does not come from a fixed amount of greater effort.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. What makes the programmable demo leverage rather than just automation theater?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The workflow can be recreated repeatedly from a known state with low additional human attention, and it returns evidence through the report.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What does a commander of compute decide?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The target, context, constraints, bounded tools, success evidence, and timing of a system that performs engineering work.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Explain to a skeptical senior engineer:</strong> why a slower first automated run may still create more leverage than a fast manual run. Use the <code>programmable/prompt.md</code> rerun and distinguish outcome volume from attention saved.</p>
+            <p class="fine">Pass if you mention repetition, marginal attention, evidence, and a judgment boundary.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-stop">
+        <span class="section-number">03</span>
+        <h2 class="section-title">Tactic #1: Stop Coding</h2>
+        <p class="section-lead">The provocation is precise: stop <em>hand-typing</em> application code. Keep generating code. Keep understanding code. Move your scarce cycles to planning, reviewing, and building closed loops.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The ninety-percent trap</h3>
+          <p>An agent produces a nearly correct file. One import is wrong and one edge case is missing. You think, “It will be faster if I just fix those two lines.” You open the editor, type the repair, and move on. The task is complete, but the learning loop is broken.</p>
+          <p>The immediate edit feels efficient because you compare two minutes of hand work with another agent turn. Dan’s tactic compares something larger: a lifetime of carrying repairs versus learning to design prompts, feedback, and checks that make the system repair itself. Every time you silently take the keyboard back, you hide a failure mode from the system. You get the file, but you do not improve the mechanism that will create the next hundred files.</p>
+          <p>This is the behavioral edge of “stop coding.” It does not ask whether you are capable of the fix. It asks whether your personal typing is still the best lever for an outcome you expect to repeat.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — reallocate the engineering cycle</p>
+          <h3>Do not remove engineering; move it around the code</h3>
+          <figure class="diagram">
+            <div class="diagram__canvas">
+              <svg viewBox="0 0 860 430" role="img" aria-labelledby="cycle-title cycle-desc">
+                <title id="cycle-title">Engineering cycles before and after Stop Coding</title>
+                <desc id="cycle-desc">The old cycle centers human attention on typing. The agentic cycle moves human attention to planning, reviewing, and closed-loop design while the agent types and runs.</desc>
+                <text x="205" y="42" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-weight="700" font-size="20">Old allocation</text>
+                <circle cx="205" cy="210" r="115" fill="#F1EAE0" stroke="#E2D9CA" stroke-width="2"/>
+                <circle cx="205" cy="210" r="62" fill="#F6E4E0" stroke="#A33D2E" stroke-width="3"/>
+                <text x="205" y="205" text-anchor="middle" fill="#A33D2E" font-family="system-ui" font-weight="800" font-size="21">HUMAN</text>
+                <text x="205" y="232" text-anchor="middle" fill="#A33D2E" font-family="system-ui" font-size="18">types code</text>
+                <text x="205" y="105" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="17">plan a little</text>
+                <text x="205" y="340" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="17">review at the end</text>
+                <path d="M390 210 L470 210" stroke="#B4530A" stroke-width="5"/>
+                <path d="M458 197 L478 210 L458 223" fill="none" stroke="#B4530A" stroke-width="5"/>
+                <text x="430" y="185" text-anchor="middle" fill="#8A3F06" font-family="system-ui" font-weight="700" font-size="17">reallocate</text>
+                <text x="655" y="42" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-weight="700" font-size="20">Phase-two allocation</text>
+                <circle cx="655" cy="210" r="128" fill="#E4EFE6" stroke="#3D7A4E" stroke-width="3"/>
+                <circle cx="655" cy="210" r="66" fill="#F7E7D8" stroke="#B4530A" stroke-width="3"/>
+                <text x="655" y="204" text-anchor="middle" fill="#8A3F06" font-family="system-ui" font-weight="800" font-size="21">AGENT</text>
+                <text x="655" y="231" text-anchor="middle" fill="#8A3F06" font-family="system-ui" font-size="18">types + runs</text>
+                <text x="655" y="100" text-anchor="middle" fill="#3D7A4E" font-family="system-ui" font-weight="700" font-size="18">PLAN</text>
+                <text x="530" y="222" text-anchor="middle" fill="#3D7A4E" font-family="system-ui" font-weight="700" font-size="18" transform="rotate(-90 530 222)">REVIEW</text>
+                <text x="780" y="220" text-anchor="middle" fill="#3D7A4E" font-family="system-ui" font-weight="700" font-size="18" transform="rotate(90 780 220)">CLOSE LOOP</text>
+                <text x="655" y="345" text-anchor="middle" fill="#3D7A4E" font-family="system-ui" font-size="17">human judgment surrounds the run</text>
+              </svg>
+            </div>
+            <figcaption>“Stop coding” removes the human from the typing center, not from the engineering system.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>The tactic is said twice because the easy interpretation is wrong</h3>
+          <p>At 6:47, after establishing the mission and leverage frame, Dan reveals the first tactic: “Stop coding.” He repeats it. Then he sharpens the claim: your hands and your mind are no longer the best tool for the job of writing code. The directness is meant to break a default behavior, not to erase engineering knowledge.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/tac-1/t0414-tactic-stop-coding.jpg" alt="Tactic number one Stop Coding reveal from the lesson" loading="lazy">
+            <figcaption><span class="frame-card__t">6:54</span>The headline is intentionally uncomfortable. Read the object of the verb carefully: stop personally <em>typing</em> the code, not producing or understanding it.</figcaption>
+          </figure>
+          <p>Dan grounds the discomfort in his own history. He spent more than a decade hand-coding across startups and large companies, mastering the familiar craft, and says he misses it. That confession matters pedagogically: the tactic is not offered by someone who never valued coding. It is an argument that the best instrument for code production has changed, and that engineers must move their attention to the work the instrument cannot own.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>Stop coding ≠ stop engineering</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Exact distinction</p>
+            <p><strong>Stop coding:</strong> stop typing application code by hand. Continue generating more code than before, understanding what it does, reviewing it, and designing systems that can validate and improve it.</p>
+          </aside>
+          <p>Three reallocations make the phrase operational:</p>
+          <ul>
+            <li><strong>Planning:</strong> express outcomes, starting state, constraints, ordered actions, and pass conditions before compute begins.</li>
+            <li><strong>Reviewing:</strong> inspect behavior, diffs, architecture, risks, and evidence. Code understanding becomes more—not less—important when production accelerates.</li>
+            <li><strong>Closed-loop structures:</strong> connect generation to execution and observation so failure becomes feedback the system can act on.</li>
+          </ul>
+          <p>The tactic is therefore a constraint on who makes the keystrokes, not a license to be ignorant. If your agent generates ten times more code, your ability to frame, inspect, and govern code must become more systematic.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — walk the course codebase</p>
+          <h3>Zero application-code keystrokes in TAC-1</h3>
+          <p>The README’s phase-one prompt contains a description of <code>main_aic.py</code>:</p>
+          <pre><code>CREATE main_aic.py:
+    print goodbye ai coding</code></pre>
+          <p>The course artifact does not ask you to open <code>main_aic.py</code> and type the print statement. You give the instruction to Claude Code. The agent writes it. Later, <code>programmable/prompt.md</code> describes both runtime files and the agent writes both again. The lab’s prime directive extends the same rule to stretch changes: even when you add a branch name to the REPORT or create a fourth launcher, you ask Claude Code to make the edit.</p>
+          <p>Notice what you still do. You read <code>.claude/settings.json</code>. You understand the prompt. You watch the plan. You inspect generated files. You run independent verification commands. You compare the report to real output. You observe how the workflow fails when a permission is removed. Nothing about that work is passive. The difference is that your keystrokes go into instructions and probes, not into application code.</p>
+          <aside class="callout callout--why">
+            <p class="callout__label">Why the constraint matters</p>
+            <p>When an exercise is trivial, hand-editing always looks faster. The zero-typing rule makes you practice the control surface before tasks become too large for manual rescue.</p>
+          </aside>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — repair without reclaiming the keyboard</p>
+          <h3>Use the next imperfection as the exercise</h3>
+          <ol>
+            <li>During the TAC-1 lab, wait until an output differs from your expectation.</li>
+            <li>Before touching the file, state the discrepancy as observed versus expected behavior.</li>
+            <li>Give the agent the observation, the expected result, and the command that should prove success.</li>
+            <li>Let the agent edit and rerun.</li>
+            <li>Review the diff and evidence. If still wrong, repeat with a more precise observation.</li>
+          </ol>
+          <p>The drill is passed when the system repairs the artifact and you can name what improved in your feedback. Speed is secondary on this first repetition.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Two opposite misunderstandings</h3>
+          <div class="comparison">
+            <article class="comparison__card"><div class="comparison__head"><h3>“No more code”</h3></div><div class="comparison__body"><p><strong>Why it fails:</strong> code remains a primary asset that produces features and products. TAC expects you to generate more of it.</p><p><strong>Fix:</strong> say “stop hand-typing” every time you teach the tactic.</p></div></article>
+            <article class="comparison__card"><div class="comparison__head"><h3>“No need to understand code”</h3></div><div class="comparison__body"><p><strong>Why it fails:</strong> faster generation magnifies the cost of weak review and weak system judgment.</p><p><strong>Fix:</strong> move reading, execution, tests, and diff review into explicit pass criteria.</p></div></article>
+          </div>
+          <p>A third failure hides between them: ritualistically never touching code while also never reviewing it. That is not Dan’s tactic. The goal is engineering leverage, not ideological purity. The lab’s zero-typing rule is a training constraint that forces better control habits.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>The tactic has a public companion</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current-practice video · plan-approved</p>
+            <p>The locked overlay map pairs this lesson’s thesis with Dan’s public treatment, <em>AI Coding is NOT ENOUGH</em>. Use it after you can state the phase distinction yourself; the chapter’s course demo remains the graded evidence.</p>
+            <p class="current-practice__source">Metadata should be rechecked at publication; the ID is supplied by the locked extract.</p>
+          </aside>
+          <div class="video-cards" style="grid-template-columns:minmax(0,1fr)">
+            <a class="video-card" href="https://www.youtube.com/watch?v=2TIXl2rlA6Q">
+              <span class="video-card__type">Operationalizes the tactic</span>
+              <strong>AI Coding is NOT ENOUGH</strong>
+              <p>Reinforces the phase-one → phase-two thesis and the reason engineering cannot collapse into code generation.</p>
+              <span class="video-card__watch">Open video ↗</span>
+            </a>
+          </div>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <section class="retrieval-quiz" aria-label="Retrieval questions for Stop Coding">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. What exactly stops when you follow Tactic #1?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Your hand-typing of application code. Code generation and code understanding continue.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. Where do the freed engineering cycles go?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Planning, reviewing, and creating closed-loop structures.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. Why is fixing the last two lines by hand a course failure even when it is faster?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It completes the artifact while hiding the loop’s weakness. You lose the chance to improve agent instructions, feedback, and verification for repeatable future work.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. What must increase when agents generate more code?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The quality and systematization of planning, review, validation, and governance.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Teach the tactic to a junior developer</strong> without using the phrase “AI is better at coding.” Explain what they stop, what they keep, and what three kinds of work replace typing. Give one example of a good re-prompt after an imperfect file.</p>
+            <p class="fine">Pass if the learner could act differently on their next task.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-core-four">
+        <span class="section-number">04</span>
+        <h2 class="section-title">Big Three → Core Four</h2>
+        <p class="section-lead">The phase change adds one diagnostic dimension: tools. The novelty is not that tools exist. The breakthrough is that a prompt can reliably carry a long chain of tool calls at useful scale and performance.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The reroll reflex</h3>
+          <p>An agentic run stops before committing. A weak operator submits the same prompt again, perhaps adding “please make sure to commit.” The second run stops too. The operator concludes that the model is flaky.</p>
+          <p>A Core Four diagnosis asks four different questions. Did the agent see the repository state and instruction file it needed? Was the model capable of the reasoning? Did the prompt state a valid starting branch and commit expectation? Did the tool surface actually allow <code>git commit</code>? In TAC-1 stretch drill S3, removing one permission creates exactly this lesson: prompt quality cannot compensate for a missing tool.</p>
+          <p>Without a diagnostic vocabulary, every failure looks like “bad AI.” With the Core Four, you can isolate the broken dimension before spending another token.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — the Core Four visual</p>
+          <h3>Four interacting primitives, one newly emphasized dimension</h3>
+          <figure class="diagram">
+            <div class="diagram__canvas">
+              <div class="core-four" role="img" aria-label="Core Four: context, model, prompt, and tools, with tools highlighted as the added phase-two dimension">
+                <div class="core-four__cell"><b>Context</b><p>What the model can see: repo, files, settings, current state.</p></div>
+                <div class="core-four__cell"><b>Model</b><p>The reasoning and generation capacity doing the work.</p></div>
+                <div class="core-four__cell"><b>Prompt</b><p>The outcome, constraints, ordered actions, and report request.</p></div>
+                <div class="core-four__cell core-four__cell--tools"><b>Tools</b><p>The bounded actions the agent can execute in a reliable chain.</p></div>
+                <span class="core-four__plus">4</span>
+              </div>
+            </div>
+            <figcaption>The Big Three never disappear. Phase two adds tools and makes the interaction among all four operational.</figcaption>
+          </figure>
+          <div class="concept-strip">
+            <div class="concept-strip__item"><b>Context</b><p>“Can it see what matters?”</p></div>
+            <div class="concept-strip__item"><b>Model</b><p>“Can it reason through this?”</p></div>
+            <div class="concept-strip__item"><b>Prompt</b><p>“Does it know the outcome and checks?”</p></div>
+            <div class="concept-strip__item concept-strip__item--new"><b>Tools</b><p>“Can it take the required actions?”</p></div>
+          </div>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>The full trace makes the fourth circle visible</h3>
+          <p>After the agentic prompt checks out a branch, writes <code>main_tac.py</code>, runs both programs, stages files, commits, cleans up its todos, and reports, Dan names what changed. AI coding had always involved context, model, and prompt—even if the user did not see all three. Agentic coding adds tools.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/tac-1/t0845-core-four.jpg" alt="Dan's Core Four diagram with context, tools, model, and prompt" loading="lazy">
+            <figcaption><span class="frame-card__t">14:05</span>The on-screen Core Four is the lesson’s central abstraction. The highlighted teaching point is reliable long-chain execution, not a claim that tool calling was invented here.</figcaption>
+          </figure>
+          <p>Dan anticipates the obvious objection: tool calling is not new. His answer is exact and portable: “It’s not a question of new. It’s a question of scale and performance.” A single calculator call proves a model can use a tool. A branch → write → run → observe → stage → commit → report chain proves that tool use can form a unit of engineering work.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>The Big Three and the Core Four</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Canonical terms</p>
+            <p><strong>Big Three:</strong> context, model, prompt. <strong>Core Four:</strong> context, model, prompt, tools. <strong>Precise delta:</strong> prompts that can reliably execute long chains of tools.</p>
+          </aside>
+          <p>Tools should not be reduced to a list of commands. The tool dimension has at least three properties:</p>
+          <ol>
+            <li><strong>Availability:</strong> a tool exists that can perform the needed action.</li>
+            <li><strong>Permission:</strong> the system allows that action in the current context.</li>
+            <li><strong>Chain reliability:</strong> the agent can choose, order, execute, and learn from several calls without losing the goal.</li>
+          </ol>
+          <p>This explains why all four interact. A correct Git tool with no repository context is useless. A capable model with an ambiguous starting state may choose the wrong branch. A precise prompt asking for a forbidden commit cannot cross the permission boundary. Diagnostics work because you ask which dimension prevented the next state transition.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — <code>.claude/settings.json</code></p>
+          <h3>Read the tool surface before running the prompt</h3>
+          <p>The lesson’s settings file is the tools circle made concrete:</p>
+          <pre><code>{
+  "permissions": {
+    "allow": [
+      "Read", "Write", "Edit",
+      "Bash(uv run:*)",
+      "Bash(git checkout:*)",
+      "Bash(git branch:*)",
+      "Bash(git add:*)",
+      "Bash(git commit:*)",
+      "WebSearch"
+    ]
+  }
+}</code></pre>
+          <p>Classify the list. <code>Read</code>, <code>Write</code>, and <code>Edit</code> let the agent inspect and change files. <code>uv run</code> lets it execute the generated programs. Four Git patterns let it checkout, inspect/create branches, add files, and commit. <code>WebSearch</code> is the single non-local tool. There is no <code>git push</code> permission.</p>
+          <p>Now predict the README workflow. The agent can create the branch because checkout/branch are allowed. It can write <code>main_tac.py</code>. It can run both files with UV. It can add and commit. It cannot push the commit under this allowlist. You have understood the possible behavior before spending tokens.</p>
+          <table>
+            <thead><tr><th>Observed failure</th><th>First Core Four hypothesis</th><th>Probe</th></tr></thead>
+            <tbody>
+              <tr><td>Agent edits wrong file</td><td>Context or prompt</td><td>Ask which file path it read and where the path was specified.</td></tr>
+              <tr><td>Agent cannot commit</td><td>Tools/permission</td><td>Inspect <code>.claude/settings.json</code> for <code>Bash(git commit:*)</code>.</td></tr>
+              <tr><td>Agent creates correct code but skips execution</td><td>Prompt or chain planning</td><td>Confirm the RUN block explicitly includes both <code>uv run</code> commands.</td></tr>
+              <tr><td>Agent reports success with wrong output</td><td>Prompt/report evidence or model reasoning</td><td>Run files independently and require exact output in REPORT.</td></tr>
+            </tbody>
+          </table>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — permissions audit</p>
+          <h3>Checkpoint zero of the lab begins here</h3>
+          <ol>
+            <li>Open <code>tac/tac-1/.claude/settings.json</code>.</li>
+            <li>Without running the agent, write the three file tools.</li>
+            <li>Write the four allowed Git subcommands and one important absent operation.</li>
+            <li>Name the single non-local tool.</li>
+            <li>Close the file and recite the answers.</li>
+          </ol>
+          <div class="checkpoint"><strong>Pass:</strong> Read, Write, Edit; checkout, branch, add, commit; push is not allowed; WebSearch is the non-local tool.</div>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: treating the Core Four as a memorization diagram</h3>
+          <p><strong>Symptom:</strong> you can chant “context, model, prompt, tools” but respond to every error by rewriting the prompt.</p>
+          <p><strong>Fix:</strong> before retrying, write one sentence per dimension: what context was present, which model property mattered, what the prompt required, and which tool/permission enabled the failed transition. Eliminate dimensions with evidence. The Core Four becomes valuable only when it changes your debugging behavior.</p>
+          <p>A related failure is giving the tools circle unlimited power so the workflow cannot be blocked. That avoids permission friction by deleting a safety boundary. TAC-1 teaches the opposite habit: inspect and deliberately bound what the agent may do.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>Permissions became richer; the audit habit survived</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · mid-2026</p>
+            <p>The flat allowlist shown in TAC-1 still communicates the primitive cleanly. Current Claude Code practice also includes permission modes, deny rules, hooks around tool use, sandboxed Bash, and settings layered across user, project, and local scopes. The modern surface is larger; the timeless habit is unchanged: inspect what the agent may do before you run it.</p>
+            <p class="current-practice__source">Teaching rule: learn the visible allowlist first, then add richer gates when the workflow requires them.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <section class="retrieval-quiz" aria-label="Core Four retrieval questions">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. Name the Big Three and the one added dimension.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Context, model, prompt; tools are added to form the Core Four.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. What exact capability makes the tools dimension phase-two significant?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Prompts that can reliably execute long chains of tool calls.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What is Dan’s rebuttal to “tool calling isn’t new”?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It is not a question of new; it is a question of scale and performance.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. Which allowed tool proves the agent can commit but not publish?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>Bash(git commit:*)</code> is allowed, while no <code>git push</code> permission appears.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Diagnose aloud:</strong> an agent creates the correct files and runs them, but cannot make the requested commit. Walk through all four dimensions, then explain why tools/permission is the leading hypothesis. Finish with Dan’s scale-and-performance answer.</p>
+            <p class="fine">Pass if you use evidence rather than “the AI is flaky.”</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-ab">
+        <span class="section-number">05</span>
+        <h2 class="section-title">Two prompts, one monumental difference</h2>
+        <p class="section-lead">The chapter’s A/B test holds repository, model, and operator constant. Prompt A creates a file. Prompt B carries an engineering workflow. Run both; the delta is the lesson.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>“Both made files, so they are basically the same”</h3>
+          <p>A learner runs both prompts and notices that <code>main_aic.py</code> and <code>main_tac.py</code> now exist. They conclude that the second prompt is merely a longer code-generation request. The visible artifacts conceal the real difference because files are the residue of both processes.</p>
+          <p>To see the delta, ignore the final directory for a moment and compare state transitions. Before Prompt A, one file is absent; afterward, it exists. Before Prompt B, the repository is on a starting branch with incomplete artifacts; afterward, a named branch exists, a second file exists, two programs have been executed, their output has been observed, changes have been staged and committed with a named message, a todo sequence has drained, and a report has been returned. The second prompt did not merely produce more. It moved the repository through an ordered series of verified states.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — AI coding versus agentic coding</p>
+          <h3>Compare verbs, states, and evidence</h3>
+          <div class="comparison">
+            <article class="comparison__card">
+              <div class="comparison__head"><p class="eyebrow">Phase 1</p><h3>AI Coding Prompt</h3><p>A request to create code.</p></div>
+              <div class="comparison__body">
+                <pre><code>CREATE main_aic.py:
+    print goodbye ai coding</code></pre>
+                <ul>
+                  <li><strong>Verb:</strong> create</li>
+                  <li><strong>State change:</strong> one file appears</li>
+                  <li><strong>Execution:</strong> human runs it later</li>
+                  <li><strong>Repository action:</strong> none requested</li>
+                  <li><strong>Evidence:</strong> file content</li>
+                </ul>
+              </div>
+            </article>
+            <article class="comparison__card comparison__card--agentic">
+              <div class="comparison__head"><p class="eyebrow">Phase 2</p><h3>Agentic Coding Prompt</h3><p>A runbook for engineering work.</p></div>
+              <div class="comparison__body">
+                <pre><code>RUN: checkout branch
+CREATE: main_tac.py
+RUN: execute both files
+RUN: add + commit</code></pre>
+                <ul>
+                  <li><strong>Verbs:</strong> run, create, run</li>
+                  <li><strong>State changes:</strong> branch, file, index, commit</li>
+                  <li><strong>Execution:</strong> agent runs both programs</li>
+                  <li><strong>Repository action:</strong> explicit Git workflow</li>
+                  <li><strong>Evidence:</strong> trace, outputs, commit, report</li>
+                </ul>
+              </div>
+            </article>
+          </div>
+          <p>A useful test: if you can describe a prompt’s success only by naming generated files, you may be looking at AI coding. If you can describe ordered state transitions and evidence, you are looking at an agentic workflow.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>Watch the todo list become a repository history</h3>
+          <p>Dan first pastes the AI Coding Prompt. Claude Code writes <code>main_aic.py</code>. He calls it familiar: something you have seen a million times. Then he pastes the Agentic Coding Prompt. This time the agent turns the instruction into a checklist and executes the work step by step.</p>
+          <div class="frame-grid">
+            <figure class="frame-card">
+              <img src="../media/frames/tac-1/t0700-ai-coding-prompt-run.jpg" alt="The AI coding prompt creating main_aic.py in Claude Code" loading="lazy">
+              <figcaption><span class="frame-card__t">11:40</span>The baseline: one prompt creates one file. Useful, but the human still owns the surrounding workflow.</figcaption>
+            </figure>
+            <figure class="frame-card">
+              <img src="../media/frames/tac-1/t0748-agentic-prompt-checklist.jpg" alt="Claude Code turns the agentic prompt into a todo checklist" loading="lazy">
+              <figcaption><span class="frame-card__t">12:28</span>The prompt becomes an execution plan. The todo list externalizes intermediate state so the chain can be carried rather than merely described.</figcaption>
+            </figure>
+          </div>
+          <figure class="frame-card">
+            <img src="../media/frames/tac-1/t0790-agentic-prompt-results.jpg" alt="Full agentic coding result showing branch, file writing, program output, commit, and completed todos" loading="lazy">
+            <figcaption><span class="frame-card__t">13:10</span>The after picture: branch checkout, file creation, both UV runs, Git add and commit, todos completed. This trace—not the print statements—is the phase-two artifact.</figcaption>
+          </figure>
+          <p>Dan’s one move is to make process visible. The agent’s checklist, tool trace, command output, and commit expose a chain that a human would otherwise carry implicitly. That visibility makes the workflow inspectable and, later, programmable.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>The Agentic Coding Prompt</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Dan’s term</p>
+            <p><strong>Agentic Coding Prompt:</strong> a prompt containing a sequence of tool calls. In plain English, it is a workflow specification that an agent can execute.</p>
+          </aside>
+          <p>The README uses a compact runbook grammar: <code>RUN</code>, <code>CREATE</code>, <code>RUN</code>. These headings separate kinds of action. The first RUN establishes repository state. CREATE defines an artifact. The final RUN executes and records the work. In <code>programmable/prompt.md</code>, a fourth heading—<code>REPORT</code>—makes the output contract explicit.</p>
+          <p>The headings are not magic syntax. Their value is structural clarity. A weak prompt mixes goal, starting state, implementation, commands, and success into a paragraph. A runbook shape lets both human and model see the sequence. It also makes omission easier to detect. If no REPORT block exists, a headless caller may receive an unhelpful narrative. If no starting branch is declared, reruns may begin from ambiguous state.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — trace every line</p>
+          <h3>Read the README prompt as a state machine</h3>
+          <pre><code>RUN:
+    checkout a new/existing "demo-agentic-coding" git branch
+
+CREATE main_tac.py:
+    print "hello agentic coding"
+    print a concise explanation of the definition of ai agents
+
+RUN:
+    uv run main_aic.py
+    uv run main_tac.py
+    git add .
+    git commit -m "Demo agentic coding capabilities"</code></pre>
+          <div class="workflow" aria-label="Agentic prompt state transitions">
+            <div class="workflow__step"><strong>1 · Isolate</strong><code>checkout branch</code></div>
+            <div class="workflow__step"><strong>2 · Produce</strong><code>create file</code></div>
+            <div class="workflow__step"><strong>3 · Observe</strong><code>run both</code></div>
+            <div class="workflow__step"><strong>4 · Record</strong><code>add + commit</code></div>
+            <div class="workflow__step"><strong>5 · Return</strong><code>trace/report</code></div>
+          </div>
+          <p>Line one establishes isolation. The CREATE block specifies two observable behaviors without dictating a full implementation. The next two commands turn code into evidence: <code>uv run main_aic.py</code> should print <code>goodbye ai coding</code>; <code>uv run main_tac.py</code> should print <code>hello agentic coding</code> followed by a concise definition. The final two commands preserve the result in Git.</p>
+          <p>The five-action delta you should write in Checkpoint 1 is:</p>
+          <ol>
+            <li>Checkout the named branch.</li>
+            <li>Create the second file to a behavioral specification.</li>
+            <li>Execute both programs and expose their outputs.</li>
+            <li>Stage and commit the change with the specified message.</li>
+            <li>Manage the sequence and report completion.</li>
+          </ol>
+          <p>The prompt depends on <code>main_aic.py</code> from the first interactive run. That dependency is why <code>programmable/prompt.md</code> later creates both files: a headless workflow must be self-contained enough to run from its declared starting state.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — reproduce the A/B test</p>
+          <h3>Do not substitute reading for running</h3>
+          <ol>
+            <li>From the cloned TAC-1 repo, start Claude Code.</li>
+            <li>Paste the README’s AI Coding Prompt. Confirm <code>main_aic.py</code> exists, then run <code>uv run main_aic.py</code> yourself.</li>
+            <li>Before Prompt B, write what did <em>not</em> happen: no branch, no execution by the agent, no commit.</li>
+            <li>Paste the Agentic Coding Prompt. Watch the checklist form and drain.</li>
+            <li>Verify branch, generated behavior, execution trace, commit message, and report.</li>
+          </ol>
+          <div class="terminal" aria-label="Verification commands">
+            <div class="terminal__bar"><span class="terminal__dot"></span><span class="terminal__dot"></span><span class="terminal__dot"></span></div>
+            <pre><code>$ git branch --show-current
+demo-agentic-coding
+
+$ uv run main_aic.py
+goodbye ai coding
+
+$ uv run main_tac.py
+hello agentic coding
+[one concise AI-agent definition]
+
+$ git log --oneline -1
+[hash] Demo agentic coding capabilities</code></pre>
+          </div>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: comparing artifacts instead of transitions</h3>
+          <p><strong>Symptom:</strong> your A/B notes say “Prompt A made one Python file; Prompt B made another Python file.”</p>
+          <p><strong>Fix:</strong> use verbs and evidence. Write <em>checkout, create, execute, observe, stage, commit, report</em>. Then connect each verb to a tool permission and a verifiable state. The monumental difference is not that Prompt B is longer or that the code is smarter. It is that the prompt carries engineering actions end to end.</p>
+          <p><strong>Secondary stall:</strong> the branch already exists, so checkout behavior differs. Return to <code>main</code> and delete <code>demo-agentic-coding</code> between clean reproductions. The prompt says new/existing, so reuse is valid behavior; the clean reset simply makes the demonstration unambiguous.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>The runbook shape spread; the lesson still teaches the primitive</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · mid-2026</p>
+            <p>RUN/CREATE/RUN/REPORT is now recognizable across command files, reusable skills, CI-oriented prompts, and agent workflows. Modern packaging can add schemas and hooks, but do not skip the plain prompt. Its lack of magic is pedagogically useful: every transition is visible, so you can tell what the runtime must provide.</p>
+            <p class="current-practice__source">Rule: teach the workflow in raw form before packaging it into a reusable abstraction.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <section class="retrieval-quiz" aria-label="A/B demo retrieval questions">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. Name five actions Prompt B performed that Prompt A did not.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Branch checkout; second specified file; execution of both programs; Git add and commit; todo management and final report.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. Why is <code>uv run</code> load-bearing in the comparison?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It turns generated code into observed behavior. The agent does not merely write; it executes and can use the outputs as evidence.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. Why does <code>programmable/prompt.md</code> create <code>main_aic.py</code> too?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>To make the headless workflow self-contained rather than dependent on the earlier interactive phase-one run.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. What is the most useful definition of an Agentic Coding Prompt here?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>A workflow specification containing a sequence of reliably executed tool calls.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Draw the comparison from memory.</strong> On the left, write the one state transition of Prompt A. On the right, draw Prompt B as branch → create → run → commit → report. Explain why two final files do not make the processes equivalent.</p>
+            <p class="fine">Pass if your listener can point to the exact boundary where code generation becomes engineering workflow execution.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-tool">
+        <span class="section-number">06</span>
+        <h2 class="section-title">Why this tool class works</h2>
+        <p class="section-lead">The lesson names three essential elements behind reliable agentic coding: a reasoning-capable model, consistent long tool chains, and the right agent architecture. Treat them as a transferable evaluation checklist.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>A model that can code but cannot carry the work</h3>
+          <p>You can have a brilliant model that writes the right function in isolation yet loses the goal after six tool calls. You can have a tool-rich shell around a weak model that follows commands literally but cannot recover when repository state differs. You can have both inside an architecture that forgets observations, loops without limits, or exposes the wrong action surface.</p>
+          <p>“Which model is best?” is therefore too small a question for agentic coding. The unit under evaluation is the combined system. TAC-1’s agentic prompt requires the system to interpret a runbook, plan it, call file and shell tools in order, preserve outputs as context, and know when the requested end state has been reached. A high benchmark score on code generation does not prove that chain.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — a three-legged platform</p>
+          <h3>Remove one element and reliability collapses</h3>
+          <figure class="diagram">
+            <div class="diagram__canvas">
+              <svg viewBox="0 0 840 430" role="img" aria-labelledby="platform-title platform-desc">
+                <title id="platform-title">Three essential elements supporting reliable agentic coding</title>
+                <desc id="platform-desc">Reasoning model, long tool-chain consistency, and agent architecture support a platform labeled reliable agentic coding at scale.</desc>
+                <rect x="120" y="80" width="600" height="86" rx="18" fill="#F7E7D8" stroke="#B4530A" stroke-width="3"/>
+                <text x="420" y="118" text-anchor="middle" fill="#8A3F06" font-family="Georgia" font-weight="700" font-size="27">Reliable agentic coding</text>
+                <text x="420" y="147" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="18">at useful scale and performance</text>
+                <path d="M170 166 L240 338 L320 338 L335 166 Z" fill="#E4EFE6" stroke="#3D7A4E" stroke-width="3"/>
+                <path d="M335 166 L385 338 L465 338 L505 166 Z" fill="#F1EAE0" stroke="#63477A" stroke-width="3"/>
+                <path d="M505 166 L520 338 L600 338 L670 166 Z" fill="#E8F0F3" stroke="#356B83" stroke-width="3"/>
+                <text x="270" y="226" text-anchor="middle" fill="#3D7A4E" font-family="system-ui" font-weight="800" font-size="19">MODEL</text>
+                <text x="270" y="256" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="16">reason when</text><text x="270" y="278" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="16">needed</text>
+                <text x="420" y="226" text-anchor="middle" fill="#63477A" font-family="system-ui" font-weight="800" font-size="19">CHAINS</text>
+                <text x="420" y="256" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="16">call tools</text><text x="420" y="278" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="16">consistently</text>
+                <text x="570" y="226" text-anchor="middle" fill="#356B83" font-family="system-ui" font-weight="800" font-size="19">ARCHITECTURE</text>
+                <text x="570" y="256" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="16">hold state, route</text><text x="570" y="278" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="16">actions, stop</text>
+                <rect x="145" y="338" width="550" height="24" rx="12" fill="#211E19"/>
+              </svg>
+            </div>
+            <figcaption>A great model is necessary but not sufficient. Long-chain behavior emerges from the combined platform.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>From “why now?” to an evaluation frame</h3>
+          <p>After introducing the Core Four, Dan asks why reliable agentic coding became possible at this point. His answer is the combination of three elements: a powerful language model that can reason when needed, the ability to consistently call long chains of tools, and the right agent architecture.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/tac-1/t0903-claude-code-three-elements.jpg" alt="Slide listing Claude Code's three essential elements" loading="lazy">
+            <figcaption><span class="frame-card__t">15:03</span>The slide explains the form factor. Carry the checklist forward even when model names and interfaces change.</figcaption>
+          </figure>
+          <p>Dan positions Claude Code as the phase-two tool that combined these elements properly first, much as Aider represented phase-one AI coding in his framing. But he immediately protects the tactic from tool lock-in: interfaces will change, models will improve, competitors will copy capabilities. The portable lesson is the checklist, not allegiance to one screen.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>Three essential elements</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Dan’s checklist</p>
+            <p><strong>1.</strong> A powerful model that can reason when needed. <strong>2.</strong> Consistent long chains of tool calls. <strong>3.</strong> The right agent architecture.</p>
+          </aside>
+          <p>In plain English:</p>
+          <ul>
+            <li>The <strong>model</strong> must interpret goals, code, output, and unexpected states rather than pattern-match one response.</li>
+            <li>The <strong>chain</strong> must survive many transitions. Reliability compounds: if each step is weak, a long workflow fails often even when individual steps look good.</li>
+            <li>The <strong>architecture</strong> must present context and tools, preserve observations, manage turns, expose progress, handle errors, and stop at a useful boundary.</li>
+          </ul>
+          <p>Dan’s historical claim is that reliable agentic coding at scale was not possible before this combination. You do not need to debate the date to use the checklist. Any candidate tool must demonstrate the combined behavior on your workflow.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — evaluate the TAC-1 run</p>
+          <h3>Map the evidence to the three elements</h3>
+          <table>
+            <thead><tr><th>Observed TAC-1 behavior</th><th>Element evidenced</th><th>Why it matters</th></tr></thead>
+            <tbody>
+              <tr><td>Interprets “new/existing branch” and a behavioral file description</td><td>Reasoning model</td><td>The prompt is not a fixed command script; meaning must be converted into actions.</td></tr>
+              <tr><td>Checks out, writes, runs twice, adds, commits, reports in order</td><td>Long tool chain</td><td>Correctness depends on state flowing between multiple calls.</td></tr>
+              <tr><td>Builds and drains a todo checklist while retaining outputs</td><td>Agent architecture</td><td>The system externalizes progress and carries observations toward completion.</td></tr>
+              <tr><td>Returns a coherent final account</td><td>Architecture + model</td><td>A headless or human caller needs a usable completion boundary.</td></tr>
+            </tbody>
+          </table>
+          <p>Now imagine substitutions. A reasoning model with no Bash tool could describe the commands but not execute them. A shell loop with no reasoning could execute fixed commands but not interpret a concise AI-agent definition or adjust to an existing branch. An architecture that discarded command output could not include exact program output in its report. The demonstration is small enough to expose all three.</p>
+          <aside class="callout callout--warning">
+            <p class="callout__label">Economics are part of operation</p>
+            <p>Dan states that TAC will use millions of tokens across the full course and calls the investment “pay to play.” The chapter does not invent a dollar estimate; costs and plans change. The operational lesson is to budget enough model access that you can run the exercises rather than stopping at recognition.</p>
+          </aside>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — tool evaluation card</p>
+          <h3>Judge capabilities with a workflow, not a feature list</h3>
+          <ol>
+            <li>Use the TAC-1 agentic prompt as a benchmark task.</li>
+            <li>For the model, note whether it interprets the outcome and reacts to repository state.</li>
+            <li>For the chain, count ordered tool actions completed without human relay.</li>
+            <li>For architecture, note plan visibility, output retention, errors, permissions, and stopping behavior.</li>
+            <li>Record one observed piece of evidence for each element.</li>
+          </ol>
+          <p>Do not grade on UI similarity to Dan’s recording. A newer or different interface passes when it carries the same primitive reliably.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: tool worship or tool dismissal</h3>
+          <p><strong>Worship:</strong> “Claude Code is the lesson.” This makes every UI change feel like curriculum drift and hides the transferable checklist.</p>
+          <p><strong>Dismissal:</strong> “Any chat model can call a tool, so there is no lesson.” This ignores long-chain reliability, state management, and action architecture.</p>
+          <p><strong>Fix:</strong> demand workflow evidence. Can the system interpret, execute, observe, recover, and stop across the TAC-1 chain? Use the result to compare tools. Preserve the tactic even as the product surface changes.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>The form factor grew beyond the early terminal demo</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current-practice video · plan-approved</p>
+            <p>The extract maps <em>How Claude Code CHANGED Engineering Forever</em> to the newer form factor and programmable embedding story. Watch it as an update layer, not as a replacement for the three-element test.</p>
+            <p class="current-practice__source">Metadata should be rechecked at publication; the ID is supplied by the locked extract.</p>
+          </aside>
+          <div class="video-cards" style="grid-template-columns:minmax(0,1fr)">
+            <a class="video-card" href="https://www.youtube.com/watch?v=6fCqj4xFCZI">
+              <span class="video-card__type">Named gap · form factor</span>
+              <strong>How Claude Code CHANGED Engineering Forever</strong>
+              <p>Extends the lesson’s tool-class and programmable-agent claims into the current surface.</p>
+              <span class="video-card__watch">Open video ↗</span>
+            </a>
+          </div>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <section class="retrieval-quiz" aria-label="Three essential elements retrieval questions">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. Name the three essential elements in order.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>A powerful language model that can reason when needed; consistent long chains of tool calls; the right agent architecture.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. Why can a strong coding model still be a weak agentic system?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It may not carry long tool chains reliably, or the surrounding architecture may fail to preserve state, route actions, handle errors, or stop well.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. Which TAC-1 behavior most directly evidences architecture?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The todo plan, retained tool observations, bounded permissions, error/completion handling, and final report all evidence the surrounding agent architecture.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. What is transferable when the UI and model names change?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The tactic, Core Four diagnosis, agentic prompt shape, and three-element evaluation checklist.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Evaluate an imaginary tool:</strong> it uses an excellent model and exposes 50 tools, but it often forgets earlier command output and continues after failure. Explain which elements are strong, which is weak, and why tool count does not equal reliable agentic coding.</p>
+            <p class="fine">Pass if you distinguish model, chain, and architecture without falling back to brand preference.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-programmable">
+        <span class="section-number">07</span>
+        <h2 class="section-title">Programmable agentic coding</h2>
+        <p class="section-lead">Because Claude Code runs in the terminal, any language with terminal access can call it. The agent stops being a place you visit and becomes a function-like component inside a larger system.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The workflow that only exists while you are chatting</h3>
+          <p>You develop a strong interactive routine. You paste a runbook, answer one question, watch the agent work, and receive a useful result. Tomorrow you perform the same ritual again. The prompt is reusable, but the trigger is still you. The workflow is stored as a habit in your head: open the terminal, start the agent, find the prompt, paste it, wait, copy the result.</p>
+          <p>This is phase two in capability but not yet in reach. The agent can carry engineering work, yet the system cannot invoke that capacity from anywhere else. It cannot be called by a script, a scheduled process, a CI job, or another agentic environment. Dan’s programmable section removes that last dependence with a tiny observation: the tool already runs in a terminal.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — agent as callable component</p>
+          <h3>Prompt in, tool chain inside, report out</h3>
+          <figure class="diagram">
+            <div class="diagram__canvas">
+              <svg viewBox="0 0 900 430" role="img" aria-labelledby="callable-title callable-desc">
+                <title id="callable-title">Programmable agent flow</title>
+                <desc id="callable-desc">Shell, Python, and TypeScript launchers feed the same prompt into claude dash p. The agent uses bounded tools against the repository and returns a report and exit status.</desc>
+                <rect x="40" y="62" width="180" height="80" rx="16" fill="#F1EAE0" stroke="#E2D9CA" stroke-width="2"/>
+                <text x="130" y="94" text-anchor="middle" fill="#211E19" font-family="system-ui" font-weight="800" font-size="20">Launcher</text>
+                <text x="130" y="121" text-anchor="middle" fill="#4C463C" font-family="monospace" font-size="16">sh · py · ts</text>
+                <rect x="40" y="280" width="180" height="80" rx="16" fill="#F1EAE0" stroke="#E2D9CA" stroke-width="2"/>
+                <text x="130" y="312" text-anchor="middle" fill="#211E19" font-family="system-ui" font-weight="800" font-size="20">prompt.md</text>
+                <text x="130" y="339" text-anchor="middle" fill="#4C463C" font-family="monospace" font-size="16">RUN/CREATE/REPORT</text>
+                <rect x="330" y="132" width="240" height="168" rx="26" fill="#F7E7D8" stroke="#B4530A" stroke-width="4"/>
+                <text x="450" y="184" text-anchor="middle" fill="#8A3F06" font-family="Georgia" font-weight="700" font-size="31">claude -p</text>
+                <text x="450" y="222" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="17">agentic runtime</text>
+                <text x="450" y="255" text-anchor="middle" fill="#4C463C" font-family="system-ui" font-size="16">plan → call → observe → continue</text>
+                <rect x="685" y="62" width="180" height="80" rx="16" fill="#E4EFE6" stroke="#3D7A4E" stroke-width="2"/>
+                <text x="775" y="94" text-anchor="middle" fill="#3D7A4E" font-family="system-ui" font-weight="800" font-size="20">Repository</text>
+                <text x="775" y="121" text-anchor="middle" fill="#4C463C" font-family="monospace" font-size="16">files · uv · git</text>
+                <rect x="685" y="280" width="180" height="80" rx="16" fill="#E8F0F3" stroke="#356B83" stroke-width="2"/>
+                <text x="775" y="312" text-anchor="middle" fill="#356B83" font-family="system-ui" font-weight="800" font-size="20">Return</text>
+                <text x="775" y="339" text-anchor="middle" fill="#4C463C" font-family="monospace" font-size="16">report + exit code</text>
+                <path d="M220 102 C280 102 280 174 330 174" fill="none" stroke="#85796A" stroke-width="3"/>
+                <path d="M220 320 C280 320 280 258 330 258" fill="none" stroke="#85796A" stroke-width="3"/>
+                <path d="M570 174 C625 174 625 102 685 102" fill="none" stroke="#3D7A4E" stroke-width="3"/>
+                <path d="M685 135 C625 135 625 216 570 216" fill="none" stroke="#3D7A4E" stroke-width="3" stroke-dasharray="7 7"/>
+                <path d="M570 258 C625 258 625 320 685 320" fill="none" stroke="#356B83" stroke-width="3"/>
+              </svg>
+            </div>
+            <figcaption>The host language only launches the process. The prompt and agent runtime carry the engineering semantics.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>Delete the branch, then watch it re-materialize headlessly</h3>
+          <p>Dan opens the <code>programmable/</code> directory and shows the shape: one prompt plus three launchers. Before running the Python launcher, he returns to <code>main</code> and deletes <code>demo-agentic-coding</code>. That cleanup is not incidental. It establishes a visible before-state so the scripted run can prove reproducibility.</p>
+          <div class="frame-grid">
+            <figure class="frame-card">
+              <img src="../media/frames/tac-1/t1063-programmable-directory.jpg" alt="The programmable directory showing shell, Python, TypeScript launchers and prompt.md" loading="lazy">
+              <figcaption><span class="frame-card__t">17:43</span>Three launchers, one prompt. The directory view is the architecture in miniature.</figcaption>
+            </figure>
+            <figure class="frame-card">
+              <img src="../media/frames/tac-1/t1105-programmable-py.jpg" alt="The programmable Python launcher reading prompt.md and calling Claude Code" loading="lazy">
+              <figcaption><span class="frame-card__t">18:25</span>The Python implementation demystifies the pattern: read, invoke, capture, print, propagate status.</figcaption>
+            </figure>
+          </div>
+          <p>From a fresh terminal on <code>main</code>, he runs <code>uv run python programmable/programmable.py</code>. No interactive conversation follows. Claude Code receives the prompt through <code>-p</code>, recreates the branch and both runtime files, runs them, commits, and returns the requested outputs.</p>
+          <figure class="frame-card">
+            <img src="../media/frames/tac-1/t1205-programmable-report.jpg" alt="Headless programmable run returning the requested report with program outputs" loading="lazy">
+            <figcaption><span class="frame-card__t">20:05</span>The report lands back in the host terminal. This closes the first programmable loop: prompt in, engineering actions performed, evidence out.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>Programmable agentic coding</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Dan’s term</p>
+            <p><strong>Programmable agentic coding:</strong> invoking an agentic coding tool from a program so your own systems can fire agentic prompts across the software development lifecycle.</p>
+          </aside>
+          <p>Plain English: treat the agent like a function with a deliberately imperfect analogy:</p>
+          <pre><code>result = agent(prompt, repository_context, allowed_tools)</code></pre>
+          <p>The analogy helps because a caller supplies input and receives output. It is imperfect because the agent has side effects: it edits files, runs programs, and changes Git state. That is why permissions, starting state, reports, and exit codes matter. You are not calling a pure text transformer. You are invoking a bounded actor.</p>
+          <p>Dan’s key expansion is spatial: “It’s not just about the agentic prompt. It’s about <strong>where</strong> we can use the agentic prompt.” A prompt trapped in an interactive session depends on your presence. A prompt callable from code can live inside triggers and environments where you are absent. TAC-1 names triggers as later-course material; this lesson only proves the callable primitive.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — all four programmable files</p>
+          <h3>Same five operations, three host languages</h3>
+          <p>Start with the shared behavior file, <code>programmable/prompt.md</code>. It differs from the README’s agentic prompt in two important ways: it also creates <code>main_aic.py</code>, making the run self-contained, and it ends with a report contract:</p>
+          <pre><code>REPORT:
+    respond with the exact output of both .py files</code></pre>
+          <p>The Shell launcher is the pattern without ceremony:</p>
+          <pre><code>PROMPT_CONTENT="$(cat programmable/prompt.md)"
+OUTPUT="$(claude -p "$PROMPT_CONTENT")"
+echo "$OUTPUT"</code></pre>
+          <p>The Python launcher makes process behavior explicit:</p>
+          <pre><code>with open("programmable/prompt.md", "r") as f:
+    prompt_content = f.read()
+
+result = subprocess.run(
+    ["claude", "-p", prompt_content],
+    capture_output=True,
+    text=True,
+)
+print(result.stdout)
+sys.exit(result.returncode)</code></pre>
+          <p>The actual course file also prints standard error when present and catches exceptions. Those details make it the most production-shaped of the three: the caller can distinguish useful output from errors and preserves the child process’s success or failure for an outer system.</p>
+          <p>The TypeScript/Bun launcher reads the same file and uses Bun’s shell template:</p>
+          <pre><code>const promptContent = readFileSync("programmable/prompt.md", "utf-8");
+const output = await $`claude -p ${promptContent}`.text();
+console.log(output);</code></pre>
+          <p>The invariant is more important than syntax:</p>
+          <div class="workflow">
+            <div class="workflow__step"><strong>Read</strong><code>prompt.md</code></div>
+            <div class="workflow__step"><strong>Invoke</strong><code>claude -p</code></div>
+            <div class="workflow__step"><strong>Capture</strong><code>stdout/stderr</code></div>
+            <div class="workflow__step"><strong>Return</strong><code>print report</code></div>
+            <div class="workflow__step"><strong>Signal</strong><code>exit status</code></div>
+          </div>
+          <p>Language choice is irrelevant to the agentic semantics because all three languages can access the terminal. The prompt defines the work; the launcher provides placement and process control.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — headless reproduction</p>
+          <h3>Feel the absence of interaction</h3>
+          <ol>
+            <li>Read <code>programmable/prompt.md</code> and identify the self-contained CREATE plus REPORT differences.</li>
+            <li>Reset exactly: <code>git checkout main &amp;&amp; git branch -D demo-agentic-coding</code>.</li>
+            <li>From <code>main</code>, run <code>uv run python programmable/programmable.py</code>.</li>
+            <li>Do not answer questions or intervene. If the process needs you, record where.</li>
+            <li>Verify the branch, both files, commit, and exact report output independently.</li>
+            <li>Reset between launchers, then repeat with Shell and Bun TypeScript.</li>
+          </ol>
+          <div class="checkpoint"><strong>Checkpoint 2:</strong> explain in one sentence why the language did not matter. Expected idea: anything with terminal access can invoke <code>claude -p</code>; the agentic work lives in the shared prompt and runtime.</div>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: treating the wrapper as too trivial to run</h3>
+          <p><strong>Symptom:</strong> you read the three lines of Shell, say “I get it,” and skip the run. The concept stays intellectually obvious but behaviorally uninstalled.</p>
+          <p><strong>Fix:</strong> delete the branch and execute the Python launcher hands-off. The felt difference matters: an interactive tool waits in a place you visit; a programmable component returns control to a caller. Seeing repository state change while you provide no mid-run input is the lesson.</p>
+          <p>Other common stalls are state errors. If you run from <code>demo-agentic-coding</code> rather than <code>main</code>, the starting state no longer matches the demonstration. If the branch already exists, “new/existing” may legitimately reuse it. Reset between runs so launcher equivalence is what you test.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>The three-line launcher has a grown-up form</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · mid-2026</p>
+            <p>The one-shot <code>claude -p</code> pattern remains the clearest teaching form. Production embedding can add structured JSON or streaming output, allowed-tool controls, permission modes, session continuation, hooks, and Python/TypeScript Agent SDKs. Those capabilities improve control; they do not replace the core idea that the agent is callable.</p>
+            <p>Reusable behavior also moved from manually discovered prompt files toward Agent Skills: <code>SKILL.md</code> packages with metadata and on-demand loading. Learn <code>prompt.md</code> first so the packaging does not hide the workflow.</p>
+            <p class="current-practice__source">Overlay: raw prompt → reusable Skill; bare subprocess → structured agent integration.</p>
+          </aside>
+          <div class="video-cards" style="grid-template-columns:minmax(0,1fr)">
+            <a class="video-card" href="https://www.youtube.com/watch?v=X2ciJedw2vU">
+              <span class="video-card__type">Corrects outdated packaging</span>
+              <strong>RAW Agentic Coding: ZERO to Agent SKILL</strong>
+              <p>Maps the lesson’s reusable prompt primitive to the modern first-class Skill encoding.</p>
+              <span class="video-card__watch">Open video ↗</span>
+            </a>
+          </div>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <section class="retrieval-quiz" aria-label="Programmable agent retrieval questions">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. What single property makes Claude Code programmable in Dan’s demonstration?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It runs in the terminal, so any language with terminal access can invoke it through <code>claude -p</code>.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. What two additions make <code>prompt.md</code> more headless-ready than the README prompt?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It creates both runtime Python files, making the workflow self-contained, and it requires a REPORT with exact outputs.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What five host-side operations do the launchers share?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Read the prompt, invoke <code>claude -p</code>, capture output/errors, print the report, and signal success/failure through process status.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. Why is the “agent as function” analogy imperfect?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The call has side effects in the repository and terminal. Starting state, permissions, reports, and exit status therefore matter.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Explain the Python launcher line by line</strong> to someone who thinks “programmable agent” requires a special platform. Then explain why the REPORT and return code matter once the human is not present.</p>
+            <p class="fine">Pass if your explanation covers placement, side effects, evidence, and failure signaling—not just subprocess syntax.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="idea-paradox">
+        <span class="section-number">08</span>
+        <h2 class="section-title">The contradicting truth: replace yourself</h2>
+        <p class="section-lead">What gets replaced is your repeated execution. What becomes harder to replace is your judgment and ownership of the systems that perform it.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — concrete failure</p>
+          <h3>The indispensable bottleneck</h3>
+          <p>A team has one engineer who knows how to complete a fragile release ritual. They know which branch to create, which files to touch, which commands to run, what output is safe, and how to write the final update. Because only they can carry it, the engineer appears indispensable. In reality the team is dependent on an undocumented human workflow.</p>
+          <p>The engineer can protect that dependency, repeating the ritual forever, or encode it into a bounded, reviewable system. Encoding seems to remove their immediate necessity. It also changes their contribution from “person who remembers the steps” to “person who understands, improves, and governs the release system.” The first kind of indispensability is a bottleneck. The second is leverage.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — the paradox resolved</p>
+          <div class="paradox">
+            <blockquote>To become an irreplaceable engineer, you will replace yourself.<cite>Dan · TAC-1, approximately 20:47</cite></blockquote>
+          </div>
+          <div class="workflow" style="margin-top:var(--space-4)">
+            <div class="workflow__step"><strong>You do it</strong><code>implicit craft</code></div>
+            <div class="workflow__step"><strong>You name it</strong><code>runbook</code></div>
+            <div class="workflow__step"><strong>Agent does it</strong><code>repeatable chain</code></div>
+            <div class="workflow__step"><strong>You review it</strong><code>judgment</code></div>
+            <div class="workflow__step"><strong>You improve it</strong><code>owned leverage</code></div>
+          </div>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story of one move — Dan’s demo</p>
+          <h3>The lesson replaces the operator before it names the paradox</h3>
+          <p>First Dan runs the agentic prompt interactively. He chooses it, pastes it, and watches the system carry the work. Then he deletes the branch and fires the same workflow through Python. The second run removes his interactive presence. By the time Dan states the contradicting truth near the close, the chapter has already enacted it.</p>
+          <p>The replacement is narrow and exact: Dan is no longer necessary to paste the prompt and supervise each transition of this branch-write-run-commit-report workflow. He remains necessary to choose the workflow, explain why it matters, define the permissions, inspect the report, and decide what mechanism to build next. This narrowness protects the idea from hype. You do not replace “the engineer” in one move. You replace one repeated piece of the engineer’s current execution.</p>
+          <aside class="callout callout--why">
+            <p class="callout__label">The ownership move</p>
+            <p>The person who turns tacit work into a reliable system becomes the person who can inspect, adapt, and multiply that system. Automation removes a task while creating a higher-order responsibility.</p>
+          </aside>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan term + plain English</p>
+          <h3>The contradicting truth</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Dan’s term</p>
+            <p><strong>The contradicting truth:</strong> to become irreplaceable, replace yourself.</p>
+          </aside>
+          <p>Plain English: systematically turn your repeated execution into systems, then move your attention to the judgment and design those systems need. “Replace yourself” is a method for discovering the next level of your role. It does not guarantee permanent job safety; Dan explicitly frames evolution as continuous. It creates an asymmetric advantage because you learn to own the machinery of change rather than defend the task being changed.</p>
+          <p>The paradox has two halves that must stay together. Replacement without ownership can become cost cutting. Ownership without replacement becomes a bottleneck. Agentic engineering aims for both: remove yourself from repeated transitions and increase your responsibility for outcome quality.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — replace one TAC-1 ritual</p>
+          <h3>From interactive operator to owner of a callable workflow</h3>
+          <table>
+            <thead><tr><th>Before</th><th>Encoded in TAC-1</th><th>Your higher-order work</th></tr></thead>
+            <tbody>
+              <tr><td>Remember to create the demo branch</td><td>RUN branch instruction</td><td>Define safe starting state and rerun policy</td></tr>
+              <tr><td>Type two tiny programs</td><td>CREATE blocks</td><td>State behavior and review generated implementation</td></tr>
+              <tr><td>Run and copy outputs</td><td>UV commands + REPORT</td><td>Define trustworthy evidence and compare it independently</td></tr>
+              <tr><td>Stage and commit manually</td><td>Git tool chain</td><td>Bound permissions and decide what may be recorded automatically</td></tr>
+              <tr><td>Paste the prompt each time</td><td>Python/Shell/TS launcher</td><td>Choose future triggers and integration boundaries</td></tr>
+            </tbody>
+          </table>
+          <p>The same transformation can be repeated across a career: observe a workflow you carry, make its state and checks explicit, give an agent bounded actions, require evidence, and move yourself to the next unresolved judgment point. TAC-1 does not teach later trigger systems yet, but it gives you the unit those systems will fire.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — the replacement ladder</p>
+          <h3>Name one task, one system, one next responsibility</h3>
+          <ol>
+            <li>Write a repeated task you currently perform.</li>
+            <li>Write the smallest action chain that would replace your repeated execution.</li>
+            <li>Write the evidence you would require before trusting the result.</li>
+            <li>Write the new question or risk that remains yours after the chain runs.</li>
+            <li>Complete the sentence: “I am not making myself unnecessary; I am making my attention available for ___.”</li>
+          </ol>
+          <p>Keep this as a teach-back exercise only during TAC-1. The graded implementation remains inside the course repo.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: reading the paradox as fatalism</h3>
+          <p><strong>Symptom:</strong> “If I automate my work, the company will not need me, so I should protect the manual process.” This treats brittle task ownership as career security.</p>
+          <p><strong>Fix:</strong> state exactly what is replaced and what remains. In TAC-1, prompt pasting and workflow carrying are replaced. Judgment about goals, constraints, permissions, evidence, risk, and improvement remains. Then make that judgment visible by owning the runbook, checks, and review standards rather than hiding the manual ritual.</p>
+          <p>The opposite failure is grandiosity: claiming a tiny launcher replaces an entire engineer. Repair it by narrowing the claim to one workflow. Credible agentic engineering grows by accumulating verified replacements.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice overlay</p>
+          <h3>Systems now scale further; responsibility scales too</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · mid-2026</p>
+            <p>Background agents, subagents, hooks, and parallel worktrees can now replace larger portions of repeated execution than TAC-1’s serial terminal example. The responsibility lesson grows with them: more autonomous reach requires clearer boundaries, stronger evidence, and better ownership. Do not mistake a higher autonomy ceiling for permission to skip review design.</p>
+            <p class="current-practice__source">No additional video card here; the chapter stays within the locked maximum of three overlays.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval check</p>
+          <section class="retrieval-quiz" aria-label="Replace yourself retrieval questions">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. State the contradicting truth exactly.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>To become an irreplaceable engineer, you will replace yourself.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. What is replaced in the TAC-1 programmable move?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The human’s repeated prompt-pasting and carrying of the branch-write-run-commit-report workflow.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What becomes more valuable after that replacement?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Judgment about goals, constraints, tool boundaries, evidence, risks, triggers, review, and improvement—plus ownership of the system.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. Why is “this launcher replaces an engineer” a bad interpretation?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It overstates a narrow workflow replacement. Credible progress names the exact repeated execution removed and the higher-order work that remains.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back prompt</p>
+          <div class="teach-back">
+            <p><strong>Resolve the paradox in one minute.</strong> Use the interactive-to-programmable TAC-1 progression. Name what Dan replaces, what he still owns, and why the second kind of work creates more leverage.</p>
+            <p class="fine">Pass if the explanation is neither fatalistic nor grandiose.</p>
+          </div>
+        </div>
+      </section>
+
+      <section class="chapter-section chapter-section--wide" id="lab">
+        <span class="section-number">09</span>
+        <h2 class="section-title">Graded lab · Make the phase change real</h2>
+        <p class="section-lead">This 45–75 minute lab runs only in the TAC-1 course repository. You will reproduce the interactive A/B test, invoke the same workflow headlessly from three languages, perturb one permission, and prove mastery without typing application code.</p>
+
+        <aside class="callout callout--warning">
+          <p class="callout__label">Safety and scope contract</p>
+          <p>Work only in a fresh clone of <code>https://github.com/disler/tac-1.git</code> or the local course source at <code>tac/tac-1</code>. Do not transplant the drill into a work repository. Read permissions before running. The course allowlist does not include <code>git push</code>. Reset the demo branch between comparable runs.</p>
+        </aside>
+
+        <h3>Lab map</h3>
+        <div class="workflow" aria-label="Lab phases">
+          <div class="workflow__step"><strong>0 · Audit</strong><code>10 min</code></div>
+          <div class="workflow__step"><strong>1 · A/B</strong><code>15 min</code></div>
+          <div class="workflow__step"><strong>2 · Headless</strong><code>15 min</code></div>
+          <div class="workflow__step"><strong>3 · Stretch</strong><code>15–30 min</code></div>
+          <div class="workflow__step"><strong>4 · Oral</strong><code>5 min</code></div>
+        </div>
+
+        <section class="lab-box" id="lab-setup">
+          <h3 class="lab-box__title">Lab 0 · Setup and permissions audit</h3>
+          <ul class="lab-box__meta"><li>10 minutes</li><li>Required</li><li>Checkpoint 0</li></ul>
+          <p><strong>Failure this prevents:</strong> an agent reaches an action boundary you did not know existed, and you misdiagnose permissions as model unreliability.</p>
+          <ol class="lab-box__steps">
+            <li>Create a fresh directory for TAC course work. Clone and enter the course repository:
+              <pre><code>git clone https://github.com/disler/tac-1.git
+cd tac-1</code></pre>
+            </li>
+            <li>Verify the required toolbelt. Bun is needed only for the TypeScript variant:
+              <pre><code>claude --version
+uv --version
+git --version
+bun --version</code></pre>
+              <p>On Windows, use WSL as the course environment.</p>
+            </li>
+            <li>Open <code>.claude/settings.json</code>. Write answers before continuing:
+              <ul>
+                <li>Which three file tools are allowed?</li>
+                <li>Which four Git subcommands are allowed?</li>
+                <li>Which obvious Git action is absent?</li>
+                <li>Which non-local tool is enabled?</li>
+              </ul>
+            </li>
+            <li>Open the repository in your IDE. Open an integrated terminal. Dan uses VS Code and <kbd>Cmd</kbd>+<kbd>J</kbd>.</li>
+            <li>Run <code>claude</code> to enter the interactive agent.</li>
+          </ol>
+          <div class="checkpoint">
+            <strong>Checkpoint 0 · no notes.</strong> Say: “Read, Write, Edit; UV run; Git checkout, branch, add, commit; WebSearch; no push permission.” If you cannot retrieve the surface, reread the file. Permission literacy is a graded outcome.
+          </div>
+          <div class="lab-box__pass">
+            <h4>Pass criteria</h4>
+            <ul><li>All required commands report versions.</li><li>You can state what the agent may and may not do.</li><li>You are in the TAC-1 course repository before starting Claude Code.</li></ul>
+          </div>
+        </section>
+
+        <section class="lab-box" id="lab-ab">
+          <h3 class="lab-box__title">Lab 1 · Reproduce Dan’s interactive A/B</h3>
+          <ul class="lab-box__meta"><li>15 minutes</li><li>Required</li><li>Checkpoint 1</li></ul>
+          <p><strong>Failure this exposes:</strong> mistaking “more generated files” for “engineering work carried by an agent.”</p>
+
+          <h4>A · Phase-one baseline</h4>
+          <ol class="lab-box__steps">
+            <li>Open <code>README.md</code> and copy only the <strong>AI Coding Prompt</strong>.</li>
+            <li>Paste it into the interactive Claude Code session and fire.</li>
+            <li>Inspect <code>main_aic.py</code>. Do not hand-edit it.</li>
+            <li>Run it independently:
+              <pre><code>uv run main_aic.py</code></pre>
+              <p>Expected exact output: <code>goodbye ai coding</code>.</p>
+            </li>
+            <li>Write what the agent did not do: it did not create a branch, execute the program as part of the prompt, stage a change, or commit.</li>
+          </ol>
+
+          <h4>B · Phase-two workflow</h4>
+          <ol class="lab-box__steps">
+            <li>Copy the README’s <strong>Agentic Coding Prompt</strong> into the same interactive session.</li>
+            <li>Before the first tool call completes, notice whether a todo plan forms. Watch the steps drain; do not relay intermediate output.</li>
+            <li>Verify the current branch:
+              <pre><code>git branch --show-current</code></pre>
+              <p>Expected: <code>demo-agentic-coding</code>.</p>
+            </li>
+            <li>Inspect <code>main_tac.py</code>. It must print <code>hello agentic coding</code> and a concise, single-line definition of AI agents. The exact definition wording is model-generated, so grade the behavior, not a fabricated fixed sentence.</li>
+            <li>Run both files yourself and compare with the agent trace:
+              <pre><code>uv run main_aic.py
+uv run main_tac.py</code></pre>
+            </li>
+            <li>Inspect the commit:
+              <pre><code>git log --oneline -1</code></pre>
+              <p>The subject must be <code>Demo agentic coding capabilities</code>.</p>
+            </li>
+            <li>Confirm the agent reported what it did and completed its todo sequence.</li>
+          </ol>
+
+          <div class="checkpoint">
+            <strong>Checkpoint 1 · write the delta.</strong> List five things Prompt B did that Prompt A did not. Use action verbs: branch, create, execute, commit, manage/report. This list is the phase change in operational form.
+          </div>
+          <div class="lab-box__pass">
+            <h4>Pass criteria</h4>
+            <ul>
+              <li><code>main_aic.py</code> prints the exact phase-one line.</li>
+              <li>You are on <code>demo-agentic-coding</code>.</li>
+              <li><code>main_tac.py</code> has both required behaviors.</li>
+              <li>Both programs were executed by the agent and independently by you.</li>
+              <li>The required commit exists and your five-action delta is complete.</li>
+            </ul>
+          </div>
+        </section>
+
+        <section class="lab-box" id="lab-headless">
+          <h3 class="lab-box__title">Lab 2 · Reproduce Dan headlessly</h3>
+          <ul class="lab-box__meta"><li>15 minutes</li><li>Required</li><li>Checkpoint 2</li></ul>
+          <p><strong>Failure this exposes:</strong> understanding <code>claude -p</code> as syntax without feeling how a caller replaces the interactive operator.</p>
+          <ol class="lab-box__steps">
+            <li>Read <code>programmable/prompt.md</code> before executing. Write its two changes relative to the README agentic prompt:
+              <ul>
+                <li>It creates <code>main_aic.py</code> too.</li>
+                <li>It requires the exact output of both files in <code>REPORT</code>.</li>
+              </ul>
+            </li>
+            <li>Return to a clean demonstration state exactly as Dan does:
+              <pre><code>git checkout main
+git branch -D demo-agentic-coding</code></pre>
+              <p>If deletion fails, inspect <code>git branch</code> and confirm you are not currently on the demo branch. Do not improvise destructive Git commands.</p>
+            </li>
+            <li>From a fresh terminal on <code>main</code>, run the Python launcher:
+              <pre><code>uv run python programmable/programmable.py</code></pre>
+            </li>
+            <li>Hands off. Record any point at which the workflow asks for input or permission. A clean run should carry the sequence and return.</li>
+            <li>After completion, verify four independent facts:
+              <ul>
+                <li>the demo branch exists and is current;</li>
+                <li>both runtime files exist;</li>
+                <li>the required commit exists;</li>
+                <li>the printed report contains the actual outputs.</li>
+              </ul>
+            </li>
+            <li>Cross-check report truth by running both programs yourself. A report that sounds plausible but disagrees with execution is not a pass.</li>
+            <li>Reset branch state between runs. Then execute:
+              <pre><code>sh programmable/programmable.sh</code></pre>
+            </li>
+            <li>Reset again and execute the optional Bun variant:
+              <pre><code>bun run programmable/programmable.ts</code></pre>
+              <p>If Bun is not installed, record the variant as not run; Python and Shell remain the required conceptual proof. The source lab specification labels Bun optional at setup while including it in the full three-launcher checkpoint.</p>
+            </li>
+          </ol>
+          <div class="checkpoint">
+            <strong>Checkpoint 2 · one sentence.</strong> “The host language does not matter because any program with terminal access can pass the shared prompt to <code>claude -p</code>; the prompt and agent runtime define the engineering workflow.”
+          </div>
+          <div class="lab-box__pass">
+            <h4>Pass criteria</h4>
+            <ul>
+              <li>Python and Shell carry the identical workflow headlessly; Bun does too when available.</li>
+              <li>Every comparable run begins from <code>main</code> without the demo branch.</li>
+              <li>The report matches independent execution.</li>
+              <li>You can explain why the wrapper language is incidental.</li>
+            </ul>
+          </div>
+        </section>
+
+        <section class="lab-box" id="lab-stretch">
+          <h3 class="lab-box__title">Lab 3 · Stretch the loop without typing code</h3>
+          <ul class="lab-box__meta"><li>15–30 minutes</li><li>Choose S1 + one more</li><li>Course repo only</li></ul>
+
+          <h4>S1 · Extend REPORT: close one more loop</h4>
+          <ol class="lab-box__steps">
+            <li>Inside Claude Code—not your editor—ask the agent to edit <code>programmable/prompt.md</code> so REPORT also includes the current Git branch name.</li>
+            <li>Review the prompt diff. Confirm the existing exact-output requirement remains.</li>
+            <li>Reset the branch and run the Python launcher.</li>
+            <li>Compare the reported branch with <code>git branch --show-current</code>.</li>
+          </ol>
+          <p><strong>Learning target:</strong> report-back is part of workflow design. The new field creates a new externally checkable claim.</p>
+
+          <h4>S2 · Add a fourth launcher: prove language independence</h4>
+          <ol class="lab-box__steps">
+            <li>Ask Claude Code to inspect the existing Shell, Python, and TypeScript launchers.</li>
+            <li>Ask it to add a launcher in another language already available on your machine—plain Node, Ruby, or Go are examples from the lab specification, not requirements.</li>
+            <li>Require the same invariants: read <code>prompt.md</code>, invoke <code>claude -p</code>, return output, surface errors/failure.</li>
+            <li>Reset, run, and verify the same repository end state.</li>
+          </ol>
+          <p><strong>Learning target:</strong> separate host syntax from the shared agentic workflow.</p>
+
+          <h4>S3 · Break one permission: feel the tools boundary</h4>
+          <ol class="lab-box__steps">
+            <li>Ask Claude Code to remove <code>"Bash(git commit:*)"</code> from <code>.claude/settings.json</code>. Review the diff.</li>
+            <li>Reset the demo state and rerun the agentic prompt.</li>
+            <li>Record the exact transition where the system halts, refuses, or asks. Do not summarize it as “Claude failed.”</li>
+            <li>Restore the permission through Claude Code and review the restored file.</li>
+            <li>Complete the sentence: “The prompt described the commit, but the workflow could not cross that state boundary because ___.”</li>
+          </ol>
+          <p><strong>Learning target:</strong> the tools circle bounds what even a correct prompt and capable model can accomplish.</p>
+
+          <h4>S4 · Transfer map: classify your real work</h4>
+          <ol class="lab-box__steps">
+            <li>Time the interactive phase-one and phase-two runs.</li>
+            <li>List real tasks that are AI-coding-prompt-shaped: the needed outcome is primarily generated code.</li>
+            <li>List tasks that are agentic-prompt-shaped: success requires ordered repository or system actions and evidence.</li>
+            <li>Circle one candidate whose repeated transitions could be encoded after the course. Do not run it outside TAC-1 in this lab.</li>
+          </ol>
+          <p><strong>Learning target:</strong> transfer the distinction without expanding the authorized lab scope.</p>
+
+          <div class="lab-box__pass">
+            <h4>Stretch pass criteria</h4>
+            <ul>
+              <li>All file changes were made through Claude Code.</li>
+              <li>S1 report includes the real branch name and both real outputs.</li>
+              <li>Your second chosen stretch produces an observed result, not a proposal.</li>
+              <li>Any settings modification is restored before you finish.</li>
+            </ul>
+          </div>
+        </section>
+
+        <section class="lab-box" id="lab-troubleshooting">
+          <h3 class="lab-box__title">Troubleshooting without abandoning the lesson</h3>
+          <ul class="lab-box__meta"><li>Use when stuck</li><li>Diagnose with Core Four</li></ul>
+          <table>
+            <thead><tr><th>What you observe</th><th>Likely cause</th><th>Repair</th></tr></thead>
+            <tbody>
+              <tr><td>Branch already exists or contains prior runtime files</td><td>Starting state differs</td><td>Checkout <code>main</code>, delete the demo branch, then rerun.</td></tr>
+              <tr><td>Branch cannot be deleted</td><td>You may still be on it</td><td>Use <code>git branch --show-current</code>, checkout <code>main</code>, retry deletion.</td></tr>
+              <tr><td>Commit action blocks</td><td>Permission was removed or not loaded</td><td>Inspect the current settings surface; do not widen it beyond the course list.</td></tr>
+              <tr><td><code>main_aic.py</code> is missing during README Prompt B</td><td>You skipped Prompt A</td><td>Run the interactive A/B in order, or use the self-contained programmable prompt for headless work.</td></tr>
+              <tr><td>Report omits exact output</td><td>Prompt/report contract or execution failed</td><td>Inspect <code>prompt.md</code>, confirm REPORT remains, compare stdout/stderr and independent runs.</td></tr>
+              <tr><td>Bun launcher fails before Claude starts</td><td>Optional Bun tool unavailable</td><td>Verify <code>bun --version</code>; complete Python and Shell, record Bun as not run.</td></tr>
+              <tr><td>You are tempted to repair a file directly</td><td>Ninety-percent trap</td><td>Give the discrepancy and a verification command back to the agent.</td></tr>
+            </tbody>
+          </table>
+        </section>
+
+        <section class="lab-box" id="lab-final-pass">
+          <h3 class="lab-box__title">Final pass sheet</h3>
+          <ul class="lab-box__meta"><li>All required</li><li>Grade from evidence</li></ul>
+          <div class="lab-box__pass">
+            <h4>Artifacts and behavior</h4>
+            <ul>
+              <li>□ Zero application code typed by hand.</li>
+              <li>□ Correct permissions audit from memory.</li>
+              <li>□ Correct five-action A/B delta.</li>
+              <li>□ <code>demo-agentic-coding</code> exists with the required commit.</li>
+              <li>□ The commit contains <code>main_aic.py</code> and <code>main_tac.py</code>.</li>
+              <li>□ <code>main_tac.py</code> prints the greeting plus a one-line AI-agent definition.</li>
+              <li>□ Python and Shell launchers complete headlessly; TypeScript/Bun when available.</li>
+              <li>□ REPORT agrees with independent execution.</li>
+              <li>□ Any permission removed in S3 has been restored.</li>
+            </ul>
+            <h4>Oral mastery</h4>
+            <ul>
+              <li>□ Big Three and Core Four, with the precise delta.</li>
+              <li>□ Dan’s scale-and-performance rebuttal.</li>
+              <li>□ Claude Code’s three essential elements.</li>
+              <li>□ Why <code>claude -p</code> changes where the workflow can live.</li>
+              <li>□ The contradicting truth resolved without fatalism.</li>
+            </ul>
+          </div>
+        </section>
+      </section>
+
+      <section class="chapter-section" id="mastery">
+        <span class="section-number">10</span>
+        <h2 class="section-title">Mastery check · retrieve, diagnose, teach</h2>
+        <p class="section-lead">Recognition is not the finish line. Close the chapter, answer on paper, then return to reveal. Score operations and reasoning, not exact prose.</p>
+
+        <h3>Round 1 · Foundations</h3>
+        <section class="retrieval-quiz" aria-label="Cumulative foundations quiz">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. What are the Big Three?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Context, model, prompt—present in AI coding whether or not they are visible in the interface.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. What upgrades them to the Core Four?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Tools, specifically prompts that can reliably execute long chains of tool calls.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What does “Stop Coding” forbid, and what does it preserve?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It forbids hand-typing application code as the default instrument. It preserves and intensifies code generation, understanding, review, planning, and closed-loop design.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. Define Commander of Compute without saying “uses AI.”</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>An engineer who aims compute by specifying outcomes, context, constraints, bounded actions, evidence, and triggers to build systems that build systems.</p></details></div>
+        </section>
+
+        <h3>Round 2 · Trace the demo</h3>
+        <section class="retrieval-quiz" aria-label="Cumulative demo quiz">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">5. Reconstruct Prompt B’s state transitions without looking.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Checkout the demo branch; create <code>main_tac.py</code>; run <code>main_aic.py</code>; run <code>main_tac.py</code>; stage files; commit with the specified message; report completion.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">6. Which runtime artifact must exist before the README Agentic Coding Prompt runs, and why?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>main_aic.py</code>, because Prompt B runs it but does not create it. The interactive A/B order supplies it.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">7. What exact commit subject proves the Git portion completed?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>Demo agentic coding capabilities</code>.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">8. What makes <code>prompt.md</code> self-contained and observable?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It creates both Python files, performs the branch/run/commit chain, and demands exact program outputs in REPORT.</p></details></div>
+        </section>
+
+        <h3>Round 3 · Diagnose with the Core Four</h3>
+        <section class="retrieval-quiz" aria-label="Cumulative diagnosis quiz">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">9. The prompt says commit; the model plans commit; the agent cannot execute it after S3. Which dimension failed?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Tools/permission: the commit tool pattern was removed from the allowlist.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">10. The agent edits the wrong <code>prompt.md</code> in a larger repo. What two dimensions should you probe first?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Context—what paths and repository content it saw—and prompt—whether the target path was explicit.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">11. A tool calls all commands but forgets the first program’s output before REPORT. Which essential element is most suspect?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The agent architecture’s state/observation management, though the combined system should be evaluated rather than blaming a label alone.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">12. Why is repeated rerolling a weak diagnostic method?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It changes stochastic output without isolating whether context, model, prompt, or tools caused the failed state transition.</p></details></div>
+        </section>
+
+        <h3>Round 4 · Transfer and judgment</h3>
+        <section class="retrieval-quiz" aria-label="Cumulative transfer quiz">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">13. A prompt generates five excellent files, but a human runs tests, commits, and reports. AI coding or agentic coding?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Primarily AI coding. Output quantity does not move the workflow boundary; the human still carries the engineering transitions.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">14. Why is exact report-back a seed of closed-loop engineering?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It turns internal work into an externally checkable claim that a human or another program can compare with reality and use for the next decision.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">15. When is a tiny workflow a better leverage point than a huge one?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>When it repeats often, has clear state transitions and evidence, and can be carried reliably with low marginal human attention.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">16. Resolve “replace yourself” in one sentence.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Automate your repeated execution so your scarce attention moves to judgment, system ownership, and the next leverage point.</p></details></div>
+        </section>
+
+        <aside class="callout callout--why">
+          <p class="callout__label">Scoring</p>
+          <p><strong>13–16 correct:</strong> ready to teach and proceed. <strong>9–12:</strong> rerun the lab checkpoint associated with each miss. <strong>0–8:</strong> redraw the phase map and Core Four, then reproduce the A/B test again. A recognized answer that you cannot use in diagnosis counts as half credit.</p>
+        </aside>
+
+        <h3>Capstone teach-back</h3>
+        <div class="teach-back">
+          <p>Without notes, teach a colleague for five minutes:</p>
+          <ol>
+            <li>Why reliable long tool chains—not tool calling itself—separate agentic coding from AI coding.</li>
+            <li>How the two README prompts provide evidence.</li>
+            <li>What the Core Four are and how to use them to diagnose a failed commit.</li>
+            <li>What <code>claude -p</code> unlocks that an interactive session does not.</li>
+            <li>Why replacing the operator of one workflow can make the engineer more valuable.</li>
+          </ol>
+          <p class="fine">Expert pass: your listener can reconstruct the course workflow and predict the effect of removing <code>Bash(git commit:*)</code>.</p>
+        </div>
+      </section>
+
+      <section class="chapter-section" id="glossary">
+        <span class="section-number">11</span>
+        <h2 class="section-title">TAC-1 glossary</h2>
+        <p class="section-lead">Use Dan’s terms consistently. Each definition below is narrow enough to test against the lesson repository.</p>
+        <dl class="glossary">
+          <div><dt>TAC</dt><dd>Tactical Agentic Coding: eight lessons, eight tactics, and one course codebase per lesson.</dd></div>
+          <div><dt>Loot box</dt><dd>The per-lesson collection of prompts, links, notes, and assets. The transcript may mishear it as “loop box.”</dd></div>
+          <div><dt>AI coding</dt><dd>Phase-one prompt-to-code work governed by context, model, and prompt. Useful and foundational, but the human often carries the surrounding workflow.</dd></div>
+          <div><dt>Agentic coding</dt><dd>Phase-two engineering in which the Big Three gain tools and a prompt reliably carries a chain of actions.</dd></div>
+          <div><dt>Agentic Engineer</dt><dd>An engineer who builds systems that can take engineering actions, rather than only prompting for isolated artifacts.</dd></div>
+          <div><dt>Commander of compute</dt><dd>The engineer who aims model capacity through outcomes, context, constraints, tools, evidence, and eventually triggers.</dd></div>
+          <div><dt>Big Three</dt><dd>Context, model, prompt—the primitives present in every AI coding interaction.</dd></div>
+          <div><dt>Core Four</dt><dd>Context, model, prompt, tools—the phase-two diagnostic vocabulary.</dd></div>
+          <div><dt>Context</dt><dd>Everything the model can see while working: repository files, current state, settings, instructions, and tool observations.</dd></div>
+          <div><dt>Model</dt><dd>The language model performing interpretation, reasoning, generation, and decisions inside the agentic system.</dd></div>
+          <div><dt>Prompt</dt><dd>The instruction describing outcome, starting state, constraints, actions, checks, and report. In TAC-1 it becomes a runbook.</dd></div>
+          <div><dt>Tools</dt><dd>The bounded actions an agent may perform. Phase-two significance comes from reliable long chains, not mere tool existence.</dd></div>
+          <div><dt>Agentic Coding Prompt</dt><dd>A workflow specification containing a sequence of tool calls. TAC-1 uses RUN, CREATE, RUN, and later REPORT.</dd></div>
+          <div><dt>Long tool chain</dt><dd>Several ordered actions whose observations and state must carry forward reliably toward one outcome.</dd></div>
+          <div><dt>Programmable agentic coding</dt><dd>Calling an agentic tool from code. In TAC-1, Shell, Python, and TypeScript all pass <code>prompt.md</code> to <code>claude -p</code>.</dd></div>
+          <div><dt>REPORT</dt><dd>The prompt block requiring returned evidence. TAC-1 asks for exact outputs of both generated Python files.</dd></div>
+          <div><dt>Closed loop</dt><dd>A structure where action produces observations that can be checked and used for the next decision rather than ending at generation.</dd></div>
+          <div><dt>System that builds systems</dt><dd>Dan’s description of moving up the stack: construct mechanisms that create and operate software-producing mechanisms.</dd></div>
+          <div><dt>Self-operating machine</dt><dd>The incremental end-state of a codebase whose agentic workflows increasingly run at the right time with bounded oversight.</dd></div>
+          <div><dt>Leverage</dt><dd>More valuable outcome per unit of scarce human attention. The “10x” label is arbitrary; the leverage point determines the multiplier.</dd></div>
+          <div><dt>Stop Coding</dt><dd>Tactic #1: stop hand-typing application code while increasing planning, review, code understanding, and closed-loop design.</dd></div>
+          <div><dt>Contradicting truth</dt><dd>“To become an irreplaceable engineer, you will replace yourself”: encode repeated execution and move to higher-order judgment and ownership.</dd></div>
+        </dl>
+      </section>
+
+      <footer class="chapter-footer">
+        <p class="eyebrow">Volume I · Tactical Agentic Coding</p>
+        <div class="chapter-footer__nav">
+          <a href="../index.html">← Book hub</a>
+          <span class="fine">Next: TAC-2 · The 12 Leverage Points (pending)</span>
+        </div>
+      </footer>
+    </main>
+  </div>
+
+  <script>
+    (() => {
+      const topBar = document.getElementById('top-progress');
+      const railBar = document.getElementById('rail-progress');
+      const label = document.getElementById('progress-label');
+      const links = [...document.querySelectorAll('.chapter-nav a')];
+      const sections = links.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
+
+      const updateProgress = () => {
+        const max = document.documentElement.scrollHeight - window.innerHeight;
+        const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
+        const percent = `${Math.round(value * 100)}%`;
+        topBar.style.width = percent;
+        railBar.style.width = percent;
+        label.textContent = percent;
+      };
+
+      const observer = new IntersectionObserver(entries => {
+        const visible = entries
+          .filter(entry => entry.isIntersecting)
+          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
+        if (!visible) return;
+        links.forEach(link => {
+          const active = link.getAttribute('href') === `#${visible.target.id}`;
+          if (active) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        });
+      }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, .1, .5] });
+
+      sections.forEach(section => observer.observe(section));
+      updateProgress();
+      window.addEventListener('scroll', updateProgress, { passive: true });
+      window.addEventListener('resize', updateProgress);
+    })();
+  </script>
+</body>
+</html>

