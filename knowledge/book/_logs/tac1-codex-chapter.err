+        </div>
+      </footer>
+    </main>
+  </div>
+
+  <script>
+    (() => {
+      const topBar = document.getElementById('top-progress');
+      const railBar = document.getElementById('rail-progress');
+      const label = document.getElementById('progress-label');
+      const links = [...document.querySelectorAll('.chapter-nav a')];
+      const sections = links.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
+      let progressFramePending = false;
+
+      const updateProgress = () => {
+        const max = document.documentElement.scrollHeight - window.innerHeight;
+        const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
+        const percent = `${Math.round(value * 100)}%`;
+        topBar.style.width = percent;
+        railBar.style.width = percent;
+        label.textContent = percent;
+      };
+
+      const requestProgressUpdate = () => {
+        if (progressFramePending) return;
+        progressFramePending = true;
+        requestAnimationFrame(() => {
+          updateProgress();
+          progressFramePending = false;
+        });
+      };
+
+      const observer = new IntersectionObserver(entries => {
+        const visible = entries
+          .filter(entry => entry.isIntersecting)
+          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
+        if (!visible) return;
+        links.forEach(link => {
+          const active = link.getAttribute('href') === `#${visible.target.id}`;
+          if (active) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        });
+      }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, .1, .5] });
+
+      sections.forEach(section => observer.observe(section));
+      updateProgress();
+      window.addEventListener('scroll', requestProgressUpdate, { passive: true });
+      window.addEventListener('resize', requestProgressUpdate);
+    })();
+  </script>
+</body>
+</html>

exec
/bin/zsh -lc "rg -n 'exit code|exit status|status' IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html | head -50" in /Users/kvnkishore/WebstormProjects/AgenticEngineer
 succeeded in 0ms:
998:                <desc id="callable-desc">Shell, Python, and TypeScript launchers feed the same prompt into claude dash p. The agent uses bounded tools against the repository and returns a report and exit status.</desc>
1014:                <text x="775" y="339" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-mono)" font-size="var(--text-diagram-sm)">report + exit code</text>
1037:              <figcaption><span class="frame-card__t">18:25</span>The Python implementation demystifies the pattern: read, invoke, capture, print, propagate status.</figcaption>
1056:          <p>The analogy helps because a caller supplies input and receives output. It is imperfect because the agent has side effects: it edits files, runs programs, and changes Git state. That is why permissions, starting state, reports, and exit codes matter. You are not calling a pure text transformer. You are invoking a bounded actor.</p>
1094:          <p>Shell reads, invokes, captures standard output through command substitution, and echoes it. It does <strong>not</strong> explicitly capture standard error or preserve the child exit code after the final <code>echo</code>. Python explicitly prints standard error and exits with Claude’s return code. The Bun wrapper catches a thrown command error and exits with status 1. Language choice is irrelevant to the agentic semantics because all three can access the terminal; wrapper quality still determines what an outer system can learn about failure.</p>
1143:            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. What host-side core do all three launchers share, and what does Shell omit?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>All read the prompt, invoke <code>claude -p</code>, and print returned text. The minimal Shell wrapper does not explicitly capture stderr or preserve the Claude process’s failing exit status after <code>echo</code>.</p></details></div>
1144:            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. Why is the “agent as function” analogy imperfect?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The call has side effects in the repository and terminal. Starting state, permissions, reports, and exit status therefore matter.</p></details></div>

