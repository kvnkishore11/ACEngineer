from html.parser import HTMLParser
from pathlib import Path
import re
p=Path('IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.html')
root=p.parent
class Audit(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.refs=[]; self.fragments=[]; self.scripts=[]; self.in_script=False; self.in_style=False; self.text=[]; self.stack=[]
    def handle_starttag(self,tag,attrs):
        d=dict(attrs); self.stack.append(tag)
        if 'id' in d:self.ids.append(d['id'])
        for key in ('src','href'):
            if key in d:
                v=d[key]
                if v.startswith('#'): self.fragments.append(v[1:])
                elif not re.match(r'"'^(?:https?:|mailto:|data:|javascript:)'"',v): self.refs.append(v)
        if tag=='script': self.in_script=True
        if tag=='style': self.in_style=True
    def handle_endtag(self,tag):
        if tag=='script': self.in_script=False
        if tag=='style': self.in_style=False
        if self.stack:
            try:
                i=len(self.stack)-1-self.stack[::-1].index(tag); self.stack=self.stack[:i]
            except ValueError: pass
    def handle_data(self,data):
        if self.in_script:self.scripts.append(data)
        elif not self.in_style:self.text.append(data)
a=Audit();a.feed(p.read_text())
missing_refs=[]
for r in sorted(set(a.refs)):
    target=(root/r).resolve()
    if not target.exists(): missing_refs.append((r,str(target)))
missing_frag=sorted(set(a.fragments)-set(a.ids))
dups=sorted({x for x in a.ids if a.ids.count(x)>1})
words=re.findall(r\"[A-Za-z0-9][A-Za-z0-9’'&+./:-]*\",' '.join(a.text))
print('visible_words',len(words))
print('ids',len(a.ids),'duplicates',dups)
print('fragment_links',len(a.fragments),'missing_fragments',missing_frag)
print('local_refs',len(set(a.refs)),'missing_refs',missing_refs)
print('scripts',len(a.scripts))
print('html_parser_errors','none')
