from html.parser import HTMLParser
from pathlib import Path
import re
files=[Path('IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.html'),Path('IndyDevDan/book/index.html')]
for p in files:
 class A(HTMLParser):
  def __init__(self):super().__init__();self.ids=[];self.fr=[];self.refs=[]
  def handle_starttag(self,t,a):
   d=dict(a)
   if 'id' in d:self.ids.append(d['id'])
   for k in ('href','src'):
    v=d.get(k,'')
    if v.startswith('#'):self.fr.append(v[1:])
    elif v and not re.match(r'"'^(https?:|mailto:|data:|javascript:)'"',v):self.refs.append(v)
 a=A();a.feed(p.read_text())
 assert len(a.ids)==len(set(a.ids)),(p,'duplicate ids')
 assert not (set(a.fr)-set(a.ids)),(p,'missing fragments',set(a.fr)-set(a.ids))
 missing=[x for x in set(a.refs) if not (p.parent/x).resolve().exists()]
 assert not missing,(p,'missing refs',missing)
 print(p,'PASS',len(set(a.refs)),'local refs')
PY

