+++ b/IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.assets.css
@@ -0,0 +1,338 @@
+/* AH-4 inherits the TAC-1 gold teaching grammar and adds fleet-system visuals. */
+@import url("../vol-1-tac/01-hello-agentic-coding.assets.css");
+
+:root {
+  --chapter-wide: 68.75rem;
+}
+
+body {
+  background:
+    radial-gradient(circle at 88% 2%, color-mix(in srgb, var(--accent-wash) 74%, transparent) 0 18rem, transparent 40rem),
+    linear-gradient(180deg, color-mix(in srgb, var(--bg) 94%, var(--bg-card)) 0, var(--bg) 36rem);
+}
+
+.skip-link {
+  position: fixed;
+  top: .5rem;
+  left: .5rem;
+  z-index: 120;
+  padding: .65rem .85rem;
+  border-radius: var(--radius-sm);
+  color: var(--ink-inverse);
+  background: var(--accent-ink);
+  transform: translateY(-180%);
+}
+
+.skip-link:focus { transform: none; }
+
+.hero--fleet {
+  background:
+    linear-gradient(128deg, transparent 0 56%, color-mix(in srgb, var(--accent-wash) 88%, transparent) 56% 100%),
+    var(--bg-card);
+}
+
+.hero--fleet::after { display: none; }
+
+.scale-ladder,
+.pillar-grid,
+.fleet-architecture,
+.piter-map,
+.core-four-grid,
+.crud-grid,
+.agent-contrast,
+.result-chain,
+.workflow-map,
+.practice-grid,
+.failure-grid,
+.mastery-grid,
+.lab-evidence,
+.tool-table,
+.template-table,
+.code-anatomy,
+.cost-board {
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+}
+
+.scale-ladder {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+  margin-top: var(--space-6);
+}
+
+.scale-ladder__step {
+  position: relative;
+  min-height: 8.5rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: color-mix(in srgb, var(--bg-card) 86%, var(--accent-wash));
+  box-shadow: var(--shadow-card);
+}
+
+.scale-ladder__step:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: -.72rem;
+  z-index: 2;
+  display: grid;
+  place-items: center;
+  width: 1.35rem;
+  height: 1.35rem;
+  border-radius: 50%;
+  color: var(--ink-inverse);
+  background: var(--accent);
+  content: "→";
+  font-weight: 800;
+  transform: translateY(-50%);
+}
+
+.scale-ladder__step b { display: block; color: var(--accent-ink); font: 700 var(--text-md)/1 var(--font-display); }
+.scale-ladder__step span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.scale-ladder__step--destination { border: 2px solid var(--accent); background: var(--accent-wash); }
+
+.pillar-grid,
+.core-four-grid,
+.crud-grid,
+.practice-grid,
+.failure-grid,
+.mastery-grid,
+.lab-evidence {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.pillar-grid article,
+.core-four-grid article,
+.crud-grid article,
+.practice-grid article,
+.failure-grid article,
+.mastery-grid article,
+.lab-evidence article {
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.pillar-grid article { border-top: .4rem solid var(--accent); }
+.pillar-grid strong,
+.core-four-grid strong,
+.crud-grid strong,
+.practice-grid strong,
+.failure-grid strong,
+.mastery-grid strong,
+.lab-evidence strong { display: block; color: var(--accent-ink); font-family: var(--font-display); font-size: var(--text-md); }
+.pillar-grid p,
+.core-four-grid p,
+.crud-grid p,
+.practice-grid p,
+.failure-grid p,
+.mastery-grid p,
+.lab-evidence p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.failure-grid article { border-top: 4px solid var(--warn); }
+
+.fleet-architecture {
+  display: grid;
+  grid-template-columns: 1fr auto 1.25fr auto 1fr;
+  gap: var(--space-3);
+  align-items: stretch;
+  padding: clamp(1.25rem, 4vw, 3rem);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: linear-gradient(135deg, var(--bg-card), var(--accent-wash));
+}
+
+.fleet-architecture__node {
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.fleet-architecture__node strong { display: block; color: var(--accent-ink); font: 700 var(--text-md) var(--font-display); }
+.fleet-architecture__node p { margin-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
+.fleet-architecture__arrow { display: grid; place-items: center; color: var(--accent); font: 800 var(--text-xl) var(--font-display); }
+
+.piter-map {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.piter-map__step {
+  position: relative;
+  min-height: 11rem;
+  padding: var(--space-5);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.piter-map__step:not(:last-child)::after { position: absolute; top: 50%; right: -.9rem; z-index: 2; color: var(--accent); content: "→"; font-size: var(--text-lg); font-weight: 800; }
+.piter-map__step b { display: block; color: var(--accent-ink); font: 800 var(--text-xl)/1 var(--font-display); }
+.piter-map__step strong { display: block; margin-top: var(--space-2); }
+.piter-map__step span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.core-four-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.core-four-grid article { min-height: 12rem; border-top: .35rem solid var(--accent); }
+
+.crud-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.crud-grid article { border-top: .35rem solid var(--ok); }
+.crud-grid code { display: block; margin-top: var(--space-2); overflow-wrap: anywhere; }
+
+.agent-contrast,
+.result-chain,
+.workflow-map,
+.cost-board {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  overflow: hidden;
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.agent-contrast article,
+.result-chain article,
+.workflow-map article,
+.cost-board article { padding: clamp(1.25rem, 4vw, 2.7rem); }
+.agent-contrast article:first-child,
+.result-chain article:first-child,
+.workflow-map article:first-child,
+.cost-board article:first-child { background: var(--accent-wash); }
+.agent-contrast article + article,
+.result-chain article + article,
+.workflow-map article + article,
+.cost-board article + article { border-left: var(--hairline); }
+.agent-contrast h3,
+.result-chain h3,
+.workflow-map h3,
+.cost-board h3 { margin: 0; }
+
+.workflow-map { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.workflow-map article:nth-child(2) { background: var(--bg-card); }
+.workflow-map article:nth-child(3) { background: var(--ok-wash); }
+
+.tool-table,
+.template-table {
+  overflow-x: auto;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.tool-table table,
+.template-table table { min-width: 62rem; margin: 0; }
+.tool-table tbody tr { border-left: .35rem solid var(--accent); }
+.template-table tbody tr { border-left: .35rem solid var(--ok); }
+
+.code-anatomy {
+  overflow: hidden;
+  border: 1px solid var(--terminal-border);
+  border-radius: var(--radius-lg);
+  color: var(--terminal-ink);
+  background: var(--terminal-bg);
+  box-shadow: var(--shadow-card);
+}
+
+.code-anatomy__title { padding: .75rem 1rem; color: var(--terminal-ink); background: var(--terminal-bar); font: 700 var(--text-sm) var(--font-mono); }
+.code-anatomy pre { margin: 0; border: 0; border-radius: 0; color: inherit; background: transparent; }
+.code-anatomy__notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; color: var(--ink); background: var(--terminal-border); }
+.code-anatomy__notes p { padding: var(--space-3); background: var(--bg-card); font-size: var(--text-sm); }
+.code-anatomy__notes b { color: var(--accent-ink); }
+
+.source-lock {
+  padding: var(--space-4);
+  border-left: 4px solid var(--ink-mute);
+  color: var(--ink-soft);
+  background: var(--bg-inset);
+  font-size: var(--text-sm);
+}
+
+.lab-checklist { padding: 0; list-style: none; }
+.lab-checklist li { position: relative; padding-left: 2rem; }
+.lab-checklist li::before { position: absolute; left: 0; color: var(--accent-ink); content: "□"; font: 700 var(--text-md) var(--font-mono); }
+
+.chapter-main .frame-card {
+  width: 100%;
+  max-width: min(100%, 68.75rem);
+  margin-inline: auto;
+}
+
+.chapter-main .frame-card img {
+  display: block;
+  width: 100%;
+  max-width: 68.75rem;
+  aspect-ratio: 16 / 9;
+  object-fit: contain;
+  background: var(--bg);
+}
+
+.frame-card figcaption { max-width: none; }
+.frame-card__t { display: inline-flex; margin-right: .5rem; padding: .12rem .42rem; border-radius: 999px; color: var(--accent-ink); background: var(--accent-wash); font: 750 var(--text-xs) var(--font-mono); }
+
+@media (max-width: 72rem) {
+  .scale-ladder { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .scale-ladder__step::after { display: none !important; }
+  .core-four-grid,
+  .crud-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .fleet-architecture { grid-template-columns: 1fr; }
+  .fleet-architecture__arrow { transform: rotate(90deg); }
+}
+
+@media (max-width: 52rem) {
+  .scale-ladder,
+  .pillar-grid,
+  .core-four-grid,
+  .crud-grid,
+  .practice-grid,
+  .failure-grid,
+  .mastery-grid,
+  .lab-evidence,
+  .piter-map,
+  .agent-contrast,
+  .result-chain,
+  .workflow-map,
+  .cost-board { grid-template-columns: 1fr; }
+  .piter-map__step::after { display: none !important; }
+  .agent-contrast article + article,
+  .result-chain article + article,
+  .workflow-map article + article,
+  .cost-board article + article { border-top: var(--hairline); border-left: 0; }
+  .code-anatomy__notes { grid-template-columns: 1fr; }
+}
+
+@media print {
+  .scale-ladder,
+  .pillar-grid,
+  .fleet-architecture,
+  .piter-map,
+  .core-four-grid,
+  .crud-grid,
+  .agent-contrast,
+  .result-chain,
+  .workflow-map,
+  .code-anatomy,
+  .tool-table,
+  .template-table,
+  .frame-card { break-inside: avoid; }
+  .frame-card img { max-height: 4.25in; object-fit: contain; }
+  .pillar-grid,
+  .practice-grid,
+  .failure-grid,
+  .mastery-grid,
+  .lab-evidence { grid-template-columns: repeat(2, 1fr); }
+}
diff --git a/IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.html b/IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.html
