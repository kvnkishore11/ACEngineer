from html.parser import HTMLParser
from pathlib import Path
import re
p=Path('IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.html'); root=p.parent
class A(HTMLParser):
 def __init__(self):super().__init__();self.ids=[];self.fr=[];self.refs=[];self.text=[];self.skip=0;self.frames=[];self.figures=0;self.details=0
 def handle_starttag(self,t,attrs):
  d=dict(attrs)
  if t in ('script','style'):self.skip+=1
  if t=='figure':self.figures+=1
  if t=='details':self.details+=1
  if 'id'in d:self.ids.append(d['id'])
  for k in ('href','src'):
   if k in d:
    v=d[k]
    if v.startswith('#'):self.fr.append(v[1:])
    elif not re.match(r'"'^(https?:|mailto:|data:|javascript:)'"',v):self.refs.append(v)
  if t=='img' and '/ah-4-multi-agent-orchestration-the-o-agent/' in d.get('src',''):self.frames.append(d['src'])
 def handle_endtag(self,t):
  if t in ('script','style') and self.skip:self.skip-=1
 def handle_data(self,d):
  if not self.skip:self.text.append(d)
a=A();a.feed(p.read_text())
words=re.findall(r\"[A-Za-z0-9][A-Za-z0-9’'&+./:-]*\",' '.join(a.text))
print('visible_words',len(words))
print('source_words',len(re.findall(r'\\S+',p.read_text())))
print('ids',len(a.ids),'duplicates',sorted({x for x in a.ids if a.ids.count(x)>1}))
print('fragments',len(a.fr),'missing',sorted(set(a.fr)-set(a.ids)))
print('local_refs',len(set(a.refs)),'missing',[x for x in sorted(set(a.refs)) if not (root/x).resolve().exists()])
print('details',a.details,'figures',a.figures,'frame_uses',len(a.frames),'unique_frames',len(set(a.frames)))
print('cycles',p.read_text().count('class=\"chapter-section idea-cycle\"'))
for c in ['hook','picture','story','name','example','try','fail','current','check','teach']:
 print(c,p.read_text().count(f'move--{c}'))
