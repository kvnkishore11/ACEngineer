   522	      </footer>
   523	    </main>
   524	  </div>
   525	
   526	  <script>
   527	    (() => {
   528	      const topBar = document.getElementById('top-progress');
   529	      const railBar = document.getElementById('rail-progress');
   530	      const label = document.getElementById('progress-label');
   531	      const links = [...document.querySelectorAll('.chapter-nav a')];
   532	      const sections = links.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
   533	      let progressFramePending = false;
   534	
   535	      const updateProgress = () => {
   536	        const max = document.documentElement.scrollHeight - window.innerHeight;
   537	        const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
   538	        const percent = `${Math.round(value * 100)}%`;
   539	        if (topBar) topBar.style.width = percent;
   540	        if (railBar) railBar.style.width = percent;
   541	        if (label) label.textContent = percent;
   542	      };
   543	
   544	      const requestProgressUpdate = () => {
   545	        if (progressFramePending) return;
   546	        progressFramePending = true;
   547	        requestAnimationFrame(() => {
   548	          updateProgress();
   549	          progressFramePending = false;
   550	        });
   551	      };
   552	
   553	      if ('IntersectionObserver' in window) {
   554	        const observer = new IntersectionObserver(entries => {
   555	          const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
   556	          if (!visible) return;
   557	          links.forEach(link => {
   558	            const active = link.getAttribute('href') === `#${visible.target.id}`;
   559	            if (active) link.setAttribute('aria-current', 'location');
   560	            else link.removeAttribute('aria-current');
   561	          });
   562	        }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, .1, .5] });
   563	        sections.forEach(section => observer.observe(section));
   564	      }
   565	
   566	      updateProgress();
   567	      window.addEventListener('scroll', requestProgressUpdate, { passive: true });
   568	      window.addEventListener('resize', requestProgressUpdate);
   569	    })();
   570	  </script>
   571	    </main>
   572	  </div>
   573	</body>
   574	</html>

diff --git a/IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.assets.css b/IndyDevDan/book/vol-2-ah/12-multi-agent-orchestration-the-o-agent.assets.css
