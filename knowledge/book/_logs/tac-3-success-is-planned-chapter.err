+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="A teaching-first companion to TAC-3: Success is Planned. Turn plans into executable prompts, templates into engineering systems, and fresh agents into repeatable workflows.">
+  <title>TAC-3 · Success is Planned — IndyDevDan Expert Book</title>
+  <link rel="stylesheet" href="../design/tokens.css">
+  <link rel="stylesheet" href="../design/base.css">
+  <link rel="stylesheet" href="../design/components.css">
+  <link rel="stylesheet" href="03-success-is-planned.assets.css">
+</head>
