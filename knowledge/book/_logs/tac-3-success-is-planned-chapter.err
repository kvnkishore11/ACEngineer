+/* TAC-3 chapter layout. Shared colors and type live in ../design/tokens.css. */
+.reading-progress{position:fixed;inset:0 0 auto;z-index:50;height:3px;background:var(--border-soft)}
+.skip-link{position:fixed;top:.5rem;left:.5rem;z-index:100;transform:translateY(-180%);padding:.55rem .8rem;border-radius:var(--radius-sm);background:var(--ink);color:var(--bg);font-weight:800}.skip-link:focus{transform:translateY(0)}
+.reading-progress__bar{display:block;width:0;height:100%;background:var(--accent)}
+.site-bar{position:sticky;top:0;z-index:40;display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);min-height:3.25rem;padding:.65rem clamp(1rem,3vw,2rem);background:color-mix(in srgb,var(--bg) 92%,transparent);border-bottom:var(--hairline);backdrop-filter:blur(14px)}
+.site-bar__home{font-size:var(--text-sm);font-weight:700;text-decoration:none}.site-bar__meta,.micro-label,.eyebrow,.rail-kicker{font-size:var(--text-xs);font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute)}
+.chapter-shell{display:grid;grid-template-columns:minmax(15rem,19rem) minmax(0,1fr);max-width:96rem;margin-inline:auto}
+.chapter-rail{position:sticky;top:3.25rem;align-self:start;height:calc(100vh - 3.25rem);overflow:auto;padding:var(--space-6) var(--space-5);border-right:var(--hairline);background:var(--bg)}
+.chapter-rail h2{margin-top:var(--space-2);font-size:var(--text-md)}
+.rail-progress{margin-top:var(--space-5);padding-bottom:var(--space-5);border-bottom:var(--hairline)}
+.rail-progress__line{height:5px;margin-top:var(--space-2);overflow:hidden;border-radius:999px;background:var(--bg-inset)}
+.rail-progress__fill{display:block;width:0;height:100%;background:var(--accent)}
+.rail-progress__copy{display:flex;justify-content:space-between;margin-top:var(--space-2);font-size:var(--text-xs);color:var(--ink-mute)}
