from html.parser import HTMLParser
from pathlib import Path
from collections import Counter
p=Path('IndyDevDan/book/vol-1-tac/03-success-is-planned.html')
class H(HTMLParser):
 def __init__(self): super().__init__(); self.skip=0; self.w=[]; self.ids=[]; self.refs=[]; self.moves=[]
 def handle_starttag(self,t,a):
  d=dict(a); self.skip += t in ('script','style')
  if 'id' in d:self.ids.append(d['id'])
  if t in ('a','link') and 'href' in d:self.refs.append(d['href'])
  if t=='img':self.refs.append(d.get('src',''))
  if d.get('class','').startswith('move '):self.moves.append(d['class'].split()[1])
 def handle_endtag(self,t): self.skip -= (t in ('script','style') and self.skip>0)
 def handle_data(self,d):
  if not self.skip:self.w += d.split()
h=H();h.feed(p.read_text());
miss=[x for x in h.refs if x and not x.startswith(('#','http:','https:','mailto:')) and not (p.parent/x.split('#')[0]).resolve().exists()]
print({'words':len(h.w),'dupe_ids':[x for x,n in Counter(h.ids).items() if n>1],'missing':miss,'moves':Counter(h.moves)})
PY
