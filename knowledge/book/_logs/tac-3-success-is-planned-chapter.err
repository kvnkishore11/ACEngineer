+++ b/IndyDevDan/book/vol-1-tac/03-success-is-planned.assets.css
@@ -0,0 +1,156 @@
+/* TAC-3 chapter shell. Shared color/type tokens live in ../design/. */
+:root {
+  --rail-width: 17rem;
+  --chapter-max: 88rem;
+  --step-hook: var(--warn);
+  --step-picture: var(--ink-soft);
+  --step-story: var(--accent);
+  --step-name: var(--ink-soft);
+  --step-example: var(--ok);
+  --step-try: var(--accent);
+  --step-fail: var(--warn);
+  --step-current: var(--ink-soft);
+  --step-check: var(--ok);
+  --step-teach: var(--accent);
+}
+
+html { scroll-behavior: smooth; }
+body {
+  min-width: 20rem;
+  background: radial-gradient(circle at 90% 1%, color-mix(in srgb, var(--accent-wash) 70%, transparent) 0 18rem, transparent 42rem), var(--bg);
+}
+.reading-progress { position:fixed; inset:0 0 auto; z-index:100; height:4px; background:var(--border-soft); }
+.reading-progress__bar { display:block; width:0; height:100%; background:var(--accent); transition:width 80ms linear; }
+.site-bar { position:sticky; top:4px; z-index:90; display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); min-height:3.25rem; padding:var(--space-2) max(var(--space-4),calc((100vw - var(--chapter-max))/2)); border-bottom:var(--hairline); background:color-mix(in srgb,var(--bg) 93%,transparent); backdrop-filter:blur(12px); }
+.site-bar__home { font-size:var(--text-sm); font-weight:750; text-decoration:none; }
+.site-bar__meta { color:var(--ink-mute); font:var(--text-xs) var(--font-mono); }
+.chapter-shell { display:grid; grid-template-columns:var(--rail-width) minmax(0,1fr); gap:var(--space-8); width:min(calc(100% - 2rem),var(--chapter-max)); margin-inline:auto; }
+.chapter-rail { position:sticky; top:4.5rem; align-self:start; max-height:calc(100vh - 5.5rem); padding:var(--space-6) var(--space-4) var(--space-6) 0; overflow:auto; scrollbar-width:thin; }
+.rail-kicker,.eyebrow,.move-label,.micro-label { color:var(--accent-ink); font-size:var(--text-xs); font-weight:750; letter-spacing:.09em; text-transform:uppercase; }
+.chapter-rail h2 { margin-top:var(--space-2); font-family:var(--font-body); font-size:var(--text-md); }
+.rail-progress { margin-top:var(--space-4); padding-bottom:var(--space-4); border-bottom:var(--hairline); }
+.rail-progress__line { height:.45rem; margin-top:var(--space-2); overflow:hidden; border-radius:999px; background:var(--bg-inset); }
+.rail-progress__fill { display:block; width:0; height:100%; border-radius:inherit; background:var(--accent); }
+.rail-progress__copy { display:flex; justify-content:space-between; margin-top:var(--space-2); color:var(--ink-mute); font-size:var(--text-xs); }
+.chapter-nav { margin-top:var(--space-4); }
+.chapter-nav ol { padding:0; list-style:none; }
+.chapter-nav li+li { margin-top:var(--space-1); }
+.chapter-nav a { display:grid; grid-template-columns:1.5rem 1fr; gap:var(--space-2); padding:.38rem .45rem; border-radius:var(--radius-sm); color:var(--ink-soft); font-size:var(--text-sm); line-height:1.3; text-decoration:none; }
+.chapter-nav a:hover,.chapter-nav a[aria-current="location"] { color:var(--accent-ink); background:var(--accent-wash); }
+.chapter-nav__n { color:var(--ink-mute); font:var(--text-xs) var(--font-mono); }
+.chapter-main { min-width:0; padding-bottom:var(--space-12); }
+.hero { position:relative; margin:var(--space-8) 0 var(--space-10); padding:clamp(1.5rem,5vw,4.5rem); overflow:hidden; border:var(--hairline); border-radius:1.5rem; background:var(--bg-card); box-shadow:var(--shadow-card); }
+.hero::after { position:absolute; right:-8rem; bottom:-11rem; width:25rem; height:25rem; border:5rem solid var(--accent-wash); border-radius:50%; content:""; }
+.hero__chapter { position:relative; z-index:1; display:inline-flex; padding:.25rem .65rem; border:1px solid var(--accent); border-radius:999px; color:var(--accent-ink); font-size:var(--text-xs); font-weight:750; letter-spacing:.08em; text-transform:uppercase; }
+.hero h1 { position:relative; z-index:1; max-width:11ch; margin-top:var(--space-4); font-size:clamp(3rem,8vw,6.7rem); line-height:.92; }
+.hero__dek { position:relative; z-index:1; max-width:52ch; margin-top:var(--space-5); color:var(--ink-soft); font:clamp(1.2rem,2.5vw,1.65rem)/1.35 var(--font-display); }
+.hero__meta { position:relative; z-index:1; display:flex; flex-wrap:wrap; gap:var(--space-2); margin-top:var(--space-6); padding:0; list-style:none; }
+.hero__meta li { padding:.3rem .7rem; border-radius:999px; color:var(--ink-soft); background:var(--bg-inset); font-size:var(--text-sm); }
+.hero__promise { position:relative; z-index:1; max-width:48rem; margin-top:var(--space-6); padding-top:var(--space-4); border-top:var(--hairline); }
+.mobile-toc { display:none; margin:0 var(--space-4) var(--space-6); }
+.mobile-toc details { padding:var(--space-3); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.mobile-toc summary { cursor:pointer; font-weight:750; }
+.chapter-section { max-width:var(--content-max); margin-inline:auto; padding:var(--space-10) var(--space-4) 0; scroll-margin-top:5.5rem; }
+.chapter-section--wide { max-width:var(--wide-max); }
+.section-number { display:inline-grid; place-items:center; width:2.4rem; height:2.4rem; border:1px solid var(--accent); border-radius:50%; color:var(--accent-ink); font:var(--text-sm) var(--font-mono); }
+.section-title { margin-top:var(--space-3); font-size:clamp(2.1rem,5vw,3.8rem); }
+.section-lead { margin-top:var(--space-4); color:var(--ink-soft); font:var(--text-md)/1.5 var(--font-display); }
+.learning-objectives { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-4); margin-top:var(--space-6); padding:0; list-style:none; }
+.learning-objectives li { padding:var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.learning-objectives strong { display:block; margin-bottom:var(--space-1); color:var(--accent-ink); }
+.idea-cycle { padding-top:var(--space-8); }
+.idea-cycle>.move { margin-top:var(--space-6); padding:clamp(1.1rem,3vw,2rem); border-left:3px solid var(--border); border-radius:0 var(--radius-lg) var(--radius-lg) 0; background:color-mix(in srgb,var(--bg-card) 88%,transparent); }
+.move>h3 { margin-top:var(--space-2); }
+.move--hook { border-left-color:var(--step-hook)!important; }
+.move--story,.move--try,.move--teach { border-left-color:var(--accent)!important; }
+.move--example,.move--check { border-left-color:var(--ok)!important; }
+.move--fail { border-left-color:var(--warn)!important; }
+.move p+*,.move *+p { margin-top:var(--space-3); }
+.frame-card { width:min(100%,1100px); margin:var(--space-6) auto 0; overflow:hidden; border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); box-shadow:var(--shadow-card); }
+.frame-card img { display:block; width:100%; max-height:none; object-fit:contain; background:#111; }
+.frame-card figcaption { padding:var(--space-3) var(--space-4); color:var(--ink-soft); font-size:var(--text-sm); line-height:1.5; }
+.frame-card__t { display:inline-block; margin-right:var(--space-2); padding:.15rem .45rem; border-radius:999px; color:var(--accent-ink); background:var(--accent-wash); font:700 var(--text-xs) var(--font-mono); }
+.diagram { margin-top:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); box-shadow:var(--shadow-card); }
+.diagram__canvas { padding:clamp(1rem,4vw,2.5rem); }
+.ladder { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--space-3); align-items:stretch; }
+.ladder__step { position:relative; padding:var(--space-4); border:1px solid var(--border); border-radius:var(--radius-md); background:var(--bg); }
+.ladder__step:not(:last-child)::after { position:absolute; top:50%; right:-1rem; z-index:2; color:var(--accent); content:"→"; }
+.ladder__step strong { display:block; color:var(--accent-ink); }
+.ladder__step code { display:block; margin-top:var(--space-2); white-space:normal; }
+.diagram figcaption { padding:0 var(--space-4) var(--space-4); color:var(--ink-mute); font-size:var(--text-sm); }
+.comparison { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-4); margin-top:var(--space-5); }
+.comparison__card { overflow:hidden; border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); }
+.comparison__head { padding:var(--space-4); border-bottom:var(--hairline); background:var(--bg-inset); }
+.comparison__body { padding:var(--space-4); }
+.workflow { display:flex; flex-wrap:wrap; gap:var(--space-2); margin-top:var(--space-5); }
+.workflow__step { flex:1 1 9rem; padding:var(--space-3); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.workflow__step strong,.workflow__step code { display:block; }
+.workflow__step code { margin-top:var(--space-1); white-space:normal; }
+.template-anatomy { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:var(--space-2); margin-top:var(--space-5); }
+.template-anatomy div { padding:var(--space-3); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.template-anatomy b { display:block; color:var(--accent-ink); }
+.callout { margin-top:var(--space-5); padding:var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.callout__label { color:var(--accent-ink); font-size:var(--text-xs); font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
+.callout--warning { border-color:color-mix(in srgb,var(--warn) 45%,var(--border)); background:var(--warn-wash); }
+.callout--term { border-color:color-mix(in srgb,var(--accent) 50%,var(--border)); background:var(--accent-wash); }
+.callout--why { border-color:color-mix(in srgb,var(--ok) 45%,var(--border)); background:var(--ok-wash); }
+.current-practice { padding:var(--space-4); border:1px dashed var(--border); border-radius:var(--radius-md); background:var(--bg-inset); }
+.current-practice__label { color:var(--accent-ink); font-size:var(--text-xs); font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
+.current-practice__source { color:var(--ink-mute); font-size:var(--text-sm); }
+.retrieval-quiz { display:grid; gap:var(--space-3); margin-top:var(--space-4); }
+.retrieval-quiz__item { padding:var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.retrieval-quiz__q { font-weight:700; }
+.retrieval-quiz details { margin-top:var(--space-2); }
+.retrieval-quiz summary { cursor:pointer; color:var(--accent-ink); font-weight:700; }
+.teach-back { padding:var(--space-4); border-radius:var(--radius-md); color:var(--ink); background:var(--accent-wash); }
+.fine { color:var(--ink-mute); font-size:var(--text-sm); }
+.file-map { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-3); margin-top:var(--space-5); }
+.file-map__item { padding:var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.file-map__item code { color:var(--accent-ink); font-weight:700; }
+.kpi-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--space-3); margin-top:var(--space-5); }
+.kpi { padding:var(--space-4); border:var(--hairline); border-radius:var(--radius-md); text-align:center; background:var(--bg-card); }
+.kpi b { display:block; font:700 var(--text-xl) var(--font-display); color:var(--accent-ink); }
+.code-caption { margin-top:var(--space-4); color:var(--ink-mute); font-size:var(--text-sm); }
+pre { overflow:auto; }
+pre code { font-size:.86rem; line-height:1.55; }
+.lab-box { margin-top:var(--space-6); padding:clamp(1rem,3vw,2rem); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); box-shadow:var(--shadow-card); }
+.lab-box__title { margin-top:0; }
+.lab-box__meta { display:flex; flex-wrap:wrap; gap:var(--space-2); margin:var(--space-3) 0; padding:0; list-style:none; }
+.lab-box__meta li { padding:.2rem .55rem; border-radius:999px; background:var(--bg-inset); color:var(--ink-soft); font-size:var(--text-xs); }
+.lab-box__steps>li+li { margin-top:var(--space-3); }
+.checkpoint { margin-top:var(--space-5); padding:var(--space-4); border-left:4px solid var(--accent); background:var(--accent-wash); }
+.lab-box__pass { margin-top:var(--space-5); padding:var(--space-4); border-radius:var(--radius-md); background:var(--ok-wash); }
+.mastery-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-4); margin-top:var(--space-5); }
+.mastery-card { padding:var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
+.glossary { display:grid; grid-template-columns:minmax(10rem,.4fr) minmax(0,1fr); gap:0; margin-top:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); overflow:hidden; }
+.glossary dt,.glossary dd { margin:0; padding:var(--space-3) var(--space-4); border-bottom:var(--hairline); }
+.glossary dt { color:var(--accent-ink); font-weight:750; background:var(--bg-inset); }
+.chapter-footer { max-width:var(--wide-max); margin:var(--space-12) auto 0; padding:var(--space-6) var(--space-4); border-top:var(--hairline); }
+.chapter-footer__nav { display:flex; justify-content:space-between; gap:var(--space-4); }
+.chapter-footer a { font-weight:750; text-decoration:none; }
+
+@media (max-width:72rem) {
+  .chapter-shell { grid-template-columns:1fr; width:100%; }
+  .chapter-rail { display:none; }
+  .mobile-toc { display:block; }
+  .hero { margin-inline:var(--space-4); }
+}
+@media (max-width:48rem) {
+  .site-bar__meta { display:none; }
+  .learning-objectives,.comparison,.file-map,.mastery-grid { grid-template-columns:1fr; }
+  .ladder,.template-anatomy,.kpi-grid { grid-template-columns:1fr 1fr; }
+  .ladder__step::after { display:none; }
+  .glossary { grid-template-columns:1fr; }
+  .glossary dd { border-bottom:var(--hairline); }
+  .chapter-footer__nav { flex-direction:column; }
+}
+@media (max-width:32rem) { .ladder,.template-anatomy,.kpi-grid { grid-template-columns:1fr; } }
+@media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } * { transition:none!important; } }
+@media print {
+  .reading-progress,.site-bar,.chapter-rail,.mobile-toc { display:none!important; }
+  .chapter-shell { display:block; width:100%; }
+  .chapter-section { max-width:none; break-before:page; }
+  .move,.frame-card,.lab-box,.retrieval-quiz__item { break-inside:avoid; box-shadow:none; }
+  details { display:block; }
+  details>* { display:block; }
+}
diff --git a/IndyDevDan/book/vol-1-tac/03-success-is-planned.html b/IndyDevDan/book/vol-1-tac/03-success-is-planned.html
