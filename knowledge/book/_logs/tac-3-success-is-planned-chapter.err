from html.parser import HTMLParser
from pathlib import Path
from collections import Counter
p=Path('IndyDevDan/book/vol-1-tac/03-success-is-planned.html')
class H(HTMLParser):
 def __init__(self): super().__init__();self.skip=0;self.words=[];self.ids=[];self.refs=[];self.img=[];self.moves=[];self.styles=[]
 def handle_starttag(self,t,a):
  d=dict(a)
  if t in ('script','style'):self.skip+=1
  if 'id' in d:self.ids.append(d['id'])
  if 'style' in d:self.styles.append((t,d['style']))
  if t in ('a','link') and 'href' in d:self.refs.append(d['href'])
  if t=='img':self.img.append(d);self.refs.append(d.get('src',''))
  c=d.get('class','')
  if c.startswith('move '):self.moves.append(c.split()[1])
 def handle_endtag(self,t):
  if t in ('script','style') and self.skip:self.skip-=1
 def handle_data(self,d):
  if not self.skip:self.words.extend(d.split())
h=H();h.feed(p.read_text())
missing=[]
for x in h.refs:
 if x and not x.startswith(('#','http:','https:','mailto:')) and not (p.parent/x.split('#')[0]).resolve().exists():missing.append(x)
frags=[x for x in h.refs if x.startswith('#') and x[1:] not in h.ids]
print('visible_words',len(h.words));print('duplicates',[x for x,n in Counter(h.ids).items() if n>1]);print('missing_local',missing);print('missing_fragments',frags);print('inline_styles',h.styles);print('moves',dict(sorted(Counter(h.moves).items())));print('images',len(h.img),len({x['src'] for x in h.img}));print('bad_images',[x for x in h.img if not all(x.get(k) for k in ('src','alt','width','height'))])
PY
