import re
from html.parser import HTMLParser
from pathlib import Path
from collections import Counter
class P(HTMLParser):
 def __init__(self):super().__init__();self.ids=[];self.href=[];self.src=[];self.css=[];self.skip=0;self.words=0
 def handle_starttag(self,t,a):
  d=dict(a)
  if 'id' in d:self.ids.append(d['id'])
  if t=='a' and 'href' in d:self.href.append(d['href'])
  if t=='img' and 'src' in d:self.src.append(d['src'])
  if t=='link' and 'href' in d:self.css.append(d['href'])
  if t in ('script','style'):self.skip+=1
 def handle_endtag(self,t):
  if t in ('script','style') and self.skip:self.skip-=1
 def handle_data(self,d):
  if not self.skip:self.words+=len(d.split())
f=Path('IndyDevDan/book/vol-1-tac/03-success-is-planned.html');s=f.read_text();p=P();p.feed(s);base=f.parent
missing=[]
for x in p.src+p.css+[h for h in p.href if not h.startswith(('#','http:','https:','mailto:'))]:
 if not (base/x).resolve().exists():missing.append(x)
rail=re.findall(r'href=\"#(["'^"]+)"'"',re.search(r'<nav class=\"chapter-nav\".*?</nav>',s,re.S).group())
mobile=re.findall(r'href=\"#(["'^"]+)"'"',re.search(r'<div class=\"mobile-toc\">.*?</div>',s,re.S).group())
print({'words':p.words,'duplicate_ids':[x for x,n in Counter(p.ids).items() if n>1],'bad_fragments':[h for h in p.href if h.startswith('#') and h[1:] not in p.ids],'missing_local':missing,'toc_equal':rail==mobile,'toc_count':len(rail),'unique_images':len(set(p.src)),'image_uses':len(p.src),'details':s.count('<details'),'yt_links':len(re.findall(r'youtube\\\\.com/watch',s))})
for c in 'hook picture story name example try fail current check teach'.split():
 print('move',c,len(re.findall(fr'class=\"move move--{c}\"',s)))
