+.frame-card{width:min(100%,1100px);max-width:min(100%,1100px);margin:var(--space-5) auto var(--space-6)}.frame-card img{width:100%;height:auto;max-height:78vh;object-fit:contain;background:var(--bg-card);border-radius:0}.frame-card figcaption{max-width:88ch;margin:0 auto;padding:var(--space-3) var(--space-4);font-size:.95rem;line-height:1.5;color:var(--ink-mute)}
