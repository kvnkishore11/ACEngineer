      "app/server/ (FastAPI + uv: server.py, main.py, pyproject.toml, core/{data_models,file_processor,llm_processor,sql_processor,insights}.py, tests/core/{test_file_processor,test_llm_processor,test_sql_processor}.py + assets)",
