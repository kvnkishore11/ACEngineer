+.diagram{width:min(100%,1100px);max-width:1100px;margin:var(--space-5) auto}.diagram__canvas{padding:clamp(1rem,4vw,2.5rem)}
+.ladder{display:grid;grid-template-columns:repeat(5,1fr);gap:var(--space-3);align-items:stretch}.ladder__step{position:relative;display:flex;flex-direction:column;justify-content:space-between;min-height:10rem;padding:var(--space-4);border:var(--hairline);border-radius:var(--radius-md);background:var(--bg-card)}.ladder__step:not(:last-child)::after{content:"→";position:absolute;right:-1.05rem;top:42%;z-index:2;color:var(--accent);font-weight:900}.ladder__n{font-family:var(--font-mono);font-size:var(--text-xs);color:var(--accent-ink)}.ladder__step strong{font-family:var(--font-display);font-size:var(--text-md)}.ladder__step small{color:var(--ink-mute);line-height:1.4}
+.template-anatomy{display:grid;grid-template-columns:repeat(5,1fr);gap:var(--space-3)}.template-anatomy article,.phase-card,.kpi-card{padding:var(--space-4);border:var(--hairline);border-radius:var(--radius-md);background:var(--bg-card)}.template-anatomy b{display:block;margin-bottom:var(--space-2);color:var(--accent-ink)}
+.phase-flow{display:grid;grid-template-columns:1fr auto 1fr;gap:var(--space-4);align-items:center}.phase-card{min-height:13rem}.phase-card__tag{font-family:var(--font-mono);font-size:var(--text-xs);color:var(--accent-ink)}.phase-card h4{margin-top:var(--space-2)}.phase-card ul{margin-top:var(--space-3)}.phase-flow__arrow{font-size:2.5rem;color:var(--accent)}
+.diagram-result{margin-top:var(--space-4);text-align:center}
+.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3)}.kpi-card{text-align:center}.kpi-card strong{display:block;font-family:var(--font-display);font-size:var(--text-lg)}.kpi-card span{color:var(--ink-mute);font-size:var(--text-sm)}
+.comparison{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-4);margin-top:var(--space-4)}.comparison__card{overflow:hidden;border:var(--hairline);border-radius:var(--radius-md);background:var(--bg-card)}.comparison__head,.comparison__body{padding:var(--space-4)}.comparison__head{background:var(--bg-inset)}.comparison__head h3{margin:0;font-size:var(--text-md)}.comparison__body>*+*{margin-top:var(--space-3)}
+.file-map{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-3);margin-top:var(--space-4)}.file-map__item{padding:var(--space-4);border:var(--hairline);border-radius:var(--radius-md);background:var(--bg-card)}.file-map__item p{margin-top:var(--space-2);font-size:var(--text-sm);color:var(--ink-soft)}
+.terminal{overflow:hidden;margin-top:var(--space-4);border:1px solid var(--terminal-border);border-radius:var(--radius-md);background:var(--terminal-bg);color:var(--terminal-ink);box-shadow:var(--shadow-card)}.terminal__bar{padding:.55rem 1rem;background:var(--terminal-bar);font-family:var(--font-mono);font-size:var(--text-xs);color:var(--terminal-dot)}.terminal pre{margin:0;border:0;border-radius:0;background:transparent;color:inherit}.terminal code{color:inherit}
+.learning-objectives{display:grid;gap:var(--space-2);padding:0;list-style:none}.learning-objectives li{padding:var(--space-3) var(--space-4);border-left:3px solid var(--border);background:var(--bg-card)}.learning-objectives strong{display:inline-block;min-width:7rem;color:var(--accent-ink)}
+.checkpoint,.teach-back{padding:var(--space-5);border:var(--hairline);border-radius:var(--radius-md);background:var(--bg-card)}.checkpoint{border-left:4px solid var(--accent)}.checkpoint h4,.teach-back h4{margin-top:0}.teach-back{background:var(--teach-wash)}
+.retrieval-quiz,.callout,.current-practice,.checkpoint,.teach-back{margin-top:var(--space-4)}
+.video-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-3);margin-top:var(--space-4)}.video-card{display:flex;flex-direction:column;min-height:11rem;padding:var(--space-4);border:var(--hairline);border-radius:var(--radius-md);background:var(--bg-card);text-decoration:none}.video-card__type{font-size:var(--text-xs);font-weight:800;text-transform:uppercase;letter-spacing:.08em}.video-card strong{margin-top:var(--space-2);color:var(--ink);font-family:var(--font-display);font-size:var(--text-md)}.video-card p{margin-top:var(--space-2);color:var(--ink-soft);font-size:var(--text-sm)}.video-card__watch{margin-top:auto;padding-top:var(--space-4);color:var(--accent-ink);font-weight:700}
+.lab-box{margin-top:var(--space-5)}.lab-box>*+*{margin-top:var(--space-3)}.lab-box__steps li+li{margin-top:var(--space-3)}.lab-box table{margin-top:var(--space-4);background:var(--bg-card)}
