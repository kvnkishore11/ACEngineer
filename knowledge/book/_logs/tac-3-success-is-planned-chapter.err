/bin/zsh -lc "ls -la IndyDevDan/book/vol-1-tac | sed -n '1,120p'; jq '.courses? // . | type' IndyDevDan/book/data/curriculum.json 2>/dev/null; rg -n 'tac-3|success-is-planned|\"status\"|chapter_html' IndyDevDan/book/data/curriculum.json | sed -n '1,100p'; python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
from collections import Counter
p=Path('IndyDevDan/book/vol-1-tac/03-success-is-planned.html')
class H(HTMLParser):
 def __init__(self): super().__init__(); self.ids=[]; self.hrefs=[]; self.srcs=[]; self.text=[]; self.moves=[]; self.sections=[]; self.stack=[]; self.skip=0
 def handle_starttag(self,t,a):
  d=dict(a)
  if t in ('script','style'): self.skip += 1
  if 'id' in d:self.ids.append(d['id'])
  if t=='a' and 'href' in d:self.hrefs.append(d['href'])
  if t=='img' and 'src' in d:self.srcs.append(d['src'])
  if t=='section' and 'class' in d:self.sections.append(d['class'])
  if 'class' in d and 'move ' in (' '+d['class']+' '): self.moves.append(d['class'])
 def handle_endtag(self,t):
  if t in ('script','style') and self.skip:self.skip-=1
 def handle_data(self,d):
  if not self.skip:self.text.append(d)
h=H();h.feed(p.read_text())
text=' '.join(h.text)
print('visible_words',len(text.split()))
print('ids',len(h.ids),'duplicate_ids',[x for x,n in Counter(h.ids).items() if n>1])
print('moves',len(h.moves),Counter(x.split()[1] for x in h.moves))
print('idea_cycles',sum('idea-cycle' in x for x in h.sections))
base=p.parent
missing=[]
for x in h.srcs+[u for u in h.hrefs if not u.startswith(('#','http','mailto:'))]:
 target=(base/x.split('#')[0]).resolve()
 if not target.exists(): missing.append((x,str(target)))
print('missing_local',missing)
missing_frag=[x for x in h.hrefs if x.startswith('#') and x[1:] not in h.ids]
print('missing_fragments',missing_frag)
print('images',len(h.srcs),len(set(h.srcs)))
