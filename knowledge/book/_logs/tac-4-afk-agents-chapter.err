index 0000000000000000000000000000000000000000..edfd94ececc4892c0633f6f4714a8c48b75ab436
--- /dev/null
+++ b/IndyDevDan/book/vol-1-tac/04-afk-agents.assets.css
@@ -0,0 +1,214 @@
+/* TAC-4 reuses the gold chapter grammar and adds AFK-specific system diagrams. */
+@import url("01-hello-agentic-coding.assets.css");
+
+:root {
+  --step-system: #315f78;
+}
+
+.hero--afk {
+  background:
+    linear-gradient(145deg, color-mix(in srgb, var(--bg-card) 92%, var(--accent-wash)), var(--bg-card));
+}
+
+.hero--afk .generated-plate--hero {
+  width: min(62rem, 100%);
+}
+
+.hero--afk .generated-plate--hero img {
+  aspect-ratio: 16 / 10;
+  object-fit: contain;
+}
+
+.loop-router,
+.piter-map,
+.layer-map,
+.telemetry-stack,
+.trust-ladder {
+  display: grid;
+  gap: var(--space-3);
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.loop-router {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.loop-router article,
+.piter-map article,
+.telemetry-stack article,
+.trust-ladder article {
+  padding: var(--space-4);
+  border: 1px solid var(--border-soft);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.loop-router article:last-child {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.loop-router h4,
+.piter-map h4,
+.telemetry-stack h4,
+.trust-ladder h4 {
+  margin: 0 0 var(--space-2);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+}
+
+.piter-map {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.piter-map article {
+  position: relative;
+  min-height: 12rem;
+  padding-top: 4.25rem;
+}
+
+.piter-map article::before {
+  position: absolute;
+  top: var(--space-4);
+  left: var(--space-4);
+  display: grid;
+  place-items: center;
+  width: 2.8rem;
+  height: 2.8rem;
+  border: 2px solid var(--accent);
+  border-radius: 50%;
+  color: var(--accent-ink);
+  background: var(--bg-card);
+  content: attr(data-letter);
+  font: 800 var(--text-md) var(--font-display);
+}
+
+.piter-map code {
+  display: block;
+  margin-top: var(--space-2);
+  font-size: var(--text-xs);
+}
+
+.adw-flow {
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+}
+
+.layer-map {
+  place-items: center;
+  min-height: 26rem;
+  background: color-mix(in srgb, var(--bg-card) 75%, var(--accent-wash));
+}
+
+.layer-map__surface,
+.layer-map__agentic,
+.layer-map__app {
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  text-align: center;
+}
+
+.layer-map__surface {
+  width: min(100%, 38rem);
+  aspect-ratio: 2 / 1;
+  border: 2px solid var(--accent);
+  background: var(--accent-wash);
+}
+
+.layer-map__agentic {
+  width: 72%;
+  height: 72%;
+  border: 2px dashed var(--step-system);
+  background: var(--bg-card);
+}
+
+.layer-map__app {
+  width: 58%;
+  height: 58%;
+  border: var(--hairline);
+  background: var(--bg-inset);
+  font-weight: 750;
+}
+
+.layer-map small { display: block; color: var(--ink-mute); font-weight: 500; }
+
+.contract-table {
+  width: 100%;
+  border-collapse: collapse;
+  border: var(--hairline);
+  background: var(--bg-card);
+}
+
+.contract-table th,
+.contract-table td {
+  padding: var(--space-3);
+  border-bottom: var(--hairline);
+  text-align: left;
+  vertical-align: top;
+}
+
+.contract-table th {
+  color: var(--accent-ink);
+  background: var(--accent-wash);
+  font-size: var(--text-sm);
+}
+
+.telemetry-stack {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.telemetry-stack article { border-top: 4px solid var(--accent); }
+
+.trust-ladder {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  align-items: end;
+}
+
+.trust-ladder article:nth-child(2) { min-height: 11rem; }
+.trust-ladder article:nth-child(3) { min-height: 14rem; border-color: var(--accent); }
+
+.evidence-list li + li { margin-top: var(--space-2); }
+
+.rubric {
+  display: grid;
+  grid-template-columns: 1.2fr repeat(3, minmax(8rem, .7fr));
+  margin-top: var(--space-5);
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.rubric > div {
+  padding: var(--space-3);
+  border-right: var(--hairline);
+  border-bottom: var(--hairline);
+}
+
+.rubric__head { color: var(--accent-ink); background: var(--accent-wash); font-weight: 750; }
+
+@media (max-width: 58rem) {
+  .piter-map,
+  .telemetry-stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .adw-flow { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 46rem) {
+  .loop-router,
+  .piter-map,
+  .telemetry-stack,
+  .trust-ladder { grid-template-columns: 1fr; }
+  .rubric { grid-template-columns: 1fr; }
+  .rubric > div { border-right: 0; }
+}
+
+@media print {
+  .piter-map,
+  .telemetry-stack { grid-template-columns: repeat(2, 1fr); }
+  .loop-router,
+  .trust-ladder { break-inside: avoid; }
+}
