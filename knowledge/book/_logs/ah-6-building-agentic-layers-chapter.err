  <link rel="stylesheet" href="design/tokens.css">
  <link rel="stylesheet" href="design/base.css">
  <link rel="stylesheet" href="design/components.css">
  <style>
    body { background: radial-gradient(circle at 88% 0, var(--accent-wash), transparent 32rem), var(--bg); }
    .hub { width: min(calc(100% - 2rem), 70rem); margin-inline: auto; padding: var(--space-6) 0 var(--space-12); }
    .masthead { display:flex; justify-content:space-between; align-items:center; gap:var(--space-4); padding-bottom:var(--space-4); border-bottom:var(--hairline); }
    .brand { color:var(--ink); font-weight:750; text-decoration:none; }
    .edition { color:var(--ink-mute); font:var(--text-xs) var(--font-mono); }
    .hero { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(18rem,.8fr); gap:var(--space-8); align-items:end; padding:var(--space-10) 0; }
    .eyebrow { color:var(--accent-ink); font-size:var(--text-xs); font-weight:750; letter-spacing:.09em; text-transform:uppercase; }
    .hero h1 { margin-top:var(--space-3); font-size:clamp(3rem,8vw,6.4rem); line-height:.92; max-width:10ch; }
    .hero__dek { margin-top:var(--space-5); color:var(--ink-soft); font:var(--text-md)/1.5 var(--font-display); max-width:48ch; }
    .progress-card { padding:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); box-shadow:var(--shadow-card); }
    .progress-card h2 { margin:var(--space-2) 0 0; font-size:var(--text-lg); }
    .progress-line { height:.7rem; margin:var(--space-4) 0 var(--space-2); overflow:hidden; border-radius:99px; background:var(--bg-inset); }
    .progress-line span { display:block; width:66.67%; height:100%; border-radius:inherit; background:var(--accent); }
    .progress-copy { display:flex; justify-content:space-between; color:var(--ink-mute); font-size:var(--text-sm); }
    .chapter-feature { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(18rem,.8fr); overflow:hidden; border:1px solid var(--accent); border-radius:1.25rem; background:var(--bg-card); box-shadow:var(--shadow-card); }
    .chapter-feature__copy { padding:clamp(1.5rem,4vw,3.5rem); }
    .chapter-feature h2 { margin-top:var(--space-3); font-size:clamp(2rem,4vw,3.5rem); }
    .chapter-feature__dek { margin-top:var(--space-3); color:var(--ink-soft); font-size:var(--text-md); }
    .chapter-feature__meta { display:flex; flex-wrap:wrap; gap:var(--space-2); margin:var(--space-5) 0 0; padding:0; list-style:none; }
    .chapter-feature__meta li { padding:.25rem .6rem; border-radius:99px; color:var(--ink-soft); background:var(--bg-inset); font-size:var(--text-sm); }
    .button { display:inline-flex; margin-top:var(--space-5); padding:.75rem 1rem; border-radius:var(--radius-md); color:var(--ink-inverse); background:var(--accent); font-weight:750; text-decoration:none; }
    .button:hover { color:var(--ink-inverse); background:var(--accent-ink); }
    .chapter-feature__map { display:grid; place-items:center; min-height:23rem; padding:var(--space-5); background:var(--accent-wash); }
    .focus-three { display:grid; gap:var(--space-3); width:min(100%,24rem); }
    .focus-three div { padding:var(--space-4); border:2px solid var(--accent); border-radius:var(--radius-lg); color:var(--accent-ink); background:color-mix(in srgb,var(--bg-card) 76%,transparent); font:650 var(--text-md) var(--font-display); text-align:center; }
    .rd-map { display:grid; grid-template-columns:repeat(2,1fr); gap:var(--space-3); width:min(100%,24rem); }
    .rd-map div { display:grid; place-items:center; min-height:11rem; padding:var(--space-4); border:2px solid var(--accent); border-radius:var(--radius-lg); color:var(--accent-ink); background:color-mix(in srgb,var(--bg-card) 76%,transparent); text-align:center; }
    .rd-map b { display:block; font:700 var(--text-3xl)/1 var(--font-display); }
    .rd-map span { display:block; margin-top:var(--space-2); font-weight:750; }
    .rd-map div:nth-child(2) { border-color:var(--ok); color:var(--ok); }
    .section { margin-top:var(--space-10); }
    .section-head { display:flex; justify-content:space-between; align-items:end; gap:var(--space-4); padding-bottom:var(--space-3); border-bottom:var(--hairline); }
    .section-head h2 { margin:0; }
    .section-head p { color:var(--ink-mute); font-size:var(--text-sm); }
    .lesson-list { display:grid; gap:var(--space-2); margin-top:var(--space-4); }
    .lesson { display:grid; grid-template-columns:3rem minmax(0,1fr) auto; gap:var(--space-3); align-items:center; padding:var(--space-3) var(--space-4); border:var(--hairline); border-radius:var(--radius-md); background:var(--bg-card); }
    .lesson__n { color:var(--ink-mute); font:var(--text-sm) var(--font-mono); }
    .lesson strong { display:block; }
    .lesson p { color:var(--ink-mute); font-size:var(--text-sm); }
    .badge { padding:.2rem .55rem; border-radius:99px; font-size:var(--text-xs); font-weight:750; text-transform:uppercase; letter-spacing:.06em; }
    .badge--done { color:var(--ok); background:var(--ok-wash); }
    .badge--pending { color:var(--ink-mute); background:var(--bg-inset); }
    .volumes { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--space-4); margin-top:var(--space-4); }
    .volume-card { padding:var(--space-5); border:var(--hairline); border-radius:var(--radius-lg); background:var(--bg-card); }
    .volume-card h3 { margin-top:var(--space-2); }
    .volume-card p { margin-top:var(--space-3); color:var(--ink-soft); }
    .hub-footer { display:flex; justify-content:space-between; gap:var(--space-4); margin-top:var(--space-10); padding-top:var(--space-5); border-top:var(--hairline); color:var(--ink-mute); font-size:var(--text-sm); }
    @media (max-width:48rem) { .hero,.chapter-feature { grid-template-columns:1fr; } .chapter-feature__map { min-height:18rem; } .volumes { grid-template-columns:1fr; } .lesson { grid-template-columns:2rem minmax(0,1fr); } .lesson .badge { grid-column:2; justify-self:start; } }
  </style>
</head>
<body>
  <main class="hub">
    <header class="masthead">
      <a class="brand" href="index.html">IndyDevDan Expert Book</a>
      <span class="edition">GOLD PILOT · 2026</span>
    </header>

    <section class="hero">
      <div>
        <p class="eyebrow">Operate · retrieve · teach back</p>
        <h1>Build systems that build systems.</h1>
        <p class="hero__dek">A dense, teaching-first companion to IndyDevDan’s course system. Each chapter turns the video spine into mental models, worked codebase examples, failure repairs, retrieval practice, and graded labs.</p>
      </div>
      <aside class="progress-card" aria-label="Book progress">
        <p class="eyebrow">Corpus phase 1</p>
        <h2>12 of 18 chapters built</h2>
        <div class="progress-line" aria-hidden="true"><span></span></div>
        <p class="progress-copy"><span>66.7% complete</span><span>Volume II · 4 of 6</span></p>
      </aside>
    </section>

    <article class="chapter-feature">
      <div class="chapter-feature__copy">
        <p class="eyebrow">Now available · Volume II · Lesson 12</p>
        <h2>Multi-Agent Orchestration: The O-Agent</h2>
        <p class="chapter-feature__dek">Put one thin custom agent in front of a fleet, give it lifecycle tools and observability, then conduct plan → build → review work without becoming the hidden workflow engine.</p>
        <ul class="chapter-feature__meta"><li>Three pillars · O-agent + CRUD + observability</li><li>120–180 min graded lab</li><li>11 full-width course frames</li><li>Plan → build → review</li></ul>
        <a class="button" href="vol-2-ah/12-multi-agent-orchestration-the-o-agent.html">Start chapter →</a>
      </div>
