        adw_id=adw_id,
        status="in_progress",
        current_step=STEP_BUILD,
        completed_steps=1,
    )

    console.print(Panel(
        f"[bold cyan]Step 2: Build[/bold cyan]\n\nPlan: {plan_path}",
        title="ADW Plan-Build Workflow",
