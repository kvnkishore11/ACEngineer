+                <tr><td>C1 G4</td><td><code>.claude/commands/review.md</code>, <code>fix.md</code>, <code>app_review/</code></td><td></td></tr>
+                <tr><td>C1 G5</td><td><code>.claude/commands/plan.md</code> task-type switch</td><td></td></tr>
+                <tr><td>C1 G6</td><td><code>orch_scout_and_build.md</code>, <code>adw_plan_build.py</code></td><td></td></tr>
+                <tr><td>C1 G7</td><td><code>.claude/commands/experts/{adw,database,websocket}/</code></td><td></td></tr>
+                <tr><td>C2 G1</td><td><code>adw_manual_trigger.py</code>, <code>adw_scripts.py</code>, <code>adw_agent_sdk.py</code></td><td></td></tr>
+                <tr><td>C2 G2</td><td><code>adw_plan_build{,_review,_review_fix}.py</code></td><td></td></tr>
+                <tr><td>C3 G1</td><td><code>orchestrator_service.py</code>, <code>agent_manager.py</code></td><td></td></tr>
+                <tr><td>C3 G2</td><td><code>apps/orchestrator_3_stream/.claude/commands/orch_*</code></td><td></td></tr>
+                <tr><td>C3 G3</td><td><code>start_adw</code>/<code>check_adw</code>, <code>AdwSwimlanes.vue</code></td><td></td></tr>
+              </tbody>
+            </table>
+          </div>
+          <div class="lab-box__pass">
+            <h4>Pass criteria</h4>
+            <ul class="checklist">
+              <li>All 12 rows contain a path you personally opened.</li>
+              <li>You identify <code>apps/*</code> as the application layer and root <code>.claude/</code> + <code>adws/</code> as the agentic layer.</li>
+              <li>You name the model choices: fast scout = Haiku, docs scraper = Sonnet, heavy plan/build roles = Opus.</li>
