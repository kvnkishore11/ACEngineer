# ─────────────────────────────────────────────────────────────
# live-bench — root .gitignore
# Covers: Python (backend, cli), Node (frontend), live-bench
# runtime artifacts, secrets, OS scratch, editors, Claude.
# Lockfiles (uv.lock, pnpm-lock.yaml) are NOT ignored — commit them.
# ─────────────────────────────────────────────────────────────

# ── Secrets & env ────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample
*.env
secrets/
*.pem
*.key

# ── Python (apps/backend, apps/cli) ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
develop-eggs/
downloads/
eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtualenvs
.venv/
.venv-*/
.mlx-venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
.dmypy.json
dmypy.json

# Jupyter / notebooks
.ipynb_checkpoints/

# ── Node (apps/frontend) ─────────────────────────────────────
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-integrity
.yarn-cache/
.parcel-cache/
.cache/

# Build outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.svelte-kit/

# Vite
.vite/
vite.config.*.timestamp-*

# Vitest / coverage
coverage/
*.lcov
.nyc_output/

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# ── live-bench runtime artifacts ─────────────────────────────
# SQLite database (created at backend boot)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# CLI client-side outbox (failed POST replays)
.live-bench-outbox.jsonl

# Validation artifacts (regenerated by validate-all)
screenshots/
specs/validation-report.md
.playwright-cli/
playwright-report/
test-results/

# Backend test fixtures (generated by tests/fixtures_export.py)
apps/backend/tests/fixtures/

# Temporary smoke databases
live-bench-smoke.db*
live-bench-cli-smoke.db*
live-bench-frontend-smoke.db*

# ── Editors & IDEs ───────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
.history/
*.swp
*.swo
*.swn
*~

# ── OS scratch ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


images/v1