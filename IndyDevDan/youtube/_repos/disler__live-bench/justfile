# ── pi-coding-agent-3way benchmark (3-way coding agent) ──────────
# 5-way: Qwen 3.6 GGUF/MLX vs Qwen 3.5 GGUF/MLX vs Gemma 4 GGUF, 6 tasks.

bench-pi3-m4 *FLAGS: bench-nuke
    uv run apps/benchmarks/pi-coding-agent-3way/bench.py --hw m4 {{FLAGS}}

