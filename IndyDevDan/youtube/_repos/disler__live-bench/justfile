# ── 3way combined (run all three 3-way benchmarks sequentially) ────
# Runs raw-inference → context-scaling → pi-coding-agent. ADDITIVE —
# emits only to the hardware's chart IDs (*_m4 or *_m5), so running m5
# after m4 (or vice versa) adds bars without wiping the other machine's
# data. Call `just bench-3way-reset` first if you want a clean slate.
# Wall-clock on M4 Max: ~70 min. On M5 Max: expected ~45-55 min.

bench-3way-m4: bench-nuke
    uv run apps/benchmarks/qwen36-vs-qwen35-vs-gemma4/bench.py --hw m4
    uv run apps/benchmarks/context-scaling-3way/bench.py --hw m4
    uv run apps/benchmarks/pi-coding-agent-3way/bench.py --hw m4

bench-3way-m5: bench-nuke
    uv run apps/benchmarks/qwen36-vs-qwen35-vs-gemma4/bench.py --hw m5
    uv run apps/benchmarks/context-scaling-3way/bench.py --hw m5
    uv run apps/benchmarks/pi-coding-agent-3way/bench.py --hw m5

# Wipe all three 3-way sessions (both M4 and M5 data across all charts).
bench-3way-reset: bench-qg3-reset bench-ctx3-reset bench-pi3-reset

# ── ping (quick 4-model smoke test) ──────────────────────────────────
# Runs all 4 models back-to-back with a simple prompt. Reports prefill,
# decode, and wall time per model. Use to compare M4 vs M5 at a glance.

bench-ping PROMPT="Explain what a hash table is in one sentence.":
    uv run apps/benchmarks/ping/run.py --prompt "{{PROMPT}}"

