# live-bench environment variables
# Copy to .env and adjust for your LAN setup:  cp .env.sample .env

# Backend URL — the live-bench CLI reads this automatically.
#
# Default below works for same-machine dev (server + CLI on one box).
# For LAN (benchmark machines pushing to a separate dashboard host),
# run `just lan-ip` on the dashboard host and paste the URL here.
LIVE_BENCH_SERVER=http://127.0.0.1:8787
