# The Agentic Dojo — human/agent launch pad (Dan pattern: the justfile is the trifecta interface)

# open the visual dojo in your browser (the default way to play)
default: play

play:
    python3 serve.py

# show progress across all lessons
status:
    python3 dojo.py status

# what to work on next
next:
    python3 dojo.py next

# run a lesson's closed loop: just check 01   (or: just check all)
check nn:
    python3 dojo.py check {{nn}}

# progressive hints: just hint 01   (or a specific one: just hint 01 2)
hint nn k="":
    python3 dojo.py hint {{nn}} {{k}}

# compare your work against the reference solution
diff nn:
    python3 dojo.py diff {{nn}}

# restore a lesson's starter files (your edits are lost)
reset nn:
    python3 dojo.py reset {{nn}}
