+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.validation-menu { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.validation-menu article,
+.loop-types article,
+.confidence-stack article,
+.browser-loop article,
+.altitude-map article,
+.adw-control article,
+.trace-map article,
+.adoption-gradient article,
+.kpi-grid article,
+.contract-grid article {
+  padding: var(--space-4);
+  border: 1px solid var(--border-soft);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.validation-menu h4,
+.loop-types h4,
+.confidence-stack h4,
+.browser-loop h4,
+.altitude-map h4,
+.adw-control h4,
+.trace-map h4,
+.adoption-gradient h4,
+.kpi-grid h4,
+.contract-grid h4 {
+  margin: 0 0 var(--space-2);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
+}
+
+.loop-types { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.loop-types article:nth-child(3) { border-color: var(--accent); background: var(--accent-wash); }
+.loop-types code { display: block; margin-top: var(--space-3); font-size: var(--text-xs); }
+
+.rvr-cycle {
+  position: relative;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-5);
+  padding: var(--space-6);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: color-mix(in srgb, var(--bg-card) 80%, var(--accent-wash));
+}
+
+.rvr-cycle article {
+  position: relative;
+  min-height: 10rem;
+  padding: var(--space-5);
+  border: 2px solid var(--border);
+  border-radius: 50%;
+  background: var(--bg-card);
+  text-align: center;
+}
+
+.rvr-cycle article:not(:last-child)::after {
+  position: absolute;
+  top: 48%;
+  right: -2.25rem;
+  color: var(--accent);
+  content: "→";
+  font-size: 2rem;
+  font-weight: 800;
+}
+
+.rvr-cycle b { display: block; color: var(--accent-ink); font: 650 var(--text-lg) var(--font-display); }
+.rvr-cycle p { margin-top: var(--space-2); font-size: var(--text-sm); }
+
+.confidence-stack { grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: end; }
+.confidence-stack article { min-height: calc(7rem + var(--level, 0) * .8rem); border-top: 4px solid var(--accent); }
+.confidence-stack code { display: block; margin-top: var(--space-2); font-size: var(--text-xs); }
+
+.browser-loop { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.browser-loop article { position: relative; }
+.browser-loop article:not(:last-child)::after,
+.adoption-gradient article:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: -.75rem;
+  z-index: 2;
+  color: var(--accent);
+  content: "→";
+  font-weight: 800;
+}
+
+.kpi-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.kpi-grid article { text-align: center; }
+.kpi-grid b { display: block; color: var(--accent-ink); font: 650 var(--text-lg) var(--font-display); }
+.kpi-grid span { color: var(--ok); font-weight: 800; }
+
+.altitude-map { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.altitude-map article:nth-child(2) { border-color: var(--accent); }
+.altitude-map article:nth-child(3) { background: var(--accent-wash); }
+
+.adw-control { grid-template-columns: 1fr 1.2fr 1fr; align-items: stretch; }
+.adw-control article { position: relative; }
+.adw-control .adw-control__code { background: var(--accent-wash); border-color: var(--accent); }
+.adw-control ol { margin-top: var(--space-3); }
+.adw-control code { font-size: var(--text-xs); }
+
+.contract-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.contract-grid article:last-child { border-color: var(--accent); background: var(--accent-wash); }
+
+.trace-map { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.trace-map article { border-top: 4px solid var(--accent); }
+.trace-map code { display: block; margin-top: var(--space-2); font-size: var(--text-xs); overflow-wrap: anywhere; }
+
+.adoption-gradient { grid-template-columns: repeat(5, minmax(0, 1fr)); align-items: end; }
+.adoption-gradient article { position: relative; min-height: calc(7rem + var(--level, 0) * 1.15rem); }
+.adoption-gradient article:last-child { border-color: var(--accent); background: var(--accent-wash); }
+
+.evidence-table-wrap { margin-top: var(--space-5); overflow-x: auto; }
+.evidence-table-wrap table { min-width: 48rem; border: var(--hairline); background: var(--bg-card); }
+
+.rubric {
+  display: grid;
+  grid-template-columns: 1.2fr repeat(3, minmax(8rem, .7fr));
+  margin-top: var(--space-5);
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.rubric > div { padding: var(--space-3); border-right: var(--hairline); border-bottom: var(--hairline); }
+.rubric__head { color: var(--accent-ink); background: var(--accent-wash); font-weight: 750; }
+
+.video-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+
+@media (max-width: 58rem) {
+  .validation-menu,
+  .loop-types,
+  .confidence-stack,
+  .browser-loop,
+  .altitude-map,
+  .adw-control,
+  .trace-map,
+  .adoption-gradient,
+  .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .rvr-cycle { grid-template-columns: 1fr; }
+  .rvr-cycle article { min-height: 8rem; border-radius: var(--radius-lg); }
+  .rvr-cycle article:not(:last-child)::after { top: auto; right: 50%; bottom: -2rem; transform: translateX(50%) rotate(90deg); }
+}
+
+@media (max-width: 46rem) {
+  .hero-loop,
+  .validation-menu,
+  .loop-types,
+  .confidence-stack,
+  .browser-loop,
+  .altitude-map,
+  .adw-control,
+  .trace-map,
+  .adoption-gradient,
+  .kpi-grid,
+  .contract-grid,
+  .video-cards { grid-template-columns: 1fr; }
+  .hero-loop__step:not(:last-child)::after { top: auto; right: 50%; bottom: -.95rem; transform: translateX(50%) rotate(90deg); }
+  .browser-loop article:not(:last-child)::after,
+  .adoption-gradient article:not(:last-child)::after { top: auto; right: 50%; bottom: -.8rem; transform: translateX(50%) rotate(90deg); }
+  .rubric { grid-template-columns: 1fr; }
+  .rubric > div { border-right: 0; }
+}
+
+@media print {
+  .skip-link { display: none; }
+  .hero-loop { grid-template-columns: repeat(3, 1fr); }
+  .validation-menu,
+  .loop-types,
+  .altitude-map,
+  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
+  .confidence-stack,
+  .browser-loop,
