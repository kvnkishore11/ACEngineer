+        <div class="four"><div>Prompts</div><div>Plans</div><div>ADWs</div><div>Triggers</div></div>
       </div>
     </article>
 
     <section class="section" aria-labelledby="tac-heading">
-      <div class="section-head"><div><p class="eyebrow">Volume I</p><h2 id="tac-heading">Tactical Agentic Coding</h2></div><p>6 of 8 chapters · 75%</p></div>
