                agent_name="task-processor",
                slash_command="/process_tasks",
                args=[],
                adw_id=generate_short_id(),
                model="sonnet",
                working_dir=os.getcwd(),
            )

            response = execute_template(request)
            if response.success:
                # Parse the JSON response using the utility function
