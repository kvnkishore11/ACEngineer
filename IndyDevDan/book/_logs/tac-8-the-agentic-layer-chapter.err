+  margin-inline: auto;
+}
+
+.app-map { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.app-map article,
+.mval-grid article,
+.output-chain article,
+.plan-anatomy article,
+.contract-flow article,
+.task-states article,
+.routing-grid article,
+.piter-grid article,
+.kpi-grid article,
+.reason-grid article,
+.practice-grid article,
+.proof-grid article,
+.progression-grid article {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.app-map article { border-top: 4px solid var(--accent); }
+.app-map strong,
+.mval-grid strong,
+.output-chain strong,
+.plan-anatomy strong,
+.contract-flow strong,
+.task-states strong,
+.routing-grid strong,
+.piter-grid strong,
+.kpi-grid strong,
+.reason-grid strong,
+.practice-grid strong,
+.proof-grid strong,
+.progression-grid strong {
+  display: block;
+  color: var(--accent-ink);
+  font-family: var(--font-display);
+}
+
+.app-map p,
+.mval-grid p,
+.output-chain p,
+.plan-anatomy p,
+.contract-flow p,
+.task-states p,
+.routing-grid p,
+.piter-grid p,
+.kpi-grid p,
+.reason-grid p,
+.practice-grid p,
+.proof-grid p,
+.progression-grid p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.layer-map { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+.layer-map__agentic,
+.layer-map__application {
+  min-height: 20rem;
+  padding: var(--space-5);
+  border-radius: var(--radius-lg);
+}
+.layer-map__agentic { border: 2px solid var(--accent); background: var(--accent-wash); }
+.layer-map__application { border: 2px solid var(--ink-soft); background: var(--bg-card); }
+.layer-map h4 { margin: 0; font-family: var(--font-display); }
+.layer-map ul { margin-top: var(--space-4); }
+
+.mval-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.mval-grid article { min-height: 12rem; border-top: 5px solid var(--accent); }
+.mval-grid code { display: inline-block; margin-bottom: var(--space-3); }
+
+.tree-card,
+.command-card,
+.equation-card,
+.question-card,
+.teach-back,
+.source-note {
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+}
+
+.tree-card,
+.command-card {
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-code);
+}
+.tree-card pre,
+.command-card pre { margin: 0; border: 0; padding: 0; white-space: pre-wrap; }
+
+.output-chain { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.output-chain article { position: relative; border-top: 4px solid var(--ink-mute); }
+.output-chain article:not(:last-child)::after,
+.contract-flow article:not(:last-child)::after {
+  position: absolute;
+  right: -.95rem;
+  top: 45%;
+  z-index: 2;
+  content: "→";
+  color: var(--accent);
+  font-weight: 800;
+}
+.output-chain code { display: block; overflow-wrap: anywhere; font-size: var(--text-xs); }
+
+.equation-card {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr auto 1.2fr;
+  gap: var(--space-3);
+  align-items: center;
+  min-height: 18rem;
+  padding: clamp(1.25rem, 4vw, 3rem);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: linear-gradient(135deg, var(--bg-card), var(--accent-wash));
+  box-shadow: var(--shadow-card);
+}
+.equation-card__term { padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); text-align: center; }
+.equation-card__term strong { display: block; font: 650 var(--text-lg)/1.1 var(--font-display); }
+.equation-card__term span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.equation-card__op { color: var(--accent); font: 700 var(--text-xl) var(--font-display); }
+
+.plan-anatomy { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.plan-anatomy article:nth-child(3), .plan-anatomy article:nth-child(4) { border-top: 4px solid var(--ok); }
+
+.contract-flow { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.contract-flow article { position: relative; min-height: 11rem; }
+.contract-flow code { display: inline-block; margin-top: var(--space-3); font-size: var(--text-xs); }
+
+.task-states { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.task-states article { border-top: 4px solid var(--ink-mute); }
+.task-states article:nth-child(2) { border-top-color: #a87300; }
+.task-states article:nth-child(3) { border-top-color: var(--ok); }
+.task-states article:nth-child(4) { border-top-color: var(--warn); background: var(--warn-wash); }
+.task-states article:nth-child(5) { border-top-color: var(--accent); background: var(--accent-wash); }
+.task-states .state { display: block; margin-bottom: var(--space-2); font: 700 var(--text-lg) var(--font-mono); }
+
+.routing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.routing-grid code { display: inline-block; margin-top: var(--space-2); font-size: var(--text-xs); }
+
+.piter-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.piter-grid article { border-top: 5px solid var(--accent); }
+.piter-grid .letter { color: var(--accent-ink); font: 750 clamp(2rem, 5vw, 3.5rem)/1 var(--font-display); }
+
+.aea-flow {
+  grid-template-columns: minmax(0, 1fr) 3.5rem minmax(0, 1.4fr) 3.5rem minmax(0, 1fr);
+  align-items: center;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+.aea-flow__app,
+.aea-flow__server,
+.aea-flow__store { min-height: 18rem; padding: var(--space-4); border-radius: var(--radius-md); }
+.aea-flow__app { border: 2px solid var(--accent); background: var(--accent-wash); }
+.aea-flow__server { border: 2px solid var(--ink-soft); background: var(--bg-inset); }
+.aea-flow__store { border: 2px solid var(--ok); background: var(--ok-wash); }
+.aea-flow__arrow { color: var(--accent); text-align: center; font: 750 2rem var(--font-display); }
+.chat-window { margin-top: var(--space-3); padding: var(--space-3); border: var(--hairline); border-radius: var(--radius-sm); background: var(--bg-card); }
+.chat-window + .chat-window { margin-top: var(--space-2); }
+.chat-window b { color: var(--accent-ink); }
+
+.pite-transform {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  gap: var(--space-5);
+  align-items: center;
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  padding: clamp(1.5rem, 5vw, 4rem);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+.pite-word { display: flex; justify-content: center; gap: .2em; font: 750 clamp(3rem, 9vw, 6.5rem)/1 var(--font-display); letter-spacing: .06em; }
+.pite-word span { display: inline-grid; place-items: center; min-width: 1em; }
+.pite-word .review { position: relative; color: var(--warn); }
+.pite-word .review::after { position: absolute; inset: 48% -10% auto; height: .1em; background: var(--warn); content: ""; transform: rotate(-12deg); }
+.pite-arrow { color: var(--accent); text-align: center; font: 750 var(--text-xl) var(--font-display); }
+.pite-note { grid-column: 1 / -1; margin-inline: auto; color: var(--ink-soft); text-align: center; }
+
+.kpi-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.kpi-grid article { border-top: 4px solid var(--accent); }
+.kpi-grid .kpi-value { display: block; margin: var(--space-2) 0; color: var(--accent-ink); font: 750 clamp(2rem, 4vw, 3rem)/1 var(--font-display); }
+
+.question-card {
+  padding: clamp(2rem, 7vw, 6rem);
+  border-radius: var(--radius-lg);
+  color: var(--ink-inverse);
+  background: var(--terminal-bg);
+  text-align: center;
+  box-shadow: var(--shadow-card);
+}
+.question-card p { max-width: 24ch; margin-inline: auto; font: 650 clamp(2.1rem, 6vw, 5.1rem)/1.05 var(--font-display); text-wrap: balance; }
+.question-card small { display: block; margin-top: var(--space-5); color: var(--terminal-dot); font: var(--text-sm) var(--font-mono); }
+
+.reason-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.reason-grid article { border-top: 4px solid var(--ok); }
+
+.progression-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.progression-grid article:nth-child(1) { background: var(--bg-inset); }
+.progression-grid article:nth-child(2) { background: var(--accent-wash); }
+.progression-grid article:nth-child(3) { background: var(--ok-wash); }
+
+.practice-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.practice-grid article { display: flex; flex-direction: column; }
+.practice-grid a { margin-top: auto; padding-top: var(--space-4); font-weight: 750; }
+.practice-grid .video-id { color: var(--ink-mute); font: var(--text-xs) var(--font-mono); }
+
+.proof-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.proof-grid article { border-left: 4px solid var(--ok); }
+
+.rubric-grid { grid-template-columns: 1.35fr repeat(3, minmax(8rem, .75fr)); gap: 0; overflow: hidden; border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.rubric-grid > div { padding: var(--space-3); border-right: var(--hairline); border-bottom: var(--hairline); }
+.rubric-grid .rubric-head { color: var(--accent-ink); background: var(--accent-wash); font-weight: 750; }
+
+.lab-checklist { padding: 0; list-style: none; }
+.lab-checklist li { position: relative; padding-left: 2rem; }
+.lab-checklist li::before { position: absolute; left: 0; content: "□"; color: var(--accent-ink); font: 700 1.25rem var(--font-mono); }
+
+.source-note { padding: var(--space-4); border-left: 4px solid var(--ink-mute); background: var(--bg-inset); color: var(--ink-soft); font-size: var(--text-sm); }
+.teach-back { padding: var(--space-5); border: 1px solid var(--accent); border-radius: var(--radius-md); background: var(--accent-wash); }
+
+.frame-card { width: 100%; max-width: min(100%, 68.75rem); }
+.frame-card img { width: 100%; max-width: min(100%, 68.75rem); object-fit: contain; }
+.frame-sequence { display: grid; gap: var(--space-6); width: 100%; max-width: min(100%, 68.75rem); margin-inline: auto; }
+
+@media (max-width: 68rem) {
+  .app-map,
+  .task-states { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .output-chain,
+  .plan-anatomy,
+  .contract-flow,
+  .piter-grid,
+  .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .output-chain article::after,
+  .contract-flow article::after { display: none; }
+}
+
+@media (max-width: 52rem) {
+  .ring-stage__label { width: 42%; }
+  .layer-map,
+  .mval-grid,
+  .app-map,
+  .output-chain,
+  .plan-anatomy,
+  .contract-flow,
+  .task-states,
+  .routing-grid,
+  .piter-grid,
+  .kpi-grid,
+  .reason-grid,
+  .practice-grid,
+  .proof-grid,
+  .progression-grid { grid-template-columns: 1fr; }
+  .equation-card { grid-template-columns: 1fr; }
+  .equation-card__op { text-align: center; }
+  .aea-flow { grid-template-columns: 1fr; }
+  .aea-flow__arrow { transform: rotate(90deg); }
+  .pite-transform { grid-template-columns: 1fr; }
+  .pite-arrow { transform: rotate(90deg); }
+  .pite-note { grid-column: auto; }
+  .rubric-grid { grid-template-columns: 1fr; }
+  .rubric-grid > div { border-right: 0; }
+}
+
+@media print {
+  .ring-stage,
+  .frame-card,
+  .equation-card,
+  .pite-transform,
+  .aea-flow,
+  .question-card { break-inside: avoid; }
+  .app-map,
+  .mval-grid,
+  .output-chain,
+  .plan-anatomy,
+  .contract-flow,
+  .task-states,
+  .piter-grid,
+  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
+}
