const ids=[...html.matchAll(/\\bid=\"(["'^"]+)"/g)].map(m=>m[1]);
const dup=[...new Set(ids.filter((x,i)=>ids.indexOf(x)!==i))];
const fragments=[...html.matchAll(/href="#([''^"]+)"/g)].map(m=>m[1]);
const missingFragments=[...new Set(fragments.filter(x=>!ids.includes(x)))];
const refs=[...html.matchAll(/(?:src|href)="([''^"]+)"/g)].map(m=>m[1]).filter(x=>!x.startsWith("#")&&!/''^https?:/.test(x));
const missingRefs=refs.filter(x=>!fs.existsSync(path.resolve(path.dirname(file),x)));
const cycles=[...html.matchAll(/<section class="chapter-section idea-cycle" id="([''^"]+)">(['"\\s\\S]*?)(?=<section class=\"chapter-section|<footer class=\"chapter-footer)/g)].map(m=>({id:m[1],moves:[...m[2].matchAll(/class=\"move move--(hook|picture|story|name|example|try|fail|current|check|teach)\"/g)].map(x=>x[1])}));
const expected=[\"hook\",\"picture\",\"story\",\"name\",\"example\",\"try\",\"fail\",\"current\",\"check\",\"teach\"];
const badCycles=cycles.filter(c=>JSON.stringify(c.moves)"'!==JSON.stringify(expected));
const frameRefs=[...html.matchAll(/src="('"\\.\\.\\/media\\/frames\\/ah-3-building-domain-specific-agents\\/["'^"]+)"/g)].map(m=>m[1]);
console.log(JSON.stringify({ids:ids.length,duplicateIds:dup,fragmentLinks:fragments.length,missingFragments,localRefs:refs.length,missingRefs,ideaCycles:cycles.length,badCycles,uniqueFrames:new Set(frameRefs).size,frameUses:frameRefs.length,details:(html.match(/<details/g)||[]).length},null,2));
if(dup.length||missingFragments.length||missingRefs.length||badCycles.length||cycles.length!==9||new Set(frameRefs).size!==12) process.exit(1);
