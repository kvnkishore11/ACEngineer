"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":13950,"estimated_tokens_delta":100,"uuid":"5ddb3aa7-37f0-4989-b874-d1cfcd75b97b","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":14050,"estimated_tokens_delta":100,"uuid":"ac621e31-7ece-4a69-8b6a-ccf266df8f13","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":14150,"estimated_tokens_delta":100,"uuid":"616dc792-95a1-447a-9f1d-ef12c83147ba","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":14350,"estimated_tokens_delta":200,"uuid":"8c8f3e0a-edb2-43a7-98b3-8bb80cdf7634","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":14650,"estimated_tokens_delta":300,"uuid":"599cd63d-70b5-444f-ba51-30320006f20b","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJ4tGT4X91h92rJQw6A","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11424,"cache_read_input_tokens":105107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11424},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"bb2a85d4-01ee-42cb-bd9c-37e57e433a6d","request_id":"req_011CcxJ4qL66Y52you4JonBn"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJ4tGT4X91h92rJQw6A","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11424,"cache_read_input_tokens":105107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11424},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"843ffd85-ee69-40d4-92c5-c5e2ac590970","request_id":"req_011CcxJ4qL66Y52you4JonBn"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJ4tGT4X91h92rJQw6A","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015VETgFCEdJKtEM3CvyYdTL","name":"TaskUpdate","input":{"taskId":"2","status":"in_progress"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11424,"cache_read_input_tokens":105107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11424},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"486edd6e-be48-41de-b449-02dcc644ace4","request_id":"req_011CcxJ4qL66Y52you4JonBn"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015VETgFCEdJKtEM3CvyYdTL","type":"tool_result","content":"Updated task #2 status"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"59407377-59e3-4e1f-8a96-a7945244ab39","timestamp":"2026-07-12T14:11:37.002Z","tool_use_result":{"success":true,"taskId":"2","updatedFields":["status"],"statusChange":{"from":"pending","to":"in_progress"}}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJ4tGT4X91h92rJQw6A","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0158B1CNR4zJ4J5GEAapNHdT","name":"Write","input":{"file_path":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/extract.json","content":"{\n  \"lesson_key\": \"tac-1-hello-agentic-coding\",\n  \"title\": \"Hello Agentic Coding\",\n  \"course\": \"TAC\",\n  \"order\": 1,\n  \"lesson_url\": \"https://agenticengineer.com/tactical-agentic-coding/course/hello-agentic-coding\",\n  \"video\": {\n    \"file\": \"tac-1-hello-agentic-coding/video/tac-1-hello-agentic-coding.mp4\",\n    \"duration_seconds\": 1311,\n    \"duration_display\": \"21:51\"\n  },\n  \"tactic\": {\n    \"name\": \"Stop Coding\",\n    \"one_liner\": \"Your hands and your mind are no longer the best tool for the job of writing code — hand the typing to agents and move your engineering cycles up the stack.\",\n    \"why_uncomfortable\": \"It asks career engineers to retire the skill that defined them. Dan spent over a decade at startups and large companies typing code by hand — mastering languages, syntax, algorithms, data structures — and says he misses it too. The tactic demands you trust that language models running in agentic loops on supercomputers are now vastly superior coders, and that clinging to hand-typing means you have no chance of keeping up. Evolution forces us to leave skills behind to adopt new ones.\"\n  },\n  \"mission\": \"Transform you into an engineer they can't replace — 'they' being your boss, the company, the industry, and AI itself. In a world where code is a commodity and your grandma or little brother can build an app with one prompt, you become irreplaceable the way engineers always have in technological revolutions: move up the stack. Become a commander of compute that builds systems that build systems, until your codebase runs itself.\",\n  \"phase_model\": {\n    \"phase1_ai_coding\": \"The generative-AI age's first phase: prompt-to-generate-code. Birth of vibe coders and the complete commoditization of code. You interact with the big three — context, model, prompt — to build faster than ever. Still foundational, no longer differentiating.\",\n    \"phase2_agentic_coding\": \"Where real engineers strike back. A superset of AI coding: the big three plus tools — prompts that reliably execute long chains of tool calls inside an agentic coding tool. Engineers reallocate their cycles to planning, reviewing, and creating closed-loop structures, and turn their codebases into increasingly self-operating machines.\"\n  },\n  \"core_concepts\": [\n    {\n      \"id\": \"agentic-engineer\",\n      \"name\": \"The Agentic Engineer — a new role\",\n      \"plain_english\": \"A software engineer whose job is not writing code but building systems that can take actions the way an engineer would: branch, write, run, test, commit, report. Dan bought agenticengineer.com in 2023 betting this role would emerge; lesson 1 declares it now exists.\",\n      \"dan_words\": \"\\\"Predicting that a new role of software engineering would emerge, defined by the ability to build systems that can take actions as we can. It's become clear this new role now exists.\\\"\",\n      \"misconception\": \"That 'agentic engineer' is a rebrand of 'prompt engineer.' It isn't: the role is defined by system-building (embedding agents across the SDLC), not by writing clever one-off prompts.\"\n    },\n    {\n      \"id\": \"phase-one-vs-phase-two\",\n      \"name\": \"Phase 1 (AI coding) vs Phase 2 (agentic coding)\",\n      \"plain_english\": \"Phase 1 = using AI to generate code faster (context, model, prompt). Phase 2 = using AI to perform engineering work end-to-end (add tools). The lesson's entire arc is the delta between these two phases, demonstrated with two prompts in one README.\",\n      \"dan_words\": \"\\\"In the generative AI age, AI coding was phase one. Here we saw the birth of VibeCoders and the complete commoditization of code... Agentic coding marks phase two. This is where real engineers strike back.\\\"\",\n      \"misconception\": \"That phase 2 replaces phase 1 knowledge. Agentic coding is a superset of AI coding — the big three are still there, always, even when you can't see them.\"\n    },\n    {\n      \"id\": \"stop-coding\",\n      \"name\": \"Tactic #1: Stop Coding\",\n      \"plain_english\": \"Stop typing code by hand. Not stop shipping code, not stop reading code — stop being the instrument that types it. Use the best tool for the job: agentic loops running powerful language models. Throughout all of TAC, not a single line of code is typed by hand.\",\n      \"dan_words\": \"\\\"Let's end the debate right now. Your hands and your mind are no longer the best tool for the job of writing code, full stop.\\\"\",\n      \"misconception\": \"Two opposite failure readings: (1) 'so we don't generate code anymore' — wrong, code is still a primary asset and you'll generate more than ever; (2) 'so I can stop understanding code' — wrong, code understanding is still critically important. What ends is hand-typing, and what replaces it is planning, reviewing, and closed-loop structures.\"\n    },\n    {\n      \"id\": \"commander-of-compute\",\n      \"name\": \"Commander of Compute\",\n      \"plain_english\": \"The identity shift of phase 2: your job is deciding where compute gets aimed and what systems it builds, not producing keystrokes. You don't just prompt to generate code — you direct compute to build systems that build systems.\",\n      \"dan_words\": \"\\\"We move up the stack once again. We become a commander of compute... You take this compute and you use it to build systems that build systems.\\\"\",\n      \"misconception\": \"That commanding compute means firing off more prompts manually. The command is structural — triggers, scripts, workflows that fire agents at the right time — not a human clicking faster.\"\n    },\n    {\n      \"id\": \"big-three\",\n      \"name\": \"The Big Three (context, model, prompt)\",\n      \"plain_english\": \"The three primitives of phase-1 AI coding: what the model can see (context), which model does the work (model), and what you ask for (prompt). Every AI coding interaction is governed by these whether you notice or not.\",\n      \"dan_words\": \"\\\"With AI coding, you've been interacting with the big three: context, model, prompt. This is a principle of AI coding. It's always there even if you can't see it.\\\"\",\n      \"misconception\": \"That the big three become obsolete in phase 2. They remain the foundation; phase 2 adds exactly one new dimension on top.\"\n    },\n    {\n      \"id\": \"core-four\",\n      \"name\": \"The Core Four (context, model, prompt, tools)\",\n      \"plain_english\": \"Add tools to the big three and you get the core four — the primitives of agentic coding. The 'tools' element specifically means prompts that can reliably execute long chains of tool calls, not the mere existence of tool calling.\",\n      \"dan_words\": \"\\\"The new element that transforms the big three of AI coding to Agentic Coding is prompts that can reliably execute long chains of tools. When you add tools, we upgrade the big three to the core four.\\\"\",\n      \"misconception\": \"'Tool calling has been around for a while, this is not new.' Dan's rebuttal: you're 100% right — and it's not a question of new, it's a question of scale and performance. Reliable long-chain execution is what changed.\"\n    },\n    {\n      \"id\": \"agentic-prompt\",\n      \"name\": \"The Agentic (Coding) Prompt\",\n      \"plain_english\": \"A prompt that contains a sequence of tool calls — a workflow specification, not a text request. It reads like a runbook (RUN / CREATE / RUN / REPORT) and executes like one: branch, write files, run programs, commit, report. It is the unit of engineering work in TAC, and every later lesson scales it.\",\n      \"dan_words\": \"\\\"Everything we do in TAC is built upon this core idea you can see right in this readme with just 35 lines... A prompt contains a sequence of tool calls.\\\"\",\n      \"misconception\": \"That it's 'just a prompt' — everyone knows prompts can call tools now. People don't invest the time to understand what this means at scale: fired repeatedly, with the right triggers and leverage, one prompt becomes an end-to-end developer workflow running minutes to hours without you.\"\n    },\n    {\n      \"id\": \"claude-code-form-factor\",\n      \"name\": \"Claude Code's three essential elements\",\n      \"plain_english\": \"Claude Code is the first agentic coding tool to properly combine: (1) a powerful language model that can reason when needed, (2) the ability to consistently call long chains of tools, and (3) the right agent architecture. That combination — being copied by every other tool — unlocks the core four, which unlocks the agentic prompt.\",\n      \"dan_words\": \"\\\"Claude Code is the first Agentic Coding tool to properly combine three essential elements: a powerful language model that can reason when needed, the ability to consistently call long chains of tools, and the right agent architecture... Reliable Agentic Coding at scale was not possible before Claude Code.\\\"\",\n      \"misconception\": \"That the lesson is Claude Code marketing and expires with the tool. Dan pre-handles this: your UI may differ, your models will be newer — great. The tactics are transferable to any tool with the right capabilities; don't get stuck on any one tool.\"\n    },\n    {\n      \"id\": \"programmable-agentic-coding\",\n      \"name\": \"Programmable agentic coding (claude -p)\",\n      \"plain_english\": \"Because Claude Code runs in the terminal, any language with terminal access can invoke it as a function: read a prompt file, pass it to `claude -p`, capture the output. The repo shows the identical pattern in shell, TypeScript+Bun, and Python+UV. The agent stops being a chat window and becomes a component you embed anywhere in the software development lifecycle.\",\n      \"dan_words\": \"\\\"Claude Code is also a programmable Agentic Coding tool... we can run it from any programming language that has terminal access... we can embed our own agents, our own workflows, our own agentic prompts across the software development lifecycle.\\\"\",\n      \"misconception\": \"That the demo scripts are trivial wrappers not worth running ('I already watched Dan do it'). The scripts ARE the lesson: it's not just about the agentic prompt, it's about where you can use it — including full agentic environments where you're not even present.\"\n    },\n    {\n      \"id\": \"systems-that-build-systems\",\n      \"name\": \"Systems that build systems / self-operating codebase\",\n      \"plain_english\": \"The end-state: codebases that increasingly run themselves — agents firing at the right time, doing the right work, with and without your oversight. Lesson 1 plants the seed (a scripted agent that does a full branch-write-run-commit-report cycle); the rest of TAC scales it.\",\n      \"dan_words\": \"\\\"The irreplaceable engineer in phase two that we're aiming to become is the engineer that transforms their code bases into self-operating machines... so much so that your code base literally runs itself.\\\"\",\n      \"misconception\": \"That this is hype about full autonomy tomorrow. The lesson's actual claim is incremental: 'increasingly self-operating,' built by investing your time in the right places and repeatedly extracting value.\"\n    },\n    {\n      \"id\": \"engineer-not-coder\",\n      \"name\": \"You're an engineer, not a coder\",\n      \"plain_english\": \"Engineering was never about writing code; it's about building systems of leverage that produce valuable outcomes for users and customers. Code is one asset those systems produce. This reframe is what makes 'stop coding' coherent rather than self-destructive.\",\n      \"dan_words\": \"\\\"Engineering was never about writing code. It's about building systems of leverage that produce valuable outcomes for your users and your customers... Remember, you're an engineer, not a coder. The difference is massive.\\\"\",\n      \"misconception\": \"That leverage means working more hours with AI. The 10x engineer emerges from 10x leverage, not 10x time or effort — and the number is arbitrary (2x, 10x, 100x) depending on the leverage points you find.\"\n    },\n    {\n      \"id\": \"replace-yourself\",\n      \"name\": \"To become irreplaceable, replace yourself\",\n      \"plain_english\": \"The lesson's closing paradox: the engineer who systematically automates their own work (replaces themselves) becomes the one the org can't replace — because they're the one who builds and commands the automation. Vibe coders can't replicate this.\",\n      \"dan_words\": \"\\\"The contradicting truth about what you'll learn in tactical agentic coding is this: To become an irreplaceable engineer, you will replace yourself.\\\"\",\n      \"misconception\": \"Reading it as job-loss fatalism. It's the opposite — an asymmetric-advantage strategy: in the tech industry, all the alpha lies in the future, in pushing what's possible forward.\"\n    }\n  ],\n  \"core_four\": {\n    \"context\": \"Everything the model can see while it works: the repo, files, README instructions, settings. tac-1 keeps context deliberately tiny — one file and two directories — so the difference between the two prompts is unmissable.\",\n    \"model\": \"The language model doing the work, able to reason when needed. Course-era Claude models power Claude Code; Dan explicitly blesses newer models: tools will change and models will improve — don't let that distract you.\",\n    \"prompt\": \"The instruction. In phase 2 the prompt graduates from 'generate this code' to a workflow specification: the README's agentic prompt reads RUN / CREATE / RUN — a runbook, not a request for text.\",\n    \"tools\": \"The fourth element and the entire phase-2 delta: file writes, terminal commands, git operations, web search — executed reliably in long chains. In tac-1 the exact tool surface is visible in .claude/settings.json: Read, Write, Edit, Bash(uv run:*), Bash(git checkout/branch/add/commit:*), WebSearch.\",\n    \"why_scale_matters\": \"Dan pre-empts the obvious objection — tool calling isn't new — with: it's not a question of new, it's a question of scale and performance. Wrap the core four in the right agent architecture and prompts become long-running end-to-end AI developer workflows (minutes to hours, with and without your oversight, highly performant and self-validating), fired over and over with the right triggers at the right time. Reliable agentic coding at scale was not possible before Claude Code.\"\n  },\n  \"ai_vs_agentic\": {\n    \"ai_coding_prompt_summary\": \"README 'AI Coding Prompt': CREATE main_aic.py that prints 'goodbye ai coding'. One file-generation request; Claude Code writes one file with one print. Dan: 'You've seen this a million times already... This is nothing new. This is AI coding.' It represents phase 1 — code generation, even at scale.\",\n    \"agentic_coding_prompt_summary\": \"README 'Agentic Coding Prompt': RUN — checkout a new/existing 'demo-agentic-coding' git branch; CREATE main_tac.py — print 'hello agentic coding' plus a concise definition of AI agents; RUN — uv run main_aic.py, uv run main_tac.py, git add ., git commit -m 'Demo agentic coding capabilities'. Claude Code plans it as a todo checklist, executes step by step by step, cleans up the todos, and reports what was done.\",\n    \"difference_that_matters\": \"Both are 'just prompts,' but the second performs engineering work — branching, executing programs, committing, reporting — not just producing code. The delta is exactly one dimension (tools, reliably chained), which upgrades the big three to the core four and turns a prompt into a repeatable unit of engineering work. Dan: 'the difference between these two prompts is monumental. It's absolutely massive.'\",\n    \"codebase_paths\": [\n      \"README.md\",\n      \".claude/settings.json\"\n    ]\n  },\n  \"programmable_agent\": {\n    \"why_it_matters\": \"Claude Code runs in the terminal, so any language with terminal access can invoke it: read prompt.md, pass it to `claude -p`, capture output. The agent becomes a callable function — the primitive needed to embed agents, workflows, and agentic prompts across the software development lifecycle, across developer environments, including full agentic environments where you're not present (agentic triggers come later in the course). This is the seed of AI developer workflows (ADWs) and the literal mechanism behind 'systems that build systems.'\",\n    \"languages\": [\n      \"shell\",\n      \"typescript+bun\",\n      \"python+uv\"\n    ],\n    \"files\": [\n      \"programmable/prompt.md\",\n      \"programmable/programmable.sh\",\n      \"programmable/programmable.ts\",\n      \"programmable/programmable.py\"\n    ]\n  },\n  \"loot_box_mentions\": [\n    \"Lesson 1 ships 28 loot notes; Dan points to the loot box twice on-screen: for missing-tool install links (pause the video) and for the lesson-1 codebase clone link.\",\n    \"Codebase: git clone https://github.com/disler/tac-1.git\",\n    \"Setup guides: Claude Code, Python, UV (Astral), Git\",\n    \"Tool docs: WSL (Windows users), Vite, pytest, npm, Bun, Node.js, GitHub CLI\",\n    \"Idea notes distilling the lesson: AI coding is NOT enough; TAC mission (become irreplaceable); commander of compute; engineering was never about writing code; the 10x-leverage opportunity; self-operating machines; Tactic #1 stop coding; no typing code throughout TAC; planning & reviewing role; Claude Code as primary tool; the core four; long-running AI developer workflows; programmable agentic coding; building systems that build systems; to become irreplaceable, replace yourself.\"\n  ],\n  \"step_by_step_demo\": [\n    \"(9:22–9:36) Essential tools flash on screen; if you're missing any, pause and install via loot box links.\",\n    \"(9:36–9:50) Move to a fresh directory for TAC codebases; clone the lesson-1 repo (loot box link); cd into it.\",\n    \"(9:50–10:00) Open your IDE (Dan uses VS Code: `code .`); open the terminal with Cmd+J; type `claude`.\",\n    \"(10:00–10:17) Economics check: TAC uses millions and millions of tokens — have the funds or Claude plan; maximum ROI requires pay-to-play.\",\n    \"(11:04–11:18) Repo tour: one file and two directories. Read .claude/settings.json so you know exactly what Claude Code has access to (Dan: always check the settings).\",\n    \"(11:18–11:46) Open README.md; copy the AI Coding Prompt; paste into Claude Code; fire. It creates main_aic.py with the expected print. Phase 1, nothing new.\",\n    \"(12:03–12:30) Copy the Agentic Coding Prompt; fire. Claude Code sets up a checklist plan, then executes the steps one by one by one.\",\n    \"(12:46–13:23) Review the work: brand-new demo-agentic-coding branch checked out, main_tac.py written ('hello agentic coding' + AI-agent definition), both files executed (goodbye ai coding / hello agentic coding), git add + git commit run, todo list cleaned up, work reported. This is agentic coding.\",\n    \"(17:22–17:59) Open programmable/: three scripts (shell, Bun TypeScript, Python) plus prompt.md — the prompt that runs inside every one of them via `claude -p`.\",\n    \"(17:56–18:10) Cleanup: `git branch` shows the demo branch from the interactive run; delete it (git branch -D demo-agentic-coding) so the scripted run recreates it from scratch.\",\n    \"(18:06–18:31) From a new terminal on main: `uv run python programmable/programmable.py`. The same workflow reruns headlessly — files created, branch changes, no human in the loop.\",\n    \"(19:29–20:05) prompt.md's REPORT section requested the exact output of both .py files; the script prints that full report at the end. Claude Code just ran as a component inside a program.\"\n  ],\n  \"quotes\": [\n    { \"text\": \"AI coding is not enough. Engineering is about much more than just writing code.\", \"approx_timestamp\": \"0:31\" },\n    { \"text\": \"Agentic coding marks phase two. This is where real engineers strike back.\", \"approx_timestamp\": \"1:44\" },\n    { \"text\": \"Transform you into an engineer they can't replace. You know who they are. It's your boss. It's the company. It's the industry. It's AI.\", \"approx_timestamp\": \"1:59\" },\n    { \"text\": \"We become a commander of compute... You take this compute and you use it to build systems that build systems.\", \"approx_timestamp\": \"2:40\" },\n    { \"text\": \"Engineering was never about writing code. It's about building systems of leverage that produce valuable outcomes for your users and your customers.\", \"approx_timestamp\": \"3:02\" },\n    { \"text\": \"Not by spending 10x the time or effort, but by achieving 10x the leverage. This number is arbitrary — it's 2x, it's 10x, it's 100x. It all depends on the leverage points you can find.\", \"approx_timestamp\": \"5:19\" },\n    { \"text\": \"Stop coding.\", \"approx_timestamp\": \"6:52\" },\n    { \"text\": \"Your hands and your mind are no longer the best tool for the job of writing code, full stop.\", \"approx_timestamp\": \"7:19\" },\n    { \"text\": \"But remember, you're an engineer, not a coder. The difference is massive.\", \"approx_timestamp\": \"7:57\" },\n    { \"text\": \"To scale into this new phase two role, we need to allocate our engineering cycles to planning, reviewing, and creating closed loop structures.\", \"approx_timestamp\": \"8:55\" },\n    { \"text\": \"Claude Code is not just writing code. It's calling tools. It's doing engineering work.\", \"approx_timestamp\": \"12:48\" },\n    { \"text\": \"The new element that transforms the big three of AI coding to Agentic Coding is prompts that can reliably execute long chains of tools.\", \"approx_timestamp\": \"13:49\" },\n    { \"text\": \"It's not a question of new. It's a question of scale and performance.\", \"approx_timestamp\": \"14:27\" },\n    { \"text\": \"Claude Code is the first Agentic Coding tool to properly combine three essential elements: a powerful language model that can reason when needed, the ability to consistently call long chains of tools, and the right agent architecture.\", \"approx_timestamp\": \"14:51\" },\n    { \"text\": \"Reliable Agentic Coding at scale was not possible before Claude Code. Everything we do in TAC is built upon this core idea you can see right in this readme with just 35 lines.\", \"approx_timestamp\": \"16:24\" },\n    { \"text\": \"Agentic coding is not about us writing code. It's about building systems that build systems on our behalf.\", \"approx_timestamp\": \"20:34\" },\n    { \"text\": \"To become an irreplaceable engineer, you will replace yourself.\", \"approx_timestamp\": \"20:47\" },\n    { \"text\": \"10 minutes of your work is equivalent to 60 minutes or more of another engineer's work.\", \"approx_timestamp\": \"21:44\" }\n  ],\n  \"prerequisites_tools\": [\n    \"A terminal (WSL for Windows users)\",\n    \"Git\",\n    \"GitHub CLI (gh)\",\n    \"Python + UV (Astral)\",\n    \"Node.js + npm\",\n    \"Bun\",\n    \"An IDE (Dan uses VS Code)\",\n    \"Claude Code, with a Claude plan or API funds sufficient for millions of tokens\"\n  ],\n  \"what_student_must_internalize\": [\n    \"Engineering ≠ typing code. It is building systems of leverage that produce valuable outcomes — code is one asset those systems produce.\",\n    \"The entire phase-1 → phase-2 delta is ONE new dimension: tools, executed reliably in long chains. Big three + tools = core four.\",\n    \"An agentic prompt is a workflow specification (RUN/CREATE/RUN/REPORT) that performs engineering work — branch, write, run, commit, report — not a request for text.\",\n    \"The question to ask about tool calling is never 'is it new?' but 'at what scale and reliability?'\",\n    \"Claude Code being programmable (claude -p from any language with terminal access) is what turns an agent from a chat UI into a component you embed across the SDLC — the seed of systems that build systems.\",\n    \"Your engineering cycles move to planning, reviewing, and closed-loop structures.\",\n    \"Tactics transfer across tools; don't marry the tool, and don't let UI/model drift distract you from the embedded value.\",\n    \"Always read .claude/settings.json (or its equivalent) before letting an agent loose — know exactly what it may do.\",\n    \"The paradox to sit with: to become irreplaceable, you will replace yourself.\"\n  ],\n  \"common_weak_student_failures\": [\n    \"Nodding along with 'stop coding,' then reflexively hand-editing the agent's files — never building trust in the loop and never freeing the cycles the tactic is designed to free.\",\n    \"Concluding the two README prompts are equivalent 'because both make files,' missing that the second performs a full engineering workflow (branch → write → run → commit → report).\",\n    \"Skipping .claude/settings.json, then being surprised or blocked by what the agent can and can't do — and never forming the safety habit of reading permissions first.\",\n    \"Hearing 'stop coding' as 'stop understanding code' — code review and code understanding remain critically important in phase 2.\",\n    \"Watching the programmable demo instead of running it ('I get the idea') — the embedding capability IS the lesson; unexecuted, it stays an idea.\",\n    \"Tool fixation: matching Dan's exact UI/model and stalling when theirs differs, instead of anchoring on the transferable tactic.\",\n    \"Forgetting to delete the demo-agentic-coding branch between runs, then misreading the 'new/existing branch' behavior as a bug.\",\n    \"Underestimating token economics — running dry mid-course instead of budgeting to pay-to-play for maximum ROI.\"\n  ],\n  \"teach_back_prompt\": \"Explain to a colleague, without notes: (1) why 'prompts that reliably execute long chains of tools' — not tool calling itself — is the primitive that separates agentic coding from AI coding, using the two prompts in the tac-1 README as your evidence; (2) what the core four are and which one is new; and (3) what `claude -p` unlocks that the interactive session doesn't — and why that unlock, not the demo's output, is the point of lesson 1. Finish by resolving the paradox: how does replacing yourself make you irreplaceable?\",\n  \"retrieval_questions\": [\n    { \"q\": \"What are the big three of AI coding?\", \"a\": \"Context, model, prompt — always present in every AI coding interaction, even when you can't see them.\" },\n    { \"q\": \"What single element upgrades the big three to the core four, and what's the precise definition?\", \"a\": \"Tools — specifically, prompts that can reliably execute long chains of tool calls. Not tool calling in general; reliable long-chain execution.\" },\n    { \"q\": \"What is Tactic #1, and name the two things it does NOT mean.\", \"a\": \"Stop coding. It does not mean you stop generating code (you'll generate more than ever), and it does not mean you stop understanding code (code understanding stays critical). It means you stop hand-typing it.\" },\n    { \"q\": \"What three essential elements did Claude Code combine first?\", \"a\": \"A powerful language model that can reason when needed; the ability to consistently call long chains of tools; and the right agent architecture.\" },\n    { \"q\": \"List what the agentic coding prompt did in the demo that the AI coding prompt did not.\", \"a\": \"Checked out the demo-agentic-coding branch, created main_tac.py, ran both .py files with uv, ran git add and git commit, and managed a todo checklist plus a final report. The AI coding prompt only created one file.\" },\n    { \"q\": \"What makes Claude Code 'programmable,' and why does that matter?\", \"a\": \"It runs in the terminal, so any language with terminal access can invoke it (claude -p with a prompt string). That turns the agent into a callable component you can embed across the software development lifecycle — even in environments where you're not present.\" },\n    { \"q\": \"Where do your engineering cycles go in phase 2?\", \"a\": \"Planning, reviewing, and creating closed-loop structures.\" },\n    { \"q\": \"Dan's rebuttal to 'tool calling isn't new'?\", \"a\": \"You're 100% right — and it's not a question of new. It's a question of scale and performance.\" },\n    { \"q\": \"Which file governs what Claude Code may do in the lesson repo, and what habit does Dan attach to it?\", \"a\": \".claude/settings.json (the permissions allowlist). Habit: always check the settings so you know what Claude Code has access to.\" },\n    { \"q\": \"What is the 'contradicting truth' of TAC?\", \"a\": \"To become an irreplaceable engineer, you will replace yourself.\" },\n    { \"q\": \"How long can agentic coding prompts run when wrapped in the right tool, and with what oversight?\", \"a\": \"Minutes to hours, end to end, with and without your oversight — in a highly performant, self-validating fashion.\" },\n    { \"q\": \"In the programmable scripts, what does the REPORT section of prompt.md demand?\", \"a\": \"That the agent respond with the exact output of both .py files — a report you can read (or another program can consume) when the headless run finishes.\" }\n  ],\n  \"codebase_map\": {\n    \"files\": [\n      \"README.md\",\n      \".claude/settings.json\",\n      \".env.sample\",\n      \"programmable/prompt.md\",\n      \"programmable/programmable.sh\",\n      \"programmable/programmable.py\",\n      \"programmable/programmable.ts\"\n    ],\n    \"what_each_does\": {\n      \"README.md\": \"The 35-line lesson artifact Dan says everything in TAC is built upon. Contains the AI Coding Prompt (CREATE main_aic.py → print goodbye ai coding), the Agentic Coding Prompt (RUN branch checkout → CREATE main_tac.py → RUN uv + git add/commit), the three programmable launch commands, and a pointer to enabled tools.\",\n      \".claude/settings.json\": \"Claude Code permission allowlist for the lesson: Read, Write, Edit, Bash(uv run:*), Bash(git checkout:*), Bash(git branch:*), Bash(git add:*), Bash(git commit:*), WebSearch. The exact tool surface of the demo — and the habit-forming file Dan tells you to always check.\",\n      \".env.sample\": \"Single line: ANTHROPIC_API_KEY= . Placeholder for the API-key billing path (alternative to a Claude plan) when running Claude Code headlessly.\",\n      \"programmable/prompt.md\": \"The agentic prompt used by all three scripts. Self-contained superset of the README demo: RUN (checkout demo-agentic-coding) → CREATE main_aic.py → CREATE main_tac.py → RUN (uv run both, git add, git commit) → REPORT (respond with the exact output of both .py files). The REPORT block is the seed of report-back patterns in later AI developer workflows.\",\n      \"programmable/programmable.sh\": \"Shell launcher: reads prompt.md into a variable, runs claude -p \\\"$PROMPT_CONTENT\\\", echoes the output. The minimal proof that an agent is one subprocess call away.\",\n      \"programmable/programmable.py\": \"Python+UV launcher: reads prompt.md, subprocess.run([\\\"claude\\\", \\\"-p\\\", prompt]) with captured stdout/stderr, prints both, exits with the subprocess's return code — the variant Dan runs on camera, and the most production-shaped (error handling + exit-code propagation).\",\n      \"programmable/programmable.ts\": \"Bun TypeScript launcher: readFileSync prompt.md, await $`claude -p ${promptContent}`.text(), console.log the output, exit 1 on error. Same pattern, third language — proving language choice is irrelevant.\"\n    },\n    \"generated_not_committed\": {\n      \"main_aic.py\": \"Created at runtime by the AI Coding Prompt (and by prompt.md). Prints 'goodbye ai coding'.\",\n      \"main_tac.py\": \"Created at runtime by the Agentic Coding Prompt (and by prompt.md). Prints 'hello agentic coding' plus a concise definition of AI agents.\",\n      \"demo-agentic-coding (git branch)\": \"Created by the agentic prompt runs; holds the commit 'Demo agentic coding capabilities'. Deleted between runs to demonstrate reproducibility.\"\n    }\n  },\n  \"current_practice_gaps\": [\n    {\n      \"gap\": \"Agent Skills under-taught in TAC-1 era\",\n      \"why\": \"TAC-1 encodes reusable agent behavior as a raw prompt file (programmable/prompt.md) launched by scripts. Modern Claude Code encodes reusable expertise as first-class Agent Skills (SKILL.md with frontmatter, discovery, and on-demand loading) — the current idiom for making 'systems that build systems' discoverable, composable, and shareable. The lesson's concept maps 1:1; the packaging has upgraded.\",\n      \"yt_candidates\": [\"X2ciJedw2vU\"]\n    },\n    {\n      \"gap\": \"claude -p has grown into headless mode + the Claude Agent SDK\",\n      \"why\": \"The one-shot `claude -p` subprocess still works and remains the clearest teaching form. Production embedding now uses headless flags (--output-format json/stream-json, --allowedTools, --permission-mode, session resume) and the Claude Agent SDK (Python/TypeScript) for structured output, hooks, and multi-turn control. Same concept — agent as callable component — richer machinery.\",\n      \"yt_candidates\": [\"6fCqj4xFCZI\"]\n    },\n    {\n      \"gap\": \"Permissions are richer than a flat allowlist now\",\n      \"why\": \".claude/settings.json allowlists like Bash(uv run:*) remain valid, but current Claude Code adds permission modes, hooks (pre/post tool-use gates), sandboxed bash, and org/user/project settings layering. The lesson's habit — read what the agent may do before running it — is timeless and transfers unchanged.\",\n      \"yt_candidates\": []\n    },\n    {\n      \"gap\": \"Model and UI drift since recording\",\n      \"why\": \"The recording shows course-era Claude Code UI and models; both have changed (newer model families, richer TUI, plan modes). Dan explicitly future-proofs in-lesson: 'Your Claude Code UI might look different. You might be using newer models. That's all great... Don't let that distract you from the value embedded in each lesson.' Treat specifics as period detail, tactics as current.\",\n      \"yt_candidates\": []\n    },\n    {\n      \"gap\": \"Single serial loop shown; parallel/multi-agent orchestration now standard\",\n      \"why\": \"TAC-1 demonstrates one agent running one workflow serially. Current practice scales the same agentic prompt across subagents, background tasks, and worktree-isolated parallel runs. Lesson 1 deliberately plants the seed only — later TAC lessons and current tooling do the scaling — but a modern reader should know the ceiling is far higher than one terminal.\",\n      \"yt_candidates\": [\"fop_yxV-mPo\", \"hGg3nWp7afg\"]\n    }\n  ],\n  \"yt_overlay_candidates\": [\n    {\n      \"video_id\": \"2TIXl2rlA6Q\",\n      \"title\": \"AI Coding is NOT ENOUGH\",\n      \"maps_to\": \"operationalizes tactic\",\n      \"include_in_phase1\": true,\n      \"rationale\": \"Public statement of the exact lesson thesis — the phase-1 → phase-2 argument and the words that open TAC-1 ('AI coding is not enough'). Reinforces the mission framing and stop-coding rationale with Dan's free-channel treatment; zero topic drift.\"\n    },\n    {\n      \"video_id\": \"6fCqj4xFCZI\",\n      \"title\": \"How Claude Code CHANGED Engineering Forever\",\n      \"maps_to\": \"named hole\",\n      \"include_in_phase1\": true,\n      \"rationale\": \"Directly expands TAC-1's two Claude-Code-specific claims — the three essential elements / new form factor, and programmable `claude -p` embedding — with the current state of the tool. Bridges the lesson's 2025-era demo to today's capabilities.\"\n    },\n    {\n      \"video_id\": \"X2ciJedw2vU\",\n      \"title\": \"RAW Agentic Coding: ZERO to Agent SKILL\",\n      \"maps_to\": \"corrects outdated\",\n      \"include_in_phase1\": true,\n      \"rationale\": \"Covers Agent Skills — the modern first-class encoding of reusable engineering that didn't exist in TAC-1's era. Upgrades the programmable/prompt.md pattern to SKILL.md thinking; fills the course's single most-cited named gap.\"\n    },\n    {\n      \"video_id\": \"fop_yxV-mPo\",\n      \"title\": \"Codebase Singularity\",\n      \"maps_to\": \"named hole\",\n      \"include_in_phase1\": false,\n      \"rationale\": \"Maps to the 'self-operating codebase' end-state vision, but that vision develops across TAC-2..8; overlaying it on lesson 1 front-loads scale before the student has the leverage-points vocabulary. Reserve for a later chapter.\"\n    },\n    {\n      \"video_id\": \"hGg3nWp7afg\",\n      \"title\": \"3 Codebase Folders\",\n      \"maps_to\": \"named hole\",\n      \"include_in_phase1\": false,\n      \"rationale\": \"Codebase-structure-for-agents (context engineering) content; belongs with TAC's context-focused lessons rather than lesson 1's thesis. Listed for the volume map only.\"\n    }\n  ],\n  \"frame_plan\": [\n    { \"t_seconds\": 78, \"label\": \"new-role-agenticengineer\", \"file\": \"media/frames/tac-1/t0078-new-role-agenticengineer.jpg\", \"why_for_weak_student\": \"Anchors the 2023 agenticengineer.com origin story — the 'new role' isn't hypothetical, it was predicted and named; gives the chapter's stakes a concrete artifact.\", \"diagram_instead\": false },\n    { \"t_seconds\": 115, \"label\": \"phase-1-vs-phase-2\", \"file\": \"media/frames/tac-1/t0115-phase-1-vs-phase-2.jpg\", \"why_for_weak_student\": \"The two-phase mental model in one image — the single scaffold every other concept in the lesson hangs from.\", \"diagram_instead\": false },\n    { \"t_seconds\": 124, \"label\": \"mission-irreplaceable\", \"file\": \"media/frames/tac-1/t0124-mission-irreplaceable.jpg\", \"why_for_weak_student\": \"The mission statement ('engineer they can't replace') as shown on screen; weak learners need the goal stated visually before the tactics make sense.\", \"diagram_instead\": false },\n    { \"t_seconds\": 162, \"label\": \"commander-of-compute\", \"file\": \"media/frames/tac-1/t0162-commander-of-compute.jpg\", \"why_for_weak_student\": \"Big-type 'COMMANDER OF COMPUTE' title card — names the identity shift; the phrase students should be able to define at chapter end.\", \"diagram_instead\": false },\n    { \"t_seconds\": 414, \"label\": \"tactic-stop-coding\", \"file\": \"media/frames/tac-1/t0414-tactic-stop-coding.jpg\", \"why_for_weak_student\": \"Tactic #1 as displayed at the reveal moment (6:54) — the chapter's headline claim, worth a full-bleed treatment.\", \"diagram_instead\": false },\n    { \"t_seconds\": 570, \"label\": \"essential-tools\", \"file\": \"media/frames/tac-1/t0570-essential-tools.jpg\", \"why_for_weak_student\": \"The on-screen checklist of required tools — lets a reader audit their setup against Dan's exact list before the lab.\", \"diagram_instead\": false },\n    { \"t_seconds\": 608, \"label\": \"terminal-claude-boot\", \"file\": \"media/frames/tac-1/t0608-terminal-claude-boot.jpg\", \"why_for_weak_student\": \"What 'success' looks like at step zero: VS Code, Cmd+J terminal, Claude Code booted. Kills the 'am I in the right place?' anxiety.\", \"diagram_instead\": false },\n    { \"t_seconds\": 700, \"label\": \"ai-coding-prompt-run\", \"file\": \"media/frames/tac-1/t0700-ai-coding-prompt-run.jpg\", \"why_for_weak_student\": \"The phase-1 baseline: the AI coding prompt running, one file created. The 'before' picture in the before/after pair.\", \"diagram_instead\": false },\n    { \"t_seconds\": 748, \"label\": \"agentic-prompt-checklist\", \"file\": \"media/frames/tac-1/t0748-agentic-prompt-checklist.jpg\", \"why_for_weak_student\": \"Claude Code planning the agentic prompt as a todo checklist — visible evidence that the agent plans before it executes.\", \"diagram_instead\": false },\n    { \"t_seconds\": 790, \"label\": \"agentic-prompt-results\", \"file\": \"media/frames/tac-1/t0790-agentic-prompt-results.jpg\", \"why_for_weak_student\": \"The 'after' picture: full trace of branch checkout, Write, uv runs with outputs, git add/commit, todos checked off. The monumental difference, visible in one screenshot.\", \"diagram_instead\": false },\n    { \"t_seconds\": 845, \"label\": \"core-four\", \"file\": \"media/frames/tac-1/t0845-core-four.jpg\", \"why_for_weak_student\": \"The Core Four Venn diagram (CONTEXT / MODEL / PROMPT / TOOLS) — the lesson's central abstraction as Dan draws it; the image to memorize.\", \"diagram_instead\": false },\n    { \"t_seconds\": 903, \"label\": \"claude-code-three-elements\", \"file\": \"media/frames/tac-1/t0903-claude-code-three-elements.jpg\", \"why_for_weak_student\": \"The three-essential-elements slide — why this tool class works: reasoning model + reliable long tool chains + right agent architecture.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1000, \"label\": \"readme-35-lines\", \"file\": \"media/frames/tac-1/t1000-readme-35-lines.jpg\", \"why_for_weak_student\": \"The entire lesson artifact in one screen — 'everything we do in TAC is built upon this core idea... with just 35 lines' — proves the foundation is small enough to fully understand.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1063, \"label\": \"programmable-directory\", \"file\": \"media/frames/tac-1/t1063-programmable-directory.jpg\", \"why_for_weak_student\": \"The programmable/ directory: three launchers + one prompt.md. Shows the pattern's shape at a glance — same prompt, any language.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1105, \"label\": \"programmable-py\", \"file\": \"media/frames/tac-1/t1105-programmable-py.jpg\", \"why_for_weak_student\": \"programmable.py source on screen — the ~30 lines that turn Claude Code into a callable function; demystifies 'programmable agent' completely.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1205, \"label\": \"programmable-report\", \"file\": \"media/frames/tac-1/t1205-programmable-report.jpg\", \"why_for_weak_student\": \"The headless run's final REPORT output in the terminal — closes the loop: prompt in, engineering work done, verified outputs back.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1250, \"label\": \"replace-yourself\", \"file\": \"media/frames/tac-1/t1250-replace-yourself.jpg\", \"why_for_weak_student\": \"The closing paradox moment ('you will replace yourself') — but the visual is B-roll hands typing; render as a designed pull-quote instead of the frame.\", \"diagram_instead\": true }\n  ],\n  \"lab\": {\n    \"setup\": [\n      \"Clone the course repo: git clone https://github.com/disler/tac-1.git && cd tac-1\",\n      \"Verify tools: claude --version, uv --version, git --version (optional: bun --version for the TS variant)\",\n      \"Read .claude/settings.json and say out loud what Claude Code may do without asking (files, which Bash commands, web search)\",\n      \"Open the repo in your IDE, open the terminal, run `claude`\"\n    ],\n    \"reproduce_dan\": [\n      \"Paste the README 'AI Coding Prompt' into Claude Code; confirm main_aic.py exists and `uv run main_aic.py` prints 'goodbye ai coding'\",\n      \"Paste the README 'Agentic Coding Prompt'; watch the todo checklist; confirm afterward: on branch demo-agentic-coding, main_tac.py prints both lines, and `git log --oneline -1` shows 'Demo agentic coding capabilities'\",\n      \"Return to main and delete the demo branch: git checkout main && git branch -D demo-agentic-coding\",\n      \"Rerun the whole workflow headlessly: uv run python programmable/programmable.py — no interaction allowed\",\n      \"Read the printed REPORT; verify it contains the exact outputs of both .py files by running them yourself\",\n      \"Repeat with sh programmable/programmable.sh and bun run programmable/programmable.ts; confirm all three launchers drive the identical workflow\"\n    ],\n    \"stretch\": [\n      \"Edit programmable/prompt.md (via Claude Code, not by hand): extend REPORT to also include the current git branch name; rerun and verify the report changed\",\n      \"Using Claude Code itself, add a fourth launcher in another language you know (e.g. Node without Bun); prove it produces the same workflow\",\n      \"Remove \\\"Bash(git commit:*)\\\" from .claude/settings.json and rerun the agentic prompt; observe exactly where and how the workflow halts; restore the permission and explain what this teaches about the tool surface\",\n      \"Time both README prompts. Then write two lists from your real job: tasks that are 'AI coding prompt'-shaped vs 'agentic coding prompt'-shaped. Pick the one agentic-shaped task you'll automate first.\"\n    ],\n    \"pass_criteria\": [\n      \"You typed zero lines of application code by hand (prompt edits via Claude Code included)\",\n      \"demo-agentic-coding branch exists with commit 'Demo agentic coding capabilities' containing main_aic.py and main_tac.py\",\n      \"uv run main_tac.py prints 'hello agentic coding' plus a one-line AI-agent definition\",\n      \"All three programmable launchers complete headlessly and print a REPORT with the exact outputs of both files\",\n      \"You can state the core four, the one-dimension delta from the big three, and Claude Code's three essential elements without notes\"\n    ]\n  },\n  \"estimated_print_pages_when_expanded\": 40,\n  \"confidence_notes\": [\n    \"All quotes cross-checked against the VTT; timestamps accurate to within ~3 seconds. Transcript is auto-generated: 'Cloud Code' = Claude Code, 'ADER' = Aider, 'Bunn' = Bun, 'the Identic Prompt' = the Agentic Prompt, 'loop box' = loot box.\",\n    \"README 'just 35 lines' claim verified: tac/tac-1/README.md is exactly 35 lines.\",\n    \"codebase_map covers every file on disk under tac/tac-1 (7 files); main_aic.py / main_tac.py are runtime artifacts, documented separately as generated_not_committed.\",\n    \"Frame images visually verified for t0162, t0845, t0790, t1250 in this session; the other 13 were extracted in the prior session and their filenames/timestamps align with VTT content at those moments (labels spot-checked against transcript).\",\n    \"YouTube overlay candidate IDs/titles come from the orchestration brief's seed list; relevance judged by title/topic mapping to TAC-1 named holes (no video downloads performed, per brief). Verify IDs resolve before publishing overlay links.\",\n    \"current_practice_gaps written against Claude Code as of mid-2026 (Skills, Agent SDK, permission modes, subagents); revisit at publish time — this axis moves fast.\",\n    \"Loot box inventory (28 notes) taken from the captured course-notes.md; the count and items reflect capture time and may have been updated on agenticengineer.com since.\"\n  ]\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11424,"cache_read_input_tokens":105107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11424},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"533c9778-e5bb-49dd-9404-58a56e4d9292","request_id":"req_011CcxJ4qL66Y52you4JonBn"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0158B1CNR4zJ4J5GEAapNHdT","type":"tool_result","content":"File created successfully at: /Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/extract.json (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"1d721180-5c7d-4d8b-927e-5fb0e323410b","timestamp":"2026-07-12T14:14:30.660Z","tool_use_result":{"type":"create","filePath":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/extract.json","content":"{\n  \"lesson_key\": \"tac-1-hello-agentic-coding\",\n  \"title\": \"Hello Agentic Coding\",\n  \"course\": \"TAC\",\n  \"order\": 1,\n  \"lesson_url\": \"https://agenticengineer.com/tactical-agentic-coding/course/hello-agentic-coding\",\n  \"video\": {\n    \"file\": \"tac-1-hello-agentic-coding/video/tac-1-hello-agentic-coding.mp4\",\n    \"duration_seconds\": 1311,\n    \"duration_display\": \"21:51\"\n  },\n  \"tactic\": {\n    \"name\": \"Stop Coding\",\n    \"one_liner\": \"Your hands and your mind are no longer the best tool for the job of writing code — hand the typing to agents and move your engineering cycles up the stack.\",\n    \"why_uncomfortable\": \"It asks career engineers to retire the skill that defined them. Dan spent over a decade at startups and large companies typing code by hand — mastering languages, syntax, algorithms, data structures — and says he misses it too. The tactic demands you trust that language models running in agentic loops on supercomputers are now vastly superior coders, and that clinging to hand-typing means you have no chance of keeping up. Evolution forces us to leave skills behind to adopt new ones.\"\n  },\n  \"mission\": \"Transform you into an engineer they can't replace — 'they' being your boss, the company, the industry, and AI itself. In a world where code is a commodity and your grandma or little brother can build an app with one prompt, you become irreplaceable the way engineers always have in technological revolutions: move up the stack. Become a commander of compute that builds systems that build systems, until your codebase runs itself.\",\n  \"phase_model\": {\n    \"phase1_ai_coding\": \"The generative-AI age's first phase: prompt-to-generate-code. Birth of vibe coders and the complete commoditization of code. You interact with the big three — context, model, prompt — to build faster than ever. Still foundational, no longer differentiating.\",\n    \"phase2_agentic_coding\": \"Where real engineers strike back. A superset of AI coding: the big three plus tools — prompts that reliably execute long chains of tool calls inside an agentic coding tool. Engineers reallocate their cycles to planning, reviewing, and creating closed-loop structures, and turn their codebases into increasingly self-operating machines.\"\n  },\n  \"core_concepts\": [\n    {\n      \"id\": \"agentic-engineer\",\n      \"name\": \"The Agentic Engineer — a new role\",\n      \"plain_english\": \"A software engineer whose job is not writing code but building systems that can take actions the way an engineer would: branch, write, run, test, commit, report. Dan bought agenticengineer.com in 2023 betting this role would emerge; lesson 1 declares it now exists.\",\n      \"dan_words\": \"\\\"Predicting that a new role of software engineering would emerge, defined by the ability to build systems that can take actions as we can. It's become clear this new role now exists.\\\"\",\n      \"misconception\": \"That 'agentic engineer' is a rebrand of 'prompt engineer.' It isn't: the role is defined by system-building (embedding agents across the SDLC), not by writing clever one-off prompts.\"\n    },\n    {\n      \"id\": \"phase-one-vs-phase-two\",\n      \"name\": \"Phase 1 (AI coding) vs Phase 2 (agentic coding)\",\n      \"plain_english\": \"Phase 1 = using AI to generate code faster (context, model, prompt). Phase 2 = using AI to perform engineering work end-to-end (add tools). The lesson's entire arc is the delta between these two phases, demonstrated with two prompts in one README.\",\n      \"dan_words\": \"\\\"In the generative AI age, AI coding was phase one. Here we saw the birth of VibeCoders and the complete commoditization of code... Agentic coding marks phase two. This is where real engineers strike back.\\\"\",\n      \"misconception\": \"That phase 2 replaces phase 1 knowledge. Agentic coding is a superset of AI coding — the big three are still there, always, even when you can't see them.\"\n    },\n    {\n      \"id\": \"stop-coding\",\n      \"name\": \"Tactic #1: Stop Coding\",\n      \"plain_english\": \"Stop typing code by hand. Not stop shipping code, not stop reading code — stop being the instrument that types it. Use the best tool for the job: agentic loops running powerful language models. Throughout all of TAC, not a single line of code is typed by hand.\",\n      \"dan_words\": \"\\\"Let's end the debate right now. Your hands and your mind are no longer the best tool for the job of writing code, full stop.\\\"\",\n      \"misconception\": \"Two opposite failure readings: (1) 'so we don't generate code anymore' — wrong, code is still a primary asset and you'll generate more than ever; (2) 'so I can stop understanding code' — wrong, code understanding is still critically important. What ends is hand-typing, and what replaces it is planning, reviewing, and closed-loop structures.\"\n    },\n    {\n      \"id\": \"commander-of-compute\",\n      \"name\": \"Commander of Compute\",\n      \"plain_english\": \"The identity shift of phase 2: your job is deciding where compute gets aimed and what systems it builds, not producing keystrokes. You don't just prompt to generate code — you direct compute to build systems that build systems.\",\n      \"dan_words\": \"\\\"We move up the stack once again. We become a commander of compute... You take this compute and you use it to build systems that build systems.\\\"\",\n      \"misconception\": \"That commanding compute means firing off more prompts manually. The command is structural — triggers, scripts, workflows that fire agents at the right time — not a human clicking faster.\"\n    },\n    {\n      \"id\": \"big-three\",\n      \"name\": \"The Big Three (context, model, prompt)\",\n      \"plain_english\": \"The three primitives of phase-1 AI coding: what the model can see (context), which model does the work (model), and what you ask for (prompt). Every AI coding interaction is governed by these whether you notice or not.\",\n      \"dan_words\": \"\\\"With AI coding, you've been interacting with the big three: context, model, prompt. This is a principle of AI coding. It's always there even if you can't see it.\\\"\",\n      \"misconception\": \"That the big three become obsolete in phase 2. They remain the foundation; phase 2 adds exactly one new dimension on top.\"\n    },\n    {\n      \"id\": \"core-four\",\n      \"name\": \"The Core Four (context, model, prompt, tools)\",\n      \"plain_english\": \"Add tools to the big three and you get the core four — the primitives of agentic coding. The 'tools' element specifically means prompts that can reliably execute long chains of tool calls, not the mere existence of tool calling.\",\n      \"dan_words\": \"\\\"The new element that transforms the big three of AI coding to Agentic Coding is prompts that can reliably execute long chains of tools. When you add tools, we upgrade the big three to the core four.\\\"\",\n      \"misconception\": \"'Tool calling has been around for a while, this is not new.' Dan's rebuttal: you're 100% right — and it's not a question of new, it's a question of scale and performance. Reliable long-chain execution is what changed.\"\n    },\n    {\n      \"id\": \"agentic-prompt\",\n      \"name\": \"The Agentic (Coding) Prompt\",\n      \"plain_english\": \"A prompt that contains a sequence of tool calls — a workflow specification, not a text request. It reads like a runbook (RUN / CREATE / RUN / REPORT) and executes like one: branch, write files, run programs, commit, report. It is the unit of engineering work in TAC, and every later lesson scales it.\",\n      \"dan_words\": \"\\\"Everything we do in TAC is built upon this core idea you can see right in this readme with just 35 lines... A prompt contains a sequence of tool calls.\\\"\",\n      \"misconception\": \"That it's 'just a prompt' — everyone knows prompts can call tools now. People don't invest the time to understand what this means at scale: fired repeatedly, with the right triggers and leverage, one prompt becomes an end-to-end developer workflow running minutes to hours without you.\"\n    },\n    {\n      \"id\": \"claude-code-form-factor\",\n      \"name\": \"Claude Code's three essential elements\",\n      \"plain_english\": \"Claude Code is the first agentic coding tool to properly combine: (1) a powerful language model that can reason when needed, (2) the ability to consistently call long chains of tools, and (3) the right agent architecture. That combination — being copied by every other tool — unlocks the core four, which unlocks the agentic prompt.\",\n      \"dan_words\": \"\\\"Claude Code is the first Agentic Coding tool to properly combine three essential elements: a powerful language model that can reason when needed, the ability to consistently call long chains of tools, and the right agent architecture... Reliable Agentic Coding at scale was not possible before Claude Code.\\\"\",\n      \"misconception\": \"That the lesson is Claude Code marketing and expires with the tool. Dan pre-handles this: your UI may differ, your models will be newer — great. The tactics are transferable to any tool with the right capabilities; don't get stuck on any one tool.\"\n    },\n    {\n      \"id\": \"programmable-agentic-coding\",\n      \"name\": \"Programmable agentic coding (claude -p)\",\n      \"plain_english\": \"Because Claude Code runs in the terminal, any language with terminal access can invoke it as a function: read a prompt file, pass it to `claude -p`, capture the output. The repo shows the identical pattern in shell, TypeScript+Bun, and Python+UV. The agent stops being a chat window and becomes a component you embed anywhere in the software development lifecycle.\",\n      \"dan_words\": \"\\\"Claude Code is also a programmable Agentic Coding tool... we can run it from any programming language that has terminal access... we can embed our own agents, our own workflows, our own agentic prompts across the software development lifecycle.\\\"\",\n      \"misconception\": \"That the demo scripts are trivial wrappers not worth running ('I already watched Dan do it'). The scripts ARE the lesson: it's not just about the agentic prompt, it's about where you can use it — including full agentic environments where you're not even present.\"\n    },\n    {\n      \"id\": \"systems-that-build-systems\",\n      \"name\": \"Systems that build systems / self-operating codebase\",\n      \"plain_english\": \"The end-state: codebases that increasingly run themselves — agents firing at the right time, doing the right work, with and without your oversight. Lesson 1 plants the seed (a scripted agent that does a full branch-write-run-commit-report cycle); the rest of TAC scales it.\",\n      \"dan_words\": \"\\\"The irreplaceable engineer in phase two that we're aiming to become is the engineer that transforms their code bases into self-operating machines... so much so that your code base literally runs itself.\\\"\",\n      \"misconception\": \"That this is hype about full autonomy tomorrow. The lesson's actual claim is incremental: 'increasingly self-operating,' built by investing your time in the right places and repeatedly extracting value.\"\n    },\n    {\n      \"id\": \"engineer-not-coder\",\n      \"name\": \"You're an engineer, not a coder\",\n      \"plain_english\": \"Engineering was never about writing code; it's about building systems of leverage that produce valuable outcomes for users and customers. Code is one asset those systems produce. This reframe is what makes 'stop coding' coherent rather than self-destructive.\",\n      \"dan_words\": \"\\\"Engineering was never about writing code. It's about building systems of leverage that produce valuable outcomes for your users and your customers... Remember, you're an engineer, not a coder. The difference is massive.\\\"\",\n      \"misconception\": \"That leverage means working more hours with AI. The 10x engineer emerges from 10x leverage, not 10x time or effort — and the number is arbitrary (2x, 10x, 100x) depending on the leverage points you find.\"\n    },\n    {\n      \"id\": \"replace-yourself\",\n      \"name\": \"To become irreplaceable, replace yourself\",\n      \"plain_english\": \"The lesson's closing paradox: the engineer who systematically automates their own work (replaces themselves) becomes the one the org can't replace — because they're the one who builds and commands the automation. Vibe coders can't replicate this.\",\n      \"dan_words\": \"\\\"The contradicting truth about what you'll learn in tactical agentic coding is this: To become an irreplaceable engineer, you will replace yourself.\\\"\",\n      \"misconception\": \"Reading it as job-loss fatalism. It's the opposite — an asymmetric-advantage strategy: in the tech industry, all the alpha lies in the future, in pushing what's possible forward.\"\n    }\n  ],\n  \"core_four\": {\n    \"context\": \"Everything the model can see while it works: the repo, files, README instructions, settings. tac-1 keeps context deliberately tiny — one file and two directories — so the difference between the two prompts is unmissable.\",\n    \"model\": \"The language model doing the work, able to reason when needed. Course-era Claude models power Claude Code; Dan explicitly blesses newer models: tools will change and models will improve — don't let that distract you.\",\n    \"prompt\": \"The instruction. In phase 2 the prompt graduates from 'generate this code' to a workflow specification: the README's agentic prompt reads RUN / CREATE / RUN — a runbook, not a request for text.\",\n    \"tools\": \"The fourth element and the entire phase-2 delta: file writes, terminal commands, git operations, web search — executed reliably in long chains. In tac-1 the exact tool surface is visible in .claude/settings.json: Read, Write, Edit, Bash(uv run:*), Bash(git checkout/branch/add/commit:*), WebSearch.\",\n    \"why_scale_matters\": \"Dan pre-empts the obvious objection — tool calling isn't new — with: it's not a question of new, it's a question of scale and performance. Wrap the core four in the right agent architecture and prompts become long-running end-to-end AI developer workflows (minutes to hours, with and without your oversight, highly performant and self-validating), fired over and over with the right triggers at the right time. Reliable agentic coding at scale was not possible before Claude Code.\"\n  },\n  \"ai_vs_agentic\": {\n    \"ai_coding_prompt_summary\": \"README 'AI Coding Prompt': CREATE main_aic.py that prints 'goodbye ai coding'. One file-generation request; Claude Code writes one file with one print. Dan: 'You've seen this a million times already... This is nothing new. This is AI coding.' It represents phase 1 — code generation, even at scale.\",\n    \"agentic_coding_prompt_summary\": \"README 'Agentic Coding Prompt': RUN — checkout a new/existing 'demo-agentic-coding' git branch; CREATE main_tac.py — print 'hello agentic coding' plus a concise definition of AI agents; RUN — uv run main_aic.py, uv run main_tac.py, git add ., git commit -m 'Demo agentic coding capabilities'. Claude Code plans it as a todo checklist, executes step by step by step, cleans up the todos, and reports what was done.\",\n    \"difference_that_matters\": \"Both are 'just prompts,' but the second performs engineering work — branching, executing programs, committing, reporting — not just producing code. The delta is exactly one dimension (tools, reliably chained), which upgrades the big three to the core four and turns a prompt into a repeatable unit of engineering work. Dan: 'the difference between these two prompts is monumental. It's absolutely massive.'\",\n    \"codebase_paths\": [\n      \"README.md\",\n      \".claude/settings.json\"\n    ]\n  },\n  \"programmable_agent\": {\n    \"why_it_matters\": \"Claude Code runs in the terminal, so any language with terminal access can invoke it: read prompt.md, pass it to `claude -p`, capture output. The agent becomes a callable function — the primitive needed to embed agents, workflows, and agentic prompts across the software development lifecycle, across developer environments, including full agentic environments where you're not present (agentic triggers come later in the course). This is the seed of AI developer workflows (ADWs) and the literal mechanism behind 'systems that build systems.'\",\n    \"languages\": [\n      \"shell\",\n      \"typescript+bun\",\n      \"python+uv\"\n    ],\n    \"files\": [\n      \"programmable/prompt.md\",\n      \"programmable/programmable.sh\",\n      \"programmable/programmable.ts\",\n      \"programmable/programmable.py\"\n    ]\n  },\n  \"loot_box_mentions\": [\n    \"Lesson 1 ships 28 loot notes; Dan points to the loot box twice on-screen: for missing-tool install links (pause the video) and for the lesson-1 codebase clone link.\",\n    \"Codebase: git clone https://github.com/disler/tac-1.git\",\n    \"Setup guides: Claude Code, Python, UV (Astral), Git\",\n    \"Tool docs: WSL (Windows users), Vite, pytest, npm, Bun, Node.js, GitHub CLI\",\n    \"Idea notes distilling the lesson: AI coding is NOT enough; TAC mission (become irreplaceable); commander of compute; engineering was never about writing code; the 10x-leverage opportunity; self-operating machines; Tactic #1 stop coding; no typing code throughout TAC; planning & reviewing role; Claude Code as primary tool; the core four; long-running AI developer workflows; programmable agentic coding; building systems that build systems; to become irreplaceable, replace yourself.\"\n  ],\n  \"step_by_step_demo\": [\n    \"(9:22–9:36) Essential tools flash on screen; if you're missing any, pause and install via loot box links.\",\n    \"(9:36–9:50) Move to a fresh directory for TAC codebases; clone the lesson-1 repo (loot box link); cd into it.\",\n    \"(9:50–10:00) Open your IDE (Dan uses VS Code: `code .`); open the terminal with Cmd+J; type `claude`.\",\n    \"(10:00–10:17) Economics check: TAC uses millions and millions of tokens — have the funds or Claude plan; maximum ROI requires pay-to-play.\",\n    \"(11:04–11:18) Repo tour: one file and two directories. Read .claude/settings.json so you know exactly what Claude Code has access to (Dan: always check the settings).\",\n    \"(11:18–11:46) Open README.md; copy the AI Coding Prompt; paste into Claude Code; fire. It creates main_aic.py with the expected print. Phase 1, nothing new.\",\n    \"(12:03–12:30) Copy the Agentic Coding Prompt; fire. Claude Code sets up a checklist plan, then executes the steps one by one by one.\",\n    \"(12:46–13:23) Review the work: brand-new demo-agentic-coding branch checked out, main_tac.py written ('hello agentic coding' + AI-agent definition), both files executed (goodbye ai coding / hello agentic coding), git add + git commit run, todo list cleaned up, work reported. This is agentic coding.\",\n    \"(17:22–17:59) Open programmable/: three scripts (shell, Bun TypeScript, Python) plus prompt.md — the prompt that runs inside every one of them via `claude -p`.\",\n    \"(17:56–18:10) Cleanup: `git branch` shows the demo branch from the interactive run; delete it (git branch -D demo-agentic-coding) so the scripted run recreates it from scratch.\",\n    \"(18:06–18:31) From a new terminal on main: `uv run python programmable/programmable.py`. The same workflow reruns headlessly — files created, branch changes, no human in the loop.\",\n    \"(19:29–20:05) prompt.md's REPORT section requested the exact output of both .py files; the script prints that full report at the end. Claude Code just ran as a component inside a program.\"\n  ],\n  \"quotes\": [\n    { \"text\": \"AI coding is not enough. Engineering is about much more than just writing code.\", \"approx_timestamp\": \"0:31\" },\n    { \"text\": \"Agentic coding marks phase two. This is where real engineers strike back.\", \"approx_timestamp\": \"1:44\" },\n    { \"text\": \"Transform you into an engineer they can't replace. You know who they are. It's your boss. It's the company. It's the industry. It's AI.\", \"approx_timestamp\": \"1:59\" },\n    { \"text\": \"We become a commander of compute... You take this compute and you use it to build systems that build systems.\", \"approx_timestamp\": \"2:40\" },\n    { \"text\": \"Engineering was never about writing code. It's about building systems of leverage that produce valuable outcomes for your users and your customers.\", \"approx_timestamp\": \"3:02\" },\n    { \"text\": \"Not by spending 10x the time or effort, but by achieving 10x the leverage. This number is arbitrary — it's 2x, it's 10x, it's 100x. It all depends on the leverage points you can find.\", \"approx_timestamp\": \"5:19\" },\n    { \"text\": \"Stop coding.\", \"approx_timestamp\": \"6:52\" },\n    { \"text\": \"Your hands and your mind are no longer the best tool for the job of writing code, full stop.\", \"approx_timestamp\": \"7:19\" },\n    { \"text\": \"But remember, you're an engineer, not a coder. The difference is massive.\", \"approx_timestamp\": \"7:57\" },\n    { \"text\": \"To scale into this new phase two role, we need to allocate our engineering cycles to planning, reviewing, and creating closed loop structures.\", \"approx_timestamp\": \"8:55\" },\n    { \"text\": \"Claude Code is not just writing code. It's calling tools. It's doing engineering work.\", \"approx_timestamp\": \"12:48\" },\n    { \"text\": \"The new element that transforms the big three of AI coding to Agentic Coding is prompts that can reliably execute long chains of tools.\", \"approx_timestamp\": \"13:49\" },\n    { \"text\": \"It's not a question of new. It's a question of scale and performance.\", \"approx_timestamp\": \"14:27\" },\n    { \"text\": \"Claude Code is the first Agentic Coding tool to properly combine three essential elements: a powerful language model that can reason when needed, the ability to consistently call long chains of tools, and the right agent architecture.\", \"approx_timestamp\": \"14:51\" },\n    { \"text\": \"Reliable Agentic Coding at scale was not possible before Claude Code. Everything we do in TAC is built upon this core idea you can see right in this readme with just 35 lines.\", \"approx_timestamp\": \"16:24\" },\n    { \"text\": \"Agentic coding is not about us writing code. It's about building systems that build systems on our behalf.\", \"approx_timestamp\": \"20:34\" },\n    { \"text\": \"To become an irreplaceable engineer, you will replace yourself.\", \"approx_timestamp\": \"20:47\" },\n    { \"text\": \"10 minutes of your work is equivalent to 60 minutes or more of another engineer's work.\", \"approx_timestamp\": \"21:44\" }\n  ],\n  \"prerequisites_tools\": [\n    \"A terminal (WSL for Windows users)\",\n    \"Git\",\n    \"GitHub CLI (gh)\",\n    \"Python + UV (Astral)\",\n    \"Node.js + npm\",\n    \"Bun\",\n    \"An IDE (Dan uses VS Code)\",\n    \"Claude Code, with a Claude plan or API funds sufficient for millions of tokens\"\n  ],\n  \"what_student_must_internalize\": [\n    \"Engineering ≠ typing code. It is building systems of leverage that produce valuable outcomes — code is one asset those systems produce.\",\n    \"The entire phase-1 → phase-2 delta is ONE new dimension: tools, executed reliably in long chains. Big three + tools = core four.\",\n    \"An agentic prompt is a workflow specification (RUN/CREATE/RUN/REPORT) that performs engineering work — branch, write, run, commit, report — not a request for text.\",\n    \"The question to ask about tool calling is never 'is it new?' but 'at what scale and reliability?'\",\n    \"Claude Code being programmable (claude -p from any language with terminal access) is what turns an agent from a chat UI into a component you embed across the SDLC — the seed of systems that build systems.\",\n    \"Your engineering cycles move to planning, reviewing, and closed-loop structures.\",\n    \"Tactics transfer across tools; don't marry the tool, and don't let UI/model drift distract you from the embedded value.\",\n    \"Always read .claude/settings.json (or its equivalent) before letting an agent loose — know exactly what it may do.\",\n    \"The paradox to sit with: to become irreplaceable, you will replace yourself.\"\n  ],\n  \"common_weak_student_failures\": [\n    \"Nodding along with 'stop coding,' then reflexively hand-editing the agent's files — never building trust in the loop and never freeing the cycles the tactic is designed to free.\",\n    \"Concluding the two README prompts are equivalent 'because both make files,' missing that the second performs a full engineering workflow (branch → write → run → commit → report).\",\n    \"Skipping .claude/settings.json, then being surprised or blocked by what the agent can and can't do — and never forming the safety habit of reading permissions first.\",\n    \"Hearing 'stop coding' as 'stop understanding code' — code review and code understanding remain critically important in phase 2.\",\n    \"Watching the programmable demo instead of running it ('I get the idea') — the embedding capability IS the lesson; unexecuted, it stays an idea.\",\n    \"Tool fixation: matching Dan's exact UI/model and stalling when theirs differs, instead of anchoring on the transferable tactic.\",\n    \"Forgetting to delete the demo-agentic-coding branch between runs, then misreading the 'new/existing branch' behavior as a bug.\",\n    \"Underestimating token economics — running dry mid-course instead of budgeting to pay-to-play for maximum ROI.\"\n  ],\n  \"teach_back_prompt\": \"Explain to a colleague, without notes: (1) why 'prompts that reliably execute long chains of tools' — not tool calling itself — is the primitive that separates agentic coding from AI coding, using the two prompts in the tac-1 README as your evidence; (2) what the core four are and which one is new; and (3) what `claude -p` unlocks that the interactive session doesn't — and why that unlock, not the demo's output, is the point of lesson 1. Finish by resolving the paradox: how does replacing yourself make you irreplaceable?\",\n  \"retrieval_questions\": [\n    { \"q\": \"What are the big three of AI coding?\", \"a\": \"Context, model, prompt — always present in every AI coding interaction, even when you can't see them.\" },\n    { \"q\": \"What single element upgrades the big three to the core four, and what's the precise definition?\", \"a\": \"Tools — specifically, prompts that can reliably execute long chains of tool calls. Not tool calling in general; reliable long-chain execution.\" },\n    { \"q\": \"What is Tactic #1, and name the two things it does NOT mean.\", \"a\": \"Stop coding. It does not mean you stop generating code (you'll generate more than ever), and it does not mean you stop understanding code (code understanding stays critical). It means you stop hand-typing it.\" },\n    { \"q\": \"What three essential elements did Claude Code combine first?\", \"a\": \"A powerful language model that can reason when needed; the ability to consistently call long chains of tools; and the right agent architecture.\" },\n    { \"q\": \"List what the agentic coding prompt did in the demo that the AI coding prompt did not.\", \"a\": \"Checked out the demo-agentic-coding branch, created main_tac.py, ran both .py files with uv, ran git add and git commit, and managed a todo checklist plus a final report. The AI coding prompt only created one file.\" },\n    { \"q\": \"What makes Claude Code 'programmable,' and why does that matter?\", \"a\": \"It runs in the terminal, so any language with terminal access can invoke it (claude -p with a prompt string). That turns the agent into a callable component you can embed across the software development lifecycle — even in environments where you're not present.\" },\n    { \"q\": \"Where do your engineering cycles go in phase 2?\", \"a\": \"Planning, reviewing, and creating closed-loop structures.\" },\n    { \"q\": \"Dan's rebuttal to 'tool calling isn't new'?\", \"a\": \"You're 100% right — and it's not a question of new. It's a question of scale and performance.\" },\n    { \"q\": \"Which file governs what Claude Code may do in the lesson repo, and what habit does Dan attach to it?\", \"a\": \".claude/settings.json (the permissions allowlist). Habit: always check the settings so you know what Claude Code has access to.\" },\n    { \"q\": \"What is the 'contradicting truth' of TAC?\", \"a\": \"To become an irreplaceable engineer, you will replace yourself.\" },\n    { \"q\": \"How long can agentic coding prompts run when wrapped in the right tool, and with what oversight?\", \"a\": \"Minutes to hours, end to end, with and without your oversight — in a highly performant, self-validating fashion.\" },\n    { \"q\": \"In the programmable scripts, what does the REPORT section of prompt.md demand?\", \"a\": \"That the agent respond with the exact output of both .py files — a report you can read (or another program can consume) when the headless run finishes.\" }\n  ],\n  \"codebase_map\": {\n    \"files\": [\n      \"README.md\",\n      \".claude/settings.json\",\n      \".env.sample\",\n      \"programmable/prompt.md\",\n      \"programmable/programmable.sh\",\n      \"programmable/programmable.py\",\n      \"programmable/programmable.ts\"\n    ],\n    \"what_each_does\": {\n      \"README.md\": \"The 35-line lesson artifact Dan says everything in TAC is built upon. Contains the AI Coding Prompt (CREATE main_aic.py → print goodbye ai coding), the Agentic Coding Prompt (RUN branch checkout → CREATE main_tac.py → RUN uv + git add/commit), the three programmable launch commands, and a pointer to enabled tools.\",\n      \".claude/settings.json\": \"Claude Code permission allowlist for the lesson: Read, Write, Edit, Bash(uv run:*), Bash(git checkout:*), Bash(git branch:*), Bash(git add:*), Bash(git commit:*), WebSearch. The exact tool surface of the demo — and the habit-forming file Dan tells you to always check.\",\n      \".env.sample\": \"Single line: ANTHROPIC_API_KEY= . Placeholder for the API-key billing path (alternative to a Claude plan) when running Claude Code headlessly.\",\n      \"programmable/prompt.md\": \"The agentic prompt used by all three scripts. Self-contained superset of the README demo: RUN (checkout demo-agentic-coding) → CREATE main_aic.py → CREATE main_tac.py → RUN (uv run both, git add, git commit) → REPORT (respond with the exact output of both .py files). The REPORT block is the seed of report-back patterns in later AI developer workflows.\",\n      \"programmable/programmable.sh\": \"Shell launcher: reads prompt.md into a variable, runs claude -p \\\"$PROMPT_CONTENT\\\", echoes the output. The minimal proof that an agent is one subprocess call away.\",\n      \"programmable/programmable.py\": \"Python+UV launcher: reads prompt.md, subprocess.run([\\\"claude\\\", \\\"-p\\\", prompt]) with captured stdout/stderr, prints both, exits with the subprocess's return code — the variant Dan runs on camera, and the most production-shaped (error handling + exit-code propagation).\",\n      \"programmable/programmable.ts\": \"Bun TypeScript launcher: readFileSync prompt.md, await $`claude -p ${promptContent}`.text(), console.log the output, exit 1 on error. Same pattern, third language — proving language choice is irrelevant.\"\n    },\n    \"generated_not_committed\": {\n      \"main_aic.py\": \"Created at runtime by the AI Coding Prompt (and by prompt.md). Prints 'goodbye ai coding'.\",\n      \"main_tac.py\": \"Created at runtime by the Agentic Coding Prompt (and by prompt.md). Prints 'hello agentic coding' plus a concise definition of AI agents.\",\n      \"demo-agentic-coding (git branch)\": \"Created by the agentic prompt runs; holds the commit 'Demo agentic coding capabilities'. Deleted between runs to demonstrate reproducibility.\"\n    }\n  },\n  \"current_practice_gaps\": [\n    {\n      \"gap\": \"Agent Skills under-taught in TAC-1 era\",\n      \"why\": \"TAC-1 encodes reusable agent behavior as a raw prompt file (programmable/prompt.md) launched by scripts. Modern Claude Code encodes reusable expertise as first-class Agent Skills (SKILL.md with frontmatter, discovery, and on-demand loading) — the current idiom for making 'systems that build systems' discoverable, composable, and shareable. The lesson's concept maps 1:1; the packaging has upgraded.\",\n      \"yt_candidates\": [\"X2ciJedw2vU\"]\n    },\n    {\n      \"gap\": \"claude -p has grown into headless mode + the Claude Agent SDK\",\n      \"why\": \"The one-shot `claude -p` subprocess still works and remains the clearest teaching form. Production embedding now uses headless flags (--output-format json/stream-json, --allowedTools, --permission-mode, session resume) and the Claude Agent SDK (Python/TypeScript) for structured output, hooks, and multi-turn control. Same concept — agent as callable component — richer machinery.\",\n      \"yt_candidates\": [\"6fCqj4xFCZI\"]\n    },\n    {\n      \"gap\": \"Permissions are richer than a flat allowlist now\",\n      \"why\": \".claude/settings.json allowlists like Bash(uv run:*) remain valid, but current Claude Code adds permission modes, hooks (pre/post tool-use gates), sandboxed bash, and org/user/project settings layering. The lesson's habit — read what the agent may do before running it — is timeless and transfers unchanged.\",\n      \"yt_candidates\": []\n    },\n    {\n      \"gap\": \"Model and UI drift since recording\",\n      \"why\": \"The recording shows course-era Claude Code UI and models; both have changed (newer model families, richer TUI, plan modes). Dan explicitly future-proofs in-lesson: 'Your Claude Code UI might look different. You might be using newer models. That's all great... Don't let that distract you from the value embedded in each lesson.' Treat specifics as period detail, tactics as current.\",\n      \"yt_candidates\": []\n    },\n    {\n      \"gap\": \"Single serial loop shown; parallel/multi-agent orchestration now standard\",\n      \"why\": \"TAC-1 demonstrates one agent running one workflow serially. Current practice scales the same agentic prompt across subagents, background tasks, and worktree-isolated parallel runs. Lesson 1 deliberately plants the seed only — later TAC lessons and current tooling do the scaling — but a modern reader should know the ceiling is far higher than one terminal.\",\n      \"yt_candidates\": [\"fop_yxV-mPo\", \"hGg3nWp7afg\"]\n    }\n  ],\n  \"yt_overlay_candidates\": [\n    {\n      \"video_id\": \"2TIXl2rlA6Q\",\n      \"title\": \"AI Coding is NOT ENOUGH\",\n      \"maps_to\": \"operationalizes tactic\",\n      \"include_in_phase1\": true,\n      \"rationale\": \"Public statement of the exact lesson thesis — the phase-1 → phase-2 argument and the words that open TAC-1 ('AI coding is not enough'). Reinforces the mission framing and stop-coding rationale with Dan's free-channel treatment; zero topic drift.\"\n    },\n    {\n      \"video_id\": \"6fCqj4xFCZI\",\n      \"title\": \"How Claude Code CHANGED Engineering Forever\",\n      \"maps_to\": \"named hole\",\n      \"include_in_phase1\": true,\n      \"rationale\": \"Directly expands TAC-1's two Claude-Code-specific claims — the three essential elements / new form factor, and programmable `claude -p` embedding — with the current state of the tool. Bridges the lesson's 2025-era demo to today's capabilities.\"\n    },\n    {\n      \"video_id\": \"X2ciJedw2vU\",\n      \"title\": \"RAW Agentic Coding: ZERO to Agent SKILL\",\n      \"maps_to\": \"corrects outdated\",\n      \"include_in_phase1\": true,\n      \"rationale\": \"Covers Agent Skills — the modern first-class encoding of reusable engineering that didn't exist in TAC-1's era. Upgrades the programmable/prompt.md pattern to SKILL.md thinking; fills the course's single most-cited named gap.\"\n    },\n    {\n      \"video_id\": \"fop_yxV-mPo\",\n      \"title\": \"Codebase Singularity\",\n      \"maps_to\": \"named hole\",\n      \"include_in_phase1\": false,\n      \"rationale\": \"Maps to the 'self-operating codebase' end-state vision, but that vision develops across TAC-2..8; overlaying it on lesson 1 front-loads scale before the student has the leverage-points vocabulary. Reserve for a later chapter.\"\n    },\n    {\n      \"video_id\": \"hGg3nWp7afg\",\n      \"title\": \"3 Codebase Folders\",\n      \"maps_to\": \"named hole\",\n      \"include_in_phase1\": false,\n      \"rationale\": \"Codebase-structure-for-agents (context engineering) content; belongs with TAC's context-focused lessons rather than lesson 1's thesis. Listed for the volume map only.\"\n    }\n  ],\n  \"frame_plan\": [\n    { \"t_seconds\": 78, \"label\": \"new-role-agenticengineer\", \"file\": \"media/frames/tac-1/t0078-new-role-agenticengineer.jpg\", \"why_for_weak_student\": \"Anchors the 2023 agenticengineer.com origin story — the 'new role' isn't hypothetical, it was predicted and named; gives the chapter's stakes a concrete artifact.\", \"diagram_instead\": false },\n    { \"t_seconds\": 115, \"label\": \"phase-1-vs-phase-2\", \"file\": \"media/frames/tac-1/t0115-phase-1-vs-phase-2.jpg\", \"why_for_weak_student\": \"The two-phase mental model in one image — the single scaffold every other concept in the lesson hangs from.\", \"diagram_instead\": false },\n    { \"t_seconds\": 124, \"label\": \"mission-irreplaceable\", \"file\": \"media/frames/tac-1/t0124-mission-irreplaceable.jpg\", \"why_for_weak_student\": \"The mission statement ('engineer they can't replace') as shown on screen; weak learners need the goal stated visually before the tactics make sense.\", \"diagram_instead\": false },\n    { \"t_seconds\": 162, \"label\": \"commander-of-compute\", \"file\": \"media/frames/tac-1/t0162-commander-of-compute.jpg\", \"why_for_weak_student\": \"Big-type 'COMMANDER OF COMPUTE' title card — names the identity shift; the phrase students should be able to define at chapter end.\", \"diagram_instead\": false },\n    { \"t_seconds\": 414, \"label\": \"tactic-stop-coding\", \"file\": \"media/frames/tac-1/t0414-tactic-stop-coding.jpg\", \"why_for_weak_student\": \"Tactic #1 as displayed at the reveal moment (6:54) — the chapter's headline claim, worth a full-bleed treatment.\", \"diagram_instead\": false },\n    { \"t_seconds\": 570, \"label\": \"essential-tools\", \"file\": \"media/frames/tac-1/t0570-essential-tools.jpg\", \"why_for_weak_student\": \"The on-screen checklist of required tools — lets a reader audit their setup against Dan's exact list before the lab.\", \"diagram_instead\": false },\n    { \"t_seconds\": 608, \"label\": \"terminal-claude-boot\", \"file\": \"media/frames/tac-1/t0608-terminal-claude-boot.jpg\", \"why_for_weak_student\": \"What 'success' looks like at step zero: VS Code, Cmd+J terminal, Claude Code booted. Kills the 'am I in the right place?' anxiety.\", \"diagram_instead\": false },\n    { \"t_seconds\": 700, \"label\": \"ai-coding-prompt-run\", \"file\": \"media/frames/tac-1/t0700-ai-coding-prompt-run.jpg\", \"why_for_weak_student\": \"The phase-1 baseline: the AI coding prompt running, one file created. The 'before' picture in the before/after pair.\", \"diagram_instead\": false },\n    { \"t_seconds\": 748, \"label\": \"agentic-prompt-checklist\", \"file\": \"media/frames/tac-1/t0748-agentic-prompt-checklist.jpg\", \"why_for_weak_student\": \"Claude Code planning the agentic prompt as a todo checklist — visible evidence that the agent plans before it executes.\", \"diagram_instead\": false },\n    { \"t_seconds\": 790, \"label\": \"agentic-prompt-results\", \"file\": \"media/frames/tac-1/t0790-agentic-prompt-results.jpg\", \"why_for_weak_student\": \"The 'after' picture: full trace of branch checkout, Write, uv runs with outputs, git add/commit, todos checked off. The monumental difference, visible in one screenshot.\", \"diagram_instead\": false },\n    { \"t_seconds\": 845, \"label\": \"core-four\", \"file\": \"media/frames/tac-1/t0845-core-four.jpg\", \"why_for_weak_student\": \"The Core Four Venn diagram (CONTEXT / MODEL / PROMPT / TOOLS) — the lesson's central abstraction as Dan draws it; the image to memorize.\", \"diagram_instead\": false },\n    { \"t_seconds\": 903, \"label\": \"claude-code-three-elements\", \"file\": \"media/frames/tac-1/t0903-claude-code-three-elements.jpg\", \"why_for_weak_student\": \"The three-essential-elements slide — why this tool class works: reasoning model + reliable long tool chains + right agent architecture.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1000, \"label\": \"readme-35-lines\", \"file\": \"media/frames/tac-1/t1000-readme-35-lines.jpg\", \"why_for_weak_student\": \"The entire lesson artifact in one screen — 'everything we do in TAC is built upon this core idea... with just 35 lines' — proves the foundation is small enough to fully understand.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1063, \"label\": \"programmable-directory\", \"file\": \"media/frames/tac-1/t1063-programmable-directory.jpg\", \"why_for_weak_student\": \"The programmable/ directory: three launchers + one prompt.md. Shows the pattern's shape at a glance — same prompt, any language.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1105, \"label\": \"programmable-py\", \"file\": \"media/frames/tac-1/t1105-programmable-py.jpg\", \"why_for_weak_student\": \"programmable.py source on screen — the ~30 lines that turn Claude Code into a callable function; demystifies 'programmable agent' completely.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1205, \"label\": \"programmable-report\", \"file\": \"media/frames/tac-1/t1205-programmable-report.jpg\", \"why_for_weak_student\": \"The headless run's final REPORT output in the terminal — closes the loop: prompt in, engineering work done, verified outputs back.\", \"diagram_instead\": false },\n    { \"t_seconds\": 1250, \"label\": \"replace-yourself\", \"file\": \"media/frames/tac-1/t1250-replace-yourself.jpg\", \"why_for_weak_student\": \"The closing paradox moment ('you will replace yourself') — but the visual is B-roll hands typing; render as a designed pull-quote instead of the frame.\", \"diagram_instead\": true }\n  ],\n  \"lab\": {\n    \"setup\": [\n      \"Clone the course repo: git clone https://github.com/disler/tac-1.git && cd tac-1\",\n      \"Verify tools: claude --version, uv --version, git --version (optional: bun --version for the TS variant)\",\n      \"Read .claude/settings.json and say out loud what Claude Code may do without asking (files, which Bash commands, web search)\",\n      \"Open the repo in your IDE, open the terminal, run `claude`\"\n    ],\n    \"reproduce_dan\": [\n      \"Paste the README 'AI Coding Prompt' into Claude Code; confirm main_aic.py exists and `uv run main_aic.py` prints 'goodbye ai coding'\",\n      \"Paste the README 'Agentic Coding Prompt'; watch the todo checklist; confirm afterward: on branch demo-agentic-coding, main_tac.py prints both lines, and `git log --oneline -1` shows 'Demo agentic coding capabilities'\",\n      \"Return to main and delete the demo branch: git checkout main && git branch -D demo-agentic-coding\",\n      \"Rerun the whole workflow headlessly: uv run python programmable/programmable.py — no interaction allowed\",\n      \"Read the printed REPORT; verify it contains the exact outputs of both .py files by running them yourself\",\n      \"Repeat with sh programmable/programmable.sh and bun run programmable/programmable.ts; confirm all three launchers drive the identical workflow\"\n    ],\n    \"stretch\": [\n      \"Edit programmable/prompt.md (via Claude Code, not by hand): extend REPORT to also include the current git branch name; rerun and verify the report changed\",\n      \"Using Claude Code itself, add a fourth launcher in another language you know (e.g. Node without Bun); prove it produces the same workflow\",\n      \"Remove \\\"Bash(git commit:*)\\\" from .claude/settings.json and rerun the agentic prompt; observe exactly where and how the workflow halts; restore the permission and explain what this teaches about the tool surface\",\n      \"Time both README prompts. Then write two lists from your real job: tasks that are 'AI coding prompt'-shaped vs 'agentic coding prompt'-shaped. Pick the one agentic-shaped task you'll automate first.\"\n    ],\n    \"pass_criteria\": [\n      \"You typed zero lines of application code by hand (prompt edits via Claude Code included)\",\n      \"demo-agentic-coding branch exists with commit 'Demo agentic coding capabilities' containing main_aic.py and main_tac.py\",\n      \"uv run main_tac.py prints 'hello agentic coding' plus a one-line AI-agent definition\",\n      \"All three programmable launchers complete headlessly and print a REPORT with the exact outputs of both files\",\n      \"You can state the core four, the one-dimension delta from the big three, and Claude Code's three essential elements without notes\"\n    ]\n  },\n  \"estimated_print_pages_when_expanded\": 40,\n  \"confidence_notes\": [\n    \"All quotes cross-checked against the VTT; timestamps accurate to within ~3 seconds. Transcript is auto-generated: 'Cloud Code' = Claude Code, 'ADER' = Aider, 'Bunn' = Bun, 'the Identic Prompt' = the Agentic Prompt, 'loop box' = loot box.\",\n    \"README 'just 35 lines' claim verified: tac/tac-1/README.md is exactly 35 lines.\",\n    \"codebase_map covers every file on disk under tac/tac-1 (7 files); main_aic.py / main_tac.py are runtime artifacts, documented separately as generated_not_committed.\",\n    \"Frame images visually verified for t0162, t0845, t0790, t1250 in this session; the other 13 were extracted in the prior session and their filenames/timestamps align with VTT content at those moments (labels spot-checked against transcript).\",\n    \"YouTube overlay candidate IDs/titles come from the orchestration brief's seed list; relevance judged by title/topic mapping to TAC-1 named holes (no video downloads performed, per brief). Verify IDs resolve before publishing overlay links.\",\n    \"current_practice_gaps written against Claude Code as of mid-2026 (Skills, Agent SDK, permission modes, subagents); revisit at publish time — this axis moves fast.\",\n    \"Loot box inventory (28 notes) taken from the captured course-notes.md; the count and items reflect capture time and may have been updated on agenticengineer.com since.\"\n  ]\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJXRLTm28MAen6XQCUj","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":31563,"cache_read_input_tokens":116531,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":31563},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"f12cfa41-99c1-45f5-bdbc-91db40879a00","request_id":"req_011CcxJXP14Wr8CcNzzuejFd"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJXRLTm28MAen6XQCUj","type":"message","role":"assistant","content":[{"type":"text","text":"extract.json written. Validating it, then writing extract.md."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":31563,"cache_read_input_tokens":116531,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":31563},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c7