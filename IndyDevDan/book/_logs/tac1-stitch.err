ns_delta":150,"uuid":"4dccc117-54c9-4fa1-a465-d518fca02b56","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":10200,"estimated_tokens_delta":100,"uuid":"806007d0-8e9f-4bef-b72f-711169d9646c","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":10350,"estimated_tokens_delta":150,"uuid":"9aca777d-8eff-4334-a033-8e464c05e14d","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":10500,"estimated_tokens_delta":150,"uuid":"0b28df1a-35aa-42a8-af27-acf8c83d99d4","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":10700,"estimated_tokens_delta":200,"uuid":"7eeceb9c-8913-47b7-bc7f-c68d8db61c24","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":10800,"estimated_tokens_delta":100,"uuid":"76840af1-9d53-46b9-86d5-84d4159a64f9","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":10900,"estimated_tokens_delta":100,"uuid":"bfe07182-e8b8-4d8a-b352-c60302b76fab","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":11000,"estimated_tokens_delta":100,"uuid":"73c00e54-c2e7-4c75-84a1-8e2cc026ecff","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":11150,"estimated_tokens_delta":150,"uuid":"894e3cf8-aa5d-4fa6-b0a8-2a23e5b6696f","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":11350,"estimated_tokens_delta":200,"uuid":"e118c330-ad8f-4214-8389-d8e6383a5779","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":11550,"estimated_tokens_delta":200,"uuid"