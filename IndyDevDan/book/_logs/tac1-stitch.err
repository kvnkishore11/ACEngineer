YZPrxdHbHJ"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WWv6t4iJWWRCBGUgXbW7ej","type":"tool_result","content":"The file /Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f","uuid":"13e4e601-2ec2-4901-917c-87107532f790","timestamp":"2026-07-12T15:02:18.403Z","tool_use_result":{"filePath":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html","oldString":"            <li><a href=\"#lab\">Graded lab</a></li>\n            <li><a href=\"#mastery\">Mastery check</a></li>\n          </ol>","newString":"            <li><a href=\"#lab\">Graded lab</a></li>\n            <li><a href=\"#mastery\">Mastery check</a></li>\n            <li><a href=\"#glossary\">Glossary</a></li>\n          </ol>","originalFile":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"description\" content=\"A teaching-first companion to TAC-1: Hello Agentic Coding. Learn the Core Four, stop hand-typing code, and turn Claude Code into a programmable agent.\">\n  <title>TAC-1 · Hello Agentic Coding — IndyDevDan Expert Book</title>\n  <link rel=\"stylesheet\" href=\"../design/tokens.css\">\n  <link rel=\"stylesheet\" href=\"../design/base.css\">\n  <link rel=\"stylesheet\" href=\"../design/components.css\">\n  <link rel=\"stylesheet\" href=\"01-hello-agentic-coding.assets.css\">\n</head>\n<body>\n  <div class=\"reading-progress\" aria-hidden=\"true\"><span class=\"reading-progress__bar\" id=\"top-progress\"></span></div>\n  <header class=\"site-bar\">\n    <a class=\"site-bar__home\" href=\"../index.html\" aria-label=\"Back to the book hub\">← IndyDevDan Expert Book</a>\n    <span class=\"site-bar__meta\">VOL I · TAC · CHAPTER 01</span>\n  </header>\n\n  <div class=\"chapter-shell\">\n    <aside class=\"chapter-rail\" aria-label=\"Chapter navigation\">\n      <p class=\"rail-kicker\">Volume I · Chapter 1</p>\n      <h2>Hello Agentic Coding</h2>\n      <div class=\"rail-progress\">\n        <p class=\"micro-label\">Reading progress</p>\n        <div class=\"rail-progress__line\"><span class=\"rail-progress__fill\" id=\"rail-progress\"></span></div>\n        <p class=\"rail-progress__copy\"><span id=\"progress-label\">0%</span><span>of chapter</span></p>\n      </div>\n      <nav class=\"chapter-nav\" aria-label=\"On this page\">\n        <ol>\n          <li><a href=\"#orientation\"><span class=\"chapter-nav__n\">00</span><span>Orientation</span></a></li>\n          <li><a href=\"#idea-role\"><span class=\"chapter-nav__n\">01</span><span>The new role</span></a></li>\n          <li><a href=\"#idea-mission\"><span class=\"chapter-nav__n\">02</span><span>Mission &amp; leverage</span></a></li>\n          <li><a href=\"#idea-stop\"><span class=\"chapter-nav__n\">03</span><span>Stop coding</span></a></li>\n          <li><a href=\"#idea-core-four\"><span class=\"chapter-nav__n\">04</span><span>The Core Four</span></a></li>\n          <li><a href=\"#idea-ab\"><span class=\"chapter-nav__n\">05</span><span>The A/B demo</span></a></li>\n          <li><a href=\"#idea-tool\"><span class=\"chapter-nav__n\">06</span><span>Why this tool class works</span></a></li>\n          <li><a href=\"#idea-programmable\"><span class=\"chapter-nav__n\">07</span><span>Programmable agent</span></a></li>\n          <li><a href=\"#idea-paradox\"><span class=\"chapter-nav__n\">08</span><span>Replace yourself</span></a></li>\n          <li><a href=\"#lab\"><span class=\"chapter-nav__n\">09</span><span>Graded lab</span></a></li>\n          <li><a href=\"#mastery\"><span class=\"chapter-nav__n\">10</span><span>Mastery check</span></a></li>\n          <li><a href=\"#glossary\"><span class=\"chapter-nav__n\">11</span><span>Glossary</span></a></li>\n        </ol>\n      </nav>\n    </aside>\n\n    <main class=\"chapter-main\" id=\"main-content\">\n      <header class=\"hero\">\n        <span class=\"hero__chapter\">Tactic #1 · Stop Coding</span>\n        <h1>Hello Agentic Coding</h1>\n        <p class=\"hero__dek\">The decisive move is not a better code-generation prompt. It is turning a prompt into a reliable engineering workflow—and turning the agent into a component you can call.</p>\n        <ul class=\"hero__meta\" aria-label=\"Chapter details\">\n          <li>Video spine · 21:51</li>\n          <li>Lab · 45–75 min</li>\n          <li>Course repo · tac/tac-1</li>\n          <li>Level · weak beginner → operator</li>\n        </ul>\n        <p class=\"hero__promise\"><strong>Mastery promise.</strong> By the end, you will be able to diagnose agentic work with the Core Four, explain the exact difference between AI coding and agentic coding, reproduce Dan’s interactive and headless demos, and teach why “replace yourself” is a leverage strategy rather than a surrender.</p>\n      </header>\n\n      <div class=\"mobile-toc\">\n        <details>\n          <summary>Chapter contents</summary>\n          <ol>\n            <li><a href=\"#orientation\">Orientation</a></li>\n            <li><a href=\"#idea-role\">The new role</a></li>\n            <li><a href=\"#idea-mission\">Mission and leverage</a></li>\n            <li><a href=\"#idea-stop\">Stop coding</a></li>\n            <li><a href=\"#idea-core-four\">The Core Four</a></li>\n            <li><a href=\"#idea-ab\">The A/B demo</a></li>\n            <li><a href=\"#idea-tool\">Why this tool class works</a></li>\n            <li><a href=\"#idea-programmable\">Programmable agent</a></li>\n            <li><a href=\"#idea-paradox\">Replace yourself</a></li>\n            <li><a href=\"#lab\">Graded lab</a></li>\n            <li><a href=\"#mastery\">Mastery check</a></li>\n          </ol>\n        </details>\n      </div>\n\n      <section class=\"chapter-section\" id=\"orientation\">\n        <span class=\"section-number\">00</span>\n        <h2 class=\"section-title\">Begin with the failure, not the slogan</h2>\n        <p class=\"section-lead\">You ask an AI to write a function. It gives you plausible code. You paste it into the repository, discover that it does not fit, repair two imports, run the tests, fix a test, create a branch, make the commit, and explain the result in Slack. The AI helped with one narrow slice. You still carried the workflow.</p>\n\n        <p>That is the concrete failure TAC-1 addresses. The problem is not that the generated code was bad. The problem is that the unit of delegation was too small. You delegated <em>typing</em> while retaining every transition that makes typing useful: reading the repository, choosing a safe branch, creating files, running programs, observing output, committing a coherent change, and reporting what happened. AI coding accelerated an activity. Agentic coding delegates an outcome-producing chain.</p>\n\n        <p>Dan’s lesson makes this distinction with almost comical economy. The source repository contains only seven files. Its README is exactly 35 lines. The generated programs print tiny messages. That smallness is deliberate. A realistic codebase would let you confuse complexity with the concept. Here the application code is so trivial that the only interesting variable is <strong>who moves the work through the engineering system</strong>.</p>\n\n        <aside class=\"callout callout--tactic\">\n          <p class=\"callout__label\">The chapter’s one-sentence thesis</p>\n          <p>AI coding uses context, model, and prompt to generate code. Agentic coding keeps those three and adds tools that can be executed reliably in a long chain—so the prompt becomes a workflow and the agent performs engineering work.</p>\n        </aside>\n\n        <h3>What you are training</h3>\n        <ul class=\"learning-objectives\">\n          <li><strong>Discrimination</strong>Tell code generation apart from workflow execution even when both begin with a prompt.</li>\n          <li><strong>Diagnosis</strong>Locate failures in context, model, prompt, or tools instead of blindly rerolling.</li>\n          <li><strong>Operation</strong>Reproduce the branch → write → run → commit → report cycle in the real TAC-1 repo.</li>\n          <li><strong>Transfer</strong>Recognize how <code>claude -p</code> turns an interactive agent into a programmable building block.</li>\n        </ul>\n\n        <h3>How to use this chapter</h3>\n        <p>Do not read it as a transcript recap. Each major idea repeats the same ten learning moves: failure, picture, one demo move, term, worked example, a small action, failure repair, current-practice overlay, retrieval, and teach-back. That repetition is intentional. Expertise is not the ability to recognize Dan’s phrases. It is the ability to retrieve the idea under pressure, operate it in the course repository, notice when it fails, and explain it without the chapter open.</p>\n\n        <div class=\"callout callout--warning\">\n          <p class=\"callout__label\">Prime directive for every exercise</p>\n          <p>You type zero lines of application code by hand. “Stop coding” is a behavioral constraint, not a discussion topic. You may type prompts and terminal commands. When a generated file is imperfect, repair it through the agent so you practice controlling the loop.</p>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-role\">\n        <span class=\"section-number\">01</span>\n        <h2 class=\"section-title\">A new role: the Agentic Engineer</h2>\n        <p class=\"section-lead\">The title matters only if the work changes. “Agentic Engineer” is not a badge for someone who uses AI often; it names an engineer who builds systems able to take engineering actions.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The prompt expert who is still the workflow engine</h3>\n          <p>Imagine an engineer who can produce excellent code with a one-shot prompt. They know how to attach a specification, point at the right files, and ask for tests. Yet after every answer they manually copy code, open files, run commands, move changes onto a branch, decide whether the output succeeded, and write a summary. Their prompts improved. Their role did not. The human remains the glue between every step.</p>\n          <p>This is why “prompt engineer” is too narrow for Dan’s prediction. A clever request can improve a model’s answer. An agentic system changes who performs the sequence. If the human must relay every output into the next input, the human is still the orchestration layer. The system has intelligence but little agency.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — the two-phase map</p>\n          <h3>Move the boundary of delegation</h3>\n          <div class=\"comparison\" aria-label=\"AI coding and agentic coding roles compared\">\n            <article class=\"comparison__card\">\n              <div class=\"comparison__head\"><h3>Phase 1 · AI coding</h3><p>The agent produces code; the human carries the workflow.</p></div>\n              <div class=\"comparison__body\">\n                <div class=\"workflow workflow--stacked\">\n                  <div class=\"workflow__step\"><strong>Human</strong><code>context → prompt</code></div>\n                  <div class=\"workflow__step\"><strong>Agent</strong><code>generate code</code></div>\n                  <div class=\"workflow__step\"><strong>Human</strong><code>write → run → fix → commit → report</code></div>\n                </div>\n              </div>\n            </article>\n            <article class=\"comparison__card comparison__card--agentic\">\n              <div class=\"comparison__head\"><h3>Phase 2 · Agentic coding</h3><p>The human specifies and reviews; the agent carries the workflow.</p></div>\n              <div class=\"comparison__body\">\n                <div class=\"workflow workflow--stacked\">\n                  <div class=\"workflow__step\"><strong>Human</strong><code>goal + constraints + checks</code></div>\n                  <div class=\"workflow__step\"><strong>Agent</strong><code>branch → write → run → commit → report</code></div>\n                  <div class=\"workflow__step\"><strong>Human</strong><code>review outcome + improve loop</code></div>\n                </div>\n              </div>\n            </article>\n          </div>\n          <p>The important movement is the boundary. The human does not disappear. The human moves from carrying transitions to designing them, setting constraints, and evaluating the result.</p>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>A 2023 bet becomes a visible phase change</h3>\n          <p>Dan opens with a concrete personal bet: in 2023 he bought <em>agenticengineer.com</em>, predicting a role centered on building systems capable of taking engineering actions. The claim is not that engineers vanish. It is that an engineer’s leverage shifts from personally performing actions to constructing systems that can perform them.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0115-phase-1-vs-phase-2.jpg\" alt=\"Dan's phase diagram moving from AI coding in phase one to agentic coding in phase two\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">1:55</span>Dan places AI coding and agentic coding on a two-phase timeline. Keep this scaffold visible: phase two is a superset, not a rejection, of phase one.</figcaption>\n          </figure>\n          <p>His one move is conceptual before it is technical: name the era change. In phase one, prompt-to-code makes code abundant and gives rise to vibe coding. In phase two, the engineering response is to command systems that take actions. That frame prevents the later terminal demo from shrinking into “Claude Code can run Git.” Git commands are merely the visible actions; role redesign is the lesson.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Phase-two Agentic Engineer</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Agentic Engineer:</strong> an engineer who builds systems that can take actions as engineers can.</p>\n          </aside>\n          <p>In plain English: you build the worker and the work path, not merely the artifact at the end. The evidence is behavioral. Does your system know which files to read? Can it create or edit files? Can it execute commands and observe their results? Can it preserve state across steps? Can it report a result that another person or program can evaluate? If yes, you are designing agency. If you only ask for a snippet, you are using generation.</p>\n          <p>The title does not require full autonomy. TAC-1 demonstrates a tiny serial workflow with a person choosing when to launch it. The role begins as soon as you deliberately package actions into a repeatable system. Later tactics can improve triggers, context, focus, and closed loops; none are prerequisites for recognizing the role here.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — walk the course codebase</p>\n          <h3>The repository describes a worker, not a product</h3>\n          <p>Open the course source at <code>tac/tac-1</code>. Before any demo runs, there is no <code>main_aic.py</code> and no <code>main_tac.py</code>. The seven committed files are instructional and operational:</p>\n          <div class=\"file-map\">\n            <div class=\"file-map__item\"><code>README.md</code><p>Holds the phase-one and phase-two prompts plus the three launcher commands.</p></div>\n            <div class=\"file-map__item\"><code>.claude/settings.json</code><p>Declares the tools the agent may use: three file tools, UV, four Git operations, and WebSearch.</p></div>\n            <div class=\"file-map__item\"><code>programmable/prompt.md</code><p>Packages a self-contained branch → create → run → commit → report workflow.</p></div>\n            <div class=\"file-map__item\"><code>programmable/*.{sh,py,ts}</code><p>Calls the same prompt from three host languages, proving the agent is a component.</p></div>\n            <div class=\"file-map__item\"><code>.env.sample</code><p>Contains the API-key placeholder used by the headless billing path.</p></div>\n            <div class=\"file-map__item\"><code>main_*.py</code><p><strong>Not source files at the start.</strong> They are runtime artifacts created by the agent.</p></div>\n          </div>\n          <p>The repository’s product is not the two print statements. Its product is a legible mechanism for directing an agent. This is the Agentic Engineer role reduced until no accidental complexity remains.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — 3 minute drill</p>\n          <h3>Classify the work by who carries the transitions</h3>\n          <ol>\n            <li>Write down one task where you ask an AI for code, then manually install the answer.</li>\n            <li>Underline every transition you still carry: locate, branch, edit, run, inspect, commit, report.</li>\n            <li>Rewrite the task as an outcome with explicit actions and a final report.</li>\n            <li>Do <em>not</em> run it yet. Circle the actions that would require tools or permissions.</li>\n          </ol>\n          <p>Your first draft is successful if it exposes the workflow you normally perform invisibly. The goal is not an elegant prompt. The goal is to see the human glue.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: a title change without a delegation change</h3>\n          <p><strong>Symptom:</strong> you say “agentic” because the tool has an agent mode, but you still approve and relay each micro-step. Or you send a long prompt that generates several files but never executes or verifies them.</p>\n          <p><strong>Fix:</strong> ask a falsifiable question: <em>What engineering action can the system complete without me moving information between steps?</em> Start with one closed chain, not a grand autonomy claim. In TAC-1 that chain is branch → write → run → commit → report. Once the system carries it, your role really has moved.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The ceiling is higher; the primitive is unchanged</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>TAC-1 intentionally shows one agent, one terminal, one serial workflow. Current practice can fan the same shape into subagents, background tasks, and worktree-isolated parallel runs. Do not import that complexity into this first lesson. First learn to specify one reliable chain. Parallelism multiplies both good system design and confused system design.</p>\n            <p class=\"current-practice__source\">Forward pointer: later TAC lessons scale the seed planted here.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <h3>Close the section before revealing answers</h3>\n          <section class=\"retrieval-quiz\" aria-label=\"Retrieval questions for the Agentic Engineer role\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What behavior, not job title, defines Dan’s Agentic Engineer?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Building systems that can take actions as engineers can—such as branching, writing, running, committing, and reporting.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Why is an excellent one-shot code prompt still phase-one shaped?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Because the output is code while the human still carries the engineering workflow around it. Quality does not change who performs the transitions.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What is the smallest observable proof that your role has moved?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>A system completes at least one meaningful multi-action chain without the human relaying intermediate results, then returns evidence for review.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Explain in 60 seconds:</strong> “An Agentic Engineer is not just someone who writes better prompts.” Use one example from the seven-file TAC-1 repository and name the moment when the human stops being workflow glue.</p>\n            <p class=\"fine\">Pass if your explanation includes actions, a repeatable system, and a report—not merely “AI does more.”</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-mission\">\n        <span class=\"section-number\">02</span>\n        <h2 class=\"section-title\">The mission: command compute through leverage</h2>\n        <p class=\"section-lead\">The tactic is emotionally difficult because it asks you to retire a visible skill. The mission supplies the reason: move up the stack from producing keystrokes to designing systems that produce outcomes.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The faster typist who cannot escape throughput</h3>\n          <p>Suppose an engineer doubles their typing speed, memorizes every framework API, and uses autocomplete perfectly. They may produce more code per hour, but every additional unit still consumes their attention. Their throughput is coupled to presence. If they stop, the work stops.</p>\n          <p>Now suppose another engineer spends ten minutes creating a reliable workflow that can be fired again. The first run may be slower than hand-typing. The second run costs almost no new design attention. The tenth run makes the original time investment look tiny. This is why Dan says the 10x engineer does not come from 10x time or effort. The multiplier is leverage, and the number could be 2x, 10x, or 100x depending on the leverage point.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — attention versus repeatability</p>\n          <h3>Effort is linear; a reusable system bends the curve</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 820 390\" role=\"img\" aria-labelledby=\"leverage-title leverage-desc\">\n                <title id=\"leverage-title\">Leverage curve comparing hand work and reusable agentic work</title>\n                <desc id=\"leverage-desc\">Hand work rises linearly with every repetition. Agentic work has an initial design investment, then much lower marginal attention for later runs.</desc>\n                <defs><marker id=\"arrow\" markerWidth=\"10\" markerHeight=\"10\" refX=\"7\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L0,6 L8,3 z\" fill=\"var(--ink-mute)\"/></marker></defs>\n                <line x1=\"90\" y1=\"315\" x2=\"760\" y2=\"315\" stroke=\"var(--ink-mute)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n                <line x1=\"90\" y1=\"315\" x2=\"90\" y2=\"45\" stroke=\"var(--ink-mute)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n                <text x=\"610\" y=\"355\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">workflow repetitions</text>\n                <text x=\"28\" y=\"210\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\" transform=\"rotate(-90 28 210)\">cumulative human attention</text>\n                <path d=\"M110 295 L700 75\" fill=\"none\" stroke=\"var(--warn)\" stroke-width=\"5\"/>\n                <text x=\"540\" y=\"105\" fill=\"var(--warn)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">hand-carry every run</text>\n                <path d=\"M110 295 C145 180 205 155 285 150 C420 142 565 137 700 132\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"6\"/>\n                <circle cx=\"190\" cy=\"164\" r=\"8\" fill=\"var(--accent)\"/>\n                <text x=\"205\" y=\"190\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">design the workflow once</text>\n                <text x=\"470\" y=\"162\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">low marginal attention</text>\n              </svg>\n            </div>\n            <figcaption>The first automated run includes design cost. Leverage appears across repetitions, not in a screenshot of run one.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>He names the enemy, then changes the identity</h3>\n          <p>Dan states the mission with uncomfortable specificity: become an engineer “they” cannot replace—where “they” means your boss, the company, the industry, and AI. The point is not permanent safety; he explicitly says nothing in technology lasts forever. The point is to choose the adaptation with the greatest asymmetric advantage.</p>\n          <div class=\"frame-grid\">\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0124-mission-irreplaceable.jpg\" alt=\"Mission slide naming the engineer they cannot replace\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">2:04</span>The mission supplies the criterion by which later tactics are judged: do they increase your leverage and make your contribution harder to substitute?</figcaption>\n            </figure>\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0162-commander-of-compute.jpg\" alt=\"Commander of Compute title card from TAC-1\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">2:42</span>The identity shift has a name: commander of compute. Your work moves from producing the artifact to aiming the machinery.</figcaption>\n            </figure>\n          </div>\n          <p>The story’s one move is to replace a threatened identity with a higher-order one. If “real engineer” means “person who types the best code,” an agent that types better feels like a rival. If engineering means building systems of leverage that produce valuable outcomes, a capable coding agent becomes new machinery. You are measured by what you can make the machinery reliably accomplish.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Commander of compute</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Commander of compute:</strong> the phase-two engineer who aims powerful models and agentic systems at valuable outcomes, building systems that build systems.</p>\n          </aside>\n          <p>Plain English: stop treating the model like a faster pair of hands and start treating it like programmable capacity. Commanding does not mean shouting more prompts. It means deciding the target, furnishing context, declaring constraints, granting a bounded tool surface, defining success evidence, and choosing when the workflow should run.</p>\n          <p>Dan’s end-state phrase—<strong>self-operating machine</strong>—should be read incrementally. TAC-1 does not claim that a codebase becomes autonomous in one lesson. It shows the smallest seed: one workflow can recreate a branch, files, executions, commit, and report without an interactive human. Every later improvement can move another piece of attention out of the repeated path.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — walk the course codebase</p>\n          <h3>Where the leverage lives in <code>programmable/</code></h3>\n          <p>Separate the TAC-1 headless example into one-time design and repeatable execution.</p>\n          <table>\n            <thead><tr><th>One-time human design</th><th>Repeatable agent execution</th><th>Evidence returned</th></tr></thead>\n            <tbody>\n              <tr><td>Specify a known starting branch</td><td>Checkout <code>demo-agentic-coding</code></td><td>Current branch can be inspected</td></tr>\n              <tr><td>Describe both generated files</td><td>Create <code>main_aic.py</code> and <code>main_tac.py</code></td><td>Files exist with reviewable content</td></tr>\n              <tr><td>Declare execution commands</td><td>Run both files with <code>uv run</code></td><td>Exact outputs appear in the trace/report</td></tr>\n              <tr><td>Declare repository transition</td><td><code>git add .</code> and commit with the specified message</td><td><code>git log</code> exposes the commit</td></tr>\n              <tr><td>Require a report</td><td>Return both program outputs</td><td>The launcher prints a human-readable result</td></tr>\n            </tbody>\n          </table>\n          <p>The two print programs are deliberately disposable. The leverage lives in the durable <code>prompt.md</code> plus launcher pattern. Delete the runtime branch and files, fire the launcher again, and the work reappears. Reproducibility—not code volume—is the first visible multiplier.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — leverage ledger</p>\n          <h3>Measure attention, not impressiveness</h3>\n          <ol>\n            <li>Choose one repeated engineering task from your week.</li>\n            <li>Write the minutes you spend per repetition and the number of repetitions per month.</li>\n            <li>List which steps are judgment and which are deterministic transitions.</li>\n            <li>Mark the smallest complete chain an agent could carry while returning evidence to your judgment point.</li>\n            <li>Estimate break-even: design minutes ÷ minutes saved per run.</li>\n          </ol>\n          <p>A boring five-minute workflow repeated 40 times may be a better leverage point than an impressive hour-long task performed once. This chapter does not authorize using any non-course repository in the lab; this ledger is a planning exercise for transfer after mastery.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: confusing more output with more leverage</h3>\n          <p><strong>Symptom:</strong> you celebrate that an agent generated 2,000 lines, even though reviewing and repairing those lines consumed more attention than the old workflow. Or you automate a one-off task because the demo looks impressive.</p>\n          <p><strong>Fix:</strong> evaluate the ratio Dan’s mission actually cares about: valuable outcome per unit of your attention. Count reruns, intervention points, review load, and evidence quality. A short stable workflow with a clear report is more agentic than a spectacular uncontrolled generation.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>Period detail changes; leverage does not</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>The course-era Claude Code interface and model names are period detail. Newer interfaces, plan modes, and background execution can reduce friction, but they do not change the leverage test. Dan future-proofs the lesson directly: newer models and a different UI are welcome; do not let them distract from the tactic.</p>\n            <p class=\"current-practice__source\">Use today’s tool, but grade it with the same question: how much reliable outcome does one unit of attention purchase?</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Retrieval questions for leverage and mission\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Why does Dan say the “10x” number is arbitrary?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Because the multiplier comes from the leverage point you find. It could be 2x, 10x, or 100x; it does not come from a fixed amount of greater effort.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What makes the programmable demo leverage rather than just automation theater?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The workflow can be recreated repeatedly from a known state with low additional human attention, and it returns evidence through the report.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What does a commander of compute decide?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The target, context, constraints, bounded tools, success evidence, and timing of a system that performs engineering work.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Explain to a skeptical senior engineer:</strong> why a slower first automated run may still create more leverage than a fast manual run. Use the <code>programmable/prompt.md</code> rerun and distinguish outcome volume from attention saved.</p>\n            <p class=\"fine\">Pass if you mention repetition, marginal attention, evidence, and a judgment boundary.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-stop\">\n        <span class=\"section-number\">03</span>\n        <h2 class=\"section-title\">Tactic #1: Stop Coding</h2>\n        <p class=\"section-lead\">The provocation is precise: stop <em>hand-typing</em> application code. Keep generating code. Keep understanding code. Move your scarce cycles to planning, reviewing, and building closed loops.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The ninety-percent trap</h3>\n          <p>An agent produces a nearly correct file. One import is wrong and one edge case is missing. You think, “It will be faster if I just fix those two lines.” You open the editor, type the repair, and move on. The task is complete, but the learning loop is broken.</p>\n          <p>The immediate edit feels efficient because you compare two minutes of hand work with another agent turn. Dan’s tactic compares something larger: a lifetime of carrying repairs versus learning to design prompts, feedback, and checks that make the system repair itself. Every time you silently take the keyboard back, you hide a failure mode from the system. You get the file, but you do not improve the mechanism that will create the next hundred files.</p>\n          <p>This is the behavioral edge of “stop coding.” It does not ask whether you are capable of the fix. It asks whether your personal typing is still the best lever for an outcome you expect to repeat.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — reallocate the engineering cycle</p>\n          <h3>Do not remove engineering; move it around the code</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 860 430\" role=\"img\" aria-labelledby=\"cycle-title cycle-desc\">\n                <title id=\"cycle-title\">Engineering cycles before and after Stop Coding</title>\n                <desc id=\"cycle-desc\">The old cycle centers human attention on typing. The agentic cycle moves human attention to planning, reviewing, and closed-loop design while the agent types and runs.</desc>\n                <text x=\"205\" y=\"42\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">Old allocation</text>\n                <circle cx=\"205\" cy=\"210\" r=\"115\" fill=\"var(--bg-inset)\" stroke=\"var(--border)\" stroke-width=\"2\"/>\n                <circle cx=\"205\" cy=\"210\" r=\"62\" fill=\"var(--warn-wash)\" stroke=\"var(--warn)\" stroke-width=\"3\"/>\n                <text x=\"205\" y=\"205\" text-anchor=\"middle\" fill=\"var(--warn)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">HUMAN</text>\n                <text x=\"205\" y=\"232\" text-anchor=\"middle\" fill=\"var(--warn)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">types code</text>\n                <text x=\"205\" y=\"105\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">plan a little</text>\n                <text x=\"205\" y=\"340\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">review at the end</text>\n                <path d=\"M390 210 L470 210\" stroke=\"var(--accent)\" stroke-width=\"5\"/>\n                <path d=\"M458 197 L478 210 L458 223\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"5\"/>\n                <text x=\"430\" y=\"185\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-base)\">reallocate</text>\n                <text x=\"655\" y=\"42\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">Phase-two allocation</text>\n                <circle cx=\"655\" cy=\"210\" r=\"128\" fill=\"var(--ok-wash)\" stroke=\"var(--ok)\" stroke-width=\"3\"/>\n                <circle cx=\"655\" cy=\"210\" r=\"66\" fill=\"var(--accent-wash)\" stroke=\"var(--accent)\" stroke-width=\"3\"/>\n                <text x=\"655\" y=\"204\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">AGENT</text>\n                <text x=\"655\" y=\"231\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">types + runs</text>\n                <text x=\"655\" y=\"100\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-md)\">PLAN</text>\n                <text x=\"530\" y=\"222\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-md)\" transform=\"rotate(-90 530 222)\">REVIEW</text>\n                <text x=\"780\" y=\"220\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-md)\" transform=\"rotate(90 780 220)\">CLOSE LOOP</text>\n                <text x=\"655\" y=\"345\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">human judgment surrounds the run</text>\n              </svg>\n            </div>\n            <figcaption>“Stop coding” removes the human from the typing center, not from the engineering system.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>The tactic is said twice because the easy interpretation is wrong</h3>\n          <p>At 6:47, after establishing the mission and leverage frame, Dan reveals the first tactic: “Stop coding.” He repeats it. Then he sharpens the claim: your hands and your mind are no longer the best tool for the job of writing code. The directness is meant to break a default behavior, not to erase engineering knowledge.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0414-tactic-stop-coding.jpg\" alt=\"Tactic number one Stop Coding reveal from the lesson\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">6:54</span>The headline is intentionally uncomfortable. Read the object of the verb carefully: stop personally <em>typing</em> the code, not producing or understanding it.</figcaption>\n          </figure>\n          <p>Dan grounds the discomfort in his own history. He spent more than a decade hand-coding across startups and large companies, mastering the familiar craft, and says he misses it. That confession matters pedagogically: the tactic is not offered by someone who never valued coding. It is an argument that the best instrument for code production has changed, and that engineers must move their attention to the work the instrument cannot own.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Stop coding ≠ stop engineering</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Exact distinction</p>\n            <p><strong>Stop coding:</strong> stop typing application code by hand. Continue generating more code than before, understanding what it does, reviewing it, and designing systems that can validate and improve it.</p>\n          </aside>\n          <p>Three reallocations make the phrase operational:</p>\n          <ul>\n            <li><strong>Planning:</strong> express outcomes, starting state, constraints, ordered actions, and pass conditions before compute begins.</li>\n            <li><strong>Reviewing:</strong> inspect behavior, diffs, architecture, risks, and evidence. Code understanding becomes more—not less—important when production accelerates.</li>\n            <li><strong>Closed-loop structures:</strong> connect generation to execution and observation so failure becomes feedback the system can act on.</li>\n          </ul>\n          <p>The tactic is therefore a constraint on who makes the keystrokes, not a license to be ignorant. If your agent generates ten times more code, your ability to frame, inspect, and govern code must become more systematic.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — walk the course codebase</p>\n          <h3>Zero application-code keystrokes in TAC-1</h3>\n          <p>The README’s phase-one prompt contains a description of <code>main_aic.py</code>:</p>\n          <pre><code>CREATE main_aic.py:\n    print goodbye ai coding</code></pre>\n          <p>The course artifact does not ask you to open <code>main_aic.py</code> and type the print statement. You give the instruction to Claude Code. The agent writes it. Later, <code>programmable/prompt.md</code> describes both runtime files and the agent writes both again. The lab’s prime directive extends the same rule to stretch changes: even when you add a branch name to the REPORT or create a fourth launcher, you ask Claude Code to make the edit.</p>\n          <p>Notice what you still do. You read <code>.claude/settings.json</code>. You understand the prompt. You watch the plan. You inspect generated files. You run independent verification commands. You compare the report to real output. You observe how the workflow fails when a permission is removed. Nothing about that work is passive. The difference is that your keystrokes go into instructions and probes, not into application code.</p>\n          <aside class=\"callout callout--why\">\n            <p class=\"callout__label\">Why the constraint matters</p>\n            <p>When an exercise is trivial, hand-editing always looks faster. The zero-typing rule makes you practice the control surface before tasks become too large for manual rescue.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — repair without reclaiming the keyboard</p>\n          <h3>Use the next imperfection as the exercise</h3>\n          <ol>\n            <li>During the TAC-1 lab, wait until an output differs from your expectation.</li>\n            <li>Before touching the file, state the discrepancy as observed versus expected behavior.</li>\n            <li>Give the agent the observation, the expected result, and the command that should prove success.</li>\n            <li>Let the agent edit and rerun.</li>\n            <li>Review the diff and evidence. If still wrong, repeat with a more precise observation.</li>\n          </ol>\n          <p>The drill is passed when the system repairs the artifact and you can name what improved in your feedback. Speed is secondary on this first repetition.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Two opposite misunderstandings</h3>\n          <div class=\"comparison\">\n            <article class=\"comparison__card\"><div class=\"comparison__head\"><h3>“No more code”</h3></div><div class=\"comparison__body\"><p><strong>Why it fails:</strong> code remains a primary asset that produces features and products. TAC expects you to generate more of it.</p><p><strong>Fix:</strong> say “stop hand-typing” every time you teach the tactic.</p></div></article>\n            <article class=\"comparison__card\"><div class=\"comparison__head\"><h3>“No need to understand code”</h3></div><div class=\"comparison__body\"><p><strong>Why it fails:</strong> faster generation magnifies the cost of weak review and weak system judgment.</p><p><strong>Fix:</strong> move reading, execution, tests, and diff review into explicit pass criteria.</p></div></article>\n          </div>\n          <p>A third failure hides between them: ritualistically never touching code while also never reviewing it. That is not Dan’s tactic. The goal is engineering leverage, not ideological purity. The lab’s zero-typing rule is a training constraint that forces better control habits.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The tactic has a public companion</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current-practice video · plan-approved</p>\n            <p>The locked overlay map pairs this lesson’s thesis with Dan’s public treatment, <em>AI Coding is NOT ENOUGH</em>. Use it after you can state the phase distinction yourself; the chapter’s course demo remains the graded evidence.</p>\n            <p class=\"current-practice__source\">Metadata should be rechecked at publication; the ID is supplied by the locked extract.</p>\n          </aside>\n          <div class=\"video-cards video-cards--single\">\n            <a class=\"video-card\" href=\"https://www.youtube.com/watch?v=2TIXl2rlA6Q\">\n              <span class=\"video-card__type\">Operationalizes the tactic</span>\n              <strong>AI Coding is NOT ENOUGH</strong>\n              <p>Reinforces the phase-one → phase-two thesis and the reason engineering cannot collapse into code generation.</p>\n              <span class=\"video-card__watch\">Open video ↗</span>\n            </a>\n          </div>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Retrieval questions for Stop Coding\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What exactly stops when you follow Tactic #1?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Your hand-typing of application code. Code generation and code understanding continue.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Where do the freed engineering cycles go?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Planning, reviewing, and creating closed-loop structures.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. Why is fixing the last two lines by hand a course failure even when it is faster?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It completes the artifact while hiding the loop’s weakness. You lose the chance to improve agent instructions, feedback, and verification for repeatable future work.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. What must increase when agents generate more code?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The quality and systematization of planning, review, validation, and governance.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Teach the tactic to a junior developer</strong> without using the phrase “AI is better at coding.” Explain what they stop, what they keep, and what three kinds of work replace typing. Give one example of a good re-prompt after an imperfect file.</p>\n            <p class=\"fine\">Pass if the learner could act differently on their next task.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-core-four\">\n        <span class=\"section-number\">04</span>\n        <h2 class=\"section-title\">Big Three → Core Four</h2>\n        <p class=\"section-lead\">The phase change adds one diagnostic dimension: tools. The novelty is not that tools exist. The breakthrough is that a prompt can reliably carry a long chain of tool calls at useful scale and performance.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The reroll reflex</h3>\n          <p>An agentic run stops before committing. A weak operator submits the same prompt again, perhaps adding “please make sure to commit.” The second run stops too. The operator concludes that the model is flaky.</p>\n          <p>A Core Four diagnosis asks four different questions. Did the agent see the repository state and instruction file it needed? Was the model capable of the reasoning? Did the prompt state a valid starting branch and commit expectation? Did the tool surface actually allow <code>git commit</code>? In TAC-1 stretch drill S3, removing one permission creates exactly this lesson: prompt quality cannot compensate for a missing tool.</p>\n          <p>Without a diagnostic vocabulary, every failure looks like “bad AI.” With the Core Four, you can isolate the broken dimension before spending another token.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — the Core Four visual</p>\n          <h3>Four interacting primitives, one newly emphasized dimension</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <div class=\"core-four\" role=\"img\" aria-label=\"Core Four: context, model, prompt, and tools, with tools highlighted as the added phase-two dimension\">\n                <div class=\"core-four__cell\"><b>Context</b><p>What the model can see: repo, files, settings, current state.</p></div>\n                <div class=\"core-four__cell\"><b>Model</b><p>The reasoning and generation capacity doing the work.</p></div>\n                <div class=\"core-four__cell\"><b>Prompt</b><p>The outcome, constraints, ordered actions, and report request.</p></div>\n                <div class=\"core-four__cell core-four__cell--tools\"><b>Tools</b><p>The bounded actions the agent can execute in a reliable chain.</p></div>\n                <span class=\"core-four__plus\">4</span>\n              </div>\n            </div>\n            <figcaption>The Big Three never disappear. Phase two adds tools and makes the interaction among all four operational.</figcaption>\n          </figure>\n          <div class=\"concept-strip\">\n            <div class=\"concept-strip__item\"><b>Context</b><p>“Can it see what matters?”</p></div>\n            <div class=\"concept-strip__item\"><b>Model</b><p>“Can it reason through this?”</p></div>\n            <div class=\"concept-strip__item\"><b>Prompt</b><p>“Does it know the outcome and checks?”</p></div>\n            <div class=\"concept-strip__item concept-strip__item--new\"><b>Tools</b><p>“Can it take the required actions?”</p></div>\n          </div>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>The full trace makes the fourth circle visible</h3>\n          <p>After the agentic prompt checks out a branch, writes <code>main_tac.py</code>, runs both programs, stages files, commits, cleans up its todos, and reports, Dan names what changed. AI coding had always involved context, model, and prompt—even if the user did not see all three. Agentic coding adds tools.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0845-core-four.jpg\" alt=\"Dan's Core Four diagram with context, tools, model, and prompt\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">14:05</span>The on-screen Core Four is the lesson’s central abstraction. The highlighted teaching point is reliable long-chain execution, not a claim that tool calling was invented here.</figcaption>\n          </figure>\n          <p>Dan anticipates the obvious objection: tool calling is not new. His answer is exact and portable: “It’s not a question of new. It’s a question of scale and performance.” A single calculator call proves a model can use a tool. A branch → write → run → observe → stage → commit → report chain proves that tool use can form a unit of engineering work.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>The Big Three and the Core Four</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Canonical terms</p>\n            <p><strong>Big Three:</strong> context, model, prompt. <strong>Core Four:</strong> context, model, prompt, tools. <strong>Precise delta:</strong> prompts that can reliably execute long chains of tools.</p>\n          </aside>\n          <p>Tools should not be reduced to a list of commands. The tool dimension has at least three properties:</p>\n          <ol>\n            <li><strong>Availability:</strong> a tool exists that can perform the needed action.</li>\n            <li><strong>Permission:</strong> the system allows that action in the current context.</li>\n            <li><strong>Chain reliability:</strong> the agent can choose, order, execute, and learn from several calls without losing the goal.</li>\n          </ol>\n          <p>This explains why all four interact. A correct Git tool with no repository context is useless. A capable model with an ambiguous starting state may choose the wrong branch. A precise prompt asking for a forbidden commit cannot cross the permission boundary. Diagnostics work because you ask which dimension prevented the next state transition.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — <code>.claude/settings.json</code></p>\n          <h3>Read the tool surface before running the prompt</h3>\n          <p>The lesson’s settings file is the tools circle made concrete:</p>\n          <pre><code>{\n  \"permissions\": {\n    \"allow\": [\n      \"Read\", \"Write\", \"Edit\",\n      \"Bash(uv run:*)\",\n      \"Bash(git checkout:*)\",\n      \"Bash(git branch:*)\",\n      \"Bash(git add:*)\",\n      \"Bash(git commit:*)\",\n      \"WebSearch\"\n    ]\n  }\n}</code></pre>\n          <p>Classify the list. <code>Read</code>, <code>Write</code>, and <code>Edit</code> let the agent inspect and change files. <code>uv run</code> lets it execute the generated programs. Four Git patterns let it checkout, inspect/create branches, add files, and commit. <code>WebSearch</code> is the single non-local tool. There is no <code>git push</code> permission.</p>\n          <p>Now predict the README workflow. The agent can create the branch because checkout/branch are allowed. It can write <code>main_tac.py</code>. It can run both files with UV. It can add and commit. It cannot push the commit under this allowlist. You have understood the possible behavior before spending tokens.</p>\n          <table>\n            <thead><tr><th>Observed failure</th><th>First Core Four hypothesis</th><th>Probe</th></tr></thead>\n            <tbody>\n              <tr><td>Agent edits wrong file</td><td>Context or prompt</td><td>Ask which file path it read and where the path was specified.</td></tr>\n              <tr><td>Agent cannot commit</td><td>Tools/permission</td><td>Inspect <code>.claude/settings.json</code> for <code>Bash(git commit:*)</code>.</td></tr>\n              <tr><td>Agent creates correct code but skips execution</td><td>Prompt or chain planning</td><td>Confirm the RUN block explicitly includes both <code>uv run</code> commands.</td></tr>\n              <tr><td>Agent reports success with wrong output</td><td>Prompt/report evidence or model reasoning</td><td>Run files independently and require exact output in REPORT.</td></tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — permissions audit</p>\n          <h3>Checkpoint zero of the lab begins here</h3>\n          <ol>\n            <li>Open <code>tac/tac-1/.claude/settings.json</code>.</li>\n            <li>Without running the agent, write the three file tools.</li>\n            <li>Write the four allowed Git subcommands and one important absent operation.</li>\n            <li>Name the single non-local tool.</li>\n            <li>Close the file and recite the answers.</li>\n          </ol>\n          <div class=\"checkpoint\"><strong>Pass:</strong> Read, Write, Edit; checkout, branch, add, commit; push is not allowed; WebSearch is the non-local tool.</div>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: treating the Core Four as a memorization diagram</h3>\n          <p><strong>Symptom:</strong> you can chant “context, model, prompt, tools” but respond to every error by rewriting the prompt.</p>\n          <p><strong>Fix:</strong> before retrying, write one sentence per dimension: what context was present, which model property mattered, what the prompt required, and which tool/permission enabled the failed transition. Eliminate dimensions with evidence. The Core Four becomes valuable only when it changes your debugging behavior.</p>\n          <p>A related failure is giving the tools circle unlimited power so the workflow cannot be blocked. That avoids permission friction by deleting a safety boundary. TAC-1 teaches the opposite habit: inspect and deliberately bound what the agent may do.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>Permissions became richer; the audit habit survived</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>The flat allowlist shown in TAC-1 still communicates the primitive cleanly. Current Claude Code practice also includes permission modes, deny rules, hooks around tool use, sandboxed Bash, and settings layered across user, project, and local scopes. The modern surface is larger; the timeless habit is unchanged: inspect what the agent may do before you run it.</p>\n            <p class=\"current-practice__source\">Teaching rule: learn the visible allowlist first, then add richer gates when the workflow requires them.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Core Four retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Name the Big Three and the one added dimension.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Context, model, prompt; tools are added to form the Core Four.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What exact capability makes the tools dimension phase-two significant?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Prompts that can reliably execute long chains of tool calls.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What is Dan’s rebuttal to “tool calling isn’t new”?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Novelty is not the deciding issue; the change is useful scale, performance, and reliable long-chain execution.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Which allowed tool proves the agent can commit but not publish?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p><code>Bash(git commit:*)</code> is allowed, while no <code>git push</code> permission appears.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Diagnose aloud:</strong> an agent creates the correct files and runs them, but cannot make the requested commit. Walk through all four dimensions, then explain why tools/permission is the leading hypothesis. Finish with Dan’s scale-and-performance answer.</p>\n            <p class=\"fine\">Pass if you use evidence rather than “the AI is flaky.”</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-ab\">\n        <span class=\"section-number\">05</span>\n        <h2 class=\"section-title\">Two prompts, one monumental difference</h2>\n        <p class=\"section-lead\">The chapter’s A/B test holds repository, model, and operator constant. Prompt A creates a file. Prompt B carries an engineering workflow. Run both; the delta is the lesson.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>“Both made files, so they are basically the same”</h3>\n          <p>A learner runs both prompts and notices that <code>main_aic.py</code> and <code>main_tac.py</code> now exist. They conclude that the second prompt is merely a longer code-generation request. The visible artifacts conceal the real difference because files are the residue of both processes.</p>\n          <p>To see the delta, ignore the final directory for a moment and compare state transitions. Before Prompt A, one file is absent; afterward, it exists. Before Prompt B, the repository is on a starting branch with incomplete artifacts; afterward, a named branch exists, a second file exists, two programs have been executed, their output has been observed, changes have been staged and committed with a named message, a todo sequence has drained, and a report has been returned. The second prompt did not merely produce more. It moved the repository through an ordered series of verified states.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — AI coding versus agentic coding</p>\n          <h3>Compare verbs, states, and evidence</h3>\n          <div class=\"comparison\">\n            <article class=\"comparison__card\">\n              <div class=\"comparison__head\"><p class=\"eyebrow\">Phase 1</p><h3>AI Coding Prompt</h3><p>A request to create code.</p></div>\n              <div class=\"comparison__body\">\n                <pre><code>CREATE main_aic.py:\n    print goodbye ai coding</code></pre>\n                <ul>\n                  <li><strong>Verb:</strong> create</li>\n                  <li><strong>State change:</strong> one file appears</li>\n                  <li><strong>Execution:</strong> human runs it later</li>\n                  <li><strong>Repository action:</strong> none requested</li>\n                  <li><strong>Evidence:</strong> file content</li>\n                </ul>\n              </div>\n            </article>\n            <article class=\"comparison__card comparison__card--agentic\">\n              <div class=\"comparison__head\"><p class=\"eyebrow\">Phase 2</p><h3>Agentic Coding Prompt</h3><p>A runbook for engineering work.</p></div>\n              <div class=\"comparison__body\">\n                <pre><code>RUN: checkout branch\nCREATE: main_tac.py\nRUN: execute both files\nRUN: add + commit</code></pre>\n                <ul>\n                  <li><strong>Verbs:</strong> run, create, run</li>\n                  <li><strong>State changes:</strong> branch, file, index, commit</li>\n                  <li><strong>Execution:</strong> agent runs both programs</li>\n                  <li><strong>Repository action:</strong> explicit Git workflow</li>\n                  <li><strong>Evidence:</strong> trace, outputs, commit, report</li>\n                </ul>\n              </div>\n            </article>\n          </div>\n          <p>A useful test: if you can describe a prompt’s success only by naming generated files, you may be looking at AI coding. If you can describe ordered state transitions and evidence, you are looking at an agentic workflow.</p>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>Watch the todo list become a repository history</h3>\n          <p>Dan first pastes the AI Coding Prompt. Claude Code writes <code>main_aic.py</code>. He calls it familiar: something you have seen a million times. Then he pastes the Agentic Coding Prompt. This time the agent turns the instruction into a checklist and executes the work step by step.</p>\n          <div class=\"frame-grid\">\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0700-ai-coding-prompt-run.jpg\" alt=\"The AI coding prompt creating main_aic.py in Claude Code\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">11:40</span>The baseline: one prompt creates one file. Useful, but the human still owns the surrounding workflow.</figcaption>\n            </figure>\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0748-agentic-prompt-checklist.jpg\" alt=\"Claude Code turns the agentic prompt into a todo checklist\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">12:28</span>The prompt becomes an execution plan. The todo list externalizes intermediate state so the chain can be carried rather than merely described.</figcaption>\n            </figure>\n          </div>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0790-agentic-prompt-results.jpg\" alt=\"Full agentic coding result showing branch, file writing, program output, commit, and completed todos\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">13:10</span>The after picture: branch checkout, file creation, both UV runs, Git add and commit, todos completed. This trace—not the print statements—is the phase-two artifact.</figcaption>\n          </figure>\n          <p>Dan’s one move is to make process visible. The agent’s checklist, tool trace, command output, and commit expose a chain that a human would otherwise carry implicitly. That visibility makes the workflow inspectable and, later, programmable.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>The Agentic Coding Prompt</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Agentic Coding Prompt:</strong> a prompt containing a sequence of tool calls. In plain English, it is a workflow specification that an agent can execute.</p>\n          </aside>\n          <p>The README uses a compact runbook grammar: <code>RUN</code>, <code>CREATE</code>, <code>RUN</code>. These headings separate kinds of action. The first RUN establishes repository state. CREATE defines an artifact. The final RUN executes and records the work. In <code>programmable/prompt.md</code>, a fourth heading—<code>REPORT</code>—makes the output contract explicit.</p>\n          <p>The headings are not magic syntax. Their value is structural clarity. A weak prompt mixes goal, starting state, implementation, commands, and success into a paragraph. A runbook shape lets both human and model see the sequence. It also makes omission easier to detect. If no REPORT block exists, a headless caller may receive an unhelpful narrative. If no starting branch is declared, reruns may begin from ambiguous state.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — trace every line</p>\n          <h3>Read the README prompt as a state machine</h3>\n          <pre><code>RUN:\n    checkout a new/existing \"demo-agentic-coding\" git branch\n\nCREATE main_tac.py:\n    print \"hello agentic coding\"\n    print a concise explanation of the definition of ai agents\n\nRUN:\n    uv run main_aic.py\n    uv run main_tac.py\n    git add .\n    git commit -m \"Demo agentic coding capabilities\"</code></pre>\n          <div class=\"workflow\" aria-label=\"Agentic prompt state transitions\">\n            <div class=\"workflow__step\"><strong>1 · Isolate</strong><code>checkout branch</code></div>\n            <div class=\"workflow__step\"><strong>2 · Produce</strong><code>create file</code></div>\n            <div class=\"workflow__step\"><strong>3 · Observe</strong><code>run both</code></div>\n            <div class=\"workflow__step\"><strong>4 · Record</strong><code>add + commit</code></div>\n            <div class=\"workflow__step\"><strong>5 · Return</strong><code>trace/report</code></div>\n          </div>\n          <p>Line one establishes isolation. The CREATE block specifies two observable behaviors without dictating a full implementation. The next two commands turn code into evidence: <code>uv run main_aic.py</code> should print <code>goodbye ai coding</code>; <code>uv run main_tac.py</code> should print <code>hello agentic coding</code> followed by a concise definition. The final two commands preserve the result in Git.</p>\n          <p>The five-action delta you should write in Checkpoint 1 is:</p>\n          <ol>\n            <li>Checkout the named branch.</li>\n            <li>Create the second file to a behavioral specification.</li>\n            <li>Execute both programs and expose their outputs.</li>\n            <li>Stage and commit the change with the specified message.</li>\n            <li>Manage the sequence and report completion.</li>\n          </ol>\n          <p>The prompt depends on <code>main_aic.py</code> from the first interactive run. That dependency is why <code>programmable/prompt.md</code> later creates both files: a headless workflow must be self-contained enough to run from its declared starting state.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — reproduce the A/B test</p>\n          <h3>Do not substitute reading for running</h3>\n          <ol>\n            <li>From the cloned TAC-1 repo, start Claude Code.</li>\n            <li>Paste the README’s AI Coding Prompt. Confirm <code>main_aic.py</code> exists, then run <code>uv run main_aic.py</code> yourself.</li>\n            <li>Before Prompt B, write what did <em>not</em> happen: no branch, no execution by the agent, no commit.</li>\n            <li>Paste the Agentic Coding Prompt. Watch the checklist form and drain.</li>\n            <li>Verify branch, generated behavior, execution trace, commit message, and report.</li>\n          </ol>\n          <div class=\"terminal\" aria-label=\"Verification commands\">\n            <div class=\"terminal__bar\"><span class=\"terminal__dot\"></span><span class=\"terminal__dot\"></span><span class=\"terminal__dot\"></span></div>\n            <pre><code>$ git branch --show-current\ndemo-agentic-coding\n\n$ uv run main_aic.py\ngoodbye ai coding\n\n$ uv run main_tac.py\nhello agentic coding\n[one concise AI-agent definition]\n\n$ git log --oneline -1\n[hash] Demo agentic coding capabilities</code></pre>\n          </div>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: comparing artifacts instead of transitions</h3>\n          <p><strong>Symptom:</strong> your A/B notes say “Prompt A made one Python file; Prompt B made another Python file.”</p>\n          <p><strong>Fix:</strong> use verbs and evidence. Write <em>checkout, create, execute, observe, stage, commit, report</em>. Then connect each verb to a tool permission and a verifiable state. The monumental difference is not that Prompt B is longer or that the code is smarter. It is that the prompt carries engineering actions end to end.</p>\n          <p><strong>Secondary stall:</strong> the branch already exists, so checkout behavior differs. Return to <code>main</code> and delete <code>demo-agentic-coding</code> between clean reproductions. The prompt says new/existing, so reuse is valid behavior; the clean reset simply makes the demonstration unambiguous.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The runbook shape spread; the lesson still teaches the primitive</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>RUN/CREATE/RUN/REPORT is now recognizable across command files, reusable skills, CI-oriented prompts, and agent workflows. Modern packaging can add schemas and hooks, but do not skip the plain prompt. Its lack of magic is pedagogically useful: every transition is visible, so you can tell what the runtime must provide.</p>\n            <p class=\"current-practice__source\">Rule: teach the workflow in raw form before packaging it into a reusable abstraction.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"A/B demo retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Name five actions Prompt B performed that Prompt A did not.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Branch checkout; second specified file; execution of both programs; Git add and commit; todo management and final report.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Why is <code>uv run</code> load-bearing in the comparison?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It turns generated code into observed behavior. The agent does not merely write; it executes and can use the outputs as evidence.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. Why does <code>programmable/prompt.md</code> create <code>main_aic.py</code> too?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>To make the headless workflow self-contained rather than dependent on the earlier interactive phase-one run.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. What is the most useful definition of an Agentic Coding Prompt here?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>A workflow specification containing a sequence of reliably executed tool calls.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Draw the comparison from memory.</strong> On the left, write the one state transition of Prompt A. On the right, draw Prompt B as branch → create → run → commit → report. Explain why two final files do not make the processes equivalent.</p>\n            <p class=\"fine\">Pass if your listener can point to the exact boundary where code generation becomes engineering workflow execution.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-tool\">\n        <span class=\"section-number\">06</span>\n        <h2 class=\"section-title\">Why this tool class works</h2>\n        <p class=\"section-lead\">The lesson names three essential elements behind reliable agentic coding: a reasoning-capable model, consistent long tool chains, and the right agent architecture. Treat them as a transferable evaluation checklist.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>A model that can code but cannot carry the work</h3>\n          <p>You can have a brilliant model that writes the right function in isolation yet loses the goal after six tool calls. You can have a tool-rich shell around a weak model that follows commands literally but cannot recover when repository state differs. You can have both inside an architecture that forgets observations, loops without limits, or exposes the wrong action surface.</p>\n          <p>“Which model is best?” is therefore too small a question for agentic coding. The unit under evaluation is the combined system. TAC-1’s agentic prompt requires the system to interpret a runbook, plan it, call file and shell tools in order, preserve outputs as context, and know when the requested end state has been reached. A high benchmark score on code generation does not prove that chain.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — a three-legged platform</p>\n          <h3>Remove one element and reliability collapses</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 840 430\" role=\"img\" aria-labelledby=\"platform-title platform-desc\">\n                <title id=\"platform-title\">Three essential elements supporting reliable agentic coding</title>\n                <desc id=\"platform-desc\">Reasoning model, long tool-chain consistency, and agent architecture support a platform labeled reliable agentic coding at scale.</desc>\n                <rect x=\"120\" y=\"80\" width=\"600\" height=\"86\" rx=\"18\" fill=\"var(--accent-wash)\" stroke=\"var(--accent)\" stroke-width=\"3\"/>\n                <text x=\"420\" y=\"118\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-display)\" font-weight=\"700\" font-size=\"var(--text-diagram-xl)\">Reliable agentic coding</text>\n                <text x=\"420\" y=\"147\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">at useful scale and performance</text>\n                <path d=\"M170 166 L240 338 L320 338 L335 166 Z\" fill=\"var(--ok-wash)\" stroke=\"var(--ok)\" stroke-width=\"3\"/>\n                <path d=\"M335 166 L385 338 L465 338 L505 166 Z\" fill=\"var(--bg-inset)\" stroke=\"var(--ink-soft)\" stroke-width=\"3\"/>\n                <path d=\"M505 166 L520 338 L600 338 L670 166 Z\" fill=\"var(--bg-inset)\" stroke=\"var(--ink-soft)\" stroke-width=\"3\"/>\n                <text x=\"270\" y=\"226\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">MODEL</text>\n                <text x=\"270\" y=\"256\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">reason when</text><text x=\"270\" y=\"278\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">needed</text>\n                <text x=\"420\" y=\"226\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">CHAINS</text>\n                <text x=\"420\" y=\"256\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">call tools</text><text x=\"420\" y=\"278\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">consistently</text>\n                <text x=\"570\" y=\"226\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">ARCHITECTURE</text>\n                <text x=\"570\" y=\"256\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">hold state, route</text><text x=\"570\" y=\"278\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">actions, stop</text>\n                <rect x=\"145\" y=\"338\" width=\"550\" height=\"24\" rx=\"12\" fill=\"var(--ink)\"/>\n              </svg>\n            </div>\n            <figcaption>A great model is necessary but not sufficient. Long-chain behavior emerges from the combined platform.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>From “why now?” to an evaluation frame</h3>\n          <p>After introducing the Core Four, Dan asks why reliable agentic coding became possible at this point. His answer is the combination of three elements: a powerful language model that can reason when needed, the ability to consistently call long chains of tools, and the right agent architecture.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0903-claude-code-three-elements.jpg\" alt=\"Slide listing Claude Code's three essential elements\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">15:03</span>The slide explains the form factor. Carry the checklist forward even when model names and interfaces change.</figcaption>\n          </figure>\n          <p>Dan positions Claude Code as the phase-two tool that combined these elements properly first, much as Aider represented phase-one AI coding in his framing. But he immediately protects the tactic from tool lock-in: interfaces will change, models will improve, competitors will copy capabilities. The portable lesson is the checklist, not allegiance to one screen.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Three essential elements</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s checklist</p>\n            <p><strong>1.</strong> A powerful model that can reason when needed. <strong>2.</strong> Consistent long chains of tool calls. <strong>3.</strong> The right agent architecture.</p>\n          </aside>\n          <p>In plain English:</p>\n          <ul>\n            <li>The <strong>model</strong> must interpret goals, code, output, and unexpected states rather than pattern-match one response.</li>\n            <li>The <strong>chain</strong> must survive many transitions. Reliability compounds: if each step is weak, a long workflow fails often even when individual steps look good.</li>\n            <li>The <strong>architecture</strong> must present context and tools, preserve observations, manage turns, expose progress, handle errors, and stop at a useful boundary.</li>\n          </ul>\n          <p>Dan’s historical claim is that reliable agentic coding at scale was not possible before this combination. You do not need to debate the date to use the checklist. Any candidate tool must demonstrate the combined behavior on your workflow.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — evaluate the TAC-1 run</p>\n          <h3>Map the evidence to the three elements</h3>\n          <table>\n            <thead><tr><th>Observed TAC-1 behavior</th><th>Element evidenced</th><th>Why it matters</th></tr></thead>\n            <tbody>\n              <tr><td>Interprets “new/existing branch” and a behavioral file description</td><td>Reasoning model</td><td>The prompt is not a fixed command script; meaning must be converted into actions.</td></tr>\n              <tr><td>Checks out, writes, runs twice, adds, commits, reports in order</td><td>Long tool chain</td><td>Correctness depends on state flowing between multiple calls.</td></tr>\n              <tr><td>Builds and drains a todo checklist while retaining outputs</td><td>Agent architecture</td><td>The system externalizes progress and carries observations toward completion.</td></tr>\n              <tr><td>Returns a coherent final account</td><td>Architecture + model</td><td>A headless or human caller needs a usable completion boundary.</td></tr>\n            </tbody>\n          </table>\n          <p>Now imagine substitutions. A reasoning model with no Bash tool could describe the commands but not execute them. A shell loop with no reasoning could execute fixed commands but not interpret a concise AI-agent definition or adjust to an existing branch. An architecture that discarded command output could not include exact program output in its report. The demonstration is small enough to expose all three.</p>\n          <aside class=\"callout callout--warning\">\n            <p class=\"callout__label\">Economics are part of operation</p>\n            <p>Dan states that TAC will use millions of tokens across the full course and calls the investment “pay to play.” The chapter does not invent a dollar estimate; costs and plans change. The operational lesson is to budget enough model access that you can run the exercises rather than stopping at recognition.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — tool evaluation card</p>\n          <h3>Judge capabilities with a workflow, not a feature list</h3>\n          <ol>\n            <li>Use the TAC-1 agentic prompt as a benchmark task.</li>\n            <li>For the model, note whether it interprets the outcome and reacts to repository state.</li>\n            <li>For the chain, count ordered tool actions completed without human relay.</li>\n            <li>For architecture, note plan visibility, output retention, errors, permissions, and stopping behavior.</li>\n            <li>Record one observed piece of evidence for each element.</li>\n          </ol>\n          <p>Do not grade on UI similarity to Dan’s recording. A newer or different interface passes when it carries the same primitive reliably.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: tool worship or tool dismissal</h3>\n          <p><strong>Worship:</strong> “Claude Code is the lesson.” This makes every UI change feel like curriculum drift and hides the transferable checklist.</p>\n          <p><strong>Dismissal:</strong> “Any chat model can call a tool, so there is no lesson.” This ignores long-chain reliability, state management, and action architecture.</p>\n          <p><strong>Fix:</strong> demand workflow evidence. Can the system interpret, execute, observe, recover, and stop across the TAC-1 chain? Use the result to compare tools. Preserve the tactic even as the product surface changes.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The form factor grew beyond the early terminal demo</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current-practice video · plan-approved</p>\n            <p>The extract maps <em>How Claude Code CHANGED Engineering Forever</em> to the newer form factor and programmable embedding story. Watch it as an update layer, not as a replacement for the three-element test.</p>\n            <p class=\"current-practice__source\">Metadata should be rechecked at publication; the ID is supplied by the locked extract.</p>\n          </aside>\n          <div class=\"video-cards video-cards--single\">\n            <a class=\"video-card\" href=\"https://www.youtube.com/watch?v=6fCqj4xFCZI\">\n              <span class=\"video-card__type\">Named gap · form factor</span>\n              <strong>How Claude Code CHANGED Engineering Forever</strong>\n              <p>Extends the lesson’s tool-class and programmable-agent claims into the current surface.</p>\n              <span class=\"video-card__watch\">Open video ↗</span>\n            </a>\n          </div>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Three essential elements retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Name the three essential elements in order.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>A powerful language model that can reason when needed; consistent long chains of tool calls; the right agent architecture.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Why can a strong coding model still be a weak agentic system?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It may not carry long tool chains reliably, or the surrounding architecture may fail to preserve state, route actions, handle errors, or stop well.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. Which TAC-1 behavior most directly evidences architecture?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The todo plan, retained tool observations, bounded permissions, error/completion handling, and final report all evidence the surrounding agent architecture.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. What is transferable when the UI and model names change?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The tactic, Core Four diagnosis, agentic prompt shape, and three-element evaluation checklist.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Evaluate an imaginary tool:</strong> it uses an excellent model and exposes 50 tools, but it often forgets earlier command output and continues after failure. Explain which elements are strong, which is weak, and why tool count does not equal reliable agentic coding.</p>\n            <p class=\"fine\">Pass if you distinguish model, chain, and architecture without falling back to brand preference.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-programmable\">\n        <span class=\"section-number\">07</span>\n        <h2 class=\"section-title\">Programmable agentic coding</h2>\n        <p class=\"section-lead\">Because Claude Code runs in the terminal, any language with terminal access can call it. The agent stops being a place you visit and becomes a function-like component inside a larger system.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The workflow that only exists while you are chatting</h3>\n          <p>You develop a strong interactive routine. You paste a runbook, answer one question, watch the agent work, and receive a useful result. Tomorrow you perform the same ritual again. The prompt is reusable, but the trigger is still you. The workflow is stored as a habit in your head: open the terminal, start the agent, find the prompt, paste it, wait, copy the result.</p>\n          <p>This is phase two in capability but not yet in reach. The agent can carry engineering work, yet the system cannot invoke that capacity from anywhere else. It cannot be called by a script, a scheduled process, a CI job, or another agentic environment. Dan’s programmable section removes that last dependence with a tiny observation: the tool already runs in a terminal.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — agent as callable component</p>\n          <h3>Prompt in, tool chain inside, report out</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 900 430\" role=\"img\" aria-labelledby=\"callable-title callable-desc\">\n                <title id=\"callable-title\">Programmable agent flow</title>\n                <desc id=\"callable-desc\">Shell, Python, and TypeScript launchers feed the same prompt into claude dash p. The agent uses bounded tools against the repository and returns a report; failure signaling varies by wrapper.</desc>\n                <rect x=\"40\" y=\"62\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--bg-inset)\" stroke=\"var(--border)\" stroke-width=\"2\"/>\n                <text x=\"130\" y=\"94\" text-anchor=\"middle\" fill=\"var(--ink)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">Launcher</text>\n                <text x=\"130\" y=\"121\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">sh · py · ts</text>\n                <rect x=\"40\" y=\"280\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--bg-inset)\" stroke=\"var(--border)\" stroke-width=\"2\"/>\n                <text x=\"130\" y=\"312\" text-anchor=\"middle\" fill=\"var(--ink)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">prompt.md</text>\n                <text x=\"130\" y=\"339\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">RUN/CREATE/REPORT</text>\n                <rect x=\"330\" y=\"132\" width=\"240\" height=\"168\" rx=\"26\" fill=\"var(--accent-wash)\" stroke=\"var(--accent)\" stroke-width=\"4\"/>\n                <text x=\"450\" y=\"184\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-display)\" font-weight=\"700\" font-size=\"var(--text-diagram-2xl)\">claude -p</text>\n                <text x=\"450\" y=\"222\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">agentic runtime</text>\n                <text x=\"450\" y=\"255\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">plan → call → observe → continue</text>\n                <rect x=\"685\" y=\"62\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--ok-wash)\" stroke=\"var(--ok)\" stroke-width=\"2\"/>\n                <text x=\"775\" y=\"94\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">Repository</text>\n                <text x=\"775\" y=\"121\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">files · uv · git</text>\n                <rect x=\"685\" y=\"280\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--bg-inset)\" stroke=\"var(--ink-soft)\" stroke-width=\"2\"/>\n                <text x=\"775\" y=\"312\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">Return</text>\n                <text x=\"775\" y=\"339\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">report · status varies</text>\n                <path d=\"M220 102 C280 102 280 174 330 174\" fill=\"none\" stroke=\"var(--ink-mute)\" stroke-width=\"3\"/>\n                <path d=\"M220 320 C280 320 280 258 330 258\" fill=\"none\" stroke=\"var(--ink-mute)\" stroke-width=\"3\"/>\n                <path d=\"M570 174 C625 174 625 102 685 102\" fill=\"none\" stroke=\"var(--ok)\" stroke-width=\"3\"/>\n                <path d=\"M685 135 C625 135 625 216 570 216\" fill=\"none\" stroke=\"var(--ok)\" stroke-width=\"3\" stroke-dasharray=\"7 7\"/>\n                <path d=\"M570 258 C625 258 625 320 685 320\" fill=\"none\" stroke=\"var(--ink-soft)\" stroke-width=\"3\"/>\n              </svg>\n            </div>\n            <figcaption>The host language only launches the process. The prompt and agent runtime carry the engineering semantics.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>Delete the branch, then watch it re-materialize headlessly</h3>\n          <p>Dan opens the <code>programmable/</code> directory and shows the shape: one prompt plus three launchers. Before running the Python launcher, he returns to <code>main</code> and deletes <code>demo-agentic-coding</code>. That cleanup is not incidental. It establishes a visible before-state so the scripted run can prove reproducibility.</p>\n          <div class=\"frame-grid\">\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t1063-programmable-directory.jpg\" alt=\"The programmable directory showing shell, Python, TypeScript launchers and prompt.md\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">17:43</span>Three launchers, one prompt. The directory view is the architecture in miniature.</figcaption>\n            </figure>\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t1105-programmable-py.jpg\" alt=\"The programmable Python launcher reading prompt.md and calling Claude Code\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">18:25</span>The Python implementation demystifies the pattern: read, invoke, capture, print, propagate status.</figcaption>\n            </figure>\n          </div>\n          <p>From a fresh terminal on <code>main</code>, he runs <code>uv run python programmable/programmable.py</code>. No interactive conversation follows. Claude Code receives the prompt through <code>-p</code>, recreates the branch and both runtime files, runs them, commits, and returns the requested outputs.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t1205-programmable-report.jpg\" alt=\"Headless programmable run returning the requested report with program outputs\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">20:05</span>The report lands back in the host terminal. This closes the first programmable loop: prompt in, engineering actions performed, evidence out.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Programmable agentic coding</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Programmable agentic coding:</strong> invoking an agentic coding tool from a program so your own systems can fire agentic prompts across the software development lifecycle.</p>\n          </aside>\n          <p>Plain English: treat the agent like a function with a deliberately imperfect analogy:</p>\n          <pre><code>result = agent(prompt, repository_context, allowed_tools)</code></pre>\n          <p>The analogy helps because a caller supplies input and receives output. It is imperfect because the agent has side effects: it edits files, runs programs, and changes Git state. That is why permissions, starting state, reports, and exit codes matter. You are not calling a pure text transformer. You are invoking a bounded actor.</p>\n          <p>Dan’s key expansion is spatial: the prompt matters, but so does where the system can invoke it. A prompt trapped in an interactive session depends on your presence. A prompt callable from code can live inside triggers and environments where you are absent. TAC-1 names triggers as later-course material; this lesson only proves the callable primitive.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — all four programmable files</p>\n          <h3>One shared invocation pattern, three error-handling choices</h3>\n          <p>Start with the shared behavior file, <code>programmable/prompt.md</code>. It differs from the README’s agentic prompt in two important ways: it also creates <code>main_aic.py</code>, making the run self-contained, and it ends with a report contract:</p>\n          <pre><code>REPORT:\n    respond with the exact output of both .py files</code></pre>\n          <p>The Shell launcher is the pattern without ceremony:</p>\n          <pre><code>PROMPT_CONTENT=\"$(cat programmable/prompt.md)\"\nOUTPUT=\"$(claude -p \"$PROMPT_CONTENT\")\"\necho \"$OUTPUT\"</code></pre>\n          <p>The Python launcher makes process behavior explicit:</p>\n          <pre><code>with open(\"programmable/prompt.md\", \"r\") as f:\n    prompt_content = f.read()\n\nresult = subprocess.run(\n    [\"claude\", \"-p\", prompt_content],\n    capture_output=True,\n    text=True,\n)\nprint(result.stdout)\nsys.exit(result.returncode)</code></pre>\n          <p>The actual course file also prints standard error when present and catches exceptions. Those details make it the most production-shaped of the three: the caller can distinguish useful output from errors and preserves the child process’s success or failure for an outer system.</p>\n          <p>The TypeScript/Bun launcher reads the same file and uses Bun’s shell template:</p>\n          <pre><code>const promptContent = readFileSync(\"programmable/prompt.md\", \"utf-8\");\nconst output = await $`claude -p ${promptContent}`.text();\nconsole.log(output);</code></pre>\n          <p>The shared core is more important than syntax, but the wrappers are not equally defensive:</p>\n          <div class=\"workflow\">\n            <div class=\"workflow__step\"><strong>Read</strong><code>prompt.md</code></div>\n            <div class=\"workflow__step\"><strong>Invoke</strong><code>claude -p</code></div>\n            <div class=\"workflow__step\"><strong>Capture</strong><code>text output</code></div>\n            <div class=\"workflow__step\"><strong>Return</strong><code>print report</code></div>\n            <div class=\"workflow__step\"><strong>Differentiate</strong><code>error policy</code></div>\n          </div>\n          <p>Shell reads, invokes, captures standard output through command substitution, and echoes it. It does <strong>not</strong> explicitly capture standard error or preserve the child exit code after the final <code>echo</code>. Python explicitly prints standard error and exits with Claude’s return code. The Bun wrapper catches a thrown command error and exits with status 1. Language choice is irrelevant to the agentic semantics because all three can access the terminal; wrapper quality still determines what an outer system can learn about failure.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — headless reproduction</p>\n          <h3>Feel the absence of interaction</h3>\n          <ol>\n            <li>Read <code>programmable/prompt.md</code> and identify the self-contained CREATE plus REPORT differences.</li>\n            <li>Reset exactly: <code>git checkout main &amp;&amp; git branch -D demo-agentic-coding</code>.</li>\n            <li>From <code>main</code>, run <code>uv run python programmable/programmable.py</code>.</li>\n            <li>Do not answer questions or intervene. If the process needs you, record where.</li>\n            <li>Verify the branch, both files, commit, and exact report output independently.</li>\n            <li>Reset between launchers, then repeat with Shell and Bun TypeScript.</li>\n          </ol>\n          <div class=\"checkpoint\"><strong>Checkpoint 2:</strong> explain in one sentence why the language did not matter. Expected idea: anything with terminal access can invoke <code>claude -p</code>; the agentic work lives in the shared prompt and runtime.</div>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: treating the wrapper as too trivial to run</h3>\n          <p><strong>Symptom:</strong> you read the three lines of Shell, say “I get it,” and skip the run. The concept stays intellectually obvious but behaviorally uninstalled.</p>\n          <p><strong>Fix:</strong> delete the branch and execute the Python launcher hands-off. The felt difference matters: an interactive tool waits in a place you visit; a programmable component returns control to a caller. Seeing repository state change while you provide no mid-run input is the lesson.</p>\n          <p>Other common stalls are state errors. If you run from <code>demo-agentic-coding</code> rather than <code>main</code>, the starting state no longer matches the demonstration. If the branch already exists, “new/existing” may legitimately reuse it. Reset between runs so launcher equivalence is what you test.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The three-line launcher has a grown-up form</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>The one-shot <code>claude -p</code> pattern remains the clearest teaching form. Production embedding can add structured JSON or streaming output, allowed-tool controls, permission modes, session continuation, hooks, and Python/TypeScript Agent SDKs. Those capabilities improve control; they do not replace the core idea that the agent is callable.</p>\n            <p>Reusable behavior also moved from manually discovered prompt files toward Agent Skills: <code>SKILL.md</code> packages with metadata and on-demand loading. Learn <code>prompt.md</code> first so the packaging does not hide the workflow.</p>\n            <p class=\"current-practice__source\">Overlay: raw prompt → reusable Skill; bare subprocess → structured agent integration.</p>\n          </aside>\n          <div class=\"video-cards video-cards--single\">\n            <a class=\"video-card\" href=\"https://www.youtube.com/watch?v=X2ciJedw2vU\">\n              <span class=\"video-card__type\">Corrects outdated packaging</span>\n              <strong>RAW Agentic Coding: ZERO to Agent SKILL</strong>\n              <p>Maps the lesson’s reusable prompt primitive to the modern first-class Skill encoding.</p>\n              <span class=\"video-card__watch\">Open video ↗</span>\n            </a>\n          </div>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Programmable agent retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What single property makes Claude Code programmable in Dan’s demonstration?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It runs in the terminal, so any language with terminal access can invoke it through <code>claude -p</code>.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What two additions make <code>prompt.md</code> more headless-ready than the README prompt?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It creates both runtime Python files, making the workflow self-contained, and it requires a REPORT with exact outputs.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What host-side core do all three launchers share, and what does Shell omit?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>All read the prompt, invoke <code>claude -p</code>, and print returned text. The minimal Shell wrapper does not explicitly capture stderr or preserve the Claude process’s failing exit status after <code>echo</code>.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Why is the “agent as function” analogy imperfect?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The call has side effects in the repository and terminal. Starting state, permissions, reports, and exit status therefore matter.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Explain the Python launcher line by line</strong> to someone who thinks “programmable agent” requires a special platform. Then explain why the REPORT and return code matter once the human is not present.</p>\n            <p class=\"fine\">Pass if your explanation covers placement, side effects, evidence, and failure signaling—not just subprocess syntax.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-paradox\">\n        <span class=\"section-number\">08</span>\n        <h2 class=\"section-title\">The contradicting truth: replace yourself</h2>\n        <p class=\"section-lead\">What gets replaced is your repeated execution. What becomes harder to replace is your judgment and ownership of the systems that perform it.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The indispensable bottleneck</h3>\n          <p>A team has one engineer who knows how to complete a fragile release ritual. They know which branch to create, which files to touch, which commands to run, what output is safe, and how to write the final update. Because only they can carry it, the engineer appears indispensable. In reality the team is dependent on an undocumented human workflow.</p>\n          <p>The engineer can protect that dependency, repeating the ritual forever, or encode it into a bounded, reviewable system. Encoding seems to remove their immediate necessity. It also changes their contribution from “person who remembers the steps” to “person who understands, improves, and governs the release system.” The first kind of indispensability is a bottleneck. The second is leverage.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — the paradox resolved</p>\n          <div class=\"paradox\">\n            <blockquote>To become an irreplaceable engineer, you will replace yourself.<cite>Dan · TAC-1, approximately 20:47</cite></blockquote>\n          </div>\n          <div class=\"workflow workflow--spaced\">\n            <div class=\"workflow__step\"><strong>You do it</strong><code>implicit craft</code></div>\n            <div class=\"workflow__step\"><strong>You name it</strong><code>runbook</code></div>\n            <div class=\"workflow__step\"><strong>Agent does it</strong><code>repeatable chain</code></div>\n            <div class=\"workflow__step\"><strong>You review it</strong><code>judgment</code></div>\n            <div class=\"workflow__step\"><strong>You improve it</strong><code>owned leverage</code></div>\n          </div>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>The lesson replaces the operator before it names the paradox</h3>\n          <p>First Dan runs the agentic prompt interactively. He chooses it, pastes it, and watches the system carry the work. Then he deletes the branch and fires the same workflow through Python. The second run removes his interactive presence. By the time Dan states the contradicting truth near the close, the chapter has already enacted it.</p>\n          <p>The replacement is narrow and exact: Dan is no longer necessary to paste the prompt and supervise each transition of this branch-write-run-commit-report workflow. He remains necessary to choose the workflow, explain why it matters, define the permissions, inspect the report, and decide what mechanism to build next. This narrowness protects the idea from hype. You do not replace “the engineer” in one move. You replace one repeated piece of the engineer’s current execution.</p>\n          <aside class=\"callout callout--why\">\n            <p class=\"callout__label\">The ownership move</p>\n            <p>The person who turns tacit work into a reliable system becomes the person who can inspect, adapt, and multiply that system. Automation removes a task while creating a higher-order responsibility.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>The contradicting truth</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>The contradicting truth:</strong> to become irreplaceable, replace yourself.</p>\n          </aside>\n          <p>Plain English: systematically turn your repeated execution into systems, then move your attention to the judgment and design those systems need. “Replace yourself” is a method for discovering the next level of your role. It does not guarantee permanent job safety; Dan explicitly frames evolution as continuous. It creates an asymmetric advantage because you learn to own the machinery of change rather than defend the task being changed.</p>\n          <p>The paradox has two halves that must stay together. Replacement without ownership can become cost cutting. Ownership without replacement becomes a bottleneck. Agentic engineering aims for both: remove yourself from repeated transitions and increase your responsibility for outcome quality.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — replace one TAC-1 ritual</p>\n          <h3>From interactive operator to owner of a callable workflow</h3>\n          <table>\n            <thead><tr><th>Before</th><th>Encoded in TAC-1</th><th>Your higher-order work</th></tr></thead>\n            <tbody>\n              <tr><td>Remember to create the demo branch</td><td>RUN branch instruction</td><td>Define safe starting state and rerun policy</td></tr>\n              <tr><td>Type two tiny programs</td><td>CREATE blocks</td><td>State behavior and review generated implementation</td></tr>\n              <tr><td>Run and copy outputs</td><td>UV commands + REPORT</td><td>Define trustworthy evidence and compare it independently</td></tr>\n              <tr><td>Stage and commit manually</td><td>Git tool chain</td><td>Bound permissions and decide what may be recorded automatically</td></tr>\n              <tr><td>Paste the prompt each time</td><td>Python/Shell/TS launcher</td><td>Choose future triggers and integration boundaries</td></tr>\n            </tbody>\n          </table>\n          <p>The same transformation can be repeated across a career: observe a workflow you carry, make its state and checks explicit, give an agent bounded actions, require evidence, and move yourself to the next unresolved judgment point. TAC-1 does not teach later trigger systems yet, but it gives you the unit those systems will fire.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — the replacement ladder</p>\n          <h3>Name one task, one system, one next responsibility</h3>\n          <ol>\n            <li>Write a repeated task you currently perform.</li>\n            <li>Write the smallest action chain that would replace your repeated execution.</li>\n            <li>Write the evidence you would require before trusting the result.</li>\n            <li>Write the new question or risk that remains yours after the chain runs.</li>\n            <li>Complete the sentence: “I am not making myself unnecessary; I am making my attention available for ___.”</li>\n          </ol>\n          <p>Keep this as a teach-back exercise only during TAC-1. The graded implementation remains inside the course repo.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: reading the paradox as fatalism</h3>\n          <p><strong>Symptom:</strong> “If I automate my work, the company will not need me, so I should protect the manual process.” This treats brittle task ownership as career security.</p>\n          <p><strong>Fix:</strong> state exactly what is replaced and what remains. In TAC-1, prompt pasting and workflow carrying are replaced. Judgment about goals, constraints, permissions, evidence, risk, and improvement remains. Then make that judgment visible by owning the runbook, checks, and review standards rather than hiding the manual ritual.</p>\n          <p>The opposite failure is grandiosity: claiming a tiny launcher replaces an entire engineer. Repair it by narrowing the claim to one workflow. Credible agentic engineering grows by accumulating verified replacements.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>Systems now scale further; responsibility scales too</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>Background agents, subagents, hooks, and parallel worktrees can now replace larger portions of repeated execution than TAC-1’s serial terminal example. The responsibility lesson grows with them: more autonomous reach requires clearer boundaries, stronger evidence, and better ownership. Do not mistake a higher autonomy ceiling for permission to skip review design.</p>\n            <p class=\"current-practice__source\">No additional video card here; the chapter stays within the locked maximum of three overlays.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Replace yourself retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. State the contradicting truth in your own words.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Becoming harder to replace requires automating your own repeated execution and moving to higher-order ownership.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What is replaced in the TAC-1 programmable move?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The human’s repeated prompt-pasting and carrying of the branch-write-run-commit-report workflow.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What becomes more valuable after that replacement?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Judgment about goals, constraints, tool boundaries, evidence, risks, triggers, review, and improvement—plus ownership of the system.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Why is “this launcher replaces an engineer” a bad interpretation?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It overstates a narrow workflow replacement. Credible progress names the exact repeated execution removed and the higher-order work that remains.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Resolve the paradox in one minute.</strong> Use the interactive-to-programmable TAC-1 progression. Name what Dan replaces, what he still owns, and why the second kind of work creates more leverage.</p>\n            <p class=\"fine\">Pass if the explanation is neither fatalistic nor grandiose.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section chapter-section--wide\" id=\"lab\">\n        <span class=\"section-number\">09</span>\n        <h2 class=\"section-title\">Graded lab · Make the phase change real</h2>\n        <p class=\"section-lead\">This 45–75 minute lab runs only in the TAC-1 course repository. You will reproduce the interactive A/B test, invoke the same workflow headlessly from three languages, perturb one permission, and prove mastery without typing application code.</p>\n\n        <aside class=\"callout callout--warning\">\n          <p class=\"callout__label\">Safety and scope contract</p>\n          <p>Work only in a fresh clone of <code>https://github.com/disler/tac-1.git</code> or the local course source at <code>tac/tac-1</code>. Do not transplant the drill into a work repository. Read permissions before running. The course allowlist does not include <code>git push</code>. Reset the demo branch between comparable runs.</p>\n        </aside>\n\n        <h3>Lab map</h3>\n        <div class=\"workflow\" aria-label=\"Lab phases\">\n          <div class=\"workflow__step\"><strong>0 · Audit</strong><code>10 min</code></div>\n          <div class=\"workflow__step\"><strong>1 · A/B</strong><code>15 min</code></div>\n          <div class=\"workflow__step\"><strong>2 · Headless</strong><code>15 min</code></div>\n          <div class=\"workflow__step\"><strong>3 · Stretch</strong><code>15–30 min</code></div>\n          <div class=\"workflow__step\"><strong>4 · Oral</strong><code>5 min</code></div>\n        </div>\n\n        <section class=\"lab-box\" id=\"lab-setup\">\n          <h3 class=\"lab-box__title\">Lab 0 · Setup and permissions audit</h3>\n          <ul class=\"lab-box__meta\"><li>10 minutes</li><li>Required</li><li>Checkpoint 0</li></ul>\n          <p><strong>Failure this prevents:</strong> an agent reaches an action boundary you did not know existed, and you misdiagnose permissions as model unreliability.</p>\n          <ol class=\"lab-box__steps\">\n            <li>Create a fresh directory for TAC course work. Clone and enter the course repository:\n              <pre><code>git clone https://github.com/disler/tac-1.git\ncd tac-1</code></pre>\n            </li>\n            <li>Verify the required toolbelt. Bun is needed only for the TypeScript variant:\n              <pre><code>claude --version\nuv --version\ngit --version\nbun --version</code></pre>\n              <p>On Windows, use WSL as the course environment.</p>\n            </li>\n            <li>Open <code>.claude/settings.json</code>. Write answers before continuing:\n              <ul>\n                <li>Which three file tools are allowed?</li>\n                <li>Which four Git subcommands are allowed?</li>\n                <li>Which obvious Git action is absent?</li>\n                <li>Which non-local tool is enabled?</li>\n              </ul>\n            </li>\n            <li>Open the repository in your IDE. Open an integrated terminal. Dan uses VS Code and <kbd>Cmd</kbd>+<kbd>J</kbd>.</li>\n            <li>Run <code>claude</code> to enter the interactive agent.</li>\n          </ol>\n          <div class=\"checkpoint\">\n            <strong>Checkpoint 0 · no notes.</strong> Say: “Read, Write, Edit; UV run; Git checkout, branch, add, commit; WebSearch; no push permission.” If you cannot retrieve the surface, reread the file. Permission literacy is a graded outcome.\n          </div>\n          <div class=\"lab-box__pass\">\n            <h4>Pass criteria</h4>\n            <ul><li>All required commands report versions.</li><li>You can state what the agent may and may not do.</li><li>You are in the TAC-1 course repository before starting Claude Code.</li></ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-ab\">\n          <h3 class=\"lab-box__title\">Lab 1 · Reproduce Dan’s interactive A/B</h3>\n          <ul class=\"lab-box__meta\"><li>15 minutes</li><li>Required</li><li>Checkpoint 1</li></ul>\n          <p><strong>Failure this exposes:</strong> mistaking “more generated files” for “engineering work carried by an agent.”</p>\n\n          <h4>A · Phase-one baseline</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Open <code>README.md</code> and copy only the <strong>AI Coding Prompt</strong>.</li>\n            <li>Paste it into the interactive Claude Code session and fire.</li>\n            <li>Inspect <code>main_aic.py</code>. Do not hand-edit it.</li>\n            <li>Run it independently:\n              <pre><code>uv run main_aic.py</code></pre>\n              <p>Expected exact output: <code>goodbye ai coding</code>.</p>\n            </li>\n            <li>Write what the agent did not do: it did not create a branch, execute the program as part of the prompt, stage a change, or commit.</li>\n          </ol>\n\n          <h4>B · Phase-two workflow</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Copy the README’s <strong>Agentic Coding Prompt</strong> into the same interactive session.</li>\n            <li>Before the first tool call completes, notice whether a todo plan forms. Watch the steps drain; do not relay intermediate output.</li>\n            <li>Verify the current branch:\n              <pre><code>git branch --show-current</code></pre>\n              <p>Expected: <code>demo-agentic-coding</code>.</p>\n            </li>\n            <li>Inspect <code>main_tac.py</code>. It must print <code>hello agentic coding</code> and a concise, single-line definition of AI agents. The exact definition wording is model-generated, so grade the behavior, not a fabricated fixed sentence.</li>\n            <li>Run both files yourself and compare with the agent trace:\n              <pre><code>uv run main_aic.py\nuv run main_tac.py</code></pre>\n            </li>\n            <li>Inspect the commit:\n              <pre><code>git log --oneline -1</code></pre>\n              <p>The subject must be <code>Demo agentic coding capabilities</code>.</p>\n            </li>\n            <li>Confirm the agent reported what it did and completed its todo sequence.</li>\n          </ol>\n\n          <div class=\"checkpoint\">\n            <strong>Checkpoint 1 · write the delta.</strong> List five things Prompt B did that Prompt A did not. Use action verbs: branch, create, execute, commit, manage/report. This list is the phase change in operational form.\n          </div>\n          <div class=\"lab-box__pass\">\n            <h4>Pass criteria</h4>\n            <ul>\n              <li><code>main_aic.py</code> prints the exact phase-one line.</li>\n              <li>You are on <code>demo-agentic-coding</code>.</li>\n              <li><code>main_tac.py</code> has both required behaviors.</li>\n              <li>Both programs were executed by the agent and independently by you.</li>\n              <li>The required commit exists and your five-action delta is complete.</li>\n            </ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-headless\">\n          <h3 class=\"lab-box__title\">Lab 2 · Reproduce Dan headlessly</h3>\n          <ul class=\"lab-box__meta\"><li>15 minutes</li><li>Required</li><li>Checkpoint 2</li></ul>\n          <p><strong>Failure this exposes:</strong> understanding <code>claude -p</code> as syntax without feeling how a caller replaces the interactive operator.</p>\n          <ol class=\"lab-box__steps\">\n            <li>Read <code>programmable/prompt.md</code> before executing. Write its two changes relative to the README agentic prompt:\n              <ul>\n                <li>It creates <code>main_aic.py</code> too.</li>\n                <li>It requires the exact output of both files in <code>REPORT</code>.</li>\n              </ul>\n            </li>\n            <li>Return to a clean demonstration state exactly as Dan does:\n              <pre><code>git checkout main\ngit branch -D demo-agentic-coding</code></pre>\n              <p>If deletion fails, inspect <code>git branch</code> and confirm you are not currently on the demo branch. Do not improvise destructive Git commands.</p>\n            </li>\n            <li>From a fresh terminal on <code>main</code>, run the Python launcher:\n              <pre><code>uv run python programmable/programmable.py</code></pre>\n            </li>\n            <li>Hands off. Record any point at which the workflow asks for input or permission. A clean run should carry the sequence and return.</li>\n            <li>After completion, verify four independent facts:\n              <ul>\n                <li>the demo branch exists and is current;</li>\n                <li>both runtime files exist;</li>\n                <li>the required commit exists;</li>\n                <li>the printed report contains the actual outputs.</li>\n              </ul>\n            </li>\n            <li>Cross-check report truth by running both programs yourself. A report that sounds plausible but disagrees with execution is not a pass.</li>\n            <li>Reset branch state between runs. Then execute:\n              <pre><code>sh programmable/programmable.sh</code></pre>\n            </li>\n            <li>Reset again and execute the Bun variant:\n              <pre><code>bun run programmable/programmable.ts</code></pre>\n              <p>Bun is optional during the initial tool audit only in the sense that it supports the TypeScript variant; the full Checkpoint 2 requires all three launchers. Install/enable Bun before claiming a complete lab pass.</p>\n            </li>\n          </ol>\n          <div class=\"checkpoint\">\n            <strong>Checkpoint 2 · one sentence.</strong> “The host language does not matter because any program with terminal access can pass the shared prompt to <code>claude -p</code>; the prompt and agent runtime define the engineering workflow.”\n          </div>\n          <div class=\"lab-box__pass\">\n            <h4>Pass criteria</h4>\n            <ul>\n              <li>Python, Shell, and Bun TypeScript all carry the identical workflow headlessly.</li>\n              <li>Every comparable run begins from <code>main</code> without the demo branch.</li>\n              <li>The report matches independent execution.</li>\n              <li>You can explain why the wrapper language is incidental.</li>\n            </ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-stretch\">\n          <h3 class=\"lab-box__title\">Lab 3 · Stretch the loop without typing code</h3>\n          <ul class=\"lab-box__meta\"><li>15–30 minutes</li><li>S1–S4</li><li>Course repo only</li></ul>\n\n          <h4>S1 · Extend REPORT: close one more loop</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Inside Claude Code—not your editor—ask the agent to edit <code>programmable/prompt.md</code> so REPORT also includes the current Git branch name.</li>\n            <li>Review the prompt diff. Confirm the existing exact-output requirement remains.</li>\n            <li>Reset the branch and run the Python launcher.</li>\n            <li>Compare the reported branch with <code>git branch --show-current</code>.</li>\n          </ol>\n          <p><strong>Learning target:</strong> report-back is part of workflow design. The new field creates a new externally checkable claim.</p>\n\n          <h4>S2 · Add a fourth launcher: prove language independence</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Ask Claude Code to inspect the existing Shell, Python, and TypeScript launchers.</li>\n            <li>Ask it to add a launcher in another language already available on your machine—plain Node, Ruby, or Go are examples from the lab specification, not requirements.</li>\n            <li>Require the same invariants: read <code>prompt.md</code>, invoke <code>claude -p</code>, return output, surface errors/failure.</li>\n            <li>Reset, run, and verify the same repository end state.</li>\n          </ol>\n          <p><strong>Learning target:</strong> separate host syntax from the shared agentic workflow.</p>\n\n          <h4>S3 · Break one permission: feel the tools boundary</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Ask Claude Code to remove <code>\"Bash(git commit:*)\"</code> from <code>.claude/settings.json</code>. Review the diff.</li>\n            <li>Reset the demo state and rerun the agentic prompt.</li>\n            <li>Record the exact transition where the system halts, refuses, or asks. Do not summarize it as “Claude failed.”</li>\n            <li>Restore the permission through Claude Code and review the restored file.</li>\n            <li>Complete the sentence: “The prompt described the commit, but the workflow could not cross that state boundary because ___.”</li>\n          </ol>\n          <p><strong>Learning target:</strong> the tools circle bounds what even a correct prompt and capable model can accomplish.</p>\n\n          <h4>S4 · Transfer map: classify your real work</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Time the interactive phase-one and phase-two runs.</li>\n            <li>List real tasks that are AI-coding-prompt-shaped: the needed outcome is primarily generated code.</li>\n            <li>List tasks that are agentic-prompt-shaped: success requires ordered repository or system actions and evidence.</li>\n            <li>Circle one candidate whose repeated transitions could be encoded after the course. Do not run it outside TAC-1 in this lab.</li>\n          </ol>\n          <p><strong>Learning target:</strong> transfer the distinction without expanding the authorized lab scope.</p>\n\n          <div class=\"lab-box__pass\">\n            <h4>Stretch pass criteria</h4>\n            <ul>\n              <li>All file changes were made through Claude Code.</li>\n              <li>S1 report includes the real branch name and both real outputs.</li>\n              <li>S2 adds and verifies a fourth launcher through Claude Code.</li>\n              <li>S3 produces a recorded permission-boundary observation and restores the setting.</li>\n              <li>S4 produces two task-shape lists and one circled transfer candidate.</li>\n              <li>Any settings modification is restored before you finish.</li>\n            </ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-troubleshooting\">\n          <h3 class=\"lab-box__title\">Troubleshooting without abandoning the lesson</h3>\n          <ul class=\"lab-box__meta\"><li>Use when stuck</li><li>Diagnose with Core Four</li></ul>\n          <table>\n            <thead><tr><th>What you observe</th><th>Likely cause</th><th>Repair</th></tr></thead>\n            <tbody>\n              <tr><td>Branch already exists or contains prior runtime files</td><td>Starting state differs</td><td>Checkout <code>main</code>, delete the demo branch, then rerun.</td></tr>\n              <tr><td>Branch cannot be deleted</td><td>You may still be on it</td><td>Use <code>git branch --show-current</code>, checkout <code>main</code>, retry deletion.</td></tr>\n              <tr><td>Commit action blocks</td><td>Permission was removed or not loaded</td><td>Inspect the current settings surface; do not widen it beyond the course list.</td></tr>\n              <tr><td><code>main_aic.py</code> is missing during README Prompt B</td><td>You skipped Prompt A</td><td>Run the interactive A/B in order, or use the self-contained programmable prompt for headless work.</td></tr>\n              <tr><td>Report omits exact output</td><td>Prompt/report contract or execution failed</td><td>Inspect <code>prompt.md</code>, confirm REPORT remains, compare stdout/stderr and independent runs.</td></tr>\n              <tr><td>Bun launcher fails before Claude starts</td><td>Bun tool unavailable</td><td>Verify or install Bun, then rerun; the full three-launcher checkpoint remains incomplete until it passes.</td></tr>\n              <tr><td>You are tempted to repair a file directly</td><td>Ninety-percent trap</td><td>Give the discrepancy and a verification command back to the agent.</td></tr>\n            </tbody>\n          </table>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-final-pass\">\n          <h3 class=\"lab-box__title\">Final pass sheet</h3>\n          <ul class=\"lab-box__meta\"><li>All required</li><li>Grade from evidence</li></ul>\n          <div class=\"lab-box__pass\">\n            <h4>Artifacts and behavior</h4>\n            <ul>\n              <li>□ Zero application code typed by hand.</li>\n              <li>□ Correct permissions audit from memory.</li>\n              <li>□ Correct five-action A/B delta.</li>\n              <li>□ <code>demo-agentic-coding</code> exists with the required commit.</li>\n              <li>□ The commit contains <code>main_aic.py</code> and <code>main_tac.py</code>.</li>\n              <li>□ <code>main_tac.py</code> prints the greeting plus a one-line AI-agent definition.</li>\n              <li>□ Python, Shell, and TypeScript/Bun launchers complete headlessly.</li>\n              <li>□ REPORT agrees with independent execution.</li>\n              <li>□ Any permission removed in S3 has been restored.</li>\n            </ul>\n            <h4>Oral mastery</h4>\n            <ul>\n              <li>□ Big Three and Core Four, with the precise delta.</li>\n              <li>□ Dan’s scale-and-performance rebuttal.</li>\n              <li>□ Claude Code’s three essential elements.</li>\n              <li>□ Why <code>claude -p</code> changes where the workflow can live.</li>\n              <li>□ The contradicting truth resolved without fatalism.</li>\n            </ul>\n          </div>\n        </section>\n      </section>\n\n      <section class=\"chapter-section\" id=\"mastery\">\n        <span class=\"section-number\">10</span>\n        <h2 class=\"section-title\">Mastery check · retrieve, diagnose, teach</h2>\n        <p class=\"section-lead\">Recognition is not the finish line. Close the chapter, answer on paper, then return to reveal. Score operations and reasoning, not exact prose.</p>\n\n        <h3>Round 1 · Foundations</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative foundations quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What are the Big Three?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Context, model, prompt—present in AI coding whether or not they are visible in the interface.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What upgrades them to the Core Four?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Tools, specifically prompts that can reliably execute long chains of tool calls.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What does “Stop Coding” forbid, and what does it preserve?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It forbids hand-typing application code as the default instrument. It preserves and intensifies code generation, understanding, review, planning, and closed-loop design.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Define Commander of Compute without saying “uses AI.”</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>An engineer who aims compute by specifying outcomes, context, constraints, bounded actions, evidence, and triggers to build systems that build systems.</p></details></div>\n        </section>\n\n        <h3>Round 2 · Trace the demo</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative demo quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">5. Reconstruct Prompt B’s state transitions without looking.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Checkout the demo branch; create <code>main_tac.py</code>; run <code>main_aic.py</code>; run <code>main_tac.py</code>; stage files; commit with the specified message; report completion.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">6. Which runtime artifact must exist before the README Agentic Coding Prompt runs, and why?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p><code>main_aic.py</code>, because Prompt B runs it but does not create it. The interactive A/B order supplies it.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">7. What exact commit subject proves the Git portion completed?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p><code>Demo agentic coding capabilities</code>.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">8. What makes <code>prompt.md</code> self-contained and observable?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It creates both Python files, performs the branch/run/commit chain, and demands exact program outputs in REPORT.</p></details></div>\n        </section>\n\n        <h3>Round 3 · Diagnose with the Core Four</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative diagnosis quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">9. The prompt says commit; the model plans commit; the agent cannot execute it after S3. Which dimension failed?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Tools/permission: the commit tool pattern was removed from the allowlist.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">10. The agent edits the wrong <code>prompt.md</code> in a larger repo. What two dimensions should you probe first?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Context—what paths and repository content it saw—and prompt—whether the target path was explicit.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">11. A tool calls all commands but forgets the first program’s output before REPORT. Which essential element is most suspect?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The agent architecture’s state/observation management, though the combined system should be evaluated rather than blaming a label alone.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">12. Why is repeated rerolling a weak diagnostic method?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It changes stochastic output without isolating whether context, model, prompt, or tools caused the failed state transition.</p></details></div>\n        </section>\n\n        <h3>Round 4 · Transfer and judgment</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative transfer quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">13. A prompt generates five excellent files, but a human runs tests, commits, and reports. AI coding or agentic coding?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Primarily AI coding. Output quantity does not move the workflow boundary; the human still carries the engineering transitions.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">14. Why is exact report-back a seed of closed-loop engineering?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It turns internal work into an externally checkable claim that a human or another program can compare with reality and use for the next decision.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">15. When is a tiny workflow a better leverage point than a huge one?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>When it repeats often, has clear state transitions and evidence, and can be carried reliably with low marginal human attention.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">16. Resolve “replace yourself” in one sentence.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Automate your repeated execution so your scarce attention moves to judgment, system ownership, and the next leverage point.</p></details></div>\n        </section>\n\n        <aside class=\"callout callout--why\">\n          <p class=\"callout__label\">Scoring</p>\n          <p><strong>13–16 correct:</strong> ready to teach and proceed. <strong>9–12:</strong> rerun the lab checkpoint associated with each miss. <strong>0–8:</strong> redraw the phase map and Core Four, then reproduce the A/B test again. A recognized answer that you cannot use in diagnosis counts as half credit.</p>\n        </aside>\n\n        <h3>Capstone teach-back</h3>\n        <div class=\"teach-back\">\n          <p>Without notes, teach a colleague for five minutes:</p>\n          <ol>\n            <li>Why reliable long tool chains—not tool calling itself—separate agentic coding from AI coding.</li>\n            <li>How the two README prompts provide evidence.</li>\n            <li>What the Core Four are and how to use them to diagnose a failed commit.</li>\n            <li>What <code>claude -p</code> unlocks that an interactive session does not.</li>\n            <li>Why replacing the operator of one workflow can make the engineer more valuable.</li>\n          </ol>\n          <p class=\"fine\">Expert pass: your listener can reconstruct the course workflow and predict the effect of removing <code>Bash(git commit:*)</code>.</p>\n        </div>\n      </section>\n\n      <section class=\"chapter-section\" id=\"glossary\">\n        <span class=\"section-number\">11</span>\n        <h2 class=\"section-title\">TAC-1 glossary</h2>\n        <p class=\"section-lead\">Use Dan’s terms consistently. Each definition below is narrow enough to test against the lesson repository.</p>\n        <dl class=\"glossary\">\n          <div><dt>TAC</dt><dd>Tactical Agentic Coding: eight lessons, eight tactics, and one course codebase per lesson.</dd></div>\n          <div><dt>Loot box</dt><dd>The per-lesson collection of prompts, links, notes, and assets. The transcript may mishear it as “loop box.”</dd></div>\n          <div><dt>AI coding</dt><dd>Phase-one prompt-to-code work governed by context, model, and prompt. Useful and foundational, but the human often carries the surrounding workflow.</dd></div>\n          <div><dt>Agentic coding</dt><dd>Phase-two engineering in which the Big Three gain tools and a prompt reliably carries a chain of actions.</dd></div>\n          <div><dt>Agentic Engineer</dt><dd>An engineer who builds systems that can take engineering actions, rather than only prompting for isolated artifacts.</dd></div>\n          <div><dt>Commander of compute</dt><dd>The engineer who aims model capacity through outcomes, context, constraints, tools, evidence, and eventually triggers.</dd></div>\n          <div><dt>Big Three</dt><dd>Context, model, prompt—the primitives present in every AI coding interaction.</dd></div>\n          <div><dt>Core Four</dt><dd>Context, model, prompt, tools—the phase-two diagnostic vocabulary.</dd></div>\n          <div><dt>Context</dt><dd>Everything the model can see while working: repository files, current state, settings, instructions, and tool observations.</dd></div>\n          <div><dt>Model</dt><dd>The language model performing interpretation, reasoning, generation, and decisions inside the agentic system.</dd></div>\n          <div><dt>Prompt</dt><dd>The instruction describing outcome, starting state, constraints, actions, checks, and report. In TAC-1 it becomes a runbook.</dd></div>\n          <div><dt>Tools</dt><dd>The bounded actions an agent may perform. Phase-two significance comes from reliable long chains, not mere tool existence.</dd></div>\n          <div><dt>Agentic Coding Prompt</dt><dd>A workflow specification containing a sequence of tool calls. TAC-1 uses RUN, CREATE, RUN, and later REPORT.</dd></div>\n          <div><dt>Long tool chain</dt><dd>Several ordered actions whose observations and state must carry forward reliably toward one outcome.</dd></div>\n          <div><dt>Programmable agentic coding</dt><dd>Calling an agentic tool from code. In TAC-1, Shell, Python, and TypeScript all pass <code>prompt.md</code> to <code>claude -p</code>.</dd></div>\n          <div><dt>REPORT</dt><dd>The prompt block requiring returned evidence. TAC-1 asks for exact outputs of both generated Python files.</dd></div>\n          <div><dt>Closed loop</dt><dd>A structure where action produces observations that can be checked and used for the next decision rather than ending at generation.</dd></div>\n          <div><dt>System that builds systems</dt><dd>Dan’s description of moving up the stack: construct mechanisms that create and operate software-producing mechanisms.</dd></div>\n          <div><dt>Self-operating machine</dt><dd>The incremental end-state of a codebase whose agentic workflows increasingly run at the right time with bounded oversight.</dd></div>\n          <div><dt>Leverage</dt><dd>More valuable outcome per unit of scarce human attention. The “10x” label is arbitrary; the leverage point determines the multiplier.</dd></div>\n          <div><dt>Stop Coding</dt><dd>Tactic #1: stop hand-typing application code while increasing planning, review, code understanding, and closed-loop design.</dd></div>\n          <div><dt>Contradicting truth</dt><dd>The paradox that automating your repeated execution moves you toward higher-order judgment, improvement, and system ownership.</dd></div>\n        </dl>\n      </section>\n\n      <footer class=\"chapter-footer\">\n        <p class=\"eyebrow\">Volume I · Tactical Agentic Coding</p>\n        <div class=\"chapter-footer__nav\">\n          <a href=\"../index.html\">← Book hub</a>\n          <span class=\"fine\">Next: TAC-2 · The 12 Leverage Points (pending)</span>\n        </div>\n      </footer>\n    </main>\n  </div>\n\n  <script>\n    (() => {\n      const topBar = document.getElementById('top-progress');\n      const railBar = document.getElementById('rail-progress');\n      const label = document.getElementById('progress-label');\n      const links = [...document.querySelectorAll('.chapter-nav a')];\n      const sections = links.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);\n      let progressFramePending = false;\n\n      const updateProgress = () => {\n        const max = document.documentElement.scrollHeight - window.innerHeight;\n        const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;\n        const percent = `${Math.round(value * 100)}%`;\n        topBar.style.width = percent;\n        railBar.style.width = percent;\n        label.textContent = percent;\n      };\n\n      const requestProgressUpdate = () => {\n        if (progressFramePending) return;\n        progressFramePending = true;\n        requestAnimationFrame(() => {\n          updateProgress();\n          progressFramePending = false;\n        });\n      };\n\n      const observer = new IntersectionObserver(entries => {\n        const visible = entries\n          .filter(entry => entry.isIntersecting)\n          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];\n        if (!visible) return;\n        links.forEach(link => {\n          const active = link.getAttribute('href') === `#${visible.target.id}`;\n          if (active) link.setAttribute('aria-current', 'location');\n          else link.removeAttribute('aria-current');\n        });\n      }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, .1, .5] });\n\n      sections.forEach(section => observer.observe(section));\n      updateProgress();\n      window.addEventListener('scroll', requestProgressUpdate, { passive: true });\n      window.addEventListener('resize', requestProgressUpdate);\n    })();\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":73,"oldLines":6,"newStart":73,"newLines":7,"lines":["             <li><a href=\"#idea-paradox\">Replace yourself</a></li>","             <li><a href=\"#lab\">Graded lab</a></li>","             <li><a href=\"#mastery\">Mastery check</a></li>","+            <li><a href=\"#glossary\">Glossary</a></li>","           </ol>","         </details>","       </div>"]}],"userModified":false,"replaceAll":false}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxN9x7jN4wp2nHM4Lnou","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015moUjeMMyy5PWgo9Dk9YkH","name":"Edit","input":{"replace_all":false,"file_path":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html","old_string":"                <pre><code>RUN: checkout branch\nCREATE: main_tac.py\nRUN: execute both files\nRUN: add + commit</code></pre>","new_string":"                <pre><code>RUN: checkout branch\nCREATE: main_tac.py\nRUN: execute both files,\n     add + commit</code></pre>"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4260,"cache_read_input_tokens":210438,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4260},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f","uuid":"4e957283-7413-440d-9aa7-5397ad7d0813","request_id":"req_011CcxN9t8sJ1TYZPrxdHbHJ"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015moUjeMMyy5PWgo9Dk9YkH","type":"tool_result","content":"The file /Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f","uuid":"9f0c9bd5-06ab-48be-8999-dc3ea748f127","timestamp":"2026-07-12T15:02:20.204Z","tool_use_result":{"filePath":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/vol-1-tac/01-hello-agentic-coding.html","oldString":"                <pre><code>RUN: checkout branch\nCREATE: main_tac.py\nRUN: execute both files\nRUN: add + commit</code></pre>","newString":"                <pre><code>RUN: checkout branch\nCREATE: main_tac.py\nRUN: execute both files,\n     add + commit</code></pre>","originalFile":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"description\" content=\"A teaching-first companion to TAC-1: Hello Agentic Coding. Learn the Core Four, stop hand-typing code, and turn Claude Code into a programmable agent.\">\n  <title>TAC-1 · Hello Agentic Coding — IndyDevDan Expert Book</title>\n  <link rel=\"stylesheet\" href=\"../design/tokens.css\">\n  <link rel=\"stylesheet\" href=\"../design/base.css\">\n  <link rel=\"stylesheet\" href=\"../design/components.css\">\n  <link rel=\"stylesheet\" href=\"01-hello-agentic-coding.assets.css\">\n</head>\n<body>\n  <div class=\"reading-progress\" aria-hidden=\"true\"><span class=\"reading-progress__bar\" id=\"top-progress\"></span></div>\n  <header class=\"site-bar\">\n    <a class=\"site-bar__home\" href=\"../index.html\" aria-label=\"Back to the book hub\">← IndyDevDan Expert Book</a>\n    <span class=\"site-bar__meta\">VOL I · TAC · CHAPTER 01</span>\n  </header>\n\n  <div class=\"chapter-shell\">\n    <aside class=\"chapter-rail\" aria-label=\"Chapter navigation\">\n      <p class=\"rail-kicker\">Volume I · Chapter 1</p>\n      <h2>Hello Agentic Coding</h2>\n      <div class=\"rail-progress\">\n        <p class=\"micro-label\">Reading progress</p>\n        <div class=\"rail-progress__line\"><span class=\"rail-progress__fill\" id=\"rail-progress\"></span></div>\n        <p class=\"rail-progress__copy\"><span id=\"progress-label\">0%</span><span>of chapter</span></p>\n      </div>\n      <nav class=\"chapter-nav\" aria-label=\"On this page\">\n        <ol>\n          <li><a href=\"#orientation\"><span class=\"chapter-nav__n\">00</span><span>Orientation</span></a></li>\n          <li><a href=\"#idea-role\"><span class=\"chapter-nav__n\">01</span><span>The new role</span></a></li>\n          <li><a href=\"#idea-mission\"><span class=\"chapter-nav__n\">02</span><span>Mission &amp; leverage</span></a></li>\n          <li><a href=\"#idea-stop\"><span class=\"chapter-nav__n\">03</span><span>Stop coding</span></a></li>\n          <li><a href=\"#idea-core-four\"><span class=\"chapter-nav__n\">04</span><span>The Core Four</span></a></li>\n          <li><a href=\"#idea-ab\"><span class=\"chapter-nav__n\">05</span><span>The A/B demo</span></a></li>\n          <li><a href=\"#idea-tool\"><span class=\"chapter-nav__n\">06</span><span>Why this tool class works</span></a></li>\n          <li><a href=\"#idea-programmable\"><span class=\"chapter-nav__n\">07</span><span>Programmable agent</span></a></li>\n          <li><a href=\"#idea-paradox\"><span class=\"chapter-nav__n\">08</span><span>Replace yourself</span></a></li>\n          <li><a href=\"#lab\"><span class=\"chapter-nav__n\">09</span><span>Graded lab</span></a></li>\n          <li><a href=\"#mastery\"><span class=\"chapter-nav__n\">10</span><span>Mastery check</span></a></li>\n          <li><a href=\"#glossary\"><span class=\"chapter-nav__n\">11</span><span>Glossary</span></a></li>\n        </ol>\n      </nav>\n    </aside>\n\n    <main class=\"chapter-main\" id=\"main-content\">\n      <header class=\"hero\">\n        <span class=\"hero__chapter\">Tactic #1 · Stop Coding</span>\n        <h1>Hello Agentic Coding</h1>\n        <p class=\"hero__dek\">The decisive move is not a better code-generation prompt. It is turning a prompt into a reliable engineering workflow—and turning the agent into a component you can call.</p>\n        <ul class=\"hero__meta\" aria-label=\"Chapter details\">\n          <li>Video spine · 21:51</li>\n          <li>Lab · 45–75 min</li>\n          <li>Course repo · tac/tac-1</li>\n          <li>Level · weak beginner → operator</li>\n        </ul>\n        <p class=\"hero__promise\"><strong>Mastery promise.</strong> By the end, you will be able to diagnose agentic work with the Core Four, explain the exact difference between AI coding and agentic coding, reproduce Dan’s interactive and headless demos, and teach why “replace yourself” is a leverage strategy rather than a surrender.</p>\n      </header>\n\n      <div class=\"mobile-toc\">\n        <details>\n          <summary>Chapter contents</summary>\n          <ol>\n            <li><a href=\"#orientation\">Orientation</a></li>\n            <li><a href=\"#idea-role\">The new role</a></li>\n            <li><a href=\"#idea-mission\">Mission and leverage</a></li>\n            <li><a href=\"#idea-stop\">Stop coding</a></li>\n            <li><a href=\"#idea-core-four\">The Core Four</a></li>\n            <li><a href=\"#idea-ab\">The A/B demo</a></li>\n            <li><a href=\"#idea-tool\">Why this tool class works</a></li>\n            <li><a href=\"#idea-programmable\">Programmable agent</a></li>\n            <li><a href=\"#idea-paradox\">Replace yourself</a></li>\n            <li><a href=\"#lab\">Graded lab</a></li>\n            <li><a href=\"#mastery\">Mastery check</a></li>\n            <li><a href=\"#glossary\">Glossary</a></li>\n          </ol>\n        </details>\n      </div>\n\n      <section class=\"chapter-section\" id=\"orientation\">\n        <span class=\"section-number\">00</span>\n        <h2 class=\"section-title\">Begin with the failure, not the slogan</h2>\n        <p class=\"section-lead\">You ask an AI to write a function. It gives you plausible code. You paste it into the repository, discover that it does not fit, repair two imports, run the tests, fix a test, create a branch, make the commit, and explain the result in Slack. The AI helped with one narrow slice. You still carried the workflow.</p>\n\n        <p>That is the concrete failure TAC-1 addresses. The problem is not that the generated code was bad. The problem is that the unit of delegation was too small. You delegated <em>typing</em> while retaining every transition that makes typing useful: reading the repository, choosing a safe branch, creating files, running programs, observing output, committing a coherent change, and reporting what happened. AI coding accelerated an activity. Agentic coding delegates an outcome-producing chain.</p>\n\n        <p>Dan’s lesson makes this distinction with almost comical economy. The source repository contains only seven files. Its README is exactly 35 lines. The generated programs print tiny messages. That smallness is deliberate. A realistic codebase would let you confuse complexity with the concept. Here the application code is so trivial that the only interesting variable is <strong>who moves the work through the engineering system</strong>.</p>\n\n        <aside class=\"callout callout--tactic\">\n          <p class=\"callout__label\">The chapter’s one-sentence thesis</p>\n          <p>AI coding uses context, model, and prompt to generate code. Agentic coding keeps those three and adds tools that can be executed reliably in a long chain—so the prompt becomes a workflow and the agent performs engineering work.</p>\n        </aside>\n\n        <h3>What you are training</h3>\n        <ul class=\"learning-objectives\">\n          <li><strong>Discrimination</strong>Tell code generation apart from workflow execution even when both begin with a prompt.</li>\n          <li><strong>Diagnosis</strong>Locate failures in context, model, prompt, or tools instead of blindly rerolling.</li>\n          <li><strong>Operation</strong>Reproduce the branch → write → run → commit → report cycle in the real TAC-1 repo.</li>\n          <li><strong>Transfer</strong>Recognize how <code>claude -p</code> turns an interactive agent into a programmable building block.</li>\n        </ul>\n\n        <h3>How to use this chapter</h3>\n        <p>Do not read it as a transcript recap. Each major idea repeats the same ten learning moves: failure, picture, one demo move, term, worked example, a small action, failure repair, current-practice overlay, retrieval, and teach-back. That repetition is intentional. Expertise is not the ability to recognize Dan’s phrases. It is the ability to retrieve the idea under pressure, operate it in the course repository, notice when it fails, and explain it without the chapter open.</p>\n\n        <div class=\"callout callout--warning\">\n          <p class=\"callout__label\">Prime directive for every exercise</p>\n          <p>You type zero lines of application code by hand. “Stop coding” is a behavioral constraint, not a discussion topic. You may type prompts and terminal commands. When a generated file is imperfect, repair it through the agent so you practice controlling the loop.</p>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-role\">\n        <span class=\"section-number\">01</span>\n        <h2 class=\"section-title\">A new role: the Agentic Engineer</h2>\n        <p class=\"section-lead\">The title matters only if the work changes. “Agentic Engineer” is not a badge for someone who uses AI often; it names an engineer who builds systems able to take engineering actions.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The prompt expert who is still the workflow engine</h3>\n          <p>Imagine an engineer who can produce excellent code with a one-shot prompt. They know how to attach a specification, point at the right files, and ask for tests. Yet after every answer they manually copy code, open files, run commands, move changes onto a branch, decide whether the output succeeded, and write a summary. Their prompts improved. Their role did not. The human remains the glue between every step.</p>\n          <p>This is why “prompt engineer” is too narrow for Dan’s prediction. A clever request can improve a model’s answer. An agentic system changes who performs the sequence. If the human must relay every output into the next input, the human is still the orchestration layer. The system has intelligence but little agency.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — the two-phase map</p>\n          <h3>Move the boundary of delegation</h3>\n          <div class=\"comparison\" aria-label=\"AI coding and agentic coding roles compared\">\n            <article class=\"comparison__card\">\n              <div class=\"comparison__head\"><h3>Phase 1 · AI coding</h3><p>The agent produces code; the human carries the workflow.</p></div>\n              <div class=\"comparison__body\">\n                <div class=\"workflow workflow--stacked\">\n                  <div class=\"workflow__step\"><strong>Human</strong><code>context → prompt</code></div>\n                  <div class=\"workflow__step\"><strong>Agent</strong><code>generate code</code></div>\n                  <div class=\"workflow__step\"><strong>Human</strong><code>write → run → fix → commit → report</code></div>\n                </div>\n              </div>\n            </article>\n            <article class=\"comparison__card comparison__card--agentic\">\n              <div class=\"comparison__head\"><h3>Phase 2 · Agentic coding</h3><p>The human specifies and reviews; the agent carries the workflow.</p></div>\n              <div class=\"comparison__body\">\n                <div class=\"workflow workflow--stacked\">\n                  <div class=\"workflow__step\"><strong>Human</strong><code>goal + constraints + checks</code></div>\n                  <div class=\"workflow__step\"><strong>Agent</strong><code>branch → write → run → commit → report</code></div>\n                  <div class=\"workflow__step\"><strong>Human</strong><code>review outcome + improve loop</code></div>\n                </div>\n              </div>\n            </article>\n          </div>\n          <p>The important movement is the boundary. The human does not disappear. The human moves from carrying transitions to designing them, setting constraints, and evaluating the result.</p>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>A 2023 bet becomes a visible phase change</h3>\n          <p>Dan opens with a concrete personal bet: in 2023 he bought <em>agenticengineer.com</em>, predicting a role centered on building systems capable of taking engineering actions. The claim is not that engineers vanish. It is that an engineer’s leverage shifts from personally performing actions to constructing systems that can perform them.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0115-phase-1-vs-phase-2.jpg\" alt=\"Dan's phase diagram moving from AI coding in phase one to agentic coding in phase two\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">1:55</span>Dan places AI coding and agentic coding on a two-phase timeline. Keep this scaffold visible: phase two is a superset, not a rejection, of phase one.</figcaption>\n          </figure>\n          <p>His one move is conceptual before it is technical: name the era change. In phase one, prompt-to-code makes code abundant and gives rise to vibe coding. In phase two, the engineering response is to command systems that take actions. That frame prevents the later terminal demo from shrinking into “Claude Code can run Git.” Git commands are merely the visible actions; role redesign is the lesson.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Phase-two Agentic Engineer</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Agentic Engineer:</strong> an engineer who builds systems that can take actions as engineers can.</p>\n          </aside>\n          <p>In plain English: you build the worker and the work path, not merely the artifact at the end. The evidence is behavioral. Does your system know which files to read? Can it create or edit files? Can it execute commands and observe their results? Can it preserve state across steps? Can it report a result that another person or program can evaluate? If yes, you are designing agency. If you only ask for a snippet, you are using generation.</p>\n          <p>The title does not require full autonomy. TAC-1 demonstrates a tiny serial workflow with a person choosing when to launch it. The role begins as soon as you deliberately package actions into a repeatable system. Later tactics can improve triggers, context, focus, and closed loops; none are prerequisites for recognizing the role here.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — walk the course codebase</p>\n          <h3>The repository describes a worker, not a product</h3>\n          <p>Open the course source at <code>tac/tac-1</code>. Before any demo runs, there is no <code>main_aic.py</code> and no <code>main_tac.py</code>. The seven committed files are instructional and operational:</p>\n          <div class=\"file-map\">\n            <div class=\"file-map__item\"><code>README.md</code><p>Holds the phase-one and phase-two prompts plus the three launcher commands.</p></div>\n            <div class=\"file-map__item\"><code>.claude/settings.json</code><p>Declares the tools the agent may use: three file tools, UV, four Git operations, and WebSearch.</p></div>\n            <div class=\"file-map__item\"><code>programmable/prompt.md</code><p>Packages a self-contained branch → create → run → commit → report workflow.</p></div>\n            <div class=\"file-map__item\"><code>programmable/*.{sh,py,ts}</code><p>Calls the same prompt from three host languages, proving the agent is a component.</p></div>\n            <div class=\"file-map__item\"><code>.env.sample</code><p>Contains the API-key placeholder used by the headless billing path.</p></div>\n            <div class=\"file-map__item\"><code>main_*.py</code><p><strong>Not source files at the start.</strong> They are runtime artifacts created by the agent.</p></div>\n          </div>\n          <p>The repository’s product is not the two print statements. Its product is a legible mechanism for directing an agent. This is the Agentic Engineer role reduced until no accidental complexity remains.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — 3 minute drill</p>\n          <h3>Classify the work by who carries the transitions</h3>\n          <ol>\n            <li>Write down one task where you ask an AI for code, then manually install the answer.</li>\n            <li>Underline every transition you still carry: locate, branch, edit, run, inspect, commit, report.</li>\n            <li>Rewrite the task as an outcome with explicit actions and a final report.</li>\n            <li>Do <em>not</em> run it yet. Circle the actions that would require tools or permissions.</li>\n          </ol>\n          <p>Your first draft is successful if it exposes the workflow you normally perform invisibly. The goal is not an elegant prompt. The goal is to see the human glue.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: a title change without a delegation change</h3>\n          <p><strong>Symptom:</strong> you say “agentic” because the tool has an agent mode, but you still approve and relay each micro-step. Or you send a long prompt that generates several files but never executes or verifies them.</p>\n          <p><strong>Fix:</strong> ask a falsifiable question: <em>What engineering action can the system complete without me moving information between steps?</em> Start with one closed chain, not a grand autonomy claim. In TAC-1 that chain is branch → write → run → commit → report. Once the system carries it, your role really has moved.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The ceiling is higher; the primitive is unchanged</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>TAC-1 intentionally shows one agent, one terminal, one serial workflow. Current practice can fan the same shape into subagents, background tasks, and worktree-isolated parallel runs. Do not import that complexity into this first lesson. First learn to specify one reliable chain. Parallelism multiplies both good system design and confused system design.</p>\n            <p class=\"current-practice__source\">Forward pointer: later TAC lessons scale the seed planted here.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <h3>Close the section before revealing answers</h3>\n          <section class=\"retrieval-quiz\" aria-label=\"Retrieval questions for the Agentic Engineer role\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What behavior, not job title, defines Dan’s Agentic Engineer?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Building systems that can take actions as engineers can—such as branching, writing, running, committing, and reporting.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Why is an excellent one-shot code prompt still phase-one shaped?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Because the output is code while the human still carries the engineering workflow around it. Quality does not change who performs the transitions.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What is the smallest observable proof that your role has moved?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>A system completes at least one meaningful multi-action chain without the human relaying intermediate results, then returns evidence for review.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Explain in 60 seconds:</strong> “An Agentic Engineer is not just someone who writes better prompts.” Use one example from the seven-file TAC-1 repository and name the moment when the human stops being workflow glue.</p>\n            <p class=\"fine\">Pass if your explanation includes actions, a repeatable system, and a report—not merely “AI does more.”</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-mission\">\n        <span class=\"section-number\">02</span>\n        <h2 class=\"section-title\">The mission: command compute through leverage</h2>\n        <p class=\"section-lead\">The tactic is emotionally difficult because it asks you to retire a visible skill. The mission supplies the reason: move up the stack from producing keystrokes to designing systems that produce outcomes.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The faster typist who cannot escape throughput</h3>\n          <p>Suppose an engineer doubles their typing speed, memorizes every framework API, and uses autocomplete perfectly. They may produce more code per hour, but every additional unit still consumes their attention. Their throughput is coupled to presence. If they stop, the work stops.</p>\n          <p>Now suppose another engineer spends ten minutes creating a reliable workflow that can be fired again. The first run may be slower than hand-typing. The second run costs almost no new design attention. The tenth run makes the original time investment look tiny. This is why Dan says the 10x engineer does not come from 10x time or effort. The multiplier is leverage, and the number could be 2x, 10x, or 100x depending on the leverage point.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — attention versus repeatability</p>\n          <h3>Effort is linear; a reusable system bends the curve</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 820 390\" role=\"img\" aria-labelledby=\"leverage-title leverage-desc\">\n                <title id=\"leverage-title\">Leverage curve comparing hand work and reusable agentic work</title>\n                <desc id=\"leverage-desc\">Hand work rises linearly with every repetition. Agentic work has an initial design investment, then much lower marginal attention for later runs.</desc>\n                <defs><marker id=\"arrow\" markerWidth=\"10\" markerHeight=\"10\" refX=\"7\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L0,6 L8,3 z\" fill=\"var(--ink-mute)\"/></marker></defs>\n                <line x1=\"90\" y1=\"315\" x2=\"760\" y2=\"315\" stroke=\"var(--ink-mute)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n                <line x1=\"90\" y1=\"315\" x2=\"90\" y2=\"45\" stroke=\"var(--ink-mute)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n                <text x=\"610\" y=\"355\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">workflow repetitions</text>\n                <text x=\"28\" y=\"210\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\" transform=\"rotate(-90 28 210)\">cumulative human attention</text>\n                <path d=\"M110 295 L700 75\" fill=\"none\" stroke=\"var(--warn)\" stroke-width=\"5\"/>\n                <text x=\"540\" y=\"105\" fill=\"var(--warn)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">hand-carry every run</text>\n                <path d=\"M110 295 C145 180 205 155 285 150 C420 142 565 137 700 132\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"6\"/>\n                <circle cx=\"190\" cy=\"164\" r=\"8\" fill=\"var(--accent)\"/>\n                <text x=\"205\" y=\"190\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">design the workflow once</text>\n                <text x=\"470\" y=\"162\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">low marginal attention</text>\n              </svg>\n            </div>\n            <figcaption>The first automated run includes design cost. Leverage appears across repetitions, not in a screenshot of run one.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>He names the enemy, then changes the identity</h3>\n          <p>Dan states the mission with uncomfortable specificity: become an engineer “they” cannot replace—where “they” means your boss, the company, the industry, and AI. The point is not permanent safety; he explicitly says nothing in technology lasts forever. The point is to choose the adaptation with the greatest asymmetric advantage.</p>\n          <div class=\"frame-grid\">\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0124-mission-irreplaceable.jpg\" alt=\"Mission slide naming the engineer they cannot replace\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">2:04</span>The mission supplies the criterion by which later tactics are judged: do they increase your leverage and make your contribution harder to substitute?</figcaption>\n            </figure>\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0162-commander-of-compute.jpg\" alt=\"Commander of Compute title card from TAC-1\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">2:42</span>The identity shift has a name: commander of compute. Your work moves from producing the artifact to aiming the machinery.</figcaption>\n            </figure>\n          </div>\n          <p>The story’s one move is to replace a threatened identity with a higher-order one. If “real engineer” means “person who types the best code,” an agent that types better feels like a rival. If engineering means building systems of leverage that produce valuable outcomes, a capable coding agent becomes new machinery. You are measured by what you can make the machinery reliably accomplish.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Commander of compute</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Commander of compute:</strong> the phase-two engineer who aims powerful models and agentic systems at valuable outcomes, building systems that build systems.</p>\n          </aside>\n          <p>Plain English: stop treating the model like a faster pair of hands and start treating it like programmable capacity. Commanding does not mean shouting more prompts. It means deciding the target, furnishing context, declaring constraints, granting a bounded tool surface, defining success evidence, and choosing when the workflow should run.</p>\n          <p>Dan’s end-state phrase—<strong>self-operating machine</strong>—should be read incrementally. TAC-1 does not claim that a codebase becomes autonomous in one lesson. It shows the smallest seed: one workflow can recreate a branch, files, executions, commit, and report without an interactive human. Every later improvement can move another piece of attention out of the repeated path.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — walk the course codebase</p>\n          <h3>Where the leverage lives in <code>programmable/</code></h3>\n          <p>Separate the TAC-1 headless example into one-time design and repeatable execution.</p>\n          <table>\n            <thead><tr><th>One-time human design</th><th>Repeatable agent execution</th><th>Evidence returned</th></tr></thead>\n            <tbody>\n              <tr><td>Specify a known starting branch</td><td>Checkout <code>demo-agentic-coding</code></td><td>Current branch can be inspected</td></tr>\n              <tr><td>Describe both generated files</td><td>Create <code>main_aic.py</code> and <code>main_tac.py</code></td><td>Files exist with reviewable content</td></tr>\n              <tr><td>Declare execution commands</td><td>Run both files with <code>uv run</code></td><td>Exact outputs appear in the trace/report</td></tr>\n              <tr><td>Declare repository transition</td><td><code>git add .</code> and commit with the specified message</td><td><code>git log</code> exposes the commit</td></tr>\n              <tr><td>Require a report</td><td>Return both program outputs</td><td>The launcher prints a human-readable result</td></tr>\n            </tbody>\n          </table>\n          <p>The two print programs are deliberately disposable. The leverage lives in the durable <code>prompt.md</code> plus launcher pattern. Delete the runtime branch and files, fire the launcher again, and the work reappears. Reproducibility—not code volume—is the first visible multiplier.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — leverage ledger</p>\n          <h3>Measure attention, not impressiveness</h3>\n          <ol>\n            <li>Choose one repeated engineering task from your week.</li>\n            <li>Write the minutes you spend per repetition and the number of repetitions per month.</li>\n            <li>List which steps are judgment and which are deterministic transitions.</li>\n            <li>Mark the smallest complete chain an agent could carry while returning evidence to your judgment point.</li>\n            <li>Estimate break-even: design minutes ÷ minutes saved per run.</li>\n          </ol>\n          <p>A boring five-minute workflow repeated 40 times may be a better leverage point than an impressive hour-long task performed once. This chapter does not authorize using any non-course repository in the lab; this ledger is a planning exercise for transfer after mastery.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: confusing more output with more leverage</h3>\n          <p><strong>Symptom:</strong> you celebrate that an agent generated 2,000 lines, even though reviewing and repairing those lines consumed more attention than the old workflow. Or you automate a one-off task because the demo looks impressive.</p>\n          <p><strong>Fix:</strong> evaluate the ratio Dan’s mission actually cares about: valuable outcome per unit of your attention. Count reruns, intervention points, review load, and evidence quality. A short stable workflow with a clear report is more agentic than a spectacular uncontrolled generation.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>Period detail changes; leverage does not</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>The course-era Claude Code interface and model names are period detail. Newer interfaces, plan modes, and background execution can reduce friction, but they do not change the leverage test. Dan future-proofs the lesson directly: newer models and a different UI are welcome; do not let them distract from the tactic.</p>\n            <p class=\"current-practice__source\">Use today’s tool, but grade it with the same question: how much reliable outcome does one unit of attention purchase?</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Retrieval questions for leverage and mission\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Why does Dan say the “10x” number is arbitrary?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Because the multiplier comes from the leverage point you find. It could be 2x, 10x, or 100x; it does not come from a fixed amount of greater effort.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What makes the programmable demo leverage rather than just automation theater?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The workflow can be recreated repeatedly from a known state with low additional human attention, and it returns evidence through the report.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What does a commander of compute decide?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The target, context, constraints, bounded tools, success evidence, and timing of a system that performs engineering work.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Explain to a skeptical senior engineer:</strong> why a slower first automated run may still create more leverage than a fast manual run. Use the <code>programmable/prompt.md</code> rerun and distinguish outcome volume from attention saved.</p>\n            <p class=\"fine\">Pass if you mention repetition, marginal attention, evidence, and a judgment boundary.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-stop\">\n        <span class=\"section-number\">03</span>\n        <h2 class=\"section-title\">Tactic #1: Stop Coding</h2>\n        <p class=\"section-lead\">The provocation is precise: stop <em>hand-typing</em> application code. Keep generating code. Keep understanding code. Move your scarce cycles to planning, reviewing, and building closed loops.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The ninety-percent trap</h3>\n          <p>An agent produces a nearly correct file. One import is wrong and one edge case is missing. You think, “It will be faster if I just fix those two lines.” You open the editor, type the repair, and move on. The task is complete, but the learning loop is broken.</p>\n          <p>The immediate edit feels efficient because you compare two minutes of hand work with another agent turn. Dan’s tactic compares something larger: a lifetime of carrying repairs versus learning to design prompts, feedback, and checks that make the system repair itself. Every time you silently take the keyboard back, you hide a failure mode from the system. You get the file, but you do not improve the mechanism that will create the next hundred files.</p>\n          <p>This is the behavioral edge of “stop coding.” It does not ask whether you are capable of the fix. It asks whether your personal typing is still the best lever for an outcome you expect to repeat.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — reallocate the engineering cycle</p>\n          <h3>Do not remove engineering; move it around the code</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 860 430\" role=\"img\" aria-labelledby=\"cycle-title cycle-desc\">\n                <title id=\"cycle-title\">Engineering cycles before and after Stop Coding</title>\n                <desc id=\"cycle-desc\">The old cycle centers human attention on typing. The agentic cycle moves human attention to planning, reviewing, and closed-loop design while the agent types and runs.</desc>\n                <text x=\"205\" y=\"42\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">Old allocation</text>\n                <circle cx=\"205\" cy=\"210\" r=\"115\" fill=\"var(--bg-inset)\" stroke=\"var(--border)\" stroke-width=\"2\"/>\n                <circle cx=\"205\" cy=\"210\" r=\"62\" fill=\"var(--warn-wash)\" stroke=\"var(--warn)\" stroke-width=\"3\"/>\n                <text x=\"205\" y=\"205\" text-anchor=\"middle\" fill=\"var(--warn)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">HUMAN</text>\n                <text x=\"205\" y=\"232\" text-anchor=\"middle\" fill=\"var(--warn)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">types code</text>\n                <text x=\"205\" y=\"105\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">plan a little</text>\n                <text x=\"205\" y=\"340\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">review at the end</text>\n                <path d=\"M390 210 L470 210\" stroke=\"var(--accent)\" stroke-width=\"5\"/>\n                <path d=\"M458 197 L478 210 L458 223\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"5\"/>\n                <text x=\"430\" y=\"185\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-base)\">reallocate</text>\n                <text x=\"655\" y=\"42\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-lg)\">Phase-two allocation</text>\n                <circle cx=\"655\" cy=\"210\" r=\"128\" fill=\"var(--ok-wash)\" stroke=\"var(--ok)\" stroke-width=\"3\"/>\n                <circle cx=\"655\" cy=\"210\" r=\"66\" fill=\"var(--accent-wash)\" stroke=\"var(--accent)\" stroke-width=\"3\"/>\n                <text x=\"655\" y=\"204\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">AGENT</text>\n                <text x=\"655\" y=\"231\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">types + runs</text>\n                <text x=\"655\" y=\"100\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-md)\">PLAN</text>\n                <text x=\"530\" y=\"222\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-md)\" transform=\"rotate(-90 530 222)\">REVIEW</text>\n                <text x=\"780\" y=\"220\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"700\" font-size=\"var(--text-diagram-md)\" transform=\"rotate(90 780 220)\">CLOSE LOOP</text>\n                <text x=\"655\" y=\"345\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">human judgment surrounds the run</text>\n              </svg>\n            </div>\n            <figcaption>“Stop coding” removes the human from the typing center, not from the engineering system.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>The tactic is said twice because the easy interpretation is wrong</h3>\n          <p>At 6:47, after establishing the mission and leverage frame, Dan reveals the first tactic: “Stop coding.” He repeats it. Then he sharpens the claim: your hands and your mind are no longer the best tool for the job of writing code. The directness is meant to break a default behavior, not to erase engineering knowledge.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0414-tactic-stop-coding.jpg\" alt=\"Tactic number one Stop Coding reveal from the lesson\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">6:54</span>The headline is intentionally uncomfortable. Read the object of the verb carefully: stop personally <em>typing</em> the code, not producing or understanding it.</figcaption>\n          </figure>\n          <p>Dan grounds the discomfort in his own history. He spent more than a decade hand-coding across startups and large companies, mastering the familiar craft, and says he misses it. That confession matters pedagogically: the tactic is not offered by someone who never valued coding. It is an argument that the best instrument for code production has changed, and that engineers must move their attention to the work the instrument cannot own.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Stop coding ≠ stop engineering</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Exact distinction</p>\n            <p><strong>Stop coding:</strong> stop typing application code by hand. Continue generating more code than before, understanding what it does, reviewing it, and designing systems that can validate and improve it.</p>\n          </aside>\n          <p>Three reallocations make the phrase operational:</p>\n          <ul>\n            <li><strong>Planning:</strong> express outcomes, starting state, constraints, ordered actions, and pass conditions before compute begins.</li>\n            <li><strong>Reviewing:</strong> inspect behavior, diffs, architecture, risks, and evidence. Code understanding becomes more—not less—important when production accelerates.</li>\n            <li><strong>Closed-loop structures:</strong> connect generation to execution and observation so failure becomes feedback the system can act on.</li>\n          </ul>\n          <p>The tactic is therefore a constraint on who makes the keystrokes, not a license to be ignorant. If your agent generates ten times more code, your ability to frame, inspect, and govern code must become more systematic.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — walk the course codebase</p>\n          <h3>Zero application-code keystrokes in TAC-1</h3>\n          <p>The README’s phase-one prompt contains a description of <code>main_aic.py</code>:</p>\n          <pre><code>CREATE main_aic.py:\n    print goodbye ai coding</code></pre>\n          <p>The course artifact does not ask you to open <code>main_aic.py</code> and type the print statement. You give the instruction to Claude Code. The agent writes it. Later, <code>programmable/prompt.md</code> describes both runtime files and the agent writes both again. The lab’s prime directive extends the same rule to stretch changes: even when you add a branch name to the REPORT or create a fourth launcher, you ask Claude Code to make the edit.</p>\n          <p>Notice what you still do. You read <code>.claude/settings.json</code>. You understand the prompt. You watch the plan. You inspect generated files. You run independent verification commands. You compare the report to real output. You observe how the workflow fails when a permission is removed. Nothing about that work is passive. The difference is that your keystrokes go into instructions and probes, not into application code.</p>\n          <aside class=\"callout callout--why\">\n            <p class=\"callout__label\">Why the constraint matters</p>\n            <p>When an exercise is trivial, hand-editing always looks faster. The zero-typing rule makes you practice the control surface before tasks become too large for manual rescue.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — repair without reclaiming the keyboard</p>\n          <h3>Use the next imperfection as the exercise</h3>\n          <ol>\n            <li>During the TAC-1 lab, wait until an output differs from your expectation.</li>\n            <li>Before touching the file, state the discrepancy as observed versus expected behavior.</li>\n            <li>Give the agent the observation, the expected result, and the command that should prove success.</li>\n            <li>Let the agent edit and rerun.</li>\n            <li>Review the diff and evidence. If still wrong, repeat with a more precise observation.</li>\n          </ol>\n          <p>The drill is passed when the system repairs the artifact and you can name what improved in your feedback. Speed is secondary on this first repetition.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Two opposite misunderstandings</h3>\n          <div class=\"comparison\">\n            <article class=\"comparison__card\"><div class=\"comparison__head\"><h3>“No more code”</h3></div><div class=\"comparison__body\"><p><strong>Why it fails:</strong> code remains a primary asset that produces features and products. TAC expects you to generate more of it.</p><p><strong>Fix:</strong> say “stop hand-typing” every time you teach the tactic.</p></div></article>\n            <article class=\"comparison__card\"><div class=\"comparison__head\"><h3>“No need to understand code”</h3></div><div class=\"comparison__body\"><p><strong>Why it fails:</strong> faster generation magnifies the cost of weak review and weak system judgment.</p><p><strong>Fix:</strong> move reading, execution, tests, and diff review into explicit pass criteria.</p></div></article>\n          </div>\n          <p>A third failure hides between them: ritualistically never touching code while also never reviewing it. That is not Dan’s tactic. The goal is engineering leverage, not ideological purity. The lab’s zero-typing rule is a training constraint that forces better control habits.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The tactic has a public companion</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current-practice video · plan-approved</p>\n            <p>The locked overlay map pairs this lesson’s thesis with Dan’s public treatment, <em>AI Coding is NOT ENOUGH</em>. Use it after you can state the phase distinction yourself; the chapter’s course demo remains the graded evidence.</p>\n            <p class=\"current-practice__source\">Metadata should be rechecked at publication; the ID is supplied by the locked extract.</p>\n          </aside>\n          <div class=\"video-cards video-cards--single\">\n            <a class=\"video-card\" href=\"https://www.youtube.com/watch?v=2TIXl2rlA6Q\">\n              <span class=\"video-card__type\">Operationalizes the tactic</span>\n              <strong>AI Coding is NOT ENOUGH</strong>\n              <p>Reinforces the phase-one → phase-two thesis and the reason engineering cannot collapse into code generation.</p>\n              <span class=\"video-card__watch\">Open video ↗</span>\n            </a>\n          </div>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Retrieval questions for Stop Coding\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What exactly stops when you follow Tactic #1?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Your hand-typing of application code. Code generation and code understanding continue.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Where do the freed engineering cycles go?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Planning, reviewing, and creating closed-loop structures.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. Why is fixing the last two lines by hand a course failure even when it is faster?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It completes the artifact while hiding the loop’s weakness. You lose the chance to improve agent instructions, feedback, and verification for repeatable future work.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. What must increase when agents generate more code?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The quality and systematization of planning, review, validation, and governance.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Teach the tactic to a junior developer</strong> without using the phrase “AI is better at coding.” Explain what they stop, what they keep, and what three kinds of work replace typing. Give one example of a good re-prompt after an imperfect file.</p>\n            <p class=\"fine\">Pass if the learner could act differently on their next task.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-core-four\">\n        <span class=\"section-number\">04</span>\n        <h2 class=\"section-title\">Big Three → Core Four</h2>\n        <p class=\"section-lead\">The phase change adds one diagnostic dimension: tools. The novelty is not that tools exist. The breakthrough is that a prompt can reliably carry a long chain of tool calls at useful scale and performance.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The reroll reflex</h3>\n          <p>An agentic run stops before committing. A weak operator submits the same prompt again, perhaps adding “please make sure to commit.” The second run stops too. The operator concludes that the model is flaky.</p>\n          <p>A Core Four diagnosis asks four different questions. Did the agent see the repository state and instruction file it needed? Was the model capable of the reasoning? Did the prompt state a valid starting branch and commit expectation? Did the tool surface actually allow <code>git commit</code>? In TAC-1 stretch drill S3, removing one permission creates exactly this lesson: prompt quality cannot compensate for a missing tool.</p>\n          <p>Without a diagnostic vocabulary, every failure looks like “bad AI.” With the Core Four, you can isolate the broken dimension before spending another token.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — the Core Four visual</p>\n          <h3>Four interacting primitives, one newly emphasized dimension</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <div class=\"core-four\" role=\"img\" aria-label=\"Core Four: context, model, prompt, and tools, with tools highlighted as the added phase-two dimension\">\n                <div class=\"core-four__cell\"><b>Context</b><p>What the model can see: repo, files, settings, current state.</p></div>\n                <div class=\"core-four__cell\"><b>Model</b><p>The reasoning and generation capacity doing the work.</p></div>\n                <div class=\"core-four__cell\"><b>Prompt</b><p>The outcome, constraints, ordered actions, and report request.</p></div>\n                <div class=\"core-four__cell core-four__cell--tools\"><b>Tools</b><p>The bounded actions the agent can execute in a reliable chain.</p></div>\n                <span class=\"core-four__plus\">4</span>\n              </div>\n            </div>\n            <figcaption>The Big Three never disappear. Phase two adds tools and makes the interaction among all four operational.</figcaption>\n          </figure>\n          <div class=\"concept-strip\">\n            <div class=\"concept-strip__item\"><b>Context</b><p>“Can it see what matters?”</p></div>\n            <div class=\"concept-strip__item\"><b>Model</b><p>“Can it reason through this?”</p></div>\n            <div class=\"concept-strip__item\"><b>Prompt</b><p>“Does it know the outcome and checks?”</p></div>\n            <div class=\"concept-strip__item concept-strip__item--new\"><b>Tools</b><p>“Can it take the required actions?”</p></div>\n          </div>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>The full trace makes the fourth circle visible</h3>\n          <p>After the agentic prompt checks out a branch, writes <code>main_tac.py</code>, runs both programs, stages files, commits, cleans up its todos, and reports, Dan names what changed. AI coding had always involved context, model, and prompt—even if the user did not see all three. Agentic coding adds tools.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0845-core-four.jpg\" alt=\"Dan's Core Four diagram with context, tools, model, and prompt\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">14:05</span>The on-screen Core Four is the lesson’s central abstraction. The highlighted teaching point is reliable long-chain execution, not a claim that tool calling was invented here.</figcaption>\n          </figure>\n          <p>Dan anticipates the obvious objection: tool calling is not new. His answer is exact and portable: “It’s not a question of new. It’s a question of scale and performance.” A single calculator call proves a model can use a tool. A branch → write → run → observe → stage → commit → report chain proves that tool use can form a unit of engineering work.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>The Big Three and the Core Four</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Canonical terms</p>\n            <p><strong>Big Three:</strong> context, model, prompt. <strong>Core Four:</strong> context, model, prompt, tools. <strong>Precise delta:</strong> prompts that can reliably execute long chains of tools.</p>\n          </aside>\n          <p>Tools should not be reduced to a list of commands. The tool dimension has at least three properties:</p>\n          <ol>\n            <li><strong>Availability:</strong> a tool exists that can perform the needed action.</li>\n            <li><strong>Permission:</strong> the system allows that action in the current context.</li>\n            <li><strong>Chain reliability:</strong> the agent can choose, order, execute, and learn from several calls without losing the goal.</li>\n          </ol>\n          <p>This explains why all four interact. A correct Git tool with no repository context is useless. A capable model with an ambiguous starting state may choose the wrong branch. A precise prompt asking for a forbidden commit cannot cross the permission boundary. Diagnostics work because you ask which dimension prevented the next state transition.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — <code>.claude/settings.json</code></p>\n          <h3>Read the tool surface before running the prompt</h3>\n          <p>The lesson’s settings file is the tools circle made concrete:</p>\n          <pre><code>{\n  \"permissions\": {\n    \"allow\": [\n      \"Read\", \"Write\", \"Edit\",\n      \"Bash(uv run:*)\",\n      \"Bash(git checkout:*)\",\n      \"Bash(git branch:*)\",\n      \"Bash(git add:*)\",\n      \"Bash(git commit:*)\",\n      \"WebSearch\"\n    ]\n  }\n}</code></pre>\n          <p>Classify the list. <code>Read</code>, <code>Write</code>, and <code>Edit</code> let the agent inspect and change files. <code>uv run</code> lets it execute the generated programs. Four Git patterns let it checkout, inspect/create branches, add files, and commit. <code>WebSearch</code> is the single non-local tool. There is no <code>git push</code> permission.</p>\n          <p>Now predict the README workflow. The agent can create the branch because checkout/branch are allowed. It can write <code>main_tac.py</code>. It can run both files with UV. It can add and commit. It cannot push the commit under this allowlist. You have understood the possible behavior before spending tokens.</p>\n          <table>\n            <thead><tr><th>Observed failure</th><th>First Core Four hypothesis</th><th>Probe</th></tr></thead>\n            <tbody>\n              <tr><td>Agent edits wrong file</td><td>Context or prompt</td><td>Ask which file path it read and where the path was specified.</td></tr>\n              <tr><td>Agent cannot commit</td><td>Tools/permission</td><td>Inspect <code>.claude/settings.json</code> for <code>Bash(git commit:*)</code>.</td></tr>\n              <tr><td>Agent creates correct code but skips execution</td><td>Prompt or chain planning</td><td>Confirm the RUN block explicitly includes both <code>uv run</code> commands.</td></tr>\n              <tr><td>Agent reports success with wrong output</td><td>Prompt/report evidence or model reasoning</td><td>Run files independently and require exact output in REPORT.</td></tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — permissions audit</p>\n          <h3>Checkpoint zero of the lab begins here</h3>\n          <ol>\n            <li>Open <code>tac/tac-1/.claude/settings.json</code>.</li>\n            <li>Without running the agent, write the three file tools.</li>\n            <li>Write the four allowed Git subcommands and one important absent operation.</li>\n            <li>Name the single non-local tool.</li>\n            <li>Close the file and recite the answers.</li>\n          </ol>\n          <div class=\"checkpoint\"><strong>Pass:</strong> Read, Write, Edit; checkout, branch, add, commit; push is not allowed; WebSearch is the non-local tool.</div>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: treating the Core Four as a memorization diagram</h3>\n          <p><strong>Symptom:</strong> you can chant “context, model, prompt, tools” but respond to every error by rewriting the prompt.</p>\n          <p><strong>Fix:</strong> before retrying, write one sentence per dimension: what context was present, which model property mattered, what the prompt required, and which tool/permission enabled the failed transition. Eliminate dimensions with evidence. The Core Four becomes valuable only when it changes your debugging behavior.</p>\n          <p>A related failure is giving the tools circle unlimited power so the workflow cannot be blocked. That avoids permission friction by deleting a safety boundary. TAC-1 teaches the opposite habit: inspect and deliberately bound what the agent may do.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>Permissions became richer; the audit habit survived</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>The flat allowlist shown in TAC-1 still communicates the primitive cleanly. Current Claude Code practice also includes permission modes, deny rules, hooks around tool use, sandboxed Bash, and settings layered across user, project, and local scopes. The modern surface is larger; the timeless habit is unchanged: inspect what the agent may do before you run it.</p>\n            <p class=\"current-practice__source\">Teaching rule: learn the visible allowlist first, then add richer gates when the workflow requires them.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Core Four retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Name the Big Three and the one added dimension.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Context, model, prompt; tools are added to form the Core Four.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What exact capability makes the tools dimension phase-two significant?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Prompts that can reliably execute long chains of tool calls.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What is Dan’s rebuttal to “tool calling isn’t new”?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Novelty is not the deciding issue; the change is useful scale, performance, and reliable long-chain execution.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Which allowed tool proves the agent can commit but not publish?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p><code>Bash(git commit:*)</code> is allowed, while no <code>git push</code> permission appears.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Diagnose aloud:</strong> an agent creates the correct files and runs them, but cannot make the requested commit. Walk through all four dimensions, then explain why tools/permission is the leading hypothesis. Finish with Dan’s scale-and-performance answer.</p>\n            <p class=\"fine\">Pass if you use evidence rather than “the AI is flaky.”</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-ab\">\n        <span class=\"section-number\">05</span>\n        <h2 class=\"section-title\">Two prompts, one monumental difference</h2>\n        <p class=\"section-lead\">The chapter’s A/B test holds repository, model, and operator constant. Prompt A creates a file. Prompt B carries an engineering workflow. Run both; the delta is the lesson.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>“Both made files, so they are basically the same”</h3>\n          <p>A learner runs both prompts and notices that <code>main_aic.py</code> and <code>main_tac.py</code> now exist. They conclude that the second prompt is merely a longer code-generation request. The visible artifacts conceal the real difference because files are the residue of both processes.</p>\n          <p>To see the delta, ignore the final directory for a moment and compare state transitions. Before Prompt A, one file is absent; afterward, it exists. Before Prompt B, the repository is on a starting branch with incomplete artifacts; afterward, a named branch exists, a second file exists, two programs have been executed, their output has been observed, changes have been staged and committed with a named message, a todo sequence has drained, and a report has been returned. The second prompt did not merely produce more. It moved the repository through an ordered series of verified states.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — AI coding versus agentic coding</p>\n          <h3>Compare verbs, states, and evidence</h3>\n          <div class=\"comparison\">\n            <article class=\"comparison__card\">\n              <div class=\"comparison__head\"><p class=\"eyebrow\">Phase 1</p><h3>AI Coding Prompt</h3><p>A request to create code.</p></div>\n              <div class=\"comparison__body\">\n                <pre><code>CREATE main_aic.py:\n    print goodbye ai coding</code></pre>\n                <ul>\n                  <li><strong>Verb:</strong> create</li>\n                  <li><strong>State change:</strong> one file appears</li>\n                  <li><strong>Execution:</strong> human runs it later</li>\n                  <li><strong>Repository action:</strong> none requested</li>\n                  <li><strong>Evidence:</strong> file content</li>\n                </ul>\n              </div>\n            </article>\n            <article class=\"comparison__card comparison__card--agentic\">\n              <div class=\"comparison__head\"><p class=\"eyebrow\">Phase 2</p><h3>Agentic Coding Prompt</h3><p>A runbook for engineering work.</p></div>\n              <div class=\"comparison__body\">\n                <pre><code>RUN: checkout branch\nCREATE: main_tac.py\nRUN: execute both files\nRUN: add + commit</code></pre>\n                <ul>\n                  <li><strong>Verbs:</strong> run, create, run</li>\n                  <li><strong>State changes:</strong> branch, file, index, commit</li>\n                  <li><strong>Execution:</strong> agent runs both programs</li>\n                  <li><strong>Repository action:</strong> explicit Git workflow</li>\n                  <li><strong>Evidence:</strong> trace, outputs, commit, report</li>\n                </ul>\n              </div>\n            </article>\n          </div>\n          <p>A useful test: if you can describe a prompt’s success only by naming generated files, you may be looking at AI coding. If you can describe ordered state transitions and evidence, you are looking at an agentic workflow.</p>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>Watch the todo list become a repository history</h3>\n          <p>Dan first pastes the AI Coding Prompt. Claude Code writes <code>main_aic.py</code>. He calls it familiar: something you have seen a million times. Then he pastes the Agentic Coding Prompt. This time the agent turns the instruction into a checklist and executes the work step by step.</p>\n          <div class=\"frame-grid\">\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0700-ai-coding-prompt-run.jpg\" alt=\"The AI coding prompt creating main_aic.py in Claude Code\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">11:40</span>The baseline: one prompt creates one file. Useful, but the human still owns the surrounding workflow.</figcaption>\n            </figure>\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t0748-agentic-prompt-checklist.jpg\" alt=\"Claude Code turns the agentic prompt into a todo checklist\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">12:28</span>The prompt becomes an execution plan. The todo list externalizes intermediate state so the chain can be carried rather than merely described.</figcaption>\n            </figure>\n          </div>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0790-agentic-prompt-results.jpg\" alt=\"Full agentic coding result showing branch, file writing, program output, commit, and completed todos\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">13:10</span>The after picture: branch checkout, file creation, both UV runs, Git add and commit, todos completed. This trace—not the print statements—is the phase-two artifact.</figcaption>\n          </figure>\n          <p>Dan’s one move is to make process visible. The agent’s checklist, tool trace, command output, and commit expose a chain that a human would otherwise carry implicitly. That visibility makes the workflow inspectable and, later, programmable.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>The Agentic Coding Prompt</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Agentic Coding Prompt:</strong> a prompt containing a sequence of tool calls. In plain English, it is a workflow specification that an agent can execute.</p>\n          </aside>\n          <p>The README uses a compact runbook grammar: <code>RUN</code>, <code>CREATE</code>, <code>RUN</code>. These headings separate kinds of action. The first RUN establishes repository state. CREATE defines an artifact. The final RUN executes and records the work. In <code>programmable/prompt.md</code>, a fourth heading—<code>REPORT</code>—makes the output contract explicit.</p>\n          <p>The headings are not magic syntax. Their value is structural clarity. A weak prompt mixes goal, starting state, implementation, commands, and success into a paragraph. A runbook shape lets both human and model see the sequence. It also makes omission easier to detect. If no REPORT block exists, a headless caller may receive an unhelpful narrative. If no starting branch is declared, reruns may begin from ambiguous state.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — trace every line</p>\n          <h3>Read the README prompt as a state machine</h3>\n          <pre><code>RUN:\n    checkout a new/existing \"demo-agentic-coding\" git branch\n\nCREATE main_tac.py:\n    print \"hello agentic coding\"\n    print a concise explanation of the definition of ai agents\n\nRUN:\n    uv run main_aic.py\n    uv run main_tac.py\n    git add .\n    git commit -m \"Demo agentic coding capabilities\"</code></pre>\n          <div class=\"workflow\" aria-label=\"Agentic prompt state transitions\">\n            <div class=\"workflow__step\"><strong>1 · Isolate</strong><code>checkout branch</code></div>\n            <div class=\"workflow__step\"><strong>2 · Produce</strong><code>create file</code></div>\n            <div class=\"workflow__step\"><strong>3 · Observe</strong><code>run both</code></div>\n            <div class=\"workflow__step\"><strong>4 · Record</strong><code>add + commit</code></div>\n            <div class=\"workflow__step\"><strong>5 · Return</strong><code>trace/report</code></div>\n          </div>\n          <p>Line one establishes isolation. The CREATE block specifies two observable behaviors without dictating a full implementation. The next two commands turn code into evidence: <code>uv run main_aic.py</code> should print <code>goodbye ai coding</code>; <code>uv run main_tac.py</code> should print <code>hello agentic coding</code> followed by a concise definition. The final two commands preserve the result in Git.</p>\n          <p>The five-action delta you should write in Checkpoint 1 is:</p>\n          <ol>\n            <li>Checkout the named branch.</li>\n            <li>Create the second file to a behavioral specification.</li>\n            <li>Execute both programs and expose their outputs.</li>\n            <li>Stage and commit the change with the specified message.</li>\n            <li>Manage the sequence and report completion.</li>\n          </ol>\n          <p>The prompt depends on <code>main_aic.py</code> from the first interactive run. That dependency is why <code>programmable/prompt.md</code> later creates both files: a headless workflow must be self-contained enough to run from its declared starting state.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — reproduce the A/B test</p>\n          <h3>Do not substitute reading for running</h3>\n          <ol>\n            <li>From the cloned TAC-1 repo, start Claude Code.</li>\n            <li>Paste the README’s AI Coding Prompt. Confirm <code>main_aic.py</code> exists, then run <code>uv run main_aic.py</code> yourself.</li>\n            <li>Before Prompt B, write what did <em>not</em> happen: no branch, no execution by the agent, no commit.</li>\n            <li>Paste the Agentic Coding Prompt. Watch the checklist form and drain.</li>\n            <li>Verify branch, generated behavior, execution trace, commit message, and report.</li>\n          </ol>\n          <div class=\"terminal\" aria-label=\"Verification commands\">\n            <div class=\"terminal__bar\"><span class=\"terminal__dot\"></span><span class=\"terminal__dot\"></span><span class=\"terminal__dot\"></span></div>\n            <pre><code>$ git branch --show-current\ndemo-agentic-coding\n\n$ uv run main_aic.py\ngoodbye ai coding\n\n$ uv run main_tac.py\nhello agentic coding\n[one concise AI-agent definition]\n\n$ git log --oneline -1\n[hash] Demo agentic coding capabilities</code></pre>\n          </div>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: comparing artifacts instead of transitions</h3>\n          <p><strong>Symptom:</strong> your A/B notes say “Prompt A made one Python file; Prompt B made another Python file.”</p>\n          <p><strong>Fix:</strong> use verbs and evidence. Write <em>checkout, create, execute, observe, stage, commit, report</em>. Then connect each verb to a tool permission and a verifiable state. The monumental difference is not that Prompt B is longer or that the code is smarter. It is that the prompt carries engineering actions end to end.</p>\n          <p><strong>Secondary stall:</strong> the branch already exists, so checkout behavior differs. Return to <code>main</code> and delete <code>demo-agentic-coding</code> between clean reproductions. The prompt says new/existing, so reuse is valid behavior; the clean reset simply makes the demonstration unambiguous.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The runbook shape spread; the lesson still teaches the primitive</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>RUN/CREATE/RUN/REPORT is now recognizable across command files, reusable skills, CI-oriented prompts, and agent workflows. Modern packaging can add schemas and hooks, but do not skip the plain prompt. Its lack of magic is pedagogically useful: every transition is visible, so you can tell what the runtime must provide.</p>\n            <p class=\"current-practice__source\">Rule: teach the workflow in raw form before packaging it into a reusable abstraction.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"A/B demo retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Name five actions Prompt B performed that Prompt A did not.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Branch checkout; second specified file; execution of both programs; Git add and commit; todo management and final report.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Why is <code>uv run</code> load-bearing in the comparison?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It turns generated code into observed behavior. The agent does not merely write; it executes and can use the outputs as evidence.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. Why does <code>programmable/prompt.md</code> create <code>main_aic.py</code> too?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>To make the headless workflow self-contained rather than dependent on the earlier interactive phase-one run.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. What is the most useful definition of an Agentic Coding Prompt here?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>A workflow specification containing a sequence of reliably executed tool calls.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Draw the comparison from memory.</strong> On the left, write the one state transition of Prompt A. On the right, draw Prompt B as branch → create → run → commit → report. Explain why two final files do not make the processes equivalent.</p>\n            <p class=\"fine\">Pass if your listener can point to the exact boundary where code generation becomes engineering workflow execution.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-tool\">\n        <span class=\"section-number\">06</span>\n        <h2 class=\"section-title\">Why this tool class works</h2>\n        <p class=\"section-lead\">The lesson names three essential elements behind reliable agentic coding: a reasoning-capable model, consistent long tool chains, and the right agent architecture. Treat them as a transferable evaluation checklist.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>A model that can code but cannot carry the work</h3>\n          <p>You can have a brilliant model that writes the right function in isolation yet loses the goal after six tool calls. You can have a tool-rich shell around a weak model that follows commands literally but cannot recover when repository state differs. You can have both inside an architecture that forgets observations, loops without limits, or exposes the wrong action surface.</p>\n          <p>“Which model is best?” is therefore too small a question for agentic coding. The unit under evaluation is the combined system. TAC-1’s agentic prompt requires the system to interpret a runbook, plan it, call file and shell tools in order, preserve outputs as context, and know when the requested end state has been reached. A high benchmark score on code generation does not prove that chain.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — a three-legged platform</p>\n          <h3>Remove one element and reliability collapses</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 840 430\" role=\"img\" aria-labelledby=\"platform-title platform-desc\">\n                <title id=\"platform-title\">Three essential elements supporting reliable agentic coding</title>\n                <desc id=\"platform-desc\">Reasoning model, long tool-chain consistency, and agent architecture support a platform labeled reliable agentic coding at scale.</desc>\n                <rect x=\"120\" y=\"80\" width=\"600\" height=\"86\" rx=\"18\" fill=\"var(--accent-wash)\" stroke=\"var(--accent)\" stroke-width=\"3\"/>\n                <text x=\"420\" y=\"118\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-display)\" font-weight=\"700\" font-size=\"var(--text-diagram-xl)\">Reliable agentic coding</text>\n                <text x=\"420\" y=\"147\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-md)\">at useful scale and performance</text>\n                <path d=\"M170 166 L240 338 L320 338 L335 166 Z\" fill=\"var(--ok-wash)\" stroke=\"var(--ok)\" stroke-width=\"3\"/>\n                <path d=\"M335 166 L385 338 L465 338 L505 166 Z\" fill=\"var(--bg-inset)\" stroke=\"var(--ink-soft)\" stroke-width=\"3\"/>\n                <path d=\"M505 166 L520 338 L600 338 L670 166 Z\" fill=\"var(--bg-inset)\" stroke=\"var(--ink-soft)\" stroke-width=\"3\"/>\n                <text x=\"270\" y=\"226\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">MODEL</text>\n                <text x=\"270\" y=\"256\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">reason when</text><text x=\"270\" y=\"278\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">needed</text>\n                <text x=\"420\" y=\"226\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">CHAINS</text>\n                <text x=\"420\" y=\"256\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">call tools</text><text x=\"420\" y=\"278\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">consistently</text>\n                <text x=\"570\" y=\"226\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">ARCHITECTURE</text>\n                <text x=\"570\" y=\"256\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">hold state, route</text><text x=\"570\" y=\"278\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">actions, stop</text>\n                <rect x=\"145\" y=\"338\" width=\"550\" height=\"24\" rx=\"12\" fill=\"var(--ink)\"/>\n              </svg>\n            </div>\n            <figcaption>A great model is necessary but not sufficient. Long-chain behavior emerges from the combined platform.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>From “why now?” to an evaluation frame</h3>\n          <p>After introducing the Core Four, Dan asks why reliable agentic coding became possible at this point. His answer is the combination of three elements: a powerful language model that can reason when needed, the ability to consistently call long chains of tools, and the right agent architecture.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t0903-claude-code-three-elements.jpg\" alt=\"Slide listing Claude Code's three essential elements\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">15:03</span>The slide explains the form factor. Carry the checklist forward even when model names and interfaces change.</figcaption>\n          </figure>\n          <p>Dan positions Claude Code as the phase-two tool that combined these elements properly first, much as Aider represented phase-one AI coding in his framing. But he immediately protects the tactic from tool lock-in: interfaces will change, models will improve, competitors will copy capabilities. The portable lesson is the checklist, not allegiance to one screen.</p>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Three essential elements</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s checklist</p>\n            <p><strong>1.</strong> A powerful model that can reason when needed. <strong>2.</strong> Consistent long chains of tool calls. <strong>3.</strong> The right agent architecture.</p>\n          </aside>\n          <p>In plain English:</p>\n          <ul>\n            <li>The <strong>model</strong> must interpret goals, code, output, and unexpected states rather than pattern-match one response.</li>\n            <li>The <strong>chain</strong> must survive many transitions. Reliability compounds: if each step is weak, a long workflow fails often even when individual steps look good.</li>\n            <li>The <strong>architecture</strong> must present context and tools, preserve observations, manage turns, expose progress, handle errors, and stop at a useful boundary.</li>\n          </ul>\n          <p>Dan’s historical claim is that reliable agentic coding at scale was not possible before this combination. You do not need to debate the date to use the checklist. Any candidate tool must demonstrate the combined behavior on your workflow.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — evaluate the TAC-1 run</p>\n          <h3>Map the evidence to the three elements</h3>\n          <table>\n            <thead><tr><th>Observed TAC-1 behavior</th><th>Element evidenced</th><th>Why it matters</th></tr></thead>\n            <tbody>\n              <tr><td>Interprets “new/existing branch” and a behavioral file description</td><td>Reasoning model</td><td>The prompt is not a fixed command script; meaning must be converted into actions.</td></tr>\n              <tr><td>Checks out, writes, runs twice, adds, commits, reports in order</td><td>Long tool chain</td><td>Correctness depends on state flowing between multiple calls.</td></tr>\n              <tr><td>Builds and drains a todo checklist while retaining outputs</td><td>Agent architecture</td><td>The system externalizes progress and carries observations toward completion.</td></tr>\n              <tr><td>Returns a coherent final account</td><td>Architecture + model</td><td>A headless or human caller needs a usable completion boundary.</td></tr>\n            </tbody>\n          </table>\n          <p>Now imagine substitutions. A reasoning model with no Bash tool could describe the commands but not execute them. A shell loop with no reasoning could execute fixed commands but not interpret a concise AI-agent definition or adjust to an existing branch. An architecture that discarded command output could not include exact program output in its report. The demonstration is small enough to expose all three.</p>\n          <aside class=\"callout callout--warning\">\n            <p class=\"callout__label\">Economics are part of operation</p>\n            <p>Dan states that TAC will use millions of tokens across the full course and calls the investment “pay to play.” The chapter does not invent a dollar estimate; costs and plans change. The operational lesson is to budget enough model access that you can run the exercises rather than stopping at recognition.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — tool evaluation card</p>\n          <h3>Judge capabilities with a workflow, not a feature list</h3>\n          <ol>\n            <li>Use the TAC-1 agentic prompt as a benchmark task.</li>\n            <li>For the model, note whether it interprets the outcome and reacts to repository state.</li>\n            <li>For the chain, count ordered tool actions completed without human relay.</li>\n            <li>For architecture, note plan visibility, output retention, errors, permissions, and stopping behavior.</li>\n            <li>Record one observed piece of evidence for each element.</li>\n          </ol>\n          <p>Do not grade on UI similarity to Dan’s recording. A newer or different interface passes when it carries the same primitive reliably.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: tool worship or tool dismissal</h3>\n          <p><strong>Worship:</strong> “Claude Code is the lesson.” This makes every UI change feel like curriculum drift and hides the transferable checklist.</p>\n          <p><strong>Dismissal:</strong> “Any chat model can call a tool, so there is no lesson.” This ignores long-chain reliability, state management, and action architecture.</p>\n          <p><strong>Fix:</strong> demand workflow evidence. Can the system interpret, execute, observe, recover, and stop across the TAC-1 chain? Use the result to compare tools. Preserve the tactic even as the product surface changes.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The form factor grew beyond the early terminal demo</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current-practice video · plan-approved</p>\n            <p>The extract maps <em>How Claude Code CHANGED Engineering Forever</em> to the newer form factor and programmable embedding story. Watch it as an update layer, not as a replacement for the three-element test.</p>\n            <p class=\"current-practice__source\">Metadata should be rechecked at publication; the ID is supplied by the locked extract.</p>\n          </aside>\n          <div class=\"video-cards video-cards--single\">\n            <a class=\"video-card\" href=\"https://www.youtube.com/watch?v=6fCqj4xFCZI\">\n              <span class=\"video-card__type\">Named gap · form factor</span>\n              <strong>How Claude Code CHANGED Engineering Forever</strong>\n              <p>Extends the lesson’s tool-class and programmable-agent claims into the current surface.</p>\n              <span class=\"video-card__watch\">Open video ↗</span>\n            </a>\n          </div>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Three essential elements retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. Name the three essential elements in order.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>A powerful language model that can reason when needed; consistent long chains of tool calls; the right agent architecture.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. Why can a strong coding model still be a weak agentic system?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It may not carry long tool chains reliably, or the surrounding architecture may fail to preserve state, route actions, handle errors, or stop well.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. Which TAC-1 behavior most directly evidences architecture?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The todo plan, retained tool observations, bounded permissions, error/completion handling, and final report all evidence the surrounding agent architecture.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. What is transferable when the UI and model names change?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The tactic, Core Four diagnosis, agentic prompt shape, and three-element evaluation checklist.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Evaluate an imaginary tool:</strong> it uses an excellent model and exposes 50 tools, but it often forgets earlier command output and continues after failure. Explain which elements are strong, which is weak, and why tool count does not equal reliable agentic coding.</p>\n            <p class=\"fine\">Pass if you distinguish model, chain, and architecture without falling back to brand preference.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-programmable\">\n        <span class=\"section-number\">07</span>\n        <h2 class=\"section-title\">Programmable agentic coding</h2>\n        <p class=\"section-lead\">Because Claude Code runs in the terminal, any language with terminal access can call it. The agent stops being a place you visit and becomes a function-like component inside a larger system.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The workflow that only exists while you are chatting</h3>\n          <p>You develop a strong interactive routine. You paste a runbook, answer one question, watch the agent work, and receive a useful result. Tomorrow you perform the same ritual again. The prompt is reusable, but the trigger is still you. The workflow is stored as a habit in your head: open the terminal, start the agent, find the prompt, paste it, wait, copy the result.</p>\n          <p>This is phase two in capability but not yet in reach. The agent can carry engineering work, yet the system cannot invoke that capacity from anywhere else. It cannot be called by a script, a scheduled process, a CI job, or another agentic environment. Dan’s programmable section removes that last dependence with a tiny observation: the tool already runs in a terminal.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — agent as callable component</p>\n          <h3>Prompt in, tool chain inside, report out</h3>\n          <figure class=\"diagram\">\n            <div class=\"diagram__canvas\">\n              <svg viewBox=\"0 0 900 430\" role=\"img\" aria-labelledby=\"callable-title callable-desc\">\n                <title id=\"callable-title\">Programmable agent flow</title>\n                <desc id=\"callable-desc\">Shell, Python, and TypeScript launchers feed the same prompt into claude dash p. The agent uses bounded tools against the repository and returns a report; failure signaling varies by wrapper.</desc>\n                <rect x=\"40\" y=\"62\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--bg-inset)\" stroke=\"var(--border)\" stroke-width=\"2\"/>\n                <text x=\"130\" y=\"94\" text-anchor=\"middle\" fill=\"var(--ink)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">Launcher</text>\n                <text x=\"130\" y=\"121\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">sh · py · ts</text>\n                <rect x=\"40\" y=\"280\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--bg-inset)\" stroke=\"var(--border)\" stroke-width=\"2\"/>\n                <text x=\"130\" y=\"312\" text-anchor=\"middle\" fill=\"var(--ink)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">prompt.md</text>\n                <text x=\"130\" y=\"339\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">RUN/CREATE/REPORT</text>\n                <rect x=\"330\" y=\"132\" width=\"240\" height=\"168\" rx=\"26\" fill=\"var(--accent-wash)\" stroke=\"var(--accent)\" stroke-width=\"4\"/>\n                <text x=\"450\" y=\"184\" text-anchor=\"middle\" fill=\"var(--accent-ink)\" font-family=\"var(--font-display)\" font-weight=\"700\" font-size=\"var(--text-diagram-2xl)\">claude -p</text>\n                <text x=\"450\" y=\"222\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-base)\">agentic runtime</text>\n                <text x=\"450\" y=\"255\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-size=\"var(--text-diagram-sm)\">plan → call → observe → continue</text>\n                <rect x=\"685\" y=\"62\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--ok-wash)\" stroke=\"var(--ok)\" stroke-width=\"2\"/>\n                <text x=\"775\" y=\"94\" text-anchor=\"middle\" fill=\"var(--ok)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">Repository</text>\n                <text x=\"775\" y=\"121\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">files · uv · git</text>\n                <rect x=\"685\" y=\"280\" width=\"180\" height=\"80\" rx=\"16\" fill=\"var(--bg-inset)\" stroke=\"var(--ink-soft)\" stroke-width=\"2\"/>\n                <text x=\"775\" y=\"312\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-body)\" font-weight=\"800\" font-size=\"var(--text-diagram-lg)\">Return</text>\n                <text x=\"775\" y=\"339\" text-anchor=\"middle\" fill=\"var(--ink-soft)\" font-family=\"var(--font-mono)\" font-size=\"var(--text-diagram-sm)\">report · status varies</text>\n                <path d=\"M220 102 C280 102 280 174 330 174\" fill=\"none\" stroke=\"var(--ink-mute)\" stroke-width=\"3\"/>\n                <path d=\"M220 320 C280 320 280 258 330 258\" fill=\"none\" stroke=\"var(--ink-mute)\" stroke-width=\"3\"/>\n                <path d=\"M570 174 C625 174 625 102 685 102\" fill=\"none\" stroke=\"var(--ok)\" stroke-width=\"3\"/>\n                <path d=\"M685 135 C625 135 625 216 570 216\" fill=\"none\" stroke=\"var(--ok)\" stroke-width=\"3\" stroke-dasharray=\"7 7\"/>\n                <path d=\"M570 258 C625 258 625 320 685 320\" fill=\"none\" stroke=\"var(--ink-soft)\" stroke-width=\"3\"/>\n              </svg>\n            </div>\n            <figcaption>The host language only launches the process. The prompt and agent runtime carry the engineering semantics.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>Delete the branch, then watch it re-materialize headlessly</h3>\n          <p>Dan opens the <code>programmable/</code> directory and shows the shape: one prompt plus three launchers. Before running the Python launcher, he returns to <code>main</code> and deletes <code>demo-agentic-coding</code>. That cleanup is not incidental. It establishes a visible before-state so the scripted run can prove reproducibility.</p>\n          <div class=\"frame-grid\">\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t1063-programmable-directory.jpg\" alt=\"The programmable directory showing shell, Python, TypeScript launchers and prompt.md\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">17:43</span>Three launchers, one prompt. The directory view is the architecture in miniature.</figcaption>\n            </figure>\n            <figure class=\"frame-card\">\n              <img src=\"../media/frames/tac-1/t1105-programmable-py.jpg\" alt=\"The programmable Python launcher reading prompt.md and calling Claude Code\" loading=\"lazy\">\n              <figcaption><span class=\"frame-card__t\">18:25</span>The Python implementation demystifies the pattern: read, invoke, capture, print, propagate status.</figcaption>\n            </figure>\n          </div>\n          <p>From a fresh terminal on <code>main</code>, he runs <code>uv run python programmable/programmable.py</code>. No interactive conversation follows. Claude Code receives the prompt through <code>-p</code>, recreates the branch and both runtime files, runs them, commits, and returns the requested outputs.</p>\n          <figure class=\"frame-card\">\n            <img src=\"../media/frames/tac-1/t1205-programmable-report.jpg\" alt=\"Headless programmable run returning the requested report with program outputs\" loading=\"lazy\">\n            <figcaption><span class=\"frame-card__t\">20:05</span>The report lands back in the host terminal. This closes the first programmable loop: prompt in, engineering actions performed, evidence out.</figcaption>\n          </figure>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>Programmable agentic coding</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>Programmable agentic coding:</strong> invoking an agentic coding tool from a program so your own systems can fire agentic prompts across the software development lifecycle.</p>\n          </aside>\n          <p>Plain English: treat the agent like a function with a deliberately imperfect analogy:</p>\n          <pre><code>result = agent(prompt, repository_context, allowed_tools)</code></pre>\n          <p>The analogy helps because a caller supplies input and receives output. It is imperfect because the agent has side effects: it edits files, runs programs, and changes Git state. That is why permissions, starting state, reports, and exit codes matter. You are not calling a pure text transformer. You are invoking a bounded actor.</p>\n          <p>Dan’s key expansion is spatial: the prompt matters, but so does where the system can invoke it. A prompt trapped in an interactive session depends on your presence. A prompt callable from code can live inside triggers and environments where you are absent. TAC-1 names triggers as later-course material; this lesson only proves the callable primitive.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — all four programmable files</p>\n          <h3>One shared invocation pattern, three error-handling choices</h3>\n          <p>Start with the shared behavior file, <code>programmable/prompt.md</code>. It differs from the README’s agentic prompt in two important ways: it also creates <code>main_aic.py</code>, making the run self-contained, and it ends with a report contract:</p>\n          <pre><code>REPORT:\n    respond with the exact output of both .py files</code></pre>\n          <p>The Shell launcher is the pattern without ceremony:</p>\n          <pre><code>PROMPT_CONTENT=\"$(cat programmable/prompt.md)\"\nOUTPUT=\"$(claude -p \"$PROMPT_CONTENT\")\"\necho \"$OUTPUT\"</code></pre>\n          <p>The Python launcher makes process behavior explicit:</p>\n          <pre><code>with open(\"programmable/prompt.md\", \"r\") as f:\n    prompt_content = f.read()\n\nresult = subprocess.run(\n    [\"claude\", \"-p\", prompt_content],\n    capture_output=True,\n    text=True,\n)\nprint(result.stdout)\nsys.exit(result.returncode)</code></pre>\n          <p>The actual course file also prints standard error when present and catches exceptions. Those details make it the most production-shaped of the three: the caller can distinguish useful output from errors and preserves the child process’s success or failure for an outer system.</p>\n          <p>The TypeScript/Bun launcher reads the same file and uses Bun’s shell template:</p>\n          <pre><code>const promptContent = readFileSync(\"programmable/prompt.md\", \"utf-8\");\nconst output = await $`claude -p ${promptContent}`.text();\nconsole.log(output);</code></pre>\n          <p>The shared core is more important than syntax, but the wrappers are not equally defensive:</p>\n          <div class=\"workflow\">\n            <div class=\"workflow__step\"><strong>Read</strong><code>prompt.md</code></div>\n            <div class=\"workflow__step\"><strong>Invoke</strong><code>claude -p</code></div>\n            <div class=\"workflow__step\"><strong>Capture</strong><code>text output</code></div>\n            <div class=\"workflow__step\"><strong>Return</strong><code>print report</code></div>\n            <div class=\"workflow__step\"><strong>Differentiate</strong><code>error policy</code></div>\n          </div>\n          <p>Shell reads, invokes, captures standard output through command substitution, and echoes it. It does <strong>not</strong> explicitly capture standard error or preserve the child exit code after the final <code>echo</code>. Python explicitly prints standard error and exits with Claude’s return code. The Bun wrapper catches a thrown command error and exits with status 1. Language choice is irrelevant to the agentic semantics because all three can access the terminal; wrapper quality still determines what an outer system can learn about failure.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — headless reproduction</p>\n          <h3>Feel the absence of interaction</h3>\n          <ol>\n            <li>Read <code>programmable/prompt.md</code> and identify the self-contained CREATE plus REPORT differences.</li>\n            <li>Reset exactly: <code>git checkout main &amp;&amp; git branch -D demo-agentic-coding</code>.</li>\n            <li>From <code>main</code>, run <code>uv run python programmable/programmable.py</code>.</li>\n            <li>Do not answer questions or intervene. If the process needs you, record where.</li>\n            <li>Verify the branch, both files, commit, and exact report output independently.</li>\n            <li>Reset between launchers, then repeat with Shell and Bun TypeScript.</li>\n          </ol>\n          <div class=\"checkpoint\"><strong>Checkpoint 2:</strong> explain in one sentence why the language did not matter. Expected idea: anything with terminal access can invoke <code>claude -p</code>; the agentic work lives in the shared prompt and runtime.</div>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: treating the wrapper as too trivial to run</h3>\n          <p><strong>Symptom:</strong> you read the three lines of Shell, say “I get it,” and skip the run. The concept stays intellectually obvious but behaviorally uninstalled.</p>\n          <p><strong>Fix:</strong> delete the branch and execute the Python launcher hands-off. The felt difference matters: an interactive tool waits in a place you visit; a programmable component returns control to a caller. Seeing repository state change while you provide no mid-run input is the lesson.</p>\n          <p>Other common stalls are state errors. If you run from <code>demo-agentic-coding</code> rather than <code>main</code>, the starting state no longer matches the demonstration. If the branch already exists, “new/existing” may legitimately reuse it. Reset between runs so launcher equivalence is what you test.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>The three-line launcher has a grown-up form</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>The one-shot <code>claude -p</code> pattern remains the clearest teaching form. Production embedding can add structured JSON or streaming output, allowed-tool controls, permission modes, session continuation, hooks, and Python/TypeScript Agent SDKs. Those capabilities improve control; they do not replace the core idea that the agent is callable.</p>\n            <p>Reusable behavior also moved from manually discovered prompt files toward Agent Skills: <code>SKILL.md</code> packages with metadata and on-demand loading. Learn <code>prompt.md</code> first so the packaging does not hide the workflow.</p>\n            <p class=\"current-practice__source\">Overlay: raw prompt → reusable Skill; bare subprocess → structured agent integration.</p>\n          </aside>\n          <div class=\"video-cards video-cards--single\">\n            <a class=\"video-card\" href=\"https://www.youtube.com/watch?v=X2ciJedw2vU\">\n              <span class=\"video-card__type\">Corrects outdated packaging</span>\n              <strong>RAW Agentic Coding: ZERO to Agent SKILL</strong>\n              <p>Maps the lesson’s reusable prompt primitive to the modern first-class Skill encoding.</p>\n              <span class=\"video-card__watch\">Open video ↗</span>\n            </a>\n          </div>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Programmable agent retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What single property makes Claude Code programmable in Dan’s demonstration?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It runs in the terminal, so any language with terminal access can invoke it through <code>claude -p</code>.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What two additions make <code>prompt.md</code> more headless-ready than the README prompt?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It creates both runtime Python files, making the workflow self-contained, and it requires a REPORT with exact outputs.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What host-side core do all three launchers share, and what does Shell omit?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>All read the prompt, invoke <code>claude -p</code>, and print returned text. The minimal Shell wrapper does not explicitly capture stderr or preserve the Claude process’s failing exit status after <code>echo</code>.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Why is the “agent as function” analogy imperfect?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The call has side effects in the repository and terminal. Starting state, permissions, reports, and exit status therefore matter.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Explain the Python launcher line by line</strong> to someone who thinks “programmable agent” requires a special platform. Then explain why the REPORT and return code matter once the human is not present.</p>\n            <p class=\"fine\">Pass if your explanation covers placement, side effects, evidence, and failure signaling—not just subprocess syntax.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section idea-cycle\" id=\"idea-paradox\">\n        <span class=\"section-number\">08</span>\n        <h2 class=\"section-title\">The contradicting truth: replace yourself</h2>\n        <p class=\"section-lead\">What gets replaced is your repeated execution. What becomes harder to replace is your judgment and ownership of the systems that perform it.</p>\n\n        <div class=\"move move--hook\">\n          <p class=\"move-label\">1 · Hook — concrete failure</p>\n          <h3>The indispensable bottleneck</h3>\n          <p>A team has one engineer who knows how to complete a fragile release ritual. They know which branch to create, which files to touch, which commands to run, what output is safe, and how to write the final update. Because only they can carry it, the engineer appears indispensable. In reality the team is dependent on an undocumented human workflow.</p>\n          <p>The engineer can protect that dependency, repeating the ritual forever, or encode it into a bounded, reviewable system. Encoding seems to remove their immediate necessity. It also changes their contribution from “person who remembers the steps” to “person who understands, improves, and governs the release system.” The first kind of indispensability is a bottleneck. The second is leverage.</p>\n        </div>\n\n        <div class=\"move move--picture\">\n          <p class=\"move-label\">2 · Picture — the paradox resolved</p>\n          <div class=\"paradox\">\n            <blockquote>To become an irreplaceable engineer, you will replace yourself.<cite>Dan · TAC-1, approximately 20:47</cite></blockquote>\n          </div>\n          <div class=\"workflow workflow--spaced\">\n            <div class=\"workflow__step\"><strong>You do it</strong><code>implicit craft</code></div>\n            <div class=\"workflow__step\"><strong>You name it</strong><code>runbook</code></div>\n            <div class=\"workflow__step\"><strong>Agent does it</strong><code>repeatable chain</code></div>\n            <div class=\"workflow__step\"><strong>You review it</strong><code>judgment</code></div>\n            <div class=\"workflow__step\"><strong>You improve it</strong><code>owned leverage</code></div>\n          </div>\n        </div>\n\n        <div class=\"move move--story\">\n          <p class=\"move-label\">3 · Story of one move — Dan’s demo</p>\n          <h3>The lesson replaces the operator before it names the paradox</h3>\n          <p>First Dan runs the agentic prompt interactively. He chooses it, pastes it, and watches the system carry the work. Then he deletes the branch and fires the same workflow through Python. The second run removes his interactive presence. By the time Dan states the contradicting truth near the close, the chapter has already enacted it.</p>\n          <p>The replacement is narrow and exact: Dan is no longer necessary to paste the prompt and supervise each transition of this branch-write-run-commit-report workflow. He remains necessary to choose the workflow, explain why it matters, define the permissions, inspect the report, and decide what mechanism to build next. This narrowness protects the idea from hype. You do not replace “the engineer” in one move. You replace one repeated piece of the engineer’s current execution.</p>\n          <aside class=\"callout callout--why\">\n            <p class=\"callout__label\">The ownership move</p>\n            <p>The person who turns tacit work into a reliable system becomes the person who can inspect, adapt, and multiply that system. Automation removes a task while creating a higher-order responsibility.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--name\">\n          <p class=\"move-label\">4 · Name it — Dan term + plain English</p>\n          <h3>The contradicting truth</h3>\n          <aside class=\"callout callout--term\">\n            <p class=\"callout__label\">Dan’s term</p>\n            <p><strong>The contradicting truth:</strong> to become irreplaceable, replace yourself.</p>\n          </aside>\n          <p>Plain English: systematically turn your repeated execution into systems, then move your attention to the judgment and design those systems need. “Replace yourself” is a method for discovering the next level of your role. It does not guarantee permanent job safety; Dan explicitly frames evolution as continuous. It creates an asymmetric advantage because you learn to own the machinery of change rather than defend the task being changed.</p>\n          <p>The paradox has two halves that must stay together. Replacement without ownership can become cost cutting. Ownership without replacement becomes a bottleneck. Agentic engineering aims for both: remove yourself from repeated transitions and increase your responsibility for outcome quality.</p>\n        </div>\n\n        <div class=\"move move--example\">\n          <p class=\"move-label\">5 · Worked example — replace one TAC-1 ritual</p>\n          <h3>From interactive operator to owner of a callable workflow</h3>\n          <table>\n            <thead><tr><th>Before</th><th>Encoded in TAC-1</th><th>Your higher-order work</th></tr></thead>\n            <tbody>\n              <tr><td>Remember to create the demo branch</td><td>RUN branch instruction</td><td>Define safe starting state and rerun policy</td></tr>\n              <tr><td>Type two tiny programs</td><td>CREATE blocks</td><td>State behavior and review generated implementation</td></tr>\n              <tr><td>Run and copy outputs</td><td>UV commands + REPORT</td><td>Define trustworthy evidence and compare it independently</td></tr>\n              <tr><td>Stage and commit manually</td><td>Git tool chain</td><td>Bound permissions and decide what may be recorded automatically</td></tr>\n              <tr><td>Paste the prompt each time</td><td>Python/Shell/TS launcher</td><td>Choose future triggers and integration boundaries</td></tr>\n            </tbody>\n          </table>\n          <p>The same transformation can be repeated across a career: observe a workflow you carry, make its state and checks explicit, give an agent bounded actions, require evidence, and move yourself to the next unresolved judgment point. TAC-1 does not teach later trigger systems yet, but it gives you the unit those systems will fire.</p>\n        </div>\n\n        <div class=\"move move--try\">\n          <p class=\"move-label\">6 · You try — the replacement ladder</p>\n          <h3>Name one task, one system, one next responsibility</h3>\n          <ol>\n            <li>Write a repeated task you currently perform.</li>\n            <li>Write the smallest action chain that would replace your repeated execution.</li>\n            <li>Write the evidence you would require before trusting the result.</li>\n            <li>Write the new question or risk that remains yours after the chain runs.</li>\n            <li>Complete the sentence: “I am not making myself unnecessary; I am making my attention available for ___.”</li>\n          </ol>\n          <p>Keep this as a teach-back exercise only during TAC-1. The graded implementation remains inside the course repo.</p>\n        </div>\n\n        <div class=\"move move--fail\">\n          <p class=\"move-label\">7 · Common fail + fix</p>\n          <h3>Failure: reading the paradox as fatalism</h3>\n          <p><strong>Symptom:</strong> “If I automate my work, the company will not need me, so I should protect the manual process.” This treats brittle task ownership as career security.</p>\n          <p><strong>Fix:</strong> state exactly what is replaced and what remains. In TAC-1, prompt pasting and workflow carrying are replaced. Judgment about goals, constraints, permissions, evidence, risk, and improvement remains. Then make that judgment visible by owning the runbook, checks, and review standards rather than hiding the manual ritual.</p>\n          <p>The opposite failure is grandiosity: claiming a tiny launcher replaces an entire engineer. Repair it by narrowing the claim to one workflow. Credible agentic engineering grows by accumulating verified replacements.</p>\n        </div>\n\n        <div class=\"move move--current\">\n          <p class=\"move-label\">8 · Current practice overlay</p>\n          <h3>Systems now scale further; responsibility scales too</h3>\n          <aside class=\"current-practice\">\n            <p class=\"current-practice__label\">Current practice · mid-2026</p>\n            <p>Background agents, subagents, hooks, and parallel worktrees can now replace larger portions of repeated execution than TAC-1’s serial terminal example. The responsibility lesson grows with them: more autonomous reach requires clearer boundaries, stronger evidence, and better ownership. Do not mistake a higher autonomy ceiling for permission to skip review design.</p>\n            <p class=\"current-practice__source\">No additional video card here; the chapter stays within the locked maximum of three overlays.</p>\n          </aside>\n        </div>\n\n        <div class=\"move move--check\">\n          <p class=\"move-label\">9 · Retrieval check</p>\n          <section class=\"retrieval-quiz\" aria-label=\"Replace yourself retrieval questions\">\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. State the contradicting truth in your own words.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Becoming harder to replace requires automating your own repeated execution and moving to higher-order ownership.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What is replaced in the TAC-1 programmable move?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The human’s repeated prompt-pasting and carrying of the branch-write-run-commit-report workflow.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What becomes more valuable after that replacement?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Judgment about goals, constraints, tool boundaries, evidence, risks, triggers, review, and improvement—plus ownership of the system.</p></details></div>\n            <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Why is “this launcher replaces an engineer” a bad interpretation?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It overstates a narrow workflow replacement. Credible progress names the exact repeated execution removed and the higher-order work that remains.</p></details></div>\n          </section>\n        </div>\n\n        <div class=\"move move--teach\">\n          <p class=\"move-label\">10 · Teach-back prompt</p>\n          <div class=\"teach-back\">\n            <p><strong>Resolve the paradox in one minute.</strong> Use the interactive-to-programmable TAC-1 progression. Name what Dan replaces, what he still owns, and why the second kind of work creates more leverage.</p>\n            <p class=\"fine\">Pass if the explanation is neither fatalistic nor grandiose.</p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"chapter-section chapter-section--wide\" id=\"lab\">\n        <span class=\"section-number\">09</span>\n        <h2 class=\"section-title\">Graded lab · Make the phase change real</h2>\n        <p class=\"section-lead\">This 45–75 minute lab runs only in the TAC-1 course repository. You will reproduce the interactive A/B test, invoke the same workflow headlessly from three languages, perturb one permission, and prove mastery without typing application code.</p>\n\n        <aside class=\"callout callout--warning\">\n          <p class=\"callout__label\">Safety and scope contract</p>\n          <p>Work only in a fresh clone of <code>https://github.com/disler/tac-1.git</code> or the local course source at <code>tac/tac-1</code>. Do not transplant the drill into a work repository. Read permissions before running. The course allowlist does not include <code>git push</code>. Reset the demo branch between comparable runs.</p>\n        </aside>\n\n        <h3>Lab map</h3>\n        <div class=\"workflow\" aria-label=\"Lab phases\">\n          <div class=\"workflow__step\"><strong>0 · Audit</strong><code>10 min</code></div>\n          <div class=\"workflow__step\"><strong>1 · A/B</strong><code>15 min</code></div>\n          <div class=\"workflow__step\"><strong>2 · Headless</strong><code>15 min</code></div>\n          <div class=\"workflow__step\"><strong>3 · Stretch</strong><code>15–30 min</code></div>\n          <div class=\"workflow__step\"><strong>4 · Oral</strong><code>5 min</code></div>\n        </div>\n\n        <section class=\"lab-box\" id=\"lab-setup\">\n          <h3 class=\"lab-box__title\">Lab 0 · Setup and permissions audit</h3>\n          <ul class=\"lab-box__meta\"><li>10 minutes</li><li>Required</li><li>Checkpoint 0</li></ul>\n          <p><strong>Failure this prevents:</strong> an agent reaches an action boundary you did not know existed, and you misdiagnose permissions as model unreliability.</p>\n          <ol class=\"lab-box__steps\">\n            <li>Create a fresh directory for TAC course work. Clone and enter the course repository:\n              <pre><code>git clone https://github.com/disler/tac-1.git\ncd tac-1</code></pre>\n            </li>\n            <li>Verify the required toolbelt. Bun is needed only for the TypeScript variant:\n              <pre><code>claude --version\nuv --version\ngit --version\nbun --version</code></pre>\n              <p>On Windows, use WSL as the course environment.</p>\n            </li>\n            <li>Open <code>.claude/settings.json</code>. Write answers before continuing:\n              <ul>\n                <li>Which three file tools are allowed?</li>\n                <li>Which four Git subcommands are allowed?</li>\n                <li>Which obvious Git action is absent?</li>\n                <li>Which non-local tool is enabled?</li>\n              </ul>\n            </li>\n            <li>Open the repository in your IDE. Open an integrated terminal. Dan uses VS Code and <kbd>Cmd</kbd>+<kbd>J</kbd>.</li>\n            <li>Run <code>claude</code> to enter the interactive agent.</li>\n          </ol>\n          <div class=\"checkpoint\">\n            <strong>Checkpoint 0 · no notes.</strong> Say: “Read, Write, Edit; UV run; Git checkout, branch, add, commit; WebSearch; no push permission.” If you cannot retrieve the surface, reread the file. Permission literacy is a graded outcome.\n          </div>\n          <div class=\"lab-box__pass\">\n            <h4>Pass criteria</h4>\n            <ul><li>All required commands report versions.</li><li>You can state what the agent may and may not do.</li><li>You are in the TAC-1 course repository before starting Claude Code.</li></ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-ab\">\n          <h3 class=\"lab-box__title\">Lab 1 · Reproduce Dan’s interactive A/B</h3>\n          <ul class=\"lab-box__meta\"><li>15 minutes</li><li>Required</li><li>Checkpoint 1</li></ul>\n          <p><strong>Failure this exposes:</strong> mistaking “more generated files” for “engineering work carried by an agent.”</p>\n\n          <h4>A · Phase-one baseline</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Open <code>README.md</code> and copy only the <strong>AI Coding Prompt</strong>.</li>\n            <li>Paste it into the interactive Claude Code session and fire.</li>\n            <li>Inspect <code>main_aic.py</code>. Do not hand-edit it.</li>\n            <li>Run it independently:\n              <pre><code>uv run main_aic.py</code></pre>\n              <p>Expected exact output: <code>goodbye ai coding</code>.</p>\n            </li>\n            <li>Write what the agent did not do: it did not create a branch, execute the program as part of the prompt, stage a change, or commit.</li>\n          </ol>\n\n          <h4>B · Phase-two workflow</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Copy the README’s <strong>Agentic Coding Prompt</strong> into the same interactive session.</li>\n            <li>Before the first tool call completes, notice whether a todo plan forms. Watch the steps drain; do not relay intermediate output.</li>\n            <li>Verify the current branch:\n              <pre><code>git branch --show-current</code></pre>\n              <p>Expected: <code>demo-agentic-coding</code>.</p>\n            </li>\n            <li>Inspect <code>main_tac.py</code>. It must print <code>hello agentic coding</code> and a concise, single-line definition of AI agents. The exact definition wording is model-generated, so grade the behavior, not a fabricated fixed sentence.</li>\n            <li>Run both files yourself and compare with the agent trace:\n              <pre><code>uv run main_aic.py\nuv run main_tac.py</code></pre>\n            </li>\n            <li>Inspect the commit:\n              <pre><code>git log --oneline -1</code></pre>\n              <p>The subject must be <code>Demo agentic coding capabilities</code>.</p>\n            </li>\n            <li>Confirm the agent reported what it did and completed its todo sequence.</li>\n          </ol>\n\n          <div class=\"checkpoint\">\n            <strong>Checkpoint 1 · write the delta.</strong> List five things Prompt B did that Prompt A did not. Use action verbs: branch, create, execute, commit, manage/report. This list is the phase change in operational form.\n          </div>\n          <div class=\"lab-box__pass\">\n            <h4>Pass criteria</h4>\n            <ul>\n              <li><code>main_aic.py</code> prints the exact phase-one line.</li>\n              <li>You are on <code>demo-agentic-coding</code>.</li>\n              <li><code>main_tac.py</code> has both required behaviors.</li>\n              <li>Both programs were executed by the agent and independently by you.</li>\n              <li>The required commit exists and your five-action delta is complete.</li>\n            </ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-headless\">\n          <h3 class=\"lab-box__title\">Lab 2 · Reproduce Dan headlessly</h3>\n          <ul class=\"lab-box__meta\"><li>15 minutes</li><li>Required</li><li>Checkpoint 2</li></ul>\n          <p><strong>Failure this exposes:</strong> understanding <code>claude -p</code> as syntax without feeling how a caller replaces the interactive operator.</p>\n          <ol class=\"lab-box__steps\">\n            <li>Read <code>programmable/prompt.md</code> before executing. Write its two changes relative to the README agentic prompt:\n              <ul>\n                <li>It creates <code>main_aic.py</code> too.</li>\n                <li>It requires the exact output of both files in <code>REPORT</code>.</li>\n              </ul>\n            </li>\n            <li>Return to a clean demonstration state exactly as Dan does:\n              <pre><code>git checkout main\ngit branch -D demo-agentic-coding</code></pre>\n              <p>If deletion fails, inspect <code>git branch</code> and confirm you are not currently on the demo branch. Do not improvise destructive Git commands.</p>\n            </li>\n            <li>From a fresh terminal on <code>main</code>, run the Python launcher:\n              <pre><code>uv run python programmable/programmable.py</code></pre>\n            </li>\n            <li>Hands off. Record any point at which the workflow asks for input or permission. A clean run should carry the sequence and return.</li>\n            <li>After completion, verify four independent facts:\n              <ul>\n                <li>the demo branch exists and is current;</li>\n                <li>both runtime files exist;</li>\n                <li>the required commit exists;</li>\n                <li>the printed report contains the actual outputs.</li>\n              </ul>\n            </li>\n            <li>Cross-check report truth by running both programs yourself. A report that sounds plausible but disagrees with execution is not a pass.</li>\n            <li>Reset branch state between runs. Then execute:\n              <pre><code>sh programmable/programmable.sh</code></pre>\n            </li>\n            <li>Reset again and execute the Bun variant:\n              <pre><code>bun run programmable/programmable.ts</code></pre>\n              <p>Bun is optional during the initial tool audit only in the sense that it supports the TypeScript variant; the full Checkpoint 2 requires all three launchers. Install/enable Bun before claiming a complete lab pass.</p>\n            </li>\n          </ol>\n          <div class=\"checkpoint\">\n            <strong>Checkpoint 2 · one sentence.</strong> “The host language does not matter because any program with terminal access can pass the shared prompt to <code>claude -p</code>; the prompt and agent runtime define the engineering workflow.”\n          </div>\n          <div class=\"lab-box__pass\">\n            <h4>Pass criteria</h4>\n            <ul>\n              <li>Python, Shell, and Bun TypeScript all carry the identical workflow headlessly.</li>\n              <li>Every comparable run begins from <code>main</code> without the demo branch.</li>\n              <li>The report matches independent execution.</li>\n              <li>You can explain why the wrapper language is incidental.</li>\n            </ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-stretch\">\n          <h3 class=\"lab-box__title\">Lab 3 · Stretch the loop without typing code</h3>\n          <ul class=\"lab-box__meta\"><li>15–30 minutes</li><li>S1–S4</li><li>Course repo only</li></ul>\n\n          <h4>S1 · Extend REPORT: close one more loop</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Inside Claude Code—not your editor—ask the agent to edit <code>programmable/prompt.md</code> so REPORT also includes the current Git branch name.</li>\n            <li>Review the prompt diff. Confirm the existing exact-output requirement remains.</li>\n            <li>Reset the branch and run the Python launcher.</li>\n            <li>Compare the reported branch with <code>git branch --show-current</code>.</li>\n          </ol>\n          <p><strong>Learning target:</strong> report-back is part of workflow design. The new field creates a new externally checkable claim.</p>\n\n          <h4>S2 · Add a fourth launcher: prove language independence</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Ask Claude Code to inspect the existing Shell, Python, and TypeScript launchers.</li>\n            <li>Ask it to add a launcher in another language already available on your machine—plain Node, Ruby, or Go are examples from the lab specification, not requirements.</li>\n            <li>Require the same invariants: read <code>prompt.md</code>, invoke <code>claude -p</code>, return output, surface errors/failure.</li>\n            <li>Reset, run, and verify the same repository end state.</li>\n          </ol>\n          <p><strong>Learning target:</strong> separate host syntax from the shared agentic workflow.</p>\n\n          <h4>S3 · Break one permission: feel the tools boundary</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Ask Claude Code to remove <code>\"Bash(git commit:*)\"</code> from <code>.claude/settings.json</code>. Review the diff.</li>\n            <li>Reset the demo state and rerun the agentic prompt.</li>\n            <li>Record the exact transition where the system halts, refuses, or asks. Do not summarize it as “Claude failed.”</li>\n            <li>Restore the permission through Claude Code and review the restored file.</li>\n            <li>Complete the sentence: “The prompt described the commit, but the workflow could not cross that state boundary because ___.”</li>\n          </ol>\n          <p><strong>Learning target:</strong> the tools circle bounds what even a correct prompt and capable model can accomplish.</p>\n\n          <h4>S4 · Transfer map: classify your real work</h4>\n          <ol class=\"lab-box__steps\">\n            <li>Time the interactive phase-one and phase-two runs.</li>\n            <li>List real tasks that are AI-coding-prompt-shaped: the needed outcome is primarily generated code.</li>\n            <li>List tasks that are agentic-prompt-shaped: success requires ordered repository or system actions and evidence.</li>\n            <li>Circle one candidate whose repeated transitions could be encoded after the course. Do not run it outside TAC-1 in this lab.</li>\n          </ol>\n          <p><strong>Learning target:</strong> transfer the distinction without expanding the authorized lab scope.</p>\n\n          <div class=\"lab-box__pass\">\n            <h4>Stretch pass criteria</h4>\n            <ul>\n              <li>All file changes were made through Claude Code.</li>\n              <li>S1 report includes the real branch name and both real outputs.</li>\n              <li>S2 adds and verifies a fourth launcher through Claude Code.</li>\n              <li>S3 produces a recorded permission-boundary observation and restores the setting.</li>\n              <li>S4 produces two task-shape lists and one circled transfer candidate.</li>\n              <li>Any settings modification is restored before you finish.</li>\n            </ul>\n          </div>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-troubleshooting\">\n          <h3 class=\"lab-box__title\">Troubleshooting without abandoning the lesson</h3>\n          <ul class=\"lab-box__meta\"><li>Use when stuck</li><li>Diagnose with Core Four</li></ul>\n          <table>\n            <thead><tr><th>What you observe</th><th>Likely cause</th><th>Repair</th></tr></thead>\n            <tbody>\n              <tr><td>Branch already exists or contains prior runtime files</td><td>Starting state differs</td><td>Checkout <code>main</code>, delete the demo branch, then rerun.</td></tr>\n              <tr><td>Branch cannot be deleted</td><td>You may still be on it</td><td>Use <code>git branch --show-current</code>, checkout <code>main</code>, retry deletion.</td></tr>\n              <tr><td>Commit action blocks</td><td>Permission was removed or not loaded</td><td>Inspect the current settings surface; do not widen it beyond the course list.</td></tr>\n              <tr><td><code>main_aic.py</code> is missing during README Prompt B</td><td>You skipped Prompt A</td><td>Run the interactive A/B in order, or use the self-contained programmable prompt for headless work.</td></tr>\n              <tr><td>Report omits exact output</td><td>Prompt/report contract or execution failed</td><td>Inspect <code>prompt.md</code>, confirm REPORT remains, compare stdout/stderr and independent runs.</td></tr>\n              <tr><td>Bun launcher fails before Claude starts</td><td>Bun tool unavailable</td><td>Verify or install Bun, then rerun; the full three-launcher checkpoint remains incomplete until it passes.</td></tr>\n              <tr><td>You are tempted to repair a file directly</td><td>Ninety-percent trap</td><td>Give the discrepancy and a verification command back to the agent.</td></tr>\n            </tbody>\n          </table>\n        </section>\n\n        <section class=\"lab-box\" id=\"lab-final-pass\">\n          <h3 class=\"lab-box__title\">Final pass sheet</h3>\n          <ul class=\"lab-box__meta\"><li>All required</li><li>Grade from evidence</li></ul>\n          <div class=\"lab-box__pass\">\n            <h4>Artifacts and behavior</h4>\n            <ul>\n              <li>□ Zero application code typed by hand.</li>\n              <li>□ Correct permissions audit from memory.</li>\n              <li>□ Correct five-action A/B delta.</li>\n              <li>□ <code>demo-agentic-coding</code> exists with the required commit.</li>\n              <li>□ The commit contains <code>main_aic.py</code> and <code>main_tac.py</code>.</li>\n              <li>□ <code>main_tac.py</code> prints the greeting plus a one-line AI-agent definition.</li>\n              <li>□ Python, Shell, and TypeScript/Bun launchers complete headlessly.</li>\n              <li>□ REPORT agrees with independent execution.</li>\n              <li>□ Any permission removed in S3 has been restored.</li>\n            </ul>\n            <h4>Oral mastery</h4>\n            <ul>\n              <li>□ Big Three and Core Four, with the precise delta.</li>\n              <li>□ Dan’s scale-and-performance rebuttal.</li>\n              <li>□ Claude Code’s three essential elements.</li>\n              <li>□ Why <code>claude -p</code> changes where the workflow can live.</li>\n              <li>□ The contradicting truth resolved without fatalism.</li>\n            </ul>\n          </div>\n        </section>\n      </section>\n\n      <section class=\"chapter-section\" id=\"mastery\">\n        <span class=\"section-number\">10</span>\n        <h2 class=\"section-title\">Mastery check · retrieve, diagnose, teach</h2>\n        <p class=\"section-lead\">Recognition is not the finish line. Close the chapter, answer on paper, then return to reveal. Score operations and reasoning, not exact prose.</p>\n\n        <h3>Round 1 · Foundations</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative foundations quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">1. What are the Big Three?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Context, model, prompt—present in AI coding whether or not they are visible in the interface.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">2. What upgrades them to the Core Four?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Tools, specifically prompts that can reliably execute long chains of tool calls.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">3. What does “Stop Coding” forbid, and what does it preserve?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It forbids hand-typing application code as the default instrument. It preserves and intensifies code generation, understanding, review, planning, and closed-loop design.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">4. Define Commander of Compute without saying “uses AI.”</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>An engineer who aims compute by specifying outcomes, context, constraints, bounded actions, evidence, and triggers to build systems that build systems.</p></details></div>\n        </section>\n\n        <h3>Round 2 · Trace the demo</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative demo quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">5. Reconstruct Prompt B’s state transitions without looking.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Checkout the demo branch; create <code>main_tac.py</code>; run <code>main_aic.py</code>; run <code>main_tac.py</code>; stage files; commit with the specified message; report completion.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">6. Which runtime artifact must exist before the README Agentic Coding Prompt runs, and why?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p><code>main_aic.py</code>, because Prompt B runs it but does not create it. The interactive A/B order supplies it.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">7. What exact commit subject proves the Git portion completed?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p><code>Demo agentic coding capabilities</code>.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">8. What makes <code>prompt.md</code> self-contained and observable?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It creates both Python files, performs the branch/run/commit chain, and demands exact program outputs in REPORT.</p></details></div>\n        </section>\n\n        <h3>Round 3 · Diagnose with the Core Four</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative diagnosis quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">9. The prompt says commit; the model plans commit; the agent cannot execute it after S3. Which dimension failed?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Tools/permission: the commit tool pattern was removed from the allowlist.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">10. The agent edits the wrong <code>prompt.md</code> in a larger repo. What two dimensions should you probe first?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Context—what paths and repository content it saw—and prompt—whether the target path was explicit.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">11. A tool calls all commands but forgets the first program’s output before REPORT. Which essential element is most suspect?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>The agent architecture’s state/observation management, though the combined system should be evaluated rather than blaming a label alone.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">12. Why is repeated rerolling a weak diagnostic method?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It changes stochastic output without isolating whether context, model, prompt, or tools caused the failed state transition.</p></details></div>\n        </section>\n\n        <h3>Round 4 · Transfer and judgment</h3>\n        <section class=\"retrieval-quiz\" aria-label=\"Cumulative transfer quiz\">\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">13. A prompt generates five excellent files, but a human runs tests, commits, and reports. AI coding or agentic coding?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Primarily AI coding. Output quantity does not move the workflow boundary; the human still carries the engineering transitions.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">14. Why is exact report-back a seed of closed-loop engineering?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>It turns internal work into an externally checkable claim that a human or another program can compare with reality and use for the next decision.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">15. When is a tiny workflow a better leverage point than a huge one?</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>When it repeats often, has clear state transitions and evidence, and can be carried reliably with low marginal human attention.</p></details></div>\n          <div class=\"retrieval-quiz__item\"><p class=\"retrieval-quiz__q\">16. Resolve “replace yourself” in one sentence.</p><details class=\"retrieval-quiz__a\"><summary>Reveal answer</summary><p>Automate your repeated execution so your scarce attention moves to judgment, system ownership, and the next leverage point.</p></details></div>\n        </section>\n\n        <aside class=\"callout callout--why\">\n          <p class=\"callout__label\">Scoring</p>\n          <p><strong>13–16 correct:</strong> ready to teach and proceed. <strong>9–12:</strong> rerun the lab checkpoint associated with each miss. <strong>0–8:</strong> redraw the phase map and Core Four, then reproduce the A/B test again. A recognized answer that you cannot use in diagnosis counts as half credit.</p>\n        </aside>\n\n        <h3>Capstone teach-back</h3>\n        <div class=\"teach-back\">\n          <p>Without notes, teach a colleague for five minutes:</p>\n          <ol>\n            <li>Why reliable long tool chains—not tool calling itself—separate agentic coding from AI coding.</li>\n            <li>How the two README prompts provide evidence.</li>\n            <li>What the Core Four are and how to use them to diagnose a failed commit.</li>\n            <li>What <code>claude -p</code> unlocks that an interactive session does not.</li>\n            <li>Why replacing the operator of one workflow can make the engineer more valuable.</li>\n          </ol>\n          <p class=\"fine\">Expert pass: your listener can reconstruct the course workflow and predict the effect of removing <code>Bash(git commit:*)</code>.</p>\n        </div>\n      </section>\n\n      <section class=\"chapter-section\" id=\"glossary\">\n        <span class=\"section-number\">11</span>\n        <h2 class=\"section-title\">TAC-1 glossary</h2>\n        <p class=\"section-lead\">Use Dan’s terms consistently. Each definition below is narrow enough to test against the lesson repository.</p>\n        <dl class=\"glossary\">\n          <div><dt>TAC</dt><dd>Tactical Agentic Coding: eight lessons, eight tactics, and one course codebase per lesson.</dd></div>\n          <div><dt>Loot box</dt><dd>The per-lesson collection of prompts, links, notes, and assets. The transcript may mishear it as “loop box.”</dd></div>\n          <div><dt>AI coding</dt><dd>Phase-one prompt-to-code work governed by context, model, and prompt. Useful and foundational, but the human often carries the surrounding workflow.</dd></div>\n          <div><dt>Agentic coding</dt><dd>Phase-two engineering in which the Big Three gain tools and a prompt reliably carries a chain of actions.</dd></div>\n          <div><dt>Agentic Engineer</dt><dd>An engineer who builds systems that can take engineering actions, rather than only prompting for isolated artifacts.</dd></div>\n          <div><dt>Commander of compute</dt><dd>The engineer who aims model capacity through outcomes, context, constraints, tools, evidence, and eventually triggers.</dd></div>\n          <div><dt>Big Three</dt><dd>Context, model, prompt—the primitives present in every AI coding interaction.</dd></div>\n          <div><dt>Core Four</dt><dd>Context, model, prompt, tools—the phase-two diagnostic vocabulary.</dd></div>\n          <div><dt>Context</dt><dd>Everything the model can see while working: repository files, current state, settings, instructions, and tool observations.</dd></div>\n          <div><dt>Model</dt><dd>The language model performing interpretation, reasoning, generation, and decisions inside the agentic system.</dd></div>\n          <div><dt>Prompt</dt><dd>The instruction describing outcome, starting state, constraints, actions, checks, and report. In TAC-1 it becomes a runbook.</dd></div>\n          <div><dt>Tools</dt><dd>The bounded actions an agent may perform. Phase-two significance comes from reliable long chains, not mere tool existence.</dd></div>\n          <div><dt>Agentic Coding Prompt</dt><dd>A workflow specification containing a sequence of tool calls. TAC-1 uses RUN, CREATE, RUN, and later REPORT.</dd></div>\n          <div><dt>Long tool chain</dt><dd>Several ordered actions whose observations and state must carry forward reliably toward one outcome.</dd></div>\n          <div><dt>Programmable agentic coding</dt><dd>Calling an agentic tool from code. In TAC-1, Shell, Python, and TypeScript all pass <code>prompt.md</code> to <code>claude -p</code>.</dd></div>\n          <div><dt>REPORT</dt><dd>The prompt block requiring returned evidence. TAC-1 asks for exact outputs of both generated Python files.</dd></div>\n          <div><dt>Closed loop</dt><dd>A structure where action produces observations that can be checked and used for the next decision rather than ending at generation.</dd></div>\n          <div><dt>System that builds systems</dt><dd>Dan’s description of moving up the stack: construct mechanisms that create and operate software-producing mechanisms.</dd></div>\n          <div><dt>Self-operating machine</dt><dd>The incremental end-state of a codebase whose agentic workflows increasingly run at the right time with bounded oversight.</dd></div>\n          <div><dt>Leverage</dt><dd>More valuable outcome per unit of scarce human attention. The “10x” label is arbitrary; the leverage point determines the multiplier.</dd></div>\n          <div><dt>Stop Coding</dt><dd>Tactic #1: stop hand-typing application code while increasing planning, review, code understanding, and closed-loop design.</dd></div>\n          <div><dt>Contradicting truth</dt><dd>The paradox that automating your repeated execution moves you toward higher-order judgment, improvement, and system ownership.</dd></div>\n        </dl>\n      </section>\n\n      <footer class=\"chapter-footer\">\n        <p class=\"eyebrow\">Volume I · Tactical Agentic Coding</p>\n        <div class=\"chapter-footer__nav\">\n          <a href=\"../index.html\">← Book hub</a>\n          <span class=\"fine\">Next: TAC-2 · The 12 Leverage Points (pending)</span>\n        </div>\n      </footer>\n    </main>\n  </div>\n\n  <script>\n    (() => {\n      const topBar = document.getElementById('top-progress');\n      const railBar = document.getElementById('rail-progress');\n      const label = document.getElementById('progress-label');\n      const links = [...document.querySelectorAll('.chapter-nav a')];\n      const sections = links.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);\n      let progressFramePending = false;\n\n      const updateProgress = () => {\n        const max = document.documentElement.scrollHeight - window.innerHeight;\n        const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;\n        const percent = `${Math.round(value * 100)}%`;\n        topBar.style.width = percent;\n        railBar.style.width = percent;\n        label.textContent = percent;\n      };\n\n      const requestProgressUpdate = () => {\n        if (progressFramePending) return;\n        progressFramePending = true;\n        requestAnimationFrame(() => {\n          updateProgress();\n          progressFramePending = false;\n        });\n      };\n\n      const observer = new IntersectionObserver(entries => {\n        const visible = entries\n          .filter(entry => entry.isIntersecting)\n          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];\n        if (!visible) return;\n        links.forEach(link => {\n          const active = link.getAttribute('href') === `#${visible.target.id}`;\n          if (active) link.setAttribute('aria-current', 'location');\n          else link.removeAttribute('aria-current');\n        });\n      }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, .1, .5] });\n\n      sections.forEach(section => observer.observe(section));\n      updateProgress();\n      window.addEventListener('scroll', requestProgressUpdate, { passive: true });\n      window.addEventListener('resize', requestProgressUpdate);\n    })();\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":689,"oldLines":8,"newStart":689,"newLines":8,"lines":["               <div class=\"comparison__body\">","                 <pre><code>RUN: checkout branch"," CREATE: main_tac.py","-RUN: execute both files","-RUN: add + commit</code></pre>","+RUN: execute both files,","+     add + commit</code></pre>","                 <ul>","                   <li><strong>Verbs:</strong> run, create, run</li>","                   <li><strong>State changes:</strong> branch, file, index, commit</li>"]}],"userModified":false,"replaceAll":false}},{"type":"system","subtype":"thinking_tokens","estimated_tokens":50,"estimated_tokens_delta":50,"uuid":"b8a7f80b-053a-4b31-bed6-3c98340ea56c","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":200,"estimated_tokens_delta":150,"uuid":"e31e6703-2a38-4558-946d-2a5f07b8dede","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":300,"estimated_tokens_delta":100,"uuid":"cc11aad4-2be3-4f85-8604-844e5a66ef3c","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":400,"estimated_tokens_delta":100,"uuid":"a1361879-08bf-4a2a-a23f-5c61a77d20cf","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":500,"estimated_tokens_delta":100,"uuid":"2e362966-23f1-4b86-8c21-74873d1862c2","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":600,"estimated_tokens_delta":100,"uuid":"7a2cb526-6710-465a-bd72-1c6985b11556","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":750,"estimated_tokens_delta":150,"uuid":"6507650b-25d6-4c2e-88f2-60e2dbeb4f2a","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":800,"estimated_tokens_delta":50,"uuid":"ef72d0e9-9497-4121-b796-1318f05e6a92","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":900,"estimated_tokens_delta":100,"uuid":"3c73e8cb-507f-431e-98d9-016c65562656","session_id":"a6b5775d-fb8f-4cfd-a661-7da1c120f35f"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":1000,"estimated_tokens_delta":100,"