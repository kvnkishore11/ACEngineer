che_creation_input_tokens":616,"cache_read_input_tokens":148094,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":616},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"ddff0e31-334a-4516-ab52-2aa3ae92393b","request_id":"req_011CcxJY88diP8C2mAe2Vm4e"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJYBN6zvBWxh4PnVMbz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N3p89tqLM1bgTfTU4MT3ob","name":"TaskUpdate","input":{"taskId":"2","status":"completed"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":616,"cache_read_input_tokens":148094,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":616},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"363aa08d-f0cc-45bb-b623-0c2c1c2391d8","request_id":"req_011CcxJY88diP8C2mAe2Vm4e"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N3p89tqLM1bgTfTU4MT3ob","type":"tool_result","content":"Updated task #2 status"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"b5eaa755-7542-47a6-a937-24f686637154","timestamp":"2026-07-12T14:14:48.840Z","tool_use_result":{"success":true,"taskId":"2","updatedFields":["status"],"statusChange":{"from":"in_progress","to":"completed"}}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJYBN6zvBWxh4PnVMbz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WSETQgzhBhsfLrWLqamTPp","name":"TaskUpdate","input":{"taskId":"3","status":"in_progress"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":616,"cache_read_input_tokens":148094,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":616},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"6b79e292-61f1-4eb8-95ab-c8bb8e7169a5","request_id":"req_011CcxJY88diP8C2mAe2Vm4e"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WSETQgzhBhsfLrWLqamTPp","type":"tool_result","content":"Updated task #3 status"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"8b2f12a3-5db3-4259-9f5f-6ee88dfbca57","timestamp":"2026-07-12T14:14:49.349Z","tool_use_result":{"success":true,"taskId":"3","updatedFields":["status"],"statusChange":{"from":"pending","to":"in_progress"}}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJYBN6zvBWxh4PnVMbz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JJvUZGgBe4zK8PiJ873eTM","name":"Write","input":{"file_path":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/extract.md","content":"# TAC-1 · Hello Agentic Coding — Master Teaching Notes\n\n> Source of truth for the expanded chapter. Video 21:51 · Beginner · Tactic #1: **Stop Coding**\n> Lesson artifact: a 35-line README, one settings file, and three ~20-line launcher scripts. That's the whole codebase, on purpose.\n\n**Lesson thesis in one sentence:** AI coding (generating code from prompts) was phase one; agentic coding — prompts that reliably execute long chains of tools inside a programmable agent — is phase two, and the engineer who commands it becomes irreplaceable by replacing themselves.\n\n**The chapter must land eight ideas.** Each below follows: Hook → Picture → Worked example (course codebase) → Dan's term → Failure mode → Retrieval Q.\n\n---\n\n## Idea 1 — A new role exists: the Agentic Engineer\n\n**Hook.** In 2023, before it was obvious, Dan bought a domain name as a bet: agenticengineer.com. The bet was that a new software role would emerge, defined not by writing code but by *building systems that can take actions as we can*. Lesson 1 opens by declaring the bet settled: the role now exists, and this course exists to move you into it.\n\n**Picture.** Frame t0078 (1:18): the agenticengineer.com page on screen while Dan narrates the 2023 prediction. Frame t0115 (1:55): the two-phase timeline — Phase 1 \"AI CODING\" (vibe coders born, code commoditized) flowing into Phase 2 \"AGENTIC CODING\" (real engineers strike back).\n\n**Worked example.** The entire lesson repo *is* the role in miniature: nothing in `tac/tac-1` is application code. It's a README of prompts, a permissions file, and launchers — artifacts of someone who directs systems rather than types programs.\n\n**Dan's term.** *Phase two Agentic Engineer.* Also the era framing: *\"In the generative AI age, AI coding was phase one... Agentic coding marks phase two. This is where real engineers strike back.\"*\n\n**Failure mode.** Hearing \"new role\" as a title change rather than a job change. The weak student keeps doing phase-1 work (prompt → code → paste) with a new label. The role's actual definition — building systems that take actions — is testable: if nothing runs without you pressing the keys, you're still phase one.\n\n**Retrieval Q.** What defines the agentic engineer role, in Dan's 2023 prediction wording? *(Building systems that can take actions as we can.)*\n\n---\n\n## Idea 2 — The mission: become the engineer they can't replace\n\n**Hook.** \"You know who *they* are. It's your boss. It's the company. It's the industry. It's AI.\" Nothing in tech is forever — and in a world where your grandma or your little brother can build an app with one prompt, what exactly makes *you* hard to replace?\n\n**Picture.** Frame t0124 (2:04): the mission slide. Frame t0162 (2:42): the full-screen **COMMANDER OF COMPUTE** title card — the answer to the question the mission poses.\n\n**Worked example.** The answer performed, not stated: by lesson end, a Python script (`programmable/programmable.py`) does a complete branch-write-run-commit-report cycle while the engineer watches. The engineer's contribution moved up one level: they wrote the prompt and the trigger, not the code.\n\n**Dan's term.** *Commander of compute* — \"We do what we always do in technological revolutions. We move up the stack once again.\" And the strategy: *build systems that build systems*. The economics: the fabled *10x engineer* comes from 10x **leverage**, never 10x time — and the number is arbitrary (2x, 100x) depending on the leverage points you find. Also the end-state: codebases as *self-operating machines* that \"literally run themselves.\"\n\n**Failure mode.** Treating the mission as motivational garnish and skipping to the demo. The mission is load-bearing: every later tactic is justified by \"does this increase your leverage per unit of attention?\" Students who skip it evaluate tactics by comfort instead.\n\n**Retrieval Q.** Who are \"they\" in \"an engineer they can't replace,\" and what is the one-word strategy for becoming that engineer? *(Boss, company, industry, AI; leverage — commanding compute to build systems that build systems.)*\n\n---\n\n## Idea 3 — Tactic #1: Stop Coding\n\n**Hook.** The first tactic is dead simple, mission critical, and potentially uncomfortable. Dan says it twice for complete clarity: **Stop coding.** Your hands and your mind are no longer the best tool for the job of writing code. Full stop. This from a man who spent a decade-plus hand-coding at startups and large companies and admits he misses it.\n\n**Picture.** Frame t0414 (6:54): the Tactic #1 reveal. The chapter's headline image.\n\n**Worked example.** Negative space in the codebase: `tac/tac-1` contains zero hand-written application code, and the course promise is that *throughout all of TAC, not a single line of code gets typed*. `main_aic.py` and `main_tac.py` exist only after an agent creates them.\n\n**Dan's term.** *Stop coding.* The supporting cast: \"powerful language models [in] agentic loops running on powerful supercomputers are now vastly superior coders than you and I are\"; \"you're an engineer, not a coder — the difference is massive\"; and the reallocation target — *planning, reviewing, and creating closed-loop structures*.\n\n**Failure mode.** Two opposite misreadings, both fatal. (a) \"No more code\" — wrong: code is still a primary asset that generates features and products; you'll generate more than ever. (b) \"No more understanding code\" — wrong: code understanding remains critically important; review is where your cycles go. And the behavioral failure: agreeing in theory, then hand-editing the agent's output at the first imperfection instead of re-prompting — which trains you to distrust the loop and forfeits the tactic entirely.\n\n**Retrieval Q.** Name the two things \"stop coding\" does NOT mean, and where the freed cycles go. *(Doesn't mean stop generating code or stop understanding it; cycles go to planning, reviewing, closed-loop structures.)*\n\n---\n\n## Idea 4 — Big Three → Core Four: the one-dimension delta\n\n**Hook.** Everything that changed between phase one and phase two is a single added dimension. You already know it — it's been hiding in plain sight, getting more capable over time.\n\n**Picture.** Frame t0845 (14:05): the Core Four Venn diagram — CONTEXT (blue), TOOLS (yellow), MODEL (red), PROMPT (green), overlapping over a dimmed view of the lesson README. The one diagram to memorize from lesson 1.\n\n**Worked example.** `.claude/settings.json` is the \"tools\" circle made concrete — the exact tool surface the demo runs on: `Read`, `Write`, `Edit`, `Bash(uv run:*)`, `Bash(git checkout:*)`, `Bash(git branch:*)`, `Bash(git add:*)`, `Bash(git commit:*)`, `WebSearch`. Read it and you can predict everything the agentic prompt is able to do — and everything it isn't.\n\n**Dan's term.** *The big three* (context, model, prompt — \"always there even if you can't see it\") upgraded by tools to *the core four*. Precise wording matters: the new element is *\"prompts that can reliably execute long chains of tools.\"* And the pre-emptive rebuttal to \"tool calling isn't new\": *\"It's not a question of new. It's a question of scale and performance.\"*\n\n**Failure mode.** Shrugging \"big whoop, who cares — prompts call tools now\" (Dan names this exact shrug). The weak student files the core four as vocabulary instead of as a diagnostic: when an agentic run goes wrong, the cause is always one of the four — wrong context, wrong model, wrong prompt, or wrong/missing tools. Students who internalize it debug systematically; students who don't just re-roll the prompt.\n\n**Retrieval Q.** What upgrades the big three to the core four — exact phrasing — and what is Dan's answer to \"tool calling isn't new\"? *(Prompts that reliably execute long chains of tools; it's not a question of new but of scale and performance.)*\n\n---\n\n## Idea 5 — Two prompts, one README: AI coding vs agentic coding\n\n**Hook.** The lesson's centerpiece is an A/B test you run on your own machine. Same repo, same agent, same afternoon — two prompts. One generates a file. The other does engineering. The difference between them, Dan insists, is *monumental*.\n\n**Picture.** Before/after pair: frame t0700 (11:40) — the AI coding prompt creating `main_aic.py`, nothing you haven't seen a million times; frame t0748 (12:28) — Claude Code converting the agentic prompt into a todo checklist; frame t0790 (13:10) — the full trace: `git checkout -b demo-agentic-coding`, `Write(main_tac.py)`, both `uv run` outputs, `git add`, `git commit`, todos checked off.\n\n**Worked example.** From `README.md` (35 lines — Dan's count is exact):\n\n- **AI Coding Prompt:** `CREATE main_aic.py: print goodbye ai coding` → one file, one print. Phase 1: code generation, full stop.\n- **Agentic Coding Prompt:** `RUN:` checkout new/existing `demo-agentic-coding` branch → `CREATE main_tac.py:` print \"hello agentic coding\" + a concise definition of AI agents → `RUN:` `uv run main_aic.py`, `uv run main_tac.py`, `git add .`, `git commit -m \"Demo agentic coding capabilities\"` → the agent plans, executes step by step, cleans up its todos, reports what it did.\n\nNote the prompt's *shape*: RUN/CREATE/RUN reads like a runbook. The prompt is a workflow specification, and the verbs are tool calls.\n\n**Dan's term.** *The Agentic (Coding) Prompt* — \"a prompt contains a sequence of tool calls.\" And the observation that unlocks it: \"Claude Code is not just writing code. It's calling tools. It's doing engineering work.\"\n\n**Failure mode.** Concluding the prompts are equivalent \"because both made files appear.\" The tell that a student missed the lesson: they can't list what the second prompt did that the first didn't (branch, execute, commit, report). Secondary failure: not rerunning the demo after deleting the branch, so they never see that the workflow is *reproducible* — the property everything in later lessons depends on.\n\n**Retrieval Q.** List everything the agentic prompt did that the AI coding prompt didn't. *(Branch checkout, second file creation per spec, running both programs, git add + commit, todo management + report.)*\n\n---\n\n## Idea 6 — Why Claude Code: the three essential elements\n\n**Hook.** If prompts could always call tools, why did agentic coding only now become real? Because the tools changed and the models improved — and one tool combined the ingredients properly first. There's a new form factor of engineering to take into account.\n\n**Picture.** Frame t0903 (15:03): the three-elements slide. Frame t0608 (10:08): the humble on-ramp — VS Code, Cmd+J, `claude`, boot screen.\n\n**Worked example.** The demo itself is the evidence: a 12-line prompt produced a plan, five tool executions in the right order with correct recovery of context between them, and a report — with zero baby-sitting. That reliability across a *long chain* is the differentiator the slide names.\n\n**Dan's term.** The *three essential elements*: (1) a powerful language model that can reason when needed; (2) the ability to consistently call long chains of tools; (3) the right agent architecture. Result: \"Reliable agentic coding at scale was not possible before Claude Code.\" Positioning: \"Just as Aider was for the AI coding phase one era, Claude Code represents the best phase two agentic coding tool\" — being copied by every other tool. Economics stated plainly: millions and millions of tokens; have the funds or the plan; *pay to play* for maximum ROI. And the anti-lock-in clause: tactics are *transferable* — \"don't get stuck on any one tool.\"\n\n**Failure mode.** Tool fixation in either direction: (a) treating the lesson as expired because the UI/models changed — Dan pre-handles this on camera (\"your Claude Code UI might look different... that's all great\"); (b) fanboy-ing the tool and missing that the three elements are a *checklist for evaluating any agentic tool*, which is the transferable part.\n\n**Retrieval Q.** Name Claude Code's three essential elements and the claim they justify. *(Reasoning model + consistent long tool chains + right agent architecture; reliable agentic coding at scale wasn't possible before it.)*\n\n---\n\n## Idea 7 — Programmable agentic coding: the agent as a function call\n\n**Hook.** The lesson's biggest unlock is almost a throwaway line: Claude Code runs in the terminal. Which means any programming language with terminal access can *call it*. Which means the agent is no longer an app you sit in front of — it's a component you build with.\n\n**Picture.** Frame t1063 (17:43): the `programmable/` directory — three launchers + `prompt.md`. Frame t1105 (18:25): `programmable.py` on screen, ~30 lines. Frame t1205 (20:05): the headless run's final REPORT in the terminal. Frame t1000 (16:40): the README-35-lines shot that frames this whole section.\n\n**Worked example.** All three launchers are the same five steps in different costumes — read `programmable/prompt.md`, pass it to `claude -p`, capture output, print it, propagate errors:\n\n- `programmable.sh` — `PROMPT_CONTENT=\"$(cat programmable/prompt.md)\"; OUTPUT=\"$(claude -p \"$PROMPT_CONTENT\")\"; echo \"$OUTPUT\"` (3 lines; the pattern with nothing else)\n- `programmable.py` — `subprocess.run([\"claude\", \"-p\", prompt_content], capture_output=True, text=True)`, print stdout/stderr, `sys.exit(returncode)` (the variant Dan runs; the most production-shaped: error handling + exit-code propagation)\n- `programmable.ts` — Bun: `await $\\`claude -p ${promptContent}\\`.text()` then log (proves language choice is irrelevant)\n\n`prompt.md` itself is a *superset* of the README demo and self-contained: it creates BOTH `main_aic.py` and `main_tac.py` (no dependency on a prior interactive run), and adds a fourth block the README prompt lacks — `REPORT: respond with the exact output of both .py files`. That REPORT block is the seed of every report-back/verification pattern in later AI developer workflows: headless runs must *tell you what happened*.\n\nDemo order matters and is worth reproducing exactly: delete the branch from the interactive run first (`git branch -D demo-agentic-coding`), then `uv run python programmable/programmable.py` from `main` — and watch the whole workflow re-materialize without you.\n\n**Dan's term.** *Programmable agentic coding* / a *programmable agentic coding tool*. Why it matters: \"we can embed our own agents, our own workflows, our own agentic prompts across the software development lifecycle\" — across all developer environments, \"including full agentic environments where we're not even present,\" with *agentic triggers* (a later-course topic) deciding when they fire. \"It's not just about the agentic prompt. It's about **where** we can use the agentic prompt.\"\n\n**Failure mode.** Watching instead of running — the scripts look too trivial to bother with, so the student never feels the qualitative difference between *chatting with* an agent and *invoking* one. Second failure: missing that `prompt.md` ≠ the README prompt (the superset + REPORT differences are exactly the parts that make headless runs viable). Third: not realizing `.env.sample` (`ANTHROPIC_API_KEY=`) marks the API-billing path that headless/CI usage implies.\n\n**Retrieval Q.** What one property of Claude Code makes it programmable, and what does prompt.md's REPORT block demand? *(It runs in the terminal, so any language with terminal access can invoke `claude -p`; REPORT demands the exact output of both .py files.)*\n\n---\n\n## Idea 8 — The contradicting truth: replace yourself\n\n**Hook.** The lesson ends on a paradox sharp enough to be the course's motto: *to become an irreplaceable engineer, you will replace yourself.* The engineer who automates their own work owns the automation — and no vibe coder will replicate what that engineer can do.\n\n**Picture.** t1250 (20:50) is B-roll (hands typing) — render this beat as a designed pull-quote, not a frame (`diagram_instead: true` in the frame plan).\n\n**Worked example.** Lesson 1's arc in miniature already performed it: the engineer ran a prompt interactively (doing the work), then scripted the same prompt (`programmable/*`), making themselves unnecessary for that workflow — permanently. Multiply by every workflow you own: that's the course.\n\n**Dan's term.** *The contradicting truth.* Supporting frame: evolution — \"Evolution forces us to leave skills behind to adapt new ones and bet on potential futures. But in the tech industry, this is where all the alpha lies... your asymmetric engineering advantage exists... in the future.\" Teaser for lesson 2: leverage points such that *10 minutes of your work equals 60+ minutes of another engineer's*.\n\n**Failure mode.** Reading the paradox as job-loss fatalism (and disengaging) instead of as the leverage strategy it is. The resolution the student must be able to articulate: what gets replaced is your *typing*; what becomes irreplaceable is your *judgment about what to build and your ownership of the systems that build it*.\n\n**Retrieval Q.** State the contradicting truth and resolve it in one sentence. *(To become irreplaceable you'll replace yourself — you automate your current work, and the irreplaceable part becomes your command of the systems doing it.)*\n\n---\n\n## Timeline map (VTT-verified)\n\n| Time | Beat |\n|---|---|\n| 0:13–1:01 | Cold open: AI coding is not enough; lesson goal |\n| 1:01–1:57 | 2023 domain-name bet; phase 1 vs phase 2 |\n| 1:57–3:14 | Mission (irreplaceable); commander of compute; systems that build systems; engineering ≠ writing code |\n| 3:14–4:56 | Course structure: 8 lessons, 8 tactics; loot box; per-lesson codebases; ambition (\"land on Mars or the moon\") |\n| 4:56–6:47 | What winning means: 10x by leverage; 80% of life is noise; self-operating machines |\n| 6:47–9:06 | **Tactic #1: Stop coding** (said twice); vastly-superior-coders claim; engineer-not-coder; what still matters (planning, reviewing, closed loops) |\n| 9:06–10:00 | Essential tools; fresh dir; clone tac-1; VS Code; Cmd+J; `claude` |\n| 10:00–11:18 | Claude Code as primary tool; token economics; Aider analogy; tools-will-change disclaimer; repo tour; check `.claude/settings.json` |\n| 11:18–12:03 | AI coding prompt run → `main_aic.py`. \"Nothing new.\" |\n| 12:03–13:23 | Agentic coding prompt run → checklist → branch, file, runs, commit, report. \"This is agentic coding.\" |\n| 13:23–14:31 | Big three → core four; \"reliably execute long chains of tools\"; scale-and-performance rebuttal |\n| 14:31–16:40 | Claude Code's three essential elements; long-running AI developer workflows (minutes to hours); \"35 lines\" |\n| 16:40–19:00 | Programmable: `claude -p` from sh/ts/py; branch cleanup; headless rerun; embed across the SDLC |\n| 19:00–20:21 | Terminal ubiquity; agentic environments without you; agentic triggers teaser; REPORT output lands |\n| 20:21–21:52 | Recap; contradicting truth; evolution/alpha; lesson-2 teaser (leverage points); sign-off |\n\n## Terminology glossary (Dan-isms, canonical spellings)\n\n- **TAC** — Tactical Agentic Coding (8 lessons, 8 tactics, one codebase each; per-lesson **loot box** of prompts/links/assets under the video)\n- **Big Three** — context, model, prompt (phase-1 primitives)\n- **Core Four** — big three + tools (phase-2 primitives)\n- **Agentic (coding) prompt** — a prompt containing a sequence of reliably-executed tool calls\n- **Commander of compute** — the phase-2 engineer identity\n- **Systems that build systems** — what commanders build; ADW seed\n- **Self-operating machine** — the end-state codebase\n- **Loot box** — per-lesson unlockable assets (transcript mishears as \"loop box\")\n- Transcript corrections: \"Cloud Code\"→Claude Code, \"ADER\"→Aider, \"Bunn\"→Bun, \"Identic Prompt\"→Agentic Prompt\n\n## Bridge to the rest of TAC (as trailed in-lesson)\n\n- Lesson 2: leverage points (10 min of yours = 60+ of another engineer's)\n- Later lessons: closed-loop structures; agentic triggers; scaling the agentic prompt \"to the max\" across the SDLC\n- Constant thread: every lesson = one tactic + one codebase; the tactic is the thing to master\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":616,"cache_read_input_tokens":148094,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":616},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"930c2d77-26d1-4ee4-8c5c-50ba6ca72cec","request_id":"req_011CcxJY88diP8C2mAe2Vm4e"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJvUZGgBe4zK8PiJ873eTM","type":"tool_result","content":"File created successfully at: /Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/extract.md (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"8ef296f4-57a5-4e6a-8e8e-167843b44485","timestamp":"2026-07-12T14:16:26.302Z","tool_use_result":{"type":"create","filePath":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/extract.md","content":"# TAC-1 · Hello Agentic Coding — Master Teaching Notes\n\n> Source of truth for the expanded chapter. Video 21:51 · Beginner · Tactic #1: **Stop Coding**\n> Lesson artifact: a 35-line README, one settings file, and three ~20-line launcher scripts. That's the whole codebase, on purpose.\n\n**Lesson thesis in one sentence:** AI coding (generating code from prompts) was phase one; agentic coding — prompts that reliably execute long chains of tools inside a programmable agent — is phase two, and the engineer who commands it becomes irreplaceable by replacing themselves.\n\n**The chapter must land eight ideas.** Each below follows: Hook → Picture → Worked example (course codebase) → Dan's term → Failure mode → Retrieval Q.\n\n---\n\n## Idea 1 — A new role exists: the Agentic Engineer\n\n**Hook.** In 2023, before it was obvious, Dan bought a domain name as a bet: agenticengineer.com. The bet was that a new software role would emerge, defined not by writing code but by *building systems that can take actions as we can*. Lesson 1 opens by declaring the bet settled: the role now exists, and this course exists to move you into it.\n\n**Picture.** Frame t0078 (1:18): the agenticengineer.com page on screen while Dan narrates the 2023 prediction. Frame t0115 (1:55): the two-phase timeline — Phase 1 \"AI CODING\" (vibe coders born, code commoditized) flowing into Phase 2 \"AGENTIC CODING\" (real engineers strike back).\n\n**Worked example.** The entire lesson repo *is* the role in miniature: nothing in `tac/tac-1` is application code. It's a README of prompts, a permissions file, and launchers — artifacts of someone who directs systems rather than types programs.\n\n**Dan's term.** *Phase two Agentic Engineer.* Also the era framing: *\"In the generative AI age, AI coding was phase one... Agentic coding marks phase two. This is where real engineers strike back.\"*\n\n**Failure mode.** Hearing \"new role\" as a title change rather than a job change. The weak student keeps doing phase-1 work (prompt → code → paste) with a new label. The role's actual definition — building systems that take actions — is testable: if nothing runs without you pressing the keys, you're still phase one.\n\n**Retrieval Q.** What defines the agentic engineer role, in Dan's 2023 prediction wording? *(Building systems that can take actions as we can.)*\n\n---\n\n## Idea 2 — The mission: become the engineer they can't replace\n\n**Hook.** \"You know who *they* are. It's your boss. It's the company. It's the industry. It's AI.\" Nothing in tech is forever — and in a world where your grandma or your little brother can build an app with one prompt, what exactly makes *you* hard to replace?\n\n**Picture.** Frame t0124 (2:04): the mission slide. Frame t0162 (2:42): the full-screen **COMMANDER OF COMPUTE** title card — the answer to the question the mission poses.\n\n**Worked example.** The answer performed, not stated: by lesson end, a Python script (`programmable/programmable.py`) does a complete branch-write-run-commit-report cycle while the engineer watches. The engineer's contribution moved up one level: they wrote the prompt and the trigger, not the code.\n\n**Dan's term.** *Commander of compute* — \"We do what we always do in technological revolutions. We move up the stack once again.\" And the strategy: *build systems that build systems*. The economics: the fabled *10x engineer* comes from 10x **leverage**, never 10x time — and the number is arbitrary (2x, 100x) depending on the leverage points you find. Also the end-state: codebases as *self-operating machines* that \"literally run themselves.\"\n\n**Failure mode.** Treating the mission as motivational garnish and skipping to the demo. The mission is load-bearing: every later tactic is justified by \"does this increase your leverage per unit of attention?\" Students who skip it evaluate tactics by comfort instead.\n\n**Retrieval Q.** Who are \"they\" in \"an engineer they can't replace,\" and what is the one-word strategy for becoming that engineer? *(Boss, company, industry, AI; leverage — commanding compute to build systems that build systems.)*\n\n---\n\n## Idea 3 — Tactic #1: Stop Coding\n\n**Hook.** The first tactic is dead simple, mission critical, and potentially uncomfortable. Dan says it twice for complete clarity: **Stop coding.** Your hands and your mind are no longer the best tool for the job of writing code. Full stop. This from a man who spent a decade-plus hand-coding at startups and large companies and admits he misses it.\n\n**Picture.** Frame t0414 (6:54): the Tactic #1 reveal. The chapter's headline image.\n\n**Worked example.** Negative space in the codebase: `tac/tac-1` contains zero hand-written application code, and the course promise is that *throughout all of TAC, not a single line of code gets typed*. `main_aic.py` and `main_tac.py` exist only after an agent creates them.\n\n**Dan's term.** *Stop coding.* The supporting cast: \"powerful language models [in] agentic loops running on powerful supercomputers are now vastly superior coders than you and I are\"; \"you're an engineer, not a coder — the difference is massive\"; and the reallocation target — *planning, reviewing, and creating closed-loop structures*.\n\n**Failure mode.** Two opposite misreadings, both fatal. (a) \"No more code\" — wrong: code is still a primary asset that generates features and products; you'll generate more than ever. (b) \"No more understanding code\" — wrong: code understanding remains critically important; review is where your cycles go. And the behavioral failure: agreeing in theory, then hand-editing the agent's output at the first imperfection instead of re-prompting — which trains you to distrust the loop and forfeits the tactic entirely.\n\n**Retrieval Q.** Name the two things \"stop coding\" does NOT mean, and where the freed cycles go. *(Doesn't mean stop generating code or stop understanding it; cycles go to planning, reviewing, closed-loop structures.)*\n\n---\n\n## Idea 4 — Big Three → Core Four: the one-dimension delta\n\n**Hook.** Everything that changed between phase one and phase two is a single added dimension. You already know it — it's been hiding in plain sight, getting more capable over time.\n\n**Picture.** Frame t0845 (14:05): the Core Four Venn diagram — CONTEXT (blue), TOOLS (yellow), MODEL (red), PROMPT (green), overlapping over a dimmed view of the lesson README. The one diagram to memorize from lesson 1.\n\n**Worked example.** `.claude/settings.json` is the \"tools\" circle made concrete — the exact tool surface the demo runs on: `Read`, `Write`, `Edit`, `Bash(uv run:*)`, `Bash(git checkout:*)`, `Bash(git branch:*)`, `Bash(git add:*)`, `Bash(git commit:*)`, `WebSearch`. Read it and you can predict everything the agentic prompt is able to do — and everything it isn't.\n\n**Dan's term.** *The big three* (context, model, prompt — \"always there even if you can't see it\") upgraded by tools to *the core four*. Precise wording matters: the new element is *\"prompts that can reliably execute long chains of tools.\"* And the pre-emptive rebuttal to \"tool calling isn't new\": *\"It's not a question of new. It's a question of scale and performance.\"*\n\n**Failure mode.** Shrugging \"big whoop, who cares — prompts call tools now\" (Dan names this exact shrug). The weak student files the core four as vocabulary instead of as a diagnostic: when an agentic run goes wrong, the cause is always one of the four — wrong context, wrong model, wrong prompt, or wrong/missing tools. Students who internalize it debug systematically; students who don't just re-roll the prompt.\n\n**Retrieval Q.** What upgrades the big three to the core four — exact phrasing — and what is Dan's answer to \"tool calling isn't new\"? *(Prompts that reliably execute long chains of tools; it's not a question of new but of scale and performance.)*\n\n---\n\n## Idea 5 — Two prompts, one README: AI coding vs agentic coding\n\n**Hook.** The lesson's centerpiece is an A/B test you run on your own machine. Same repo, same agent, same afternoon — two prompts. One generates a file. The other does engineering. The difference between them, Dan insists, is *monumental*.\n\n**Picture.** Before/after pair: frame t0700 (11:40) — the AI coding prompt creating `main_aic.py`, nothing you haven't seen a million times; frame t0748 (12:28) — Claude Code converting the agentic prompt into a todo checklist; frame t0790 (13:10) — the full trace: `git checkout -b demo-agentic-coding`, `Write(main_tac.py)`, both `uv run` outputs, `git add`, `git commit`, todos checked off.\n\n**Worked example.** From `README.md` (35 lines — Dan's count is exact):\n\n- **AI Coding Prompt:** `CREATE main_aic.py: print goodbye ai coding` → one file, one print. Phase 1: code generation, full stop.\n- **Agentic Coding Prompt:** `RUN:` checkout new/existing `demo-agentic-coding` branch → `CREATE main_tac.py:` print \"hello agentic coding\" + a concise definition of AI agents → `RUN:` `uv run main_aic.py`, `uv run main_tac.py`, `git add .`, `git commit -m \"Demo agentic coding capabilities\"` → the agent plans, executes step by step, cleans up its todos, reports what it did.\n\nNote the prompt's *shape*: RUN/CREATE/RUN reads like a runbook. The prompt is a workflow specification, and the verbs are tool calls.\n\n**Dan's term.** *The Agentic (Coding) Prompt* — \"a prompt contains a sequence of tool calls.\" And the observation that unlocks it: \"Claude Code is not just writing code. It's calling tools. It's doing engineering work.\"\n\n**Failure mode.** Concluding the prompts are equivalent \"because both made files appear.\" The tell that a student missed the lesson: they can't list what the second prompt did that the first didn't (branch, execute, commit, report). Secondary failure: not rerunning the demo after deleting the branch, so they never see that the workflow is *reproducible* — the property everything in later lessons depends on.\n\n**Retrieval Q.** List everything the agentic prompt did that the AI coding prompt didn't. *(Branch checkout, second file creation per spec, running both programs, git add + commit, todo management + report.)*\n\n---\n\n## Idea 6 — Why Claude Code: the three essential elements\n\n**Hook.** If prompts could always call tools, why did agentic coding only now become real? Because the tools changed and the models improved — and one tool combined the ingredients properly first. There's a new form factor of engineering to take into account.\n\n**Picture.** Frame t0903 (15:03): the three-elements slide. Frame t0608 (10:08): the humble on-ramp — VS Code, Cmd+J, `claude`, boot screen.\n\n**Worked example.** The demo itself is the evidence: a 12-line prompt produced a plan, five tool executions in the right order with correct recovery of context between them, and a report — with zero baby-sitting. That reliability across a *long chain* is the differentiator the slide names.\n\n**Dan's term.** The *three essential elements*: (1) a powerful language model that can reason when needed; (2) the ability to consistently call long chains of tools; (3) the right agent architecture. Result: \"Reliable agentic coding at scale was not possible before Claude Code.\" Positioning: \"Just as Aider was for the AI coding phase one era, Claude Code represents the best phase two agentic coding tool\" — being copied by every other tool. Economics stated plainly: millions and millions of tokens; have the funds or the plan; *pay to play* for maximum ROI. And the anti-lock-in clause: tactics are *transferable* — \"don't get stuck on any one tool.\"\n\n**Failure mode.** Tool fixation in either direction: (a) treating the lesson as expired because the UI/models changed — Dan pre-handles this on camera (\"your Claude Code UI might look different... that's all great\"); (b) fanboy-ing the tool and missing that the three elements are a *checklist for evaluating any agentic tool*, which is the transferable part.\n\n**Retrieval Q.** Name Claude Code's three essential elements and the claim they justify. *(Reasoning model + consistent long tool chains + right agent architecture; reliable agentic coding at scale wasn't possible before it.)*\n\n---\n\n## Idea 7 — Programmable agentic coding: the agent as a function call\n\n**Hook.** The lesson's biggest unlock is almost a throwaway line: Claude Code runs in the terminal. Which means any programming language with terminal access can *call it*. Which means the agent is no longer an app you sit in front of — it's a component you build with.\n\n**Picture.** Frame t1063 (17:43): the `programmable/` directory — three launchers + `prompt.md`. Frame t1105 (18:25): `programmable.py` on screen, ~30 lines. Frame t1205 (20:05): the headless run's final REPORT in the terminal. Frame t1000 (16:40): the README-35-lines shot that frames this whole section.\n\n**Worked example.** All three launchers are the same five steps in different costumes — read `programmable/prompt.md`, pass it to `claude -p`, capture output, print it, propagate errors:\n\n- `programmable.sh` — `PROMPT_CONTENT=\"$(cat programmable/prompt.md)\"; OUTPUT=\"$(claude -p \"$PROMPT_CONTENT\")\"; echo \"$OUTPUT\"` (3 lines; the pattern with nothing else)\n- `programmable.py` — `subprocess.run([\"claude\", \"-p\", prompt_content], capture_output=True, text=True)`, print stdout/stderr, `sys.exit(returncode)` (the variant Dan runs; the most production-shaped: error handling + exit-code propagation)\n- `programmable.ts` — Bun: `await $\\`claude -p ${promptContent}\\`.text()` then log (proves language choice is irrelevant)\n\n`prompt.md` itself is a *superset* of the README demo and self-contained: it creates BOTH `main_aic.py` and `main_tac.py` (no dependency on a prior interactive run), and adds a fourth block the README prompt lacks — `REPORT: respond with the exact output of both .py files`. That REPORT block is the seed of every report-back/verification pattern in later AI developer workflows: headless runs must *tell you what happened*.\n\nDemo order matters and is worth reproducing exactly: delete the branch from the interactive run first (`git branch -D demo-agentic-coding`), then `uv run python programmable/programmable.py` from `main` — and watch the whole workflow re-materialize without you.\n\n**Dan's term.** *Programmable agentic coding* / a *programmable agentic coding tool*. Why it matters: \"we can embed our own agents, our own workflows, our own agentic prompts across the software development lifecycle\" — across all developer environments, \"including full agentic environments where we're not even present,\" with *agentic triggers* (a later-course topic) deciding when they fire. \"It's not just about the agentic prompt. It's about **where** we can use the agentic prompt.\"\n\n**Failure mode.** Watching instead of running — the scripts look too trivial to bother with, so the student never feels the qualitative difference between *chatting with* an agent and *invoking* one. Second failure: missing that `prompt.md` ≠ the README prompt (the superset + REPORT differences are exactly the parts that make headless runs viable). Third: not realizing `.env.sample` (`ANTHROPIC_API_KEY=`) marks the API-billing path that headless/CI usage implies.\n\n**Retrieval Q.** What one property of Claude Code makes it programmable, and what does prompt.md's REPORT block demand? *(It runs in the terminal, so any language with terminal access can invoke `claude -p`; REPORT demands the exact output of both .py files.)*\n\n---\n\n## Idea 8 — The contradicting truth: replace yourself\n\n**Hook.** The lesson ends on a paradox sharp enough to be the course's motto: *to become an irreplaceable engineer, you will replace yourself.* The engineer who automates their own work owns the automation — and no vibe coder will replicate what that engineer can do.\n\n**Picture.** t1250 (20:50) is B-roll (hands typing) — render this beat as a designed pull-quote, not a frame (`diagram_instead: true` in the frame plan).\n\n**Worked example.** Lesson 1's arc in miniature already performed it: the engineer ran a prompt interactively (doing the work), then scripted the same prompt (`programmable/*`), making themselves unnecessary for that workflow — permanently. Multiply by every workflow you own: that's the course.\n\n**Dan's term.** *The contradicting truth.* Supporting frame: evolution — \"Evolution forces us to leave skills behind to adapt new ones and bet on potential futures. But in the tech industry, this is where all the alpha lies... your asymmetric engineering advantage exists... in the future.\" Teaser for lesson 2: leverage points such that *10 minutes of your work equals 60+ minutes of another engineer's*.\n\n**Failure mode.** Reading the paradox as job-loss fatalism (and disengaging) instead of as the leverage strategy it is. The resolution the student must be able to articulate: what gets replaced is your *typing*; what becomes irreplaceable is your *judgment about what to build and your ownership of the systems that build it*.\n\n**Retrieval Q.** State the contradicting truth and resolve it in one sentence. *(To become irreplaceable you'll replace yourself — you automate your current work, and the irreplaceable part becomes your command of the systems doing it.)*\n\n---\n\n## Timeline map (VTT-verified)\n\n| Time | Beat |\n|---|---|\n| 0:13–1:01 | Cold open: AI coding is not enough; lesson goal |\n| 1:01–1:57 | 2023 domain-name bet; phase 1 vs phase 2 |\n| 1:57–3:14 | Mission (irreplaceable); commander of compute; systems that build systems; engineering ≠ writing code |\n| 3:14–4:56 | Course structure: 8 lessons, 8 tactics; loot box; per-lesson codebases; ambition (\"land on Mars or the moon\") |\n| 4:56–6:47 | What winning means: 10x by leverage; 80% of life is noise; self-operating machines |\n| 6:47–9:06 | **Tactic #1: Stop coding** (said twice); vastly-superior-coders claim; engineer-not-coder; what still matters (planning, reviewing, closed loops) |\n| 9:06–10:00 | Essential tools; fresh dir; clone tac-1; VS Code; Cmd+J; `claude` |\n| 10:00–11:18 | Claude Code as primary tool; token economics; Aider analogy; tools-will-change disclaimer; repo tour; check `.claude/settings.json` |\n| 11:18–12:03 | AI coding prompt run → `main_aic.py`. \"Nothing new.\" |\n| 12:03–13:23 | Agentic coding prompt run → checklist → branch, file, runs, commit, report. \"This is agentic coding.\" |\n| 13:23–14:31 | Big three → core four; \"reliably execute long chains of tools\"; scale-and-performance rebuttal |\n| 14:31–16:40 | Claude Code's three essential elements; long-running AI developer workflows (minutes to hours); \"35 lines\" |\n| 16:40–19:00 | Programmable: `claude -p` from sh/ts/py; branch cleanup; headless rerun; embed across the SDLC |\n| 19:00–20:21 | Terminal ubiquity; agentic environments without you; agentic triggers teaser; REPORT output lands |\n| 20:21–21:52 | Recap; contradicting truth; evolution/alpha; lesson-2 teaser (leverage points); sign-off |\n\n## Terminology glossary (Dan-isms, canonical spellings)\n\n- **TAC** — Tactical Agentic Coding (8 lessons, 8 tactics, one codebase each; per-lesson **loot box** of prompts/links/assets under the video)\n- **Big Three** — context, model, prompt (phase-1 primitives)\n- **Core Four** — big three + tools (phase-2 primitives)\n- **Agentic (coding) prompt** — a prompt containing a sequence of reliably-executed tool calls\n- **Commander of compute** — the phase-2 engineer identity\n- **Systems that build systems** — what commanders build; ADW seed\n- **Self-operating machine** — the end-state codebase\n- **Loot box** — per-lesson unlockable assets (transcript mishears as \"loop box\")\n- Transcript corrections: \"Cloud Code\"→Claude Code, \"ADER\"→Aider, \"Bunn\"→Bun, \"Identic Prompt\"→Agentic Prompt\n\n## Bridge to the rest of TAC (as trailed in-lesson)\n\n- Lesson 2: leverage points (10 min of yours = 60+ of another engineer's)\n- Later lessons: closed-loop structures; agentic triggers; scaling the agentic prompt \"to the max\" across the SDLC\n- Constant thread: every lesson = one tactic + one codebase; the tactic is the thing to master\n","structuredPatch":[],"originalFile":null,"userModified":false}},{"type":"system","subtype":"thinking_tokens","estimated_tokens":50,"estimated_tokens_delta":50,"uuid":"dd5af882-1a74-4e26-8ebb-4edeb39155e0","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"system","subtype":"thinking_tokens","estimated_tokens":107,"estimated_tokens_delta":57,"uuid":"37662b15-1449-4f50-bb2a-617873e8fd62","session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJfuiF7WjwCo4pLNsm1","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8024,"cache_read_input_tokens":148710,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8024},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"cece27a7-00d3-48b1-ad7c-ba7204431de8","request_id":"req_011CcxJfsUJJXXhveDb14oqY"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJfuiF7WjwCo4pLNsm1","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8024,"cache_read_input_tokens":148710,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8024},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"5768135f-2b15-4463-85c6-c078af0f8230","request_id":"req_011CcxJfsUJJXXhveDb14oqY"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJfuiF7WjwCo4pLNsm1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NoYFGD7iHyaA4HMH9JMBfD","name":"TaskUpdate","input":{"taskId":"3","status":"completed"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8024,"cache_read_input_tokens":148710,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8024},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"f8eaa20c-e1d7-44ea-a1dc-458dcd14a215","request_id":"req_011CcxJfsUJJXXhveDb14oqY"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJfuiF7WjwCo4pLNsm1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RYZfEywq8QgAy2vRVcGT9a","name":"TaskUpdate","input":{"taskId":"4","status":"in_progress"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8024,"cache_read_input_tokens":148710,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8024},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"532566df-7cb2-4b3a-bc04-c5ff4e649b33","request_id":"req_011CcxJfsUJJXXhveDb14oqY"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NoYFGD7iHyaA4HMH9JMBfD","type":"tool_result","content":"Updated task #3 status"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"d1bbe88f-604d-4b49-b02a-9d3802733598","timestamp":"2026-07-12T14:16:36.018Z","tool_use_result":{"success":true,"taskId":"3","updatedFields":["status"],"statusChange":{"from":"in_progress","to":"completed"}}},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RYZfEywq8QgAy2vRVcGT9a","type":"tool_result","content":"Updated task #4 status"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"786c7724-241d-4699-9d4d-bd34683d1fb8","timestamp":"2026-07-12T14:16:36.041Z","tool_use_result":{"success":true,"taskId":"4","updatedFields":["status"],"statusChange":{"from":"pending","to":"in_progress"}}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJfuiF7WjwCo4pLNsm1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01J2XsggJv5HMpSEKokcQQhR","name":"Write","input":{"file_path":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/nuggets.md","content":"# TAC-1 Nuggets — ranked for the struggling learner\n\nOrdering rule: how much of the rest of the course breaks if this nugget is missing. Tier 1 is non-negotiable; Tier 2 is the working machinery; Tier 3 is framing that keeps you motivated and honest.\n\n---\n\n## Tier 1 — If you remember nothing else\n\n**1. The whole upgrade is ONE added ingredient.**\nAI coding runs on the big three: **context, model, prompt**. Agentic coding = big three + **tools**, and \"tools\" means *prompts that can reliably execute long chains of tool calls*. That's the core four. Every lesson after this one is just scaling that fourth ingredient.\n*Why weak learners lose it:* it sounds too small to matter. Test yourself: when a run fails, can you name which of the four was wrong?\n\n**2. Stop coding ≠ stop shipping code, and ≠ stop reading code.**\nStop *typing* it. Agents type; you plan, review, and build closed loops. Code volume goes UP; your keystrokes go to zero. If you hand-edit the agent's file when it's 90% right instead of re-prompting, you've quietly quit the course.\n*Say it Dan's way:* \"Your hands and your mind are no longer the best tool for the job of writing code. Full stop.\"\n\n**3. A prompt can BE a workflow.**\nThe README's agentic prompt isn't a request for text — it's a runbook: RUN (branch) → CREATE (file) → RUN (execute, add, commit). The agent plans it as a checklist and does engineering work. If you can only remember one artifact from the lesson, remember what those 12 lines did.\n\n**4. The agent is a function you can call from code.**\n`claude -p \"<prompt>\"` from shell, Python, or TypeScript. Three tiny scripts in `programmable/` prove it. This is the seed of everything \"systems that build systems\" means — the agent stops being a chat window and becomes a building block you can embed anywhere, including places you aren't.\n\n---\n\n## Tier 2 — The working machinery\n\n**5. The A/B test is the lesson. Run it, don't watch it.**\nSame repo, two prompts: `main_aic.py` (file generated — phase 1) vs branch+file+runs+commit+report (engineering done — phase 2). Then delete the branch and rerun it *headlessly* with `uv run python programmable/programmable.py`. Feeling the rerun is what installs the concept.\n\n**6. Read `.claude/settings.json` before you run anything. Always.**\nIt's the agent's entire tool surface: Read/Write/Edit, `uv run`, four git commands, WebSearch. Know what the agent MAY do and you can predict everything it will do. This habit scales to every agentic tool you'll ever touch.\n\n**7. \"Tool calling isn't new\" — correct, and irrelevant.**\nDan's rebuttal, verbatim: \"It's not a question of new. It's a question of **scale and performance**.\" What's new is *reliable long chains*: plans that survive twelve consecutive tool calls without derailing.\n\n**8. Why Claude Code (three essential elements).**\n(1) A model that can reason when needed, (2) consistent long tool chains, (3) the right agent architecture. Together they made \"reliable agentic coding at scale\" possible for the first time. Use the trio as a checklist for judging ANY agentic tool — that's the transferable part. Don't get stuck on any one tool.\n\n**9. Make the agent REPORT.**\n`programmable/prompt.md` ends with `REPORT: respond with the exact output of both .py files`. Headless work you can't verify is work you can't trust. Report-back is the first closed-loop habit of the course.\n\n**10. Wrapped in the right tool, prompts become long-running workflows.**\nMinutes to hours, end to end, with and without your oversight — fired repeatedly with the right triggers at the right time. That's the scale Dan is asking you not to turn your brain off about.\n\n---\n\n## Tier 3 — Framing that keeps you going\n\n**11. You're an engineer, not a coder.**\nEngineering was never about writing code; it's about systems of leverage that produce outcomes for users and customers. This reframe is what makes Tactic #1 survivable emotionally.\n\n**12. 10x comes from leverage, never from effort.**\nAnd the number is arbitrary — 2x, 10x, 100x — set by the leverage points you find. 80% of life is noise and repetition; this is the rare opportunity worth focusing on.\n\n**13. Pay to play.**\nMillions and millions of tokens across the course. Budget for it (plan or API funds) or you'll stall mid-lesson and blame the tactics.\n\n**14. The contradicting truth: to become irreplaceable, replace yourself.**\nWhoever automates the work owns the automation. What gets replaced is your typing; what becomes irreplaceable is your judgment and your ownership of the systems doing the work.\n\n**15. The mission has named enemies.**\n\"An engineer *they* can't replace — your boss, the company, the industry, AI.\" Nothing in tech is forever; constant evolution is the price of staying valuable. That's why lesson 1 spends six minutes on stakes before touching a terminal.\n\n---\n\n## Micro-quiz (close the book first)\n\n1. Big three? Core four? Which element is new and what's its precise definition?\n2. Five things the agentic prompt did that the AI coding prompt didn't?\n3. What file tells you the agent's tool surface, and what's in it here?\n4. Write the shell version of the programmable pattern from memory (3 lines).\n5. What does prompt.md's REPORT block demand, and why does that matter for headless runs?\n6. Resolve the paradox: how does replacing yourself make you irreplaceable?\n\n*(Answers: extract.md ideas 4, 5, 4/6, 7, 7, 8.)*\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8024,"cache_read_input_tokens":148710,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8024},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"f09c8c35-d3b7-48f9-842a-15c4f5e68beb","request_id":"req_011CcxJfsUJJXXhveDb14oqY"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J2XsggJv5HMpSEKokcQQhR","type":"tool_result","content":"File created successfully at: /Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/nuggets.md (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"da3282af-94dd-4b0b-a1ee-6e88baa7a20a","timestamp":"2026-07-12T14:17:01.826Z","tool_use_result":{"type":"create","filePath":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/nuggets.md","content":"# TAC-1 Nuggets — ranked for the struggling learner\n\nOrdering rule: how much of the rest of the course breaks if this nugget is missing. Tier 1 is non-negotiable; Tier 2 is the working machinery; Tier 3 is framing that keeps you motivated and honest.\n\n---\n\n## Tier 1 — If you remember nothing else\n\n**1. The whole upgrade is ONE added ingredient.**\nAI coding runs on the big three: **context, model, prompt**. Agentic coding = big three + **tools**, and \"tools\" means *prompts that can reliably execute long chains of tool calls*. That's the core four. Every lesson after this one is just scaling that fourth ingredient.\n*Why weak learners lose it:* it sounds too small to matter. Test yourself: when a run fails, can you name which of the four was wrong?\n\n**2. Stop coding ≠ stop shipping code, and ≠ stop reading code.**\nStop *typing* it. Agents type; you plan, review, and build closed loops. Code volume goes UP; your keystrokes go to zero. If you hand-edit the agent's file when it's 90% right instead of re-prompting, you've quietly quit the course.\n*Say it Dan's way:* \"Your hands and your mind are no longer the best tool for the job of writing code. Full stop.\"\n\n**3. A prompt can BE a workflow.**\nThe README's agentic prompt isn't a request for text — it's a runbook: RUN (branch) → CREATE (file) → RUN (execute, add, commit). The agent plans it as a checklist and does engineering work. If you can only remember one artifact from the lesson, remember what those 12 lines did.\n\n**4. The agent is a function you can call from code.**\n`claude -p \"<prompt>\"` from shell, Python, or TypeScript. Three tiny scripts in `programmable/` prove it. This is the seed of everything \"systems that build systems\" means — the agent stops being a chat window and becomes a building block you can embed anywhere, including places you aren't.\n\n---\n\n## Tier 2 — The working machinery\n\n**5. The A/B test is the lesson. Run it, don't watch it.**\nSame repo, two prompts: `main_aic.py` (file generated — phase 1) vs branch+file+runs+commit+report (engineering done — phase 2). Then delete the branch and rerun it *headlessly* with `uv run python programmable/programmable.py`. Feeling the rerun is what installs the concept.\n\n**6. Read `.claude/settings.json` before you run anything. Always.**\nIt's the agent's entire tool surface: Read/Write/Edit, `uv run`, four git commands, WebSearch. Know what the agent MAY do and you can predict everything it will do. This habit scales to every agentic tool you'll ever touch.\n\n**7. \"Tool calling isn't new\" — correct, and irrelevant.**\nDan's rebuttal, verbatim: \"It's not a question of new. It's a question of **scale and performance**.\" What's new is *reliable long chains*: plans that survive twelve consecutive tool calls without derailing.\n\n**8. Why Claude Code (three essential elements).**\n(1) A model that can reason when needed, (2) consistent long tool chains, (3) the right agent architecture. Together they made \"reliable agentic coding at scale\" possible for the first time. Use the trio as a checklist for judging ANY agentic tool — that's the transferable part. Don't get stuck on any one tool.\n\n**9. Make the agent REPORT.**\n`programmable/prompt.md` ends with `REPORT: respond with the exact output of both .py files`. Headless work you can't verify is work you can't trust. Report-back is the first closed-loop habit of the course.\n\n**10. Wrapped in the right tool, prompts become long-running workflows.**\nMinutes to hours, end to end, with and without your oversight — fired repeatedly with the right triggers at the right time. That's the scale Dan is asking you not to turn your brain off about.\n\n---\n\n## Tier 3 — Framing that keeps you going\n\n**11. You're an engineer, not a coder.**\nEngineering was never about writing code; it's about systems of leverage that produce outcomes for users and customers. This reframe is what makes Tactic #1 survivable emotionally.\n\n**12. 10x comes from leverage, never from effort.**\nAnd the number is arbitrary — 2x, 10x, 100x — set by the leverage points you find. 80% of life is noise and repetition; this is the rare opportunity worth focusing on.\n\n**13. Pay to play.**\nMillions and millions of tokens across the course. Budget for it (plan or API funds) or you'll stall mid-lesson and blame the tactics.\n\n**14. The contradicting truth: to become irreplaceable, replace yourself.**\nWhoever automates the work owns the automation. What gets replaced is your typing; what becomes irreplaceable is your judgment and your ownership of the systems doing the work.\n\n**15. The mission has named enemies.**\n\"An engineer *they* can't replace — your boss, the company, the industry, AI.\" Nothing in tech is forever; constant evolution is the price of staying valuable. That's why lesson 1 spends six minutes on stakes before touching a terminal.\n\n---\n\n## Micro-quiz (close the book first)\n\n1. Big three? Core four? Which element is new and what's its precise definition?\n2. Five things the agentic prompt did that the AI coding prompt didn't?\n3. What file tells you the agent's tool surface, and what's in it here?\n4. Write the shell version of the programmable pattern from memory (3 lines).\n5. What does prompt.md's REPORT block demand, and why does that matter for headless runs?\n6. Resolve the paradox: how does replacing yourself make you irreplaceable?\n\n*(Answers: extract.md ideas 4, 5, 4/6, 7, 7, 8.)*\n","structuredPatch":[],"originalFile":null,"userModified":false}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJiXkUYTWvd1W134ugo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PvvE3mV58Bhbcqbj9nWUA6","name":"TaskUpdate","input":{"taskId":"4","status":"completed"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2511,"cache_read_input_tokens":156734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2511},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"29b3c283-6a0f-4401-b00a-f3af3f6cc5c1","request_id":"req_011CcxJiVgTaYQ3ewiWDabS8"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PvvE3mV58Bhbcqbj9nWUA6","type":"tool_result","content":"Updated task #4 status"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"7272e23f-827e-4d99-b3e7-970cd525a203","timestamp":"2026-07-12T14:17:10.506Z","tool_use_result":{"success":true,"taskId":"4","updatedFields":["status"],"statusChange":{"from":"in_progress","to":"completed"}}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJiXkUYTWvd1W134ugo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CKLcpdCW7SwrpjFskdE2Uw","name":"TaskUpdate","input":{"taskId":"5","status":"in_progress"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2511,"cache_read_input_tokens":156734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2511},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"6b09d080-b6bc-428f-a187-fe1216f77db7","request_id":"req_011CcxJiVgTaYQ3ewiWDabS8"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CKLcpdCW7SwrpjFskdE2Uw","type":"tool_result","content":"Updated task #5 status"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"da88ad00-cec8-427c-a9a7-830ea1fdc5e8","timestamp":"2026-07-12T14:17:10.970Z","tool_use_result":{"success":true,"taskId":"5","updatedFields":["status"],"statusChange":{"from":"pending","to":"in_progress"}}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJiXkUYTWvd1W134ugo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y1U19HxwcoWEAUynVKah96","name":"Write","input":{"file_path":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/outdated-vs-current.md","content":"# TAC-1 — Outdated vs Current (course era → mid-2026)\n\nTAC-1 ages unusually well because it teaches primitives, and Dan future-proofs on camera: *\"Your Claude Code UI might look different. You might be using newer models. That's all great... Don't let that distract you from the value embedded in each lesson.\"* Still, five things have moved. For each: what the course shows, what current practice is, and whether the book needs an overlay.\n\n---\n\n## 1. Reusable agent behavior: prompt files → Agent Skills  ⟵ the big named gap\n\n**Course era:** reusable behavior is encoded as a raw prompt file (`programmable/prompt.md`) plus launcher scripts. Works, but discovery, triggering, and composition are all manual.\n**Current:** Agent Skills are the first-class encoding — `SKILL.md` files with frontmatter (name, description, trigger guidance), loaded on demand by Claude Code and shareable across projects/teams. Skills are the modern answer to \"how do I package the thing my agent knows how to do?\" — exactly the question `programmable/` answers primitively.\n**Book treatment:** overlay REQUIRED. This is the course's most-cited gap (\"Skills as modern encoding of engineering\"). Teach prompt.md first (pedagogically perfect: no magic), then show the same workflow as a Skill.\n**Overlay:** `X2ciJedw2vU` — *RAW Agentic Coding: ZERO to Agent SKILL* (include_in_phase1: **yes**).\n\n## 2. Embedding: bare `claude -p` → headless mode + Claude Agent SDK\n\n**Course era:** `claude -p \"<prompt>\"` via subprocess from sh/ts/py; output captured as plain text; REPORT requested inside the prompt itself.\n**Current:** the pattern survives verbatim (and remains the best teaching form), but production embedding now uses headless flags — `--output-format json|stream-json`, `--allowedTools`, `--permission-mode`, session resume — and, for real systems, the Claude Agent SDK (Python/TS): structured outputs, hooks, subagents, multi-turn control. What TAC-1 calls \"programmable agentic coding\" grew into a supported product surface.\n**Book treatment:** sidebar (\"the 3-line script you just wrote has a grown-up form\"), not a rewrite — concept unchanged: agent as callable component.\n**Overlay:** `6fCqj4xFCZI` — *How Claude Code CHANGED Engineering Forever* (include_in_phase1: **yes**).\n\n## 3. Permissions: flat allowlist → modes, hooks, sandboxing\n\n**Course era:** `.claude/settings.json` with a flat `permissions.allow` list (`Read`, `Write`, `Edit`, `Bash(uv run:*)`, four git patterns, `WebSearch`).\n**Current:** that syntax still works, but the surface grew: permission modes (plan/accept-edits/etc.), pre/post tool-use hooks, sandboxed bash, deny rules, and settings layering (user/project/local). Teams gate agents with hooks, not just allowlists.\n**Book treatment:** footnote + \"current practice\" callout. The lesson's HABIT — always read what the agent may do before running it — transfers unchanged and is the actual teaching point.\n**Overlay:** none needed.\n\n## 4. Models & UI: period detail, pre-handled by Dan\n\n**Course era:** course-era Claude models and TUI; Aider cited as the phase-1 analogue.\n**Current:** newer model families (Claude 4.x → Claude 5 era), richer TUI, plan modes, background tasks. None of it invalidates a frame of the lesson — the demo is deliberately primitive-level.\n**Book treatment:** one-line margin note on affected screenshots (\"UI is period detail; the flow is identical today\"). No overlay.\n\n## 5. Scale: one serial loop → fleets, subagents, parallel worktrees\n\n**Course era:** one agent, one workflow, serially, in one terminal — deliberately, since it's lesson 1 of 8.\n**Current:** the same agentic prompt is routinely fanned out: subagents, background tasks, git-worktree-isolated parallel runs, orchestrated pipelines. \"Systems that build systems\" now has industrial-strength machinery.\n**Book treatment:** forward-pointer only (\"the course scales this in later lessons; today's ceiling is higher still\"). Overlaying scale content on lesson 1 would front-run the pedagogy.\n**Overlay candidates (deferred to later chapters):** `fop_yxV-mPo` — *Codebase Singularity*; `hGg3nWp7afg` — *3 Codebase Folders* (both include_in_phase1: **no**).\n\n---\n\n## What has NOT aged (teach with full confidence)\n\n- The phase-1/phase-2 frame and \"AI coding is not enough\" — if anything, more consensus now than at recording.\n- The core four. Context/model/prompt/tools remains the complete diagnostic vocabulary for agentic failures.\n- The agentic prompt as workflow-specification (RUN/CREATE/RUN/REPORT) — this shape is now everywhere (slash commands, skills, CI prompts).\n- \"Scale and performance, not novelty\" as the right lens on tool calling.\n- The three-essential-elements checklist for evaluating agentic tools.\n- Terminal ubiquity as the embedding superpower.\n- Report-back as the first closed-loop habit.\n- The economics: token spend as pay-to-play. (Costs shifted; the logic didn't.)\n\n## Phase-1 overlay decision (strict, per brief: max 1–3)\n\n| # | Video | Maps to | Include |\n|---|---|---|---|\n| 1 | `2TIXl2rlA6Q` — AI Coding is NOT ENOUGH | operationalizes tactic (lesson thesis, phase model) | ✅ |\n| 2 | `6fCqj4xFCZI` — How Claude Code CHANGED Engineering Forever | named hole (form factor + programmable embedding, current state) | ✅ |\n| 3 | `X2ciJedw2vU` — RAW Agentic Coding: ZERO to Agent SKILL | corrects outdated (skills gap) | ✅ |\n| 4 | `fop_yxV-mPo` — Codebase Singularity | self-operating vision → later lessons | ❌ defer |\n| 5 | `hGg3nWp7afg` — 3 Codebase Folders | context engineering → later lessons | ❌ defer |\n\n*Caveat: IDs/titles from the orchestration brief's seed list; verify each resolves and content matches title before publishing overlay links (no video fetching was performed in this extract pass, per brief).*\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2511,"cache_read_input_tokens":156734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2511},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"ece79012-9a24-4622-948d-9fb046d6a3b8","request_id":"req_011CcxJiVgTaYQ3ewiWDabS8"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y1U19HxwcoWEAUynVKah96","type":"tool_result","content":"File created successfully at: /Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/outdated-vs-current.md (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"d21b30c9-9ec4-438b-8e14-783a516130a0","timestamp":"2026-07-12T14:17:45.042Z","tool_use_result":{"type":"create","filePath":"/Users/kvnkishore/WebstormProjects/AgenticEngineer/IndyDevDan/book/_extracts/tac-1-hello-agentic-coding/outdated-vs-current.md","content":"# TAC-1 — Outdated vs Current (course era → mid-2026)\n\nTAC-1 ages unusually well because it teaches primitives, and Dan future-proofs on camera: *\"Your Claude Code UI might look different. You might be using newer models. That's all great... Don't let that distract you from the value embedded in each lesson.\"* Still, five things have moved. For each: what the course shows, what current practice is, and whether the book needs an overlay.\n\n---\n\n## 1. Reusable agent behavior: prompt files → Agent Skills  ⟵ the big named gap\n\n**Course era:** reusable behavior is encoded as a raw prompt file (`programmable/prompt.md`) plus launcher scripts. Works, but discovery, triggering, and composition are all manual.\n**Current:** Agent Skills are the first-class encoding — `SKILL.md` files with frontmatter (name, description, trigger guidance), loaded on demand by Claude Code and shareable across projects/teams. Skills are the modern answer to \"how do I package the thing my agent knows how to do?\" — exactly the question `programmable/` answers primitively.\n**Book treatment:** overlay REQUIRED. This is the course's most-cited gap (\"Skills as modern encoding of engineering\"). Teach prompt.md first (pedagogically perfect: no magic), then show the same workflow as a Skill.\n**Overlay:** `X2ciJedw2vU` — *RAW Agentic Coding: ZERO to Agent SKILL* (include_in_phase1: **yes**).\n\n## 2. Embedding: bare `claude -p` → headless mode + Claude Agent SDK\n\n**Course era:** `claude -p \"<prompt>\"` via subprocess from sh/ts/py; output captured as plain text; REPORT requested inside the prompt itself.\n**Current:** the pattern survives verbatim (and remains the best teaching form), but production embedding now uses headless flags — `--output-format json|stream-json`, `--allowedTools`, `--permission-mode`, session resume — and, for real systems, the Claude Agent SDK (Python/TS): structured outputs, hooks, subagents, multi-turn control. What TAC-1 calls \"programmable agentic coding\" grew into a supported product surface.\n**Book treatment:** sidebar (\"the 3-line script you just wrote has a grown-up form\"), not a rewrite — concept unchanged: agent as callable component.\n**Overlay:** `6fCqj4xFCZI` — *How Claude Code CHANGED Engineering Forever* (include_in_phase1: **yes**).\n\n## 3. Permissions: flat allowlist → modes, hooks, sandboxing\n\n**Course era:** `.claude/settings.json` with a flat `permissions.allow` list (`Read`, `Write`, `Edit`, `Bash(uv run:*)`, four git patterns, `WebSearch`).\n**Current:** that syntax still works, but the surface grew: permission modes (plan/accept-edits/etc.), pre/post tool-use hooks, sandboxed bash, deny rules, and settings layering (user/project/local). Teams gate agents with hooks, not just allowlists.\n**Book treatment:** footnote + \"current practice\" callout. The lesson's HABIT — always read what the agent may do before running it — transfers unchanged and is the actual teaching point.\n**Overlay:** none needed.\n\n## 4. Models & UI: period detail, pre-handled by Dan\n\n**Course era:** course-era Claude models and TUI; Aider cited as the phase-1 analogue.\n**Current:** newer model families (Claude 4.x → Claude 5 era), richer TUI, plan modes, background tasks. None of it invalidates a frame of the lesson — the demo is deliberately primitive-level.\n**Book treatment:** one-line margin note on affected screenshots (\"UI is period detail; the flow is identical today\"). No overlay.\n\n## 5. Scale: one serial loop → fleets, subagents, parallel worktrees\n\n**Course era:** one agent, one workflow, serially, in one terminal — deliberately, since it's lesson 1 of 8.\n**Current:** the same agentic prompt is routinely fanned out: subagents, background tasks, git-worktree-isolated parallel runs, orchestrated pipelines. \"Systems that build systems\" now has industrial-strength machinery.\n**Book treatment:** forward-pointer only (\"the course scales this in later lessons; today's ceiling is higher still\"). Overlaying scale content on lesson 1 would front-run the pedagogy.\n**Overlay candidates (deferred to later chapters):** `fop_yxV-mPo` — *Codebase Singularity*; `hGg3nWp7afg` — *3 Codebase Folders* (both include_in_phase1: **no**).\n\n---\n\n## What has NOT aged (teach with full confidence)\n\n- The phase-1/phase-2 frame and \"AI coding is not enough\" — if anything, more consensus now than at recording.\n- The core four. Context/model/prompt/tools remains the complete diagnostic vocabulary for agentic failures.\n- The agentic prompt as workflow-specification (RUN/CREATE/RUN/REPORT) — this shape is now everywhere (slash commands, skills, CI prompts).\n- \"Scale and performance, not novelty\" as the right lens on tool calling.\n- The three-essential-elements checklist for evaluating agentic tools.\n- Terminal ubiquity as the embedding superpower.\n- Report-back as the first closed-loop habit.\n- The economics: token spend as pay-to-play. (Costs shifted; the logic didn't.)\n\n## Phase-1 overlay decision (strict, per brief: max 1–3)\n\n| # | Video | Maps to | Include |\n|---|---|---|---|\n| 1 | `2TIXl2rlA6Q` — AI Coding is NOT ENOUGH | operationalizes tactic (lesson thesis, phase model) | ✅ |\n| 2 | `6fCqj4xFCZI` — How Claude Code CHANGED Engineering Forever | named hole (form factor + programmable embedding, current state) | ✅ |\n| 3 | `X2ciJedw2vU` — RAW Agentic Coding: ZERO to Agent SKILL | corrects outdated (skills gap) | ✅ |\n| 4 | `fop_yxV-mPo` — Codebase Singularity | self-operating vision → later lessons | ❌ defer |\n| 5 | `hGg3nWp7afg` — 3 Codebase Folders | context engineering → later lessons | ❌ defer |\n\n*Caveat: IDs/titles from the orchestration brief's seed list; verify each resolves and content matches title before publishing overlay links (no video fetching was performed in this extract pass, per brief).*\n","structuredPatch":[],"originalFile":null,"userModified":false}},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJmiQWvSC2TSDkFNMSm","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2766,"cache_read_input_tokens":159245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2766},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"a011b7a8-3c81-4347-a368-6214e636c390","request_id":"req_011CcxJmgKW5HfUdyNQBDy8b"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJmiQWvSC2TSDkFNMSm","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2766,"cache_read_input_tokens":159245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2766},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2b29d221-2a38-404f-babf-a4bbd9f0c72a","uuid":"b5155041-a936-4b21-944f-a13b55709084","request_id":"req_011CcxJmgKW5HfUdyNQBDy8b"},{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CcxJmiQWvSC2TSDkFNMSm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MAm4BgWqFbpeJU5tSJKXHW","name":"TaskUpdate","input":{"taskId":"5","status":"completed"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2766,"cache_read_input_tokens":159245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2766},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"dia