+++ b/IndyDevDan/book/vol-3-ma/16-lead-agents.assets.css
@@ -0,0 +1,325 @@
+/* MA-2 extends the gold TAC-1 chapter system with team-orchestration diagrams. */
+@import url("../vol-1-tac/01-hello-agentic-coding.assets.css");
+
+:root {
+  --team-orchestrator: #2f7658;
+  --team-planning: #8c6613;
+  --team-engineering: #9a3652;
+  --team-validation: #9c4f1e;
+  --team-worker: #356f9c;
+  --team-line: #b9ad9b;
+}
+
+.hero--teams::before {
+  position: absolute;
+  inset: 1.25rem 1.5rem auto auto;
+  width: clamp(9rem, 22vw, 18rem);
+  height: clamp(9rem, 22vw, 18rem);
+  border: 1px solid var(--border);
+  border-radius: 50%;
+  background:
+    radial-gradient(circle at 50% 20%, var(--team-orchestrator) 0 .38rem, transparent .43rem),
+    radial-gradient(circle at 20% 52%, var(--team-planning) 0 .32rem, transparent .37rem),
+    radial-gradient(circle at 50% 52%, var(--team-engineering) 0 .32rem, transparent .37rem),
+    radial-gradient(circle at 80% 52%, var(--team-validation) 0 .32rem, transparent .37rem),
+    radial-gradient(circle at 10% 82%, var(--team-worker) 0 .25rem, transparent .3rem),
+    radial-gradient(circle at 28% 82%, var(--team-worker) 0 .25rem, transparent .3rem),
+    radial-gradient(circle at 42% 82%, var(--team-worker) 0 .25rem, transparent .3rem),
+    radial-gradient(circle at 58% 82%, var(--team-worker) 0 .25rem, transparent .3rem),
+    radial-gradient(circle at 72% 82%, var(--team-worker) 0 .25rem, transparent .3rem),
+    radial-gradient(circle at 90% 82%, var(--team-worker) 0 .25rem, transparent .3rem);
+  content: "";
+  opacity: .42;
+}
+
+.hero--teams h1 { max-width: 12ch; }
+
+.hero-system {
+  display: grid;
+  grid-template-columns: minmax(9rem, .8fr) auto minmax(12rem, 1fr) auto minmax(14rem, 1.35fr);
+  gap: var(--space-3);
+  align-items: center;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.hero-system__node {
+  display: grid;
+  align-content: center;
+  min-height: 8rem;
+  padding: var(--space-4);
+  border: 2px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.hero-system__node--orchestrator { border-color: var(--team-orchestrator); background: var(--ok-wash); }
+.hero-system__node--teams { border-color: var(--accent); background: var(--accent-wash); }
+.hero-system__node b { font: 650 var(--text-md) var(--font-display); }
+.hero-system__node span { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.hero-system__arrow { color: var(--accent); font-size: var(--text-xl); font-weight: 800; text-align: center; }
+
+.pillar-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.pillar-card {
+  min-height: 13rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.pillar-card__n {
+  display: grid;
+  place-items: center;
+  width: 2.1rem;
+  height: 2.1rem;
+  border-radius: 50%;
+  color: var(--ink-inverse);
+  background: var(--accent);
+  font: 750 var(--text-sm) var(--font-mono);
+}
+
+.pillar-card h3 { margin-top: var(--space-3); font-size: var(--text-md); }
+.pillar-card p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.team-map {
+  display: grid;
+  grid-template-columns: minmax(10rem, .72fr) minmax(15rem, 1fr) minmax(22rem, 1.75fr);
+  gap: var(--space-4);
+  align-items: center;
+  padding: var(--space-6);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.team-map__tier {
+  display: grid;
+  gap: var(--space-3);
+}
+
+.team-map__label {
+  color: var(--ink-mute);
+  font: 700 var(--text-xs) var(--font-mono);
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+
+.team-map__node {
+  padding: var(--space-3) var(--space-4);
+  border: 2px solid var(--node-color, var(--border));
+  border-radius: var(--radius-md);
+  background: var(--bg-inset);
+}
+
+.team-map__node b { display: block; font-family: var(--font-display); }
+.team-map__node span { display: block; margin-top: var(--space-1); color: var(--ink-soft); font-size: var(--text-xs); }
+.team-map__node--orch { --node-color: var(--team-orchestrator); background: var(--ok-wash); }
+.team-map__node--planning { --node-color: var(--team-planning); }
+.team-map__node--engineering { --node-color: var(--team-engineering); }
+.team-map__node--validation { --node-color: var(--team-validation); }
+.team-map__workers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
+.team-map__workers .team-map__node { --node-color: var(--team-worker); min-height: 6.5rem; }
+
+.tier-table td:first-child { width: 20%; font-weight: 750; }
+.tier-table td:nth-child(2) { width: 18%; }
+.tier-table td:last-child { border-left: 3px solid var(--ok); }
+
+.lock-stack {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  gap: var(--space-4);
+  align-items: stretch;
+}
+
+.lock-card {
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+}
+
+.lock-card--hard { border: 2px solid var(--ok); background: var(--ok-wash); }
+.lock-card h3 { margin-top: var(--space-2); }
+.lock-card p { margin-top: var(--space-3); color: var(--ink-soft); }
+.lock-stack__plus { align-self: center; color: var(--accent); font-size: var(--text-xl); font-weight: 800; }
+
+.permission-map {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+}
+
+.permission-map div { padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+.permission-map b { display: block; color: var(--accent-ink); font: 650 var(--text-md) var(--font-display); }
+.permission-map span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.memory-loop {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+  align-items: stretch;
+}
+
+.memory-loop__step {
+  position: relative;
+  min-height: 9rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.memory-loop__step:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: calc(var(--space-3) * -1);
+  z-index: 2;
+  color: var(--accent);
+  content: "→";
+  font-weight: 800;
+}
+
+.memory-loop__step b { display: block; color: var(--accent-ink); font-family: var(--font-display); }
+.memory-loop__step span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.skill-matrix td:first-child { width: 28%; font-family: var(--font-mono); font-weight: 700; }
+.skill-matrix .yes { color: var(--ok); font-weight: 800; }
+.skill-matrix .no { color: var(--ink-mute); }
+
+.anatomy-grid {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+}
+
+.anatomy-grid div { padding: var(--space-3); border-top: .3rem solid var(--accent); border-radius: var(--radius-md); background: var(--bg-card); box-shadow: var(--shadow-card); }
+.anatomy-grid b { display: block; font-family: var(--font-display); }
+.anatomy-grid span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-xs); }
+
+.config-split {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.config-split__card { padding: var(--space-5); border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.config-split__card--agent { border-top: .35rem solid var(--team-worker); }
+.config-split__card--yaml { border-top: .35rem solid var(--team-planning); }
+.config-split__card h3 { margin-top: 0; }
+.config-split__card ul { margin-top: var(--space-3); }
+
+.preset-grid {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-2);
+}
+
+.preset-grid div { min-height: 8rem; padding: var(--space-3); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+.preset-grid code { display: inline-block; }
+.preset-grid span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-xs); }
+
+.cost-balance {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  gap: var(--space-4);
+  align-items: center;
+}
+
+.cost-balance__side { min-height: 12rem; padding: var(--space-5); border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.cost-balance__side--value { border: 2px solid var(--ok); background: var(--ok-wash); }
+.cost-balance__side h3 { margin-top: 0; }
+.cost-balance__side p { margin-top: var(--space-3); }
+.cost-balance__mark { color: var(--accent); font: 750 var(--text-2xl) var(--font-display); }
+
+.runtime-flow {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: var(--space-3);
+  align-items: stretch;
+}
+
+.runtime-flow__node { position: relative; min-height: 10rem; padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+.runtime-flow__node:not(:last-child)::after { position: absolute; top: 50%; right: calc(var(--space-4) * -1); z-index: 2; color: var(--accent); content: "→"; font-weight: 800; }
+.runtime-flow__node b { display: block; font-family: var(--font-display); }
+.runtime-flow__node code { display: inline-block; margin-top: var(--space-2); }
+.runtime-flow__node span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-xs); }
+
+.two-runtimes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
+.two-runtimes article { padding: var(--space-5); border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.two-runtimes article:first-child { border-top: .35rem solid var(--team-orchestrator); }
+.two-runtimes article:last-child { border-top: .35rem solid var(--team-worker); }
+.two-runtimes h3 { margin-top: 0; }
+
+.current-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
+.current-link { padding: var(--space-5); border: 1px dashed var(--accent); border-radius: var(--radius-lg); background: var(--bg-card); }
+.current-link h3 { margin-top: var(--space-2); }
+.current-link p { margin-top: var(--space-3); color: var(--ink-soft); }
+
+.frame-card img {
+  width: 100%;
+  max-width: min(100%, 1100px);
+  aspect-ratio: 16 / 9;
+  object-fit: contain;
+  background: var(--bg-card);
+}
+
+.frame-card figcaption { max-width: 78ch; }
+
+.rubric-table th:first-child { width: 18%; }
+.rubric-table td:not(:first-child), .rubric-table th:not(:first-child) { text-align: center; }
+.rubric-table td:first-child { font-weight: 700; }
+
+.source-note { padding: var(--space-4); border-top: var(--hairline); color: var(--ink-mute); font-size: var(--text-sm); }
+
+@media (max-width: 64rem) {
+  .pillar-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .team-map { grid-template-columns: 1fr; }
+  .team-map__workers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .anatomy-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .preset-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .runtime-flow { grid-template-columns: 1fr; }
+  .runtime-flow__node:not(:last-child)::after { top: auto; right: 50%; bottom: calc(var(--space-4) * -1); transform: rotate(90deg); }
+}
+
+@media (max-width: 48rem) {
+  .hero-system,
+  .lock-stack,
+  .cost-balance { grid-template-columns: 1fr; }
+  .hero-system__arrow,
+  .lock-stack__plus,
+  .cost-balance__mark { transform: rotate(90deg); text-align: center; }
+  .pillar-grid,
+  .permission-map,
+  .config-split,
+  .two-runtimes,
+  .current-links { grid-template-columns: 1fr; }
+  .team-map__workers,
+  .anatomy-grid,
+  .preset-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .memory-loop { grid-template-columns: 1fr; }
+  .memory-loop__step:not(:last-child)::after { top: auto; right: 50%; bottom: calc(var(--space-3) * -1); transform: rotate(90deg); }
+}
+
+@media (max-width: 34rem) {
+  .team-map__workers,
+  .anatomy-grid,
+  .preset-grid { grid-template-columns: 1fr; }
+}
+
+@media print {
+  .hero--teams::before { display: none; }
+  .pillar-grid { grid-template-columns: repeat(3, 1fr); }
+  .pillar-card,
+  .team-map__workers .team-map__node,
+  .runtime-flow__node { min-height: 0; }
+  .source-note { display: none; }
+}
