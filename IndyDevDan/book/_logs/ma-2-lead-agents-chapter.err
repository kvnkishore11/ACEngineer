const fs = require('fs');
const path = require('path');
const file = path.resolve('IndyDevDan/book/vol-3-ma/16-lead-agents.html');
const html = fs.readFileSync(file, 'utf8');
const base = path.dirname(file);
const ids = new Set([...html.matchAll(/\\bid=\"(["'^"]+)"/g)].map(m => m[1]));
const refs = [...html.matchAll(/'"\\b(?:href|src)=\"(["'^"]+)"/g)].map(m => m[1]);
const missing = [];
for (const ref of refs) {
  if (/''^(?:https?:|mailto:|data:)/.test(ref)) continue;
  if (ref.startsWith('"'#')) { if ("'!ids.has(ref.slice(1))) missing.push(`anchor ${ref}`); continue; }
  const [pathname, hash] = ref.split('"'#');
  const target = path.resolve(base, pathname);
  if ("'!fs.existsSync(target)) missing.push(`file ${ref}`);
  if (hash && fs.existsSync(target) && target === file && !ids.has(hash)) missing.push(`anchor ${ref}`);
}
const duplicateIds = [...html.matchAll(/'"\\bid=\"(["'^"]+)"/g)].map(m => m[1]).filter((id, i, a) => a.indexOf(id) !== i);
console.log(JSON.stringify({refs: refs.length, localRefs: refs.filter(r => !/''^https?:/.test(r)).length, ids: ids.size, missing, duplicateIds}, null, 2));
