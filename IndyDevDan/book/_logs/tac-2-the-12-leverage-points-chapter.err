-/* TAC-2 extends the gold TAC-1 chapter system without duplicating its layout. */
 @import url("01-hello-agentic-coding.assets.css");
 
-.leverage-grid {
+/* TAC-2 additions. The shared chapter shell remains identical to TAC-1 gold. */
+
+.skip-link {
+  position: fixed;
+  top: var(--space-2);
+  left: var(--space-2);
+  z-index: 200;
+  padding: var(--space-2) var(--space-3);
+  border-radius: var(--radius-sm);
+  color: var(--ink-inverse);
+  background: var(--accent-ink);
+  transform: translateY(-200%);
+}
+
+.skip-link:focus { transform: none; }
+
+.leverage-map {
   display: grid;
   grid-template-columns: repeat(4, minmax(0, 1fr));
   gap: var(--space-3);
   margin-top: var(--space-5);
 }
 
-.leverage-grid article {
+.leverage-map__item {
