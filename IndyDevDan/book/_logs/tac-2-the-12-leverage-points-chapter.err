+          <li><a href="#idea-system"><span class="chapter-nav__n">06</span><span>Fix the system</span></a></li>
+          <li><a href="#idea-types"><span class="chapter-nav__n">07</span><span>Types are IDKs</span></a></li>
+          <li><a href="#idea-architecture"><span class="chapter-nav__n">08</span><span>Architecture</span></a></li>
+          <li><a href="#idea-docs"><span class="chapter-nav__n">09</span><span>Documentation</span></a></li>
+          <li><a href="#idea-tests"><span class="chapter-nav__n">10</span><span>Closed loops</span></a></li>
