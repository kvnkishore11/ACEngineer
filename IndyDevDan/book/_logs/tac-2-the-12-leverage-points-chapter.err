diff --git a/IndyDevDan/book/vol-1-tac/02-the-12-leverage-points.assets.css b/IndyDevDan/book/vol-1-tac/02-the-12-leverage-points.assets.css
new file mode 100644
index 0000000000000000000000000000000000000000..215a42ef6e4bc4c5aee9a95677aa7aed7ad98d60
--- /dev/null
+++ b/IndyDevDan/book/vol-1-tac/02-the-12-leverage-points.assets.css
@@ -0,0 +1,131 @@
+/* TAC-2 extends the gold TAC-1 chapter system without duplicating its layout. */
+@import url("01-hello-agentic-coding.assets.css");
+
+.leverage-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.leverage-grid article {
+  min-height: 9rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.leverage-grid article:nth-child(-n + 4) {
+  border-color: var(--accent);
+  background: var(--accent-wash);
+}
+
+.leverage-grid strong { display: block; font-family: var(--font-display); font-size: var(--text-md); }
+.leverage-grid span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); line-height: 1.45; }
+
+.sdlc-map,
+.kpi-grid,
+.diagnostic-grid {
+  display: grid;
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+}
+
+.sdlc-map { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.kpi-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.diagnostic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+
+.sdlc-map div,
+.kpi-grid article,
+.diagnostic-grid article {
+  position: relative;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
+
+.sdlc-map div:not(:last-child)::after {
+  position: absolute;
+  top: 50%;
+  right: calc(var(--space-3) * -1);
+  z-index: 2;
+  color: var(--accent);
+  content: "→";
+  transform: translate(55%, -50%);
+}
+
+.sdlc-map strong,
+.kpi-grid strong,
+.diagnostic-grid strong { display: block; font-family: var(--font-display); font-size: var(--text-md); }
+.sdlc-map span,
+.kpi-grid span,
+.diagnostic-grid span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.kpi-grid .up strong::after { color: var(--ok); content: " ↑"; }
+.kpi-grid .down strong::after { color: var(--ok); content: " ↓"; }
+
+.formula {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-3);
+  margin-top: var(--space-5);
+  padding: var(--space-5);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: var(--accent-wash);
+  font: 650 var(--text-md) var(--font-display);
+}
+
+.formula b { color: var(--accent-ink); }
+.formula i { color: var(--ink-mute); font-style: normal; }
+
+.evidence-strip {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.evidence-strip div {
+  padding: var(--space-3);
+  border-left: 3px solid var(--accent);
+  background: var(--bg-inset);
+}
+
+.evidence-strip strong { display: block; }
+.evidence-strip span { color: var(--ink-soft); font-size: var(--text-sm); }
+
+.frame-card img {
+  width: 100%;
+  max-width: min(100%, 1100px);
+  height: auto;
+  object-fit: contain;
+}
+
+.generated-plate--hero img {
+  max-height: 48rem;
+  object-fit: contain;
+}
+
+@media (max-width: 65rem) {
+  .leverage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .sdlc-map { grid-template-columns: 1fr; }
+  .sdlc-map div:not(:last-child)::after { top: auto; right: 50%; bottom: calc(var(--space-3) * -1); transform: translate(50%, 55%) rotate(90deg); }
+  .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 46rem) {
+  .leverage-grid,
+  .kpi-grid,
+  .diagnostic-grid,
+  .evidence-strip { grid-template-columns: 1fr; }
+}
+
+@media print {
+  .leverage-grid { grid-template-columns: repeat(4, 1fr); }
+  .kpi-grid { grid-template-columns: repeat(4, 1fr); }
+  .sdlc-map { grid-template-columns: repeat(5, 1fr); }
+}
