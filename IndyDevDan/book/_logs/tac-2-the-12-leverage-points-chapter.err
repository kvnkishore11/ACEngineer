-  flex-wrap: wrap;
-  align-items: center;
-  justify-content: center;
-  gap: var(--space-3);
-  margin-top: var(--space-5);
+.kpi {
   padding: var(--space-5);
-  border: 1px solid var(--accent);
+  border: var(--hairline);
   border-radius: var(--radius-lg);
