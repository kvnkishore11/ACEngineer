+          <li><a href="#orientation"><span class="chapter-nav__n">00</span><span>Orientation</span></a></li>
+          <li><a href="#idea-sdlc"><span class="chapter-nav__n">01</span><span>The durable bet</span></a></li>
+          <li><a href="#idea-perspective"><span class="chapter-nav__n">02</span><span>Adopt the perspective</span></a></li>
