+          <li><a href="#idea-tests"><span class="chapter-nav__n">10</span><span>Tests</span></a></li>
+          <li><a href="#idea-ladder"><span class="chapter-nav__n">11</span><span>Plans → ADWs</span></a></li>
+          <li><a href="#idea-kpis"><span class="chapter-nav__n">12</span><span>Four KPIs</span></a></li>
+          <li><a href="#lab"><span class="chapter-nav__n">13</span><span>Graded lab</span></a></li>
+          <li><a href="#mastery"><span class="chapter-nav__n">14</span><span>Mastery check</span></a></li>
+          <li><a href="#glossary"><span class="chapter-nav__n">15</span><span>Glossary</span></a></li>
+        </ol>
