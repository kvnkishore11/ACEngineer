from pathlib import Path
from html.parser import HTMLParser
from urllib.parse import unquote, urlparse
import json,re
base=Path('IndyDevDan/book/vol-1-tac').resolve()
htmlp=base/'02-the-12-leverage-points.html'
html=htmlp.read_text()
class Audit(HTMLParser):
 def __init__(self): super().__init__(); self.refs=[]; self.ids=[]; self.hrefs=[]; self.text=[]; self.skip=0
 def handle_starttag(self,t,a):
  d=dict(a)
  if 'id' in d:self.ids.append(d['id'])
  for key in ('src','href'):
   if key in d:
    self.refs.append((t,key,d[key]))
    if key=='href':self.hrefs.append(d[key])
  if t in {'script','style'}:self.skip+=1
 def handle_endtag(self,t):
  if t in {'script','style'} and self.skip:self.skip-=1
 def handle_data(self,d):
  if not self.skip:self.text.append(d)
a=Audit();a.feed(html)
missing=[]
for t,k,v in a.refs:
 if v.startswith(('#','http://','https://','mailto:','data:')):continue
 p=(htmlp.parent/unquote(urlparse(v).path)).resolve()
 if not p.exists():missing.append((t,k,v,str(p)))
fragments=[v[1:] for v in a.hrefs if v.startswith('#')]
print('local_refs',sum(1 for _,_,v in a.refs if not v.startswith(('#','http://','https://','mailto:','data:'))))
print('missing_local_refs',missing)
print('duplicate_ids',sorted({x for x in a.ids if a.ids.count(x)>1}))
print('missing_fragments',sorted(set(fragments)-set(a.ids)))
print('unused_section_ids',sorted(set(re.findall(r'<section["'^>]+id="([''^"]+)"'"',html))-set(fragments)))
print('unresolved_placeholders',re.findall(r'\\{\\{["'^}]+'"\\}\\}|TODO|TBD',html)[:20])
print('idea_cycles',html.count('chapter-section idea-cycle'),'moves',len(re.findall(r'class=\"move move--',html)))
print('frame_paths',html.count('../media/frames/tac-2-the-12-leverage-points/'),'youtube',html.count('youtube.com/watch'),'details',html.count('<details'))
words=len(re.findall(r\"\\b[\\w’'-]+\\b\",' '.join(a.text)))
print('visible_words',words)
for cssname in ['../design/tokens.css','../design/base.css','../design/components.css','02-the-12-leverage-points.assets.css']:
 p=(htmlp.parent/cssname).resolve(); s=p.read_text(); print('css',p.name,'bytes',p.stat().st_size,'brace_delta',s.count('{')-s.count('}'))
print('html_tag_presence',all(x in html.lower() for x in ['<"'!doctype html>'"','<html','</html>','<body','</body>']))
print('curriculum_json',json.load(open(base.parent/'data/curriculum.json'))['lessons'][1]['status'])
print('frameplan_json',len(json.load(open(base.parent/'_extracts/tac-2-the-12-leverage-points/frame-plan.json'))['frames']))
