   border-radius: var(--radius-lg);
+  color: var(--accent-ink);
   background: var(--accent-wash);
   font: 650 var(--text-md) var(--font-display);
+  text-align: center;
+}
+
+.leverage-map {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-3);
+  margin-top: var(--space-5);
 }
 
-.formula b { color: var(--accent-ink); }
-.formula i { color: var(--ink-mute); font-style: normal; }
+.leverage-map__item {
+  min-height: 9rem;
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-top: 3px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+}
 
-.evidence-strip {
+.leverage-map__item--in { border-top-color: var(--accent); }
+.leverage-map__item--through { border-top-color: var(--ok); }
+.leverage-map__item b { display: block; margin-bottom: var(--space-2); font: 650 var(--text-md) var(--font-display); }
+.leverage-map__item p { color: var(--ink-soft); font-size: var(--text-sm); }
+
+.kpi-grid {
   display: grid;
-  grid-template-columns: repeat(3, minmax(0, 1fr));
+  grid-template-columns: repeat(4, minmax(0, 1fr));
   gap: var(--space-3);
-  margin-top: var(--space-4);
+  margin-top: var(--space-5);
 }
 
-.evidence-strip div {
-  padding: var(--space-3);
-  border-left: 3px solid var(--accent);
-  background: var(--bg-inset);
+.kpi {
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
 }
 
-.evidence-strip strong { display: block; }
-.evidence-strip span { color: var(--ink-soft); font-size: var(--text-sm); }
+.kpi__direction { color: var(--accent-ink); font: 700 var(--text-xl) var(--font-display); }
+.kpi h3 { margin-top: var(--space-2); }
+.kpi p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+.kpi-grid article.up { border-top: 3px solid var(--ok); }
+.kpi-grid article.down { border-top: 3px solid var(--accent); }
+
+.abstraction-ladder { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.abstraction-ladder .workflow__step { min-height: 9rem; display: grid; align-content: center; }
+.abstraction-ladder .workflow__step code { white-space: normal; }
+
+.mastery-table td:first-child { font-weight: 700; color: var(--accent-ink); }
+.mastery-table td:last-child { width: 32%; }
 
-.frame-card img {
-  width: 100%;
-  max-width: min(100%, 1100px);
-  height: auto;
+.chapter-main .frame-card img {
   object-fit: contain;
 }
 
-.generated-plate--hero img {
-  max-height: 48rem;
-  object-fit: contain;
+.chapter-main table {
+  display: block;
+  max-width: 100%;
+  overflow-x: auto;
 }
 
-@media (max-width: 65rem) {
-  .leverage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
-  .sdlc-map { grid-template-columns: 1fr; }
-  .sdlc-map div:not(:last-child)::after { top: auto; right: 50%; bottom: calc(var(--space-3) * -1); transform: translate(50%, 55%) rotate(90deg); }
+@media (max-width: 56rem) {
+  .sdlc-map,
+  .leverage-grid,
+  .diagnostic-grid,
+  .evidence-strip,
+  .leverage-map,
   .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
 }
 
-@media (max-width: 46rem) {
+@media (max-width: 36rem) {
+  .sdlc-map,
   .leverage-grid,
+  .diagnostic-grid,
+  .evidence-strip,
+  .leverage-map,
   .kpi-grid,
-  .diagnostic-grid,
-  .evidence-strip { grid-template-columns: 1fr; }
+  .abstraction-ladder { grid-template-columns: 1fr; }
 }
 
 @media print {
-  .leverage-grid { grid-template-columns: repeat(4, 1fr); }
-  .kpi-grid { grid-template-columns: repeat(4, 1fr); }
-  .sdlc-map { grid-template-columns: repeat(5, 1fr); }
+  .leverage-map,
+  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
 }
