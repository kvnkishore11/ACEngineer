   .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
 }
 
-@media (max-width: 46rem) {
+@media (max-width: 36rem) {
+  .sdlc-map,
   .leverage-grid,
+  .diagnostic-grid,
+  .evidence-strip,
+  .leverage-map,
   .kpi-grid,
-  .diagnostic-grid,
-  .evidence-strip { grid-template-columns: 1fr; }
+  .abstraction-ladder { grid-template-columns: 1fr; }
 }
 
 @media print {
-  .leverage-grid { grid-template-columns: repeat(4, 1fr); }
-  .kpi-grid { grid-template-columns: repeat(4, 1fr); }
-  .sdlc-map { grid-template-columns: repeat(5, 1fr); }
+  .leverage-map,
+  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
 }
diff --git a/IndyDevDan/book/vol-1-tac/02-the-12-leverage-points.html b/IndyDevDan/book/vol-1-tac/02-the-12-leverage-points.html
