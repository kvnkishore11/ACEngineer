from pathlib import Path
import re
start=Path('IndyDevDan/book/vol-1-tac/02-the-12-leverage-points.assets.css').resolve()
seen=set(); missing=[]
def walk(p):
 if p in seen:return
 seen.add(p)
 s=p.read_text()
 for raw in re.findall(r'(?:url\\(|@import\\s+url\\()[\"\\']?(["'^"'"\\')]+)',s):
  raw=raw.strip()
  if raw.startswith(('data:','http:','https:','#')):continue
  q=(p.parent/raw).resolve()
  if not q.exists():missing.append((str(p),raw,str(q)))
  elif q.suffix=='.css':walk(q)
walk(start)
print('css_files_walked',*[str(p) for p in sorted(seen)],sep='\\n- ')
print('missing_css_refs',missing)
