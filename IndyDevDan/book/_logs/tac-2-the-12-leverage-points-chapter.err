+      <nav class="chapter-nav" aria-label="On this page">
+        <ol>
+          <li><a href="#orientation"><span class="chapter-nav__n">00</span><span>Orientation</span></a></li>
+          <li><a href="#idea-sdlc"><span class="chapter-nav__n">01</span><span>The durable loop</span></a></li>
+          <li><a href="#idea-perspective"><span class="chapter-nav__n">02</span><span>Agent perspective</span></a></li>
+          <li><a href="#idea-map"><span class="chapter-nav__n">03</span><span>The twelve-point map</span></a></li>
+          <li><a href="#idea-tools"><span class="chapter-nav__n">04</span><span>Tools</span></a></li>
+          <li><a href="#idea-stdout"><span class="chapter-nav__n">05</span><span>Standard out</span></a></li>
+          <li><a href="#idea-system"><span class="chapter-nav__n">06</span><span>Fix the system</span></a></li>
