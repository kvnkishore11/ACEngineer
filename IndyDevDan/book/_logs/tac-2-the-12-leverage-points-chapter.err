-/* TAC-2 extends the gold TAC-1 chapter system without duplicating its layout. */
 @import url("01-hello-agentic-coding.assets.css");
 
-.leverage-grid {
+/* TAC-2 additions. The shared chapter shell remains identical to TAC-1 gold. */
+
+.skip-link {
+  position: fixed;
+  top: var(--space-2);
+  left: var(--space-2);
+  z-index: 200;
+  padding: var(--space-2) var(--space-3);
+  border-radius: var(--radius-sm);
+  color: var(--ink-inverse);
+  background: var(--accent-ink);
+  transform: translateY(-200%);
+}
+
+.skip-link:focus { transform: none; }
+
+.sdlc-map {
   display: grid;
-  grid-template-columns: repeat(4, minmax(0, 1fr));
+  grid-template-columns: repeat(5, minmax(0, 1fr));
   gap: var(--space-3);
   margin-top: var(--space-5);
 }
 
-.leverage-grid article {
-  min-height: 9rem;
+.sdlc-map div,
+.leverage-grid article,
+.diagnostic-grid article,
+.evidence-strip article,
+.kpi-grid article {
   padding: var(--space-4);
   border: var(--hairline);
   border-radius: var(--radius-md);
   background: var(--bg-card);
 }
 
-.leverage-grid article:nth-child(-n + 4) {
-  border-color: var(--accent);
-  background: var(--accent-wash);
+.sdlc-map strong,
+.leverage-grid strong,
+.diagnostic-grid strong,
+.evidence-strip strong,
+.kpi-grid strong {
+  display: block;
+  margin-bottom: var(--space-2);
+  color: var(--accent-ink);
+  font-family: var(--font-display);
+  font-size: var(--text-md);
 }
 
-.leverage-grid strong { display: block; font-family: var(--font-display); font-size: var(--text-md); }
-.leverage-grid span { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); line-height: 1.45; }
+.sdlc-map span,
+.leverage-grid span,
+.diagnostic-grid span,
+.evidence-strip span,
+.kpi-grid span {
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+}
 
-.sdlc-map,
-.kpi-grid,
-.diagnostic-grid {
+.leverage-grid {
   display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
   gap: var(--space-3);
   margin-top: var(--space-5);
 }
 
-.sdlc-map { grid-template-columns: repeat(5, minmax(0, 1fr)); }
-.kpi-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
