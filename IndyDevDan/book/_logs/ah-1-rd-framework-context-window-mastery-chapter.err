}
const badCycles = cycles.filter(([, count]) => count "'!== 10);
if (badCycles.length) errors.push(`bad idea cycles: ${JSON.stringify(badCycles)}`);

const frames = [...chapter.matchAll(/<figure class="frame-card">'"\\s*<img src=\"(["'^"]+)"/g)].map(m => m[1]);
if (frames.length !== 12) errors.push(`frame count ${frames.length}, expected 12`);
if (new Set(frames).size !== 12) errors.push('"'frame paths are not unique');
for (const ref of frames) {
  const target = path.resolve(path.dirname(files[0]), ref);
  const buf = fs.readFileSync(target);
  if (buf[0] "'!== 0xff || buf[1] !== 0xd8) errors.push(`not jpeg: ${ref}`);
}

const scripts = [...chapter.matchAll(/<script>(['"\\s\\S]*?)<\\/script>/g)].map(m => m[1]);
for (const [i, script] of scripts.entries()) {
  try { new Function(script); } catch (e) { errors.push("'`script ${i+1}: ${e.message}`); }
}
for (const cssFile of files.filter(f => f.endsWith('"'.css'))) {
  const css = fs.readFileSync(cssFile, 'utf8').replace(/\\/\\*[\\s\\S]*?\\*\\//g, '');
  let depth = 0;
  for (const ch of css) { if (ch === '{') depth++; else if (ch === '}') depth--; if (depth < 0) break; }
  if (depth "'!== 0) errors.push(`unbalanced css braces: ${path.basename(cssFile)} (${depth})`);
}

console.log(JSON.stringify({ids: ids.length, anchors: anchors.length, cycles, frames: frames.length, errors}, null, 2));
process.exitCode = errors.length ? 1 : 0;
