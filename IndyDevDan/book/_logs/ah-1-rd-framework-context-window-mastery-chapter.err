+/* AH-1 reuses the TAC-1 gold teaching grammar and adds context-engineering visuals. */
+@import url("../vol-1-tac/01-hello-agentic-coding.assets.css");
+
+:root {
+  --chapter-wide: 68.75rem;
+  --reduce: var(--accent);
+  --delegate: #3d6b56;
+  --foundation: #5f536e;
+  --level-beginner: #8a6a45;
+  --level-intermediate: #a55a22;
+  --level-advanced: #5f536e;
+  --level-agentic: #2f5d68;
+}
+
+.skip-link {
+  position: fixed;
+  z-index: 200;
+  top: var(--space-2);
+  left: var(--space-2);
+  padding: var(--space-2) var(--space-3);
+  border-radius: var(--radius-sm);
+  color: var(--ink-inverse);
+  background: var(--accent-ink);
+  transform: translateY(-160%);
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.hero--context {
+  background:
+    linear-gradient(135deg, var(--bg-card) 0 60%, color-mix(in srgb, var(--accent-wash) 78%, var(--bg-card)) 60% 100%);
+}
+
+.hero--context::after { display: none; }
+
+.hero-rd {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: var(--space-3);
+  width: min(100%, 48rem);
+  margin-top: var(--space-6);
+}
+
+.hero-rd__lane {
+  min-height: 12rem;
+  padding: var(--space-5);
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-lg);
+  background: color-mix(in srgb, var(--bg-card) 88%, transparent);
+  box-shadow: var(--shadow-card);
+}
+
+.hero-rd__lane--delegate { border-color: var(--delegate); }
+.hero-rd__letter { display: block; color: var(--accent-ink); font: 700 var(--text-3xl)/1 var(--font-display); }
+.hero-rd__lane--delegate .hero-rd__letter { color: var(--delegate); }
+.hero-rd__lane strong { display: block; margin-top: var(--space-2); font: 650 var(--text-lg)/1.1 var(--font-display); }
+.hero-rd__lane p { margin-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.framework-map,
+.technique-grid,
+.practice-grid,
+.evidence-grid,
+.agent-compare,
+.future-grid,
+.lab-evidence {
+  display: grid;
+  gap: var(--space-3);
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+}
+
+.framework-map { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.technique-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.practice-grid,
+.agent-compare { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.evidence-grid,
+.lab-evidence { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.future-grid { grid-template-columns: repeat(5, minmax(10rem, 1fr)); overflow-x: auto; padding-bottom: var(--space-2); }
+
+.framework-map article,
+.technique-grid article,
+.practice-grid article,
+.evidence-grid article,
+.agent-compare article,
+.future-grid article,
+.lab-evidence article {
+  padding: var(--space-4);
+  border: var(--hairline);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.framework-map article { border-top: .35rem solid var(--reduce); }
+.framework-map article:nth-child(2) { border-top-color: var(--delegate); }
+.framework-map strong,
+.technique-grid strong,
+.practice-grid strong,
+.evidence-grid strong,
+.agent-compare strong,
+.future-grid strong,
+.lab-evidence strong {
+  display: block;
+  color: var(--accent-ink);
+  font-family: var(--font-display);
+}
+
+.framework-map article:nth-child(2) strong { color: var(--delegate); }
+.framework-map p,
+.technique-grid p,
+.practice-grid p,
+.evidence-grid p,
+.agent-compare p,
+.future-grid p,
+.lab-evidence p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.level-map {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(12rem, 1fr));
+  gap: var(--space-3);
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  overflow-x: auto;
+  padding-bottom: var(--space-2);
+}
+
+.level-map__level {
+  padding: var(--space-4);
+  border-top: .42rem solid var(--level-color);
+  border-radius: var(--radius-md);
+  background: color-mix(in srgb, var(--level-color) 8%, var(--bg-card));
+  box-shadow: var(--shadow-card);
+}
+
+.level-map__level b { display: block; color: var(--level-color); font: 700 var(--text-lg)/1 var(--font-display); }
+.level-map__level strong { display: block; margin-top: var(--space-2); font-family: var(--font-display); }
+.level-map__level ol { margin-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.technique-head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-2);
+  margin: var(--space-4) 0;
+}
+
+.technique-chip,
+.framework-chip,
+.level-chip,
+.graded-badge {
+  display: inline-flex;
+  align-items: center;
+  padding: .22rem .62rem;
+  border-radius: 999px;
+  font-size: var(--text-xs);
+  font-weight: 750;
+  letter-spacing: .05em;
+  text-transform: uppercase;
+}
+
+.technique-chip { color: var(--ink-inverse); background: var(--ink-soft); }
+.framework-chip--reduce { color: var(--accent-ink); background: var(--accent-wash); }
+.framework-chip--delegate { color: var(--delegate); background: color-mix(in srgb, var(--delegate) 14%, var(--bg-card)); }
+.framework-chip--both { color: var(--foundation); background: var(--teach-wash); }
+.level-chip { color: var(--ink-soft); background: var(--bg-inset); }
+.graded-badge { color: var(--ok); background: var(--ok-wash); }
+
+.context-meter {
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.context-meter__bar {
+  display: flex;
+  height: 3.2rem;
+  margin-top: var(--space-4);
+  overflow: hidden;
+  border-radius: 999px;
+  background: var(--bg-inset);
+}
+
+.context-meter__slice { min-width: 1.25rem; background: var(--slice-color); }
+.context-meter__legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
+.context-meter__legend span::before { display: inline-block; width: .75rem; height: .75rem; margin-right: .4rem; border-radius: 50%; background: var(--slice-color); content: ""; }
+
+.before-after {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  gap: var(--space-3);
+  align-items: stretch;
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+}
+
+.before-after__card { padding: var(--space-5); border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); box-shadow: var(--shadow-card); }
+.before-after__card--after { border-color: var(--ok); background: var(--ok-wash); }
+.before-after__card b { display: block; color: var(--accent-ink); font: 700 var(--text-xl)/1 var(--font-display); }
+.before-after__card p { margin-top: var(--space-2); color: var(--ink-soft); }
+.before-after__arrow { display: grid; place-items: center; color: var(--accent); font: 700 var(--text-xl) var(--font-display); }
+
+.agent-flow {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: var(--space-3);
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+}
+
+.agent-flow__step { position: relative; min-height: 11rem; padding: var(--space-4); border: var(--hairline); border-top: .4rem solid var(--flow-color, var(--accent)); border-radius: var(--radius-md); background: var(--bg-card); box-shadow: var(--shadow-card); }
+.agent-flow__step:not(:last-child)::after { position: absolute; z-index: 2; top: 45%; right: -1.15rem; color: var(--accent); content: "→"; font-weight: 800; }
+.agent-flow__step b { display: block; color: var(--flow-color, var(--accent-ink)); font: 700 var(--text-md)/1.1 var(--font-display); }
+.agent-flow__step code { display: inline-block; margin-top: var(--space-2); }
+.agent-flow__step p { margin-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.bundle-log {
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+  padding: var(--space-5);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--terminal-bg);
+  color: var(--terminal-ink);
+  box-shadow: var(--shadow-card);
+}
+
+.bundle-log code { border: 0; color: inherit; background: transparent; }
+.bundle-log__line + .bundle-log__line { margin-top: var(--space-2); }
+.bundle-log__op { display: inline-block; min-width: 5.4rem; color: #f0b685; font-weight: 700; }
+
+.expert-loop {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: var(--space-3);
+  width: 100%;
+  max-width: min(100%, var(--chapter-wide));
+  margin-inline: auto;
+}
+
+.expert-loop article { position: relative; padding: var(--space-5); border: 1px solid var(--accent); border-radius: 50%; background: var(--bg-card); text-align: center; box-shadow: var(--shadow-card); }
+.expert-loop article:not(:last-child)::after { position: absolute; top: 42%; right: -1.15rem; content: "→"; color: var(--accent); font-weight: 800; }
+.expert-loop strong { display: block; color: var(--accent-ink); font: 700 var(--text-lg) var(--font-display); }
+.expert-loop p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
+
+.future-grid article { border-top: .35rem solid var(--future-color, var(--accent)); }
+.future-grid b { display: block; color: var(--future-color, var(--accent-ink)); font: 700 var(--text-xl)/1 var(--font-display); }
+
+.source-note { padding: var(--space-4); border-left: 4px solid var(--ink-mute); background: var(--bg-inset); color: var(--ink-soft); font-size: var(--text-sm); }
+.teach-back { width: 100%; max-width: min(100%, var(--chapter-wide)); margin-inline: auto; }
+.lab-checklist { padding: 0; list-style: none; }
+.lab-checklist li { position: relative; padding-left: 2rem; }
+.lab-checklist li::before { position: absolute; left: 0; content: "□"; color: var(--accent-ink); font: 700 1.25rem var(--font-mono); }
+
+/* Full-resolution teaching frames: never shrink them to thumbnail cards. */
+.chapter-main .frame-card {
+  width: min(68.75rem, calc(100vw - var(--rail-width) - var(--space-8) - 4rem));
+  max-width: none;
+  margin-block: var(--space-6);
+}
+
+.chapter-main .frame-card img {
+  width: 100%;
+  max-width: 68.75rem;
+  aspect-ratio: 16 / 9;
+  object-fit: contain;
+  background: var(--bg-card);
+}
+
+.chapter-main .frame-card figcaption { max-width: none; }
+
+@media (max-width: 72rem) {
+  .technique-grid,
+  .evidence-grid,
+  .lab-evidence { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .future-grid { grid-template-columns: repeat(5, minmax(13rem, 1fr)); }
+}
+
+@media (max-width: 52rem) {
+  .hero-rd,
+  .framework-map,
+  .technique-grid,
+  .practice-grid,
+  .evidence-grid,
+  .agent-compare,
+  .lab-evidence,
+  .expert-loop { grid-template-columns: 1fr; }
+  .level-map { grid-template-columns: repeat(4, minmax(14rem, 1fr)); }
+  .before-after { grid-template-columns: 1fr; }
+  .before-after__arrow { transform: rotate(90deg); }
+  .agent-flow { grid-template-columns: 1fr; }
+  .agent-flow__step:not(:last-child)::after { top: auto; right: 50%; bottom: -1.45rem; transform: rotate(90deg); }
+  .expert-loop article { border-radius: var(--radius-lg); }
+  .expert-loop article:not(:last-child)::after { top: auto; right: 50%; bottom: -1.4rem; transform: rotate(90deg); }
+}
+
+@media print {
+  .hero-rd,
+  .level-map,
+  .context-meter,
+  .before-after,
+  .agent-flow,
+  .bundle-log,
+  .expert-loop,
+  .future-grid,
+  .frame-card { break-inside: avoid; }
+  .future-grid { grid-template-columns: repeat(5, 1fr); font-size: 8pt; }
+  .agent-flow__step { min-height: auto; }
+}
diff --git a/IndyDevDan/book/vol-2-ah/09-rd-framework-context-window-mastery.html b/IndyDevDan/book/vol-2-ah/09-rd-framework-context-window-mastery.html
new file mode 100644
index 0000000000000000000000000000000000000000..b36420dff01a9a65c439eb603b4c3f3c584f99a5
--- /dev/null
+++ b/IndyDevDan/book/vol-2-ah/09-rd-framework-context-window-mastery.html
@@ -0,0 +1,1519 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="A teaching-first companion to Agentic Horizon lesson 1: measure, reduce, delegate, and deliberately own an agent's context window through twelve course-grounded techniques.">
+  <title>AH-1 · Elite Context Engineering — IndyDevDan Expert Book</title>
+  <link rel="stylesheet" href="../design/tokens.css">
+  <link rel="stylesheet" href="../design/base.css">
+  <link rel="stylesheet" href="../design/components.css">
+  <link rel="stylesheet" href="09-rd-framework-context-window-mastery.assets.css">
+</head>
+<body>
+  <a class="skip-link" href="#main-content">Skip to chapter content</a>
+  <div class="reading-progress" aria-hidden="true"><span class="reading-progress__bar" id="top-progress"></span></div>
+  <header class="site-bar">
+    <a class="site-bar__home" href="../index.html" aria-label="Back to the book hub">← IndyDevDan Expert Book</a>
+    <span class="site-bar__meta">VOL II · AH · CHAPTER 09</span>
+  </header>
+
+  <div class="chapter-shell">
+    <aside class="chapter-rail" aria-label="Chapter navigation">
+      <p class="rail-kicker">Volume II · Agentic Horizon</p>
+      <h2>Elite Context Engineering</h2>
+      <div class="rail-progress">
+        <p class="micro-label">Reading progress</p>
+        <div class="rail-progress__line"><span class="rail-progress__fill" id="rail-progress"></span></div>
+        <p class="rail-progress__copy"><span id="progress-label">0%</span><span>of chapter</span></p>
+      </div>
+      <nav class="chapter-nav" aria-label="On this page">
+        <ol>
+          <li><a href="#orientation"><span class="chapter-nav__n">00</span><span>R&amp;D orientation</span></a></li>
+          <li><a href="#measure"><span class="chapter-nav__n">01</span><span>Measure to manage</span></a></li>
+          <li><a href="#mcp"><span class="chapter-nav__n">02</span><span>Avoid idle MCP</span></a></li>
+          <li><a href="#prime"><span class="chapter-nav__n">03</span><span>Prime, don’t default</span></a></li>
+          <li><a href="#output"><span class="chapter-nav__n">04</span><span>Control output</span></a></li>
+          <li><a href="#subagents"><span class="chapter-nav__n">05</span><span>Sub-agents properly</span></a></li>
+          <li><a href="#architect"><span class="chapter-nav__n">06</span><span>Architect / editor</span></a></li>
+          <li><a href="#reset"><span class="chapter-nav__n">07</span><span>Reset and prime</span></a></li>
+          <li><a href="#bundles"><span class="chapter-nav__n">08</span><span>Context bundles</span></a></li>
+          <li><a href="#one-purpose"><span class="chapter-nav__n">09</span><span>One purpose</span></a></li>
+          <li><a href="#system-prompt"><span class="chapter-nav__n">10</span><span>System prompt</span></a></li>
+          <li><a href="#primary"><span class="chapter-nav__n">11</span><span>Primary delegation</span></a></li>
+          <li><a href="#experts"><span class="chapter-nav__n">12</span><span>Agent experts</span></a></li>
+          <li><a href="#future"><span class="chapter-nav__n">13</span><span>Current practice &amp; future</span></a></li>
+          <li><a href="#lab"><span class="chapter-nav__n">14</span><span>Graded lab</span></a></li>
+          <li><a href="#mastery"><span class="chapter-nav__n">15</span><span>Cumulative mastery</span></a></li>
+          <li><a href="#glossary"><span class="chapter-nav__n">16</span><span>Glossary</span></a></li>
+        </ol>
+      </nav>
+    </aside>
+
+    <main class="chapter-main" id="main-content">
+      <header class="hero hero--context">
+        <span class="hero__chapter">Agentic Horizon · Lesson 1 · The R&amp;D framework</span>
+        <h1>Elite Context Engineering</h1>
+        <p class="hero__dek">Stop treating the context window as invisible plumbing. Measure what enters, remove what does not serve the job, and move independent work into focused agents.</p>
+        <ul class="hero__meta" aria-label="Chapter details">
+          <li>Video spine · 73:20</li>
+          <li>12 techniques · 4 levels</li>
+          <li>Core lab · 75–120 min</li>
+          <li>12 verified 1920×1080 frames</li>
+        </ul>
+        <p class="hero__promise"><strong>Mastery promise.</strong> By the end, you will be able to inspect a window before and after a change, sort all twelve techniques into Reduce and Delegate, distinguish sub-agent from primary-agent isolation, remount a prior session with a context bundle, and run the course’s plan/build/improve loop without hand-typing application code.</p>
+        <div class="hero-rd" aria-label="Reduce and Delegate framework">
+          <article class="hero-rd__lane">
+            <span class="hero-rd__letter">R</span><strong>Reduce</strong>
+            <p>Remove, defer, scope, or shorten context in the primary agent. You are protecting attention, not chasing the smallest bill.</p>
+          </article>
+          <article class="hero-rd__lane hero-rd__lane--delegate">
+            <span class="hero-rd__letter">D</span><strong>Delegate</strong>
+            <p>Move a coherent job into another context window, then return only the result the primary agent needs.</p>
+          </article>
+        </div>
+      </header>
+
+      <div class="mobile-toc">
+        <details>
+          <summary>Chapter contents</summary>
+          <ol>
+            <li><a href="#orientation">R&amp;D orientation</a></li><li><a href="#measure">Measure</a></li><li><a href="#mcp">MCP</a></li><li><a href="#prime">Prime</a></li><li><a href="#output">Output</a></li><li><a href="#subagents">Sub-agents</a></li><li><a href="#architect">Architect/editor</a></li><li><a href="#reset">Reset</a></li><li><a href="#bundles">Bundles</a></li><li><a href="#one-purpose">One purpose</a></li><li><a href="#system-prompt">System prompt</a></li><li><a href="#primary">Primary delegation</a></li><li><a href="#experts">Experts</a></li><li><a href="#future">Future</a></li><li><a href="#lab">Lab</a></li><li><a href="#mastery">Mastery</a></li><li><a href="#glossary">Glossary</a></li>
+          </ol>
+        </details>
+      </div>
+
+      <section class="chapter-section idea-cycle" id="orientation">
+        <span class="section-number">00</span>
+        <h2 class="section-title">A focused agent is a performant agent</h2>
+        <p class="section-lead">Context engineering begins when you stop asking only, “What information might help?” and begin asking, “What should this particular agent process on every next turn?”</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — the invisible third-full window</p>
+          <h3>A capable model can still be drowned before the first real prompt</h3>
+          <p>The recording opens a fresh Claude Code session and discovers that 63,000 of 200,000 tokens—31% of the available window—are already occupied. The user has not yet performed the difficult work. MCP tool definitions account for 24,100 tokens, and memory files account for 23,700. If you judge only the prompt you are about to type, you miss nearly the entire operating state that will answer it.</p>
+          <p>This is the chapter’s concrete failure: a model can be more capable than the work requires and still underperform because the window is carrying irrelevant tools, automatic memory, stale conversation, and verbose replies. The failure looks like “the model wandered.” The cause may be that the agent was never focused.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — two legal moves</p>
+          <h3>Everything you do to a window belongs in R or D</h3>
+          <div class="framework-map" aria-label="Reduce and Delegate explained">
+            <article><strong>Reduce from the primary window</strong><p>Measure first. Remove unused MCP definitions. Shrink always-on memory. Cap response prose. Reset and reload known context. Control what the agent reads.</p></article>
+            <article><strong>Delegate into another window</strong><p>Give scraping to sub-agents. Separate planning from building. Fire independent primary agents. Encode focused experts. Return concise reports across boundaries.</p></article>
+          </div>
+          <p>Reduction changes what one agent processes. Delegation changes which agent processes it. Several techniques do both: the architect/editor split delegates exploration to a planner so the builder’s window is reduced; one-agent-one-purpose uses decomposition to protect every window in the pipeline.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — Dan names the framework</p>
+          <h3>Reduce and Delegate becomes the chapter’s sorting rule</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t0176-rd-reduce-and-delegate.jpg" alt="Full-screen lesson title reading Reduce and Delegate" width="1920" height="1080" fetchpriority="high">
+            <figcaption><span class="frame-card__t">02:56</span>The title card gives you the first retrieval target: there are only two ways to manage the window—Reduce and Delegate.</figcaption>
+          </figure>
+          <p>The lesson repository makes that sentence executable. Its 301-line <code>README.md</code> labels twelve techniques by level and framework. Its <code>.claude/</code> directory contains the machinery: priming commands, output styles, sub-agent definitions, hook-built bundles, a background-agent launcher, and the plan/build/improve expert triad. The repository is not a neutral sample application. It is a context-engineering exhibit.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it — Dan’s vocabulary</p>
+          <h3>R&amp;D, context sweet spot, search and destroy</h3>
+          <aside class="callout callout--term">
+            <p class="callout__label">Central law</p>
+            <p><strong>A focused agent is a performant agent.</strong> The R&amp;D framework preserves focus by reducing context from the primary agent or delegating context to another agent.</p>
+          </aside>
+          <p>The <strong>context sweet spot</strong> is the useful range in which the agent has enough information for the task without being diluted by unrelated material. <strong>Search and destroy</strong> means finding the right context agentically, then removing or delegating everything else. <strong>Context bloat</strong> is excess material; <strong>context rot</strong> is material that has become stale, irrelevant, or contradictory. The vocabulary is operational: each term tells you what to inspect or change.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — classify the twelve techniques</p>
+          <h3>Four levels, one framework</h3>
+          <div class="level-map" aria-label="Twelve context techniques across four levels">
+            <article class="level-map__level" style="--level-color:var(--level-beginner)"><b>Level 1</b><strong>Beginner</strong><ol><li>Measure to manage</li><li>Avoid idle MCP</li><li>Prime, don’t default</li></ol></article>
+            <article class="level-map__level" style="--level-color:var(--level-intermediate)"><b>Level 2</b><strong>Intermediate</strong><ol><li>Control output tokens</li><li>Use sub-agents properly</li><li>Architect / editor</li></ol></article>
+            <article class="level-map__level" style="--level-color:var(--level-advanced)"><b>Level 3</b><strong>Advanced</strong><ol><li>Reset and prime</li><li>Use context bundles</li><li>One agent, one purpose</li></ol></article>
+            <article class="level-map__level" style="--level-color:var(--level-agentic)"><b>Level 4</b><strong>Agentic</strong><ol><li>Modify system prompt</li><li>Primary delegation</li><li>Agent experts</li></ol></article>
+          </div>
+          <p>Technique 1 is the foundation: you cannot prove either R or D worked without measuring. Techniques 2, 3, 4, 7, 8, and 10 are principally Reduce. Techniques 5 and 11 are principally Delegate. Techniques 6, 9, and 12 use both. The categories are not badges; they are a debugging question. If the primary agent is unfocused, will you remove context or move a coherent responsibility elsewhere?</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — ninety-second window audit</p>
+          <h3>Adopt the agent’s perspective before touching a setting</h3>
+          <ol>
+            <li>Write the single purpose of your current agent in one sentence.</li>
+            <li>List what it has already seen: memory, prompts, files, tool definitions, outputs.</li>
+            <li>Mark each item <strong>needed now</strong>, <strong>possibly later</strong>, or <strong>belongs to another job</strong>.</li>
+            <li>Circle one Reduce move and one Delegate move. Do not perform either until Technique 1 gives you a baseline.</li>
+          </ol>
+          <p>The exercise passes only if you reason from the agent’s next turn. “I like having all tools available” is the human’s convenience. “This agent needs one scraper for this task” is the agent’s context requirement.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: treating context engineering as a bigger prompt</h3>
+          <p><strong>Symptom:</strong> every difficulty is answered by adding instructions and files. The prompt becomes more explicit, but the surrounding state remains invisible and keeps growing.</p>
+          <p><strong>Fix:</strong> separate prompt quality from window quality. A bad prompt can waste a perfect window; a bloated window can dilute a good prompt. Inspect both. Use the R&amp;D question at each boundary: can the primary agent avoid processing this, or should a different focused agent own it?</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — durable principle</p>
+          <h3>Window sizes and model names move; attention remains the constraint</h3>
+          <aside class="current-practice">
+            <p class="current-practice__label">Current practice · extract verified mid-2026</p>
+            <p>The course’s model IDs and numeric breakdowns are period evidence. The extract’s current-practice review keeps the framework model-agnostic: larger windows help, but effective use of attention remains the frontier. Grade the direction and proportion of a context change, not whether your machine reproduces 63k, 24.1k, or 23.7k exactly.</p>
+          </aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval — close the section first</p>
+          <section class="retrieval-quiz" aria-label="R and D framework retrieval">
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What are the only two ways to manage a context window?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Reduce context from the primary agent and Delegate coherent work/context to another focused agent.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What is the one-line law behind all twelve techniques?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>A focused agent is a performant agent.</p></details></div>
+            <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why is “add everything that might help” not context engineering?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It does not manage attention. It ignores relevance, timing, contradiction, and which agent should own the work.</p></details></div>
+          </section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p><strong>Teach this in sixty seconds:</strong> define R&amp;D, give one pure Reduce example, one pure Delegate example, and one technique that does both. Finish with why a larger window does not remove the need for focus.</p><p class="fine">Pass if your listener can use the framework to decide what to do with one irrelevant file or one independent research task.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="mcp">
+        <span class="section-number">02</span>
+        <h2 class="section-title">Technique 2 · Avoid MCP servers you do not need</h2>
+        <p class="section-lead">A tool you might call later can charge rent on every prompt now. Load the smallest server surface that serves this agent’s actual purpose.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 02</span><span class="level-chip">Beginner</span><span class="framework-chip framework-chip--reduce">Reduce</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — the unused-tool tax</p>
+          <h3>The most expensive context may be a capability you never invoke</h3>
+          <p>The recorded fresh session pays 24,100 tokens for MCP tool definitions. The agent has not yet used those tools. Their schemas are present so the model can decide whether and how to call them, which means “available just in case” is not free. The course’s rough scaling example makes the waste visible: about 24k unused tokens across five agents in an hour is roughly 120k tokens—more than half of the recorded 200k window and approximately a quarter of five windows’ combined capacity.</p>
+          <p>The lesson is not “MCP is bad.” The lesson is temporal scope. A server is valuable in the session that needs it and bloat in the session that does not. The default should therefore be no server, followed by deliberate loading of the specific configuration required for the job.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — scope before startup</p>
+          <h3>Project defaults, global defaults, and one strict instance</h3>
+          <div class="practice-grid" aria-label="MCP loading choices">
+            <article><strong>Broad default</strong><p>A project <code>.mcp.json</code> or user/local server is automatically available. Every new agent may inherit definitions whether the task uses them or not.</p></article>
+            <article><strong>Task-scoped instance</strong><p>Start with <code>--mcp-config .mcp.json.firecrawl_7k.sample --strict-mcp-config</code>. Only that file’s servers are available to this instance; global servers are overridden.</p></article>
+          </div>
+          <p>The shipped repository makes costs legible in filenames: <code>.mcp.json.firecrawl_7k.sample</code> is the single-server option; <code>.mcp.json.all_16k.sample</code> mounts Playwright and Firecrawl; <code>.mcp.json.sample</code> is also a two-server project example. The suffix is a planning hint, not a promise that every future tool version will tokenize identically.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — one server, visible reduction</p>
+          <h3>The MCP line falls from 24.1k to 6.5k</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t0505-mcp-strict-config-tree.jpg" alt="Course repository tree beside a context readout where MCP tools have dropped to 6.5k tokens" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">08:25</span>After a Firecrawl-only strict configuration, the recorded MCP category drops to 6.5k (3.2%) and total context to 45k/200k. The file tree uses on-camera sample names that differ from the shipped repository.</figcaption>
+          </figure>
+          <p>This is a clean Reduce experiment because the category targeted by the configuration is the category that falls. The agent keeps a tool relevant to documentation fetching and discards unrelated schemas. Capability is not removed from the entire system; it is removed from this one agent’s startup state until needed.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Load exactly what you need</h3>
+          <aside class="callout callout--term"><p class="callout__label">Dan’s rule</p><p><strong>Do not load MCP servers unless you need them.</strong> Use <code>--mcp-config &lt;file&gt;</code> to choose a server set and <code>--strict-mcp-config</code> to override global servers for that Claude Code instance.</p></aside>
+          <p>“Avoid” means avoid idle definitions, not avoid tool use. A focused agent with the one required server is more capable for its actual purpose than an agent spending attention on every possible tool. This is search and destroy applied before the session begins.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — choose from shipped files</p>
+          <h3>Match the configuration to the job</h3>
+          <table>
+            <thead><tr><th>Course file</th><th>Servers in shipped file</th><th>Use when</th><th>Do not infer</th></tr></thead>
+            <tbody>
+              <tr><td><code>.mcp.json.firecrawl_7k.sample</code></td><td>Firecrawl only</td><td>The agent must scrape documentation</td><td>That the exact count is permanently 7k</td></tr>
+              <tr><td><code>.mcp.json.all_16k.sample</code></td><td>Playwright + Firecrawl</td><td>The same agent genuinely needs both surfaces</td><td>That “all” is a sensible default</td></tr>
+              <tr><td><code>.mcp.json.sample</code></td><td>Playwright + Firecrawl</td><td>Reference for a project config</td><td>That it should be renamed to active <code>.mcp.json</code></td></tr>
+              <tr><td>No MCP config</td><td>None from this project</td><td>The task needs only built-in tools</td><td>That global servers are absent unless strict mode verifies it</td></tr>
+            </tbody>
+          </table>
+          <pre><code>claude \
+  --mcp-config .mcp.json.firecrawl_7k.sample \
+  --strict-mcp-config</code></pre>
+          <p>Run <code>/context</code> immediately after startup and compare the MCP category with your baseline. The proof is the category delta plus confirmation that the required server still appears.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — remove “just in case”</p>
+          <h3>Perform one controlled MCP reduction</h3>
+          <ol><li>Record your current MCP token count.</li><li>Exit the session. Relaunch with the shipped Firecrawl-only sample and <code>--strict-mcp-config</code>.</li><li>Run <code>/context</code> again and record MCP tokens, total, and free space.</li><li>Write one sentence explaining what strict mode prevented from leaking into the comparison.</li></ol>
+          <p>The drill is complete when you can cite the before and after and still identify the one server you intentionally retained.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: renaming a broad sample into the default project config</h3>
+          <p><strong>Symptom:</strong> every project session loads two servers because the file is convenient, while only the documentation task uses Firecrawl and no current task uses browser automation.</p>
+          <p><strong>Fix:</strong> keep the samples self-describing, invoke the narrow one explicitly, and use strict mode when global configuration would contaminate the experiment. If a later task needs a different server set, launch a different focused agent.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — screen versus shipped tree</p>
+          <h3>Teach from disk; use the frame as historical evidence</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · repository note</p><p>The video tree shows <code>.mcp.json.firecrawl_4k</code>, <code>.mcp.json.all_22k</code>, and an empty variant. The shipped repository contains <code>.mcp.json.firecrawl_7k.sample</code>, <code>.mcp.json.all_16k.sample</code>, and <code>.mcp.json.sample</code>. Use the shipped names in the lab and treat the on-screen counts as record-time detail.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What two flags create a task-scoped MCP instance?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>--mcp-config &lt;file&gt;</code> chooses the configuration; <code>--strict-mcp-config</code> overrides global servers for that instance.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why is an unused MCP server a context problem before it is ever called?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Its tool definitions are loaded so the model can reason about them, consuming the window on every prompt.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Teach the difference between “MCP is bad” and “idle MCP is bloat.” Use the Firecrawl-only command, the recorded 24.1k → 6.5k result, and the shipped/on-screen filename difference.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="prime">
+        <span class="section-number">03</span>
+        <h2 class="section-title">Technique 3 · More prime, less CLAUDE.md</h2>
+        <p class="section-lead">The same automatic memory file is powerful because it is always loaded and dangerous because it is always loaded. Keep only true universals; pull task context on demand.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 03</span><span class="level-chip">Beginner</span><span class="framework-chip framework-chip--reduce">Reduce</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — convenience becomes contradiction</p>
+          <h3>A memory file grows by addition but rarely by subtraction</h3>
+          <p>A team learns one convention and appends it. A framework changes and the old convention remains. A subsystem needs a special instruction and the root file absorbs it. Eventually every agent pays for thousands of lines, even when the current task touches none of them. Worse, irrelevant context can become contradictory context and actively steer the model away from the code in front of it.</p>
+          <p>The course exaggerates the pattern deliberately. <code>CLAUDE.large.md</code> is 2,978 lines and labels itself an anti-pattern of over-contextualization. The recorded session reports 23.7k memory tokens and warns that the 79.7k-character file exceeds the 40k warning threshold. The failure is not hidden.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — always-on versus task-scoped</p>
+          <h3>Keep universals in memory; move changing context into commands</h3>
+          <div class="before-after">
+            <article class="before-after__card"><b>23.7k</b><p><code>CLAUDE.large.md</code> · 2,978 lines · automatically loaded · recorded 11.8% of the window.</p></article>
+            <div class="before-after__arrow" aria-hidden="true">→</div>
+            <article class="before-after__card before-after__card--after"><b>358</b><p>Concise 43-line memory · recorded 0.2% · then <code>/prime</code> loads the task-specific codebase view.</p></article>
+          </div>
+          <p>The split is semantic, not just quantitative. <code>CLAUDE.md</code> holds rules asserted as universal: use Bun over npm/yarn, use uv over pip/Poetry, key commands, broad project structure, and development guidelines. <code>/prime</code> performs an observation at session time: run <code>git ls-files</code>, read <code>README.md</code>, summarize the codebase.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — 92% free after the swap</p>
+          <h3>The warning becomes a controlled before/after</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t0786-context-after-prime.jpg" alt="Concise CLAUDE.md beside context readout showing memory files at 358 tokens and 92.4 percent free" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">13:06</span>With the concise 43-line file restored, recorded memory drops to 358 tokens (0.2%), total context to 15k/200k, and free space rises to 92.4%.</figcaption>
+          </figure>
+          <p>The key move happens after the reduction: priming puts back the context the job actually requires. <code>/prime_cc</code> demonstrates composability. It first executes the base <code>prime.md</code>, then reads <code>.claude/commands/**</code>, <code>.claude/output-styles/**</code>, <code>context_bundle_builder.py</code>, and <code>settings.json</code>. The agent that works on the agentic layer receives more context than a general codebase session—but only because its purpose demands it.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Prime, don’t default</h3>
+          <aside class="callout callout--term"><p class="callout__label">The paradox</p><p><strong>CLAUDE.md is incredible and terrible for the same reason: it is always loaded.</strong> Reserve it for context required 100% of the time. Use context priming for task-specific state.</p></aside>
+          <p>A prime is a reusable, inspectable loading procedure. It can be stacked, compared, and replaced. That turns context setup from a pile of inherited prose into a named operation. The course mentions possible task primes such as <code>/prime_bug</code>, <code>/prime_feature</code>, and <code>/prime_testing</code>; only <code>/prime</code> and <code>/prime_cc</code> ship here, so the others belong in stretch work, not claims about existing files.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — read the two shipped primes</p>
+          <h3>A base observation and a stacked specialization</h3>
+          <div class="practice-grid">
+            <article><strong><code>.claude/commands/prime.md</code></strong><p><em>Run:</em> <code>git ls-files</code>. <em>Read:</em> <code>README.md</code>. <em>Report:</em> summarize the codebase. Eighteen lines create a general starting state.</p></article>
+            <article><strong><code>.claude/commands/prime_cc.md</code></strong><p>Execute the base prime, then read the commands, output styles, bundle hook, and settings. Twenty-one lines define the agentic-layer specialization.</p></article>
+          </div>
+          <pre><code># Prime
+
+## Run
+git ls-files
+
+## Read
+README.md
+
+## Report
+Summarize your understanding of the codebase.</code></pre>
+          <p>The worked example shows why priming is not “tell the model everything.” It is an explicit recipe that another human can review and a student can measure. If the summary needs a file the prime omitted, change the prime for that task class; do not smuggle every possible file into root memory.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — classify each line</p>
+          <h3>Does it belong always, or only for this job?</h3>
+          <ol><li>Read the 43-line <code>CLAUDE.md</code>.</li><li>For each section, write <strong>universal</strong> or <strong>task-scoped</strong>. Do not edit during the core lab.</li><li>Read <code>prime.md</code> and <code>prime_cc.md</code>. Predict which files each loads.</li><li>Run <code>/prime</code>, then measure. In a fresh session run <code>/prime_cc</code>, then measure. Explain the difference by purpose.</li></ol>
+          <p>The drill passes when you can justify why a larger measured window can be healthier if the extra context is deliberately aligned with the agent’s job.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: shrinking memory, then forgetting to restore the task model</h3>
+          <p><strong>Symptom:</strong> memory usage falls dramatically, but the agent repeatedly rediscovers the repository or edits without reading the operating layer.</p>
+          <p><strong>Fix:</strong> couple reduction with an explicit prime. The objective is known context, not empty context. Keep universals automatic; make task observations named and repeatable; measure the resulting state.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — more packages, same boundary</p>
+          <h3>Always-on memory is still not a substitute for task setup</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Skills, plugins, and settings layering broaden the customization surface, but the durable decision remains: what must every session know versus what should load only when a matching task begins? Keep the course’s tiny-memory-plus-prime contrast because it exposes that boundary without magic.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why is CLAUDE.md incredible and terrible for the same reason?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It is always loaded: ideal for true universals, costly and risky when it accumulates irrelevant or contradictory context.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What does <code>/prime_cc</code> add to the base prime?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It reads the Claude Code layer: commands, output styles, the context-bundle hook, and settings.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Explain the 23.7k → 358-token contrast, then defend one line that belongs in always-on memory and one observation that belongs in a prime. Finish with why “less memory” without priming is incomplete.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="measure">
+        <span class="section-number">01</span>
+        <h2 class="section-title">Technique 1 · Measure to manage</h2>
+        <p class="section-lead">A context change without a before and after is a story. This technique turns every later technique into an observable intervention.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 01</span><span class="level-chip">Beginner</span><span class="framework-chip framework-chip--both">Foundation for R&amp;D</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — optimize the thing you can see</p>
+          <h3>The agent is already processing more than your prompt</h3>
+          <p>You type six words and receive a wandering answer. If your only measurement is the six words, your diagnosis starts in the wrong place. Claude Code’s <code>/context</code> view exposes system prompt, system tools, MCP tools, custom agents, memory files, messages, and free space. A tokenizer in the editor answers the complementary question: what will this file cost before the agent reads it?</p>
+          <p>The two tools look in opposite directions. <code>/context</code> audits the loaded state. The file token counter estimates an incoming payload. You need both because a healthy boot can still be ruined by reading a giant file, and a small target file can still enter an already unhealthy boot.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — read the composition, not only the total</p>
+          <h3>31% occupied is a clue; the categories identify the levers</h3>
+          <div class="context-meter" aria-label="Recorded context composition on fresh boot">
+            <strong>Recorded fresh boot · 63k / 200k tokens</strong>
+            <div class="context-meter__bar" aria-hidden="true">
+              <span class="context-meter__slice" style="width:1.55%;--slice-color:var(--foundation)"></span>
+              <span class="context-meter__slice" style="width:5.85%;--slice-color:var(--level-beginner)"></span>
+              <span class="context-meter__slice" style="width:12.05%;--slice-color:var(--reduce)"></span>
+              <span class="context-meter__slice" style="width:.1%;--slice-color:var(--delegate)"></span>
+              <span class="context-meter__slice" style="width:11.85%;--slice-color:var(--warn)"></span>
+            </div>
+            <div class="context-meter__legend"><span style="--slice-color:var(--foundation)">System prompt · 3.1k</span><span style="--slice-color:var(--level-beginner)">System tools · 11.7k</span><span style="--slice-color:var(--reduce)">MCP tools · 24.1k</span><span style="--slice-color:var(--delegate)">Custom agents · 122</span><span style="--slice-color:var(--warn)">Memory files · 23.7k</span></div>
+          </div>
+          <p>The percentages matter because the next action should target the dominant controllable categories. MCP and memory are not abstract complaints in this baseline; together they account for almost 48,000 tokens. The tiny custom-agent line is a clue Technique 5 will exploit.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — the whole before-state in one frame</p>
+          <h3>Dan measures before prescribing</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t0266-context-measure-before.jpg" alt="Claude Code context readout showing 63k of 200k tokens used, including large MCP and memory categories" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">04:26</span>The recorded baseline shows 63k/200k used, MCP at 24.1k, memory at 23.7k, a large-CLAUDE.md warning, and the README token counter at 2,650. Treat the numbers as period detail and the breakdown habit as the lesson.</figcaption>
+          </figure>
+          <p>Notice the sequence. Dan does not begin by deleting a config because “MCP feels heavy.” He exposes the cost, names the category, and preserves a frame that later techniques can compare against. That makes improvement falsifiable. If MCP shrinks but total context does not, another category may have grown. If memory shrinks but the next task performs worse, the prime may have omitted necessary context.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Measure to manage</h3>
+          <aside class="callout callout--term"><p class="callout__label">Dan’s term</p><p><strong>“What gets measured gets managed.”</strong> <code>/context</code> shows what is already in the window; a token counter estimates what a file will add before it enters.</p></aside>
+          <p>This is not a request to minimize every number. A complete plan may be worth thousands of tokens if it prevents three failed implementations. Measurement supports allocation. The engineering question is whether each occupied region earns its place for this agent’s purpose.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — build a context ledger</p>
+          <h3>Record categories before changing any configuration</h3>
+          <table>
+            <thead><tr><th>Measure</th><th>Recorded demo</th><th>What it can reveal</th><th>Likely next technique</th></tr></thead>
+            <tbody>
+              <tr><td>Total / free</td><td>63k used · 137.3k free</td><td>Overall pressure and available runway</td><td>Choose after inspecting categories</td></tr>
+              <tr><td>MCP tools</td><td>24.1k</td><td>Always-loaded server definitions</td><td>T2 · scope MCP</td></tr>
+              <tr><td>Memory files</td><td>23.7k</td><td>Automatic project instructions</td><td>T3 · shrink and prime</td></tr>
+              <tr><td>Custom agents</td><td>122</td><td>Small primary-window definitions</td><td>T5 · delegate isolated work</td></tr>
+              <tr><td><code>README.md</code></td><td>~2,650 before read</td><td>Incoming high-touch file cost</td><td>Decide whether this prime needs it</td></tr>
+            </tbody>
+          </table>
+          <p>Your own ledger will differ. Preserve the units that <code>/context</code> reports, the timestamp or checkpoint, and what you changed next. The lab grades the direction and your explanation, not a forced reproduction of Dan’s machine.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — baseline checkpoint</p>
+          <h3>Write the numbers before learning the cure</h3>
+          <ol><li>From the course codebase, boot <code>claude</code> and run <code>/context</code>.</li><li>Record total percentage, System tools, MCP tools, Custom agents, Memory files, and Free space.</li><li>Open <code>README.md</code> and record the IDE token estimate before asking the agent to read it.</li><li>Predict the two largest controllable consumers. Do not change them yet.</li></ol>
+          <p>Checkpoint 0 passes when you can explain every recorded line. A screenshot without interpretation is not measurement literacy.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: measuring once, then trusting memory</h3>
+          <p><strong>Symptom:</strong> you run <code>/context</code> at boot, make three changes, and remember only that the bar “looked better.” Or you compare your count to the video and treat a mismatch as failure.</p>
+          <p><strong>Fix:</strong> pair every meaningful R or D move with before/after evidence. Annotate what changed between samples. Compare your machine to itself. Models, tool schemas, global configuration, and repository state shift the absolute numbers.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — grade the delta</p>
+          <h3>Period numbers are calibration examples, not targets</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>The recording displays course-era model IDs and a specific 200k breakdown. Current model and tool surfaces change token accounting. Keep the two-instrument habit, cite your own baseline, and evaluate whether a scoped change moved the expected category in the expected direction.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What does <code>/context</code> tell you that a file token counter does not?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The exact category breakdown already loaded into the agent’s window.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What does the file counter tell you that <code>/context</code> does not?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The estimated cost of a file before you add it to the window.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Explain the recorded 31% boot state to a colleague without saying merely “too many tokens.” Name the two dominant categories, the two measurement tools, and why only a before/after on the same machine proves an intervention.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="output">
+        <span class="section-number">04</span>
+        <h2 class="section-title">Technique 4 · Control output tokens</h2>
+        <p class="section-lead">The agent’s status prose is not outside the window. It is expensive output now and input on the next turn. Control the response layer without starving questions, errors, or requested evidence.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 04</span><span class="level-chip">Intermediate</span><span class="framework-chip framework-chip--reduce">Reduce</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — the compounding reply</p>
+          <h3>The file is done; the agent writes another paragraph about doing it</h3>
+          <p>Suppose a workflow edits the right files and verifies the result. The useful artifact already exists. A default assistant may still narrate the plan, repeat the changes, restate the tests, offer next steps, and invite a follow-up. That reply consumes output tokens and then becomes conversation context. Repeat the pattern across hundreds of prompts and agents and a tiny social convention becomes a recurring window tax.</p>
+          <p>Dan frames the economics sharply: output tokens cost roughly three to five times input tokens in the lesson, and they return to context. You cannot remove the tokens required to write the repository files. You can remove redundant chat about work whose evidence is already available elsewhere.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — the response is a configurable layer</p>
+          <h3>Same tool work, different report budget</h3>
+          <div class="before-after">
+            <article class="before-after__card"><b>~150</b><p>Recorded default-style completion response: explanation and status prose re-enter the conversation.</p></article>
+            <div class="before-after__arrow" aria-hidden="true">→</div>
+            <article class="before-after__card before-after__card--after"><b>2</b><p>Recorded one-word response: <code>Done.</code> Roughly a 99% response reduction in the demonstration.</p></article>
+          </div>
+          <p>An output style hot-swaps the output-style block in Claude Code’s system prompt. The course ships five specimens: <code>concise-done.md</code>, <code>concise-ultra.md</code>, <code>concise-tts.md</code>, <code>verbose-bullet-points.md</code>, and <code>verbose-yaml-structured.md</code>. The point is not that the shortest always wins. The point is that response shape is an explicit engineering choice.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — “hi” becomes “Done.”</p>
+          <h3>The menu and the effect share one frame</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t1085-output-styles-done.jpg" alt="Claude Code terminal answering Done beside the output style selection menu" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">18:05</span>Left: <code>hi</code> receives <code>Done.</code> Right: the output-style menu offers Default, Explanatory, Learning, Ultra Concise, One Word Output, TTS Summary, Bullet Points, and YAML Structured.</figcaption>
+          </figure>
+          <p>The shipped local settings file selects <code>"outputStyle": "One Word Output"</code>. Its definition says respond only “Done.” 95 of 100 times, but it preserves three exceptions: an explicit request for a different response, a direct question, and an error or blocker. That distinction matters. Minimalism is useful only if it does not erase the information required for the next decision.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Output styles and response budgets</h3>
+          <aside class="callout callout--term"><p class="callout__label">Durable idea</p><p><strong>Control the response layer.</strong> An output style changes how the agent reports; it does not prevent the agent from spending tokens to reason, use tools, or write files.</p></aside>
+          <p>Think in report contracts. A background worker may need a structured progress file. A human asking a question needs the answer. A completed mechanical step may need only “Done.” A debugging agent may need the exact error. The useful budget follows the consumer of the output.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — inspect the exception design</p>
+          <h3>Short by default, informative when state changes</h3>
+          <div class="practice-grid">
+            <article><strong>Routine success</strong><p><code>Done.</code> The repository diff and test output are the evidence; more narration is redundant.</p></article>
+            <article><strong>Question or blocker</strong><p>One or two concise sentences answer the question or identify the error. Hiding a blocker would break the workflow.</p></article>
+          </div>
+          <pre><code>{
+  "enableAllProjectMcpServers": true,
+  "enabledMcpjsonServers": ["firecrawl-mcp"],
+  "outputStyle": "One Word Output"
+}</code></pre>
+          <p>The settings specimen intentionally contains both an output choice and MCP choices. Measure the response delta separately from MCP state so one comparison does not claim credit for both. The lab uses identical prompts in two terminals to isolate the response style.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — same prompt, two styles</p>
+          <h3>Hold the task constant</h3>
+          <ol><li>Open two course-repository terminals.</li><li>Use the One Word Output style in one and leave the other at default.</li><li>Send <code>hi</code> to both, then ask, “What does this codebase do?”</li><li>Record the response-token difference and whether the concise style still answers the explicit question.</li></ol>
+          <p>The experiment passes when you can explain why “Done.” is correct for routine completion but wrong as the answer to a requested explanation.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: optimizing away the evidence channel</h3>
+          <p><strong>Symptom:</strong> every response becomes “Done.”, including failed commands, ambiguous questions, and checkpoints that require numbers. The window is smaller but the system is no longer observable.</p>
+          <p><strong>Fix:</strong> write explicit exceptions and make persistent artifacts carry detailed evidence. Short chat is safe when diffs, reports, test output, or checkpoint notes preserve what another actor needs.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — a broader customization surface</p>
+          <h3>The mechanism sits beside newer packages; the economics stay</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Output styles remain one customization surface among settings layering, plugins, and Skills. The course’s hot-swap demonstration still teaches the durable point: response behavior is controllable, output is costly, and verbose completion prose should justify its place.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why can output tokens create a compound context cost?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>They are costly to generate and their text returns as input context on later turns.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What three cases override “Done.” in the shipped style?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>An explicit request for another response, a direct question, and an error or blocker.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Explain why a one-word output style changes the report layer rather than the work layer. Include the recorded ~150 → 2-token effect and one case where a longer response is necessary.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="subagents">
+        <span class="section-number">05</span>
+        <h2 class="section-title">Technique 5 · Use sub-agents properly</h2>
+        <p class="section-lead">A sub-agent is a partially forked context window. Its value is not “more AI”; it is keeping a large isolated job and its intermediate context away from the primary agent.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 05</span><span class="level-chip">Intermediate</span><span class="framework-chip framework-chip--delegate">Delegate</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — ten scrapes, one concise report</p>
+          <h3>Do the expensive work without pouring its trail into the main window</h3>
+          <p>Documentation scraping is a perfect delegation candidate. Each URL can be fetched independently. The raw page, fallback logic, extraction decisions, and file-writing trace are useful to the scraper but mostly irrelevant to the primary agent. If the primary agent performs every scrape itself, all that context competes with the engineering task that requested the docs.</p>
+          <p>The course’s <code>/load_ai_docs</code> command delegates one URL per docs-scraper sub-agent in parallel. Each sub-agent spends its own window, writes clean Markdown into <code>ai_docs/</code>, and returns a compact success/failure line to the primary agent. The main window retains the result map, not every scrape’s internal history.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — follow the information arrows</p>
+          <h3>User → primary → sub-agent → primary</h3>
+          <div class="agent-flow" aria-label="Sub-agent information flow">
+            <article class="agent-flow__step" style="--flow-color:var(--foundation)"><b>User</b><code>/load_ai_docs</code><p>Requests a documentation refresh.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--accent)"><b>Primary agent</b><code>Task × URLs</code><p>Reads the URL list, applies the age rule, and dispatches independent prompts.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--delegate)"><b>Docs scrapers</b><code>own windows</code><p>Fetch, clean, and write files in parallel.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--ok)"><b>Primary report</b><code>✅ / ❌ + path</code><p>Receives reduced outcomes and reports to the user.</p></article>
+          </div>
+          <p>Sub-agents report to the primary agent, not directly to the human. That sentence prevents a common mental-model error. The primary agent decides how the returned summaries participate in the larger task.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — custom agents cost 122 tokens</p>
+          <h3>A small definition opens a separate working window</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t1492-subagent-docs-scrapers.jpg" alt="Load AI docs command above a terminal launching docs scraper sub-agents" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">24:52</span>The command finds ten URLs/files, removes stale documentation after the 24-hour rule, and launches docs-scraper agents. The recorded primary <code>/context</code> shows Custom agents at only 122 tokens.</figcaption>
+          </figure>
+          <p>Dan describes the sub-agent definition as a system prompt isolated from the primary conversation, which is why the recorded custom-agent category is tiny while a scraper may spend thousands of tokens. The delegation still has a return cost: the sub-agent’s report enters the primary agent. Proper use therefore requires a narrow task and a narrow report.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Partially forked context window</h3>
+          <aside class="callout callout--term"><p class="callout__label">Dan’s model</p><p>A sub-agent is a <strong>partially forked context window</strong>. Its system-prompt definition stays isolated, it performs work in its own window, and it returns a result to the primary agent.</p></aside>
+          <p>“Partial” distinguishes this from Technique 11’s fully independent primary agents. A sub-agent is part of the primary agent’s orchestration surface. A background primary instance owns its own model, settings, keys, and file-based report channel.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — trace <code>/load_ai_docs</code></p>
+          <h3>The command encodes a delegation contract</h3>
+          <ol>
+            <li>Read <code>ai_docs/README.md</code> for source URLs.</li>
+            <li>Check existing Markdown files against <code>DELETE_OLD_AI_DOCS_AFTER_HOURS: 24</code>.</li>
+            <li>Skip fresh files; delete stale files.</li>
+            <li>For each remaining URL, invoke the Task tool in parallel with the exact docs-scraper prompt.</li>
+            <li>Return <code>✅</code> or <code>❌</code>, the URL, and the Markdown path.</li>
+          </ol>
+          <p>The allowed tool surface makes the design inspectable: Task, WebFetch, Write, Edit, a narrow <code>Bash(ls*)</code>, and the Firecrawl scrape tool. The primary command does not ask every sub-agent for a tutorial about scraping. It asks for a file and a status line.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — track who knows what</p>
+          <h3>Run the delegation, then audit the primary window</h3>
+          <ol><li>Record Custom agents and total context before the command.</li><li>Run <code>/load_ai_docs</code> in the course repository.</li><li>Identify which files were skipped, deleted, and written.</li><li>Run <code>/context</code> afterward and explain why scrape work did not appear as a giant primary conversation trace.</li></ol>
+          <p>The checkpoint passes when you can draw the four arrows—user, primary, sub-agent, primary—and identify the file artifact and return report at the boundary.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: adding agents before you can trace one</h3>
+          <p><strong>Symptom:</strong> you cannot say who generated a prompt, which window read a page, or where the result returned. Sub-agents repeat work, return essays, or receive the entire primary transcript.</p>
+          <p><strong>Fix:</strong> delegate tasks that can operate in isolation, pass the minimum input, and specify a reduced report. If you are losing track of a single agent’s context, master measurement before increasing the topology.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — principle before fleet</p>
+          <h3>More orchestration surfaces do not change the boundary test</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Sub-agents and primary-agent delegation remain standard building blocks in the extract’s current-practice review. Newer packaging can make agents easier to discover, but good delegation still asks: is the job isolated, is the input minimal, and is the return concise?</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why did custom agents occupy only about 122 tokens in the recorded primary window?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The definitions are isolated system prompts; the sub-agents spend their own windows and return reduced results.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Who receives a sub-agent’s report?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The primary agent, which uses or reports the result to the user.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Using <code>/load_ai_docs</code>, explain why delegation can increase total token spending while improving the primary agent’s focus. Distinguish the scrape file, the sub-agent’s working context, and the concise report.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="architect">
+        <span class="section-number">06</span>
+        <h2 class="section-title">Technique 6 · Architect / editor</h2>
+        <p class="section-lead">Let the planner spend context discovering the complete work, then let a fresh builder spend context only on the specification and implementation.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 06</span><span class="level-chip">Intermediate</span><span class="framework-chip framework-chip--both">Reduce via Delegate</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — the builder that never had to search</p>
+          <h3>Exploration and editing want opposite windows</h3>
+          <p>A planner should inspect broadly, compare approaches, notice edge cases, and discover which files matter. That is intentionally expansive work. A builder should make surgical edits from a settled contract. Combining the two in one conversation means the implementer carries every dead end, rejected option, and exploratory read into the moment that demands precision.</p>
+          <p>The architect/editor pattern treats those as different purposes. The planner is allowed to “waste” tokens finding the right context because its product is a concise specification. A fresh builder reads that product and the target files, not the entire search history.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — an information bottleneck on purpose</p>
+          <h3>Repository → planner → spec → builder → diff</h3>
+          <div class="agent-flow" aria-label="Architect editor information flow">
+            <article class="agent-flow__step" style="--flow-color:var(--foundation)"><b>Explore</b><code>Read · Glob · Grep</code><p>The planner gathers more than the builder should carry.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--accent)"><b>Specify</b><code>specs/name.md</code><p>Objectives, approach, steps, risks, tests, and success criteria.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--delegate)"><b>Build fresh</b><code>/build path</code><p>A separate agent reads the settled plan and implements.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--ok)"><b>Report</b><code>git diff --stat</code><p>The builder returns changed files and a concise summary.</p></article>
+          </div>
+          <p>The specification is a deliberate bottleneck. It compresses the useful result of exploration into an artifact another agent can consume. Unlike automatic conversation compaction, the plan has a visible schema and a single purpose.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — planner left, builder right</p>
+          <h3>The TypeScript wrapper crosses the boundary</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t1790-planner-builder-split.jpg" alt="Split-screen planner designing a three-file TypeScript wrapper and fresh builder invoking the build command" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">29:50</span>The planner identifies a types file, low-level SDK wrapper, and CLI. A fresh agent clears its state and runs <code>/build</code> from the written plan.</figcaption>
+          </figure>
+          <p>The shipped result lives in <code>apps/cc_ts_wrapper/</code>. <code>types.ts</code> defines settings, reusable prompt configuration, results, and defaults. <code>core.ts</code> wraps the SDK <code>query()</code> call through <code>adhoc_prompt()</code>, a registry, and <code>reusable_prompt()</code>. <code>cli.ts</code> exposes direct prompts plus built-in <code>/analyze</code> and <code>/refactor</code> commands. The three-file shape visible in the planner’s thought becomes a legible implementation boundary.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Architect / editor, planner / builder</h3>
+          <aside class="callout callout--term"><p class="callout__label">Dan’s instruction</p><p><strong>Go overboard planning, then delete.</strong> The planner over-gathers; the finished plan removes irrelevant exploration so the builder receives a focused window.</p></aside>
+          <p>The labels emphasize responsibility rather than hierarchy. The architect is not inherently smarter; it owns discovery and decisions. The editor is not a typist; it owns faithful implementation and evidence. The boundary makes failures easier to localize: incomplete contract or incorrect build.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — compare command contracts</p>
+          <h3><code>/quick-plan</code> is broad; <code>/build</code> is narrow</h3>
+          <table>
+            <thead><tr><th>Command</th><th>Inputs</th><th>Allowed / expected work</th><th>Output</th></tr></thead>
+            <tbody><tr><td><code>/quick-plan</code></td><td><code>USER_PROMPT</code></td><td>Read, Write, Edit, Glob, Grep; analyze architecture, challenges, tests, and success</td><td><code>specs/&lt;name&gt;.md</code></td></tr><tr><td><code>/build</code></td><td><code>PATH_TO_PLAN</code></td><td>Read the plan, think hard, implement it</td><td>Concise bullets + <code>git diff --stat</code></td></tr></tbody>
+          </table>
+          <p>The shipped <code>quick-plan.md</code> pins a course-era Opus model ID. The plan’s capability comes from its role and contract, not that exact identifier. If the pinned model is unavailable when adapting the course, update the frontmatter before the lab; do not pretend the old ID is current.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — fresh builder test</p>
+          <h3>Prove the plan carries the hand-off</h3>
+          <ol><li>Ask <code>/quick-plan</code> for a tiny helper in <code>apps/cc_ts_wrapper</code>.</li><li>Review the written spec for target files, behavior, tests, and success evidence.</li><li>Open a fresh agent. Do not prime the full repository.</li><li>Run <code>/build &lt;spec-path&gt;</code> and compare the diff to the plan.</li></ol>
+          <p>The checkpoint passes if the builder can act from the plan alone. If it must rediscover the whole codebase, repair the plan rather than stuffing the planner’s transcript into the builder.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: prompt-chaining in one window and calling it two roles</h3>
+          <p><strong>Symptom:</strong> the same agent explores, debates, plans, receives corrections, and implements. A “now build it” prompt changes the label but not the context state.</p>
+          <p><strong>Fix:</strong> materialize the plan, clear or open a fresh agent, and pass only the artifact. Keep the planner’s decision record where the builder can inspect it without inheriting every discarded path.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — model IDs drift, seams endure</p>
+          <h3>The two-agent seam is the lesson</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · course adaptation</p><p>The exact model frontmatter is period detail. Preserve the separation of responsibilities and the visible plan artifact. Current orchestration may automate the hand-off, but automation is safe only after the plan’s contract is good enough for a fresh builder.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Whose job is it to “waste” tokens, and why?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The planner’s. It explores broadly to create a complete, reduced specification for the builder.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What proves the builder’s window is truly fresh?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>A separate or cleared agent implements from the plan artifact without inheriting the planning conversation.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Walk a colleague through repository → planner → spec → builder → diff. Explain why the planner may spend more tokens so the builder can spend fewer and edit more precisely.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="reset">
+        <span class="section-number">07</span>
+        <h2 class="section-title">Technique 7 · Avoid <code>/compact</code>: reset and prime</h2>
+        <p class="section-lead">Dan’s stance is deliberately strict: when the work must run out of loop, a known fresh state is more valuable than a convenient compressed state you must rediscover.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 07</span><span class="level-chip">Advanced</span><span class="framework-chip framework-chip--reduce">Reduce</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — the unknown summary</p>
+          <h3>After compaction, what exactly survived?</h3>
+          <p>You reach a long session’s limit and invoke <code>/compact</code>. Work can continue, but your operating state is now a summary selected by the compaction process. Which file facts survived? Which decisions were compressed into a vague sentence? Which rejected path still sounds active? Dan points out that you must use transcript mode to inspect what remains. That means the agent’s state is decent perhaps, but not known until you look.</p>
+          <p>Unknown state is tolerable when a human stays present to catch drift. It becomes dangerous in an out-of-loop workflow where a long-running agent cannot ask you to reconstruct the past. The advanced habit is therefore to design work small enough that one agent does not overflow its window, and to use a deterministic reload when a new window is needed.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — certainty versus convenience</p>
+          <h3>Compaction keeps a summary; reset-and-prime rebuilds a recipe</h3>
+          <div class="agent-compare">
+            <article><strong><code>/compact</code></strong><p>Conversation is summarized. Continuity is convenient, but the retained set is not your explicit loading recipe. Inspecting it is another task.</p></article>
+            <article><strong><code>/clear</code> → <code>/prime</code></strong><p>The old window is removed. A named command reloads the repository observations selected for this purpose. You know the recipe.</p></article>
+          </div>
+          <p>The comparison is about ownership, not an assertion that compaction never works. Dan’s rule chooses a more expensive reset because predictable context is infrastructure for unattended execution.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — compaction after a completed build</p>
+          <h3>The moment to stop guessing</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t2050-avoid-compact.jpg" alt="Builder completion report followed by the Claude Code compacting conversation message" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">34:10</span>The TypeScript wrapper report is complete; <code>/compact</code> begins summarizing. Dan uses this moment to recommend reset and prime instead.</figcaption>
+          </figure>
+          <p>The previous technique created a natural hand-off point. Once the builder reports, the next job should not inherit planning exploration and implementation narration merely because they exist. A fresh agent can load the state appropriate to review, testing, or the next feature. One agent should not become a forever-process.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Reset and prime; own the window</h3>
+          <aside class="callout callout--term"><p class="callout__label">Dan’s stance</p><p><strong>Stop guessing and start knowing.</strong> Use <code>/clear</code> to remove the window, then <code>/prime</code> to reload the intended state. Do not delegate control of context to compaction.</p></aside>
+          <p>Ownership means being able to state the loading procedure. It does not mean every token is manually enumerated. System tools still exist; the model still reasons. You own the controllable inputs and can reproduce the prime after a reset.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — compare two recoveries</p>
+          <h3>Ask the same question after each path</h3>
+          <table><thead><tr><th>Recovery</th><th>What you can state before inspection</th><th>What can go wrong</th><th>Repair</th></tr></thead><tbody><tr><td><code>/compact</code></td><td>A summary was generated</td><td>Critical file detail or decision may be compressed</td><td>Read the summary and reintroduce omissions</td></tr><tr><td><code>/clear</code> + <code>/prime</code></td><td>The base prime ran, file list was observed, README was read</td><td>The prime itself may omit task-specific files</td><td>Use or improve the task-specific prime</td></tr></tbody></table>
+          <p>The second path does not make errors impossible. It makes the state specification reviewable. If a bug-fixing agent repeatedly misses tests because the prime ignores them, create the stretch <code>/prime_bug</code> and measure it. That is a correctable system defect.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — feel the epistemic difference</p>
+          <h3>Use both once, then write the contrast</h3>
+          <ol><li>After some course work, run <code>/compact</code>.</li><li>Use transcript mode to inspect the resulting summary. List two facts you had to verify.</li><li>Then run <code>/clear</code> and <code>/prime</code>.</li><li>Write one sentence explaining which state you can specify by recipe and why that matters out of loop.</li></ol>
+          <p>The exercise is not an endorsement of intentionally filling the window. It is a controlled comparison of the recovery mechanisms.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: turning an opinionated rule into a universal ban</h3>
+          <p><strong>Symptom:</strong> you claim compaction is broken in all situations, or repeatedly reset without a sufficient prime and call the resulting amnesia “control.”</p>
+          <p><strong>Fix:</strong> preserve the reasoned tradeoff. Compaction is convenient and can be legitimate. Dan prioritizes known state for advanced out-loop workflows. Reset only when a named prime can restore the context the next purpose needs.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — improved compaction, unchanged principle</p>
+          <h3>Custom summaries can narrow the gap, but ownership remains the test</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Compaction tooling has improved, including custom summarization instructions and automatic compaction. The course’s avoidance remains a stance, not a platform fact. Foreground the durable test: can you know and reproduce the state of an out-of-loop agent?</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why does Dan avoid <code>/compact</code>?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Because he cannot state exactly what was retained without inspecting the summary; advanced workflows need predictable state.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What is the two-command alternative?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>/clear</code>, then a purpose-appropriate <code>/prime</code>.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Present the strongest case for compaction, then explain why Dan still chooses reset-and-prime for out-of-loop work. A good answer treats certainty as the objective and a prime as a reproducible recipe.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="bundles">
+        <span class="section-number">08</span>
+        <h2 class="section-title">Technique 8 · Use context bundles</h2>
+        <p class="section-lead">When a fresh agent needs the story of a prior agent, replay the useful operations—not the entire transcript and not a blind summary.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 08</span><span class="level-chip">Advanced</span><span class="framework-chip framework-chip--reduce">Reduce through replay</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — remount after the window explodes</p>
+          <h3>Starting fresh should not mean starting ignorant</h3>
+          <p>Reset-and-prime gives you a known base, but long work creates task-specific state: which prompts were issued, which files were read, which files were written, and which slices mattered. Copying the entire conversation recreates bloat. Asking a summary to remember everything delegates selection to another opaque step. A context bundle records a narrow operational trail that a fresh agent can inspect and replay.</p>
+          <p>The course’s bundle is append-only JSONL. Each line is one prompt, read, or write event. The format matters: it can grow one operation at a time, survives partial work, and can be processed without loading a giant monolithic object.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — record, deduplicate, replay</p>
+          <h3>A hook captures the trail; a command selects the useful reads</h3>
+          <div class="bundle-log" aria-label="Example context bundle lines">
+            <div class="bundle-log__line"><span class="bundle-log__op">PROMPT</span><code>{"prompt":"/prime_cc"}</code></div>
+            <div class="bundle-log__line"><span class="bundle-log__op">READ</span><code>{"file_path":".claude/settings.json"}</code></div>
+            <div class="bundle-log__line"><span class="bundle-log__op">READ</span><code>{"file_path":"README.md","tool_input":{"limit":100}}</code></div>
+            <div class="bundle-log__line"><span class="bundle-log__op">WRITE</span><code>{"file_path":"specs/helper.md","tool_input":{"content_length":14003}}</code></div>
+          </div>
+          <p><code>context_bundle_builder.py</code> converts absolute paths inside the project to relative paths, keeps <code>limit</code> and <code>offset</code> for reads, records only content length for writes, and truncates logged user prompts to 500 characters. <code>/load_bundle</code> groups entries by file, chooses a full read if any event was full, otherwise chooses the most comprehensive slice, and reads each unique file once.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — the JSONL trail becomes visible</p>
+          <h3>The file list is the prior agent’s working map</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t2345-context-bundle-jsonl.jpg" alt="Context bundle JSON Lines file listing prompts and read operations beside a terminal replaying deduplicated reads" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">39:05</span>A bundle in <code>agents/context_bundles/</code> records <code>/prime_cc</code> and reads of settings, commands, hooks, README, and output styles. The terminal replays deduplicated file reads.</figcaption>
+          </figure>
+          <p>Dan describes the replay as getting roughly 70% of where the previous agent was; the extract also frames it as about 60–70%, not exact restoration. The missing portion is a feature as much as a limitation. Internal reasoning and every intermediate message do not flood the new window. The fresh agent receives the task trail and important files, then continues with a cleaner state.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Context bundle</h3>
+          <aside class="callout callout--term"><p class="callout__label">Definition</p><p>A <strong>context bundle</strong> is an append-only, per-session JSONL trail of selected prompts, reads, and writes, produced by a hook and remounted by <code>/load_bundle</code>.</p></aside>
+          <p>“Bundle” does not mean archive everything. This implementation explicitly ignores tools other than Read and Write in the file-operations handler. It records write length, not file content. It treats logged prompts as context to understand, never instructions to execute during replay.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — trace the wiring</p>
+          <h3>Two hook events feed one per-session file</h3>
+          <table><thead><tr><th>Event</th><th>Matcher / type</th><th>Recorded line</th><th>Purpose</th></tr></thead><tbody><tr><td><code>PostToolUse</code></td><td><code>Read|Write</code> · <code>--type file_ops</code></td><td>Operation, relative path, read slice or write length</td><td>Reconstruct file context</td></tr><tr><td><code>UserPromptSubmit</code></td><td><code>--type user_prompt</code></td><td>Prompt truncated to 500 characters</td><td>Understand the requested story</td></tr></tbody></table>
+          <p>The filename is <code>agents/context_bundles/&lt;DAY_HOUR&gt;_&lt;session_id&gt;.jsonl</code>. The hook uses <code>CLAUDE_PROJECT_DIR</code> when available, creates parent directories, and appends one JSON object per line. The settings file runs a separate universal logger across a broader event set; do not confuse its hook logs with the context bundle used for replay.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — remount a real session</p>
+          <h3>Inspect first, replay second</h3>
+          <ol><li>Run <code>/prime</code> and perform a few reads in the course repository.</li><li>Open the matching file under <code>agents/context_bundles/</code>.</li><li>Predict which duplicate reads <code>/load_bundle</code> will collapse.</li><li>Open a fresh agent and run <code>/load_bundle &lt;path&gt;</code>.</li><li>Confirm each unique file is read once with the most comprehensive parameters.</li></ol>
+          <p>Checkpoint 3 passes when a fresh agent remounts the useful prior state and you can explain what was intentionally not captured.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: logging everything, then replaying everything</h3>
+          <p><strong>Symptom:</strong> the replacement agent fills immediately with redundant slices, giant writes, tool noise, and old prompts executed as if they were new instructions.</p>
+          <p><strong>Fix:</strong> keep the operational schema narrow, deduplicate reads, prefer the most comprehensive entry, treat prompts as historical context only, and accept partial restoration. The goal is a useful mount point, not a byte-for-byte clone.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — inspectable state transfer</p>
+          <h3>New runtimes may structure sessions differently; the seam survives</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · durable pattern</p><p>The extract’s SDK overlay notes structured output, hooks, sub-agents, and session control in newer production forms. The hand-built JSONL bundle remains valuable teaching because you can inspect exactly what crosses the hand-off and repair the selection rule.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What produces a context bundle, and what reloads it?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>context_bundle_builder.py</code>, wired through hooks, appends the JSONL; <code>/load_bundle</code> deduplicates and replays it.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why does replaying roughly 70% help?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It restores the task trail and important files without cloning every intermediate detail that bloated the previous window.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Draw the path from hook event to JSONL line to <code>/load_bundle</code>. Explain the full-read preference, why prompts are not re-executed, and why incomplete restoration is intentional.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="one-purpose">
+        <span class="section-number">09</span>
+        <h2 class="section-title">Technique 9 · One agent, one purpose</h2>
+        <p class="section-lead">The summary rule turns individual reductions and delegations into an AI Developer Workflow: plan the human outcome first, then allocate one focused responsibility to each agent.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 09</span><span class="level-chip">Advanced</span><span class="framework-chip framework-chip--both">R&amp;D</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — the heroic generalist</p>
+          <h3>One agent owns a feature, so every failure looks the same</h3>
+          <p>A single agent interviews the requirement, explores the repository, chooses an architecture, edits files, tests, improves its own prompt, commits, and writes release notes. Its context becomes a mixture of user intent, rejected designs, implementation details, logs, corrections, and delivery ceremony. When it fails, you cannot tell whether discovery, planning, building, or verification was weak.</p>
+          <p>One-agent-one-purpose is not a claim that agents can perform only simple tasks. It is a design rule: give one window one coherent responsibility so its context and success evidence remain legible.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — designed ADW diagram</p>
+          <h3>A high-level outcome becomes a pipeline of focused windows</h3>
+          <figure class="diagram">
+            <div class="diagram__canvas">
+              <svg viewBox="0 0 1000 420" role="img" aria-labelledby="pipeline-title pipeline-desc">
+                <title id="pipeline-title">One agent one purpose AI Developer Workflow</title>
+                <desc id="pipeline-desc">A customer outcome enters four focused agents for planning, building, improving, and committing, with artifacts moving between each stage.</desc>
+                <defs><marker id="pipeline-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" fill="var(--accent)"/></marker></defs>
+                <text x="500" y="45" text-anchor="middle" fill="var(--ink)" font-family="var(--font-display)" font-size="var(--text-diagram-2xl)" font-weight="700">Outcome first. Agent topology second.</text>
+                <rect x="30" y="130" width="170" height="165" rx="18" fill="var(--accent-wash)" stroke="var(--accent)" stroke-width="3"/>
+                <text x="115" y="178" text-anchor="middle" fill="var(--accent-ink)" font-family="var(--font-display)" font-size="var(--text-diagram-xl)" font-weight="700">Plan</text>
+                <text x="115" y="215" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-body)" font-size="var(--text-diagram-sm)">purpose: decide</text>
+                <text x="115" y="246" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-mono)" font-size="var(--text-diagram-sm)">output: spec</text>
+                <line x1="205" y1="212" x2="275" y2="212" stroke="var(--accent)" stroke-width="4" marker-end="url(#pipeline-arrow)"/>
+                <rect x="285" y="130" width="170" height="165" rx="18" fill="var(--bg-card)" stroke="var(--delegate)" stroke-width="3"/>
+                <text x="370" y="178" text-anchor="middle" fill="var(--delegate)" font-family="var(--font-display)" font-size="var(--text-diagram-xl)" font-weight="700">Build</text>
+                <text x="370" y="215" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-body)" font-size="var(--text-diagram-sm)">purpose: implement</text>
+                <text x="370" y="246" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-mono)" font-size="var(--text-diagram-sm)">output: diff</text>
+                <line x1="460" y1="212" x2="530" y2="212" stroke="var(--accent)" stroke-width="4" marker-end="url(#pipeline-arrow)"/>
+                <rect x="540" y="130" width="170" height="165" rx="18" fill="var(--bg-card)" stroke="var(--foundation)" stroke-width="3"/>
+                <text x="625" y="178" text-anchor="middle" fill="var(--foundation)" font-family="var(--font-display)" font-size="var(--text-diagram-xl)" font-weight="700">Improve</text>
+                <text x="625" y="215" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-body)" font-size="var(--text-diagram-sm)">purpose: learn</text>
+                <text x="625" y="246" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-mono)" font-size="var(--text-diagram-sm)">output: expertise</text>
+                <line x1="715" y1="212" x2="785" y2="212" stroke="var(--accent)" stroke-width="4" marker-end="url(#pipeline-arrow)"/>
+                <rect x="795" y="130" width="170" height="165" rx="18" fill="var(--ok-wash)" stroke="var(--ok)" stroke-width="3"/>
+                <text x="880" y="178" text-anchor="middle" fill="var(--ok)" font-family="var(--font-display)" font-size="var(--text-diagram-xl)" font-weight="700">Commit</text>
+                <text x="880" y="215" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-body)" font-size="var(--text-diagram-sm)">purpose: preserve</text>
+                <text x="880" y="246" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-mono)" font-size="var(--text-diagram-sm)">output: history</text>
+                <text x="500" y="360" text-anchor="middle" fill="var(--ink-soft)" font-family="var(--font-body)" font-size="var(--text-diagram-md)">Each arrow carries an artifact, not the whole previous window.</text>
+              </svg>
+            </div>
+            <figcaption>Technique 9 has no unique course UI frame; the verified frame plan calls for a designed pipeline. A specification, diff, learned Expertise, and commit are explicit hand-off artifacts.</figcaption>
+          </figure>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — the first eight techniques collapse into one rule</p>
+          <h3>Focus becomes architecture</h3>
+          <p>Measure tells you whether a window is focused. MCP scoping, small memory, concise output, reset-and-prime, and bundles reduce what one agent carries. Sub-agents and architect/editor move responsibilities into other windows. Technique 9 names the architecture those moves imply: do not let one agent become the codebase, project manager, researcher, implementer, and historian.</p>
+          <p>Dan gives a two-step planning sequence. First, plan the work without regard for technology: what outcome serves the user or customer? Second, plan the agent pipeline that will deliver it. Starting with “I have five agents; what should they do?” reverses the design and creates artificial roles.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>One agent, one purpose; AI Developer Workflow</h3>
+          <aside class="callout callout--term"><p class="callout__label">Summary technique</p><p><strong>Use one agent for one purpose so that your context windows are focused.</strong> Compose those agents into an <strong>ADW</strong>—an AI Developer Workflow.</p></aside>
+          <p>Purpose is narrower than a job title. “Builder” is useful only if its inputs, allowed actions, and success evidence are clear. The <code>/build</code> command is a purpose because it accepts a plan, implements it, and reports the diff. “Do the feature” is not.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — decompose the hook lab</p>
+          <h3>Turn one request into four observable stages</h3>
+          <table><thead><tr><th>Purpose</th><th>Minimum input</th><th>Output artifact</th><th>Failure becomes</th></tr></thead><tbody><tr><td>Plan the hook</td><td>Feature request + hook expertise</td><td>Spec under <code>specs/experts/</code></td><td>Incomplete or unsafe design</td></tr><tr><td>Build the hook</td><td>Spec + implementation expertise</td><td>Hook file + settings diff + tests</td><td>Implementation defect</td></tr><tr><td>Improve expert</td><td>Git diff/log + expert files</td><td>Updated <code>## Expertise</code></td><td>Missed learning or scope violation</td></tr><tr><td>Commit</td><td>Verified diff</td><td>Repository history</td><td>Packaging/history defect</td></tr></tbody></table>
+          <p>The table localizes debugging. If Workflow changed during improve, the improve purpose violated its contract. If the hook is wrong but the spec predicted the wrong event, the failure began in planning. Focus creates observability.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — pipeline on paper</p>
+          <h3>Do not write code yet</h3>
+          <ol><li>Choose one small course-repository outcome.</li><li>Describe the user-visible or operator-visible result without naming agents.</li><li>Split it into plan, build, improve, and commit only where each stage has a distinct artifact.</li><li>For each stage, write one purpose sentence and one pass criterion.</li></ol>
+          <p>This is the Technique 9 lab checkpoint. A paper pipeline is enough. Full ADW orchestration belongs to later lessons; this chapter protects the primitive.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: agent topology before work design</h3>
+          <p><strong>Symptom:</strong> roles exist because the orchestration tool supports them. Several agents read the same files, no artifact defines a hand-off, and a “manager” repeats everyone’s reports.</p>
+          <p><strong>Fix:</strong> plan work without regard for technology, then create one agent only where one coherent purpose and one hand-off artifact exist. Fewer focused stages beat a decorative fleet.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — topology scales the rule</p>
+          <h3>Multi-agent architectures are the future trend, not an excuse to skip focus</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Multi-agent architectures and specialized agents are two of the lesson’s future bets. They increase the value of one-agent-one-purpose because every extra window multiplies both good boundaries and confused boundaries. Compose only after the single-purpose contract is legible.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What are the two planning steps behind one-agent-one-purpose?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Plan the desired work/outcome without regard for technology; then design the focused agent pipeline that delivers it.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why does single purpose improve debugging?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Each stage has a narrower context and observable artifact, so a failure can be localized to planning, building, improving, or delivery.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Teach the ADW diagram without using “because multi-agent is better.” Explain the outcome-first sequence, the four hand-off artifacts, and why an artifact should cross the boundary instead of an entire transcript.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="system-prompt">
+        <span class="section-number">10</span>
+        <h2 class="section-title">Technique 10 · Modify the system prompt</h2>
+        <p class="section-lead">At the hidden agentic level, you can steer the behavior that creates context—not just the files or prompts already inside it. Append narrowly; overwrite only when you understand what disappears.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 10</span><span class="level-chip">Agentic</span><span class="framework-chip framework-chip--reduce">Reduce</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — control the read itself</p>
+          <h3>A request to “be concise” does not constrain tool behavior</h3>
+          <p>An agent asked about the purpose of <code>CLAUDE.large.md</code> could read all 2,978 lines before answering. The user prompt states the question but not a tool-use discipline. Technique 10 modifies the behavioral layer: read only 100 lines at a time, continue in increments only if necessary, and mark the final response with success or failure.</p>
+          <p>The resulting reduction is not guaranteed by a shorter answer. It comes from changing how the agent gathers evidence. This is why the system prompt is a deeper control surface than an output style.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — append versus overwrite</p>
+          <h3>Preserve the crafted default unless replacement is the product</h3>
+          <div class="agent-compare">
+            <article><strong><code>--append-system-prompt</code></strong><p>Adds one behavioral rule to Claude Code’s existing system prompt. The course uses it in print mode for an out-of-loop run.</p></article>
+            <article><strong><code>customSystemPrompt</code></strong><p>The course-era SDK wrapper passes a complete replacement. It can remove the carefully crafted default behavior; Dan warns not to use it casually.</p></article>
+          </div>
+          <p>Both controls can be legitimate. The asymmetry is risk. Appending can conflict with the default, but overwriting begins from zero. If your goal is a narrow read discipline, replacement is a needlessly large intervention.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — one command, observable obedience</p>
+          <h3>The bundle proves <code>Read(100)</code></h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t2705-append-system-prompt.jpg" alt="Terminal command appending a system prompt that requires reading in 100-line increments and prefixing the final answer with an emoji" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">45:05</span>The command runs with <code>--append-system-prompt</code> and <code>-p</code>, asks about <code>CLAUDE.large.md</code>, limits reads to 100-line increments, and requires a ✅/❌ final prefix.</figcaption>
+          </figure>
+          <p>The clever part is the evidence channel already built in Technique 8. The session’s context bundle records read operations and their limits. The student does not grade success from the final prose alone; the JSONL should show 100-line reads. Behavior control becomes testable.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>When you control behavior, you control the window</h3>
+          <aside class="callout callout--term"><p class="callout__label">Agentic-level rule</p><p><strong><code>--append-system-prompt</code></strong> augments the default in print mode. <strong><code>customSystemPrompt</code></strong> replaces it. Prefer the smaller behavioral intervention.</p></aside>
+          <p>Print mode matters because the course is treating Claude Code as a callable component rather than an interactive partner. The command uses <code>-p</code>; the agent executes and returns. That is the bridge from context engineering in one terminal to programmable, out-of-loop agents.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — decompose the command</p>
+          <h3>Every flag has a context role and a risk</h3>
+          <pre><code>claude \
+  --dangerously-skip-permissions \
+  --model sonnet \
+  --append-system-prompt "ALWAYS read files in 100-line increments ...
+    prefix your final message with ✅ or ❌" \
+  -p "what is CLAUDE.large.md for?"</code></pre>
+          <table><thead><tr><th>Part</th><th>Role</th><th>Evidence / caution</th></tr></thead><tbody><tr><td>Append rule</td><td>Constrains read increments and report prefix</td><td>Bundle read limits + final marker</td></tr><tr><td><code>-p</code></td><td>Runs non-interactively</td><td>Required for the demonstrated out-loop form</td></tr><tr><td>Model flag</td><td>Selects the course demo model class</td><td>Model name is period detail</td></tr><tr><td>Skip permissions</td><td>Prevents prompts from blocking automation</td><td>High risk; keep the run scoped to this course repo</td></tr></tbody></table>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — verify tool behavior, not rhetoric</p>
+          <h3>Run the exact course-scoped experiment</h3>
+          <ol><li>Use the lab command against <code>CLAUDE.large.md</code> in the course repository.</li><li>Open the generated bundle for the run.</li><li>Find each Read entry and record its <code>limit</code> and <code>offset</code>.</li><li>Confirm the final message begins with the required marker.</li></ol>
+          <p>The checkpoint passes only when the bundle shows the read discipline. A compliant final sentence with an uncontrolled full-file read is a failure.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: overwrite the system prompt to add one sentence</h3>
+          <p><strong>Symptom:</strong> a custom agent loses default tool-use behaviors or guardrails because a full replacement was used for a narrow preference.</p>
+          <p><strong>Fix:</strong> append the smallest rule that produces the observable behavior, keep the run scoped, and verify the effect through tool traces. Replace only when the whole system prompt is intentionally part of the domain-specific agent design.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — the grown-up SDK form</p>
+          <h3>The flags survive; production embedding adds structure</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Headless mode now sits alongside richer structured output, allowed-tool and permission controls, session resume, hooks, sub-agents, and Python/TypeScript Agent SDKs. The raw CLI remains the clearest teaching form. Production code should expose the same behavioral rule and evidence through a structured runtime rather than silently rewriting the idea.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Which flag augments the system prompt, and what mode does the demo use?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>--append-system-prompt</code> in print mode, <code>-p</code>.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What is the dangerous SDK alternative?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>customSystemPrompt</code>, because it overwrites the default rather than appending.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Explain append versus overwrite with the 100-line experiment. Your listener should know the command’s purpose, why print mode matters, and where to find behavioral proof.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="primary">
+        <span class="section-number">11</span>
+        <h2 class="section-title">Technique 11 · Primary multi-agent delegation</h2>
+        <p class="section-lead">A sub-agent is an internal worker. A delegated primary agent is a fully independent Claude Code instance with its own context, model, settings, and file-based reporting channel.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 11</span><span class="level-chip">Agentic</span><span class="framework-chip framework-chip--delegate">Delegate</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — keep working while another primary runs</p>
+          <h3>The orchestration layer launches compute, then exits the loop</h3>
+          <p>Sub-agents are excellent for internal, isolated work, but their lifecycle belongs to the primary agent and their summaries return into its conversation. Technique 11 creates a stronger boundary: launch another Claude Code process in print mode, give it a model and behavioral prompt, and make a report file its primary output. The launcher can continue other work while the independent instance proceeds.</p>
+          <p>This is “compute orchestrating compute.” The power comes with direct billing and reduced safety prompts. The course repeatedly frames this as an agentic-level technique: master the simpler context habits before scaling them into independent instances.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — partial fork versus independent process</p>
+          <h3>Do not collapse two delegation models</h3>
+          <div class="agent-compare">
+            <article><strong>Sub-agent · Technique 5</strong><p>Partially forked window. Definition is an isolated system prompt. Primary agent prompts it and receives its response in the primary workflow.</p></article>
+            <article><strong>Primary agent · Technique 11</strong><p>Independent Claude Code instance. Own context, model, settings, and keys. Writes progress into a report file and renames the file for terminal status.</p></article>
+          </div>
+          <p>Independence is useful when the work should continue without occupying or blocking the launching conversation. It also means the child process does not magically share the parent’s understanding. Its prompt and repository state must be sufficient.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — a live report becomes the return channel</p>
+          <h3>The file tells the launcher where work stands</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t3195-background-primary-delegation.jpg" alt="Background Claude Code task writing to a report file and promising a complete or failed filename" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">53:15</span>The launched instance writes <code>background-report-&lt;time&gt;.md</code>, updates progress while it works, and renames the file with <code>.complete.md</code> or <code>.failed.md</code>.</figcaption>
+          </figure>
+          <p>The shipped <code>/background</code> command creates <code>agents/background/</code>, captures one timestamp, creates the initial report header, and launches <code>claude</code> with model, text output, skipped permissions, an appended reporting system prompt, and print mode. It then checks the task with BashOutput and returns a concise launch message.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Primary delegation</h3>
+          <aside class="callout callout--term"><p class="callout__label">Dan’s phrase</p><p><strong>Agents orchestrating agents; better agents, and then more agents.</strong> Primary delegation launches independent instances instead of partially forked sub-agent windows.</p></aside>
+          <p>The order matters. “Better agents” means focused, measured, scoped, and observable agents. “More agents” multiplies those properties. If the launching prompt is vague or the report contract is weak, independence makes the failure harder to notice, not more agentic.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — the background report state machine</p>
+          <h3>Pending → progressing → complete or failed</h3>
+          <div class="agent-flow" aria-label="Background report lifecycle">
+            <article class="agent-flow__step" style="--flow-color:var(--foundation)"><b>Create</b><code>report-time.md</code><p>Header exists before launch, so the path is stable.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--accent)"><b>Launch</b><code>claude ... --print</code><p>Independent process receives the exact user prompt.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--delegate)"><b>Update</b><code>## Progress</code><p>Report is continuously edited after major steps.</p></article>
+            <article class="agent-flow__step" style="--flow-color:var(--ok)"><b>Rename</b><code>.complete / .failed</code><p>Filename exposes terminal status to the orchestrator.</p></article>
+          </div>
+          <p>The repository also ships <code>scripts/bg_claude_code_test.sh</code>, a raw <code>bg()</code> function demonstrating the same primitive. It is a teaching specimen, not the lab’s preferred interface; <code>/background</code> has the fuller report workflow.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — launch one tiny planner</p>
+          <h3>Keep the independent job small and inspectable</h3>
+          <ol><li>From a primary agent, run <code>/background "/quick-plan add a second helper to the wrapper" sonnet</code>.</li><li>Confirm the initial report file exists.</li><li>Watch <code>## Progress</code> update without sending interactive follow-ups.</li><li>Confirm terminal rename to <code>.complete.md</code> or <code>.failed.md</code>.</li><li>Run <code>/context</code> in the launching agent and explain what stayed outside it.</li></ol>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: treat background execution as free autonomy</h3>
+          <p><strong>Symptom:</strong> the agent runs with skipped permissions and API billing against a broad or unrelated directory; the report is empty until the end; failure has no observable state.</p>
+          <p><strong>Fix:</strong> keep the prompt and repository scope small, create the report before launch, update it continuously, expose success/failure in the filename, and remember that the independent agent uses your keys.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — structured production runtimes</p>
+          <h3>The shell form teaches the boundary; SDKs strengthen the channel</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Richer headless flags and Agent SDKs add JSON or streaming output, allowed-tool controls, permission modes, resume, hooks, sub-agents, and multi-turn control. The course’s report-file implementation remains the primitive: an independent agent needs explicit input, an observable progress channel, and terminal state.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">How does a primary delegated agent differ from a sub-agent?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It is a fully independent Claude Code instance with its own context, model, settings, and keys, reporting through files rather than returning inside the primary conversation.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What makes the report filename a state machine?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The initial <code>.md</code> becomes <code>.complete.md</code> on success or <code>.failed.md</code> on failure.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Compare Technique 5 and Technique 11 across context ownership, who prompts whom, where results return, and who pays. Then explain why a progress file is part of the agent design rather than mere logging.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="experts">
+        <span class="section-number">12</span>
+        <h2 class="section-title">Technique 12 · Agent experts</h2>
+        <p class="section-lead">A static expert prompt rots like any memory file. The course closes the loop: plan with expertise, build with expertise, then update only the expertise from the work just completed.</p>
+        <div class="technique-head"><span class="technique-chip">Technique 12</span><span class="level-chip">Agentic</span><span class="framework-chip framework-chip--both">R&amp;D</span></div>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — encode the engineer who knows the subsystem</p>
+          <h3>Knowledge is useful only if the procedure can learn without drifting</h3>
+          <p>The hook subsystem has event semantics, UV script structure, output formats, path rules, testing commands, and project conventions. A generic builder can rediscover them on every task, spending context and repeating mistakes. A static mega-prompt can store them, then become stale. The agent-expert pattern separates stable procedure from updateable domain knowledge and gives one meta-step permission to edit only the latter.</p>
+          <p>This is the lesson’s culmination because it combines reduction, delegation, artifacts, and feedback. A plan agent focuses on architecture. A build agent focuses on implementation. An improve agent reads the diff and folds durable discoveries back into their dedicated <code>## Expertise</code> sections.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — plan, build, improve</p>
+          <h3>Stable Workflow around a learning core</h3>
+          <div class="expert-loop" aria-label="Agent expert plan build improve loop">
+            <article><strong>Plan</strong><p>Read hook docs and infrastructure. Write a spec under <code>specs/experts/cc_hook_expert/</code>.</p></article>
+            <article><strong>Build</strong><p>Implement from the spec, make the script executable, and test with JSON piped through uv.</p></article>
+            <article><strong>Improve</strong><p>Read diff and history. Update only <code>## Expertise</code>; never modify Workflow.</p></article>
+          </div>
+          <p>The strict header boundary is the design. Purpose, Instructions, and Workflow remain the procedure. Expertise is the knowledge that may change after experience. “We’re not conflating our headers” is a prompt-engineering rule with maintenance consequences.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — the triad is visible in the tree</p>
+          <h3>Three command files, one encoded specialist</h3>
+          <figure class="frame-card">
+            <img src="../media/frames/ah-1-rd-framework-context-window-mastery/t3485-agent-experts-triad.jpg" alt="Claude commands tree expanded to show hook expert plan build and improve files" width="1920" height="1080" loading="lazy">
+            <figcaption><span class="frame-card__t">58:05</span>The expanded <code>experts/cc_hook_expert/</code> directory shows the three files that constitute the expert: plan, build, and improve.</figcaption>
+          </figure>
+          <p>The repository already contains evidence that improve ran. The plan expert’s <code>## Expertise</code> includes “Discovered Patterns from Universal Logger Implementation.” The build expert includes “Learned Best Practices from Recent Implementations.” The demonstrated feature, <code>universal_hook_logger.py</code>, writes timestamped payloads into <code>agents/hook_logs/&lt;session_id&gt;/&lt;event&gt;.jsonl</code> and exits non-blockingly.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Self-improving agent expert</h3>
+          <aside class="callout callout--term"><p class="callout__label">Definition</p><p>An <strong>agent expert</strong> is a specialized plan/build/improve triad that owns a codebase area and updates its own dedicated Expertise from completed work.</p></aside>
+          <p>The differentiator is not a long prompt or a specialist label. It is the controlled learning loop. The improve command can stop with “No expertise updates needed.” Refusing to invent a lesson from an irrelevant diff is part of maintaining quality.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — inspect update permissions</p>
+          <h3>The improve command has a narrow mutation surface</h3>
+          <ol><li>Read hook documentation and establish expertise.</li><li>Run <code>git diff</code>, <code>git diff --cached</code>, and <code>git log --oneline -10</code>.</li><li>Filter to hook implementations, settings, and expert specs.</li><li>Determine whether new patterns, security practices, tests, or performance lessons exist.</li><li>If not, stop. If yes, update only the plan/build <code>## Expertise</code> sections.</li></ol>
+          <p>Planning knowledge includes event selection, spec structure, security, and output-format decisions. Building knowledge includes UV patterns, error handling, implementation standards, and testing. The Workflow sections remain stable so one diff cannot rewrite how the expert governs itself.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — run the triad end to end</p>
+          <h3>Build a tiny SessionStart logger through agents only</h3>
+          <ol><li>Run <code>/experts:cc_hook_expert:cc_hook_expert_plan "log SessionStart events to a JSONL file"</code>.</li><li>Run the build expert with the generated spec path.</li><li>Run the improve expert after reviewing the hook diff.</li><li>Use <code>git diff</code> to prove improve changed only <code>## Expertise</code>, never Workflow.</li></ol>
+          <p>Zero application code is typed by hand. Your work is to review artifacts, check the command evidence, and reject a scope violation.</p>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: a giant expert prompt with no learning boundary</h3>
+          <p><strong>Symptom:</strong> knowledge and procedure share one undifferentiated block. An “improve yourself” command edits instructions, silently changes workflow order, or appends every local detail forever.</p>
+          <p><strong>Fix:</strong> keep Expertise as a dedicated section, constrain improve to that section, require diff-based evidence, and allow no-op improvement. A maintained specialist is more valuable than a prompt that merely calls itself expert.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — Skills as first-class packaging</p>
+          <h3>The hand-built loop still teaches what the package must preserve</h3>
+          <aside class="current-practice"><p class="current-practice__label">Current practice · mid-2026 extract</p><p>Agent Skills package reusable expertise through a discoverable <code>SKILL.md</code> with trigger guidance and sharing. They are the first-class modern answer to “how do I encode what an agent knows?” The course’s triad remains additive: plan/build separation and diff-driven self-improvement show the learning loop a package must still govern.</p></aside>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">What are the three steps, and what makes the expert self-improving?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Plan → Build → Improve. Improve reads the diff/history and updates only dedicated Expertise sections with relevant learnings.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why must Workflow remain untouched?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It is the stable procedure and governance boundary; learning should update domain knowledge without silently rewriting the process.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Explain how the hook expert is different from a static mega-prompt. Include the three artifacts, the diff evidence, the no-op case, and the exact section improve may mutate.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section idea-cycle" id="future">
+        <span class="section-number">13</span>
+        <h2 class="section-title">The future: spend tokens properly</h2>
+        <p class="section-lead">The lesson does not predict that context engineering disappears. It predicts bigger, better, more dynamic windows—and more agents whose windows must be deliberately composed.</p>
+
+        <div class="move move--hook">
+          <p class="move-label">1 · Hook — the bigger-window escape hatch</p>
+          <h3>If a future window is ten times larger, do the twelve techniques vanish?</h3>
+          <p>A larger container delays overflow. It does not guarantee that a model attends equally well to everything inside. The lesson’s safe-bet argument is that capability degrades as relevant evidence is diluted by length, contradiction, and unrelated state. Bigger windows help with capacity; better effective windows address attention. R&amp;D remains useful under both.</p>
+          <p>The closing economic frame also changes the objective. Elite context engineering is not a competition to spend the fewest tokens. A planner may spend more so a builder succeeds once. A sub-agent fleet may consume more aggregate context while protecting the critical primary window. The waste to remove is failed correction loops and human babysitting.</p>
+        </div>
+
+        <div class="move move--picture">
+          <p class="move-label">2 · Picture — five bets</p>
+          <h3>Capacity, effectiveness, hot swap, architectures, specialization</h3>
+          <div class="future-grid" aria-label="Five context engineering future trends">
+            <article style="--future-color:var(--level-beginner)"><b>01</b><strong>Larger windows</strong><p>More capacity and less pressure to compact. Helpful, not sufficient.</p></article>
+            <article style="--future-color:var(--accent)"><b>02</b><strong>Better windows</strong><p>More effective attention as length grows—the deeper frontier.</p></article>
+            <article style="--future-color:var(--foundation)"><b>03</b><strong>Hot-swapped context</strong><p>Tools, context, and system-prompt blocks move in and out per need.</p></article>
+            <article style="--future-color:var(--delegate)"><b>04</b><strong>Multi-agent architecture</strong><p>Delegation becomes a standard way to isolate work and context.</p></article>
+            <article style="--future-color:var(--level-agentic)"><b>05</b><strong>Specialized agents</strong><p>Context, model, prompt, and tools are tuned for a domain purpose.</p></article>
+          </div>
+          <p>The verified frame plan calls for this designed diagram because the recap is narration over B-roll, not a unique slide. Output styles already demonstrate a small hot-swap: a system-prompt block changes without rebuilding the whole tool.</p>
+        </div>
+
+        <div class="move move--story">
+          <p class="move-label">3 · Story — better agents, then more agents</p>
+          <h3>The chapter’s levels are an adoption sequence</h3>
+          <p>The beginner learns to see and remove obvious bloat. The intermediate controls replies and separates responsibilities. The advanced learner owns reset, state transfer, and purpose boundaries. Only then does the agentic level modify system behavior, launch independent primaries, and maintain expert knowledge. The sequence is a safety story: patterns scale whatever quality they already have.</p>
+          <p>Dan’s endgame moves from in-loop to out-of-loop to ZTE. Context is what lets presence drop. When an agent begins with a known state, performs one purpose, writes observable artifacts, and hands off through a defined channel, the human can review the outcome instead of carrying each transition.</p>
+        </div>
+
+        <div class="move move--name">
+          <p class="move-label">4 · Name it</p>
+          <h3>Spend tokens properly</h3>
+          <aside class="callout callout--term"><p class="callout__label">Closing frame</p><p><strong>It is not about saving tokens. It is about spending them properly.</strong> The target is reliable one-shot out-of-loop work with fewer correction attempts and less human presence.</p></aside>
+          <p>Proper spending means context that earns its place: a complete plan, the exact tool schema, a relevant file slice, or a concise report. Improper spending means idle servers, contradictory memory, repeated summaries, undifferentiated transcripts, and retries caused by an unfocused agent.</p>
+        </div>
+
+        <div class="move move--example">
+          <p class="move-label">5 · Worked example — the same feature under two budgets</p>
+          <h3>Cheap first attempt versus reliable pipeline</h3>
+          <div class="practice-grid"><article><strong>Minimize each call</strong><p>One under-primed agent receives a short request, misses the hook event, retries after correction, then needs a second repair. Initial usage is small; total work and human attention grow.</p></article><article><strong>Spend for focus</strong><p>A planner loads hook expertise and writes a spec. A fresh builder implements. Improve captures the new pattern. Aggregate tokens may be higher, but the artifacts are reviewable and the path is reusable.</p></article></div>
+          <p>The second scenario is not guaranteed to win on every tiny change. The lesson asks you to measure. Use the heavier pipeline when complexity, repetition, or unattended execution makes reliability valuable.</p>
+        </div>
+
+        <div class="move move--try">
+          <p class="move-label">6 · You try — context investment ledger</p>
+          <h3>Separate useful spend from correction spend</h3>
+          <ol><li>Choose one completed lab checkpoint.</li><li>List tokens or time spent establishing context, performing the purpose, reporting, and correcting errors.</li><li>Mark each item <strong>investment</strong>, <strong>execution</strong>, or <strong>rework</strong>.</li><li>Name one Reduce move that could cut rework and one Delegate move that could protect the critical window.</li></ol>
+        </div>
+
+        <div class="move move--fail">
+          <p class="move-label">7 · Common fail + fix</p>
+          <h3>Failure: skip beginner discipline because the future is multi-agent</h3>
+          <p><strong>Symptom:</strong> every task becomes a fleet, each agent inherits broad memory and MCP servers, and nobody records <code>/context</code>. Aggregate spend rises while failures become harder to localize.</p>
+          <p><strong>Fix:</strong> better agents first. Measure one window, establish the prime, narrow the purpose, define evidence, then add another window only where delegation protects focus.</p>
+        </div>
+
+        <div class="move move--current">
+          <p class="move-label">8 · Current practice — what changed and what did not</p>
+          <h3>Modern packaging overlays the course; it does not erase it</h3>
+          <div class="evidence-grid">
+            <article><strong>Agent Skills</strong><p>First-class packaging for reusable expertise. Preserve the expert loop’s trigger, knowledge boundary, and improvement discipline.</p></article>
+            <article><strong>Agent SDKs</strong><p>Structured output, hooks, sub-agents, sessions, and control around headless agents. Preserve explicit inputs and observable terminal state.</p></article>
+            <article><strong>Improved compaction</strong><p>More controllable summaries and automatic behavior. Preserve the principle that out-of-loop state must be knowable and owned.</p></article>
+          </div>
+          <p class="source-note"><strong>Video overlay discipline.</strong> The extract names three possible IndyDevDan overlay topics but contains no verified video IDs. This chapter therefore publishes no YouTube links rather than fabricating them. The current-practice notes above come from the supplied technical-accuracy extract.</p>
+        </div>
+
+        <div class="move move--check">
+          <p class="move-label">9 · Retrieval</p>
+          <section class="retrieval-quiz"><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Name the five future trends.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Larger windows, better/effective windows, hot-swapped context, multi-agent architectures, and specialized agents everywhere.</p></details></div><div class="retrieval-quiz__item"><p class="retrieval-quiz__q">Why can spending more tokens be better context engineering?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>When the spend creates a focused plan, isolated work, observable artifacts, and fewer correction attempts, it reduces rework and human babysitting.</p></details></div></section>
+        </div>
+
+        <div class="move move--teach">
+          <p class="move-label">10 · Teach-back</p>
+          <div class="teach-back"><p>Resolve the paradox in two minutes: explain how more effort on reset-and-prime, plan-then-build, and expert maintenance allows less human presence. Finish with which future trend strengthens—not weakens—the R&amp;D framework.</p></div>
+        </div>
+      </section>
+
+      <section class="chapter-section chapter-section--wide" id="lab">
+        <span class="section-number">14</span>
+        <h2 class="section-title">Graded lab · Own and move the window</h2>
+        <p class="section-lead">Run every drill inside <code>agentic-horizon/elite-context-engineering</code> only. Measure before and after every R or D move. Do not hand-type application code; planners, builders, and experts produce it.</p>
+
+        <aside class="callout callout--warning"><p class="callout__label">Cost and safety boundary</p><p>Techniques 10–12 run in print/background modes, use your API key, and may use <code>--dangerously-skip-permissions</code>. Keep them scoped to this course repository and to the tiny prompts below. If you cannot incur that cost, complete read-only inspection but mark those execution checkpoints incomplete.</p></aside>
+
+        <h3>Lab map</h3>
+        <div class="lab-evidence">
+          <article><strong>Checkpoint 0</strong><p>Baseline <code>/context</code> ledger and file token estimate.</p></article><article><strong>Checkpoint 1</strong><p>MCP and memory categories both measurably reduced.</p></article><article><strong>Checkpoint 2</strong><p>Output, sub-agent, and planner/builder boundaries proved.</p></article><article><strong>Checkpoint 3</strong><p>Known reset and successful bundle remount.</p></article><article><strong>Checkpoint 4</strong><p>System behavior, background report, and expert loop verified.</p></article><article><strong>Oral close</strong><p>Sort all twelve and resolve the context-effort paradox.</p></article>
+        </div>
+
+        <section class="lab-box" id="lab-setup">
+          <h3 class="lab-box__title">Checkpoint 0 · Setup and baseline <span class="graded-badge">10 minutes</span></h3>
+          <ol class="lab-box__steps">
+            <li>Use the supplied course codebase, or clone <code>https://github.com/disler/elite-context-engineering.git</code> for your own course workspace.</li>
+            <li>Copy <code>.env.sample</code> to <code>.env</code>. Set <code>ANTHROPIC_API_KEY</code>; ElevenLabs and OpenAI keys are optional for unrelated TTS/utility demonstrations.</li>
+            <li>Read <code>README.md</code>. On paper, list the twelve techniques with their Level and R/D framework tag.</li>
+            <li>Open the README in an editor with a token counter. Record its estimate.</li>
+            <li>Boot <code>claude</code>, run <code>/context</code>, and record total percentage, System tools, MCP tools, Custom agents, Memory files, and Free space.</li>
+          </ol>
+          <div class="lab-box__pass"><h4>Pass evidence</h4><ul><li>A timestamped baseline ledger with six <code>/context</code> values.</li><li>A separate README token estimate and a correct explanation of why it is not already-loaded context.</li><li>A twelve-technique map; exact recorded-video numbers are not required.</li></ul></div>
+        </section>
+
+        <section class="lab-box" id="lab-reduce">
+          <h3 class="lab-box__title">Checkpoint 1 · Beginner Reduce moves <span class="graded-badge">20 minutes</span></h3>
+          <h4>T1 · Measure</h4><p>Identify your two largest controllable categories. Keep the baseline unchanged in your notes.</p>
+          <h4>T2 · Scope MCP</h4>
+          <pre><code>claude --mcp-config .mcp.json.firecrawl_7k.sample --strict-mcp-config</code></pre>
+          <p>Run <code>/context</code>. Record MCP before/after and state why strict mode matters.</p>
+          <h4>T3 · Memory and prime</h4>
+          <ol class="lab-box__steps"><li>Inspect the first lines and line count of <code>CLAUDE.large.md</code>. Observe the large-memory warning when using the course’s bloated-memory demonstration.</li><li>Restore the 43-line <code>CLAUDE.md</code>/<code>CLAUDE.concise.md</code>.</li><li>Run <code>/context</code>, then <code>/prime</code>. Inspect <code>/prime_cc</code> without assuming it is the same prime.</li></ol>
+          <div class="lab-box__pass"><h4>Pass evidence</h4><ul><li>MCP tokens moved down after the scoped config.</li><li>Memory-file tokens moved down after the concise file.</li><li>Your notes separate “smaller automatic memory” from “task context intentionally reloaded by prime.”</li><li>Grade direction and proportion; video values 24.1k → 6.5k and 23.7k → 358 are reference evidence only.</li></ul></div>
+        </section>
+
+        <section class="lab-box" id="lab-intermediate">
+          <h3 class="lab-box__title">Checkpoint 2 · Intermediate Reduce + Delegate <span class="graded-badge">20 minutes</span></h3>
+          <h4>T4 · Output style A/B</h4><p>Use two terminals. Select One Word Output in one and default in the other. Send the same <code>hi</code> and “What does this codebase do?” prompts. Record both response sizes and whether the explicit question was answered.</p>
+          <h4>T5 · Sub-agent scrape</h4><p>Record Custom agents, run <code>/load_ai_docs</code>, list skipped/deleted/written docs, and measure the primary window afterward. Draw who prompted whom and where the result returned.</p>
+          <h4>T6 · Architect/editor</h4><p>Run <code>/quick-plan "add a tiny helper to apps/cc_ts_wrapper"</code>. Review the spec. Open a fresh agent and run <code>/build &lt;spec-path&gt;</code>. Do not give the builder the planner transcript.</p>
+          <div class="lab-box__pass"><h4>Pass evidence</h4><ul><li>Same-prompt output comparison with the concise response measurably smaller.</li><li>Sub-agent work produces documentation files and a reduced primary report.</li><li>A fresh builder implements from a spec artifact alone.</li><li>You correctly label T4 Reduce, T5 Delegate, and T6 R&amp;D.</li></ul></div>
+        </section>
+
+        <section class="lab-box" id="lab-advanced">
+          <h3 class="lab-box__title">Checkpoint 3 · Advanced known state <span class="graded-badge">20 minutes</span></h3>
+          <h4>T7 · Compact versus reset</h4><p>After course work, run <code>/compact</code> and inspect the summary. Then run <code>/clear</code> and <code>/prime</code>. Write which state you can describe as a loading recipe.</p>
+          <h4>T8 · Bundle remount</h4><p>Open the current file under <code>agents/context_bundles/</code>. Mark prompts, duplicate reads, read slices, and writes. In a fresh agent run <code>/load_bundle &lt;path&gt;</code> and confirm deduplicated replay.</p>
+          <h4>T9 · One purpose</h4><p>On paper, split one course task into plan → build → improve → commit. Give every stage one purpose, minimum input, output artifact, and pass criterion.</p>
+          <div class="lab-box__pass"><h4>Pass evidence</h4><ul><li>A one-sentence epistemic contrast between compact and reset-and-prime.</li><li>A fresh agent reads each unique bundle file once using the best recorded parameters.</li><li>A four-stage paper ADW whose arrows carry artifacts rather than transcripts.</li></ul></div>
+        </section>
+
+        <section class="lab-box" id="lab-agentic">
+          <h3 class="lab-box__title">Checkpoint 4 · Agentic control and delegation <span class="graded-badge">25 minutes</span></h3>
+          <h4>T10 · Append system behavior</h4>
+          <pre><code>claude --dangerously-skip-permissions --model sonnet \
+  --append-system-prompt "ALWAYS read files in 100-line increments (offset=0 limit=100, then offset=100 limit=100); if you have enough, stop and proceed; prefix your final message with ✅ or ❌" \
+  -p "what is CLAUDE.large.md for?"</code></pre>
+          <p>Open the run’s bundle and prove 100-line reads.</p>
+          <h4>T11 · Background primary</h4><p>Run <code>/background "/quick-plan add a second helper to the wrapper" sonnet</code>. Confirm progress writes and terminal rename.</p>
+          <h4>T12 · Hook expert triad</h4><p>Plan “log SessionStart events to a JSONL file,” build from the spec, and run improve. Use <code>git diff</code> to prove that improve touched only <code>## Expertise</code>, never Workflow.</p>
+          <div class="lab-box__pass"><h4>Pass evidence</h4><ul><li>Bundle entries show <code>limit: 100</code>, not merely a compliant final message.</li><li>Background report progresses without interactive babysitting and ends in complete/failed state.</li><li>Expert loop runs plan → build → improve and the mutation boundary holds.</li><li>Zero application code was hand-typed.</li></ul></div>
+        </section>
+
+        <section class="lab-box" id="lab-stretch">
+          <h3 class="lab-box__title">Stretch drills · still course codebase only</h3>
+          <ol class="lab-box__steps"><li><strong>New prime:</strong> have the agent author <code>/prime_bug</code> or <code>/prime_feature</code>; prove it loads a different task-scoped state.</li><li><strong>Self-fixed MCP sample:</strong> add a narrow sample for a server you actually use and verify the measured cost.</li><li><strong>Middle output style:</strong> create one line plus a status emoji; compare it with default and one-word styles.</li><li><strong>Second expert:</strong> create a plan/build/improve triad for another concern; prove improve edits only Expertise.</li><li><strong>Wrapped ADW:</strong> chain plan → build → improve → commit in one background workflow and remount with a bundle if required.</li></ol>
+          <p class="fine">All stretch changes are authored through the course agents. Do not extend the lab to unrelated repositories.</p>
+        </section>
+
+        <section class="lab-box" id="lab-troubleshooting">
+          <h3 class="lab-box__title">Troubleshooting without losing the lesson</h3>
+          <table><thead><tr><th>Observation</th><th>Likely cause</th><th>Repair</th></tr></thead><tbody><tr><td>Your counts do not match the frame</td><td>Model, tool, globals, or shipped state differs</td><td>Grade your before/after direction and annotate the environment</td></tr><tr><td>Strict MCP does not reduce as expected</td><td>Wrong sample or comparison state</td><td>Confirm filename, restart, and inspect the MCP category—not only total</td></tr><tr><td><code>/quick-plan</code> model unavailable</td><td>Course-era model pin</td><td>Update the command frontmatter to a model available in your environment</td></tr><tr><td><code>/load_ai_docs</code> cannot scrape</td><td>Firecrawl/key/network dependency</td><td>Record the blocker; inspect command/agent flow without fabricating success</td></tr><tr><td>Bundle contains no reads</td><td>Hook not loaded or no matching operations</td><td>Inspect <code>.claude/settings.json</code>, restart, run a known read</td></tr><tr><td>Background run feels unsafe</td><td>Skipped permissions + broad prompt</td><td>Stop; narrow to this repo and the tiny course prompt before relaunching</td></tr><tr><td>Improve edits Workflow</td><td>Expert violated mutation contract</td><td>Fail the checkpoint and ask the expert to revert only its out-of-scope edits</td></tr></tbody></table>
+        </section>
+
+        <section class="lab-box" id="lab-final-pass">
+          <h3 class="lab-box__title">Final graded pass sheet</h3>
+          <ul class="lab-checklist"><li>Before/after <code>/context</code> evidence accompanies every context move.</li><li>MCP and memory categories measurably decreased.</li><li>At least two delegations ran: docs sub-agents and a background primary agent.</li><li>A fresh builder implemented from a plan alone.</li><li>A fresh agent remounted a context bundle with deduplicated reads.</li><li>The system-prompt run proved 100-line reads through its bundle.</li><li>The expert triad completed and improve changed only Expertise.</li><li>Zero application code was typed by hand.</li><li>All work remained in the course repository.</li><li>You can sort all twelve techniques by level and R/D without notes.</li></ul>
+        </section>
+      </section>
+
+      <section class="chapter-section" id="mastery">
+        <span class="section-number">15</span>
+        <h2 class="section-title">Cumulative mastery · retrieve, diagnose, teach</h2>
+        <p class="section-lead">Close the chapter and answer on paper. Reopen only to reveal. Recognition earns half credit; an answer you can use to choose or diagnose a context move earns full credit.</p>
+
+        <h3>Round 1 · Framework and measurement</h3>
+        <section class="retrieval-quiz" aria-label="Framework mastery questions">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">1. State R&amp;D and the central law.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Reduce and Delegate; a focused agent is a performant agent.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">2. Name the two measuring tools and the direction each looks.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>/context</code> looks at loaded category state; an IDE tokenizer estimates an incoming file before it enters.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">3. Reconstruct the important recorded boot numbers.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>About 63k/200k (31%) used, including MCP 24.1k and memory 23.7k; Custom agents about 122; README token estimate about 2,650. Approximation is enough if categories are correct.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">4. Why is the smallest window not automatically the best window?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The objective is sufficient, relevant context for the purpose. A complete spec or task prime may cost more and prevent larger rework.</p></details></div>
+        </section>
+
+        <h3>Round 2 · Beginner and intermediate diagnosis</h3>
+        <section class="retrieval-quiz" aria-label="Beginner and intermediate mastery questions">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">5. A new agent loads global MCP servers despite a narrow sample. Which flag was probably omitted?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p><code>--strict-mcp-config</code>.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">6. Why is CLAUDE.md incredible and terrible for the same reason?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It is always loaded. That guarantees true universals and also guarantees payment for irrelevant or contradictory material.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">7. A one-word style hides a failed test. Is the problem excessive or insufficient output?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Insufficient exception design. Errors and blockers must cross the report boundary even when routine success is one word.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">8. Why can sub-agents increase total token use while improving the system?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>They spend separate windows on isolated work and return reduced results, protecting the primary agent’s focus even if aggregate compute rises.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">9. The builder must rediscover target files after receiving a spec. Where should you repair first?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The planner/spec contract. A fresh builder should receive enough settled context from the plan.</p></details></div>
+        </section>
+
+        <h3>Round 3 · Advanced state ownership</h3>
+        <section class="retrieval-quiz" aria-label="Advanced mastery questions">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">10. What is Dan’s objection to <code>/compact</code>, and what principle survives improved compaction?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>The retained state is not explicit until inspected. The durable principle is that out-of-loop context must be knowable and owned.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">11. A bundle has full and sliced reads of the same file. What should <code>/load_bundle</code> do?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Read the file once in full because any full-read entry wins during deduplication.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">12. Why must logged prompts never be acted on during bundle replay?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>They are historical context describing prior requests, not new instructions for the replacement agent.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">13. What two planning steps come before an ADW?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Plan the desired work without regard for technology, then design the focused agent pipeline that performs it.</p></details></div>
+        </section>
+
+        <h3>Round 4 · Agentic boundaries</h3>
+        <section class="retrieval-quiz" aria-label="Agentic mastery questions">
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">14. A final message has ✅, but the bundle shows one full 2,978-line read. Did Technique 10 pass?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>No. The behavioral requirement was incremental 100-line reads; the marker alone is insufficient evidence.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">15. Sort this behavior: “launch an independent Claude process that continuously edits a report.”</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Technique 11, primary multi-agent delegation—not a sub-agent.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">16. An improve agent edits its own Workflow to add a new step. What happened?</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>It violated the expert’s mutation boundary. Improve may update only dedicated <code>## Expertise</code> sections.</p></details></div>
+          <div class="retrieval-quiz__item"><p class="retrieval-quiz__q">17. Sort all twelve by level, then place each in R, D, or both.</p><details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>Beginner: Measure (foundation), MCP (R), Prime (R). Intermediate: Output (R), Sub-agents (D), Architect/editor (R&amp;D). Advanced: Reset (R), Bundles (R), One purpose (R&amp;D). Agentic: System prompt (R), Primary delegation (D), Experts (R&amp;D).</p></details></div>
+        </section>
+
+        <aside class="callout callout--why"><p class="callout__label">Scoring</p><p><strong>15–17:</strong> ready to teach and design a small pipeline. <strong>11–14:</strong> rerun the checkpoint associated with each miss. <strong>0–10:</strong> rebuild the R&amp;D map, record a new baseline, and complete the beginner/intermediate checkpoints before agentic mode.</p></aside>
+
+        <h3>Capstone teach-back</h3>
+        <div class="teach-back">
+          <p>Without notes, teach a colleague for seven minutes:</p>
+          <ol><li>State R&amp;D and sort at least six techniques.</li><li>Explain the recorded fresh-window problem and both measurement tools.</li><li>Resolve the CLAUDE.md paradox and demonstrate what a prime changes.</li><li>Trace sub-agent versus primary-agent information flow.</li><li>Defend reset-and-prime without claiming compaction is universally broken.</li><li>Describe the expert plan/build/improve loop and its protected header boundary.</li><li>Resolve the final paradox: why more context-engineering effort can produce less babysitting.</li></ol>
+          <p class="fine">Expert pass: your listener can choose one Reduce move and one Delegate move for a bloated, multi-purpose agent—and can name the evidence that would prove each move worked.</p>
+        </div>
+      </section>
+
+      <section class="chapter-section" id="glossary">
+        <span class="section-number">16</span>
+        <h2 class="section-title">AH-1 glossary</h2>
+        <p class="section-lead">Use these terms narrowly enough that another engineer can inspect the corresponding course artifact or context state.</p>
+        <dl class="glossary">
+          <div><dt>R&amp;D framework</dt><dd>Reduce and Delegate—the two ways this lesson classifies context-window management.</dd></div>
+          <div><dt>Reduce</dt><dd>Remove, scope, defer, shorten, reset, or control context in the primary agent.</dd></div>
+          <div><dt>Delegate</dt><dd>Move a coherent responsibility into another focused context window and return a reduced result.</dd></div>
+          <div><dt>Focused agent</dt><dd>An agent whose context, prompt, tools, and purpose are aligned with the current job.</dd></div>
+          <div><dt>Context sweet spot</dt><dd>The useful range where the agent has sufficient relevant context without dilution by unrelated state.</dd></div>
+          <div><dt>Context bloat</dt><dd>Excess material that consumes attention without serving the agent’s purpose.</dd></div>
+          <div><dt>Context rot</dt><dd>Stale, irrelevant, or contradictory context that can actively degrade decisions.</dd></div>
+          <div><dt>Search and destroy</dt><dd>Find the right context agentically, then remove or delegate everything else.</dd></div>
+          <div><dt><code>/context</code></dt><dd>The loaded-window measurement view for system prompt, tools, MCP, agents, memory, messages, and free space.</dd></div>
+          <div><dt>Token counter</dt><dd>An editor tokenizer that estimates a file’s cost before the agent reads it.</dd></div>
+          <div><dt>Strict MCP config</dt><dd>A task-scoped server configuration loaded with <code>--mcp-config</code> and isolated from global servers using <code>--strict-mcp-config</code>.</dd></div>
+          <div><dt>Context priming</dt><dd>A named command that observes and loads a purpose-specific initial state, such as <code>/prime</code> or <code>/prime_cc</code>.</dd></div>
+          <div><dt>Output style</dt><dd>A reusable response behavior that hot-swaps the output-style block in Claude Code’s system prompt.</dd></div>
+          <div><dt>Sub-agent</dt><dd>A partially forked, system-prompt-isolated context window that performs work and reports to the primary agent.</dd></div>
+          <div><dt>Architect / editor</dt><dd>The planner/builder split: one agent explores and writes a spec; a fresh agent implements from it.</dd></div>
+          <div><dt>Reset and prime</dt><dd><code>/clear</code> followed by a named prime, producing a known loading recipe instead of an implicit compacted state.</dd></div>
+          <div><dt>Context bundle</dt><dd>An append-only per-session JSONL trail of selected prompts, reads, and writes for deduplicated replay.</dd></div>
+          <div><dt>ADW</dt><dd>AI Developer Workflow—a pipeline of single-purpose agents connected by explicit artifacts.</dd></div>
+          <div><dt>System-prompt append</dt><dd>A narrow behavioral addition made with <code>--append-system-prompt</code>, preserving Claude Code’s default system prompt.</dd></div>
+          <div><dt>Primary delegation</dt><dd>Launching a fully independent Claude Code instance with its own context, model, settings, keys, and report channel.</dd></div>
+          <div><dt>Agent expert</dt><dd>A plan/build/improve triad specialized for one codebase area and able to update its dedicated Expertise.</dd></div>
+          <div><dt>Expertise section</dt><dd>The intentionally mutable knowledge block in an expert command, kept distinct from stable Purpose, Instructions, and Workflow.</dd></div>
+          <div><dt>In-loop / out-of-loop / ZTE</dt><dd>Human present during execution / agent runs without interactive presence / zero-touch engineering target.</dd></div>
+          <div><dt>Proper token spend</dt><dd>Context expenditure that improves focus, evidence, one-shot success, and reusable execution rather than minimizing raw usage.</dd></div>
+        </dl>
+      </section>
+
+      <footer class="chapter-footer">
+        <p class="eyebrow">Volume II · Agentic Horizon</p>
+        <div class="chapter-footer__nav">
+          <a href="../vol-1-tac/08-the-agentic-layer.html">← Previous: TAC-8 · The Agentic Layer</a>
+          <a href="10-seven-levels-agentic-prompt-formats.html">Next: AH-2 · Seven Prompt Formats →</a>
+        </div>
+      </footer>
+    </main>
+  </div>
+
+  <script>
+    (() => {
+      /* Keep Technique 1 directly after orientation even in the no-build source assembly. */
+      const measure = document.getElementById('measure');
+      const mcp = document.getElementById('mcp');
+      if (measure && mcp && measure.nextElementSibling !== mcp) {
+        mcp.parentNode.insertBefore(measure, mcp);
+      }
+
+      const topBar = document.getElementById('top-progress');
+      const railBar = document.getElementById('rail-progress');
+      const label = document.getElementById('progress-label');
+      const links = [...document.querySelectorAll('.chapter-nav a')];
+      const sections = links.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
+      let progressFramePending = false;
+
+      const updateProgress = () => {
+        const max = document.documentElement.scrollHeight - window.innerHeight;
+        const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
+        const percent = `${Math.round(value * 100)}%`;
+        topBar.style.width = percent;
+        railBar.style.width = percent;
+        label.textContent = percent;
+      };
+
+      const requestProgressUpdate = () => {
+        if (progressFramePending) return;
+        progressFramePending = true;
+        requestAnimationFrame(() => {
+          updateProgress();
+          progressFramePending = false;
+        });
+      };
+
+      const observer = new IntersectionObserver(entries => {
+        const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
+        if (!visible) return;
+        links.forEach(link => {
+          const active = link.getAttribute('href') === `#${visible.target.id}`;
+          if (active) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        });
+      }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, .1, .5] });
+
+      sections.forEach(section => observer.observe(section));
+      updateProgress();
+      window.addEventListener('scroll', requestProgressUpdate, { passive: true });
+      window.addEventListener('resize', requestProgressUpdate);
+    })();
+  </script>
+</body>
+</html>

