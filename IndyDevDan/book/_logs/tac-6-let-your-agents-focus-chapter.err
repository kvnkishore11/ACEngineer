147:def resolve_review_issues(
148-    review_issues: List[ReviewIssue],
149-    spec_file: str,
150-    state: ADWState,
151-    logger: logging.Logger,
152-    issue_number: str,
153-    iteration: int = 1,
154-) -> Tuple[int, int]:
155-    """Resolve review issues by creating and implementing patch plans.
156-    Returns (resolved_count, failed_count)."""
157-
158-    resolved_count = 0
159-    failed_count = 0
160-    adw_id = state.get("adw_id")
161-
162-    # Filter to only handle blocker issues
163-    blocker_issues = [i for i in review_issues if i.issue_severity == "blocker"]
164-
165-    if not blocker_issues:
166-        logger.info("No blocker issues to resolve")
167-        return 0, 0
168-
169-    logger.info(f"Found {len(blocker_issues)} blocker issues to resolve")
170-    make_issue_comment(
171-        issue_number,
172-        format_issue_message(
173-            adw_id,
174-            "ops",
175-            f"🔧 Attempting to resolve {len(blocker_issues)} blocker issues",
176-        ),
177-    )
178-
179-    for idx, issue in enumerate(blocker_issues):
180-        logger.info(
181-            f"\n=== Resolving blocker issue {idx + 1}/{len(blocker_issues)}: Issue #{issue.review_issue_number} ==="
182-        )
183-
184-        # Create and implement patch
185-        # Prepare unique agent names with iteration and issue number for tracking
186-        agent_name_planner = f"{AGENT_REVIEW_PATCH_PLANNER}_{iteration}_{issue.review_issue_number}"
187-        agent_name_implementor = f"{AGENT_REVIEW_PATCH_IMPLEMENTOR}_{iteration}_{issue.review_issue_number}"
188-        
189-        make_issue_comment(
190-            issue_number,
191-            format_issue_message(
192-                adw_id,
193-                agent_name_planner,
194-                f"📝 Creating patch plan for issue #{issue.review_issue_number}: {issue.issue_description}",
195-            ),
196-        )
197-
198-        # Format the review change request from the issue
199-        review_change_request = f"{issue.issue_description}\n\nSuggested resolution: {issue.issue_resolution}"
200-
201-        # Prepare screenshots
202-        screenshots = issue.screenshot_path if issue.screenshot_path else None
203-
204-        # Use the shared method to create and implement patch
205-        patch_file, implement_response = create_and_implement_patch(
206-            adw_id=adw_id,
207-            review_change_request=review_change_request,
208-            logger=logger,
209-            agent_name_planner=agent_name_planner,
210-            agent_name_implementor=agent_name_implementor,
211-            spec_path=spec_file,
212-            issue_screenshots=screenshots,
213-        )
214-
215-        if not patch_file:
216-            failed_count += 1
217-            make_issue_comment(
218-                issue_number,
219-                format_issue_message(
220-                    adw_id,
221-                    agent_name_planner,
222-                    f"❌ Failed to create patch plan for issue #{issue.review_issue_number}",
223-                ),
224-            )
225-            continue
226-
227-        make_issue_comment(
228-            issue_number,
229-            format_issue_message(
230-                adw_id, agent_name_planner, f"✅ Created patch plan: {patch_file}"
231-            ),
232-        )
233-
234-        # Check implementation result
235-        if implement_response.success:
236-            resolved_count += 1
237-            make_issue_comment(
238-                issue_number,
239-                format_issue_message(
240-                    adw_id,
241-                    agent_name_implementor,
242-                    f"✅ Successfully resolved issue #{issue.review_issue_number}",
243-                ),
244-            )
245-            logger.info(f"Successfully resolved issue #{issue.review_issue_number}")
246-        else:
247-            failed_count += 1
248-            make_issue_comment(
249-                issue_number,
250-                format_issue_message(
251-                    adw_id,
252-                    agent_name_implementor,
253-                    f"❌ Failed to implement patch for issue #{issue.review_issue_number}: {implement_response.output}",
254-                ),
255-            )
256-            logger.error(
257-                f"Failed to implement patch for issue #{issue.review_issue_number}"
258-            )
259-
260-    return resolved_count, failed_count
