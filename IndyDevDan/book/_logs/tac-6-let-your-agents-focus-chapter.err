324-def format_review_comment(review_result: ReviewResult) -> str:
325-    """Format review result for GitHub issue comment."""
326-    parts = []
327-
328-    if review_result.success:
329-        parts.append("## ✅ Review Passed")
330-        parts.append("")
331-        parts.append("The implementation matches the specification.")
332-        parts.append("")
333-
334-        if review_result.screenshot_urls:
335-            parts.append("### Screenshots")
336-            parts.append("")
337-            for i, screenshot_url in enumerate(review_result.screenshot_urls):
338-                if screenshot_url:  # Only show if URL was successfully generated
339-                    filename = screenshot_url.split("/")[-1]
340-                    parts.append(f"![{filename}]({screenshot_url})")
341-            parts.append("")
342-    else:
343-        parts.append("## ❌ Review Issues Found")
344-        parts.append("")
345-        parts.append(f"Found {len(review_result.review_issues)} issues during review:")
346-        parts.append("")
347-
348-        # Group by severity
349-        blockers = [
350-            i for i in review_result.review_issues if i.issue_severity == "blocker"
351-        ]
352-        tech_debts = [
353-            i for i in review_result.review_issues if i.issue_severity == "tech_debt"
354-        ]
355-        skippables = [
356-            i for i in review_result.review_issues if i.issue_severity == "skippable"
357-        ]
358-
359-        if blockers:
360-            parts.append("### 🚨 Blockers")
361-            parts.append("")
362-            for issue in blockers:
363-                parts.append(
364-                    f"**Issue #{issue.review_issue_number}**: {issue.issue_description}"
365-                )
366-                parts.append(f"- **Resolution**: {issue.issue_resolution}")
367-                if issue.screenshot_url:
368-                    filename = issue.screenshot_url.split("/")[-1]
369-                    parts.append(f"- **Screenshot**:")
370-                    parts.append(f"  ![{filename}]({issue.screenshot_url})")
371-                parts.append("")
372-
373-        if tech_debts:
374-            parts.append("### ⚠️ Tech Debt")
375-            parts.append("")
376-            for issue in tech_debts:
377-                parts.append(
378-                    f"**Issue #{issue.review_issue_number}**: {issue.issue_description}"
379-                )
380-                parts.append(f"- **Resolution**: {issue.issue_resolution}")
381-                if issue.screenshot_url:
382-                    filename = issue.screenshot_url.split("/")[-1]
383-                    parts.append(f"- **Screenshot**:")
384-                    parts.append(f"  ![{filename}]({issue.screenshot_url})")
385-                parts.append("")
386-
387-        if skippables:
388-            parts.append("### ℹ️ Skippable")
389-            parts.append("")
390-            for issue in skippables:
391-                parts.append(
392-                    f"**Issue #{issue.review_issue_number}**: {issue.issue_description}"
393-                )
394-                parts.append(f"- **Resolution**: {issue.issue_resolution}")
395-                if issue.screenshot_url:
396-                    filename = issue.screenshot_url.split("/")[-1]
397-                    parts.append(f"- **Screenshot**:")
398-                    parts.append(f"  ![{filename}]({issue.screenshot_url})")
399-                parts.append("")
400-
401-    # Add JSON payload
402-    parts.append("### Review Data")
403-    parts.append("")
404-    parts.append("```json")
405-    parts.append(review_result.model_dump_json(indent=2))
406-    parts.append("```")
407-
408-    return "\n".join(parts)
