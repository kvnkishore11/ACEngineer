263-def upload_and_map_screenshots(
264-    review_result: ReviewResult,
265:    r2_uploader: R2Uploader,
266-    adw_id: str,
267-    state: ADWState,
268-    logger: logging.Logger,
269-) -> None:
270-    """
271-    Upload screenshots to R2 and populate URL fields in the review result.
272-    
273-    Preserves original file paths and adds public URLs in separate fields:
274-    - ReviewResult.screenshot_urls (indexed-aligned with screenshots)
275-    - ReviewIssue.screenshot_url
276-    
277-    Args:
278-        review_result: The review result containing screenshots to upload
279:        r2_uploader: R2Uploader instance
280-        adw_id: ADW workflow ID
281-        state: ADWState instance for saving screenshot URLs
282-        logger: Logger instance
283-    """
284-    # Upload screenshots to R2 if available
285-    if review_result.screenshots or any(
286-        issue.screenshot_path for issue in review_result.review_issues
287-    ):
288-        logger.info("Uploading review screenshots to R2")
289-
290-        # Collect all screenshot paths
291-        all_screenshots = list(review_result.screenshots)
292-        for review_issue in review_result.review_issues:
293-            if review_issue.screenshot_path:
294-                all_screenshots.append(review_issue.screenshot_path)
295-
296-        # Upload and get URL mapping
297-        url_mapping = r2_uploader.upload_screenshots(all_screenshots, adw_id)
298-
299-        # Populate screenshot_urls for ReviewResult (indexed-aligned with screenshots)
300-        review_result.screenshot_urls = [
301-            url_mapping.get(path, "") for path in review_result.screenshots
302-        ]
303-
304-        # Populate screenshot_url for each ReviewIssue
305-        for review_issue in review_result.review_issues:
306-            if review_issue.screenshot_path:
307-                review_issue.screenshot_url = url_mapping.get(
308-                    review_issue.screenshot_path, None
309-                )
310-
311-        logger.info(
312-            f"Screenshot upload complete - {len(url_mapping)} files processed"
313-        )
314-
315-    # Save screenshot URLs to state for documentation workflow
316-    if review_result.screenshot_urls:
317-        state.update(review_screenshots=review_result.screenshot_urls)
318-        state.save("adw_review")
319-        logger.info(
320-            f"Saved {len(review_result.screenshot_urls)} screenshot URLs to state for documentation"
321-        )
322-
