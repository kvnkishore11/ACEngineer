  font-size: 0.95rem;
  line-height: 1.45;
  color: var(--ink-muted, #475569);
  max-width: 70ch;
  margin-inline: auto;
}
.generated-plate img {
  width: 100%;
  max-width: min(100%, 1000px);
  height: auto;
  display: block;
  margin: 1rem auto;
  border-radius: 14px;
}

