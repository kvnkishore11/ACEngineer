  "what_each_does": {
    ".claude/commands/review.md": "The reviewer agent's whole brain: review work against the spec, git diff origin/main, e2e prompts as screenshot navigation guides only, 1-5 numbered screenshots into agents/{adw_id}/{agent}/review_img/ (absolute paths), severity guidelines (skippable/tech_debt/blocker with think-hard guidance), Setup section that executes prepare_app.md, and a strict raw-JSON Report contract (success only reflects blockers; screenshots ALWAYS included). Contains the './claude/commands/e2e' path typo.",
    ".claude/commands/patch.md": "Template meta prompt producing specs/patch/patch-adw-{adw_id}-{name}.md: minimal targeted plan (metadata, issue summary, files, 2-5 steps, validation from spec or test.md, scope estimate). Reads conditional_docs.md; 'Address only the review_change_request'; returns exclusively the plan path.",
    ".claude/commands/document.md": "Template meta prompt: analyze git diff origin/main (--stat/--name-only/per-file >50 lines), read spec, copy screenshots to app_docs/assets/, write app_docs/feature-{adw_id}-{descriptive-name}.md per the committed Documentation Format, THEN update conditional_docs.md with the new entry + conditions; returns exclusively the doc path.",
    ".claude/commands/conditional_docs.md": "The loop-closing lower-level prompt: instructions to read a doc ONLY if a condition matches ('you don't want to excessively read documentation'), plus the doc→conditions index. Ships with 4 entries (README.md, app/client/src/style.css, classify_adw.md, adws/README.md); the documenter appends more at runtime.",
    ".claude/commands/prepare_app.md": "Shared setup step executed inside /review (and tests): reset DB via scripts/reset_db.sh, ensure server+client run in background via nohup sh ./scripts/start.sh, stop via scripts/stop_apps.sh.",
    ".claude/commands/implement.md": "The reused higher-order prompt: 'Read the plan, think hard about the plan and implement the plan', then report a bullet summary + git diff --stat. Consumes chore/bug/feature plans AND patch plans.",
    ".claude/commands/bug.md|chore.md|feature.md": "Planning template meta prompts from TAC-3/4/5, now with the conditional-docs hook in Relevant Files: check conditional_docs.md and pull matching docs into the generated plan.",
    ".claude/commands/prime.md": "Context priming: git ls-files, README.md, adws/README.md, and conditional_docs.md 'to determine which documentation to read based on the upcoming task.'",
    ".claude/commands/install.md": "All-in-one onboarding prompt (encode your engineering for you and your team): re-init git, install FE/BE deps, copy env, reset DB, background-start the app — with the new final mention: set Cloudflare env vars if you want public review images.",
    "adws/adw_review.py": "Review phase workflow (agents: reviewer, review_patch_planner_{i}_{n}, review_patch_implementor_{i}_{n}): state-driven checkout, spec discovery, /review execution, ReviewResult parsing (failure synthesizes a blocker), R2 upload + URL mapping into the result and state, grouped GitHub report with raw JSON payload, blocker-only agentic resolution loop capped at 3 attempts, review commit, push/PR, exit 1 on unresolved blockers.",
    "adws/adw_patch.py": "Standalone patch workflow (agents: patch_planner, patch_implementor): requires 'adw_patch' keyword in latest comment or issue body, branch create-or-find, create_and_implement_patch, commit as '/patch', push/PR, final state echo.",
    "adws/adw_document.py": "Documentation phase workflow (agent: documenter): requires adw-id; no-diff → graceful skip; passes [adw_id, spec_path, screenshots_dir] to /document; commits, pushes, updates PR; saves documentation_path to state.",
    "adws/adw_plan_build_review.py": "Composer: plan → build → review (test skipped; the run Dan demos). Dumb subprocess chain sharing one adw_id.",
    "adws/adw_plan_build_document.py": "Composer: plan → build → document (skips test AND review; README warns documentation quality is limited without review screenshots).",
    "adws/adw_plan_build_test_review.py": "Composer: plan → build → test → review — 'probably the winning workflow' per the demo post-mortem.",
    "adws/adw_sdlc.py": "The complete SDLC composer: plan → build → test (--skip-e2e) → review → document.",
    "adws/adw_modules/r2_uploader.py": "Cloudflare R2 (S3-compatible boto3) uploader: silently disabled unless all four env vars present; upload_screenshots maps local paths → https://{public_domain}/adw/{adw_id}/review/{filename}; default public domain tac-public-imgs.iddagents.com.",
    "adws/adw_modules/agent.py": "Claude Code integration: SLASH_COMMAND_MODEL_MAP (per-prompt opus/sonnet routing), execute_template → claude -p with --model, --output-format stream-json, --verbose, --dangerously-skip-permissions; saves prompt + raw_output.jsonl per agent; parses the trailing result message (session_id, is_error, num_turns, total_cost_usd).",
    "adws/adw_modules/data_types.py": "Pydantic contracts: ReviewIssue (number, screenshot_path, screenshot_url, description, resolution, severity Literal), ReviewResult (success, review_summary, review_issues, screenshots, screenshot_urls), DocumentationResult, ADWStateData, AgentTemplateRequest, SlashCommand + ADWWorkflow literals. NOTE: ADWWorkflow omits adw_plan_build_review/adw_plan_build_document (see trigger_drift_bug).",
    "adws/adw_modules/workflow_ops.py": "Shared ops: agent name constants, classify_issue, build_plan, implement_plan, generate_branch_name, create_commit, create_pull_request, ensure_adw_id, create_or_find_branch, find_spec_file (state → diff → branch-pattern glob), create_and_implement_patch (validates the returned specs/patch/*.md path, then /implement), AVAILABLE_ADW_WORKFLOWS allowlist.",
    "adws/adw_modules/state.py": "ADWState: persistent agents/{adw_id}/adw_state.json, load/update/save(+phase note), to_stdout for pipe chaining.",
    ".mcp.json": "Playwright MCP server config: npx @playwright/mcp@latest --isolated --config ./playwright-mcp-config.json. No --vision flag — the course-era review agent cannot see its own screenshots.",
    "playwright-mcp-config.json": "Headless chromium at 1920x1080 with video recording to ./videos — the review agent's browser.",
    ".env.sample": "ANTHROPIC_API_KEY (required), GITHUB_PAT, CLAUDE_CODE_PATH, E2B_API_KEY, CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR, CLOUDFLARED_TUNNEL_TOKEN, and the new CLOUDFLARE_ACCOUNT_ID / R2 ACCESS_KEY_ID / SECRET / BUCKET_NAME / PUBLIC_DOMAIN block for review screenshot hosting.",
    ".claude/settings.json": "Permission allowlist (mkdir/uv/find/mv/grep/npm/ls/cp/Write/chmod/touch + copy_dot_env.sh), denials (git push --force, rm -rf), and all seven hook events wired to .claude/hooks/*.py loggers.",
    "app/": "The Natural Language SQL Interface (FastAPI + Vite/TS) — the subject codebase the agents operate on; the export feature gets built into app/client/src/main.ts + client.ts + style.css and app/server/server.py + core/.",
    "scripts/": "Deterministic support: start.sh/stop_apps.sh/reset_db.sh (used by prepare_app + install), expose_webhook.sh + kill_trigger_webhook.sh (Cloudflare tunnel for out-loop triggers), clear_issue_comments.sh, delete_pr.sh (demo-reset utilities).",
    "specs/": "Committed example plans from prior lessons' runs (e.g. issue-28 random-query, issue-222 debounce, sql-injection fix) — the spec corpus review runs against; specs/patch/ appears at runtime."
  },
  "generated_not_committed": {
    "agents/{adw_id}/": "Per-run workspace: adw_state.json plus per-agent folders (sdlc_planner, sdlc_implementor, reviewer with review_img/, patch_planner, patch_implementor, documenter, *_committer, issue_classifier, branch_generator) each holding prompts/ and raw_output.jsonl → raw_output.json.",
    "specs/patch/patch-adw-{adw_id}-{name}.md": "Patch plans created by /patch at runtime (Dan's: patch-adw-490eb6b5-fix-download-button-position.md).",
    "specs/issue-{n}-adw-{id}-sdlc_planner-{slug}.md": "The feature plan the planner writes (Dan's: issue-14-adw-490eb6b5-sdlc_planner-one-click-table-exports.md).",
    "app_docs/feature-{adw_id}-{name}.md + app_docs/assets/": "Documentation output + copied screenshots (Dan's: feature-490eb6b5-one-click-table-exports.md).",
    "conditional_docs.md fifth+ entries": "Appended agentically by the document step (committed file ships with 4 entries).",
    "logs/, videos/, agents/**": "Session logs from hooks, Playwright recordings, stream outputs."
  }
}
[
