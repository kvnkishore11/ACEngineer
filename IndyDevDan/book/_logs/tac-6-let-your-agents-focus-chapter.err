@@ -0,0 +1,260 @@
+/* TAC-6 reuses the gold chapter grammar and adds focus/review-specific systems. */
+@import url("01-hello-agentic-coding.assets.css");
+
+.hero--focus {
+  background:
+    radial-gradient(circle at 86% 8%, color-mix(in srgb, var(--accent-wash) 82%, transparent), transparent 24rem),
+    linear-gradient(145deg, var(--bg-card), color-mix(in srgb, var(--bg-card) 92%, var(--accent-wash)));
+}
+
+.hero--focus .focus-hero { margin-top: var(--space-7); }
+
+.focus-hero,
+.question-pipeline,
+.window-study,
+.agent-cast,
+.contract-map,
+.severity-board,
+.loop-system,
+.kpi-board,
+.artifact-chain,
+.practice-grid,
+.rubric-grid,
+.proof-strip {
+  display: grid;
+  gap: var(--space-3);
+  width: 100%;
+  max-width: min(100%, 68.75rem);
+  margin-inline: auto;
+}
+
+.focus-hero {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  padding: clamp(1rem, 3vw, 2.25rem);
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.focus-hero article {
+  position: relative;
+  min-height: 12rem;
+  padding: var(--space-5);
+  overflow: hidden;
+  border: 1px solid var(--border-soft);
+  border-radius: var(--radius-lg);
+  background: var(--bg-inset);
+}
+
+.focus-hero article::after {
+  position: absolute;
+  right: -1.1rem;
+  bottom: -2.6rem;
+  color: color-mix(in srgb, var(--accent) 13%, transparent);
+  content: "1";
+  font: 800 10rem/.8 var(--font-display);
+}
+
+.focus-hero strong {
+  display: block;
+  color: var(--accent-ink);
+  font: 650 clamp(1.35rem, 3vw, 2.1rem)/1.05 var(--font-display);
+}
+
+.focus-hero p { position: relative; z-index: 1; margin-top: var(--space-3); color: var(--ink-soft); }
+
+.question-pipeline { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.question-pipeline article,
+.agent-cast article,
+.severity-board article,
+.practice-grid article,
+.kpi-board article,
+.proof-strip article {
+  padding: var(--space-4);
+  border: 1px solid var(--border-soft);
+  border-radius: var(--radius-md);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.question-pipeline article { border-top: 4px solid var(--accent); }
+.question-pipeline article:nth-child(3) { border-top-color: var(--ok); }
+.question-pipeline article:nth-child(4) { background: var(--accent-wash); }
+.question-pipeline article:nth-child(5) { border-top-color: var(--ink-soft); }
+.question-pipeline b { color: var(--accent-ink); font: 700 var(--text-md) var(--font-display); }
+.question-pipeline p { margin-top: var(--space-2); font-size: var(--text-sm); }
+.question-pipeline code { display: block; margin-top: var(--space-3); font-size: var(--text-xs); }
+
+.window-study { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.85fr); align-items: stretch; }
+.window-study__polluted,
+.window-study__fresh {
+  padding: var(--space-5);
+  border-radius: var(--radius-lg);
+}
+.window-study__polluted {
+  border: 1px solid var(--warn);
+  background: var(--warn-wash);
+}
+.window-study__fresh {
+  border: 1px solid var(--ok);
+  background: var(--ok-wash);
+}
+.token-cloud { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: var(--space-4); }
+.token-cloud span {
+  padding: .3rem .55rem;
+  border: 1px solid color-mix(in srgb, var(--warn) 38%, var(--border-soft));
+  border-radius: 99px;
+  color: var(--ink-soft);
+  background: color-mix(in srgb, var(--bg-card) 65%, transparent);
+  font: var(--text-xs) var(--font-mono);
+}
+.fresh-windows { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .5rem; margin-top: var(--space-4); }
+.fresh-windows div {
+  display: grid;
+  place-items: center;
+  min-height: 6.6rem;
+  padding: .6rem;
+  border: 1px solid color-mix(in srgb, var(--ok) 45%, var(--border-soft));
+  border-radius: var(--radius-md);
+  color: var(--ink-soft);
+  background: var(--bg-card);
+  text-align: center;
+  font-size: var(--text-sm);
+}
+
+.constraint-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
+.constraint-row article { padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+.constraint-row article:nth-child(-n+2) { border-color: var(--ok); background: var(--ok-wash); }
+.constraint-row strong { display: block; color: var(--accent-ink); font-family: var(--font-display); }
+
+.agent-cast { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.agent-cast article { border-left: 4px solid var(--accent); }
+.agent-cast code { display: inline-block; margin-top: var(--space-2); }
+
+.contract-map { grid-template-columns: minmax(0, 1fr) 3.5rem minmax(0, 1fr); align-items: center; }
+.contract-map__pane { min-height: 21rem; padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-code); }
+.contract-map__pane h4 { margin: 0 0 var(--space-3); color: var(--accent-ink); }
+.contract-map__pane pre { margin: 0; border: 0; padding: 0; font-size: .78rem; white-space: pre-wrap; }
+.contract-map__arrow { color: var(--accent); text-align: center; font: 700 2rem var(--font-display); }
+
+.severity-board { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.severity-board article { border-top: 5px solid var(--ink-mute); }
+.severity-board article:nth-child(2) { border-top-color: var(--warn); }
+.severity-board article:nth-child(3) { border-top-color: var(--danger, #b42318); background: var(--warn-wash); }
+.severity-board .severity { font: 700 var(--text-md) var(--font-mono); }
+.severity-board p { margin-top: var(--space-2); }
+
+.state-card { max-width: 46rem; margin-inline: auto; }
+.state-card pre { margin: 0; }
+
+.frame-sequence { display: grid; gap: var(--space-6); }
+.chapter-main .frame-sequence {
+  width: min(68.75rem, calc(100vw - var(--rail-width) - var(--space-8) - 4rem));
+  max-width: none;
+  margin-right: 0;
+  margin-left: 50%;
+  transform: translateX(-50%);
+}
+.move > .frame-sequence { transform: translateX(calc(-50% - 1.125rem)); }
+.frame-sequence .frame-card { width: 100%; max-width: none; margin: 0; transform: none; }
+.frame-card img { object-fit: contain; }
+
+.artifact-chain { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.artifact-chain article { position: relative; padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
+.artifact-chain article:not(:last-child)::after { position: absolute; right: -.9rem; top: 45%; z-index: 2; color: var(--accent); content: "→"; font-weight: 800; }
+.artifact-chain strong { display: block; color: var(--accent-ink); }
+.artifact-chain code { display: block; margin-top: var(--space-2); font-size: var(--text-xs); overflow-wrap: anywhere; }
+
+.loop-system { grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: stretch; }
+.loop-system div {
+  position: relative;
+  display: grid;
+  align-content: center;
+  min-height: 8rem;
+  padding: var(--space-3);
+  border: var(--hairline);
+  border-radius: 50%;
+  background: var(--bg-card);
+  text-align: center;
+  font-weight: 700;
+}
+.loop-system div:not(:last-child)::after { position: absolute; right: -.8rem; color: var(--accent); content: "→"; }
+.loop-system div:last-child { border: 2px solid var(--accent); background: var(--accent-wash); }
+
+.kpi-board { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.kpi-board article { border-top: 4px solid var(--accent); }
+.kpi-board .kpi-value { display: block; margin: var(--space-2) 0; color: var(--accent-ink); font: 700 clamp(1.8rem, 4vw, 3rem)/1 var(--font-display); }
+.kpi-board small { color: var(--ink-mute); }
+
+.proof-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.proof-strip article { border-left: 4px solid var(--ok); }
+
+.practice-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.practice-grid article { display: flex; flex-direction: column; }
+.practice-grid a { margin-top: auto; padding-top: var(--space-3); font-weight: 700; }
+.practice-grid .video-id { color: var(--ink-mute); font: var(--text-xs) var(--font-mono); }
+
+.command-card { padding: var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-code); }
+.command-card code { display: block; border: 0; padding: 0; overflow-wrap: anywhere; }
+
+.rubric-grid { grid-template-columns: 1.35fr repeat(3, minmax(8rem, .75fr)); overflow: hidden; gap: 0; border: var(--hairline); border-radius: var(--radius-lg); background: var(--bg-card); }
+.rubric-grid > div { padding: var(--space-3); border-right: var(--hairline); border-bottom: var(--hairline); }
+.rubric-grid .rubric-head { color: var(--accent-ink); background: var(--accent-wash); font-weight: 750; }
+
+.source-note { padding: var(--space-4); border-left: 4px solid var(--ink-mute); background: var(--bg-inset); color: var(--ink-soft); font-size: var(--text-sm); }
+.source-note code { font-size: .84em; }
+
+.lab-checklist { list-style: none; padding: 0; }
+.lab-checklist li { position: relative; padding-left: 2rem; }
+.lab-checklist li::before { position: absolute; left: 0; content: "□"; color: var(--accent-ink); font: 700 1.25rem var(--font-mono); }
+
+.teach-back ol { margin-top: var(--space-3); }
+
+@media (max-width: 65rem) {
+  .question-pipeline,
+  .fresh-windows,
+  .loop-system { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .artifact-chain { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .artifact-chain article::after { display: none; }
+  .chapter-main .frame-sequence { width: min(68.75rem, calc(100vw - 2rem)); }
+}
+
+@media (max-width: 50rem) {
+  .focus-hero,
+  .window-study,
+  .agent-cast,
+  .severity-board,
+  .kpi-board,
+  .proof-strip,
+  .practice-grid,
+  .constraint-row { grid-template-columns: 1fr; }
+  .question-pipeline,
+  .fresh-windows,
+  .loop-system,
+  .artifact-chain { grid-template-columns: 1fr; }
+  .contract-map { grid-template-columns: 1fr; }
+  .contract-map__arrow { transform: rotate(90deg); }
+  .loop-system div { min-height: 5rem; border-radius: var(--radius-lg); }
+  .loop-system div::after { display: none; }
+  .rubric-grid { grid-template-columns: 1fr; }
+  .rubric-grid > div { border-right: 0; }
+  .move > .frame-sequence { transform: translateX(calc(-50% - .875rem)); }
+}
+
+@media print {
+  .focus-hero,
+  .question-pipeline,
+  .agent-cast,
+  .severity-board,
+  .kpi-board,
+  .proof-strip { grid-template-columns: repeat(2, 1fr); }
+  .window-study,
+  .contract-map,
+  .practice-grid { break-inside: avoid; }
+  .chapter-main .frame-sequence,
+  .move > .frame-sequence { width: 100%; margin-left: 0; transform: none; }
+  .frame-card { break-inside: avoid; }
+  details > * { display: block !important; }
+  details > summary { display: list-item !important; }
+}
