411:def main():
412-    """Main entry point."""
413-    # Load environment variables
414-    load_dotenv()
415-
416-    # Check for --skip-resolution flag
417-    skip_resolution = "--skip-resolution" in sys.argv
418-    if skip_resolution:
419-        sys.argv.remove("--skip-resolution")
420-
421-    # Parse command line args
422-    # adw-id is REQUIRED for review to find the correct state and spec
423-    if len(sys.argv) < 3:
424-        print("Usage: uv run adw_review.py <issue-number> <adw-id> [--skip-resolution]")
425-        print("\nError: adw-id is required to locate the spec file and state")
426-        sys.exit(1)
427-
428-    issue_number = sys.argv[1]
429-    adw_id = sys.argv[2]
430-
431-    # Try to load existing state
432-    temp_logger = setup_logger(adw_id, "adw_review")
433-    state = ADWState.load(adw_id, temp_logger)
434-    if state:
435-        # Found existing state
436-        issue_number = state.get("issue_number", issue_number)
437-        make_issue_comment(
438-            issue_number,
439-            f"{adw_id}_ops: 🔍 Found existing state - starting review\n```json\n{json.dumps(state.data, indent=2)}\n```",
440-        )
441-    else:
442-        # No existing state found
443-        logger = setup_logger(adw_id, "adw_review")
444-        logger.error(f"No state found for ADW ID: {adw_id}")
445-        logger.error("Run adw_plan.py first to create the state")
446-        print(f"\nError: No state found for ADW ID: {adw_id}")
447-        print("Run adw_plan.py first to create the state")
448-        sys.exit(1)
449-
450-    # Set up logger with ADW ID from command line
451-    logger = setup_logger(adw_id, "adw_review")
452-    logger.info(f"ADW Review starting - ID: {adw_id}, Issue: {issue_number}")
453-
454-    # Validate environment
455-    check_env_vars(logger)
456-
457-    # Get repo information
458-    try:
459-        github_repo_url = get_repo_url()
460-        repo_path = extract_repo_path(github_repo_url)
461-    except ValueError as e:
462-        logger.error(f"Error getting repository URL: {e}")
463-        sys.exit(1)
464-
465-    # Ensure we have required state fields
466-    if not state.get("branch_name"):
467-        error_msg = "No branch name in state - run adw_plan.py first"
468-        logger.error(error_msg)
469-        make_issue_comment(
470-            issue_number, format_issue_message(adw_id, "ops", f"❌ {error_msg}")
471-        )
472-        sys.exit(1)
473-
474-    # Checkout the branch from state
475-    branch_name = state.get("branch_name")
476-    result = subprocess.run(
477-        ["git", "checkout", branch_name], capture_output=True, text=True
478-    )
479-    if result.returncode != 0:
480-        logger.error(f"Failed to checkout branch {branch_name}: {result.stderr}")
481-        make_issue_comment(
482-            issue_number,
483-            format_issue_message(
484-                adw_id, "ops", f"❌ Failed to checkout branch {branch_name}"
485-            ),
486-        )
487-        sys.exit(1)
488-    logger.info(f"Checked out branch: {branch_name}")
489-
490-    make_issue_comment(
491-        issue_number, format_issue_message(adw_id, "ops", "✅ Starting review phase")
492-    )
493-
494-    # Find the spec file
495-    spec_file = find_spec_file(state, logger)
496-    if not spec_file:
497-        error_msg = "Could not find spec file for review"
498-        logger.error(error_msg)
499-        make_issue_comment(
500-            issue_number, format_issue_message(adw_id, "ops", f"❌ {error_msg}")
501-        )
502-        sys.exit(1)
503-
504-    logger.info(f"Using spec file: {spec_file}")
505-    make_issue_comment(
506-        issue_number,
507-        format_issue_message(adw_id, "ops", f"✅ Found spec file: {spec_file}"),
508-    )
509-
510-    # Initialize R2 uploader
511:    r2_uploader = R2Uploader(logger)
512-
513-    # Run review with resolution retry loop
514-    attempt = 0
515:    max_attempts = MAX_REVIEW_RETRY_ATTEMPTS if not skip_resolution else 1
516-
517-    while attempt < max_attempts:
518-        attempt += 1
519-        logger.info(f"\n=== Review Attempt {attempt}/{max_attempts} ===")
520-
521-        # Run the review
522-        logger.info("Running review against specification")
523-        make_issue_comment(
524-            issue_number,
525-            format_issue_message(
526-                adw_id,
527-                AGENT_REVIEWER,
528-                f"✅ Reviewing implementation against specification (attempt {attempt}/{max_attempts})",
529-            ),
530-        )
531-
532-        review_result = run_review(spec_file, adw_id, logger)
533-
534-        # Upload screenshots and update URLs
535-        upload_and_map_screenshots(review_result, r2_uploader, adw_id, state, logger)
536-
537-        # Format and post review results
538-        review_comment = format_review_comment(review_result)
539-        make_issue_comment(
540-            issue_number, format_issue_message(adw_id, AGENT_REVIEWER, review_comment)
541-        )
542-
543-        # Log summary
544-        if review_result.success:
545-            logger.info(
546-                "Review passed - implementation matches specification (no blocking issues)"
547-            )
548-            break
549-        else:
550-            blocker_count = sum(
551-                1 for i in review_result.review_issues if i.issue_severity == "blocker"
552-            )
553-            logger.warning(
554-                f"Review found {len(review_result.review_issues)} issues ({blocker_count} blockers)"
555-            )
556-
557-            # If this is the last attempt or no blockers or resolution is skipped, stop
558-            if attempt == max_attempts or blocker_count == 0 or skip_resolution:
559-                if skip_resolution and blocker_count > 0:
560-                    logger.info(
561-                        f"Skipping resolution workflow for {blocker_count} blocker issues (--skip-resolution flag set)"
562-                    )
563-                    make_issue_comment(
564-                        issue_number,
565-                        format_issue_message(
566-                            adw_id,
567-                            "ops",
568-                            f"⚠️ Skipping resolution for {blocker_count} blocker issues",
569-                        ),
570-                    )
571-                break
572-
573-            # Resolution workflow
574-            logger.info("\n=== Starting resolution workflow ===")
575-            make_issue_comment(
576-                issue_number,
577-                format_issue_message(
578-                    adw_id,
579-                    "ops",
580-                    f"🔧 Starting resolution workflow for {blocker_count} blocker issues",
581-                ),
582-            )
583-
584-            # Resolve the issues
585:            resolved_count, failed_count = resolve_review_issues(
586-                review_result.review_issues,
587-                spec_file,
588-                state,
589-                logger,
590-                issue_number,
591-                iteration=attempt,
592-            )
593-
594-            # Report resolution results
595-            if resolved_count > 0:
596-                make_issue_comment(
597-                    issue_number,
598-                    format_issue_message(
599-                        adw_id,
600-                        "ops",
601-                        f"✅ Resolution complete: {resolved_count} issues resolved, {failed_count} failed",
602-                    ),
603-                )
604-
605-                # Commit the resolution changes
606-                logger.info("Committing resolution changes")
607-                review_issue = fetch_issue(issue_number, repo_path)
608-                issue_command = state.get("issue_class", "/chore")
609-
610-                # Use a generic review patch implementor name for the commit
611-                commit_msg, error = create_commit(
612-                    AGENT_REVIEW_PATCH_IMPLEMENTOR, review_issue, issue_command, adw_id, logger
613-                )
614-
615-                if not error:
616-                    success, error = commit_changes(commit_msg)
617-                    if success:
618-                        logger.info(f"Committed resolution: {commit_msg}")
619-                        make_issue_comment(
620-                            issue_number,
621-                            format_issue_message(
622-                                adw_id,
623-                                AGENT_REVIEW_PATCH_IMPLEMENTOR,
624-                                "✅ Resolution changes committed",
625-                            ),
626-                        )
627-                    else:
628-                        logger.error(f"Error committing resolution: {error}")
629-                        make_issue_comment(
630-                            issue_number,
631-                            format_issue_message(
632-                                adw_id,
633-                                AGENT_REVIEW_PATCH_IMPLEMENTOR,
634-                                f"❌ Error committing resolution: {error}",
635-                            ),
636-                        )
637-
638-                # Continue to next iteration to re-review
639-                logger.info(
640-                    f"\n=== Preparing for re-review after resolving {resolved_count} issues ==="
641-                )
642-                make_issue_comment(
643-                    issue_number,
644-                    format_issue_message(
645-                        adw_id,
646-                        AGENT_REVIEWER,
647-                        f"🔄 Re-running review (attempt {attempt + 1}/{max_attempts})...",
648-                    ),
649-                )
650-            else:
651-                # No issues were resolved, no point in retrying
652-                logger.info("No issues were resolved, stopping retry attempts")
653-                make_issue_comment(
654-                    issue_number,
655-                    format_issue_message(
656-                        adw_id,
657-                        "ops",
658-                        f"❌ Resolution failed: Could not resolve any of the {blocker_count} blocker issues",
659-                    ),
660-                )
661-                break
662-
663-    # Log final attempt status
664-    if attempt == max_attempts and not review_result.success:
665-        blocker_count = sum(
666-            1 for i in review_result.review_issues if i.issue_severity == "blocker"
667-        )
668-        if blocker_count > 0:
669-            logger.warning(
