90-def run_review(
91-    spec_file: str,
92-    adw_id: str,
93-    logger: logging.Logger,
94-) -> ReviewResult:
95-    """Run the review using the /review command."""
96-    request = AgentTemplateRequest(
97-        agent_name=AGENT_REVIEWER,
98-        slash_command="/review",
99-        args=[adw_id, spec_file, AGENT_REVIEWER],
100-        adw_id=adw_id,
101-    )
102-
103-    logger.debug(f"Review request: {request.model_dump_json(indent=2, by_alias=True)}")
104-
105-    response = execute_template(request)
106-
107-    logger.debug(
108-        f"Review response: {response.model_dump_json(indent=2, by_alias=True)}"
109-    )
110-
111-    if not response.success:
112-        logger.error(f"Error running review: {response.output}")
113-        # Return a failed review result
114-        return ReviewResult(
115-            success=False,
116-            review_issues=[
117-                ReviewIssue(
118-                    review_issue_number=1,
119-                    screenshot_path="",
120-                    issue_description=f"Review execution failed: {response.output}",
121-                    issue_resolution="Fix the review execution error",
122-                    issue_severity="blocker",
123-                )
124-            ],
125-        )
126-
127-    # Parse the review result
128-    try:
129-        result = parse_json(response.output, ReviewResult)
130-        return result
131-    except Exception as e:
132-        logger.error(f"Error parsing review result: {e}")
133-        return ReviewResult(
134-            success=False,
135-            review_issues=[
136-                ReviewIssue(
137-                    review_issue_number=1,
138-                    screenshot_path="",
139-                    issue_description=f"Failed to parse review result: {str(e)}",
140-                    issue_resolution="Fix the review output format",
141-                    issue_severity="blocker",
142-                )
143-            ],
144-        )
