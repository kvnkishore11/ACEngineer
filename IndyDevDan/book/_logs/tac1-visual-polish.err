.move {
  position: relative;
  margin-top: var(--space-6);
  padding-left: 2.25rem;
}

.move::before {
  position: absolute;
  top: .45rem;
  left: .2rem;
  width: .72rem;
  height: .72rem;
  border: 2px solid currentColor;
  border-radius: 50%;
  content: "";
}

.move::after {
  position: absolute;
  top: 1.55rem;
  bottom: -1.7rem;
  left: .54rem;
  width: 1px;
  background: var(--border);
  content: "";
}

.move:last-child::after { display: none; }
.move--hook { color: var(--step-hook); }
.move--picture { color: var(--step-picture); }
.move--story { color: var(--step-story); }
.move--name { color: var(--step-name); }
.move--example { color: var(--step-example); }
.move--try { color: var(--step-try); }
.move--fail { color: var(--step-fail); }
.move--current { color: var(--step-current); }
.move--check { color: var(--step-check); }
.move--teach { color: var(--step-teach); }

.move > *:not(.move-label) { color: var(--ink); }
.move-label { color: currentColor; }
.move h3 { margin-top: var(--space-2); color: var(--ink); }
.move p + p,
.move p + ul,
.move p + ol,
.move ul + p,
.move ol + p,
.move pre,
.move figure,
.move aside,
.move .comparison,
.move .retrieval-quiz,
.move .workflow,
.move .file-map { margin-top: var(--space-4); }

.concept-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-3);
  margin-top: var(--space-5);
}

.concept-strip__item {
  min-height: 8rem;
  padding: var(--space-4);
  border: var(--hairline);
  border-radius: var(--radius-md);
  background: var(--bg-card);
}

.concept-strip__item b {
  display: block;
  margin-bottom: var(--space-2);
  font-family: var(--font-display);
  font-size: var(--text-md);
}

.concept-strip__item--new {
  border-color: var(--accent);
  background: var(--accent-wash);
}

.comparison {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-4);
}

.comparison__card {
  overflow: hidden;
  border: var(--hairline);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
}

.comparison__head {
  padding: var(--space-4);
  border-bottom: var(--hairline);
}

.comparison__head h3 { margin: 0; }
.comparison__head p { margin-top: var(--space-2); color: var(--ink-soft); }
.comparison__body { padding: var(--space-4); }
.comparison__card--agentic { border-color: var(--accent); box-shadow: var(--shadow-card); }

.workflow {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--space-2);
  padding: var(--space-5);
  border: var(--hairline);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
}

.workflow--stacked { grid-template-columns: 1fr; }
.workflow--spaced { margin-top: var(--space-4); }

.workflow__step {
  position: relative;
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--bg-inset);
  text-align: center;
}

.workflow__step:not(:last-child)::after {
  position: absolute;
  top: 50%;
  right: -.72rem;
  z-index: 2;
  color: var(--accent);
  content: "→";
  font-weight: 800;
  transform: translateY(-50%);
}

.workflow__step code {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--text-xs);
}

.core-four {
  position: relative;
  display: grid;
  grid-template-columns: repeat(2, minmax(10rem, 1fr));
  gap: var(--space-3);
  max-width: 36rem;
  margin-inline: auto;
}

.core-four__cell {
  min-height: 11rem;
  padding: var(--space-5);
  border: 2px solid var(--border);
  border-radius: 45% 55% 50% 50%;
  background: color-mix(in srgb, var(--bg-card) 88%, var(--bg-inset));
}

.core-four__cell b {
  display: block;
  margin-bottom: var(--space-2);
