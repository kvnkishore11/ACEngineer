 .frame-grid {
   display: grid;
-  grid-template-columns: repeat(2, minmax(0, 1fr));
-  gap: var(--space-4);
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--space-6);
+}
+
+.chapter-main .frame-card,
+.chapter-main .diagram,
+.chapter-main .generated-plate,
+.chapter-main .frame-grid {
+  width: min(68.75rem, calc(100vw - var(--rail-width) - var(--space-8) - 4rem));
