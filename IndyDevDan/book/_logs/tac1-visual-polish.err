  font-family: var(--font-display);
  font-size: var(--text-lg);
}

.core-four__cell--tools {
  border-color: var(--accent);
  background: var(--accent-wash);
}

.core-four__plus {
  position: absolute;
  top: 50%;
  left: 50%;
