}

.lab-box { scroll-margin-top: 5.5rem; }
.lab-box + .lab-box { margin-top: var(--space-5); }
.lab-box__meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: var(--space-3) 0 var(--space-4);
  padding: 0;
  list-style: none;
}

.lab-box__meta li {
  padding: .15rem .55rem;
