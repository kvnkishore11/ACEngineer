@@ -548,12 +548,76 @@
 
 .frame-grid {
   display: grid;
-  grid-template-columns: repeat(2, minmax(0, 1fr));
-  gap: var(--space-4);
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--space-6);
 }
 
-.frame-grid .frame-card { margin: 0; }
+.chapter-main .frame-card,
+.chapter-main .diagram,
+.chapter-main .generated-plate,
+.chapter-main .frame-grid {
+  width: min(68.75rem, calc(100vw - var(--rail-width) - var(--space-8) - 4rem));
+  max-width: none;
+  margin-right: 0;
+  margin-left: 50%;
+  transform: translateX(-50%);
+}
 
+.frame-grid .frame-card {
+  width: 100%;
+  max-width: none;
+  margin: 0;
+  transform: none;
+}
+
+.chapter-main .frame-card img,
+.chapter-main .diagram svg,
+.chapter-main .generated-plate img {
+  width: 100%;
+  max-width: none;
+  height: auto;
+}
+
+.chapter-main .frame-card figcaption,
+.chapter-main .diagram figcaption,
+.chapter-main .generated-plate figcaption {
+  max-width: 74ch;
+  margin-inline: auto;
+  color: var(--ink-soft);
+  font-size: 1rem;
+  line-height: 1.55;
+}
+
+.generated-plate {
+  overflow: hidden;
+  border: var(--hairline);
+  border-radius: var(--radius-lg);
+  background: var(--bg-card);
+  box-shadow: var(--shadow-card);
+}
+
+.chapter-section > .generated-plate {
+  margin-top: var(--space-6);
+}
+
+.generated-plate img {
+  margin: 0;
+  border-radius: 0;
+  background: var(--bg-card);
+}
+
+.generated-plate figcaption {
+  padding: var(--space-3) var(--space-5) var(--space-4);
+}
+
+.hero .generated-plate--hero {
+  width: min(46rem, 100%);
+  margin-top: var(--space-8);
+  margin-right: auto;
+  margin-left: auto;
+  transform: none;
+}
+
 .image-note {
   margin-top: var(--space-2);
   color: var(--ink-mute);
@@ -705,6 +769,13 @@
   .mobile-toc details { padding: var(--space-3) var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
   .mobile-toc summary { cursor: pointer; font-weight: 700; }
   .mobile-toc ol { margin-top: var(--space-3); }
+  .chapter-main .frame-card,
+  .chapter-main .diagram,
+  .chapter-main .generated-plate,
+  .chapter-main .frame-grid {
+    width: min(68.75rem, calc(100vw - 2rem));
+  }
+  .hero .generated-plate--hero { width: min(46rem, 100%); }
 }
 
