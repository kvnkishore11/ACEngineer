/* ============================================================
   IndyDevDan Expert Book — base: reset + prose defaults
   Requires tokens.css loaded first.
   ============================================================ */

*, *::before, *::after { box-sizing: border-box; }

* { margin: 0; }

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-body);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

img, svg, video { display: block; max-width: 100%; height: auto; }

::selection { background: var(--accent-wash); color: var(--ink); }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 2px;
}

/* ---------- prose ---------- */

.prose {
  max-width: var(--content-max);
  margin-inline: auto;
  padding-inline: var(--space-4);
}

.prose > * + * { margin-top: var(--space-4); }

h1, h2, h3 {
  font-family: var(--font-display);
  font-weight: 600;
  line-height: var(--leading-tight);
  letter-spacing: -0.01em;
  text-wrap: balance;
}

h1 { font-size: var(--text-2xl); margin-top: var(--space-8); }
h2 { font-size: var(--text-xl);  margin-top: var(--space-8); }
h3 { font-size: var(--text-lg);  margin-top: var(--space-6); line-height: var(--leading-snug); }
h4 { font-size: var(--text-md);  margin-top: var(--space-5); line-height: var(--leading-snug); font-weight: 650; }

p, li { max-width: var(--measure); }

ul, ol { padding-left: 1.4em; }
li + li { margin-top: var(--space-2); }

a {
  color: var(--accent-ink);
  text-decoration: underline;
  text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  text-underline-offset: 0.15em;
}
a:hover { color: var(--accent); text-decoration-color: var(--accent); }

strong { font-weight: 650; }

blockquote {
  border-left: 3px solid var(--accent);
  padding: var(--space-2) var(--space-4);
  color: var(--ink-soft);
  font-style: italic;
}
blockquote cite { display: block; margin-top: var(--space-2); font-style: normal; font-size: var(--text-sm); color: var(--ink-mute); }

hr { border: 0; border-top: var(--hairline); margin-block: var(--space-8); }

/* ---------- code ---------- */

code, kbd, samp, pre {
  font-family: var(--font-mono);
  font-size: 0.9em;
}

code {
  background: var(--bg-code);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-sm);
  padding: 0.1em 0.35em;
}

pre {
  background: var(--bg-code);
  border: var(--hairline);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  overflow-x: auto;
  line-height: 1.5;
}
pre code { background: none; border: 0; padding: 0; font-size: var(--text-sm); }

/* ---------- tables ---------- */

table {
  border-collapse: collapse;
  width: 100%;
  font-size: var(--text-sm);
}
th, td {
  text-align: left;
  padding: var(--space-2) var(--space-3);
  border-bottom: var(--hairline);
  vertical-align: top;
}
th { font-weight: 650; color: var(--ink-soft); }
tbody tr:nth-child(even) { background: var(--bg-inset); }

/* ---------- small print ---------- */

figcaption, .fine { font-size: var(--text-sm); color: var(--ink-mute); }

