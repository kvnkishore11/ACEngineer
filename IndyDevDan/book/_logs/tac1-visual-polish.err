/* ============================================================
   IndyDevDan Expert Book — component stubs
   Contracts for the chapter builder. Each block documents its
   expected markup. Visual detail intentionally minimal — extend
   here, never inline in chapters.
   Requires tokens.css + base.css.
   ============================================================ */

/* ---------- callout ------------------------------------------------
   <aside class="callout callout--tactic|--term|--warning|--why">
     <p class="callout__label">Tactic #1</p>
     <p>…</p>
   </aside>
-------------------------------------------------------------------- */
.callout {
  background: var(--bg-card);
  border: var(--hairline);
  border-left: 4px solid var(--accent);
  border-radius: var(--radius-md);
  padding: var(--space-4) var(--space-5);
  box-shadow: var(--shadow-card);
}
.callout__label {
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-ink);
  margin-bottom: var(--space-2);
}
.callout--tactic  { background: var(--accent-wash); }
.callout--term    { border-left-color: var(--ink-soft); }   /* "Dan's term" definitions */
.callout--term .callout__label { color: var(--ink-soft); }
.callout--warning { border-left-color: var(--warn); background: var(--warn-wash); }
.callout--warning .callout__label { color: var(--warn); }
.callout--why     { border-left-color: var(--ok); }         /* "why this matters" asides */
.callout--why .callout__label { color: var(--ok); }

/* ---------- diagram -------------------------------------------------
   <figure class="diagram">
     <div class="diagram__canvas"> …inline SVG or structured HTML… </div>
     <figcaption>…</figcaption>
   </figure>
   Used when a redrawn diagram beats a video frame (frame_plan.diagram_instead).
-------------------------------------------------------------------- */
.diagram {
  max-width: var(--wide-max);
  margin-inline: auto;
}
.diagram__canvas {
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
}
.diagram figcaption { margin-top: var(--space-2); text-align: center; }

/* ---------- frame-card ----------------------------------------------
   <figure class="frame-card">
     <img src="../media/frames/tac-1/t0845-core-four.jpg" alt="…">
     <figcaption><span class="frame-card__t">14:05</span> …why this frame matters…</figcaption>
   </figure>
-------------------------------------------------------------------- */
.frame-card {
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  max-width: var(--wide-max);
  margin-inline: auto;
}
.frame-card img { width: 100%; }
.frame-card figcaption { padding: var(--space-3) var(--space-4); }
.frame-card__t {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--accent-ink);
  background: var(--accent-wash);
  border-radius: var(--radius-sm);
  padding: 0.1em 0.5em;
  margin-right: var(--space-2);
}

/* ---------- lab-box --------------------------------------------------
   <section class="lab-box">
     <h3 class="lab-box__title">Lab 1.1 — Reproduce Dan</h3>
     <ol class="lab-box__steps">…</ol>
     <div class="lab-box__pass"><h4>Pass criteria</h4><ul>…</ul></div>
   </section>
-------------------------------------------------------------------- */
.lab-box {
  background: var(--bg-inset);
  border: var(--hairline);
  border-radius: var(--radius-md);
  padding: var(--space-5);
}
.lab-box__title { margin-top: 0; }
.lab-box__pass {
  margin-top: var(--space-4);
  background: var(--bg-card);
  border-left: 4px solid var(--ok);
  border-radius: var(--radius-sm);
  padding: var(--space-3) var(--space-4);
}

/* ---------- retrieval-quiz -------------------------------------------
   <section class="retrieval-quiz">
     <div class="retrieval-quiz__item">
       <p class="retrieval-quiz__q">Q. …</p>
       <details class="retrieval-quiz__a"><summary>Reveal answer</summary><p>…</p></details>
     </div>
   </section>
-------------------------------------------------------------------- */
.retrieval-quiz {
  border: var(--hairline);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  padding: var(--space-5);
}
.retrieval-quiz__item + .retrieval-quiz__item {
  margin-top: var(--space-4);
  border-top: 1px solid var(--border-soft);
  padding-top: var(--space-4);
}
.retrieval-quiz__q { font-weight: 650; }
.retrieval-quiz__a summary {
  cursor: pointer;
  color: var(--accent-ink);
  font-size: var(--text-sm);
  margin-top: var(--space-2);
}
.retrieval-quiz__a[open] summary { color: var(--ink-mute); }
.retrieval-quiz__a p {
  margin-top: var(--space-2);
  background: var(--ok-wash);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
}

/* ---------- current-practice ------------------------------------------
   "What changed since the course" overlay blocks.
   <aside class="current-practice">
     <p class="current-practice__label">Current practice · 2026</p>
     <p>…gap + what to do today…</p>
     <p class="current-practice__source">Overlay: <a href="…">RAW Agentic Coding: ZERO to Agent SKILL</a></p>
   </aside>
-------------------------------------------------------------------- */
.current-practice {
  border: 1px dashed var(--accent);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  padding: var(--space-4) var(--space-5);
}
.current-practice__label {
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-ink);
  margin-bottom: var(--space-2);
}
.current-practice__source { font-size: var(--text-sm); color: var(--ink-mute); margin-top: var(--space-3); }


/* Fan-out: large readable teaching frames */
.frame-card,
.figure-frame,
figure.teaching-frame {
