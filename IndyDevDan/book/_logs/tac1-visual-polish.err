}

.terminal__dot { width: .65rem; height: .65rem; border-radius: 50%; background: var(--terminal-dot); }
.terminal pre { margin: 0; border: 0; border-radius: 0; color: inherit; background: transparent; }

.frame-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-4);
}

.frame-grid .frame-card { margin: 0; }

.image-note {
  margin-top: var(--space-2);
