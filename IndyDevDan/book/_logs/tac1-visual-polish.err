}

.terminal {
  overflow: hidden;
  border: 1px solid var(--terminal-border);
  border-radius: var(--radius-lg);
  background: var(--terminal-bg);
  color: var(--terminal-ink);
  box-shadow: var(--shadow-card);
}

.terminal__bar {
