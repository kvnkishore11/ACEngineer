/* ============================================================
   IndyDevDan Expert Book — design tokens (light teaching theme)
   Single source of truth. Chapters must consume these variables;
   no ad-hoc colors or type sizes in chapter HTML.
   Skeleton only — extend via new tokens, don't fork values inline.
   ============================================================ */

:root {
  /* ---------- color: surfaces (warm cream, no heavy dark mode) ---------- */
  --bg:          #FAF6EF;   /* page — warm off-white cream */
  --bg-card:     #FFFFFF;   /* raised cards, code frames */
  --bg-inset:    #F1EAE0;   /* wells, quiz bodies, table stripes */
  --bg-code:     #F6F1E8;   /* code blocks (slightly warmer than card) */
  --border:      #E2D9CA;   /* hairline card borders */
  --border-soft: #EDE6D9;   /* subtle dividers */

  /* ---------- color: ink ---------- */
  --ink:         #211E19;   /* primary text — warm near-black */
  --ink-soft:    #4C463C;   /* secondary text, captions */
  --ink-mute:    #85796A;   /* metadata, labels, timestamps */

  /* ---------- color: the one accent ---------- */
  --accent:       #B4530A;  /* tactical clay-orange — links, highlights, tactic marks */
  --accent-ink:   #8A3F06;  /* accent on cream at small sizes (AA) */
  --accent-wash:  #F7E7D8;  /* accent tint for callout fills / selection */

  /* functional colors (quiz feedback + danger callouts only — not brand) */
  --ok:          #3D7A4E;
  --ok-wash:     #E4EFE6;
  --warn:        #A33D2E;
  --warn-wash:   #F6E4E0;

  /* chapter illustration + terminal surfaces */
  --ink-inverse:     #FFFFFF;
  --teach-wash:      #ECE3F4;
  --terminal-border: #D3C9BA;
  --terminal-bg:     #27231F;
  --terminal-ink:    #F5EFE7;
  --terminal-bar:    #39332D;
  --terminal-dot:    #D7C6AE;

  /* ---------- type ---------- */
  /* Display webfont is OPTIONAL. If Fraunces is self-hosted later, add the
     @font-face in base.css; these stacks degrade cleanly without it. */
  --font-display: "Fraunces", "Iowan Old Style", Georgia, "Times New Roman", serif;
  --font-body:    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono:    ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;

  /* type scale (1.25 ratio on 1rem=16px base; print-friendly) */
  --text-xs:   0.75rem;    /* 12 — fine print, frame credits */
  --text-sm:   0.875rem;   /* 14 — captions, labels, code */
  --text-base: 1.0625rem;  /* 17 — body prose */
  --text-md:   1.25rem;    /* 20 — lead paragraphs, h4 */
  --text-lg:   1.5625rem;  /* 25 — h3 */
  --text-xl:   1.9375rem;  /* 31 — h2 */
  --text-2xl:  2.4375rem;  /* 39 — h1 / chapter titles */
  --text-3xl:  3.0625rem;  /* 49 — volume covers only */
  --text-diagram-sm: 1rem;
  --text-diagram-md: 1.125rem;
  --text-diagram-lg: 1.25rem;
  --text-diagram-xl: 1.6875rem;
  --text-diagram-2xl: 1.9375rem;
  --text-print: 10.5pt;

  --leading-tight: 1.15;   /* display headings */
  --leading-snug:  1.35;   /* h3/h4, quiz options */
  --leading-body:  1.65;   /* prose */

  --measure: 66ch;         /* max prose line length */

  /* ---------- spacing (4px base) ---------- */
  --space-1:  0.25rem;
  --space-2:  0.5rem;
  --space-3:  0.75rem;
  --space-4:  1rem;
  --space-5:  1.5rem;
  --space-6:  2rem;
  --space-8:  3rem;
  --space-10: 4rem;
  --space-12: 6rem;

  /* ---------- shape & elevation ---------- */
  --radius-sm: 6px;        /* inline chips, quiz options */
  --radius-md: 10px;       /* callouts, lab boxes */
  --radius-lg: 16px;       /* frame cards, diagrams */
