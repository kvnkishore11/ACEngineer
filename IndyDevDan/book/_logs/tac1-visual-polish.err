  border-radius: 50%;
  color: var(--ink-inverse);
  background: var(--accent);
  font: 800 var(--text-lg)/1 var(--font-body);
  transform: translate(-50%, -50%);
}

.file-map {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.file-map__item {
  padding: var(--space-4);
  border: var(--hairline);
