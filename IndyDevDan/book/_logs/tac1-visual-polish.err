}

.checkpoint strong { color: var(--accent-ink); }

.teach-back {
  padding: var(--space-5);
  border: 2px solid color-mix(in srgb, var(--step-teach) 70%, var(--border));
  border-radius: var(--radius-lg);
  background: color-mix(in srgb, var(--bg-card) 84%, var(--teach-wash));
}

.teach-back p + p { margin-top: var(--space-3); }

.video-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.video-cards--single { grid-template-columns: minmax(0, 1fr); }

.video-card {
  display: flex;
  flex-direction: column;
  min-height: 12rem;
  padding: var(--space-4);
  border: var(--hairline);
  border-radius: var(--radius-md);
  color: var(--ink);
  background: var(--bg-card);
  text-decoration: none;
  box-shadow: var(--shadow-card);
}

.video-card:hover { border-color: var(--accent); }
.video-card__type { color: var(--accent-ink); font-size: var(--text-xs); font-weight: 750; text-transform: uppercase; letter-spacing: .07em; }
.video-card strong { display: block; margin-top: var(--space-3); font-family: var(--font-display); font-size: var(--text-md); line-height: 1.25; }
.video-card p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }
.video-card__watch { margin-top: auto; padding-top: var(--space-3); color: var(--accent-ink); font-size: var(--text-sm); font-weight: 700; }

.paradox {
  position: relative;
  padding: clamp(2rem, 6vw, 5rem);
  overflow: hidden;
  border-radius: 1.5rem;
  color: var(--ink);
  background: var(--accent-wash);
  text-align: center;
}

.paradox::before,
.paradox::after {
  position: absolute;
  color: color-mix(in srgb, var(--accent) 17%, transparent);
  font: 700 12rem/1 var(--font-display);
  content: "“";
}

.paradox::before { top: -3rem; left: 1rem; }
.paradox::after { right: 1rem; bottom: -8rem; transform: rotate(180deg); }
.paradox blockquote { position: relative; z-index: 1; border: 0; color: var(--ink); font: 600 clamp(2rem, 5vw, 4rem)/1.08 var(--font-display); }
.paradox cite { color: var(--accent-ink); }

.glossary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
  margin-top: var(--space-5);
}

.glossary div {
  padding: var(--space-4);
  border-top: 2px solid var(--border);
}

.glossary dt { font-family: var(--font-display); font-size: var(--text-md); font-weight: 650; }
.glossary dd { margin-top: var(--space-2); color: var(--ink-soft); }

.chapter-footer {
  max-width: var(--wide-max);
  margin: var(--space-10) auto 0;
  padding: var(--space-6) var(--space-4);
  border-top: var(--hairline);
}

.chapter-footer__nav {
  display: flex;
  justify-content: space-between;
  gap: var(--space-4);
}

.chapter-footer__nav a { font-weight: 700; }

.mobile-toc { display: none; }

@keyframes rise-in {
  from { opacity: 0; transform: translateY(.6rem); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: no-preference) {
  .hero,
  .chapter-section { animation: rise-in .5s both; }
}

@media (max-width: 65rem) {
  .chapter-shell { display: block; width: 100%; }
  .chapter-rail { display: none; }
  .chapter-main { width: 100%; }
  .hero { margin: var(--space-4); }
  .mobile-toc {
    display: block;
    max-width: var(--content-max);
    margin: 0 auto var(--space-6);
    padding: 0 var(--space-4);
  }
  .mobile-toc details { padding: var(--space-3) var(--space-4); border: var(--hairline); border-radius: var(--radius-md); background: var(--bg-card); }
  .mobile-toc summary { cursor: pointer; font-weight: 700; }
  .mobile-toc ol { margin-top: var(--space-3); }
}

@media (max-width: 46rem) {
  .site-bar__meta { display: none; }
  .hero h1 { font-size: clamp(2.55rem, 15vw, 4.6rem); }
  .learning-objectives,
  .comparison,
  .concept-strip,
  .file-map,
  .frame-grid,
  .glossary,
  .video-cards { grid-template-columns: 1fr; }
  .workflow { grid-template-columns: 1fr; }
  .workflow__step:not(:last-child)::after { top: auto; right: 50%; bottom: -.85rem; transform: translateX(50%) rotate(90deg); }
  .move { padding-left: 1.75rem; }
  .core-four { grid-template-columns: 1fr; }
  .core-four__plus { display: none; }
}

@media print {
  @page { margin: .7in; }
  body { background: var(--ink-inverse); font-size: var(--text-print); }
  .reading-progress,
  .site-bar,
  .chapter-rail,
  .mobile-toc { display: none !important; }
  .chapter-shell { display: block; width: auto; }
  .hero { margin-top: 0; break-after: page; box-shadow: none; }
  .chapter-section { max-width: none; padding-inline: 0; }
  .chapter-section[id] { break-before: page; }
  .move,
  .callout,
  .frame-card,
  .diagram,
  .retrieval-quiz__item,
  .lab-box { break-inside: avoid; }
  .frame-card img { max-height: 4.2in; object-fit: contain; }
  .chapter-footer { display: none; }
  a { color: inherit; text-decoration: none; }
}

