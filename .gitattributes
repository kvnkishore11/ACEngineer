# Normalise line endings for text, keep binaries byte-exact, and stop generated
# HTML from skewing language stats and diffs.

* text=auto eol=lf

# --- Binary ------------------------------------------------------------------
*.mp4 -text
*.m4a -text
*.mov -text
*.webm -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.pdf -text
*.safetensors -text

# --- Text --------------------------------------------------------------------
*.vtt text
*.md text
*.json text
*.py text
*.sh text eol=lf

# --- Generated ---------------------------------------------------------------
catalog/_source/course-pages-offline/** linguist-generated=true
catalog/**/metadata/*.html linguist-generated=true
knowledge/book/code/*.html linguist-generated=true
